      "wholePositiveProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "valenzstruktur",
            "essentialUnderstandingDe": "Proton und Neutron besitzen die Valenzquarkinhalte uud und udd; einfache Mesonen werden als Quark-Antiquark-Systeme beschrieben.",
            "essentialUnderstandingEn": "The proton and neutron have valence-quark contents uud and udd; simple mesons are described as quark-antiquark systems.",
            "observablePerformanceDe": "Beschreibt die angegebenen Hadronen mit passenden Quarkinhalten und erkl\u00e4rt den Unterschied zwischen Drei-Valenzquark- und Quark-Antiquark-Struktur.",
            "observablePerformanceEn": "Describes the specified hadrons with appropriate quark contents and explains the distinction between three-valence-quark and quark-antiquark structures."
          },
          {
            "id": "ladungsbilanz-und-modell",
            "essentialUnderstandingDe": "Hadronladung ergibt sich aus den Quarkladungen; Antiquarks tragen die entgegengesetzte elektrische Ladung. Quarkstruktur bedeutet innere Zusammensetzung, nicht eine vollst\u00e4ndige klassische Miniaturmechanik.",
            "essentialUnderstandingEn": "Hadron charge follows from quark charges; antiquarks carry the opposite electric charge. Quark structure implies internal composition, not a complete classical miniature mechanics.",
            "observablePerformanceDe": "Pr\u00fcft eine Ladungsbilanz und erl\u00e4utert, wie das Quarkmodell die Materiebeschreibung verfeinert, mit Hinweis auf Bindung durch die starke Wechselwirkung und den vereinfachten Valenzcharakter.",
            "observablePerformanceEn": "Checks a charge balance and explains how the quark model refines the description of matter, noting strong-interaction binding and the simplified valence description."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "valenzstruktur",
            "ladungsbilanz-und-modell"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "baryon-meson",
            "textDe": "Proton/Neutron mit drei Valenzquarks gegen\u00fcber geladenen Pionen mit Quark und Antiquark.",
            "textEn": "Proton/neutron with three valence quarks versus charged pions with a quark and antiquark."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "nukleonen-vergleichen",
            "taskDemandDe": "Beschreibe Proton und Neutron als Quarksysteme. Verwende q_u=+2e/3 und q_d=\u2212e/3, pr\u00fcfe ihre Ladungen und erkl\u00e4re, warum ein elektrisch neutrales Neutron nicht strukturlos sein muss.",
            "taskDemandEn": "Describe the proton and neutron as quark systems. Use q_u=+2e/3 and q_d=\u2212e/3, check their charges and explain why an electrically neutral neutron need not be structureless.",
            "expectedPerformanceDe": "uud ergibt (+2+2\u22121)e/3=+e; udd ergibt (+2\u22121\u22121)e/3=0. Elektrische Neutralit\u00e4t des Neutrons entsteht aus der Summe geladener Bestandteile, nicht aus fehlender innerer Struktur. Drei Valenzquarks geben charakteristische Quantenzahlen wieder; die starke Bindung und weitere Quantenfeldanteile werden nicht als drei starre Kugeln vollst\u00e4ndig beschrieben.",
            "expectedPerformanceEn": "uud gives (+2+2\u22121)e/3=+e; udd gives (+2\u22121\u22121)e/3=0. Neutron electrical neutrality results from the sum of charged constituents, not absence of internal structure. Three valence quarks account for characteristic quantum numbers; strong binding and additional quantum-field contributions are not completely described as three rigid balls.",
            "understandingFocusDe": "Eine \u00e4u\u00dfere Eigenschaft wird aus innerer Zusammensetzung erkl\u00e4rt.",
            "understandingFocusEn": "An external property is explained from internal composition."
          },
          {
            "id": "pionen-und-antiquarks",
            "taskDemandDe": "Die ausgew\u00e4hlten Mesonen \u03c0\u207a und \u03c0\u207b werden durch u anti-d beziehungsweise d anti-u modelliert. Bestimme ihre Ladungen und vergleiche diese Struktur mit einem Proton. Erl\u00e4utere, was das Antizeichen bedeutet.",
            "taskDemandEn": "The selected mesons \u03c0\u207a and \u03c0\u207b are modeled by u anti-d and d anti-u respectively. Determine their charges and compare this structure with a proton. Explain the meaning of the anti label.",
            "expectedPerformanceDe": "anti-d tr\u00e4gt +e/3, anti-u \u22122e/3. Damit haben die Pionen +e beziehungsweise \u2212e. Sie sind Quark-Antiquark-Systeme statt Drei-Valenzquark-Systemen wie das Proton; gleiche Gesamtladung \u03c0\u207a/Proton bedeutet daher nicht gleiche Zusammensetzung. Antizeichen bezeichnet das entsprechende Antiteilchen, nicht ein negativ geladenes Quark jeder Sorte.",
            "expectedPerformanceEn": "Anti-d carries +e/3 and anti-u \u22122e/3, so the pions have +e and \u2212e. They are quark-antiquark systems rather than three-valence-quark systems like the proton; equal total charge of \u03c0\u207a and proton therefore does not mean equal composition. The anti label denotes the corresponding antiparticle, not a negatively charged quark of every type.",
            "understandingFocusDe": "Materie- und Antimateriebeitr\u00e4ge ergeben Ladung, ohne die Hadronenfamilien gleichzusetzen.",
            "understandingFocusEn": "Matter and antimatter contributions yield charge without equating hadron families."
          }
        ]
      }

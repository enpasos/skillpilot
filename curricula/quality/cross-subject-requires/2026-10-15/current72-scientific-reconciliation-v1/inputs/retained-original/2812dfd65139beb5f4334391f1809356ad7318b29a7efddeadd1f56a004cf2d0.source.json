        "archetype": "concept",
        "expectations": [
          {
            "id": "order-spectrum-consistently",
            "essentialUnderstandingDe": "Alle Spektralbereiche sind elektromagnetische Wellen. Im Vakuum sind Frequenz und Wellenl\u00e4nge \u00fcber c = \u03bbf gegenl\u00e4ufig geordnet; die benannten Bereichsgrenzen sind Konventionen und keine sprunghaften \u00c4nderungen der Wellenart.",
            "essentialUnderstandingEn": "All spectral regions are electromagnetic waves. In vacuum, frequency and wavelength are inversely ordered through c = \u03bbf; named region boundaries are conventions rather than abrupt changes in wave type.",
            "observablePerformanceDe": "Die lernende Person ordnet unbekannte Frequenz- und Vakuumwellenl\u00e4ngenangaben konsistent, rechnet zwischen ihnen um, kennzeichnet \u00fcberlappende oder konventionelle Grenzbereiche angemessen und pr\u00fcft Gr\u00f6\u00dfenordnung sowie Einheit.",
            "observablePerformanceEn": "The learner consistently orders unfamiliar frequency and vacuum-wavelength data, converts between them, appropriately marks overlapping or conventional boundary regions, and checks order of magnitude and units."
          },
          {
            "id": "justify-applications-and-limits",
            "essentialUnderstandingDe": "Technische Eignung folgt nicht allein aus dem Namen eines Spektralbereichs, sondern aus Eigenschaften wie Beugung, r\u00e4umlicher Aufl\u00f6sung, atmosph\u00e4rischer oder materieller Absorption und der energieabh\u00e4ngigen Wechselwirkung mit Materie. Die konkrete Eignung h\u00e4ngt daher auch vom Medium, der Geometrie und Sicherheitsanforderungen ab.",
            "essentialUnderstandingEn": "Technical suitability follows not from a spectral-region name alone but from properties such as diffraction, spatial resolution, atmospheric or material absorption, and energy-dependent interaction with matter. Suitability therefore also depends on medium, geometry, and safety requirements.",
            "observablePerformanceDe": "Die lernende Person w\u00e4hlt f\u00fcr eine neue technische Anforderung einen plausiblen Bereich, begr\u00fcndet die Wahl mit mindestens einer relevanten Welleneigenschaft, vergleicht eine Alternative und benennt eine physikalische oder praktische Grenze.",
            "observablePerformanceEn": "For a new technical requirement, the learner selects a plausible region, justifies it using at least one relevant wave property, compares an alternative, and states a physical or practical limitation."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "order-spectrum-consistently",
            "justify-applications-and-limits"
          ],

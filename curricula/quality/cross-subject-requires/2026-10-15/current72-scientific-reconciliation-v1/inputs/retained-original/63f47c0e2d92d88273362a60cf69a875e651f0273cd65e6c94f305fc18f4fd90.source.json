        "expectations": [
          {
            "id": "photon-relations",
            "essentialUnderstandingDe": "Im Vakuum verbinden E=hf=hc/\u03bb und p=E/c=h/\u03bb Energie, Impulsbetrag, Frequenz und Wellenl\u00e4nge; Photonenimpuls setzt keine von null verschiedene Ruhemasse voraus.",
            "essentialUnderstandingEn": "In vacuum E=hf=hc/\u03bb and p=E/c=h/\u03bb connect energy, momentum magnitude, frequency and wavelength; photon momentum does not require nonzero rest mass.",
            "observablePerformanceDe": "Konstruiert eine konsistente Tabelle, Relationsdarstellung oder Grafik und \u00fcbersetzt zwischen verschiedenen gegebenen Gr\u00f6\u00dfen mit Einheiten.",
            "observablePerformanceEn": "Constructs a consistent table, relation representation or graph and translates between different given quantities with units."
          },
          {
            "id": "scaling-meaning",
            "essentialUnderstandingDe": "Energie und Impuls pro Photon wachsen proportional zur Frequenz und umgekehrt proportional zur Wellenl\u00e4nge; die Beziehungen betreffen nicht ohne Photonenzahl die gesamte Strahlenergie.",
            "essentialUnderstandingEn": "Energy and momentum per photon grow proportionally with frequency and inversely with wavelength; without photon count the relationships do not determine total beam energy.",
            "observablePerformanceDe": "Erkl\u00e4rt und pr\u00fcft Skalierungsvergleiche einschlie\u00dflich eines umgekehrten Schlusses von Impuls auf Wellenl\u00e4nge und grenzt Einzelphoton von Strahlmenge ab.",
            "observablePerformanceEn": "Explains and checks scaling comparisons including reverse inference from momentum to wavelength and distinguishes a single photon from a quantity of light."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "photon-relations",
            "scaling-meaning"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "given-quantity-and-count",
            "textDe": "Wellenl\u00e4nge als Eingabe gegen\u00fcber Impuls als Eingabe; Einzelphotonwerte gegen\u00fcber einer ge\u00e4nderten Photonenzahl.",
            "textEn": "Wavelength as input versus momentum as input; single-photon values versus a changed photon count."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "wavelength-to-table",
            "taskDemandDe": "F\u00fcr Vakuumlicht mit \u03bb=600 nm, h=6,63\u00b710\u207b\u00b3\u2074 J s und c=3,00\u00b710\u2078 m/s erstelle eine Tabelle f\u00fcr f, E und p und erl\u00e4utere die Zusammenh\u00e4nge.",
            "taskDemandEn": "For vacuum light with \u03bb=600 nm, h=6.63\u00b710\u207b\u00b3\u2074 J s and c=3.00\u00b710\u2078 m/s, construct a table for f, E and p and explain the relationships.",
            "expectedPerformanceDe": "Erh\u00e4lt f=5,00\u00b710\u00b9\u2074 Hz, E=3,315\u00b710\u207b\u00b9\u2079 J und p=1,105\u00b710\u207b\u00b2\u2077 kg m/s; erkl\u00e4rt c=f\u03bb und E=pc und kontrolliert die Einheiten.",
            "expectedPerformanceEn": "Obtains f=5.00\u00b710\u00b9\u2074 Hz, E=3.315\u00b710\u207b\u00b9\u2079 J and p=1.105\u00b710\u207b\u00b2\u2077 kg m/s; explains c=f\u03bb and E=pc and checks units.",
            "understandingFocusDe": "Konsistente \u00dcbersetzung physikalischer Gr\u00f6\u00dfen statt unabh\u00e4ngiger Formeleins\u00e4tze.",
            "understandingFocusEn": "Consistent translation of physical quantities rather than independent formula substitutions."
          },
          {
            "id": "momentum-and-photon-count",
            "taskDemandDe": "Ein Photon hat im Vakuum p=2,210\u00b710\u207b\u00b2\u2077 kg m/s; nutze dieselben Konstanten. Bestimme \u03bb, E und f. Vergleiche mit einem 600-nm-Photon und beurteile, ob doppelt so viele gleichartige Photonen die Wellenl\u00e4nge \u00e4ndern.",
            "taskDemandEn": "A photon in vacuum has p=2.210\u00b710\u207b\u00b2\u2077 kg m/s; use the same constants. Determine \u03bb, E and f. Compare with a 600-nm photon and assess whether twice as many otherwise identical photons change wavelength.",
            "expectedPerformanceDe": "Erh\u00e4lt \u03bb=300 nm, E=6,63\u00b710\u207b\u00b9\u2079 J, f=1,00\u00b710\u00b9\u2075 Hz; begr\u00fcndet doppelte Energie und doppelten Impuls bei halber Wellenl\u00e4nge. Eine gr\u00f6\u00dfere Photonenzahl \u00e4ndert die Gesamtenergie, nicht automatisch E oder \u03bb des Einzelphotons.",
            "expectedPerformanceEn": "Obtains \u03bb=300 nm, E=6.63\u00b710\u207b\u00b9\u2079 J, f=1.00\u00b710\u00b9\u2075 Hz; justifies double energy and momentum at half wavelength. A larger photon count changes total energy, not automatically an individual photon's E or \u03bb.",
            "understandingFocusDe": "Umkehrschluss und Abgrenzung intrinsischer Photonengr\u00f6\u00dfen von der Strahlmenge.",
            "understandingFocusEn": "Reverse inference and distinction between individual-photon quantities and amount of light."
          }
        ]
      }

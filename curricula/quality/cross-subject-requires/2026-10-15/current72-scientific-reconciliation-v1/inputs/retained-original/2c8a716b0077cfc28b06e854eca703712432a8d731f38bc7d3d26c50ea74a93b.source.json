      "wholePositiveProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "vacancy-transition",
            "essentialUnderstandingDe": "Eine innere Leerstelle kann durch ein Elektron aus einem h\u00f6heren H\u00fcllenniveau gef\u00fcllt werden; ein dabei emittiertes R\u00f6ntgenphoton tr\u00e4gt die entsprechende Energiedifferenz.",
            "essentialUnderstandingEn": "An inner-shell vacancy can be filled by an electron from a higher shell level; an emitted X-ray photon carries the corresponding energy difference.",
            "observablePerformanceDe": "Die lernende Person erkl\u00e4rt und beschriftet aus gegebenen Bindungsenergien Leerstellenbildung und Strahlungs\u00fcbergang und ordnet Linien verschiedenen \u00dcberg\u00e4ngen zu.",
            "observablePerformanceEn": "The learner explains and labels vacancy creation and radiative transition from supplied binding energies and assigns lines to different transitions."
          },
          {
            "id": "characteristic-versus-excitation",
            "essentialUnderstandingDe": "Die charakteristische Linienenergie ist durch die H\u00fcllenniveaus des Elements bestimmt; die verf\u00fcgbare Anregungsenergie entscheidet mit, ob die n\u00f6tige Leerstelle entstehen kann.",
            "essentialUnderstandingEn": "Characteristic line energy is determined by the element's shell levels; available excitation energy helps determine whether the required vacancy can be produced.",
            "observablePerformanceDe": "Die lernende Person sagt bei ge\u00e4ndertem Element oder ge\u00e4nderter Anregung voraus, welche Linie m\u00f6glich ist und welche Energie unver\u00e4ndert bleibt, und benennt die Grenzen des vereinfachten Schemas.",
            "observablePerformanceEn": "The learner predicts which line is possible and which energy remains unchanged after changing the element or excitation, and states the limits of the simplified diagram."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "vacancy-transition",
            "characteristic-versus-excitation"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "target",
            "textDe": "Elementwechsel ver\u00e4ndert die inneren Bindungsenergien.",
            "textEn": "Changing the target element changes inner binding energies."
          },
          {
            "id": "threshold",
            "textDe": "Anregung unterhalb und oberhalb der inneren Ionisationsschwelle.",
            "textEn": "Excitation below and above the inner ionisation threshold."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "two-lines",
            "taskDemandDe": "F\u00fcr ein idealisiertes Atom seien Energien relativ zum freien Elektron K=\u221210, L=\u22122 und M=\u22121 keV. Eine K-Leerstelle ist vorhanden; L\u2192K und M\u2192K seien m\u00f6glich. Erkl\u00e4re die charakteristischen Photonen und warum Linien statt beliebiger Energien entstehen.",
            "taskDemandEn": "For an idealised atom, energies relative to a free electron are K=\u221210, L=\u22122 and M=\u22121 keV. A K vacancy exists and L\u2192K and M\u2192K are possible. Explain the characteristic photons and why lines rather than arbitrary energies occur.",
            "expectedPerformanceDe": "Bestimmt 8 bzw. 9 keV aus der Abnahme der H\u00fcllenenergie, zeichnet die Abw\u00e4rtspfeile und begr\u00fcndet diskrete elementabh\u00e4ngige Linien. Kennzeichnet das vereinfachte Einteilchen-Energieschema; es sagt keine Linienintensit\u00e4ten voraus.",
            "expectedPerformanceEn": "Obtains 8 and 9 keV from the decrease in shell energy, draws downward arrows and explains discrete element-dependent lines. Identifies the simplified single-electron energy diagram; it does not predict line intensities.",
            "understandingFocusDe": "Photonenenergie ist die Differenz zweier H\u00fcllenniveaus.",
            "understandingFocusEn": "Photon energy is the difference between two shell levels."
          },
          {
            "id": "threshold-target-change",
            "taskDemandDe": "Bei einem zweiten Modelltarget gelten K=\u221216 und L=\u22123 keV. Vergleiche Elektronenanregung mit maximal 14 und 20 keV; anschlie\u00dfend werde die maximale Energie weiter erh\u00f6ht. Erkl\u00e4re die M\u00f6glichkeit und Lage der L\u2192K-Linie anhand des Schemas. Verwende nur bereitgestellte Daten, keine R\u00f6ntgenquelle.",
            "taskDemandEn": "For a second model target, K=\u221216 and L=\u22123 keV. Compare electron excitation with maximum energies of 14 and 20 keV, then increase the maximum further. Explain the possibility and position of the L\u2192K line using the diagram. Use supplied data only, not an X-ray source.",
            "expectedPerformanceDe": "Ordnet 16 keV der K-Ionisationsschwelle und 13 keV der Linienenergie zu. Unter 16 keV kann dieser angenommene Sto\u00dfmechanismus keine K-Leerstelle bilden; bei 20 keV ist die Linie m\u00f6glich, nicht garantiert. H\u00f6here Anregung verschiebt bei gleichem Target diese Niveaudifferenz nicht.",
            "expectedPerformanceEn": "Assigns 16 keV to the K-ionisation threshold and 13 keV to the line energy. Below 16 keV this assumed impact mechanism cannot create a K vacancy; at 20 keV the line is possible, not guaranteed. Higher excitation does not shift this level difference for the same target.",
            "understandingFocusDe": "Erzeugungsbedingung und charakteristische Emissionsenergie sind verschiedene Gr\u00f6\u00dfen.",
            "understandingFocusEn": "Production condition and characteristic emission energy are different quantities."
          }
        ]
      }

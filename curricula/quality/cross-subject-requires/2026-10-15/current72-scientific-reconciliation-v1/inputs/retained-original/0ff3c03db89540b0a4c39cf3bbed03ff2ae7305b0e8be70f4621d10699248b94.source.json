        "expectations": [
          {
            "id": "thomson-and-units",
            "essentialUnderstandingDe": "F\u00fcr den idealisierten LC-Kreis gilt f\u2080=1/(2\u03c0\u221a(LC)); L und C bestimmen die Eigenfrequenz, nicht die anf\u00e4ngliche Ladungsamplitude.",
            "essentialUnderstandingEn": "For an idealised LC circuit, f\u2080=1/(2\u03c0\u221a(LC)); L and C determine natural frequency, not initial charge amplitude.",
            "observablePerformanceDe": "W\u00e4hlt die Thomson-Gleichung, rechnet Einheiten korrekt um und unterscheidet f\u2080, \u03c9\u2080 und T.",
            "observablePerformanceEn": "Chooses Thomson's equation, converts units correctly, and distinguishes f\u2080, \u03c9\u2080, and T."
          },
          {
            "id": "parameter-dependence",
            "essentialUnderstandingDe": "Die Frequenz h\u00e4ngt umgekehrt von der Quadratwurzel des Produkts LC ab; die Aussage setzt ein ideales beziehungsweise hinreichend verlustarmes Modell voraus.",
            "essentialUnderstandingEn": "Frequency is inversely proportional to the square root of LC; this assumes an ideal or sufficiently low-loss model.",
            "observablePerformanceDe": "Begr\u00fcndet Parameter\u00e4nderungen und pr\u00fcft das Ergebnis durch Verh\u00e4ltnis- und Plausibilit\u00e4tsbetrachtungen.",
            "observablePerformanceEn": "Justifies parameter changes and checks results through ratios and plausibility."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [

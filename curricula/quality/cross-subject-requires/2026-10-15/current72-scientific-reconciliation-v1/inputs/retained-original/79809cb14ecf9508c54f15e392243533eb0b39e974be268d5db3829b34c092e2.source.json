        "archetype": "modeling",
        "expectations": [
          {
            "id": "ensemble-exponential",
            "essentialUnderstandingDe": "Bei einem einzelnen Isotop ohne Zu-/Abfuhr beschreibt N=N\u2080\u00b72^(\u2212t/T) die erwartete Restzahl; bei gleicher Zerfallskonstante nimmt A im gleichen Verh\u00e4ltnis ab. Die Halbwertszeit ist keine feste Lebensdauer jedes Kerns.",
            "essentialUnderstandingEn": "For one isotope with no inflow/outflow N=N\u2080\u00b72^(\u2212t/T) describes the expected remaining population; activity falls in the same ratio for a fixed decay constant. Half-life is not each nucleus\u2019s fixed lifetime.",
            "observablePerformanceDe": "W\u00e4hlt N oder A passend zur Frage, berechnet mit Zeiteinheiten und erkl\u00e4rt statistische Schwankungen gegen\u00fcber der Modellkurve.",
            "observablePerformanceEn": "Selects N or A for the question, calculates with time units and explains statistical fluctuations around the model curve."
          },
          {
            "id": "relative-not-absolute",
            "essentialUnderstandingDe": "In gleichen Halbwertszeitintervallen halbiert sich der jeweils vorhandene Bestand; die absoluten Verluste werden kleiner. Eine Hintergrundz\u00e4hlrate ist nicht ohne Abzug die Aktivit\u00e4t des Isotops.",
            "essentialUnderstandingEn": "Each half-life halves the population then present; absolute losses decrease. A background count rate is not the isotope\u2019s activity without correction.",
            "observablePerformanceDe": "Leitet eine Halbwertszeit oder Prognose aus neuen Daten ab und pr\u00fcft, ob eine scheinbar fehlende Halbierung durch einen konstanten Hintergrund erkl\u00e4rbar ist.",
            "observablePerformanceEn": "Infers a half-life or prediction from fresh data and checks whether constant background explains an apparent failure to halve."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "ensemble-exponential",

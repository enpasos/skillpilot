      "wholePositiveProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "orbital-statistik",
            "essentialUnderstandingDe": "Ein Orbital beschreibt einen Quantenzustand; dargestellte Dichten oder r\u00e4umliche Konturen veranschaulichen Nachweiswahrscheinlichkeiten, keine Bahn oder materielle Elektronenwolke.",
            "essentialUnderstandingEn": "An orbital describes a quantum state; displayed densities or spatial contours visualize detection probabilities, not a trajectory or a material electron cloud.",
            "observablePerformanceDe": "\u00dcbersetzt die angegebene Darstellungskonvention in Aussagen \u00fcber viele gleich pr\u00e4parierte Ortsmessungen und unterscheidet diese von der unvorhersagbaren Einzelmessung.",
            "observablePerformanceEn": "Translates the stated display convention into claims about many identically prepared position measurements and distinguishes these from an unpredictable individual measurement."
          },
          {
            "id": "darstellungskonvention",
            "essentialUnderstandingDe": "Punktdichte, Wahrscheinlichkeitskontur und Vorzeichenf\u00e4rbung enthalten unterschiedliche Informationen; r\u00e4umliche Ausdehnung und Dichte d\u00fcrfen nicht gleichgesetzt werden.",
            "essentialUnderstandingEn": "Dot density, probability contours and sign coloring convey different information; spatial extent and density must not be equated.",
            "observablePerformanceDe": "Begr\u00fcndet passende r\u00e4umliche Vergleiche und erkl\u00e4rt, welche Aussagen die konkrete Orbitaldarstellung nicht tr\u00e4gt.",
            "observablePerformanceEn": "Justifies appropriate spatial comparisons and explains which claims the particular orbital display does not support."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "orbital-statistik",
            "darstellungskonvention"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "konvention-und-symmetrie",
            "textDe": "Gleich gro\u00dfe Volumenelemente einer s-Darstellung gegen\u00fcber Kontur und Vorzeichenfarben einer p-Darstellung.",
            "textEn": "Equal-sized volume elements in an s display versus contours and sign colors in a p display."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "s-orbital-nachweise",
            "taskDemandDe": "Eine Punktdarstellung eines Wasserstoff-s-Orbitals verwendet Punktdichte proportional zur Nachweisdichte. Zwei gleich gro\u00dfe kleine Volumenelemente A und B liegen in Bereichen, in denen die Dichte in A etwa doppelt so gro\u00df wie in B ist. Erl\u00e4utere eine Vorhersage f\u00fcr viele Wiederholungen und deren Grenze f\u00fcr ein einzelnes Elektron.",
            "taskDemandEn": "A dot display of a hydrogen s orbital uses dot density proportional to detection density. Two equally sized small volume elements A and B lie in regions where density in A is about twice that in B. Explain a prediction for many repetitions and its limit for one electron.",
            "expectedPerformanceDe": "Erwartet bei gleicher Pr\u00e4paration ungef\u00e4hr doppelt so viele Nachweise in A wie in B, nicht zwei Elektronenanteile eines einzelnen Nachweises. Ein einzelner Treffer ist nicht festgelegt. Der Vergleich nutzt gleich gro\u00dfe Volumina; aus h\u00f6herer lokaler Dichte folgt ohne Volumenvergleich keine gr\u00f6\u00dfere Wahrscheinlichkeit einer beliebig gro\u00dfen Region.",
            "expectedPerformanceEn": "Expects about twice as many detections in A as in B under identical preparation, not two electron fractions within one detection. A single outcome is not fixed. The comparison uses equal volumes; greater local density alone does not establish a larger probability for an arbitrarily sized region.",
            "understandingFocusDe": "Die r\u00e4umliche Statistik wird aus der Legende erschlossen, nicht als Elektronenbahn gelesen.",
            "understandingFocusEn": "Spatial statistics are inferred from the legend rather than read as an electron orbit."
          },
          {
            "id": "p-orbital-kontur",
            "taskDemandDe": "Eine symmetrische Wasserstoff-p-Orbitalkontur umschlie\u00dft laut Legende insgesamt 90 % der Nachweiswahrscheinlichkeit. Ihre beiden Lappen sind wegen unterschiedlicher Vorzeichen der Wellenfunktion verschieden gef\u00e4rbt. Erl\u00e4utere Nachweise in den Lappen und au\u00dferhalb der Kontur sowie die Bedeutung der Farben.",
            "taskDemandEn": "A symmetric hydrogen p-orbital contour encloses 90% of the detection probability according to its legend. Its two lobes have different colors because the wave function has different signs. Explain detections in the lobes and outside the contour, and the meaning of the colors.",
            "expectedPerformanceDe": "Die symmetrischen Lappen enthalten jeweils 45 % der Gesamtwahrscheinlichkeit; 10 % liegt au\u00dferhalb. Beide Farben stehen f\u00fcr gleich m\u00f6gliche Nachweise in entsprechenden Bereichen, nicht f\u00fcr positive und negative Elektronenladung. Die Kontur ist keine harte Wand, und die Lappen sind keine Umlaufbahnen.",
            "expectedPerformanceEn": "The symmetric lobes each contain 45% of total probability; 10% lies outside. The two colors represent equally possible detections in corresponding regions, not positive and negative electron charge. The contour is not a hard wall and the lobes are not orbits.",
            "understandingFocusDe": "Konturwahrscheinlichkeit und Vorzeicheninformation m\u00fcssen getrennt interpretiert werden.",
            "understandingFocusEn": "Contour probability and sign information must be interpreted separately."
          }
        ]
      }
    },

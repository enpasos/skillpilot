      "wholePositiveProfile": {
        "archetype": "experiment",
        "expectations": [
          {
            "id": "apparatus-and-rings",
            "essentialUnderstandingDe": "Elektronenquelle, Beschleunigung, polykristalline Probe und Leuchtschirm haben unterschiedliche Funktionen; Beugungsringe entstehen durch die vielen Kristallorientierungen.",
            "essentialUnderstandingEn": "The electron source, acceleration, polycrystalline sample, and fluorescent screen serve different functions; many crystal orientations produce diffraction rings.",
            "observablePerformanceDe": "Die Person erkl\u00e4rt die Funktionskette und deutet Ringe als Beugungsstruktur statt als einzelne Elektronenbahnen; sie arbeitet mit bereitgestellten Daten oder einem betreuten Versuch.",
            "observablePerformanceEn": "The learner explains the functional sequence and interprets rings as a diffraction structure rather than individual electron trajectories, using supplied data or a supervised experiment."
          },
          {
            "id": "momentum-wavelength-inference",
            "essentialUnderstandingDe": "Aus Beschleunigungsspannung folgt im nichtrelativistischen Modell p = \u221a(2m\u2091eU); geometrisch erschlossene Wellenl\u00e4ngen pr\u00fcfen \u03bb = h/p.",
            "essentialUnderstandingEn": "The nonrelativistic model relates accelerating voltage to p = \u221a(2m\u2091eU); geometrically inferred wavelengths test \u03bb = h/p.",
            "observablePerformanceDe": "Die Person legt Streuwinkel, Schirmgeometrie, Netzebenenabstand und N\u00e4herung offen, wertet Daten mit Einheiten aus und begr\u00fcndet Trends einschlie\u00dflich Messunsicherheit.",
            "observablePerformanceEn": "The learner specifies scattering angle, screen geometry, lattice-plane spacing, and approximation, evaluates data with units, and explains trends including measurement uncertainty."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "apparatus-and-rings",
            "momentum-wavelength-inference"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "voltage-and-wavelength",
            "textDe": "Beschleunigungsspannung und daraus erschlossenen Impuls gemeinsam variieren.",
            "textEn": "Vary accelerating voltage and the momentum inferred from it together."
          },
          {
            "id": "lattice-family",
            "textDe": "Verschiedene Ringfamilien bei derselben Elektronenenergie vergleichen.",
            "textEn": "Compare different ring families at the same electron energy."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "planar-calibrated-data",
            "taskDemandDe": "Erkl\u00e4re eine Elektronenbeugungsr\u00f6hre anhand ihrer Bauteile. Werte anschlie\u00dfend einen ausdr\u00fccklich idealisierten ebenen Schirm aus: U = 2,50 kV, Abstand L = 0,100 m, erster Ringradius R = 11,52 mm, d = 0,213 nm. Gegeben sind \u03bb \u2248 dR/L f\u00fcr kleine Winkel und p = \u221a(2m\u2091eU).",
            "taskDemandEn": "Explain an electron diffraction tube using its components. Then analyze an explicitly idealized flat screen: U = 2.50 kV, distance L = 0.100 m, first ring radius R = 11.52 mm, d = 0.213 nm. The small-angle relation \u03bb \u2248 dR/L and p = \u221a(2m\u2091eU) are supplied.",
            "expectedPerformanceDe": "Die Person erh\u00e4lt \u03bb \u2248 24,54 pm und p \u2248 2,70\u00b710\u207b\u00b2\u00b3 kg m/s und zeigt die \u00dcbereinstimmung mit h/p innerhalb der Rundung. Sie benennt R und U als gemessen, \u03bb und p als erschlossen und \u00fcbertr\u00e4gt die ebene Geometrie nicht ungepr\u00fcft auf eine Kugelr\u00f6hre.",
            "expectedPerformanceEn": "The learner obtains \u03bb \u2248 24.54 pm and p \u2248 2.70\u00b710\u207b\u00b2\u00b3 kg m/s and shows agreement with h/p within rounding. R and U are measured, \u03bb and p inferred; flat-screen geometry is not transferred unchecked to a spherical tube.",
            "understandingFocusDe": "Geometrie und Energiemodell tragen gemeinsam die Materiewellenaussage.",
            "understandingFocusEn": "Geometry and the energy model jointly support the matter-wave inference."
          },
          {
            "id": "two-ring-families",
            "taskDemandDe": "Ein neuer Datensatz verwendet U = 5,00 kV und denselben idealisierten Schirmabstand L = 0,100 m. Radien 8,14 mm und 14,10 mm geh\u00f6ren zu d = 0,213 nm beziehungsweise 0,123 nm. Pr\u00fcfe, ob zwei Wellenl\u00e4ngen n\u00f6tig sind, und erkl\u00e4re die Spannungstendenz.",
            "taskDemandEn": "A new dataset uses U = 5.00 kV and the same idealized screen distance L = 0.100 m. Radii 8.14 mm and 14.10 mm correspond to d = 0.213 nm and 0.123 nm. Test whether two wavelengths are needed and explain the voltage trend.",
            "expectedPerformanceDe": "Die Person findet aus beiden Ringen ungef\u00e4hr 17,34 pm und begr\u00fcndet unterschiedliche Radien durch unterschiedliche Netzebenenabst\u00e4nde bei gleichem Impuls. Gr\u00f6\u00dferes U bedeutet gr\u00f6\u00dferes p und kleineres \u03bb; Ringbreite und Geometriekalibrierung begrenzen die Genauigkeit.",
            "expectedPerformanceEn": "The learner finds approximately 17.34 pm from both rings and explains their different radii by different lattice spacings at the same momentum. Higher U means higher p and smaller \u03bb; ring width and geometric calibration limit precision.",
            "understandingFocusDe": "Mehrere Beugungsringe bedeuten nicht automatisch mehrere Elektronenenergien.",
            "understandingFocusEn": "Multiple diffraction rings do not automatically imply multiple electron energies."
          }
        ]
      }
    },

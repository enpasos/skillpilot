      "wholePositiveProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "probability-versus-trajectory",
            "essentialUnderstandingDe": "Quantenmechanische Vorhersagen beziehen sich auf Wahrscheinlichkeiten m\u00f6glicher Messergebnisse bei festgelegter Pr\u00e4paration und Messanordnung, nicht auf eine aus diesen Angaben bekannte klassische Einzelbahn.",
            "essentialUnderstandingEn": "Quantum predictions concern probabilities of possible measurement outcomes for specified preparation and measurement arrangement, not a classical individual trajectory known from those data.",
            "observablePerformanceDe": "Formuliert zutreffende Einzelereignis- und Ensembleaussagen und benennt, welche Information die Wahrscheinlichkeitsverteilung nicht liefert.",
            "observablePerformanceEn": "States correct single-event and ensemble claims and identifies information the probability distribution does not supply."
          },
          {
            "id": "statistical-prediction",
            "essentialUnderstandingDe": "Eine erwartete H\u00e4ufigkeit ist keine garantierte exakte Anzahl und legt keine Reihenfolge der Einzelergebnisse fest; ver\u00e4nderte Messbedingungen k\u00f6nnen die Verteilung ver\u00e4ndern.",
            "essentialUnderstandingEn": "An expected frequency is not a guaranteed exact count and does not determine the sequence of individual outcomes; changed measurement conditions can change the distribution.",
            "observablePerformanceDe": "Deutet konkrete Wahrscheinlichkeitsangaben und bewertet deterministische Schlussfolgerungen sowie Schlussfolgerungen \u00fcber unbeobachtete Wege.",
            "observablePerformanceEn": "Interprets concrete probability data and assesses deterministic conclusions and claims about unobserved paths."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "probability-versus-trajectory",
            "statistical-prediction"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "ensemble-count-and-same-marginal",
            "textDe": "Erwartete Trefferzahlen deuten und zeigen, dass gleiche Ergebniswahrscheinlichkeiten keine eindeutige Bahnrekonstruktion erlauben.",
            "textEn": "Interpret expected detection counts and show that identical outcome probabilities do not allow unique trajectory reconstruction."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "screen-probability",
            "taskDemandDe": "Ein gegebenes Quantenmodell sagt f\u00fcr gleich pr\u00e4parierte, unabh\u00e4ngig registrierte Nachweise P(A)=0,30 f\u00fcr einen Schirmbereich A voraus. Was darf man f\u00fcr 1000 Nachweise erwarten? Beurteile 'genau der n\u00e4chste dritte Nachweis liegt in A' und 'es werden sicher genau 300'.",
            "taskDemandEn": "A supplied quantum model predicts P(A)=0.30 for a screen region A for identically prepared independently registered detections. What may be expected for 1000 detections? Assess 'the next third detection will lie in A' and 'there will certainly be exactly 300'.",
            "expectedPerformanceDe": "Die erwartete Anzahl ist 1000\u00b70,30=300; tats\u00e4chliche Zahlen k\u00f6nnen statistisch abweichen. Die Wahrscheinlichkeit betrifft jedes entsprechend pr\u00e4parierte Ereignis, legt aber weder dessen Ort noch die Reihenfolge fest. Eine einzelne Abweichung von 300 widerlegt das Modell nicht automatisch; die Pr\u00e4paration und Auswertung m\u00fcssen vergleichbar sein.",
            "expectedPerformanceEn": "The expected count is 1000\u00b70.30=300; actual counts can fluctuate statistically. The probability concerns each correspondingly prepared event but determines neither its location nor the sequence. A deviation from 300 does not automatically refute the model; preparation and analysis must be comparable.",
            "understandingFocusDe": "Quantitativ sinnvolle Vorhersage ohne falsche Garantie f\u00fcr Einzelereignisse geben.",
            "understandingFocusEn": "Give a meaningful quantitative prediction without a false guarantee for individual events."
          },
          {
            "id": "probability-not-path-record",
            "taskDemandDe": "Zwei verschiedene idealisierte Messanordnungen liefern beide P(links)=P(rechts)=1/2 f\u00fcr zwei Detektorbereiche. Eine Person behauptet, daraus die gleiche klassische Bahn jedes Quantenobjekts rekonstruieren zu k\u00f6nnen. Erkl\u00e4re, welche Aussagen die Angaben tragen und welche Zusatzinformation fehlt.",
            "taskDemandEn": "Two different idealised measurement arrangements both give P(left)=P(right)=1/2 for two detector regions. Someone claims to reconstruct the same classical trajectory of every quantum object from this. Explain what the data support and what information is missing.",
            "expectedPerformanceDe": "Die gleichen zwei Ergebniswahrscheinlichkeiten bedeuten nur gleiche Vorhersagen f\u00fcr diese grob zusammengefassten Detektorereignisse. Sie bestimmen keine Einzeltrefferfolge und enthalten keine Bahnaufzeichnung zwischen Quelle und Detektor. Bei 200 Nachweisen ist je 100 nur der Erwartungswert. Eine tats\u00e4chlich zus\u00e4tzliche Wegmessung w\u00e4re eine neue Messanordnung und darf nicht als schon vorhandene Information unterstellt werden.",
            "expectedPerformanceEn": "Equal outcome probabilities imply only equal predictions for these coarsely grouped detector events. They determine neither the sequence of individual hits nor a trajectory record between source and detector. For 200 detections, 100 each is only the expectation. An additional actual path measurement would be a new measurement arrangement and cannot be assumed as information already present.",
            "understandingFocusDe": "Grenzen einer Ergebnisverteilung erkl\u00e4ren, ohne eine ungest\u00fctzte Interpretation verborgener Einzelbahnen einzuf\u00fchren.",
            "understandingFocusEn": "Explain the limits of an outcome distribution without introducing an unsupported interpretation of hidden individual paths."
          }
        ]
      }
    },

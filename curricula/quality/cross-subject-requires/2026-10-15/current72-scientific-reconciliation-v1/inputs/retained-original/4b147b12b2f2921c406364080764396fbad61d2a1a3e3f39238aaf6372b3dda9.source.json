      "wholePositiveProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "electromagnetic-propagation",
            "essentialUnderstandingDe": "Licht wird im Wellenmodell durch gekoppelte elektrische und magnetische Feld\u00e4nderungen beschrieben; die Ausbreitungsgeschwindigkeit ist keine Geschwindigkeit mitreisender Leiterladungen.",
            "essentialUnderstandingEn": "In the wave model, light is described by coupled electric and magnetic field variations; its propagation speed is not the speed of conductor charges travelling with it.",
            "observablePerformanceDe": "Beschreibt eine frische Feld-/Ausbreitungssituation und verkn\u00fcpft r\u00e4umliche und zeitliche Periodizit\u00e4t mit der angegebenen Lichtgeschwindigkeit.",
            "observablePerformanceEn": "Describes a fresh field/propagation situation and connects spatial and temporal periodicity with the supplied speed of light."
          },
          {
            "id": "coherence-and-vacuum-speed",
            "essentialUnderstandingDe": "Koh\u00e4renz bedeutet eine ausreichend stabile Phasenbeziehung \u00fcber den betrachteten Zeitraum; sie ist weder blo\u00df gleiche Farbe noch eine erh\u00f6hte Lichtgeschwindigkeit.",
            "essentialUnderstandingEn": "Coherence means a sufficiently stable phase relation over the interval considered; it is neither merely the same colour nor increased light speed.",
            "observablePerformanceDe": "Pr\u00fcft Phasenangaben und begr\u00fcndet, welche Aussagen \u00fcber Koh\u00e4renz und Vakuumausbreitung daraus folgen.",
            "observablePerformanceEn": "Examines phase information and justifies conclusions about coherence and vacuum propagation."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "electromagnetic-propagation",
            "coherence-and-vacuum-speed"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "single-wave-and-relative-phase",
            "textDe": "Eine einzelne laufende Welle und den Phasenbezug zweier gleichfarbiger Teilwellen untersuchen.",
            "textEn": "Investigate one travelling wave and the phase relation between two same-colour wave components."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "vacuum-wave",
            "taskDemandDe": "Eine idealisierte Lichtwelle l\u00e4uft im Vakuum in z-Richtung; ihr elektrisches Feld schwingt in x-Richtung. Beschreibe die magnetische Feldorientierung und die Ausbreitung. F\u00fcr \u03bb=600 nm sind c=3,0\u00b710\u2078 m/s und c=\u03bbf gegeben; ordne die resultierende Frequenz ein.",
            "taskDemandEn": "An idealised light wave travels in the z direction in vacuum; its electric field oscillates in the x direction. Describe the magnetic field orientation and propagation. For \u03bb=600 nm, c=3.0\u00b710\u2078 m/s and c=\u03bbf are supplied; interpret the resulting frequency.",
            "expectedPerformanceDe": "Das magnetische Feld liegt quer dazu in y-Richtung, mit Orientierung passend zur Ausbreitung; beide Felder sind transversal. f=5,0\u00b710\u00b9\u2074 Hz, T=2,0\u00b710\u207b\u00b9\u2075 s. Die Feldgr\u00f6\u00dfen \u00e4ndern sich periodisch, w\u00e4hrend das Muster sich mit c ausbreitet; kein materielles Medium oder Elektronentransport \u00fcber die Lichtstrecke ist erforderlich.",
            "expectedPerformanceEn": "The magnetic field lies transversely along y, oriented consistently with propagation; both fields are transverse. f=5.0\u00b710\u00b9\u2074 Hz and T=2.0\u00b710\u207b\u00b9\u2075 s. Field quantities vary periodically as the pattern propagates at c; no material medium or electron transport along the light path is required.",
            "understandingFocusDe": "Feldschwingung, r\u00e4umliche Ausbreitung und charakteristische Geschwindigkeit unterscheiden.",
            "understandingFocusEn": "Distinguish field oscillation, spatial propagation, and characteristic speed."
          },
          {
            "id": "phase-stability",
            "taskDemandDe": "Zwei gleichfarbige Lichtanteile haben im Fall A \u00fcber die Beobachtungszeit eine konstante Phasendifferenz \u03c0/2, im Fall B eine rasch zuf\u00e4llig wechselnde Phasendifferenz. Vergleiche Koh\u00e4renz und ihre Ausbreitung im Vakuum. Ver\u00e4ndert h\u00f6here Intensit\u00e4t allein ihre Lichtgeschwindigkeit?",
            "taskDemandEn": "Two same-colour light components have a constant phase difference \u03c0/2 throughout observation in case A and a rapidly random phase difference in case B. Compare coherence and their propagation in vacuum. Does greater intensity alone change their speed?",
            "expectedPerformanceDe": "A besitzt eine stabile relative Phase und ist in diesem betrachteten Sinn koh\u00e4rent; B nicht \u00fcber die angegebene Beobachtungszeit. Gleiche Farbe allein gen\u00fcgt nicht. Beide breiten sich im Vakuum mit c aus; eine blo\u00dfe Intensit\u00e4ts\u00e4nderung \u00e4ndert c nicht. Koh\u00e4renz beschreibt den Phasenbezug, keine besondere schnellere Lichtart.",
            "expectedPerformanceEn": "A has a stable relative phase and is coherent in the sense considered; B is not over the stated observation interval. The same colour alone is insufficient. Both propagate in vacuum at c; an intensity change alone does not change c. Coherence describes phase relation, not a special faster kind of light.",
            "understandingFocusDe": "Koh\u00e4renz operational an Phasenangaben erkl\u00e4ren und von Ausbreitungsgeschwindigkeit trennen.",
            "understandingFocusEn": "Explain coherence operationally from phase information and separate it from propagation speed."
          }
        ]
      }

        "expectations": [
          {
            "id": "ray-wave-domain",
            "essentialUnderstandingDe": "Strahlen beschreiben Ausbreitungsrichtungen und geometrische Abbildungen n\u00e4herungsweise; sie enthalten ohne zus\u00e4tzliche Welleninformation keine Interferenz- oder Beugungsstruktur.",
            "essentialUnderstandingEn": "Rays approximately describe propagation directions and geometrical imaging; without additional wave information they contain no interference or diffraction structure.",
            "observablePerformanceDe": "W\u00e4hlt f\u00fcr eine gegebene Aperturfrage ein geeignetes Modell und erkl\u00e4rt die Abh\u00e4ngigkeit von Aperturgr\u00f6\u00dfe und Wellenl\u00e4nge.",
            "observablePerformanceEn": "Chooses an appropriate model for an aperture question and explains dependence on aperture size and wavelength."
          },
          {
            "id": "dispersion-limit",
            "essentialUnderstandingDe": "Ein Strahlenmodell mit wellenl\u00e4ngenabh\u00e4ngigem Brechungsindex kann Farbaufspaltung beschreiben; ein einziger konstanter Index kann dies nicht. Die mikroskopische Ursache der Dispersion ist dadurch noch nicht erkl\u00e4rt.",
            "essentialUnderstandingEn": "A ray model with wavelength-dependent refractive index can describe colour separation; one constant index cannot. This does not yet explain the microscopic cause of dispersion.",
            "observablePerformanceDe": "Unterscheidet Beschreibung und Erkl\u00e4rung und benennt pr\u00e4zise, welche Strahlenmodell-Annahme bei Dispersion zu erg\u00e4nzen ist.",
            "observablePerformanceEn": "Distinguishes description from explanation and states precisely which ray-model assumption needs extension for dispersion."
          }
        ],
        "coverageExpectations": {

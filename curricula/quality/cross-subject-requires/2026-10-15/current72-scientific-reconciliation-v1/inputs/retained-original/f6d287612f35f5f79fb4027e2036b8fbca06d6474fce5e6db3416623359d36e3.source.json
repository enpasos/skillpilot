        "expectations": [
          {
            "id": "transition-energy",
            "essentialUnderstandingDe": "Bei Emission sinkt die Atomenergie um die Photonenenergie h\u03bd, bei Absorption steigt sie um diesen Betrag; diskrete Niveaudifferenzen erlauben diskrete Linien.",
            "essentialUnderstandingEn": "During emission the atom loses the photon energy h\u03bd; during absorption it gains that amount. Discrete level differences allow discrete lines.",
            "observablePerformanceDe": "Die lernende Person konstruiert beschriftete Niveaus und gerichtete \u00dcberg\u00e4nge aus Energiedaten, ordnet Photonenenergien zu und erkl\u00e4rt die Auswahl aus einem einfallenden Spektrum.",
            "observablePerformanceEn": "The learner constructs labelled levels and directed transitions from energy data, assigns photon energies and explains selection from an incident spectrum."
          },
          {
            "id": "population-and-scope",
            "essentialUnderstandingDe": "Ein Niveauschema ist eine Energiedarstellung, keine Elektronenbahn; beobachtete Linien h\u00e4ngen auch von Anfangsbesetzung und erlaubten \u00dcberg\u00e4ngen ab.",
            "essentialUnderstandingEn": "A level diagram represents energy, not electron trajectories; observed lines also depend on initial populations and allowed transitions.",
            "observablePerformanceDe": "Die lernende Person sagt Linien bei ge\u00e4nderter Anfangsbesetzung voraus und nennt, welche \u00dcbergangsannahmen f\u00fcr diese Vorhersage gegeben sein m\u00fcssen.",
            "observablePerformanceEn": "The learner predicts lines for changed initial populations and states which transition assumptions must be supplied."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "transition-energy",
            "population-and-scope"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "direction-population",
            "textDe": "Absorption aus dem Grundzustand gegen\u00fcber Emission aus einem angeregten Zustand.",
            "textEn": "Absorption from the ground state versus emission from an excited state."
          },
          {
            "id": "path",
            "textDe": "Direkter \u00dcbergang gegen\u00fcber vorgegebener Kaskade.",
            "textEn": "Direct transition versus a specified cascade."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "ground-absorption",
            "taskDemandDe": "Ein Modellatom hat Niveaus 0, 2 und 5 eV, zun\u00e4chst nur Grundzustandsatome; die \u00dcberg\u00e4nge 0\u21942 und 0\u21945 seien erlaubt. Stelle dar, welche Photonen aus einem schwachen Gemisch von 2, 3 und 5 eV absorbiert werden k\u00f6nnen, bevor sich Besetzungen wesentlich \u00e4ndern.",
            "taskDemandEn": "A model atom has levels 0, 2 and 5 eV and initially only ground-state atoms; transitions 0\u21942 and 0\u21945 are allowed. Represent which photons from a weak mixture of 2, 3 and 5 eV can be absorbed before populations change appreciably.",
            "expectedPerformanceDe": "Zeichnet Aufw\u00e4rtspfeile mit 2 und 5 eV; 3 eV passt zwar zwischen die oberen Niveaus, aber nicht von der anf\u00e4nglich besetzten Ausgangslage. Begr\u00fcndet Linienauswahl durch Energieerhaltung und Besetzung.",
            "expectedPerformanceEn": "Draws upward arrows labelled 2 and 5 eV; 3 eV matches the upper-level gap but not an initially populated starting level. Explains line selection through energy conservation and population.",
            "understandingFocusDe": "Passende Energiedifferenz und besetztes Ausgangsniveau geh\u00f6ren zusammen.",
            "understandingFocusEn": "Matching energy difference and an occupied starting level must coincide."
          },
          {
            "id": "emission-cascade",
            "taskDemandDe": "Ein anderes Modellatom mit Niveaus 0, 1,5 und 4 eV startet oben. Direkter \u00dcbergang nach 0 sowie die Kaskade \u00fcber 1,5 eV seien erlaubt. Konstruiere beide Emissionswege und vergleiche die Photonen mit dem Gesamtsaldo.",
            "taskDemandEn": "A different model atom with levels 0, 1.5 and 4 eV starts at the top. Direct decay to 0 and a cascade through 1.5 eV are allowed. Construct both emission paths and compare the photons with the total energy balance.",
            "expectedPerformanceDe": "Kennzeichnet abw\u00e4rts 4 eV oder nacheinander 2,5 und 1,5 eV; die Kaskade gibt insgesamt ebenfalls 4 eV ab, nicht ein einziges Photon dieser Energie. Deutet die m\u00f6glichen Ensemblelinien ohne feste Einzelereignisfolge zu erfinden.",
            "expectedPerformanceEn": "Labels downward emission of 4 eV or successively 2.5 and 1.5 eV; the cascade also releases 4 eV in total, not one photon of that energy. Interprets possible ensemble lines without inventing a fixed individual-event sequence.",
            "understandingFocusDe": "Diskrete Spektrallinien bilden einzelne \u00dcberg\u00e4nge und nicht nur den Gesamtenergieverlust ab.",
            "understandingFocusEn": "Discrete spectral lines reflect individual transitions, not just the total energy loss."
          }
        ]
      }

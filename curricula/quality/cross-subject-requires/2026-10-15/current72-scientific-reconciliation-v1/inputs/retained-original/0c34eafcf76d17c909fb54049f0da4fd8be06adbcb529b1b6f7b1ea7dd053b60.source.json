      "wholePositiveProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "stationaere-zustaende",
            "essentialUnderstandingDe": "Im Bohr-Modell sind nur bestimmte station\u00e4re Bahnen mit quantisierten Energien und Drehimpuls L=n\u210f zugelassen; auf einer solchen Bahn wird keine Strahlung abgegeben.",
            "essentialUnderstandingEn": "In the Bohr model only particular stationary orbits with quantized energies and angular momentum L=n\u210f are allowed; no radiation is emitted on such an orbit.",
            "observablePerformanceDe": "Formuliert die Postulate in eigenen Worten und erkl\u00e4rt an einer ver\u00e4nderten Situation, welche Zust\u00e4nde das Modell erlaubt und weshalb station\u00e4r nicht kontinuierlich strahlend bedeutet.",
            "observablePerformanceEn": "States the postulates in their own words and explains in a changed situation which states the model allows and why stationary does not mean continuously radiating."
          },
          {
            "id": "uebergangsphoton",
            "essentialUnderstandingDe": "Absorption oder Emission bei einem Niveauwechsel verbindet die positive Photonenenergie hf mit der Energiedifferenz; sie ist nicht beliebig fein abstufbar.",
            "essentialUnderstandingEn": "Absorption or emission during a level change connects positive photon energy hf to the energy difference; it cannot vary arbitrarily continuously.",
            "observablePerformanceDe": "Sagt anhand weniger vorgegebener Niveaus m\u00f6gliche Energie\u00fcbertragungen und ihre Richtung voraus und kennzeichnet dies als Aussage des idealisierten Modells.",
            "observablePerformanceEn": "Predicts possible energy transfers and their direction from a few given levels and identifies this as a statement of the idealized model."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "stationaere-zustaende",
            "uebergangsphoton"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "zustand-uebergang",
            "textDe": "Station\u00e4rer Zustand gegen\u00fcber einer gezielten Anregung; erlaubte Bahn gegen\u00fcber erlaubter Photonenenergie.",
            "textEn": "A stationary state versus targeted excitation; an allowed orbit versus an allowed photon energy."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "anregung-aus-grundzustand",
            "taskDemandDe": "Ein idealisiertes Bohr-artiges Atom hat nur die betrachteten Niveaus \u22126, \u22122 und \u22121 eV und startet bei \u22126 eV. Vergleiche Einphotonenanregung mit 1 eV und 4 eV; Mehrphotonenprozesse und Linienbreiten bleiben au\u00dfer Betracht. Erkl\u00e4re die Vorhersage durch die Postulate.",
            "taskDemandEn": "An idealized Bohr-like atom has the considered levels \u22126, \u22122 and \u22121 eV and starts at \u22126 eV. Compare single-photon excitation with 1 eV and 4 eV; neglect multiphoton processes and linewidths. Explain the prediction using the postulates.",
            "expectedPerformanceDe": "4 eV passt zur Differenz nach \u22122 eV, 1 eV zu keinem \u00dcbergang vom Ausgangsniveau. Das Atom nimmt nicht beliebige Zwischenenergien an; ohne \u00dcbergang bleibt der station\u00e4re Zustand im Modell nichtstrahlend. Bei R\u00fcckkehr von \u22122 nach \u22126 eV werden 4 eV abgegeben.",
            "expectedPerformanceEn": "4 eV matches the gap to \u22122 eV, whereas 1 eV matches no transition from the initial level. The atom does not take arbitrary intermediate energies; without a transition the stationary state remains nonradiating in the model. Returning from \u22122 to \u22126 eV releases 4 eV.",
            "understandingFocusDe": "Quantisierung verbindet Zustandsauswahl mit konkreten Energie\u00fcbertragungen.",
            "understandingFocusEn": "Quantization connects state selection to concrete energy transfers."
          },
          {
            "id": "stationaere-bahn",
            "taskDemandDe": "Eine Skizze zeigt eine erlaubte Bohr-Bahn n=2 und schl\u00e4gt zus\u00e4tzlich eine station\u00e4re Bahn mit L=1,5\u210f sowie stetigen Energieverlust auf der n=2-Bahn vor. Erkl\u00e4re mit den Bohr-Postulaten, welche Modellvorhersage an ihre Stelle tritt; diskutiere keine modernen Elektronenbahnen.",
            "taskDemandEn": "A sketch shows an allowed Bohr orbit n=2 and additionally proposes a stationary orbit with L=1.5\u210f and continuous energy loss on the n=2 orbit. Use Bohr's postulates to explain the model prediction that replaces these proposals; do not discuss modern electron trajectories.",
            "expectedPerformanceDe": "Ganzzahliges n erlaubt nicht L=1,5\u210f. Die n=2-Bahn ist im Modell station\u00e4r und strahlt nicht kontinuierlich; Energieabgabe erfolgt bei einem \u00dcbergang zu einem niedrigeren erlaubten Niveau mit hf=E_i\u2212E_f. Kennzeichnet die Bahn als historische Idealisierung, nicht als beobachtete Elektronenspur.",
            "expectedPerformanceEn": "Integer n does not allow L=1.5\u210f. In the model the n=2 orbit is stationary and does not radiate continuously; energy is emitted on a transition to a lower allowed level, with hf=E_i\u2212E_f. Identifies the orbit as a historical idealization, not an observed electron track.",
            "understandingFocusDe": "Die Postulate ersetzen die klassische kontinuierliche Strahlungserwartung durch diskrete Zust\u00e4nde und \u00dcberg\u00e4nge.",
            "understandingFocusEn": "The postulates replace the classical expectation of continuous radiation with discrete states and transitions."
          }
        ]
      }

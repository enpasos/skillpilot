import{readFileSync,writeFileSync}from'node:fs';import{resolve}from'node:path';import{pathToFileURL}from'node:url';
const R=process.env.SCIENCE_REPLAY_ROOT!,L=process.env.SCIENCE_REPLAY_WORK!,P=process.env.SCIENCE_REPLAY_PACKET!,j=(p:string)=>JSON.parse(readFileSync(p,'utf8'));
const{stableJson,fingerprint}=await import(pathToFileURL(R+'/app/scripts/lib/crossSubjectRequiresInventory.ts').href);const eq=(a:any,b:any,s:string)=>{if(stableJson(a)!==stableJson(b))throw Error(s)};
const fresh=j(resolve(L,'QUALIFICATION.current72.actual.json')),a=j(resolve(P,'requires-author.native-bound.actual.json')),q=j(resolve(P,'requires-independent-review.native-bound.actual.json')),u=j(resolve(P,'requires-author.original-unbound.actual.json')),rows=[];
for(const x of fresh.qualified){const d=a.decisions.find((z:any)=>z.dependentGoalId===x.goalId),r=q.decisions.find((z:any)=>z.decisionId===d.decisionId),original=u.decisions.find((z:any)=>z.decisionId===d.decisionId);const bound={...d};delete bound.proposalBinding;eq(bound,original,'prepared author fields diverge '+x.goalId);eq(d.scientificTransport.originalJudgmentSnapshot,x.originalAuthorRecord,'author original snapshot');eq(r.scientificTransport.originalJudgmentSnapshot,x.originalPeerRecord,'peer original snapshot');eq(d.rationale,JSON.stringify(x.originalAuthorRecord,null,2),'author full rationale');eq(r.rationale,JSON.stringify(x.originalPeerRecord,null,2),'peer full rationale');eq(d.author,x.author,'author identity');eq(r.reviewer,x.peer,'reviewer identity');eq(r.decision,x.peerDecision??'approved','independent verdict');eq(d.positiveEvidenceCondition,x.condition,'author whole condition');eq(r.positiveEvidenceCondition,x.condition,'peer whole condition');eq(r.proposalBindingSha256,fingerprint(d.proposalBinding),'normal proposal binding');rows.push({goalId:x.goalId,originalAuthorSnapshot:fingerprint(x.originalAuthorRecord),originalPeerSnapshot:fingerprint(x.originalPeerRecord),independentVerdict:r.decision})}
eq(rows.length,22,'exact genuine current pair rows');eq(rows.filter(x=>x.independentVerdict==='approved').length,21,'approved rows');eq(rows.filter(x=>x.independentVerdict==='rejected').length,1,'rejected rows');writeFileSync(resolve(L,'ORIGINAL-SNAPSHOT-REPLAY.actual.json'),JSON.stringify({rows,newScientificJudgment:false},null,2)+'\n');console.log(JSON.stringify({exactOriginalSnapshots:rows.length,approved:21,rejected:1}));

    {
      "decisionId": "canonical-physics-839ecc8f-3a60-418b-bc92-64bfeef33824",
      "familyId": "canonical-gymnasium",
      "dependentGoalId": "839ecc8f-3a60-418b-bc92-64bfeef33824",
      "dependentTitle": "Impulserhaltung",
      "dependentDescription": "Die lernende Person kann in einem abgegrenzten System ohne resultierenden \u00e4u\u00dferen Kraftsto\u00df den Gesamtimpuls als vektorielle Erhaltungsgr\u00f6\u00dfe nutzen und einfache R\u00fccksto\u00dfsituationen damit qualitativ begr\u00fcnden.",
      "prerequisiteGoalIds": [],
      "decision": "no_cross_subject_required",
      "rationale": "Die vollst\u00e4ndige BY-Quelle bleibt mit einem obligatorischen echten zweidimensionalen Sto\u00df und der Abgrenzung gegen kinetische beziehungsweise gesamte Energie erhalten. Gesamtpfeile und Erhaltungsfolgerung fehlen als Eing\u00e4nge. Eine allgemeine mathematische Pfeilkonstruktionsregel steht explizit zur Verf\u00fcgung; die lernende Person w\u00e4hlt das physikalische System, konstruiert aus den richtigen Einzelmomenten die Summe und begr\u00fcndet die Aussage selbst. Das ganze c63-P verlangt zus\u00e4tzlich selbst\u00e4ndige 2D/3D-Komponentenrechnung; diese ist in der zul\u00e4ssigen grafisch unterst\u00fctzten qualitativen Route nicht notwendig. Andere breite Mathematikatome sind ebenfalls keine unvermeidliche Vorleistung. Daher Autorenkandidat ohne fachfremde Pflicht-Mastery, mit vollst\u00e4ndigem physikalischem Quellenumfang und neuer unabh\u00e4ngiger Pr\u00fcfungspflicht.",
      "evidenceKind": "didacticSequencing",

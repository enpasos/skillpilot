{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "audience",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "audience": {
      "const": "learner"
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "place"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^decimal-case-00[1-6]$"
          },
          "number": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$"
          },
          "place": {
            "enum": [
              "hundredths",
              "thousandths",
              "ten_thousandths"
            ]
          }
        }
      }
    }
  }
}

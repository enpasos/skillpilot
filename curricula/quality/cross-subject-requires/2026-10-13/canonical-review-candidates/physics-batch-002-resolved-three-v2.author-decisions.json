    "dependentGoalId": "d6dc0e02-831d-4894-a61a-852bcc74f147",
    "dependentTitle": "Modellierung und Idealisierung von Bewegungen",
    "dependentDescription": "Die lernende Person kann Bewegungen mit Zeit-Ort- und Zeit-Geschwindigkeits-Gesetzen modellieren, die verwendeten Idealisierungen wie Massepunkt und Reibungsfreiheit begründen und die Grenzen der Modellvorhersagen angeben.",
    "prerequisiteGoalIds": [
      "f08d06dc-139d-5fd2-892c-8cc919b1e4fc"

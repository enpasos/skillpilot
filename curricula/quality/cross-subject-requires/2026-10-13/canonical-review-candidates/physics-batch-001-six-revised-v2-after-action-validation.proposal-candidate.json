    {
      "decisionId": "canonical-physics-a24c41ce-68c5-56a7-8235-ef9a7dba7042",
      "familyId": "canonical-gymnasium",
      "dependentGoalId": "a24c41ce-68c5-56a7-8235-ef9a7dba7042",
      "dependentTitle": "Schallgeschwindigkeiten in verschiedenen Medien vergleichen und begründen",
      "dependentDescription": "Die lernende Person kann Schallgeschwindigkeiten in verschiedenen Medien anhand von Daten vergleichen, Unterschiede mit elastischer Kopplung und Trägheit im Teilchenmodell begründen und eine vorschnelle Rangfolge allein nach Aggregatzuständen prüfen.",
      "prerequisiteGoalIds": [],
      "decision": "no_cross_subject_required",
      "rationale": "Die verbindliche kanonische Leistung ist datenbasiertes Vergleichen, Teilchenmodellbegründung und Gegenprüfung einer Aggregatzustandspauschale. BW 3.2.2(13) fordert Gemeinsamkeiten/Unterschiede beschreiben, HE 8.3b Schallgeschwindigkeit im Teilchenbild; keines setzt eine bestimmte Differenz-/Verhältnisrechnung in jedem Scope voraus. Der aktuelle P-Fall macht solche Rechnungen fälschlich obligatorisch, obwohl er sie selbst als Alternativen behandelt. Vorgeschlagen wird eine fachliche P-Korrektur: konkrete Werte, Einheiten, Bedingungen und ein Gegenvergleich bleiben Pflicht; zusätzliche Differenz- oder Verhältnisquantifizierung wird fakultative Vertiefung. Keine AND-Pflicht aus Subtraktion und Division und kein künstliches OR-Mathematikatom.",
      "evidenceKind": "didacticSequencing",

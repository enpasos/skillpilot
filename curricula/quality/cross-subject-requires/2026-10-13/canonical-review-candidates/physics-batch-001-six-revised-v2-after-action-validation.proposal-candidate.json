    {
      "decisionId": "canonical-physics-264dc31c-ec92-5e39-a8b8-16f1d74366d4",
      "familyId": "canonical-gymnasium",
      "dependentGoalId": "264dc31c-ec92-5e39-a8b8-16f1d74366d4",
      "dependentTitle": "Methode: Linearisierung von Messkurven",
      "dependentDescription": "Die lernende Person kann nichtlineare Messdaten durch geeignete Transformationen linearisieren, Geraden anpassen und Parameter deuten (z. B. $s\\sim t^2$, Einstein-Gerade).",
      "prerequisiteGoalIds": [
        "f08d06dc-139d-5fd2-892c-8cc919b1e4fc",
        "af3d6bff-c5fb-4ec6-a9f0-c0be09fc9186",

    {
      "decisionId": "canonical-physics-2a6703e0-2a6f-4ebf-a5c6-7aa05a4b86eb",
      "familyId": "canonical-gymnasium",
      "dependentGoalId": "2a6703e0-2a6f-4ebf-a5c6-7aa05a4b86eb",
      "dependentTitle": "Kern und Hülle des Atoms qualitativ beschreiben",
      "dependentDescription": "Die lernende Person kann Kern und Elektronenhülle als Bestandteile eines Atommodells beschreiben und die Größenordnungen von Atom- und Kerndurchmesser vergleichen.",
      "prerequisiteGoalIds": [
        "26f668a0-6425-5466-9cf7-6295dd189005",
        "ee48e811-4c9c-5080-9836-8403fc9f0810"
      ],
      "decision": "add",
      "rationale": "Der Größenordnungs- und Durchmesserfaktorvergleich verlangt die Bedeutung sehr kleiner Größen mit negativen Zehnerpotenzen und einen Quotienten der bereitgestellten Durchmesser. Das genaue aktuelle P-Profil 1,2·10^-10m gegen 1,0·10^-15m sowie die lineare Analogie bestätigen diesen Kern. Potenzen mit rationalen Basen/negativen Exponenten und rationale Multiplikation/Division passen; allgemeine Einheitenumrechnung ist nicht universell nötig, weil beide Daten in Metern vorliegen und die Analogie auch korrekt in Millimetern bleiben kann. Potenzgesetze werden nicht als eigener AND-Rechenweg erzwungen, da die Zahlen auch digital als Quotient ausgewertet werden können.",
      "evidenceKind": "didacticSequencing",

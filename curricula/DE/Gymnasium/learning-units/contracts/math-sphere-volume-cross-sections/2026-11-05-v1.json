    "79f5f4cc-10e1-56a5-8ed3-8cd51688db41": {
      "id": "79f5f4cc-10e1-56a5-8ed3-8cd51688db41",
      "title": "Kugelvolumen durch Querschnittsvergleich herleiten (Jahrgangsstufe 10, 12 BE)",
      "titleEn": "Derive sphere volume by comparing cross sections (Year 10, 12 points)",
      "description": "Die lernende Person kann in einer eigenständigen Prüfungsaufgabe die Querschnitte einer Kugel mit denen eines Zylinders ohne zwei Kegel vergleichen, die Voraussetzungen von Cavalieri begründen und daraus die Kugelvolumenformel herleiten.",
      "descriptionEn": "The learner can independently compare the cross sections of a sphere with those of a cylinder minus two cones, justify the conditions of Cavalieri’s principle, and derive the sphere-volume formula.",

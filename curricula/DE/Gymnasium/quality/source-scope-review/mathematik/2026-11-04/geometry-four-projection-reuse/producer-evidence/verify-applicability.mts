import assert from'node:assert/strict'
import{readFileSync,writeFileSync}from'node:fs'
import{resolve,dirname}from'node:path'
import{fileURLToPath,pathToFileURL}from'node:url'
const H=dirname(fileURLToPath(import.meta.url)),R=resolve(H,'../../..'),cfg=JSON.parse(readFileSync(resolve(H,'integration-config.json'),'utf8')),B=resolve(R,cfg.baseHost),C=resolve(H,'check-host'),rows:any[]=[]

              "points": 6,
              "description": "beide Quadratsummen 2; beide Varianzen 1; beide SD 1; Streuungsvergleich 1; richtige Einheiten/keine Garantie 1",
              "descriptionEn": "two squared-deviation sums 2; two variances 1; two SDs 1; spread comparison 1; units/no guarantee 1"
            },
            {
              "id": "new_he_g8_descriptive_statistics_4",
              "points": 5,
              "description": "neue Lagewerte 1; neue Quadratsumme/Varianz 1; neue SD 1; Ausreißerwirkung 1; sachliche Kausalitätsgrenze 1",
              "descriptionEn": "new location measures 1; new squared sum/variance 1; new SD 1; outlier effect 1; contextual causal limit 1"
            }

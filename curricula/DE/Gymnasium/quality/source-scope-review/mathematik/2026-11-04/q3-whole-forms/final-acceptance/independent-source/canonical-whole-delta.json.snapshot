              "id": "new_bw_independence_1",
              "points": 5,
              "description": "vier Innenfelder/Randsummen 2; erste Baumstufe 1; bedingte zweite Stufe 1; korrekte Verbindung zur Tafel 1",
              "descriptionEn": "cells/margins 2; first tree stage 1; conditional second stage 1; table-tree consistency 1"
            },
            {
              "id": "new_bw_independence_2",
              "points": 5,
              "description": "vier Wahrscheinlichkeiten je 1; unterschiedliche Bezugsgruppen 1",
              "descriptionEn": "four probabilities 1 each; different reference groups 1"
            },
            {
              "id": "new_bw_independence_3",
              "points": 6,
              "description": "gültiges Kriterium 2; Einsetzen und Abhängigkeit 2; Deutung 1; begründete Kausalitätsgrenze 1",
              "descriptionEn": "valid criterion 2; substitution and dependence 2; interpretation 1; reasoned causal limit 1"
            },
            {
              "id": "new_bw_independence_4",
              "points": 4,
              "description": "Gleichung 1; 28,8 1; ganzzahlige Unmöglichkeit 1; Nähe ist keine exakte Unabhängigkeit 1",
              "descriptionEn": "equation 1; 28.8 1; integer impossibility 1; closeness is not exact independence 1"

    {
      "id": "57833097-393c-5a08-8c03-e161b43cb9cc",
      "title": "Prüfung: Stichproben mit und ohne Zurücklegen vergleichen",
      "titleEn": "Assessment: Compare sampling with and without replacement",
      "description": "Die lernende Person kann die vollständige Prüfung selbstständig bearbeiten und ihre Ergebnisse fachlich begründen.",
      "descriptionEn": "The learner can complete the whole assessment independently and justify the results.",
      "weight": 1,
      "tags": [
        "GK",
        "LK",
        "Practice",
        "Assessment"
      ],
      "contains": [],
      "requires": [
        "bd63c0fc-50ef-55aa-ae6c-25cf73d02636",
        "dabff49b-d40a-4c81-a584-21408b2d4219"
      ],
      "dimensionTags": {
        "framework": "canonical-gymnasium-math",
        "demandLevel": "AB3",
        "processCompetencies": [
          "K2",

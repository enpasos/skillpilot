              "points": 5,
              "description": "sechs Anordnungen 2; feste Folge 1; disjunkte Summation 1; Ergebnis und Deutung 1",
              "descriptionEn": "six arrangements 2; fixed sequence 1; disjoint sum 1; result and interpretation 1"
            },
            {
              "id": "new_bw_binomial_comparison_3",
              "points": 5,
              "description": "vollständige Tabelle 2; passend beschriftetes Histogramm 2; Gegenereignis 1",
              "descriptionEn": "complete table 2; labelled matching histogram 2; complement probability 1"
            },
            {
              "id": "new_bw_binomial_comparison_4",
              "points": 7,
              "description": "A/B Lage, absolute Streuung, Schiefe je 1; A/C Lage, Streuung, Symmetrie je 1; konkrete Begründung oder Grenze allgemeiner p-Aussage 1",
              "descriptionEn": "A/B location, absolute spread, skew 1 each; A/C location, spread, symmetry 1 each; concrete justification or limit of general p claim 1"
            }

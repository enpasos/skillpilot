  "wholeBilingualDeckContracts": {
    "de": {
      "deckId": "de_gymnasium_math_stochastics_core",
      "title": "Stochastik-Core - Kernaussagen",
      "cards": [
        {
          "id": "math_stoch_c01",
          "front": "Formel für bedingte Wahrscheinlichkeit $P(A|B)$",
          "back": "$P(A|B) = \\frac{P(A \\cap B)}{P(B)}$",
          "category": "Grundlagen",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c02",
          "front": "Bedingung für stochastische Unabhängigkeit von $A$ und $B$",
          "back": "$P(A \\cap B) = P(A) \\cdot P(B)$",
          "category": "Grundlagen",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c03",
          "front": "Laplace-Experiment: Bedingung und Berechnung",
          "back": "Alle Ergebnisse sind gleich wahrscheinlich.\n\n$P(E) = \\frac{\\text{Anzahl günstige Ergebnisse}}{\\text{Anzahl mögliche Ergebnisse}}$",
          "category": "Grundlagen",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c04",
          "front": "Erwartungswert $E(X)$ einer Zufallsgröße",
          "back": "Summe der Produkte aus Wert und Wahrscheinlichkeit.\n\n$\\mu = \\sum x_i \\cdot P(X=x_i)$",
          "category": "Kenngrößen",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c05",
          "front": "Binomialkoeffizient $\\binom{n}{k}$: Bedeutung",
          "back": "Anzahl der Möglichkeiten, $k$ Elemente aus $n$ Elementen auszuwählen.\n\nOhne Reihenfolge, ohne Zurücklegen.",
          "category": "Kombinatorik",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c06",
          "front": "Bernoulli-Formel (Binomialverteilung)",
          "back": "$P(X=k) = \\binom{n}{k} \\cdot p^k \\cdot (1-p)^{n-k}$",
          "category": "Verteilungen",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c07",
          "front": "Erwartungswert $\\mu$ einer Binomialverteilung",
          "back": "$\\mu = n \\cdot p$",
          "category": "Verteilungen",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c08",
          "front": "Standardabweichung $\\sigma$ einer Binomialverteilung",
          "back": "$\\sigma = \\sqrt{n \\cdot p \\cdot (1-p)}$",
          "category": "Verteilungen",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c09",
          "front": "1-2-3-Sigma-Regel (Normalverteilung)",
          "back": "$\\approx 68\\%$ in $[\\mu-\\sigma,\\mu+\\sigma]$\n\n$\\approx 95\\%$ in $[\\mu-2\\sigma,\\mu+2\\sigma]$\n\n$\\approx 99{,}7\\%$ in $[\\mu-3\\sigma,\\mu+3\\sigma]$",
          "category": "Verteilungen",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c10",
          "front": "Hypothesentest: \n\nFehler 1. Art ($\\alpha$-Fehler)",
          "back": "Die Nullhypothese $H_0$ wird abgelehnt, obwohl sie wahr ist.",
          "category": "Tests",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c11",
          "front": "Hypothesentest: \n\nFehler 2. Art ($\\beta$-Fehler)",
          "back": "Die Nullhypothese $H_0$ wird beibehalten, obwohl die Alternativhypothese $H_1$ wahr ist.",
          "category": "Tests",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c12",
          "front": "Rechtsseitiger Test: Aufbau der Nullhypothese",
          "back": "$H_0: p \\le p_0$.\n\nAblehnungsbereich liegt rechts.",
          "category": "Tests",
          "tags": [
            "GK",
            "LK"
          ]
        }
      ],
      "landscapeId": "68a8ac50-f5f5-4e24-8aa9-5e408ca01ced"
    },
    "en": {
      "deckId": "de_gymnasium_math_stochastics_core",
      "title": "Core Stochastics - Key Statements",
      "cards": [
        {
          "id": "math_stoch_c01",
          "front": "Formula for conditional probability $P(A|B)$",
          "back": "$P(A|B) = \\frac{P(A \\cap B)}{P(B)}$",
          "category": "Basics",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c02",
          "front": "Condition for stochastic independence of $A$ and $B$",
          "back": "$P(A \\cap B) = P(A) \\cdot P(B)$",
          "category": "Basics",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c03",
          "front": "Laplace experiment: condition and calculation",
          "back": "All outcomes are equally likely.\n\n$P(E) = \\frac{\\text{number of favorable outcomes}}{\\text{number of possible outcomes}}$",
          "category": "Basics",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c04",
          "front": "Expected value $E(X)$ of a random variable",
          "back": "Sum of products of value and probability.\n\n$\\mu = \\sum x_i \\cdot P(X=x_i)$",
          "category": "Measures",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c05",
          "front": "Binomial coefficient $\\binom{n}{k}$: meaning",
          "back": "Number of ways to choose $k$ elements from $n$ elements.\n\nWithout order, without replacement.",
          "category": "Combinatorics",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c06",
          "front": "Bernoulli formula (binomial distribution)",
          "back": "$P(X=k) = \\binom{n}{k} \\cdot p^k \\cdot (1-p)^{n-k}$",
          "category": "Distributions",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c07",
          "front": "Expected value $\\mu$ of a binomial distribution",
          "back": "$\\mu = n \\cdot p$",
          "category": "Distributions",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c08",
          "front": "Standard deviation $\\sigma$ of a binomial distribution",
          "back": "$\\sigma = \\sqrt{n \\cdot p \\cdot (1-p)}$",
          "category": "Distributions",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c09",
          "front": "1-2-3 sigma rule (normal distribution)",
          "back": "$\\approx 68\\%$ in $[\\mu-\\sigma,\\mu+\\sigma]$\n\n$\\approx 95\\%$ in $[\\mu-2\\sigma,\\mu+2\\sigma]$\n\n$\\approx 99.7\\%$ in $[\\mu-3\\sigma,\\mu+3\\sigma]$",
          "category": "Distributions",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c10",
          "front": "Hypothesis test:\n\nType I error ($\\alpha$ error)",
          "back": "The null hypothesis $H_0$ is rejected even though it is true.",
          "category": "Tests",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c11",
          "front": "Hypothesis test:\n\nType II error ($\\beta$ error)",
          "back": "The null hypothesis $H_0$ is retained even though the alternative $H_1$ is true.",
          "category": "Tests",
          "tags": [
            "GK",
            "LK"
          ]
        },
        {
          "id": "math_stoch_c12",
          "front": "Right-tailed test: form of the null hypothesis",
          "back": "$H_0: p \\le p_0$.\n\nRejection region is on the right.",
          "category": "Tests",
          "tags": [
            "GK",
            "LK"
          ]
        }
      ],
      "landscapeId": "68a8ac50-f5f5-4e24-8aa9-5e408ca01ced"
    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/goal-evidence/v2/goal-evidence-review-config.schema.json",
  "title": "SkillPilot positive understanding-evidence review configuration v2",
  "description": "Repository-local configuration for a bounded positive understanding-evidence review ledger. AI-authored records remain candidates unless requireApproved is enabled for a separately human-approved scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "reviewId",
    "goalFingerprintRuleVersion",
    "profileRuleVersion",
    "landscapeId",
    "landscapePath",
    "semanticKindLedgerPath",
    "reviewCriteriaPath",
    "reviewPath",
    "reviewedResourceTypes",
    "requireApproved",
    "scope"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/goal-evidence/v2/goal-evidence-review-config.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "reviewId": {
      "$ref": "#/$defs/slug"
    },
    "goalFingerprintRuleVersion": {
      "const": "goal-evidence-v1"
    },
    "profileRuleVersion": {
      "const": "positive-understanding-evidence-v2"
    },
    "landscapeId": {
      "$ref": "#/$defs/nonBlank"
    },
    "landscapePath": {
      "$ref": "#/$defs/repositoryPath"
    },
    "semanticKindLedgerPath": {
      "$ref": "#/$defs/repositoryPath"
    },
    "reviewCriteriaPath": {
      "$ref": "#/$defs/repositoryPath"
    },
    "reviewPath": {
      "$ref": "#/$defs/repositoryPath"
    },
    "reviewRunManifestPaths": {
      "description": "Optional repository-local manifests for the exact AI review runs cited by reviewRunIds. Empty reviewRunIds remain valid without manifests; every configured manifest must be referenced and every cited run ID must resolve uniquely.",
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "reviewedResourceTypes": {
      "description": "Resource bytes intentionally reviewed as part of this profile scope. An empty array keeps visualization review in its existing independent QA lane.",
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["goal-visualization"]
      }
    },
    "requireApproved": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "goalIds"],
      "properties": {
        "label": {
          "$ref": "#/$defs/nonBlank"
        },
        "goalIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlank"
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))\\S(?:[\\s\\S]*\\S)?$"
    }
  }
}

    },
    {
      "goalId": "ffef97e3-12d6-5090-9816-46ab9e57fae2",
      "atomicityContentDecision": "keep",
      "atomicityReason": "One given genetic-change analysis linking its event type to a justified possible encoded-protein consequence. The profile avoids a second independent trait diagnosis or whole functional-risk assessment.",
      "memoryDecision": "no_memory_needed",
      "memoryReason": "Given reference/variant sequences, origin traces, reading frame and code data support analysis. The learner must justify classification and bounded consequences; no additional memorisation deck is necessary.",
      "sourceScopeDecision": "block"
    },
    {
      "goalId": "e70d8a85-2dea-5165-919b-200fee9f4db4",
      "atomicityContentDecision": "keep",
      "atomicityReason": "One semiconservative copying mechanism with its significance for retained information. Tracing material labels through a further round tests the same mechanism and its material/information distinction.",

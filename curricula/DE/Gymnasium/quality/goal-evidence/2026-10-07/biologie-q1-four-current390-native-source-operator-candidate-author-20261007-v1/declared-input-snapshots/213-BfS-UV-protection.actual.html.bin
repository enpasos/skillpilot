 47.827l1.422-10.463.991.134-1.422 10.464zM54.152 48.579l.6-4.42.991.135-.6 4.42zM57.245 49.338l3.65-26.863.992.134-3.651 26.863zM60.341 50.097l1.956-14.388.99.135-1.955 14.388zM63.447 50.845l2.17-15.963.99.134-2.169 15.964zM66.554 51.608l2.202-16.2.991.134-2.202 16.201zM69.644 52.357l3.559-26.18.99.136-3.558 26.179zM72.748 53.125l3.123-22.98.99.136-3.122 22.978z"></path><path fill="#625c81" d="M8.059 37.964l.123-.993 68.433 8.512-.123.992z"></path><path fill="#e0dee6" d="M12.087 40.412l.26-1.912.99.134-.26 1.913zM14.888 42.876l.495-3.636.99.134-.494 3.637zM19.315 45.72l.727-5.352.99.135-.727 5.35zM24.179 45.287l.514-3.785.991.134-.514 3.786zM27.14 47.017l.647-4.766.991.134-.648 4.767zM29.517 53.087l1.368-10.068.99.135-1.368 10.067zM33.195 49.571l.788-5.796.991.134-.788 5.797zM35.618 55.333l1.468-10.801.99.135-1.467 10.8zM39.9 47.396l.286-2.11.99.133-.285 2.111zM41.622 58.27l1.662-12.227.991.135-1.662 12.227zM50.118 54.654l.915-6.728.99.135-.914 6.728zM53.527 53.1l.6-4.419.992.135-.601 4.42zM64.702 53.443l.287-2.11.991.134-.287 2.111zM2.703 51.106l6.116-46.52.991.13-6.116 46.52z"></path><path fill="#e0dee6" d="M3.078 51.654l.237-.971 70.573 17.204-.237.971zM15.42 8.239l.196-.98 11.08 2.215-.196.98z"></path></g></g></svg><svg xmlns="http://www.w3.org/2000/svg" width="84.6" height="73.59" viewBox="0 0 84.6 73.59" class="UVScene5_screen3__lRai6"><g data-name="Ebene 2"><g data-name="S7"><path fill="#918da7" d="M76.47 73.59L0 53.69 6.1 0l78.5 14.44-8.13 59.15z"></path><path fill="#e0dee6" d="M75.27 69.17L3.9 51.46 9.02 7.07l.99.11L4.99 50.7l70.52 17.5-.24.97z"></path><path fill="#625c81" d="M6.32 44.35l-.3-.95 7.29-2.28 2.28.98 4.33-2.26 4.58-.27 5.65 3.09 7.05-1.26 5.47.5 5.11.05 9.81-3.85 5.76 2.65 3.27-11.46 4.53.18 3.33-2.67 3.22.22-.45 3.71 2.47-1.36.49.88-4.18 2.3.55-4.6-1.77-.12-3.32 2.65-4.12-.16-3.38 11.83-6.43-2.96-9.59 3.76-5.35-.05-5.38-.49-7.26 1.3-5.71-3.12-4.18.24-4.46 2.38-2.38-1.03-6.93 2.17z"></path><path fill="#e0dee6" d="M36.36 50.33l-3.34-9.65-3.1-1.09-3.6-1.64-5.03 9.88-1.7-6.41-3.12-2.22-3.9 7.98-6.33-7.62.77-.64 5.34 6.44 3.74-7.65 4.37 3.11 1.13 4.22 4.28-8.4 4.42 2.03 3.51 1.22 2.65 7.64 4.32-10.34 6.08 1.69 5.92-7.78 7.37 5.69 2.97-2.97 8.81-1.12 6.55 2.56-.36.93-6.32-2.46-8.22 1.04-3.35 3.35-7.26-5.61-5.72 7.52-5.89-1.64-4.99 11.94zM14.156 9.57l.196-.98 14.964 2.993-.196.98zM13.71 12.67l.196-.98 14.964 2.992-.197.981zM13.05 16.331l.196-.98 10.364 2.072-.196.981z"></path></g></g></svg></div></div></div></div><div class="UVScene5_inner__nsszU"><div class="UVScene5_backgroundContainer__pxNDe"><figure class="UVScene5_bottomBackground__qXUI0"></figure></div></div></div><div class="print-only"><h3 class="headline-3">Niedrig-Ozon-Ereignisse</h3><div><p>In den letzten Jahrzehnten treten vermehrt Ozonl&ouml;cher &uuml;ber der Arktis auf. Am Ende des Winters, mit &Auml;nderung der Wetterlage, k&ouml;nnen die ozonarmen Luftmassen daraus nach S&uuml;den driften. Diese driftenden, ozonarmen Luftmassen sind so genannte Niedrig-Ozon-Ereignisse, die auch Deutschland erreichen.</p>
<p>&nbsp;</p>
<p>Eine geringere Ozonkonzentration in der Atmosph&auml;re bedeutet einen h&ouml;heren UV-B-Anteil in der UV-Strahlung, die die Erdoberfl&auml;che erreicht. Solche Niedrig-Ozon-Ereignisse k&ouml;nnen daher bereits Ende M&auml;rz bzw. Anfang April in Deutschland zu pl&ouml;tzlichen, unerwartet hohen UV-Bestrahlungsst&auml;rken f&uuml;hren. Also in einer Jahreszeit, in der niemand damit rechnet.</p>
<p>&nbsp;</p>
<p>Niedrig-Ozon-Ereignisse sind gesundheitlich relevant, da sich dadurch das Risiko f&uuml;r UV-bedingte Erkrankungen erh&ouml;ht &ndash; auch f&uuml;r Krebserkrankungen an Auge und Haut.</p></div></div><div class="section bg-violet-50-20 clip-pad-top-uv-xs clip-pad-bottom-uv-xs"><div class="Paragraph_inner__LZf66"><div class="Paragraph_paragraph__RBIN1"><p>Silke: &bdquo;Hat denn der Klimawandel noch weitere Auswirkungen auf die UV-Strahlung?&ldquo;</p>
<p>Laura: &bdquo;Ja! &Uuml;ber Deutschland steigt die Anzahl an Sonnenstunden. Das bedeutet mehr Zeit, in der UV-Strahlung ungehindert die Erdoberfl&auml;che &ndash; und unsere K&ouml;rper &ndash; erreichen kann. Dadurch steigt die UV-Jahresdosis. Au&szlig;erdem erh&ouml;ht sich die Temperatur. Es gibt mehr Tage, an denen es richtig hei&szlig; ist, aber auch mehr Tage mit Wohlf&uuml;hltemperaturen. Das beeinflusst unser Verhalten. An hei&szlig;en Tagen bleiben wir eher in der k&uuml;hlen Wohnung. Aber wenn es angenehm warm ist, verbringen wir mehr Zeit drau&szlig;en und bekommen folglich mehr UV-Strahlen ab.</p>
<p>Dazu kommt: Wir setzen uns auch unfreiwillig UV-Strahlen aus, wenn wir keinen Schatten finden. Sei es im Park, in der Stadt oder auf dem Spielplatz. &Uuml;berleg dir mal: Menschen, die im Freien arbeiten, k&ouml;nnen sich h&auml;ufig &uuml;berhaupt nicht vor UV-Strahlung sch&uuml;tzen.&ldquo;</p>
<p>Silke: &bdquo;Also liegt es in unserer Verantwortung, uns vor UV-Strahlung zu sch&uuml;tzen, oder?&ldquo; Laura: &bdquo;Ja, auch! Es kommt aber auch darauf an, dass man zu intensiver UV-Strahlung aus dem Weg gehen kann &ndash; im Beruf wie in der Freizeit. Da ist auch die Politik gefragt.&ldquo;</p></div></div></div><div class="no-print"><div class="UVScene6_inner__hHl0t"><div class="UVScene6_upperBackgroundContainer__LqudZ"><figure class="UVScene6_upperBackground__8ZFq3"></figure></div></div><div class="UVScene6_container__9Dvvq"><figure class="UVScene6_lightboxTrigger___WiYz"><button class="LightboxTrigger_wrapper__k_bmz no-print" type="button" aria-label="Anzahl Sonnenstunden Modal öffnen"><span class="bold-text semibold-font magnifying-glass-bg-right LightboxTrigger_magnifyingGlassRight__ZbgD_">Anzahl Sonnenstunden</span></button></figure></div><div class="UVScene6_wrapper__8PmZP" id="uv-scene-6"></div><div class="UVScene6_inner__hHl0t"><div class="UVScene6_backgroundContainer__X_E08"><figure class="UVScene6_headingBackground__gPzni"></figure></div></div></div><div class="print-only"><h3 class="headline-3">Anzahl Sonnenstunden</h3><div><p>In den letzten Jahrzehnten steigt in Deutschland die Anzahl der Jahre mit auff&auml;llig vielen Sonnenscheinstunden.</p>
<p>Daten des deutschlandweiten UV-Messnetzes zeigen, dass sich in Jahren mit vielen Sonnenscheinstunden ebenfalls die Jahressumme der UV-Bestrahlungsst&auml;rke erh&ouml;ht: In 2003 und 2018 beispielsweise lag diese Summe deutlich &uuml;ber dem 20-j&auml;hrigen Mittel. Damit erh&ouml;ht sich die m&ouml;gliche j&auml;hrliche UV-Belastung der Menschen.</p></div></div><div class="section bg-violet-50-20  clip-pad-top-uv-xs"><div class="SectionHeading_inner__zw_y_"><h2 class="SectionHeading_h2__tbZ9L headline-2" id="klimawandelunduvbedingteerkrankungen">Klimawandel und UV-bedingte Erkrankungen</h2></div></div><div class="section bg-violet-50-20 clip-pad-bottom-uv-xs"><div class="Paragraph_inner__LZf66"><div class="Paragraph_paragraph__RBIN1"><p>Immer noch kein Anruf vom Hautarzt. Silke stellt derweil fest: &bdquo;Dann h&auml;ngen Klimawandel und UV-bedingte Erkrankungen auch zusammen.&ldquo; Laura: &bdquo;Genau. Die Hautkrebs-F&auml;lle aufgrund von UV-Strahlung haben in den letzten Jahrzehnten stetig zugenommen.&ldquo;</p>
<p>Inzwischen erkranken im Jahr etwa 300.000 Menschen. Laut Statistischem Bundesamt starben etwa 4.000 Menschen in 2020 daran. Das sind 53 Prozent mehr als noch im Jahr 2000. Durch den Klimawandel droht sich jetzt die Lage noch zu verschlimmern. Das bedeutet: Die Pr&auml;vention UV-bedingter Erkrankungen muss f&uuml;r die Politik Priorit&auml;t haben und sie sollte entsprechende gesetzliche Regelungen treffen. Denn die steigenden F&auml;lle von Hautkrebs belasten das Gesundheitswesen und das Allgemeinwohl erheblich.</p></div></div></div><div class="no-print"><div class="UVScene7_inner__Mf_0v"><div class="UVScene7_upperBackgroundContainer__zdR_p"><figure class="UVScene7_upperBackground__52adh"></figure></div></div><div class="UVScene7_container__ZePNW"><figure class="UVScene7_lightboxTrigger__spfqm"><button class="LightboxTrigger_wrapper__k_bmz no-print" type="button" aria-label="Hautkrebs und Klimawandel Modal öffnen"><span class="bold-text semibold-font magnifying-glass-bg-right LightboxTrigger_magnifyingGlassRight__ZbgD_">Hautkrebs und</br> Klimawandel</span></button></figure></div><div class="UVScene7_wrapper__o5R46" id="uv-scene-7"></div></div><div class="print-only"><h3 class="headline-3">Hautkrebs und Klimawandel</h3><div><p>Sch&auml;tzungen gehen davon aus, dass bei 1 Prozent weniger Ozon in der Atmosph&auml;re die F&auml;lle von schwarzem Hautkrebs um bis zu 2 Prozent steigen k&ouml;nnten. F&uuml;r den hellen Hautkrebs k&ouml;nnten es bis zu 4,6 Prozent sein. Modellrechnungen lassen erkennen, dass ein globaler Anstieg der Umgebungstemperatur um 2&nbsp;&deg;C die Hautkrebserkrankungsrate (Inzidenz) erh&ouml;hen k&ouml;nnte &ndash; es wird von einer Steigerung um 11&nbsp;Prozent bis 2050 gesprochen. Studien auf Zellebene unterst&uuml;tzen diese Sch&auml;tzung.</p></div></div><div class="section bg-red-70  clip-pad-top-uv-xs"><div class="SectionHeading_inner__zw_y_"><h2 class="SectionHeading_h2__tbZ9L headline-2" id="wiegelingtanpassung">Wie gelingt Anpassung?</h2></div></div><div class="section bg-red-70 clip-pad-bottom-uv-xs"><div class="Paragraph_inner__LZf66"><div class="Paragraph_paragraph__RBIN1"><p>Silke: &bdquo;Das sind schlimme Aussichten! Was k&ouml;nnen wir tun, um uns an die Folgen des Klimawandels anzupassen? Gibt es Strategien, um die UV-Belastung zu umgehen?&ldquo;</p>
<p>Laura: &bdquo;Zum einen k&ouml;nnen wir unser Verhalten &auml;ndern. Das hei&szlig;t, dass wir uns mit einfachen Ma&szlig;nahmen selbst vor der Sonne sch&uuml;tzen. Wir k&ouml;nnen lang&auml;rmelige Kleidung tragen, uns mit Sonnencreme einreiben, eine Sonnenbrille aufsetzen und so weiter. Das nennt man Verhaltenspr&auml;vention. Zum anderen m&uuml;ssen unsere Lebensbedingungen so ver&auml;ndert werden, dass wir hohen UV-Belastungen aus dem Weg gehen k&ouml;nnen. Dazu geh&ouml;rt, die UV-Belastung gut sichtbar, z. B. im Freibad, anzuzeigen, Schattenpl&auml;tze einzurichten und Aktivit&auml;ten im Freien auf Zeiten verschieben zu k&ouml;nnen, in denen die UV-Strahlung nicht so stark ist. Das nennt sich dann Verh&auml;ltnispr&auml;vention.&ldquo;</p>
<p>Silke schmunzelt: &bdquo;Oder wir vermeiden die Sonne komplett!&ldquo; Laura: &bdquo;Nein, das ist auch nicht gesund. Verhaltens- und Verh&auml;ltnispr&auml;vention m&uuml;ssen sich sinnvoll erg&auml;nzen. Wie soll man in den Schatten gehen, wenn es keinen Schatten gibt? Diese Strategien sollen jedem erm&ouml;glichen, zu jeder Zeit bewusst mit UV-Strahlung umzugehen. Und die verh&auml;ltnispr&auml;ventiven Ma&szlig;nahmen m&uuml;ssen landesweit eingerichtet werden. Da spielt die Politik auf Bundes- und L&auml;nderebene eine wichtige Rolle.&ldquo;</p></div></div></div><div style="padding-top:10px;padding-bottom:10px;height:100px" class="section bg-red-20 bdg-fg-red-20"><div class="LightboxTrigger_trigger__DFtm2"><button class="LightboxTrigger_wrapper__k_bmz no-print" type="button" aria-label="Verhaltens- und Verhältnisprävention Modal öffnen"><span class="bold-text semibold-font magnifying-glass-bg">Verhaltens- und</br> Verhältnisprävention</span></button></div></div><div class="print-only"><h3 class="headline-3">Verhaltens- und Verhältnisprävention</h3><div><p><strong>Verhaltenspr&auml;vention</strong> setzt beim Menschen an. Alle Ma&szlig;nahmen der Verhaltenspr&auml;vention zeigen, wie man sich am besten verh&auml;lt, um das eigene gesundheitliche Risiko zu minimieren. Menschen aller Altersgruppen sollen dazu f&auml;hig sein, Gesundheitsrisiken zu erkennen und diese durch ihren pers&ouml;nlichen Lebensstil so gut wie m&ouml;glich zu vermeiden. Letztendlich soll die Gesundheitskompetenz eines Jeden gesteigert werden. Das richtige UV-Schutz-Verhalten bringen Eltern und P&auml;dagog*innen den Kindern am besten von klein auf bei.</p>
<p>&nbsp;</p>
<p><strong>Verh&auml;ltnispr&auml;ventive</strong> Ma&szlig;nahmen sind alle Handlungen, die die Lebensbedingungen bzw. die Welt, in der die Menschen leben, derart ver&auml;ndern, dass diese Lebenswelten (u.a. Bildungs-, Sport- und Freizeiteinrichtungen) m&ouml;glichst risikoarm gestaltet sind. Zur Reduzierung der UV-Belastung dienen leicht umsetzbare Ma&szlig;nahmen: z. B. die UV-Bestrahlungsst&auml;rke f&uuml;r jeden sichtbar anzuzeigen und Schatten zu schaffen. T&auml;tigkeiten im Freien k&ouml;nnen auf Zeiten verschoben werden, in denen die UV-Strahlung nicht so stark ist. Diese Ma&szlig;nahmen helfen dabei, hohen UV-Belastungen ausweichen zu k&ouml;nnen. Verh&auml;ltnispr&auml;ventive Ma&szlig;nahmen nachhaltig und deutschlandweit gerecht verteilt aufzubauen, ist Sache der Politik und bedingt auch eine Anpassung der Normen &ndash; z. B. f&uuml;r das Bauwesen &ndash; an die Folgen des Klimawandels.</p></div></div><div class="no-print"><div class="UVScene8_wrapper__5p4HG" role="img"><div class="IllustrationContainer_inner__L4XL2"><div class="IllustrationContainer_illustration__NrdFy"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 -30 305.23 311.84" class="UVScene8_silke__i2ojO"><g data-name="Ebene 2"><g data-name="S8"><g data-name="Silke"><path fill="#d06c67" d="M150.44 146.96l-57.72 94.57 21 33.57 54.82-69.95-18.1-58.19z"></path><path fill="#d06c67" d="M61.35 183.2l-12.54 6.29 30.5 60 22.78 31 13.01-6.31 2.91-25-56.66-65.98z"></path><path fill="#93613d" d="M45.5 163.57l-9.83-3.02-11.8-8.89-3.73 3.19 9.63 9.6-4.7 4.92 20.43-5.8z"></path><path fill="#9e7150" d="M61.32 183.73L45.5 163.57l-15.78 4.18L0 160.55v3.48l27.63 14.4 13.23-2.56L50.78 189l10.54-5.27z"></path><path fill="#d06c67" d="M253.4 141.39l-41.38-39.71-36.44 9.74-25.14 35.54-8.24 114.07-12.14 77.6 113.45 3.21 1.56-83.36 8.33-117.09z"></path><path fill="#d06c67" d="M252.35 141.39l19.71 27.59 43.17 144.37-29.1 7.44-56.37-129.14 22.59-50.26z"></path><path fill="#0f2237" d="M145.66 80.84l-8.97-24.35-3.21-52.64 58.13 30.62-45.95 46.37z"></path><path fill="#93613d" d="M189.42 65.85l22.6 35.83-30.41 32.34-24.54-53.62 32.35-14.55z"></path><path d="M207.03 56.53c8.64-16.98 1.88-37.76-15.1-46.4s-41.48-5.46-50.12 11.52c-5.5 14.01-4.84 34.04-3.16 49.13.07.61 2.44 1.47 2.44 1.47l1.19 5.56s-2.13.91-2.54 1.29c1.15 7.72 2.3 12.82 2.3 12.82l28.2-.7 19.78-30.08 15.34-1.67c.6-.94 1.17-1.92 1.68-2.93z" fill="#93613d"></path><path d="M142.44 92.65l-.04-2 27.45-.43 6.51-5.53 1.29 1.52-7.05 6-28.16.44z"></path><circle cx="182.21" cy="39.95" r="33.71" fill="#93613d"></circle><path d="M133.48 3.85s40.63-7.82 64.86-1.18c28.39 7.78 43.22 27.81 43.22 27.81l-9.02 39.49-26.31 15.92-.8 5.34-23.71-29.13-35.69-24.23-12.55-34.02z" fill="#0f2237"></path><ellipse cx="178.02" cy="58.09" rx="12.41" ry="8.55" transform="rotate(-58.37 178.033 58.085)" fill="#93613d"></ellipse><path fill="#93613d" d="M138.21 42.99l-10.89 22.07 11.34 1.46-.45-23.53z"></path><g><path d="M146.16 51.68l-2.9-3.88-5.84-1.4.47-1.94 6.54 1.56 3.34 4.47-1.61 1.19z"></path><path d="M143.79 51.57l-2.82-.35-.3-5.63 3.18 1.32-.06 4.66zM136.169 39.977l.76-1.85 8.12 3.338-.76 1.85zM142.62 78.35l-1.07-4.97-3.62-1.05.56-1.92 4.77 1.38 1.31 6.15-1.95.41z"></path></g></g><path fill="#93613d" d="M218.62 108.02l-38.67 34.89-9.73-23.91 5.36-7.58 36.44-9.74 6.6 6.34z"></path><path fill="#b74d48" d="M177.61 155.38l-12.07-30.71 1.86-.73 11.04 28.1 45.56-39 1.3 1.52-47.69 40.82z"></path><path d="M127.208 66.258l.253-1.984 15.633 1.994-.253 1.984z"></path></g></g></svg><figure class="UVScene8_overlay__L1Thw"></figure></div></div></div></div><div class="section bg-red-70 clip-pad-top-uv-xs"><div class="Paragraph_inner__LZf66"><div class="Paragraph_paragraph__RBIN1"><p>Es gibt viel zu tun bei den verh&auml;ltnispr&auml;ventiven Ma&szlig;nahmen. Zum Beispiel f&uuml;r Parks, Schulh&ouml;fe oder &ouml;ffentliche Pl&auml;tze sollten St&auml;dtebau-, Stadt- und Geb&auml;udeplanung UV-reduzierende Ma&szlig;nahmen von Anfang an mit bedenken. Es braucht Schulungsangebote f&uuml;r Multiplikator*innen wie &Auml;rzt*innen, Erziehungs- oder Lehrkr&auml;fte. Das Thema &bdquo;Schutz vor UV-Strahlung&ldquo; sollte in Lehr- und Ausbildungspl&auml;ne aufgenommen werden. Die UV-Intensit&auml;t muss weiterhin kontinuierlich gemessen werden. Der daraus berechnete UV-Index kann k&uuml;nftig gut sichtbar f&uuml;r alle Menschen in der &Ouml;ffentlichkeit angezeigt werden: z. B. im Schwimmbad, im Gebirge auf den H&uuml;tten oder an den Seilbahnstationen. Der UV-Index sollte zudem in den Wetternachrichten ver&ouml;ffentlicht werden &ndash; gleichberechtigt neben der Anzeige von Temperatur, Wind oder Niederschlag.</p>
<p>Zudem sollen <b>GIS-basierte Modellierungsprogramme</b> entwickelt werden, die die m&ouml;gliche UV-Belastung an bestimmten Orten berechnen k&ouml;nnen. Die Programme sollten dann auch zeigen, wie die UV-Belastung durch z. B. B&auml;ume oder Markisen reduziert werden kann. Bau- oder Landschaftsplaner*innen k&ouml;nnen mit einem solchen Programm schattenspendende Ma&szlig;nahmen optimal planen und an die Umgebung anpassen.</p></div></div></div><div style="padding-top:10px;padding-bottom:10px;height:100px" class="section bg-red-70 bdg-fg-red-70"><div class="LightboxTrigger_trigger__DFtm2"><button class="LightboxTrigger_wrapper__k_bmz no-print" type="button" aria-label="GIS-basierte Modellierungsprogramme Modal öffnen"><span class="bold-text semibold-font magnifying-glass-bg">GIS-basierte</br> Modellierungsprogramme</span></button></div></div><div class="print-only"><h3 class="headline-3">GIS-basierte Modellierungsprogramme</h3><div><p>GIS ist die Abk&uuml;rzung f&uuml;r Geographische Informationssysteme. Sie erfassen, bearbeiten, organisieren, analysieren und pr&auml;sentieren r&auml;umliche Daten. Ein bekanntes GIS Programm ist zum Beispiel Google Maps.</p>
<p>&nbsp;</p>
<p>Bei GIS-Modellen werden die Geodaten mit weiteren Informationen verkn&uuml;pft &ndash; wie z. B. der Verkehrsauslastung auf Autobahnen oder in St&auml;dten oder die Temperatur in bestimmten Stadtteilen oder Landschaften.</p>
<p>&nbsp;</p>
<p>Um die UV-Belastung darzustellen, m&uuml;ssen Geodaten eines Geographischen Informationssystems mit den Informationen &uuml;ber die UV-Bestrahlungsst&auml;rke verkn&uuml;pft werden. Da die UV-Bestrahlungsst&auml;rke auf Stadtpl&auml;tzen oder Au&szlig;enbereichen von Kinderg&auml;rten nicht nur durch Wolken beeinflusst ist, sondern auch durch Schattenwurf von Hausmauern oder Reflektionen von Hausw&auml;nden, ist die Erstellung eines solchen Programms &auml;u&szlig;erst komplex.</p></div></div><div class="section bg-red-70 clip-pad-bottom-uv-xs"><div class="Paragraph_inner__LZf66"><div class="Paragraph_paragraph__RBIN1"><p>Einige Anpassungsma&szlig;nahmen an den Klimawandel, um UV-Belastung zu reduzieren, verabschiedete die Bundesregierung im <a href="https://www.bmuv.de/download/aktionsplan-anpassung-zur-deutschen-anpassungsstrategie-an-den-klimawandel" target="_blank" rel="noopener">Aktionsplan Anpassung III</a>.</p></div></div></div><div class="no-print"><div class="UVScene9_wrapper__XXSbP"><div class="IllustrationContainer_inner__L4XL2"><div class="IllustrationContainer_illustration__NrdFy"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="25 -60 264.22 382.61" class="UVScene9_laura__GNa84"><g data-name="Ebene 2"><g data-name="S9"><path fill="#f4cdb3" d="M247.88 154.82l10.68-16.66 5.66-.94-4.4 11.31-12.45 13.19.51-6.9z"></path><g data-name="Lisa"><g fill="#b5cfa8"><path d="M153.31 146.39l62.53 124.69-10.72 14.82-20.74-11.21-52.39-72.51-8.8-78.8 30.12 23.01zM29.74 152.25L0 290.38l10.88 18.81 16.55-5.89 55.94-181.17-53.63 30.12z"></path><path d="M153.36 148.11l-37.25-30.5-25.59.13-60.72 35.63 13.59 115.01-13.82 112.46 134.07 1.77-17.16-113.64 6.88-120.86z"></path></g><path fill="#0f2237" d="M49.41 10.48L73.65 0l5.18 21.2-13.72 13.73-22.66-4.16 6.96-20.29zM82.38 83.48l6.31 17.83 11.14-13.05-17.45-14.38v9.6z"></path><path fill="#f4cdb3" d="M84.84 78.79l6.48 43.31 18.87 8.41L121 120.27l1.88-40.85-38.04-.63z"></path><path fill="#eaf1e6" d="
        "jurisdiction:DE-TH",
        "topic:K78-WIRBELLOSE"
      ]
    },
    {
      "id": "th-biology-seki-lehrplan-2024-k78-zellen-03-zellen-einzeller-vielzeller-bakterien-und-viren-unterscheiden",
      "title": "Zellen, Einzeller, Vielzeller, Bakterien und Viren unterscheiden",
      "description": "Die lernende Person kann Merkmale des Lebens, pflanzliche und tierische Zellen, Zellbestandteile und Funktionen, autotrophe und heterotrophe Ernaehrungsweisen, Einzeller, Vielzeller, Viren und Bakterien erklaeren, mikroskopisch untersuchen und Modellgrenzen reflektieren.",
      "type": "atomic",
      "sourceRef": "Thueringer Lehrplan Biologie AHR 2024, Klassenstufen 7/8, Zellen als Lebensbausteine, S. 15",
      "sourceDocumentKey": "DE-TH-BIOLOGIE-GYMNASIUM-LEHRPLAN-2024",
      "sourcePath": "curricula/DE/Gymnasium/input/TH/LP_GY_Biologie_2024.pdf",

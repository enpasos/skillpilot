  "sourceGoals": [
    {
      "id": "th-biology-seki-lehrplan-2024-pb-01-biologische-fach-erkenntnis-kommunikations-und-bewertungskompetenzen-anwenden",
      "title": "Biologische Fach-, Erkenntnis-, Kommunikations- und Bewertungskompetenzen anwenden",
      "description": "Die lernende Person kann biologische Sachverhalte mit Basiskonzepten erschliessen, empirisch untersuchen, modellieren, fachsprachlich kommunizieren und Kriterien fuer gesundheits-, umwelt- und gesellschaftsbezogene Bewertungen nutzen.",
      "type": "atomic",
      "sourceRef": "Thueringer Lehrplan Biologie AHR 2024, Kompetenzmodell und Fachkompetenz, S. 1-13",
      "sourceDocumentKey": "DE-TH-BIOLOGIE-GYMNASIUM-LEHRPLAN-2024",
      "sourcePath": "curricula/DE/Gymnasium/input/TH/LP_GY_Biologie_2024.pdf",
      "tags": [
        "source-extraction",
        "subject:Biologie",
        "phase:SekI",
        "jurisdiction:DE-TH",
        "topic:PB"
      ]
    },
    {
      "id": "th-biology-seki-lehrplan-2024-k78-wirbellose-02-wirbellose-insekten-angepasstheit-und-schutzmassnahmen-erklaeren",
      "title": "Wirbellose, Insekten, Angepasstheit und Schutzmassnahmen erklaeren",
      "description": "Die lernende Person kann Wirbellose anhand des Stuetzsystems und weiterer Merkmale von Wirbeltieren abgrenzen, Gruppen und Insektenordnungen begruendet zuordnen, Angepasstheiten, Metamorphose, Insektenstaaten und die Bedeutung sowie den Schutz von Wirbellosen in Lebensraeumen erklaeren und bewerten.",
      "type": "atomic",
      "sourceRef": "Thueringer Lehrplan Biologie AHR 2024, Klassenstufen 7/8, Wirbellose in ihren Lebensraeumen, S. 14-15",
      "sourceDocumentKey": "DE-TH-BIOLOGIE-GYMNASIUM-LEHRPLAN-2024",
      "sourcePath": "curricula/DE/Gymnasium/input/TH/LP_GY_Biologie_2024.pdf",
      "tags": [
        "source-extraction",

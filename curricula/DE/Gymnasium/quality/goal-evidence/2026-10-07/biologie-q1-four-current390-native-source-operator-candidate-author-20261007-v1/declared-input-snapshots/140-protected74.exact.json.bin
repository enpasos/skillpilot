          "canonicalUrl": "https://skillpilot.com/lernzielbuch?landscape=08a43a1b-d97e-522c-9dfa-c950a493364e&edition=curricular-atomic-v1#goal-1cfb2f8b-d44b-57f4-aae0-c5d9f55a1c6a"
        }
      ],
      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Gelelektrophorese auswerten",
        "url": "/assets/goal-visualizations/biologie/8eb86a82-122d-5cae-8f80-bb2850b29c2f/8eb86a82-122d-5cae-8f80-bb2850b29c2f.png",
        "altText": "Schematisches Gel mit einem Größenmarker und zwei Probenbahnen. Die Taschen liegen oben am Minuspol, die DNA-Fragmente wandern zum Pluspol unten. Kleinere lineare Fragmente wandern weiter; größere bleiben näher bei den Taschen. Vier Markerbanden und je zwei Probenbanden werden nach ihrer Höhe verglichen. Numerische Fragmentlängen sind nicht angegeben.",
        "originalDigest": "sha256:6c5a1ac50d05b30f31639f4c25f9eb948aff545783df606b57d9557664b36a87",
        "qaStatus": "review_candidate",
        "approvedForPublication": false
      },
      "evidenceReview": null,
      "goalFingerprint": "sha256:6b1a4628773ecd79c837fb81cd066b1ebfb8eeea3d99ddb318f00cd8d706aa57",
      "pageFingerprint": "sha256:8714789ffccc3503f4eedeeb126dc6ba07c1eec4e687cd07b6bc29053e9b7ab1"
    }
  },

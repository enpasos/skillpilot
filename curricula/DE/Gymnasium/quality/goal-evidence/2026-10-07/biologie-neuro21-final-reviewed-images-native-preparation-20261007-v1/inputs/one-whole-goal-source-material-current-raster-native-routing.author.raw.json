          "goalId": "ce19b80f-d392-5851-ac92-750c85adfb3e",
          "caseId": "initial-bounded-model",
          "unchangedPriorWholeCaseBrief": {
            "id": "initial-bounded-model",
            "taskDemandDe": "Ein vereinfachtes Neuronenmodell zeigt verzweigte Fortsätze am Zellkörper, einen langen Fortsatz und Endknöpfchen. Die Legende nennt Dendrit, Zellkörper und Axon. Beschrifte das Modell und erkläre eine mögliche Signalroute zwischen zwei Nervenzellen.",
            "taskDemandEn": "A simplified neuron model shows branching processes at the cell body, one long process and terminals. The legend names dendrite, cell body and axon. Label the model and explain a possible signal route between two neurons.",
            "expectedPerformanceDe": "Die Erklärung verbindet Signalaufnahme an Dendriten/Zellkörper, Weiterleitung entlang des Axons und Weitergabe an den Endigungen. Die Richtung folgt dem gegebenen Grundmodell; daraus wird keine universelle Aussage über jeden Neuronentyp abgeleitet.",
            "expectedPerformanceEn": "The explanation connects reception at dendrites/cell body, conduction along the axon and transmission at terminals. Direction follows the supplied basic model without making a universal claim about every neuron type.",
            "understandingFocusDe": "Eigenständig begründete Erklärung des gegebenen Mechanismus und seiner Bedingungen.",
            "understandingFocusEn": "Independently justified explanation of the supplied mechanism and its conditions."
          },
          "taskDe": "Ein vereinfachtes Neuronenmodell zeigt verzweigte Fortsätze am Zellkörper, einen langen Fortsatz und Endknöpfchen. Die Legende nennt Dendrit, Zellkörper und Axon. Beschrifte das Modell und erkläre eine mögliche Signalroute zwischen zwei Nervenzellen.",
          "taskEn": "A simplified neuron model shows branching processes at the cell body, one long process and terminals. The legend names dendrite, cell body and axon. Label the model and explain a possible signal route between two neurons.",
          "referenceResponseDe": "Die Erklärung verbindet Signalaufnahme an Dendriten/Zellkörper, Weiterleitung entlang des Axons und Weitergabe an den Endigungen. Die Richtung folgt dem gegebenen Grundmodell; daraus wird keine universelle Aussage über jeden Neuronentyp abgeleitet.",
          "referenceResponseEn": "The explanation connects reception at dendrites/cell body, conduction along the axon and transmission at terminals. Direction follows the supplied basic model without making a universal claim about every neuron type.",
          "understandingFocusDe": "Eigenständig begründete Erklärung des gegebenen Mechanismus und seiner Bedingungen.",
          "understandingFocusEn": "Independently justified explanation of the supplied mechanism and its conditions.",

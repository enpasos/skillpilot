const f=read(resolve(own,'INPUTS.final-eight-stable-current-profiles-and-neutral-material.json')),host=resolve(repo,f.executionHost)
const {loadGoalDescriptionRolloutBatchConfig}=await import(pathToFileURL(resolve(host,'app/scripts/materializeGoalDescriptionRolloutBatch.ts')).href)
const {parseGoalBookEvidenceReviewRecord,validateGoalBookEvidenceReviewRecordSemantics}=await import(pathToFileURL(resolve(host,'app/scripts/goalBookEvidenceReviewLoader.ts')).href)
const loaded=await loadGoalDescriptionRolloutBatchConfig(f.nativeConfig.path);assert.deepEqual(loaded.config.goalIds,f.goalIds);assert.equal(loaded.config.goalIds.length,8);assert.equal(loaded.config.baseGoalBookConfigPath,f.baseGoalBookConfig.path);assert.ok(!existsSync(loaded.outputDirectory))
const config=read(f.baseGoalBookConfig.path);assert.equal(config.publicationMode,'review');assert.equal(config.compositionViewPath,'curricula/DE/Gymnasium/quality/goal-description-review/chemie/review-views/chemie-m7-full-canonical.view.json');assert.ok(!existsSync(resolve(repo,config.outputPath)));assert.equal(config.evidenceReviewPaths.length,5)
const canonical=read(f.canonical.path),qa=read(f.visualizationQA.path),kinds=new Map(read(f.semantic.path).decisions.map((d:any)=>[d.goalId,d.semanticKind])) as Map<string,string>,rows=[] as any[],hash=(p:string)=>`sha256:${createHash('sha256').update(readFileSync(p)).digest('hex')}`
for(const path of config.evidenceReviewPaths)for(const raw of readFileSync(resolve(repo,path),'utf8').trim().split('\n').map((x:string)=>JSON.parse(x))){const r=parseGoalBookEvidenceReviewRecord(raw,'final exact current Book P profile'),g=canonical.goals.find((g:any)=>g.id===r.goalId);assert.ok(g);const digests=Object.fromEntries((g.resourceLinks??[]).filter((l:any)=>l.type==='goal-visualization').map((l:any)=>[l.url,hash(resolve(host,'app/public',l.url.slice(1)))]));assert.deepEqual(validateGoalBookEvidenceReviewRecordSemantics(r,g,digests,kinds.get(r.goalId)),[]);rows.push(r)}
assert.equal(rows.length,8);assert.equal(new Set(rows.map(r=>r.goalId)).size,8);assert.deepEqual(rows.map(r=>r.goalId).sort(),[...f.goalIds].sort())
for(const id of f.goalIds){const goal=canonical.goals.find((g:any)=>g.id===id);for(const req of goal.requires??[])if(f.goalIds.includes(req))assert.ok(f.goalIds.indexOf(req)<f.goalIds.indexOf(id));const asset=qa.records.find((r:any)=>r.goalId===id);assert.equal(hash(resolve(host,asset.publicAssetPath)),asset.assetSha256);assert.ok(statSync(resolve(host,asset.publicAssetPath)).isFile())}
const previous=read(f.previousNeutralEightInputs.path),prior=read(previous.roundAInput.path),oldById=new Map(prior.goals.map((g:any)=>[g.goalId,g.reviewContext.evidenceProfile])) as Map<string,any>;for(const r of rows){const before=oldById.get(r.goalId);if(!f.expectedChangedPageFPGoalIds.includes(r.goalId))assert.deepEqual(r,before);else {assert.equal(r.goalFingerprint,before.goalFingerprint);assert.equal(r.reviewInputFingerprint,before.reviewInputFingerprint);for(const k of Object.keys(r.profile))if(k!=='expectations')assert.deepEqual(r.profile[k],before.profile[k]);for(let i=0;i<r.profile.expectations.length;i++){for(const k of ['id','observablePerformanceDe','observablePerformanceEn'])assert.equal(r.profile.expectations[i][k],before.profile.expectations[i][k]);}}}const scopes=f.retentionGroups.map((x:any)=>read(x.config.path)).concat([read(f.P1Config.path)]),ownerIds=scopes.flatMap((x:any)=>x.scope.goalIds);assert.equal(new Set(ownerIds).size,8);assert.equal(ownerIds.length,8);const out=resolve(own,'checks/PREFLIGHT.final-Native8.actual-stock-closed-config-eight-current-profiles.json');assert.ok(!existsSync(out));writeFileSync(out,JSON.stringify({schemaVersion:1,closedStockNativeConfig:'PASS',actualEightProfileSemantics:'PASS',exactTopologicalScope:'PASS',goalIds:f.goalIds,profiles:8,nullProfiles:0,fullModelExports:0,newModelCalls:0,newRenders:0},null,2)+'\n');console.log(JSON.stringify({closedStockNativeConfig:'PASS',eightCurrentProfiles:'PASS',topologicalScope:'PASS',nullProfiles:0,modelCalls:0,renders:0}))

      "goalId": "e0d4f08a-3e67-5e2b-9c4a-06468ec5c3dd",
      "title": "vanʼt Hoff Gleichung nutzen",
      "changedKeys": [
        "description",
        "descriptionEn"
      ],
      "before": {
        "description": "Die lernende Person kann Temperaturabhängigkeiten von Gleichgewichten berechnen.",
        "descriptionEn": "The learner can calculate temperature dependencies of equilibria."
      },
      "after": {
        "description": "Die lernende Person kann mit der van’t-Hoff-Gleichung die Änderung der Gleichgewichtskonstante mit der Temperatur berechnen und die dabei verwendete Annahme zur Reaktionsenthalpie erläutern.",
        "descriptionEn": "The learner can use the van’t Hoff equation to calculate how the equilibrium constant changes with temperature and explain the assumption about reaction enthalpy used in the calculation."
      },
      "otherWholeGoalFieldsExact": true
    },
    {
      "goalId": "1a51362e-fd84-5964-89b5-b435772c2149",
      "title": "Mehrfachgleichgewichte",
      "changedKeys": [
        "description",
        "descriptionEn"
      ],
      "before": {
        "description": "Die lernende Person kann gekoppelte Gleichgewichte qualitativ/quantitativ analysieren.",
        "descriptionEn": "The learner can analyze coupled equilibria qualitatively/quantitatively."
      },
      "after": {
        "description": "Die lernende Person kann gekoppelte Gleichgewichte über gemeinsame Teilchen, zusammengehörige Gleichgewichtskonstanten und Stoffbilanzen qualitativ und quantitativ analysieren.",
        "descriptionEn": "The learner can analyze coupled equilibria qualitatively and quantitatively using shared species, related equilibrium constants and material balances."
      },
      "otherWholeGoalFieldsExact": true
    },
    {
      "goalId": "0c9fe376-0fbd-5dc1-b8d4-d56d658a00e3",
      "title": "Elektrolyse und Gleichgewicht",
      "changedKeys": [
        "description",
        "descriptionEn"
      ],
      "before": {
        "description": "Die lernende Person kann Elektrolyseprozesse mit Redoxgleichgewichten verknüpfen.",
        "descriptionEn": "The learner can link electrolysis processes with redox equilibria."
      },
      "after": {
        "description": "Die lernende Person kann Elektrolyse als durch elektrische Arbeit erzwungenen Redoxumsatz erklären und den Zusammenhang zwischen Zellspannung, thermodynamisch bevorzugter Reaktionsrichtung und Redoxgleichgewicht erläutern.",
        "descriptionEn": "The learner can explain electrolysis as a redox conversion driven by electrical work and explain the relationship between cell voltage, the thermodynamically favoured reaction direction and redox equilibrium."
      },
      "otherWholeGoalFieldsExact": true
    },
    {
      "goalId": "16f0dc69-6da8-5751-a00e-abbc1c882dbc",
      "title": "Katalyseformen vergleichen",

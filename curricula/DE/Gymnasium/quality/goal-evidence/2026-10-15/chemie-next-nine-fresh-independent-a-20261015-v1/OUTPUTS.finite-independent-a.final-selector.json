  "originalSourceLimits": [
    {
      "goalId": "f71a2c0a-3a6a-5b23-9fb4-1b57cfb68528",
      "sourceBoundary": "Konkrete BY-Kompetenz und die gelesenen übrigen Quellkontexte sind keine neue Freigabe aller geltenden Länder-/Kursprojektionen."
    },
    {
      "goalId": "6d3a2bad-8c67-5964-a720-375f138adaba",
      "sourceBoundary": "Kein direkter Spezialvergleich in HE Q1.2 oder Q2.1 nachgewiesen. Die induktiven/sterischen Effekte von Q1.2 stehen ausdrücklich bei SN1/SN2 und dürfen nicht als identische Additionszelle ausgegeben werden. Die schmale Q2.1-Zelle allein reicht für diesen Vergleich nicht. Die genannten ganzen übergreifenden Originalpassagen erlauben die didaktische Operationalisierung; keine neue wörtliche oder flächendeckende BY/HE-Pflichtstoffdeckung."
    },
    {
      "goalId": "0c9fe376-0fbd-5dc1-b8d4-d56d658a00e3",
      "sourceBoundary": "Die quantitative Stoffumsatzberechnung mit den Faraday-Gesetzen ist kein importiertes Pflichtkriterium dieses Ziels; die gasförmige Elektrolyse ist ein explizites Lehrmodell. Keine Gesamtquellenfreigabe."
    },
    {
      "goalId": "16f0dc69-6da8-5751-a00e-abbc1c882dbc",
      "sourceBoundary": "Spezifität und Reaktionsweg werden als vertiefender Vergleich gelesen; keine pauschale Nachhaltigkeits- oder Geschwindigkeitsrangfolge und keine neue V-Freigabe."
    },
    {
      "goalId": "b7521ac7-4ad1-5e63-96ca-4c6c9b2b1e0b",
      "sourceBoundary": "Nichtstandardbedingungen bedeuten hier die ausdrücklich materialisierten Aktivitäts-/Konzentrationsfälle; keine Freigabe beliebiger pH-, Temperatur- oder Nichtmetall-Nernst-Rechnungen in allen Ländern."
    },
    {
      "goalId": "13838147-c26d-54ca-b9be-5f2f0b8e9de5",
      "sourceBoundary": "Der konkrete HB-Kinetikkontext trägt den Mechanismusanspruch. Allgemeine mathematische Standards sind allein keine Spezialquellenfreigabe für beliebige quantitative Mechanismen oder alle BY/HE-Verbindlichkeiten."
    }
  ],
  "scopeOnlyLimits": [
    {
      "goalId": "f85b4651-50ea-5b42-b193-3465c05257a7",
      "sourceBoundary": "Die gelesene HE-Orbitalpassage ist keine wörtliche O2/N2-MO-Vorgabe; die jetzige Scope-Stimme bestätigt die engere Bindung, nicht neue Vollabdeckung aller verbleibenden Länder."
    },
    {
      "goalId": "057a6826-f599-53b1-bdd1-5a83037a1494",
      "sourceBoundary": "Optionaler RP-Quellencharakter und explizite authored-comparative-transfer-Provenienz bleiben erhalten. Keine neue normative Klassenrangfolge- oder Länderfreigabe."
    },
    {
      "goalId": "39c85aa0-b01f-56ec-a148-b8009bf650f5",
      "sourceBoundary": "Keine neue fachliche Prüfung der historischen Lactonfälle, keine pauschale Fünf-/Sechsringregel, keine neue vollständige Länder-/Kursdeckung."
    }
  ],

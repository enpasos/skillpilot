  "findings": [
    {
      "id": "BBBE-NO-HH",
      "source": "BB/BE44–46",
      "findingDe": "Der Einleitungstext schließt Pufferberechnungen ausdrücklich aus. Die Pufferzeile steht im zusätzlichen LK-Teil; die qualitative Pflicht bleibt vollständig bei25729, nicht bei HH. Die Kurven-/Punktzeilen stehen ebenfalls im LK-Teil. GK-Neutralisationstitration bleibt bei den tatsächlichen praktischen/quantitativen Trägern erhalten."
    },
    {
      "id": "HE-ONE-EACH",
      "source": "HE47–48",
      "findingDe": "HE47 nennt Interpretation und charakteristische Punkte im erhöhten Niveau, einschließlich schwacher und mehrprotoniger Titrationsbeispiele. HE48 nennt einen LK-HH-Rechenauftrag. Kein Paar aus eigenständigen schlichten und vertieften HH-Identitäten."
    },
    {
      "id": "NI-COMPOUND-OPERATORS",
      "source": "NI23",
      "findingDe": "eA verlangt die eine Punkt-/Kurvenkompetenz plus eigenständige Messaufnahme, experimentellen Halbpunkt, Zeichnen, mono-/polyprotischen Vergleich und praktische Pufferermittlung. Diese Operatoren werden nicht aus theoretischen Kurven-/HH-Fällen als ausgeführt ausgegeben."
    },
    {
      "id": "HB-REAL-HH",
      "source": "HB23",
      "findingDe": "Die tatsächliche LK-Zeile lautet berechnen Puffersysteme mit der Henderson-Hasselbalch-Gleichung. Der alte extrahierte Mischoperator polyprotisch+HH+Pufferdesign ist keine wörtliche amtliche Sammelpflicht. Polyprotische Kurven sind eine andere echte LK-Zeile; Herstellung/Untersuchung eines Puffers steht als Beispiel experimenteller Arbeiten."
    },
    {
      "id": "BW-LK",
      "source": "BWphysical36/printed34",
      "findingDe": "3.4.3(16) verbindet Wirkungsweise/Bedeutung und HH-pH-Berechnung ausdrücklich im Leistungsfach. GK wird aus dieser Seite nicht abgeleitet; die tatsächliche Quelle wird mit beiden Teiloperatoren erhalten."
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bound independent P/A scientific review material, not an active ledger",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactKind",
    "scienceFirstPath",
    "scienceFirstSha256",
    "reviewAuthority",
    "humanApproval",
    "strictClosureGranted",
    "goals"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactKind": {
      "const": "typed-independent-P-A-review-material-v1"
    },
    "reviewAuthority": {
      "const": "ai_candidate"
    },
    "humanApproval": {
      "const": false
    },
    "strictClosureGranted": {
      "const": false
    },
    "goals": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "goalId",
          "wholeGoalObjectSha256",
          "nativeGoalFingerprint",
          "nativePageFingerprint",
          "rawProfileObjectSha256",
          "cases",
          "P",
          "A",
          "currentDDecision",
          "openCurrentPageFindingIds"
        ],
        "properties": {
          "P": {
            "type": "object",
            "required": [
              "decision",
              "reasonDe",
              "status",
              "reviewAuthority",
              "authorCasesEvidenceLevel",
              "authorCasesMaximumClaimScope",
              "observations",
              "executions",
              "profile"
            ],
            "properties": {
              "decision": {
                "enum": [
                  "KEEP",
                  "REVISE",
                  "HOLD"
                ]
              },
              "status": {
                "const": "needs_human_review"
              },
              "reviewAuthority": {
                "const": "ai_candidate"
              },
              "authorCasesEvidenceLevel": {
                "const": "E0"
              },
              "authorCasesMaximumClaimScope": {
                "const": "G0"
              },
              "observations": {
                "type": "array",
                "maxItems": 0
              },
              "executions": {
                "type": "array",
                "maxItems": 0
              },
              "profile": {
                "$ref": "#/$defs/profile"
              }
            }
          },
          "A": {
            "type": "object",
            "required": [
              "status",
              "semanticAtomic",
              "reasonDe"
            ],
            "properties": {
              "status": {
                "enum": [
                  "atomic",
                  "needs_developer_review",
                  "non_atomic"
                ]
              },
              "semanticAtomic": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "reasonDe": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "cases": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          },
          "currentDDecision": {
            "enum": [
              "keep",
              "revise",
              "split_review",
              "block"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "localizedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "textDe",
        "textEn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "textDe": {
          "$ref": "#/$defs/boundedText"
        },
        "textEn": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "essentialUnderstandingDe",
        "essentialUnderstandingEn",
        "observablePerformanceDe",
        "observablePerformanceEn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "essentialUnderstandingDe": {
          "$ref": "#/$defs/boundedText"
        },
        "essentialUnderstandingEn": {
          "$ref": "#/$defs/boundedText"
        },
        "observablePerformanceDe": {
          "$ref": "#/$defs/boundedText"
        },
        "observablePerformanceEn": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "coverageExpectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredExpectationIds",
        "alternativeExpectationGroups",
        "minimumIndependentDemonstrations",
        "freshVariationRequired",
        "independentTransferRequired"
      ],
      "properties": {
        "requiredExpectationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "alternativeExpectationGroups": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/slug"
            }
          }
        },
        "minimumIndependentDemonstrations": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "freshVariationRequired": {
          "const": true
        },
        "independentTransferRequired": {
          "const": true
        }
      }
    },
    "applicationCaseBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "taskDemandDe",
        "taskDemandEn",
        "expectedPerformanceDe",
        "expectedPerformanceEn",
        "understandingFocusDe",
        "understandingFocusEn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "taskDemandDe": {
          "$ref": "#/$defs/boundedText"
        },
        "taskDemandEn": {
          "$ref": "#/$defs/boundedText"
        },
        "expectedPerformanceDe": {
          "$ref": "#/$defs/boundedText"
        },
        "expectedPerformanceEn": {
          "$ref": "#/$defs/boundedText"
        },
        "understandingFocusDe": {
          "$ref": "#/$defs/boundedText"
        },
        "understandingFocusEn": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype",
        "expectations",
        "coverageExpectations",
        "variationAxes",
        "applicationCaseBriefs"
      ],
      "properties": {
        "archetype": {
          "enum": [
            "concept",
            "procedure",
            "representation",
            "modeling",
            "proof",
            "experiment",
            "data"
          ]
        },
        "expectations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/expectation"
          }
        },
        "coverageExpectations": {
          "$ref": "#/$defs/coverageExpectations"
        },
        "variationAxes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/localizedItem"
          }
        },
        "applicationCaseBriefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/applicationCaseBrief"
          }
        }
      }
    }
  }
}

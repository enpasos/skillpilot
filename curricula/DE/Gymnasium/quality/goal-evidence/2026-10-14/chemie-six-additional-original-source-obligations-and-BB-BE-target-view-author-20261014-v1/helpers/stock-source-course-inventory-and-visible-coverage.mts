import {convertLearningGoal} from '../src/goalTypes';
import {normalizeCompositionView} from '../src/utils/authoring/compositionViewAuthoring';
import {applyCompositionViewProjection} from '../src/utils/compositionViewRuntime';
import {buildDirectChildrenMap,getRenderedChildIds} from '../src/utils/treeProjectionRuntime';
import {createHash} from 'node:crypto';
import {readFileSync,writeFileSync,readdirSync} from 'node:fs';
import {resolve,join} from 'node:path';
import {buildApplicabilityCompilation} from './applicabilityCompiler';
import {readSourceExtractionGoalIdsByLandscapeId,readAllGoalMappingFiles,evaluateCourseLevelMappingConsistency} from './generateCurriculumQualityStatus';
import {collectAuthoritativeTargetAtomicGoalIds} from './compositionViewSourceCoverage';
import {createReviewedRequiresClosureCoverageChecker,sourceCoverageSurrogateKey} from './sourceCoverageEvidence';
const repoRoot=resolve('.');const output=process.argv[2];
const load=(p:string)=>JSON.parse(readFileSync(p,'utf8'));
const canonicalPath='curricula/DE/Gymnasium/canonical/DE_DEU_S_GYM_CANONICAL_CHEMIE.de.json';
const landscape=load(canonicalPath);const goals=new Map(landscape.goals.map((g:any)=>[g.id,g]));
const compilation=buildApplicabilityCompilation();const report=compilation.reports.find(r=>r.landscapeId===landscape.landscapeId)!;
const dir='curricula/DE/Gymnasium/composition-views/chemie';const views=readdirSync(dir).filter(n=>n.endsWith('.view.json')).map(n=>({file:n,view:load(join(dir,n))}));
const canonicalAtoms=new Set<string>();for(const v of views.filter(v=>v.file.toLowerCase().startsWith('de-de')))for(const id of collectAuthoritativeTargetAtomicGoalIds(landscape,v.view))canonicalAtoms.add(id);
const eligible=(g:any)=>!!g&&!(g.contains?.length)&&!g.examData&&!g.tags?.some((t:string)=>['Practice','Assessment','Motivation','Orientation','memorization'].includes(t)||t.startsWith('srs-deck:'))&&g.nodeKind!=='memory';
const surrogates=new Map<string,any[]>();for(const e of load('curricula/DE/Gymnasium/provenance/canonical-goal-surrogate-evidence-registry.json').entries??[]){if(e.status!=='accepted'||e.evidenceType!=='requires-closure'||!e.rationale?.trim())continue;const k=sourceCoverageSurrogateKey(e.landscapeId,e.goalId,e.jurisdiction);surrogates.set(k,[...(surrogates.get(k)??[]),e]);}
const jurisdictions=report.projections.map(p=>{const target=new Set<string>();for(const v of views.filter(v=>v.file.toLowerCase().startsWith(p.value.toLowerCase())))for(const id of collectAuthoritativeTargetAtomicGoalIds(landscape,v.view))target.add(id);const checker=createReviewedRequiresClosureCoverageChecker({landscapeId:report.landscapeId,jurisdiction:p.value,goals:report.goals,canonicalGoalById:goals,surrogateEntriesByKey:surrogates,isEligibleCanonicalGoal:eligible});const actual=report.goals.filter(g=>g.goalType==='atomic'&&canonicalAtoms.has(g.goalId)&&eligible(goals.get(g.goalId))&&(target.size?target.has(g.goalId):g.compiledApplicability.jurisdiction?.includes(p.value)));const unsupported=actual.filter(g=>!checker.hasCoverageBackedJurisdictionEvidence(g));return {jurisdiction:p.value,targetCount:actual.length,unsupportedCount:unsupported.length,unsupported:unsupported.map(g=>({wholeGoal:goals.get(g.goalId),actualCompilerEvidence:g.evidence}))};});
const extracted=readSourceExtractionGoalIdsByLandscapeId(false);const mappings=readAllGoalMappingFiles().filter(m=>m.targetLandscapeId===landscape.landscapeId);const mapped=new Map<string,Set<string>>();for(const m of mappings){const decisions=new Set((m.decisions??[]).filter((d:any)=>d.decision==='mapped').map((d:any)=>d.sourceGoalId));let ids=mapped.get(m.sourceLandscapeId!)??new Set<string>();for(const e of m.mappings??[]){if(m.sourceExtractionPath&&!decisions.has(e.legacyGoalId))continue;if(e.legacyGoalId)ids.add(e.legacyGoalId)}mapped.set(m.sourceLandscapeId!,ids);}
const inventories=[...extracted].map(([sourceLandscapeId,ids])=>({sourceLandscapeId,goalCount:ids.size,unmappedInventoryIds:[...ids].filter(id=>!mapped.get(sourceLandscapeId)?.has(id))}));

// Reproduce CQR raw projected leaf collection exactly: scoped views can expose a canonical cluster as a projected leaf.
// This is an existing reader behavior, not a new source-closure/scientific approval.
const rawProjectedLeaves=(view:any):Set<string>=>{const v=normalizeCompositionView(view);const projected=applyCompositionViewProjection([{meta:landscape,goals:landscape.goals.map((g:any)=>convertLearningGoal(g,{landscapeId:landscape.landscapeId}))}],v)[0];const byId=new Map(projected.goals.map((g:any)=>[g.id,g]));const children=buildDirectChildrenMap(byId);const stack=projected.goals.filter((g:any)=>g.tags?.includes('root')).map((g:any)=>g.id);const seen=new Set<string>(),leaves=new Set<string>();while(stack.length){const id=stack.pop()!;if(seen.has(id))continue;seen.add(id);const g:any=byId.get(id);if(!id.startsWith('composition:')&&g&&!g.contains?.length)leaves.add(id);stack.push(...getRenderedChildIds(id,byId,children));}return leaves;};
const registry=load('curricula/DE/Gymnasium/provenance/source-landscape-registry.json');const sourceJurisdiction=new Map(registry.entries.map((e:any)=>[e.landscapeId,e.jurisdiction]));
const descendants=(id:string,seen=new Set<string>()):Set<string>=>{if(seen.has(id))return new Set();seen.add(id);const g:any=goals.get(id);if(!g)return new Set();if(!g.contains?.length)return new Set([id]);const result=new Set<string>();for(const r of g.contains)for(const i of descendants(r.split(':').pop(),new Set(seen)))result.add(i);return result;};
const reverseUnmapped=report.projections.flatMap(p=>{const target=new Set<string>();for(const v of views.filter(v=>v.file.toLowerCase().startsWith(p.value.toLowerCase())))for(const id of rawProjectedLeaves(v.view))target.add(id);if(!target.size)for(const g of report.goals)if(g.goalType==='atomic'&&g.compiledApplicability.jurisdiction?.includes(p.value)&&eligible(goals.get(g.goalId)))target.add(g.goalId);const relevant=mappings.filter(m=>sourceJurisdiction.get(m.sourceLandscapeId!)===p.value&&(!extracted.has(m.sourceLandscapeId!)||!!m.sourceExtractionPath));const ids=new Set(relevant.map(m=>m.sourceLandscapeId!));const mappedIntoView=new Set<string>();for(const m of relevant){const approved=new Set((m.decisions??[]).filter((d:any)=>d.decision==='mapped').map((d:any)=>d.sourceGoalId));for(const e of m.mappings??[]){if(m.sourceExtractionPath&&!approved.has(e.legacyGoalId))continue;if(target.has(e.canonicalGoalId!)||[...descendants(e.canonicalGoalId!)].some(id=>target.has(id)))mappedIntoView.add(m.sourceLandscapeId+':'+e.legacyGoalId);}}return [...ids].flatMap(id=>[...(extracted.get(id)??[])].filter(g=>!mappedIntoView.has(id+':'+g)).map(g=>({jurisdiction:p.value,sourceLandscapeId:id,sourceGoalId:g})));});
const digest=(x:unknown)=>'sha256:'+createHash('sha256').update(JSON.stringify(x)).digest('hex');const result={sourceReverseUnmappedGoalIdsMatchingStockMainWhenCount12:reverseUnmapped,actualCompilerAllGoalEvidenceDigest:digest(report.goals),actualCompilerAllFindingsDigest:digest(report.findings),stockCompilerSummary:compilation.summary,stockCourseRule:evaluateCourseLevelMappingConsistency(landscape,mappings),stockSourceInventoryReader:inventories,sourceInventoryGoalCount:inventories.reduce((n,e)=>n+e.goalCount,0),unsupportedAssignedTotal:jurisdictions.reduce((n,j)=>n+j.unsupportedCount,0),jurisdictions,sourceSuffixHasNoRoleInCompilerMappingOrCoverageEvidence:true,sourceGoalClosureRegistryIgnoredForRecognizedSourceExtractionLandscapes:true};writeFileSync(output,JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({sourceInventoryGoalCount:result.sourceInventoryGoalCount,unsupportedAssignedTotal:result.unsupportedAssignedTotal,courseStatus:result.stockCourseRule.status,courseMetrics:result.stockCourseRule.metrics,compilerErrors:compilation.summary.errors,compilerWarnings:compilation.summary.warnings}));

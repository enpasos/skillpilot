<article>
	<h1 class="nci-heading-h1">
		What Is Cancer?
	</h1>
	<div class="cgdp-inner-content-area">
		<div class="cgdp-field-image-article">
      

<div class="cgdp-image">
  <figure>
                <img loading="lazy" src="/sites/www/files/styles/cgov_article/public/cgov_image/media_image/2025-04/dividing-breast-cancer-cell-article-only.jpg?itok=GHCV4T2Q" width="600" height="340" alt="Breast cancer cell dividing, as seen using microscope." />




              <figcaption class="cgdp-image__caption">
        <div class="cgdp-image__caption-text">
          <p>A dividing breast cancer cell.</p>
        </div>
                  <p class="cgdp-image__credit">Credit: National Cancer Institute / Univ. of Pittsburgh Cancer Institute</p>
              </figcaption>
      </figure>
  </div>


  </div>

		

        "originGoalId": "4aeced1e-15cd-58df-83f7-68e2531c2d32",
        "front": {
          "de": "Wie ist der Massenanteil wᵢ eines Bestandteils i definiert?",
          "en": "How is a constituent’s mass fraction wᵢ defined?"
        },
        "back": {
          "de": "wᵢ = mᵢ / Σmⱼ. Der Nenner ist die Gesamtmasse aller Bestandteile des Gemisches, einschließlich i. Der Anteil ist dimensionslos; Prozentangabe = 100 · wᵢ %.",
          "en": "wᵢ = mᵢ / Σmⱼ. The denominator is the total mass of all mixture constituents, including i. The fraction is dimensionless; percentage = 100 · wᵢ %."
        },
        "deckId": "de_gymnasium_chemistry_basics_seki",
        "memoryGoalIds": [
          "1e372b97-6f1c-596c-8a8b-fc03193d784a"
        ]

      "tupleDigest": "sha256:ec1c35ef1d4ed69ec01637405ac15cf4545a9f89b33f8e76fb04f058661cb9a4",
      "priorScientificRecord": {
        "cardId": "fec5886f-2463-5ca7-af58-0c3e17b5498b",
        "originGoalId": "4aeced1e-15cd-58df-83f7-68e2531c2d32",
        "memoryGoalId": "1e372b97-6f1c-596c-8a8b-fc03193d784a",
        "decision": "keep",
        "scientificReasoning": "Gesamtmasse Σm_j enthält i; w_i ist dimensionslos und 100·w_i % ist die Prozentdarstellung. Eigene aktuelle NIST 8.6.10 und IUPAC Green Book 2.10 bestätigen dies. Der definitorische Abruf ist dem aktuellen Anteilsziel zugeordnet, nicht einem alten Cluster. Notwendigkeit steht in meinem eigenen M-Datensatz.",
        "visibilityDecision": "hold until actual same-scope memory support is shown"
      },

    {
      "cardId": "6ff2e974-3691-5239-9531-2aa966c8c620",
      "exactScientificTuple": {
        "cardId": "6ff2e974-3691-5239-9531-2aa966c8c620",
        "originGoalId": "49d42c38-419c-5048-b7e9-860645dd122d",
        "front": {
          "de": "Wie ist der Volumenanteil φᵢ eines Bestandteils i definiert? Welche Volumina stehen im Nenner?",
          "en": "How is a constituent’s volume fraction φᵢ defined? Which volumes form its denominator?"
        },
        "back": {
          "de": "φᵢ = Vᵢ / ΣVⱼ mit den bei gleicher Temperatur und gleichem Druck vor dem Mischen bestimmten Bestandteilsvolumina. Der Nenner ist deren Summe, auch wenn das gemessene Endvolumen abweicht. Der Anteil ist dimensionslos; Prozentangabe = 100 · φᵢ %.",
          "en": "φᵢ = Vᵢ / ΣVⱼ using constituent volumes determined before mixing at the same temperature and pressure. Their sum is the denominator even if measured final volume differs. The fraction is dimensionless; percentage = 100 · φᵢ %."
        },
        "deckId": "de_gymnasium_chemistry_basics_seki",
        "memoryGoalIds": [
          "1e372b97-6f1c-596c-8a8b-fc03193d784a"
        ]
      },
      "tupleDigest": "sha256:126655cfae67fafdf7c676770f8149ec0d7af539fac515d052da5337913ca13a",

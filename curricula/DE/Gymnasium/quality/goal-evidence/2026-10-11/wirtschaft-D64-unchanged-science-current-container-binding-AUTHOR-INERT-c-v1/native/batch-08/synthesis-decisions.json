      "finalText": {
        "titleDe": "Finanz- und Ertragslage mit Kennzahlen darstellen",
        "titleEn": "Represent financial position and performance using ratios",
        "descriptionDe": "Die lernende Person kann die Finanz- und Ertragslage von Unternehmen mithilfe geeigneter Kennzahlen darstellen, auch mit Tabellenkalkulationsprogrammen.",
        "descriptionEn": "The learner can represent companies’ financial position and performance using suitable ratios, including spreadsheet applications."
      },
      "resolutionDecision": "keep_current",
      "evidenceRound": "first",

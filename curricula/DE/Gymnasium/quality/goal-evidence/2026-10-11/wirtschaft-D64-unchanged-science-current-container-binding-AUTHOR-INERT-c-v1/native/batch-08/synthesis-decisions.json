        "titleDe": "Kapitalgeber und Haftung",
        "titleEn": "Describe capital providers and liability",
        "descriptionDe": "Die lernende Person kann Rechte/Pflichten von Kapitalgebern und Haftungsrisiken beschreiben.",
        "descriptionEn": "The learner can describe capital providers' rights and duties and liability risks."
      },
      "resolutionDecision": "keep_current",
      "evidenceRound": "first",
      "records": {
        "first": {
          "recordId": "current336-D124-b05-a-04-c4f27b51-958c-5416-a2de-d96a6e59e8b5",

  "findings": [
    {
      "id": "A-P-PRELIM-01-b6-X-mass-not-water-mass",
      "goalId": "b6b1a9ab-3930-5165-8b4e-92b3d87ea014",
      "caseId": "persistent-receptor-example",
      "field": "materialDe/materialEn plus whole profile brief",
      "status": "REVISE_BEFORE_FINAL_CURRENT_REVIEW",
      "actualTextDe": "Nach Beenden der Zufuhr verbleiben80% der Wassermenge nach30Tagen.",
      "issueDe": "Die benannte Wassermenge ist keine definierte verbleibende Menge des unveränderten X. Die Musterlösung leitet daraus langsamen X-Abbau ab. Größenbezug/DEEN-Ausdruck müssen eindeutige passende chemische Modellbefunde liefern.",
      "minimalRecommendationDe": "Restanteil klar auf ursprüngliche Menge des unveränderten X im Wasser beziehen; geeignete gleichbleibende System-/Abbaumodellannahme explizit nennen, damit Verluste/Verdünnung/Verteilung nicht mit Abbau verwechselt werden. Nur eigene fiktive Lehrdaten, kein tatsächlich durchgeführter Versuch. Ganze DEEN-Material/Brief/normalP synchron."
    },
    {
      "id": "A-P-PRELIM-02-b6-absent-food-chain-data-rubric",
      "goalId": "b6b1a9ab-3930-5165-8b4e-92b3d87ea014",
      "caseId": "fast-degradation-continuous-input",
      "field": "mandatoryCoverageCriteria[persistence-and-food-web]",
      "status": "REVISE_BEFORE_FINAL_CURRENT_REVIEW",
      "actualCriterionDe": "Interpretiert zeitliche Abbau- und vergleichbare Nahrungskettendaten mit Einheiten und begrenzt eine ungestützte Verallgemeinerung.",
      "issueDe": "Der ganze Fall sagt ausdrücklich, fürY/Z seien keine Nahrungskettenkonzentrationen gegeben. Die ausdrücklich mandatory Forderung nach Interpretation vorhandener vergleichbarer Nahrungskettendaten ist daher nicht erfüllbar. Eine Erklärung der Datenlücke ist sinnvolle, aber andere Leistung.",
      "minimalRecommendationDe": "Fallbezogen vorhandene Abbauanteile/Zeiten auswerten und fehlende Nahrungskettendaten als Aussagegrenze verlangen. Profile/Pflichtkriterien und vollständige Fälle so synchronisieren, dass tatsächlich verfügbare Daten bzw. deren belegte Abwesenheit geprüft werden; keine unbekannten Daten erfinden. Ganze erste Daten-Auswertungsleistung bleibt erhalten."
    },
    {
      "id": "A-P-PRELIM-03-b6-causal-endocrine-link",
      "goalId": "b6b1a9ab-3930-5165-8b4e-92b3d87ea014",
      "caseId": "fast-degradation-continuous-input",
      "field": "materialDe/materialEn and workedPerformanceDe/En",
      "status": "REVISE_BEFORE_FINAL_CURRENT_REVIEW",
      "issueDe": "Material berichtet veränderte Hormonsignale und schädliche Entwicklungsendpunkte gemeinsam. Die Pflicht fordert vorgegebenen Mechanismus mit daraus folgendem schädlichen Endpunkt; die Musterlösung behandelt die bloße gemeinsame Nennung schon als verbundene endokrine Schädigung.",
      "minimalRecommendationDe": "Kausale Verbindung der Signaländerung zum schädlichen Endpunkt ausdrücklich als eigene Unterrichts-Modellannahme liefern oder das Urteil auf eine Hypothese begrenzen. Das Profilprinzip hormonartige/Rezeptorwirkung allein≠nachgewiesener endokriner Schaden erhalten; keine echte experimentelle Bestätigung behaupten."
    },
    {
      "id": "A-P-PRELIM-04-eb-meaning-is-not-actual-is-ought-transfer",
      "goalId": "eb48ba5b-eaa9-52bc-a579-841fc2566182",
      "caseId": "evidence-and-meaning",
      "field": "mandatoryCoverageCriteria[normative-transfer] and freshTransfer",
      "status": "REVISE_BEFORE_FINAL_CURRENT_REVIEW",
      "actualCriterionDe": "Widerlegt einen naturalistischen Fehlschluss im neuen Fall, ohne eine persönliche Weltanschauung zur Pflichtantwort zu machen.",
      "issueDe": "Der frische Transfer verbindet eine neue Stammbaumverzweigung mit einer religiösen Sinnfrage. Dies ist eine unzulässige Übertragung der naturwissenschaftlichen Aussagegrenze/Kategorienverwechslung, jedoch kein konkret formulierter Ist→Soll-Schluss. Die mandatory Rubrik behauptet einen dort nicht gelieferten speziellen Operator. Der zweite ganze Fall naturalistic-fallacy prüft den echten Ist→Soll-Schluss korrekt.",
      "minimalRecommendationDe": "Die erste Fallrubrik bzw. passende Profil-Erwartung fallgerecht auf Aussagegrenzen-/Sinnfragen-Transfer beziehen oder tatsächlich passenden ganzen normativen Fall synchron liefern. Gute erste Material-/Lösungsargumente und echten zweiten normativen Transfer erhalten. Kein Zwang zu persönlicher Weltanschauung und keine neue Pflichtsource-Promotion vonQ2.2."
    }

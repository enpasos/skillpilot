  "findings": {
    "D": {
      "verdict": "accepted",
      "reason": "Both DE and EN describe one assessable contextual reflection. Trigger, effect on observation/action and justified response are linked aspects of that reflection. The wording is pupil-facing, concrete and faithful to reflect; it neither certifies feelings nor requires overcoming disgust. No semantic text change recommended."
    },
    "P": {
      "verdict": "accepted_current_machine_candidate",
      "reason": "Full P1 expectation and both DE/EN case bodies, materials, worked responses, three rubric criteria, acceptable alternatives and fresh variations examined. Mara changes from surface-triggered text to sketch, then revises when shape is also a trigger. Ben distinguishes an imagined odor from available color information and rejects physical distance when a caption word is the trigger. Both demand linked reasoning, justify alternatives and adapt to new facts; neither personal disclosure, actual touching/smelling nor reduced disgust earns mastery. Worked responses are authored illustrations, not observed learner work.",
      "preservedStatus": "needs_human_review",
      "preservedAuthority": "ai_candidate",
      "evidenceLevel": "E1",
      "maximumClaimScope": "G1",
      "approvedProfileCount": 0,
      "humanApproval": false,

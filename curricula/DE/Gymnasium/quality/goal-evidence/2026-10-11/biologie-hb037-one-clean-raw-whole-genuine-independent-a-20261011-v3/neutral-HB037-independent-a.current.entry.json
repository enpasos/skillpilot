    },
    "A": {
      "verdict": "atomic",
      "semanticAtomic": true,
      "reason": "Exactly one process competence: reflect on a described disgust reaction in relation to a natural object. The trigger/effect/response chain forms its internal reasoning structure and is assessable together; it does not combine independent recall or scientific routines."
    },
    "M": {
      "verdict": "no_memory_needed",
      "reason": "The competence is context-sensitive reflection. The two variations require revision of a reasoned response, not reliable recall of a compact fact. A memorized exposure/avoidance rule would misrepresent the criterion. No new deck or memory-goal link needed."
    },
    "SOURCE": {
      "verdict": "accepted",
      "rawLiteral": "beim Umgang mit Naturobjekten Ekelreaktionen reflektieren",
      "reason": "Actual raw primary page 30 contains the literal process-competence bullet. Page 28 establishes section 3.1 as requirements at the end of grade 8; page 29 supplies Körperleistungen und Gesundheit context and page 30 continues its process competencies. The 2022 annex narrows overall Gymnasium validity to grades 5–9, keeps this theme in 7/8, and moves the separate section 3.2 requirements to grade 9. The annex page 2 pig-eye dissection belongs to the separate perception standard and does not add a dissection/exposure requirement to HB037. The canonical DE/EN formulation operationalizes reflection without changing the object or operator. HB/SekI/G8 scope is consistent; GK/LK tags are compatibility labels, not an upper-secondary course claim.",
      "specificEndGrade": 8,
      "overallValidGrades": "5–9",
      "jurisdiction": "DE-HB",
      "stage": "SekI",
      "durationModel": "G8",
      "noNewYear9Claim": true
    },
    "V": {
      "verdict": "accepted_machine_candidate",
      "reason": "Actual original 1672×941 PNG, 360×203 and 680×383 browser images, supplied whole HTML/PDF captures and all three actual PDF plus three own actual HTML pages inspected. Two comic scenes show the same young person and segmented earthworm, withdrawn hands then greater distance, with readable thought bubbles. No touching, coercion, pathology, infection claim or misleading biological label. The illustration supports orientation and one possible response; P variation expressly blocks a universal distance rule. Alt text matches the image. Native title, description, HB/SekI/G8 scope and one visible parent fit on the whole page without clipping or missing image.",
      "assetSha256": "sha256:edf671ce57bceae95aac1bcab1a8293ad757e26cbd077e85bd8c3eea3f488dec",

+const capturedCommandOutputs = new Map<string, Array<{ path: string; sha256: string; bytes: number }>>()
+
+/** Raw command output records source wording; it is not authored product prose.
+ * Require an exact sibling execution-receipt binding, rather than exempting
+ * files merely because somebody named them stdout or stderr.
+ */
+function isCapturedCommandOutput(relativePath: string, contents: string): boolean {
+  if (!/\.(?:stdout|stderr)\.actual\.txt$/u.test(relativePath)) return false
+  const directory = toPosixPath(dirname(relativePath))
+  let bindings = capturedCommandOutputs.get(directory)
+  if (!bindings) {
+    bindings = []
+    for (const name of readdirSync(resolve(repoRoot, directory))) {
+      if (!name.endsWith('.terminal.actual.json')) continue
+      let receipt: unknown
+      try { receipt = JSON.parse(readFileSync(resolve(repoRoot, directory, name), 'utf8')) } catch { continue }
+      if (!receipt || typeof receipt !== 'object') continue
+      const value = receipt as Record<string, unknown>
+      const commands = [value, ...(Array.isArray(value.actualChecks) ? value.actualChecks : [])]
+      for (const command of commands) {
+        if (!command || typeof command !== 'object' || !Array.isArray(command.argv)) continue
+        if (!Number.isInteger(command.exitCode ?? command.actualExitCode)) continue
+        for (const key of ['stdout', 'stderr']) {
+          const binding = command[key]
+          if (binding && typeof binding.path === 'string' && typeof binding.sha256 === 'string' && Number.isInteger(binding.bytes)) {
+            bindings.push(binding)
+          }
+        }
+      }
+    }
+    capturedCommandOutputs.set(directory, bindings)
+  }
+  const bytes = Buffer.from(contents, 'utf8')
+  const digest = createHash('sha256').update(bytes).digest('hex')
+  return bindings.some((binding) => binding.path === relativePath
+    && binding.sha256.replace(/^sha256:/u, '') === digest && binding.bytes === bytes.length)
+}

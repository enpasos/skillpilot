  "judgment": "HOLD solely for malformed argv classification; other reviewed policy changes are supported",
  "findings": [
    {
      "id": "TRM-A-ARGV-001",
      "severity": "medium",
      "status": "open_executed",
      "rootCause": "Array.isArray(command.argv) alone does not establish executable argv. Exact path/hash/bytes and integer exit do not repair a structurally invalid command vector.",
      "actualIncorrectlyExemptedCases": [
        {
          "name": "empty argv",
          "argv": [],
          "expectedCapture": false,
          "actualCapture": true,
          "expectationPassed": false
        },
        {
          "name": "numeric executable argv",
          "argv": [
            42
          ],
          "expectedCapture": false,
          "actualCapture": true,
          "expectationPassed": false
        },
        {
          "name": "null executable argv",
          "argv": [
            null
          ],
          "expectedCapture": false,
          "actualCapture": true,
          "expectationPassed": false
        },
        {
          "name": "empty executable string",
          "argv": [
            ""
          ],
          "expectedCapture": false,
          "actualCapture": true,
          "expectationPassed": false
        },
        {
          "name": "whitespace-only executable string",
          "argv": [
            "  "
          ],
          "expectedCapture": false,
          "actualCapture": true,
          "expectationPassed": false
        },
        {
          "name": "nonstring argument after executable",
          "argv": [
            "fixture-command",
            42
          ],
          "expectedCapture": false,
          "actualCapture": true,
          "expectationPassed": false
        }
      ],
      "requiredCorrection": "Require nonempty all-string argv and a nonblank argv[0]. Permit empty strings after the executable token, as they are valid process arguments. No directory exemptions, retired-rule relaxation or receipt-filename-only skipping."
    }
  ],

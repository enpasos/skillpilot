    {
      "id": "hb-chemistry-sekii:2022-primary-p20-E-SAEURE-BASE",
      "topicCode": "E-SAEURE-BASE",
      "title": "Primary clauses p20: E-SAEURE-BASE",
      "page": 20,
      "sourceDocumentKey": "HB-GYO-CHEMIE-2022",
      "sourcePath": "curricula/DE/Gymnasium/input/HB/GyO_Chemie_2022.pdf",
      "textKind": "authored_concise_paraphrases_not_original_raw_text",
      "text": "Säure- und Basenverhalten anhand der Brönsted-Theorie erklären\nOxonium- und Hydroxidionenkonzentration mit dem pH-Wert verknüpfen\npH-Werte mit Indikatoren oder pH-Metern ermitteln und Lösungen als sauer, neutral oder basisch klassifizieren\nDas Donator-Akzeptor-Prinzip an Säure-Base-Reaktionen darstellen und erklären sowie Reaktionsgleichungen formulieren\nWirkung und Gefahren von Säuren und Basen in Alltagsprodukten bewerten",
      "sourceGoalIds": [
        "hb-chemistry-sekii-gyo2022-3-2-e-saeure-base-024-372f625f",

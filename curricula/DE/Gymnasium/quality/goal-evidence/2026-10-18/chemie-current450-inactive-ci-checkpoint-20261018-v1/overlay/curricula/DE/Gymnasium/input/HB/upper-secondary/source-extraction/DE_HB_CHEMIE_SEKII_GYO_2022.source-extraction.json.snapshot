        "hb-chemistry-sekii-gyo2022-clause-p12-std-b-standard-b2-b14-gk_lk-06",
        "hb-chemistry-sekii-gyo2022-clause-p12-std-b-standard-b2-b14-gk_lk-07",
        "hb-chemistry-sekii-gyo2022-clause-p12-std-b-standard-b2-b14-gk_lk-08",
        "hb-chemistry-sekii-gyo2022-clause-p12-std-b-standard-b2-b14-gk_lk-09",
        "hb-chemistry-sekii-gyo2022-clause-p12-std-b-standard-b2-b14-gk_lk-10",
        "hb-chemistry-sekii-gyo2022-clause-p12-std-b-standard-b2-b14-gk_lk-11",
        "hb-chemistry-sekii-gyo2022-clause-p12-std-b-standard-b2-b14-gk_lk-12",
        "hb-chemistry-sekii-gyo2022-clause-p12-std-b-standard-b2-b14-gk_lk-13"

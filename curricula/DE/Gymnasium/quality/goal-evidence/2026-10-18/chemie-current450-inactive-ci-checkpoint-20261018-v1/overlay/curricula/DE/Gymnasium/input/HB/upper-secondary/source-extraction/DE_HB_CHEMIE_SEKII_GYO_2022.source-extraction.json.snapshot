        "hb-chemistry-sekii-gyo2022-3-3-2-3-fette-oele-057-e19f685e",
        "hb-chemistry-sekii-gyo2022-clause-p28-2.3-content-gk_lk-02",
        "hb-chemistry-sekii-gyo2022-3-3-2-3-fette-oele-058-cbbe4d73",
        "hb-chemistry-sekii-gyo2022-clause-p28-2.3-content-gk_lk-04",
        "hb-chemistry-sekii-gyo2022-clause-p28-2.3-content-gk_lk-05",
        "hb-chemistry-sekii-gyo2022-clause-p28-2.3-process-gk_lk-01",
        "hb-chemistry-sekii-gyo2022-clause-p28-2.3-process-gk_lk-02",
        "hb-chemistry-sekii-gyo2022-clause-p28-2.3-process-gk_lk-03",
        "hb-chemistry-sekii-gyo2022-3-3-2-3-fette-oele-061-21ec3448"

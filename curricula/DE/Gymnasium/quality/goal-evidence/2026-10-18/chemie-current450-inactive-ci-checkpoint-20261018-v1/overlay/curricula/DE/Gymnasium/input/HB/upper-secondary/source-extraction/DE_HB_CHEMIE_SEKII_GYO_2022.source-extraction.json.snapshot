    },
    {
      "id": "hb-chemistry-sekii:2022-primary-p14-PROCESS",
      "topicCode": "PROCESS",
      "title": "Primary clauses p14: PROCESS",
      "page": 14,
      "sourceDocumentKey": "HB-GYO-CHEMIE-2022",
      "sourcePath": "curricula/DE/Gymnasium/input/HB/GyO_Chemie_2022.pdf",
      "textKind": "authored_concise_paraphrases_not_original_raw_text",
      "text": "Naturwissenschaftliche Denk- und Arbeitsweisen erkennen und anwenden\nDie Rolle von Experimenten, Theorien und Modellen im naturwissenschaftlichen Arbeiten erläutern und unterscheiden",
      "sourceGoalIds": [
        "hb-chemistry-sekii-gyo2022-clause-p14-process-process-gk_lk-01",
        "hb-chemistry-sekii-gyo2022-clause-p14-process-process-gk_lk-02"
      ]
    },
    {
      "id": "hb-chemistry-sekii:2022-primary-p15-PROCESS",
      "topicCode": "PROCESS",
      "title": "Primary clauses p15: PROCESS",
      "page": 15,
      "sourceDocumentKey": "HB-GYO-CHEMIE-2022",
      "sourcePath": "curricula/DE/Gymnasium/input/HB/GyO_Chemie_2022.pdf",
      "textKind": "authored_concise_paraphrases_not_original_raw_text",
      "text": "Experimentelle Untersuchungen durchführen, dokumentieren und bewerten\nNaturwissenschaftliche Informationen fachgerecht recherchieren, erschließen und darstellen\nFachsprache korrekt anwenden\nNaturwissenschaftliche Sachverhalte kontextbezogen sachgerecht bewerten\nNaturwissenschaftliches Wissen nutzen, seine gesellschaftliche Bedeutung erfassen und kritisch diskutieren\nSelbstständig und kooperativ naturwissenschaftliche Fragen bearbeiten\nDaten einfacher experimenteller Untersuchungen digital erfassen\nExperimente digital auswerten, dokumentieren und mit digitalen Medien darstellen\nModelle und Visualisierungen ausgewählter Beispiele auf makroskopischer, mikroskopischer und submikroskopischer Ebene digital darstellen\nDigitale Daten recherchieren, identifizieren und präsentieren\nInformationen digitaler Quellen kritisch bewerten\nDigitale Werkzeuge zur gemeinsamen Erstellung von Dokumentationen und Präsentationen nutzen",
      "sourceGoalIds": [
        "hb-chemistry-sekii-gyo2022-clause-p15-process-process-gk_lk-01",
        "hb-chemistry-sekii-gyo2022-clause-p15-process-process-gk_lk-02",

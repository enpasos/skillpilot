import fs from 'node:fs';import path from 'node:path';import {spawnSync} from 'node:child_process';import {fileURLToPath} from 'node:url';
const out=path.dirname(fileURLToPath(import.meta.url));const root='/home/enpasos/projects/skillpilot';process.chdir(root);const rel=(p:string)=>path.relative(root,p);const configs=fs.readdirSync(path.join(out,'A/validation')).filter(f=>f.endsWith('.config.json')).map(f=>({lane:'A',config:rel(path.join(out,'A/validation',f)),script:'app/scripts/semanticAtomicityReview.ts'}));configs.push({lane:'M',config:rel(path.join(out,'M447.fullscope.inactive-validation.config.json')),script:'app/scripts/memoryCardReview.ts'});const results:any[]=[];
// Sequential stock CLI invocations are the actual unchanged required gates.
for(const [i,c] of configs.entries()){const r=spawnSync('app/node_modules/.bin/tsx',[c.script,'--config='+c.config,'--mode=check'],{cwd:root,encoding:'utf8',maxBuffer:10*1024*1024});const log=path.join(out,'stock-check-logs',String(i+1).padStart(3,'0')+'-'+c.lane+'.txt');fs.mkdirSync(path.dirname(log),{recursive:true});fs.writeFileSync(log,r.stdout+'\n'+r.stderr);results.push({...c,exitCode:r.status,log:rel(log),output:r.stdout.split('\n').filter(l=>!l.startsWith('- ')&&l.trim()).slice(0,30),error:r.error?.message??null});}
fs.writeFileSync(path.join(out,'CHECK.stock-A-M.actual.json'),JSON.stringify({atUTC:new Date().toISOString(),stockScriptsUnchanged:true,checks:results,allPassed:results.every(r=>r.exitCode===0)},null,2)+'\n');console.log(JSON.stringify({checks:results.length,A:results.filter(r=>r.lane==='A').length,M:results.filter(r=>r.lane==='M').length,failures:results.filter(r=>r.exitCode!==0)},null,2));if(results.some(r=>r.exitCode!==0))process.exitCode=1;

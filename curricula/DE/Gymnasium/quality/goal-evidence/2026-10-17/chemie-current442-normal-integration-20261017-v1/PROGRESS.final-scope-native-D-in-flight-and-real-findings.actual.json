  "openScientificFindingsFromAlreadyCompletedNativeBatches": [
    {
      "goalId": "684ffe86-3a9f-5514-866a-47d16372f2d4",
      "titleDe": "Kohlenhydratklassen strukturbezogen unterscheiden",
      "readiness": "OPEN_PENDING_BOTH_COMPLETE_FIRST_PASSES_AND_REAL_SCIENTIFIC_RESOLUTION",
      "reviewerFindings": [
        {
          "round": "a",
          "decision": "keep",
          "profileRecommendation": "revise",
          "rationale": "D ist bilingual klar und grenzt den Nachweisnachfolger ab. Das ganze P deckt Klassen/Eigenschaften ab, fordert aber zusätzlich einen formalen Aldosen-Stammbaum und C2-Epimervergleich; diese eigenständige Konfigurationsleistung ist im D-Umfang nicht erkennbar und überschneidet den Konfigurationsnachfolger. P-Alignment prüfen, keine neue D-Kompetenz hinzufügen."
        },
        {
          "round": "b",
          "decision": "keep",
          "profileRecommendation": "revise",
          "rationale": "Die aktuelle Beschreibung ist als Klassen-/Struktur-Eigenschaftsziel klar. Das gesamte P ergänzt jedoch verpflichtendes Zeichnen eines Aldosenstammbaums mit Pentose-Elternmustern und C2-Konfigurationsvergleich. Diese Leistung ist für Mono-/Di-/Polysaccharidklassifikation oder die genannten Eigenschaften nicht nötig und überschneidet den ausdrücklich vorhandenen Konfigurationen-/Anomere-Nachfolger. Diese zusätzliche P-Pflicht muss fachlich abgegrenzt oder passend zugeordnet werden; keine Beschreibungserweiterung als Ausgleich."
        }
      ]
    },
    {
      "goalId": "0278a515-8990-5a1c-8a1b-a03382a144a3",
      "titleDe": "Biokunststoffe erläutern",
      "readiness": "OPEN_PENDING_BOTH_COMPLETE_FIRST_PASSES_AND_REAL_SCIENTIFIC_RESOLUTION",
      "reviewerFindings": [
        {
          "round": "a",
          "decision": "keep",
          "profileRecommendation": "revise",
          "rationale": "D beschreibt Synthese/Eigenschaften und Einsatzfelder klar bilingual. Das ganze P fordert zusätzlich eigene geplante und ausgeführte PLA-Eigenschaftsexperimente; dieser praktische Operator ist im aktuellen D nicht beansprucht. P-Alignment für diese zusätzliche Abschlussbedingung prüfen, Beschreibung nicht stillschweigend erweitern."
        },
        {
          "round": "b",
          "decision": "keep",
          "profileRecommendation": "revise",
          "rationale": "Die aktuelle Beschreibung ist eine Erklärungsleistung zu Synthese, Eigenschaften und Anwendungen. Das P fügt als erforderliche Erwartung hb097 jedoch eine selbst geplante und tatsächlich vollzogene Eigenschaftsuntersuchung hinzu. Dieser praktische Operator ist durch beschreiben/nennen nicht beansprucht und lässt sich nicht aus einem fehlenden Labornachweis als Defizit dieses Ziels ableiten. P-Pflicht passend abgrenzen oder einem praktischen Ziel zuordnen; den Beschreibungsscope nicht dafür erweitern."
        }
      ]
    },
    {
      "goalId": "0959eef2-3c7d-5b33-a109-ddf332a5dbd9",
      "titleDe": "Pflanzenölkraftstoffe strukturbezogen einordnen",
      "readiness": "OPEN_PENDING_BOTH_COMPLETE_FIRST_PASSES_AND_REAL_SCIENTIFIC_RESOLUTION",
      "reviewerFindings": [
        {
          "round": "b",
          "decision": "split_review",
          "profileRecommendation": "revise",
          "rationale": "Der erste Satz verlangt struktur- und herkunftsbezogene Kraftstoffbewertung; der zweite ergänzt industrielle Gewinnung und Generationenklassifikation, die ohne diese Bewertung eigenständig bestanden oder verfehlt werden können. Das P bestätigt dies durch zwei detaillierte Ölverwendungsfälle plus eine eigenständige, nur knapp formulierte HB200-Routenaufgabe. Eine bloße Satzglättung verdeckt die Atomizitätsfrage; P muss nach der fachlichen Zielabgrenzung passend zugeordnet werden."
        }
      ]
    },
    {
      "goalId": "72236f2c-771e-4ab6-933a-e549ee49d15b",
      "titleDe": "Kern-Hülle-Modell und Elementarteilchen beschreiben",
      "readiness": "OPEN_PENDING_BOTH_COMPLETE_FIRST_PASSES_AND_REAL_SCIENTIFIC_RESOLUTION",
      "reviewerFindings": [
        {
          "round": "b",
          "decision": "block",
          "profileRecommendation": "none",
          "rationale": "Die Beschreibung und das P sind in der Kern-Hülle-Erklärung fachlich tragfähig; das P sagt ausdrücklich, dass Protonen/Neutronen im modernen Sinn nicht elementar sind. Der gebundene deutsche UND englische Titel bezeichnet diese Inhalte dennoch als Elementarteilchen/elementary particles. Dieser konkrete sachliche Titelwiderspruch lässt sich durch eine Ersatzbeschreibung nicht beseitigen. Vor Freigabe Titelkonvention fachlich klären, etwa Atombausteine/atomic constituents; keine historische Streumessung oder Neutronenmessung aus den Modellzahlen behaupten."
        }
      ]
    },
    {
      "goalId": "8721d943-8368-5304-bd3c-7d7944099662",
      "titleDe": "Recyclingstrategien abwägen",
      "readiness": "OPEN_PENDING_BOTH_COMPLETE_FIRST_PASSES_AND_REAL_SCIENTIFIC_RESOLUTION",
      "reviewerFindings": [
        {
          "round": "b",
          "decision": "revise",
          "profileRecommendation": "none",
          "rationale": "Die aktuelle Aufzählung stellt hydrolytisches und rohstoffliches Recycling sprachlich als gleichrangige getrennte Kategorien dar, obwohl die beschriebene Polymerhydrolyse eine rohstoffliche Route ist. Die lokale Ersetzung ordnet diese Beziehung korrekt ein und erhält sämtliche Bewertungs-, Quellen- und Energieverwertungsaspekte. Das P selbst unterscheidet Kettenerhaltung, Bindungsspaltung und Energienutzung passend."
        }
      ]
    },
    {
      "goalId": "3eb2a06c-d283-57aa-9eb4-088940c4801a",
      "titleDe": "Wirkstoffentwicklung, Produktion und Vermarktung verknüpfen",
      "readiness": "OPEN_PENDING_BOTH_COMPLETE_FIRST_PASSES_AND_REAL_SCIENTIFIC_RESOLUTION",
      "reviewerFindings": [
        {
          "round": "b",
          "decision": "split_review",
          "profileRecommendation": "revise",
          "rationale": "Der erste Satz ist trotz seiner Länge eine zusammenhängende Kompetenz zur Prozesskette eines Wirkstoffgruppenbeispiels. Der zweite Satz fügt eine historische/aktuelle gesellschaftliche Bewertung hinzu. Das ganze P belegt die Trennbarkeit mit zwei durchgängigen Salicylat-Projektfällen und einem gesonderten HB232-Wirkungs-/Resistenzfall. Beide Leistungen können unabhängig gelingen oder fehlen; eine wording-only Glättung würde diese Atomizitätsfrage verdecken. P danach passend zuordnen statt Kernziel weiter auszubauen."
        }

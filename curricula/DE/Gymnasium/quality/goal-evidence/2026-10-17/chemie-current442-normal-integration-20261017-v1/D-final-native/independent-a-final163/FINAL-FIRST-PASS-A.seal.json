  "PAlignmentFindings": [
    {
      "goalId": "684ffe86-3a9f-5514-866a-47d16372f2d4",
      "decision": "keep",
      "recommendation": "revise",
      "rationale": "D ist bilingual klar und grenzt den Nachweisnachfolger ab. Das ganze P deckt Klassen/Eigenschaften ab, fordert aber zusätzlich einen formalen Aldosen-Stammbaum und C2-Epimervergleich; diese eigenständige Konfigurationsleistung ist im D-Umfang nicht erkennbar und überschneidet den Konfigurationsnachfolger. P-Alignment prüfen, keine neue D-Kompetenz hinzufügen."
    },
    {
      "goalId": "0278a515-8990-5a1c-8a1b-a03382a144a3",
      "decision": "keep",
      "recommendation": "revise",
      "rationale": "D beschreibt Synthese/Eigenschaften und Einsatzfelder klar bilingual. Das ganze P fordert zusätzlich eigene geplante und ausgeführte PLA-Eigenschaftsexperimente; dieser praktische Operator ist im aktuellen D nicht beansprucht. P-Alignment für diese zusätzliche Abschlussbedingung prüfen, Beschreibung nicht stillschweigend erweitern."
    },
    {
      "goalId": "d72cbb62-0b65-5b9a-aece-70c23d4e618a",
      "decision": "keep",
      "recommendation": "revise",
      "rationale": "D legt in beiden Sprachen eine sinnvolle mehrdimensionale Klassifikation mit mindestens drei Klassen fest. Die tatsächlich gelesenen vollständigen A/B/C- und P/Q/R-Karten tragen diese Leistung einschließlich löslich versus pigmentär und Herkunft versus Identität. Das ebenfalls vollständig gelesene hb217-Material ist chemisch plausibel, verlangt aber zusätzlich die Erklärung eines Absorptionswechsels 450→300 nm im Energielückenmodell als Pflicht. Diese Farbigkeitsmechanismusleistung steht nicht in der aktuellen Klassifikationsbeschreibung; P deshalb zur Scope-Ausrichtung überarbeiten, D beibehalten."
    },
    {
      "goalId": "02634fdd-c8ba-591a-b240-77129b1bebb8",
      "decision": "keep",
      "recommendation": "revise",
      "rationale": "D ist fachlich klar und seine 1:1-/1:2-Rechenfälle sowie die Verdünnungsrückrechnung im vollständig gelesenen P sind korrekt. Eine Ausrichtung von P ist dennoch nötig: hb134-own-digital-strong-acid-curve wird als zusätzliche Pflicht mit eigener pH-Messreihe und digitaler XY-Datei geführt. Das tatsächlich gelesene HB134-Ganzmaterial verlangt bei fehlender Reihe neue reale Erfassung. D fordert Indikatortitration und dokumentierte Volumina, keine eigene pH-Kurvenaufnahme; der direkte Nachfolger e0944fbb ist gerade dafür benannt. D KEEP, verpflichtenden P-Mehrumfang abgleichen."
    },
    {
      "goalId": "cc803809-fa7f-517c-b356-9f2f7caf21a5",
      "decision": "keep",
      "recommendation": "revise",
      "rationale": "Die ganze D-Beschreibung verlangt in beiden Sprachen eine tatsächliche thermometrische Untersuchung und ist fachlich sinnvoll. Das vollständige P und beide tatsächlich gelesenen eqrk16-02-Ganzfälle liefern korrekte Redoxrollen und 887,4 J/−222 kJ mol−1 beziehungsweise 916/709,9 J. Sie fordern aber ausdrücklich Planung eines zukünftigen Versuchs und Modellrechnung; ein verbindliches beobachtbares eigenes thermometrisches Durchführen mit Rohdaten fehlt als Abschlussbedingung. Der Hinweis, Modellzahlen ersetzten keine Durchführung, füllt diese positive Beleglücke nicht. P-Ausrichtung revise, D KEEP."
    }
  ],

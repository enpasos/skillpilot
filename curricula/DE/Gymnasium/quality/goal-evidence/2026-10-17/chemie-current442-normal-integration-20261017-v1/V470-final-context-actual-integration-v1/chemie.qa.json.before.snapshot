      "publicAssetPath": "app/public/assets/goal-visualizations/chemie/e313c1ee-a617-54ed-adea-c183da1e03d8/e313c1ee-a617-54ed-adea-c183da1e03d8.jpg",
      "canonicalAssetPath": "curricula/DE/Gymnasium/visualizations/chemie/e313c1ee-a617-54ed-adea-c183da1e03d8/e313c1ee-a617-54ed-adea-c183da1e03d8.jpg",
      "assetSha256": "sha256:a6987f59f725c65c60a23e94b74694e7007a823b3439f9e9a8918345db3ee627",
      "umlautsCorrectChatGpt": "yes",

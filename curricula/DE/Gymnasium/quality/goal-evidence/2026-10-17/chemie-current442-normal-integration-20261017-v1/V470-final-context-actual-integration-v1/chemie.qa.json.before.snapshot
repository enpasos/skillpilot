    {
      "goalId": "ca216bc6-5205-5b46-abbd-fd5628e4ca5b",
      "title": "Acidität begründen",
      "description": "Die lernende Person kann die Acidität von Alkohol-Molekülen und Carbonsäure-Molekülen vergleichen und den Einfluss polarer Bindungen, induktiver Effekte und Mesomerie auf die Säurestärke von Carbonsäuren erklären.",
      "subject": "chemie",
      "landscapeId": "c436b994-8f44-5134-b9f8-0c9f5d6a5ba0",
      "landscapePath": "curricula/DE/Gymnasium/canonical/DE_DEU_S_GYM_CANONICAL_CHEMIE.de.json",
      "visualizationState": "available",
      "missingReason": "",
      "imageUrl": "/assets/goal-visualizations/chemie/ca216bc6-5205-5b46-abbd-fd5628e4ca5b/ca216bc6-5205-5b46-abbd-fd5628e4ca5b.png",
      "publicAssetPath": "app/public/assets/goal-visualizations/chemie/ca216bc6-5205-5b46-abbd-fd5628e4ca5b/ca216bc6-5205-5b46-abbd-fd5628e4ca5b.png",
      "canonicalAssetPath": "curricula/DE/Gymnasium/visualizations/chemie/ca216bc6-5205-5b46-abbd-fd5628e4ca5b/ca216bc6-5205-5b46-abbd-fd5628e4ca5b.png",
      "assetSha256": "sha256:e1b232098e418fe36ca3db44af7ec9c4e53c38ab57cec617ba96073164b73930",
      "umlautsCorrectChatGpt": "no",

      "aiNotes": "{\"sourceFIRST\":{\"path\":\"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-two-local-text-successors-informed-PAV-context-20261015-v1/FIRSTV2.two-existing-images-under-new-whole-text-contexts.json\",\"sha256\":\"sha256:177779d5b5c84dcdbc9114fb692d722b2dfc9f0008ebe22e8c78fbce35487a8b\",\"bytes\":23262},\"originalWholeIndependentVRecord\":{\"goalId\":\"0b5342b9-512d-573f-90d5-7522aee35efa\",\"wholeGoal\":{\"id\":\"0b5342b9-512d-573f-90d5-7522aee35efa\",\"shortKey\":\"canonical_chemistry_by_individual_digestion_resorption\",\"title\":\"Individuelle Verdauungs- und Resorptionsunterschiede begründen\",\"titleEn\":\"Justify individual differences in digestion and intestinal absorption\",\"description\":\"Die lernende Person kann genetisch bedingte oder erworbene individuelle Unterschiede bei Verdauung und Resorption von Nahrungsbestandteilen chemisch begründen.\",\"descriptionEn\":\"The learner can chemically justify genetically caused or acquired individual differences in digestion and intestinal absorption of food components.\",\"weight\":1,\"tags\":[\"GK\",\"LK\",\"canonical\",\"SekII\"],\"contains\":[],\"requires\":[\"3681e688-7880-5bb4-9ab9-ef78289345c8\",\"f7f35d71-927a-511c-a49e-65a66794a9bc\"],\"dimensionTags\":{\"framework\":\"canonical-gymnasium-chemistry\",\"demandLevel\":\"AB3\",\"processCompetencies\":[\"PK2_MODELLIEREN\",\"PK5_BEWERTEN\"],\"guidingIdeas\":[\"BC_REAKTION\"],\"phase\":\"Q2\",\"area\":\"Lebensmittelchemie\",\"topicCode\":\"CANONICAL.CHEMISTRY.Q2.INDIVIDUAL_DIGESTION_RESORPTION\"},\"applicability\":{\"jurisdiction\":[\"DE-BY\",\"DE-HE\",\"DE-NI\",\"DE-RP\",\"DE-SH\",\"DE-SL\",\"DE-SN\"]},\"extendedData\":{\"provenance\":{\"sourceLandscapeId\":\"ff1ca997-b6cc-5ece-8e13-5498b4bbf808\",\"sourceLandscapeTitle\":\"DE-BY - Chemie Gymnasium (Bayern, LehrplanPLUS Source-Extraction)\",\"sourceGoalId\":\"f93dde15-1574-52c0-923b-5780ad39f081\"}},\"type\":\"atomic\",\"examples\":[],\"resourceLinks\":[{\"type\":\"goal-visualization\",\"resourceType\":\"image\",\"role\":\"primary\",\"skillpilotId\":\"0b5342b9-512d-573f-90d5-7522aee35efa\",\"title\":\"Visualisierung: Individuelle Verdauungs- und Resorptionsunterschiede begründen\",\"url\":\"/assets/goal-visualizations/chemie/0b5342b9-512d-573f-90d5-7522aee35efa/0b5342b9-512d-573f-90d5-7522aee35efa.png\",\"provider\":\"OpenAI / ChatGPT-Codex built-in image_gen (model version not exposed)\",\"description\":\"Comicartiger Vergleich der enzymatischen Lactosespaltung mit und ohne Lactase. Die Darmsymbole stehen allgemein für den Verdauungstrakt; die Abbildung ist kein anatomischer Lageplan oder klinischer Befund.\",\"altText\":\"Mit Lactase wird die schematische Lactose in zwei Einfachzucker gespalten; ohne Lactase bleibt sie verbunden. Darmsymbole veranschaulichen den Verdauungstrakt.\",\"lang\":\"de\",\"license\":\"CC-BY-4.0\",\"reviewStatus\":\"candidate\"}]},\"image\":{\"path\":\"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-two-existing-missing-image-links-author-successor-20261015-v1/candidate/source/visualizations/chemie/0b5342b9-512d-573f-90d5-7522aee35efa/0b5342b9-512d-573f-90d5-7522aee35efa.png\",\"sha256\":\"sha256:91f16a9a25439e6376c9a7e3fb256bffe0334f6988689858eb84979de0b79ca7\",\"bytes\":1472426},\"wholePromptInput\":{\"path\":\"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-two-local-text-successors-informed-PAV-context-20261015-v1/inputs/two-whole-new-visual-contexts-images-and-prompts.exact.json\",\"sha256\":\"sha256:1597dbde008a21354953ec1a1695ae2b187868cbd5ca18a770f68a761bbf51c0\",\"bytes\":13572},\"nativeActuallyViewedWithViewImage\":true,\"nativeDimensions\":{\"width\":1672,\"height\":941},\"nativeDetailObservation\":\"Original1672x941 file directly inspected.\",\"actualScreensActuallyViewedWithViewImage\":[{\"language\":\"de\",\"containerWidth\":360,\"screenshot\":{\"path\":\"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-two-local-text-successors-informed-PAV-context-202
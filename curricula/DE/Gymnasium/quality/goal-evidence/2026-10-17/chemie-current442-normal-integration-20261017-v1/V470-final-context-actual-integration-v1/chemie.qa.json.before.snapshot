      "publicAssetPath": "app/public/assets/goal-visualizations/chemie/62149f36-87c0-5a2d-8a78-e7d4203f58c2/62149f36-87c0-5a2d-8a78-e7d4203f58c2.png",
      "canonicalAssetPath": "curricula/DE/Gymnasium/visualizations/chemie/62149f36-87c0-5a2d-8a78-e7d4203f58c2/62149f36-87c0-5a2d-8a78-e7d4203f58c2.png",

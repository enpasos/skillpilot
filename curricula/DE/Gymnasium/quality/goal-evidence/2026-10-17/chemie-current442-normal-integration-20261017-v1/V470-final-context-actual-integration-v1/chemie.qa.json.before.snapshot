      "chatGptReviewer": "codex",
      "chatGptNotes": "Content and umlaut checks approved from accepted review ledger chemie-batch-007.md (accepted_pilot_after_regeneration). Review note: Accepted after targeted regeneration. The four jars distinguish element as pure substance, compound as pure substance, mixture of elements, and mixture of compounds. The `N2 + O2` mixture uses only bonded diatomic molecules, water is bent, and carbon dioxide is straight.",
      "humanReviewedAt": null,
      "humanReviewer": "",
      "aiApproved": "yes",
      "aiApprovedAssetSha256": "sha256:395a6ff0bd5142b2e7ac7cc505b616843ccfa14f69702bde96019aa3b2737c0f",

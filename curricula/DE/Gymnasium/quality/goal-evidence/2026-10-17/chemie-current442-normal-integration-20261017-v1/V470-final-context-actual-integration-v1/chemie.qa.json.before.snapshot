    {
      "goalId": "7c0b944d-3f1f-5d26-84b0-2a359f689cf0",
      "title": "Konduktometrische Fällungstitrationen durchführen und auswerten",
      "description": "Die lernende Person kann eine konduktometrische Fällungstitration unter kontrollierten Messbedingungen durchführen, den Leitfähigkeitsverlauf mit den gelösten Ionen und ihrer Fällung erklären, den Äquivalenzpunkt aus den Messdaten bestimmen und daraus die Konzentration des bestimmten Ions stöchiometrisch berechnen.",
      "subject": "chemie",
      "landscapeId": "c436b994-8f44-5134-b9f8-0c9f5d6a5ba0",
      "landscapePath": "curricula/DE/Gymnasium/canonical/DE_DEU_S_GYM_CANONICAL_CHEMIE.de.json",
      "visualizationState": "available",
      "missingReason": "",
      "imageUrl": "/assets/goal-visualizations/chemie/7c0b944d-3f1f-5d26-84b0-2a359f689cf0/7c0b944d-3f1f-5d26-84b0-2a359f689cf0.png",
      "publicAssetPath": "app/public/assets/goal-visualizations/chemie/7c0b944d-3f1f-5d26-84b0-2a359f689cf0/7c0b944d-3f1f-5d26-84b0-2a359f689cf0.png",
      "canonicalAssetPath": "curricula/DE/Gymnasium/visualizations/chemie/7c0b944d-3f1f-5d26-84b0-2a359f689cf0/7c0b944d-3f1f-5d26-84b0-2a359f689cf0.png",
      "assetSha256": "sha256:2ba79c6ee5a58dceca997db185a975c0cb6cd358d047e5b4de9d3fb432ad3138",
      "umlautsCorrectChatGpt": "no",
      "contentApprovedChatGpt": "no",
      "humanApproved": "no",
      "humanIssueIdentified": "no",
      "humanIssueDescription": "",
      "chatGptReviewedAt": null,

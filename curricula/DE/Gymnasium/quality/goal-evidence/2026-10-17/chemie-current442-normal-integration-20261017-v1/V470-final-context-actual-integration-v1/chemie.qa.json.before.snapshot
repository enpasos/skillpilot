    {
      "goalId": "0f632595-5875-5a95-83d8-7de3180bdaa6",
      "title": "Lebensgemeinschaften und Standortfaktoren im Freiland charakterisieren",
      "description": "Die lernende Person kann eine hypothesengeleitete ökologische Freilanduntersuchung schonend planen und durchführen, Lebensgemeinschaften sowie abiotische Standortfaktoren qualitativ und quantitativ mit eigener Stichprobe dokumentieren und beobachtete Zusammenhänge von kausalen Aussagen unterscheiden.",
      "subject": "chemie",
      "landscapeId": "c436b994-8f44-5134-b9f8-0c9f5d6a5ba0",
      "landscapePath": "curricula/DE/Gymnasium/canonical/DE_DEU_S_GYM_CANONICAL_CHEMIE.de.json",
      "visualizationState": "available",
      "missingReason": "",
      "imageUrl": "/assets/goal-visualizations/chemie/0f632595-5875-5a95-83d8-7de3180bdaa6/0f632595-5875-5a95-83d8-7de3180bdaa6.png",
      "publicAssetPath": "app/public/assets/goal-visualizations/chemie/0f632595-5875-5a95-83d8-7de3180bdaa6/0f632595-5875-5a95-83d8-7de3180bdaa6.png",
      "canonicalAssetPath": "curricula/DE/Gymnasium/visualizations/chemie/0f632595-5875-5a95-83d8-7de3180bdaa6/0f632595-5875-5a95-83d8-7de3180bdaa6.png",
      "assetSha256": "sha256:fc20ac755ab0331a81917d3ccef106e528ff10d94ce317c7bcf6bd709cc88e2b",
      "umlautsCorrectChatGpt": "no",
      "contentApprovedChatGpt": "no",
      "humanApproved": "no",
      "humanIssueIdentified": "no",
      "humanIssueDescription": "",
      "chatGptReviewedAt": null,
      "chatGptReviewer": "",
      "chatGptNotes": "",
      "humanReviewedAt": null,

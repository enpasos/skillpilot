      "publicAssetPath": "app/public/assets/goal-visualizations/chemie/8761cfd2-aa1a-56f1-9272-9cf66ef4b271/8761cfd2-aa1a-56f1-9272-9cf66ef4b271.png",
      "canonicalAssetPath": "curricula/DE/Gymnasium/visualizations/chemie/8761cfd2-aa1a-56f1-9272-9cf66ef4b271/8761cfd2-aa1a-56f1-9272-9cf66ef4b271.png",

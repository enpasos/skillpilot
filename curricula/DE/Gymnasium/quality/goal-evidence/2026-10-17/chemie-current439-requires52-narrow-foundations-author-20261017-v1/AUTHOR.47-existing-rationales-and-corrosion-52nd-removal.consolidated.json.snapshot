    {
      "docketIndex": 38,
      "goalId": "8721d943-8368-5304-bd3c-7d7944099662",
      "title": "Recyclingstrategien abwägen",
      "authorDisposition": "keep_removal_no_addition",
      "addExistingPrerequisiteIds": [],
      "hold": false,
      "holds": [],
      "wholePerformanceRationaleDe": "Die tatsächlichen beiden Materialien liefern funktionale Produktmengen, Energie, Sortierung/Ausbeuten und klar begrenzte Systemgrenzen. Eigenleistung ist die drei Wege erklären, PET-Ester-/PE-C-C-Grenze, Vergleich je gleichem Bedarf und Quellenkritik. Das vollständige Polykondensationsverfahren und dessen Synthesemechanismus sind dafür kein vorheriger Erwerb.",
      "meaningfulCounterexampleBoundaryDe": "Die Person begründet0,50 gegen1,33kWh/kg und PET-Hydrolyse gegenüberPE-Grenze, ohne eine Polykondensation mit Monomerauswahl und Reaktionsführung darstellen zu können.",
      "acquisitionBoundaryDe": "Passende Esterstellen und Hydrolyseprodukte werden als materialgebundene Grundlagen dieses Recyclingziels eingeführt.667bc303 würde zusätzlich Säure/Alkali-Reversibilität/Alltagsester verlangen; die ganze Kunststoffklassenkompetenz wäre ebenfalls umfassender als nötig.",
      "removedDirectPrerequisiteIdsNotRestored": [

    {
      "docketIndex": 29,
      "goalId": "a3788e40-b540-5bed-be37-b33053528422",
      "title": "Carbonsäuren beschreiben",
      "authorDisposition": "keep_removal_no_addition",
      "addExistingPrerequisiteIds": [],
      "hold": false,
      "holds": [],
      "wholePerformanceRationaleDe": "Das P kombiniert Carboxygruppenerkennung, bereitgestellte Indikatorbefunde, CH2-Reihe und Struktur/Skelett-Transfer einschließlich Säure/Ester-Isomeren. Die Bildung der Säure durch Alkanoloxidation ist weder Aufgabeninput noch Nachweisweg. Die konkrete Nachweisleistung arbeitet mit Beobachtungsdaten; es wird keine eigene Säureherstellung oder Versuchsausführung gefordert.",
      "meaningfulCounterexampleBoundaryDe": "Die Person schreibt Butansäure und trennt sie vom gleichsummigen Ester anhand COOH und gegebener Indikatordaten, kann jedoch die Oxidationsfolge Ethanol→Ethanal→Ethansäure noch nicht erklären.",
      "acquisitionBoundaryDe": "COOH-Bindungsumgebung, passende saure Beobachtung und homologe Erweiterung sind eigener Zielkern. Der begrenzte Struktur/Skelett-Leseschritt wird am Säure/Ester-Fall eingeführt; ganze Moleküldarstellungsvielfalt oder mesomere Formeln sind nicht vorher nötig.",
      "removedDirectPrerequisiteIdsNotRestored": [

    "evidenceProfile": {
      "goalId": "28c90c6a-3020-5c51-ac40-d802f3f12d2d",
      "goalFingerprint": "sha256:5e7666abb7cd2c4c761356fcd30cccad0080ed13ebcaeb84fb8683e8b420f9c5",
      "profileRuleVersion": "positive-understanding-evidence-v2",
      "profileFingerprint": "sha256:be2bd97fa5b8a51ab5753e851f0ba3b0260f3f2fdb4d780dbc05ef6b55b0c578",
      "status": "needs_human_review",
      "reviewAuthority": "ai_candidate",
      "evidenceLevel": "E1",

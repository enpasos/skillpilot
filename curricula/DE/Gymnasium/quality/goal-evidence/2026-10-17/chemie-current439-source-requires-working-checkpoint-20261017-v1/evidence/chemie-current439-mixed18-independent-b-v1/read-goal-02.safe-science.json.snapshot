      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Stereoisomerietypen zuordnen",
        "url": "/assets/goal-visualizations/chemie/9decc36b-a69a-5599-a9f0-fcebdf0203d8/9decc36b-a69a-5599-a9f0-fcebdf0203d8.png",
        "altText": "Drei Vergleiche bei gleicher Konstitution: Gestaffelte und ekliptische Newman-Projektionen von Ethan zeigen Konformere durch Drehung um eine Einfachbindung. Zwei räumliche Darstellungen von 2-Brombutan mit vier verschiedenen Substituenten bilden nicht deckungsgleiche Spiegelbilder. E/trans- und Z/cis-1,2-Dichlorethen zeigen verschiedene Anordnungen der Chlorgruppen um die Doppelbindung und sind Diastereomere.",
        "originalDigest": "sha256:11cd739874de87fd9ebf8ca3e40a9c65677b5dfc22297a89683b4ade91af697a",
        "qaStatus": "review_candidate",
        "approvedForPublication": false
      },
      "goalFingerprint": "sha256:881725c14f6fdc54b32a2c1c098b57a668e39ddafb8fc4887a42642e7d18730c",

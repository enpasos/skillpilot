    "evidenceProfile": {
      "goalId": "f85b4651-50ea-5b42-b193-3465c05257a7",
      "goalFingerprint": "sha256:9ffb4363e6e864a302afd1ae4ae743606b402cdde234375ccc281b9043c34ac8",
      "reviewInputFingerprint": "sha256:9c8bbffaee1a3ca35bdd5a5b04954b8bd4b11dc70602fb364af8c1997e9c805b",
      "profileRuleVersion": "positive-understanding-evidence-v2",
      "profileFingerprint": "sha256:f00ad695a87958f2b2ba1a96ea432659086167e9378e4bde96cefa24c8052586",
      "status": "needs_human_review",

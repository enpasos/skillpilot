  "ordinaryContentDecision": {
    "2d16528c-1424-5999-b3d2-af4593a147fc": "KEEP whole existing goal/P",
    "cc5a626a-dc85-57e2-b422-259f92901545": "KEEP whole existing goal; propose one narrowly guarded P terminology successor"

  "newCase": {
    "id": "th-internal-energy-level-diagram-heat-and-volume-work",
    "canonicalJsonSha256": "8e3b497a1ec2c262edd54baa34801b5804d2f028c00a98b363c5c68263ac8cbd",
    "deEnEquivalent": true,
    "operatorActuallyDemanded": "Construct and explain two actual schematic internal-energy level diagrams, including signed heat and work contributions and a direct initial-to-final ΔU arrow. A boundary-arrow vessel sketch is explicitly insufficient.",
    "signChecks": [
      {
        "case": "A",
        "q": "positive",
        "wOn": "negative, expansion",
        "condition": "q exceeds absolute value of work",
        "deltaU": "positive; final level above initial but below bookkeeping heat intermediate",
        "privateConstructiveRelativeExample": [
          0,
          5,
          3
        ]
      },
      {
        "case": "B",
        "q": "negative",
        "wOn": "positive, compression",
        "condition": "work input is less than absolute value of heat output",
        "deltaU": "negative; final level below initial and above bookkeeping heat intermediate",
        "privateConstructiveRelativeExample": [
          0,
          -5,
          -3
        ]
      }
    ],
    "symbolicProof": "For A, q=a>0 and w_on=−b with 0<b<a, so ΔU=a−b>0. For B, q=−a and w_on=b with 0<b<a, so ΔU=−a+b<0. Both direct arrows equal q+w_on.",
    "stateAndProcessDistinction": "U0 is an arbitrary relative energy level. The q/w steps represent a bookkeeping decomposition of transfer contributions, not stored kinds of heat/work or real sequential intermediate states. ΔH=ΔU+Δ(pV); absent information about Δ(pV), a U arrow cannot generally be relabelled ΔH.",
    "freshTransfer": "B changes both transfer directions and the net sign. The learner constructs a new diagram and justifies its endpoint independently; no Joule values, pΔV calculation or molar scaling are demanded.",
    "fit": "Representing how heat and volume work change internal energy, then distinguishing this from enthalpy, directly operationalises the unchanged 4928 concept. It does not create a separate entropy/second-law or numerical-calorimetry goal."
  },

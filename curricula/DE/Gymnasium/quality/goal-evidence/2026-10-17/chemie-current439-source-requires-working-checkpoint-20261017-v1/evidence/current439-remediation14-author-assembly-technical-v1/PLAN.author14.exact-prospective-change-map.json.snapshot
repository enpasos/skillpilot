  "exactDescriptionCandidateDeltas": [
    {
      "goalId": "bbe038e9-86ed-5ec6-ab33-316758ddb16d",
      "title": "Elektronenpaarbindung mit Orbitalüberlappung erklären",
      "changedFields": [
        "description",
        "descriptionEn"
      ],
      "before": {
        "description": "Die lernende Person kann den Zusammenhalt von Atomen in Molekülen durch die Überlagerung einfach besetzter Orbitale erklären.",
        "descriptionEn": "The learner can explain the cohesion of atoms in molecules through the overlap of singly occupied orbitals."
      },
      "authorCandidate": {
        "description": "Die lernende Person kann den Zusammenhalt von Atomen in Molekülen im einfachen Elektronenpaarbindungsmodell durch Überlagerung einfach besetzter Orbitale erklären.",
        "descriptionEn": "The learner can explain the cohesion of atoms in molecules in the simple electron-pair bonding model through the overlap of singly occupied orbitals."
      }
    },
    {
      "goalId": "92c99237-1c74-54fc-bf08-9191656afaa6",
      "title": "Moleküldarstellungen situationsgerecht umwandeln",
      "changedFields": [
        "description",
        "descriptionEn"
      ],
      "before": {
        "description": "Die lernende Person kann verschiedene Formeldarstellungen von Molekülen ineinander überführen und situationsgerecht eine geeignete Darstellung auswählen.",
        "descriptionEn": "The learner can convert different formula representations of molecules into one another and select an appropriate representation for the situation."
      },
      "authorCandidate": {
        "description": "Die lernende Person kann auf Grundlage ausreichender Strukturinformationen verschiedene Formeldarstellungen von Molekülen ineinander überführen und situationsgerecht eine geeignete Darstellung auswählen.",
        "descriptionEn": "The learner can convert different formula representations of molecules into one another using sufficient structural information and select an appropriate representation for the situation."
      }
    },
    {
      "goalId": "a78aacf9-92ea-5627-8776-a595111f754c",
      "title": "Zusammensetzung moderner Waschmittel",
      "changedFields": [
        "description",
        "descriptionEn"
      ],
      "before": {
        "description": "Die lernende Person kann Funktionen von Enthärtern, Bleichsystemen, Enzymen und Hilfsstoffen erklären.",
        "descriptionEn": "The learner can explain functions of softeners, bleaching systems, enzymes, and auxiliaries."
      },
      "authorCandidate": {
        "description": "Die lernende Person kann Funktionen von Wasserenthärtern (Buildern), Bleichsystemen, Enzymen und Hilfsstoffen erklären.",
        "descriptionEn": "The learner can explain the functions of water softeners (builders), bleaching systems, enzymes and auxiliaries."
      }
    },
    {
      "goalId": "64a5bb87-358d-5a22-958a-f66ba5521cd5",
      "title": "Proteinquellen nachhaltig und quellenkritisch bewerten",
      "changedFields": [
        "description",
        "descriptionEn"
      ],
      "before": {
        "description": "Die lernende Person kann tierische und pflanzliche Proteinquellen unter ökologischen, ökonomischen und ethischen Gesichtspunkten vergleichen und Informationen auf fachliche Richtigkeit, Vertrauenswürdigkeit und Intention prüfen.",
        "descriptionEn": "The learner can compare animal and plant protein sources ecologically, economically, and ethically and check information for scientific accuracy, trustworthiness, and intent."
      },
      "authorCandidate": {
        "description": "Die lernende Person kann tierische und pflanzliche Proteinquellen anhand selbst recherchierter Informationen unter ökologischen, ökonomischen und ethischen Gesichtspunkten vergleichen und die Informationen auf fachliche Richtigkeit, Vertrauenswürdigkeit und Intention prüfen.",
        "descriptionEn": "The learner can compare animal and plant protein sources using independently researched information from ecological, economic and ethical perspectives, and assess the information for scientific accuracy, trustworthiness and intent."
      }
    }
  ],

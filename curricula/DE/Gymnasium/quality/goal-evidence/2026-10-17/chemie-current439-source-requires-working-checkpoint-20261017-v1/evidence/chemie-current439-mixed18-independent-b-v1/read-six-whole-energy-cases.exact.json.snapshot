  {
    "sourcePath": "/mnt/e/skillpilot-chemie-L7-20261017/current439-AV-and-native-registry-integration-root-v1/capsule/curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json",
    "sourceJsonPointer": "/cases/2",
    "wholeCase": {
      "id": "energy20-06-a",
      "goalId": "d465d82b-4bf2-5527-bb7c-dad5a92605fe",
      "title": "GeladenerKopf ist nicht Gegenion",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Strukturkarten: A=C12H25−O−SO3− Na+; B=C16H33−N+(CH3)3 Br−; C=C12H25−(OCH2CH2)6−OH. Jeweils unpolare Kette und polare Kopfregion. D enthält NaCl ohne Kohlenwasserstoffkette. Wasser ist Lösemittel; kein Reinstoff-Mischversuch.",
      "materialsEn": "Complete structural abbreviations:A=C12H25−O−SO3− Na+;B=C16H33−N+(CH3)3 Br−;C=C12H25−(OCH2CH2)6−OH. Each tail is nonpolar,the head polar. Water solvent;no laboratory mixing of pure ingredients. CardD isNaCl without a hydrocarbon tail.",
      "taskDe": "OrdneA/B/C begründet als anionisch, kationisch oder nichtionisch zu. Markiere Kopf, Schwanz und Gegenion. Erkläre die Wechselwirkung vonC mit Wasser und warumD kein Tensid ist. Sage eine mögliche Folge einerA/B-Mischung voraus, ohne alle Mischungen als unlöslich zu behandeln.",
      "taskEn": "ClassifyA/B/C as anionic/cationic/nonionic,mark heads/tails/counterions. Explain water interaction of unchargedC and whyD is not a surfactant. Predict a plausible consequence of combiningA/B heads without claiming all mixtures precipitate.",
      "workedReasoningDe": "A trägt den negativen Sulfatester-Kopf, Na+ist Gegenion; B den positiven quartären Ammoniumkopf mit Br−. C hat eine polare sauerstoffreiche Ethoxyregion ohne formale Ladung. Neutralität des gesamten Salzes ändert die Kopfklasse nicht. NaCl fehlt der lipophile Schwanz. Entgegengesetzte Köpfe können abhängig von Konzentration/Zusammensetzung Ionenpaare oder schwerlösliche Komplexe bilden. Die Klasse beweist keine bestimmte Waschleistung.",
      "workedReasoningEn": "A has a negative sulfate-ester head,Na+ is its counterion;B a positive quaternary ammonium head withBr−;C’s oxygen-rich ethoxy region is polar and interacts with water. Neutrality of the entire salt does not change head classification. NaCl lacks a lipophilic tail. Opposite heads can form ion pairs/poorly soluble complexes depending on composition/concentration. Classification does not prove identical cleaning performance.",
      "freshIndependentTransferDe": "Entferne eine Ethoxyeinheit ausC und ersetze Na+ inA durchK+. Welche Klasse bleibt, welche quantitative Eigenschaft ist ohne Daten offen?",
      "freshIndependentTransferEn": "Remove one ethoxy unit fromC and replaceNa+ byK+ inA. Decide which class remains and which quantitative properties cannot follow from structure alone.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Kopfladung statt Gesamtladung des Salzes klassifizieren.",
          "observableEn": "Classify charge on the amphiphilic ion,not total salt charge.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "Kopf, Schwanz und Gegenion richtig zuordnen.",
          "observableEn": "Correctly mark head,tail and counterion.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Hydratation und Mischgrenzen ohne pauschales Leistungsranking erklären.",
          "observableEn": "Assess hydration/mixing limits without unsupported performance ranking.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    }
  },
  {
    "sourcePath": "/mnt/e/skillpilot-chemie-L7-20261017/current439-AV-and-native-registry-integration-root-v1/capsule/curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json",
    "sourceJsonPointer": "/cases/3",
    "wholeCase": {
      "id": "energy20-06-b",
      "goalId": "d465d82b-4bf2-5527-bb7c-dad5a92605fe",
      "title": "Drei Tensidklassen in einer neuen Kopfgruppenserie",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Eigene Strukturkarten bei pH7 in Wasser: K=C16H33-SO3− Na+; G=C12H25-N+(CH3)3 Cl−; L=C12H25-O-C6H11O5, dabei ist C6H11O5 ein ungeladener Glucosidkopf mit freien OH-Gruppen. Zusatzkarte E=C12H25NH2 liegt unter dem bereitgestellten Modell-pH9 überwiegend als C12H25NH3+ vor; die pH-Angabe ist Stoffinformation, keine aus der Kettenlänge abgeleitete Regel. Keine Reinstoffmischung.",
      "materialsEn": "Own structural cards at pH7 in water: K=C16H33-SO3− Na+; G=C12H25-N+(CH3)3 Cl−; L=C12H25-O-C6H11O5, where C6H11O5 denotes an uncharged glucoside head with free OH groups. Extra card E=C12H25NH2 is predominantly C12H25NH3+ below the supplied model pH9; this pH behaviour is substance data, not inferred from tail length. No pure-ingredient mixing.",
      "taskDe": "Charakterisiere K, G und L aus dem Aufbau als anionisch, kationisch oder nichtionisch. Markiere jeweils Kopf, Kette und gegebenenfalls Gegenion und begründe, wie die Kopfregion mit Wasser wechselwirkt. Erkläre am zusätzlichen Amin, warum die pH-Angabe eine Klassifizierung beeinflussen kann, ein quartärer Ammoniumkopf aber nicht auf dieselbe Weise protoniert wird.",
      "taskEn": "Characterise K, G and L as anionic, cationic or nonionic from their structures. Mark head, tail and any counterion, and justify how each head interacts with water. Use the additional amine to explain why pH can affect classification, while a quaternary ammonium head is not protonated in the same way.",
      "workedReasoningDe": "K trägt eine negativ geladene Sulfonatgruppe mit Na+ als Gegenion; G trägt den positiven quartären Ammoniumkopf mit Cl−. L besitzt einen ungeladenen OH-reichen polaren Kopf, der Wasserstoffbrücken mit Wasser bilden kann. Die unpolare Kette vermittelt Wechselwirkung mit unpolaren Stoffen. Gesamtneutralität der Salze ändert die Kopfladung nicht. E kann durch Protonierung kationisch werden; ohne pH-/Stoffdaten ist es nicht als permanent kationisch einzuordnen. Die drei Zuordnungen enthalten keinen Beweis gleicher Waschleistung oder Umweltverträglichkeit.",
      "workedReasoningEn": "K has a negatively charged sulfonate head with Na+ as counterion; G has a positive quaternary ammonium head with Cl−. L has an uncharged OH-rich polar head that can hydrogen-bond with water. The nonpolar tail interacts with nonpolar substances. Overall salt neutrality does not remove head charge. E can become cationic through protonation; without pH/substance data it cannot be treated as permanently cationic. Classification does not establish equal cleaning performance or environmental safety.",
      "freshIndependentTransferDe": "Ersetze den Glucosidkopf von L durch eine angegebene ungeladene Ethoxykette und ersetze Na+ in K durch K+. Begründe, welche Zuordnungen bleiben und welche quantitative Löslichkeits- oder Leistungsangabe neue Stoffdaten benötigt.",
      "freshIndependentTransferEn": "Replace the glucoside head of L with a specified uncharged ethoxy chain and change Na+ to K+ in K. Justify which classifications remain and which quantitative solubility or performance claims require new substance data.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Drei Klassen aus formaler Kopfladung statt Gesamtladung des Salzes begründen.",
          "observableEn": "Justify the three classes from formal head charge rather than overall salt charge.",
          "evidenceBoundary": "Future independent learner performance; not an observed trial."
        },
        {
          "criterionId": "e2",
          "observableDe": "Polare ungeladene OH-/Ethoxyköpfe und geladene Gruppen mit ihrer Wasserwechselwirkung erklären.",
          "observableEn": "Explain water interactions of polar uncharged OH/ethoxy heads and charged groups.",
          "evidenceBoundary": "Future independent learner performance; not an observed trial."
        },
        {
          "criterionId": "e3",
          "observableDe": "pH-/Gegenioneffekt und fehlende quantitative Stoffdaten getrennt beurteilen.",
          "observableEn": "Distinguish pH and counterion effects from missing quantitative substance data.",
          "evidenceBoundary": "Future independent learner performance; not an observed trial."
        }
      ]
    }
  },

    "wholeCase": {
      "id": "energy20-10-b",
      "goalId": "0cf2ffe1-a988-5ffb-ab37-0ac7d58b23dd",
      "title": "Winterwärme und Versorgungssicherheit",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "EigenesKWK-Modell pro10MJ Brennstoff: FC5MJ Strom+3MJ nutzbare Wärme; Verbrennungsanlage3MJ Strom+5MJ Wärme. Winterbedarf2MJ Wärme, Sommer0MJ; keine Speicherung. FC1,60€, Verbrennung1,00€ pro Zyklus; gleiche Verfügbarkeitsklasse, FC-Wartung lokal ungesichert. Vorketten-/Klimadaten fehlen.",
      "materialsEn": "OwnCHP data per10MJ chemical input:FC gives5MJ electricity+3MJ usable-grade heat;combustion unit3MJ electricity+5MJ heat. Winter service needs2MJheat/cycle,summer0MJ;no heat storage. Fictional running costFC€1.60/cycle,combustion€1.00;equal stated availability class,localFC maintenance not secured. Fuel-chain/carbon data intentionally absent.",
      "taskDe": "Vergleiche elektrische und tatsächlich genutzte Gesamtenergie im Winter/Sommer. Begründe eine Versorgungswahl mit Kosten und Wartungszugang und erkläre die Grenze zum vollständigen Klimavergleich.",
      "taskEn": "Compare electrical and actually used total energy in winter/summer. Justify a community supply choice including cost and maintenance access. Explain why this is neither a complete carbon comparison nor simply an efficiency contest.",
      "workedReasoningDe": "Elektrisch50%/30%. Winter: FC(5+2)/10=70%, Verbrennung(3+2)/10=50%; Sommer50%/30%. Beide als80%genutzt zu bezeichnen zählt überschüssige Wärme fälschlich. Stromausbeute, Kosten und Wartungsrisiken sind abzuwägen; gleicher Dienst kann weitere Dimensionierung benötigen. Ohne Brennstoffherkunft keinCO2-Urteil. Zugang/Zuverlässigkeit sind explizit zu gewichtende soziale Kriterien.",
      "workedReasoningEn": "Electrical efficiencies50%/30%. Winter useful totalsFC5+2=7MJ=70%,combustion3+2=5MJ=50%;summer50%/30%. Calling both80%useful would falsely count surplus heat. HigherFC electrical output must be weighed against€1.60/cycle and maintenance risk;equal service may need sizing changes. Without hydrogen/fuel provenance no carbon decision is possible. Weight social access/reliability explicitly as value judgements.",
      "freshIndependentTransferDe": "Ein Wärmenetz nutzt alle5MJ der Verbrennungsanlage. Definiere eine faire Dienstleistungsgrenze und zähle dieselbe Wärme nicht doppelt gut.",
      "freshIndependentTransferEn": "A heat network now uses all5MJ from combustion. Establish a fair service boundary and reconsider;do not credit the same heat twice.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Nominelle Wärme und tatsächlichen Bedarf trennen.",
          "observableEn": "Separate nominal heat from actual demand.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "Winter70%/50% und Sommer50%/30% richtig berechnen.",
          "observableEn": "Consistently calculate winter70%/50% and summer50%/30%.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Kosten, soziale Grenzen und fehlende Klimavorkette offenlegen.",
          "observableEn": "Disclose economic/social limits and missing upstream climate evidence.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    }

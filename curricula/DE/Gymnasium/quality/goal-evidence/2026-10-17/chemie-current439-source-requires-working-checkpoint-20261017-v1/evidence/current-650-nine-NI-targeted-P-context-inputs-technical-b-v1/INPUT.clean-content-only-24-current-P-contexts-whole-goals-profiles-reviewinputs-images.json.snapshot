    {
      "wholeDeck": {
        "deckId": "de_gymnasium_chemistry_organic_q1",
        "title": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
        "cards": [
          {
            "id": "chem_org_q1_001",
            "front": "Alkane, Alkene, Alkine: Bindung und allgemeine Formel?",
            "back": "Acyclische Kohlenwasserstoffe:\n\nAlkane: nur Einfachbindungen, $C_nH_{2n+2}$\n\nAlkene: genau eine Doppelbindung, sonst Einfachbindungen, $C_nH_{2n}$\n\nAlkine: genau eine Dreifachbindung, sonst Einfachbindungen, $C_nH_{2n-2}$\n\nDie Formeln gelten nicht für Ringe oder mehrere Mehrfachbindungen.",
            "category": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
            "tags": [
              "GK",
              "LK",
              "goal:dd58c029-176f-5d99-923e-1c1fda6cf58e",
              "select:chemistry-bw-lk-organic_q1"
            ]
          },
          {
            "id": "chem_org_q1_002",
            "front": "Wichtige funktionelle Gruppen?",
            "back": "Alkohol: $-OH$\n\nAldehyd: $-CHO$\n\nKeton: $>C=O$\n\nCarbonsäure: $-COOH$\n\nEster: $-COOR$",
            "category": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
            "tags": [
              "GK",
              "LK",
              "goal:7990387d-f254-5d3b-a589-a3e7ed9502a3",
              "select:chemistry-bw-lk-organic_q1",
              "select:chemistry-functional-groups-only",
              "goal:cc5a626a-dc85-57e2-b422-259f92901545",
              "goal:0959eef2-3c7d-5b33-a109-ddf332a5dbd9",
              "goal:4d9defde-d3bc-5c43-83ff-9cf6f2930643",
              "goal:f57d53b0-5bdf-5998-81f4-8bfb2fc5bde7"
            ]
          },
          {
            "id": "chem_org_q1_003",
            "front": "IUPAC-Endungen für sauerstoffhaltige Stoffklassen?",
            "back": "Alkanol: -ol\n\nAldehyd: -al\n\nKeton: -on\n\nCarbonsäure: -säure",
            "category": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
            "tags": [
              "GK",
              "LK",
              "goal:e14abd24-a0e5-5ab5-ade3-a8ae4f49e935",
              "select:chemistry-bw-lk-organic_q1"
            ]
          },
          {
            "id": "chem_org_q1_004",
            "front": "Nachweise: C=C-Doppelbindung und Aldehydgruppe?",
            "back": "C=C-Doppelbindung: Bromwasser wird entfärbt.\n\nAldehydgruppe: Fehling- oder Tollens-Probe positiv.",
            "category": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
            "tags": [
              "GK",
              "LK",
              "goal:3de28598-672f-5753-8a45-8f559c2f9dc2",
              "select:chemistry-bw-lk-organic_q1"
            ]
          },
          {
            "id": "chem_org_q1_005",
            "front": "Aldehyd vs. Keton: Fehling/Tollens?",
            "back": "Aldehyde reagieren in der Regel positiv.\n\nKetone reagieren unter Schulbedingungen meist nicht positiv.",
            "category": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
            "tags": [
              "GK",
              "LK",
              "goal:973c12d9-d863-5292-8c68-9c80cdacf9e2"
            ]
          },
          {
            "id": "chem_org_q1_006",
            "front": "Halogenidionen-Nachweis mit Silbernitrat?",
            "back": "Mit $AgNO_3$ entstehen schwerlösliche Silberhalogenide:\n\n$AgCl$ weiß, $AgBr$ cremefarben, $AgI$ gelblich.",
            "category": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
            "tags": [
              "GK",
              "LK",
              "goal:41396457-d97b-55f3-9804-2af1bb188e79"
            ]
          },
          {
            "id": "chem_org_q1_007",
            "front": "Konfiguration vs. Konformation?",
            "back": "Konformation: räumliche Anordnung, die sich bei gleicher Konstitution durch Drehung um Einfachbindungen ändern kann.\n\nKonfiguration: räumliche Anordnung, die nicht allein durch solche Drehungen geändert wird, zum Beispiel R/S oder E/Z.",
            "category": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
            "tags": [
              "GK",
              "LK",
              "goal:85342c52-9722-54b0-8fbb-513d9d648363",
              "select:chemistry-configuration-conformation-only",
              "goal:4955f745-b946-5d3d-82d6-5e52dc8549a3"
            ]
          },
          {
            "id": "chem_org_q1_008",
            "front": "Enantiomer, Diastereomer, E/Z?",
            "back": "Enantiomere: nicht deckungsgleiche Spiegelbilder\n\nDiastereomere: Stereoisomere, aber keine Spiegelbilder\n\nE/Z: Konfiguration an Doppelbindungen",
            "category": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
            "tags": [
              "GK",
              "LK",
              "goal:9decc36b-a69a-5599-a9f0-fcebdf0203d8"
            ]
          },
          {
            "id": "chem_org_q1_009",
            "front": "Stereozentrum am Kohlenstoff?",
            "back": "Ein asymmetrisches Kohlenstoff-Atom ist an vier verschiedene Substituenten gebunden.",
            "category": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
            "tags": [
              "GK",
              "LK",
              "goal:b92bfa45-b500-5647-8fd2-a14b708aaf59"
            ]
          },
          {
            "id": "chem_org_q1_010",
            "front": "IR und $^1H$-NMR: Wofür nutzt man sie?",
            "back": "IR-Spektren zeigen charakteristische Schwingungen funktioneller Gruppen.\n\n$^1H$-NMR unterscheidet Wasserstoff-Umgebungen im Molekül.",
            "category": "Chemie Q1 - Organische Stoffklassen und Stereochemie",
            "tags": [
              "GK",
              "LK",
              "goal:466bd2e9-39a5-5221-b620-945934adce00"
            ]
          },
          {
            "id": "chem_split_tensid_primary_vs_mineralisation",
            "front": "Primärabbau und Mineralisierung: Was ist der Unterschied?",
            "back": "Beim Primärabbau verändern biologische Prozesse den Ausgangsstoff so, dass eine spezifische Eigenschaft verloren geht, bei Tensiden die Oberflächenaktivität; Zwischenprodukte können bleiben. Mineralisierung führt organischen Kohlenstoff in anorganische Endprodukte über, bei vollständigem aerobem Kohlenstoffabbau insbesondere CO2. Ausgangsstoffentfernung allein belegt keine vollständige Mineralisierung; Sorption ist nur Phasenverlagerung.",
            "category": "Chemie - Tensidabbau",
            "tags": [
              "goal:cc5a626a-dc85-57e2-b422-259f92901545",
              "select:chemistry-surfactant-primary-mineralisation-only"
            ]
          },
          {
            "id": "chem_polymer_chain_conformation",
            "front": "Was bedeutet Konformationsänderung einer Polymerkette an drehbaren Einfachbindungen?",
            "back": "Die räumliche Form der Kette ändert sich durch Drehungen um Einfachbindungen. Die chemische Verknüpfung der Atome bleibt erhalten; es werden dabei keine Bindungen gelöst oder neu geknüpft.",
            "category": "Chemie Q2 - Polymere",
            "tags": [
              "goal:4955f745-b946-5d3d-82d6-5e52dc8549a3",
              "select:chemistry-polymer-chain-conformation-only"
            ]
          }
        ]
      },
      "contentPin": {
        "path": "/mnt/e/skillpilot-chemie-L7-20261017/accepted-components-current-bindings-independent-b-v1/capsule/app/public/data/de_gymnasium_chemistry_flashcards_organic_q1.de.json",

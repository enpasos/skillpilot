    "status": "needs_human_review",
    "reviewAuthority": "ai_candidate",
    "reviewedAt": "2026-10-10T11:53:56.152224+00:00",
    "reviewer": "Codex post-seal technical synthesis of genuine current independent A/B and explicitly inherited historical whole science; no third scientific review",
    "reason": "Original complete scientific profile retained exactly. Current paired independent native/source/context A/B reviewed after both FIRST seals. A unterscheidet Interessenbindung von automatischer Verwerfung des Befunds. B ergänzt fachliche Belege und Popularität-versus-Gegenwissen. Unternehmens-/Institutionengeschichte bleibt erkennbare Quellenrolle ohne Neutralitätsgarantie.",
    "evidenceLevel": "E1",
    "maximumClaimScope": "G1",
    "reviewRunIds": [],
    "dissent": [
      "E1/G1 needs_human_review ai_candidate; no human approval, trial or observed learner performance.",
      "Whole-source/course/placement HOLDs remain separate and unchanged."
    ],
    "profile": {
      "archetype": "data",
      "expectations": [
        {
          "id": "claims-and-evidence",
          "essentialUnderstandingDe": "Vertrauenswürdigkeit wird für eine konkrete Aussage anhand Urheberschaft, Intention, Methode, Rohdaten und relevanter Grenzen geprüft.",
          "essentialUnderstandingEn": "Trustworthiness for a specific claim is checked using authorship, intention, method, raw data and relevant limits.",
          "observablePerformanceDe": "Vergleicht Anbieter-, Labor- und anonymes Material bzw. Fachbericht, Verkaufsgraphik und Modelltext; prüft fachliche Relevanz und Beleglage statt Quellen nur zu etikettieren.",
          "observablePerformanceEn": "Compares vendor, laboratory and anonymous material or technical report, sales chart and model text; checks scientific relevance and evidence rather than merely labelling sources."
        },
        {
          "id": "bounded-validity",
          "essentialUnderstandingDe": "Geringere Absorbanz belegt unter festen Bedingungen eine begrenzte Signaländerung; Löslichkeit belegt keine klinische Wirksamkeit.",
          "essentialUnderstandingEn": "Lower absorbance demonstrates a bounded signal change under fixed conditions; solubility does not demonstrate clinical efficacy.",
          "observablePerformanceDe": "Begründet 75 % Absorbanzabnahme und Faktor 10 bzw. 900 % Löslichkeitsanstieg mit korrekter Bezugsgröße und verwirft daraus nicht ableitbare Alles-schadstofffrei-/Wirkungsbehauptungen.",
          "observablePerformanceEn": "Justifies 75% absorbance decrease and factor 10 or 900% solubility increase using the correct reference quantity and rejects unsupported all-pollutant-free/effect claims."
        },
        {
          "id": "revise-source-judgment",
          "essentialUnderstandingDe": "Neue unabhängige Prüfbelege können ein Urteil verbessern; deklarierte Herstellerfinanzierung ist ein zu prüfender Interessenkonflikt, kein automatischer Falschheitsbeweis.",
          "essentialUnderstandingEn": "New independent evidence can improve a judgment; declared manufacturer funding is a conflict to examine, not automatic proof of falsehood.",
          "observablePerformanceDe": "Ändert das Quellenurteil nur für tatsächlich neu belegte Aussagen, prüft unabhängige Methode/Analytumfang oder Finanzierung/Datenauswahl und hält die verbleibende Aussagegrenze fest.",
          "observablePerformanceEn": "Revises the source judgment only for actually newly evidenced claims, checks independent method/analyte scope or funding/data selection and records remaining claim limits."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "claims-and-evidence",
          "bounded-validity",
          "revise-source-judgment"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "new-verification",
          "textDe": "Bisher unvollständige Anbieterangaben erhalten unabhängig überprüfbare Daten.",
          "textEn": "Previously incomplete vendor claims gain independently checkable data."
        },
        {
          "id": "funding-disclosure",
          "textDe": "Ein technisch nachvollziehbarer Bericht legt Herstellerfinanzierung offen.",
          "textEn": "A technically traceable report discloses manufacturer funding."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "upper-source-criticism-dye-removal-claims",
          "taskDemandDe": "Vergleiche Aussagen, Darstellungsformen, Relevanz, Urheber und Intention für „Entfernt X den Farbstoff unter diesen Bedingungen?“ und für „Ist Wasser sicher trinkbar?“ Beurteile Eignung und Validität getrennt.\nFrische Variation: A ergänzt unabhängige vollständige Prüfdaten: Wie muss das Urteil anhand neuer Evidenz angepasst werden?",
          "taskDemandEn": "Compare claims, representations, relevance, authors and intent for “Does X remove the dye under these conditions?” and “Is the water safe to drink?” Assess suitability and validity separately.\nFresh variation: A adds independent complete test data: how must the judgment change with new evidence?",
          "expectedPerformanceDe": "B trägt einen begrenzten Farbstoffvergleich: 75 % geringere A bei gegebenem System, nicht vollständige Schadstofffreiheit. Offene Methoden/Kontrollen erhöhen Prüfbarkeit; Schulurheber allein garantiert nicht Wahrheit. A verfolgt Verkauf, verschweigt Achsen/Analytes und überdehnt Aussage; C ist mangels Daten nicht valide. Keine Quelle belegt Trinkbarkeit oder medizinische Sicherheit. Auch B kann bei Farbumschlag statt Stoffentfernung weitere Methodenprüfung brauchen.\nFrischer Transfer: Ein neues unabhängiges vollständiges Prüfprotokoll kann das bisherige Urteil über A verbessern. Erst tatsächlichen Autor/Unabhängigkeit, Methode, pH/Wellenlänge, Blank, Probenumfang, Wiederholung, Rohdaten und geprüfte Analytliste lesen und prüfen. Wenn es die Abnahme des untersuchten Farbstoffs unter den angegebenen Bedingungen unabhängig bestätigt, diese begrenzte Aussage höher gewichten und den alten pauschalen Zweifel korrigieren. Es belegt nur tatsächlich erfasste Stoffe und Nachweisgrenzen; „alle Schadstoffe entfernt“ oder Trinkwassersicherheit folgt weiterhin nicht. Der Laborbefund B bleibt unter seiner Methodengrenze verwertbar. Die neue Quelle ist im Transfer nur angekündigt; ohne konkrete neue Daten wird kein gelungenes Prüfresultat erfunden.",
          "expectedPerformanceEn": "B supports a bounded dye comparison: 75% lower A for the given system, not complete pollutant absence. Open methods/controls increase checkability; school authorship alone does not guarantee truth. A pursues sales, hides axes/analytes and overextends the claim; C lacks valid evidence. None establishes drinkability or medical safety. B may still need further method checks if colour change rather than removal occurs.\nFresh transfer: A new independent complete test protocol can improve the prior judgment of A. First actually read and examine author/independence, method, pH/wavelength, blank, sample scope, repeats, raw data and the analyte list. If it independently confirms reduction of the investigated dye under stated conditions, give that bounded claim greater weight and revise prior general doubt. It supports only actually covered substances and detection limits; “all pollutants removed” or drinking-water safety still does not follow. Laboratory finding B remains usable within its method limits. The new source is only announced in the transfer; without specific new data no successful test result is invented.",
          "understandingFocusDe": "Quellenkritik verändert sich durch überprüfbare neue Evidenz und wahrt den tatsächlich geprüften Analytumfang.",
          "understandingFocusEn": "Source criticism changes with checkable new evidence and preserves the actually examined analyte scope."
        },
        {
          "id": "upper-source-criticism-pharmaceutical-graph",
          "taskDemandDe": "Beurteile Quellen für die konkrete chemische Löslichkeitsfrage und für eine behauptete pharmazeutische Wirkung. Vergleiche Form, Herkunft, Intention, relevante Evidenz und offene Grenzen.\nFrische Variation: Wie verändert eine von A deklarierte Herstellerfinanzierung die Bewertung, wenn alle Methoden weiterhin prüfbar sind?",
          "taskDemandEn": "Assess sources for the specific chemical solubility question and a claimed pharmaceutical effect. Compare form, origin, intent, relevant evidence and unresolved limits.\nFresh variation: How does declared manufacturer funding of A affect evaluation if methods remain checkable?",
          "expectedPerformanceDe": "A eignet sich bei geprüften Annahmen zur Modell-Löslichkeit; C zum Theoriebezug, nicht als Q-Messung. B verschweigt Nenner und „besser“-Kriterium; bei Anstieg 1,1→11,0 ist Endwert zehnfach, relative Zunahme 900 %, nicht unklar „1000 % besser“. Keine Quelle zeigt Aufnahme, Wirksamkeit oder klinische Sicherheit. Fachliche Plausibilität, Quellenunabhängigkeit und methodische Begrenzung werden gemeinsam gewichtet.\nFrischer Transfer: Herstellerfinanzierung schafft ein relevantes Interesse an günstiger Darstellung, macht fachlich nachvollziehbare pH-/Löslichkeitsdaten aber nicht automatisch falsch. Finanzierung transparent nennen, vollständige Methoden/Rohdaten, Auswahl der pH-Punkte, Unsicherheiten und unabhängige Prüfung verlangen. A kann weiterhin das fiktive Modell unter seinen Voraussetzungen stützen; Finanzierung senkt gegebenenfalls das Vertrauen in unbelegte Verallgemeinerungen. Die berechnete Änderung 1,1→11 ist Faktor 10 bzw. +900 %, ohne Wirksamkeitsbeleg. B bleibt wegen fehlendem Nenner/klinischen Daten ungeeignet für „besser“, C erklärt eine Theorie ohne eigene Q-Messung. Ein Quellenurteil unterscheidet diese Funktionen und die konkrete Sachfrage.",
          "expectedPerformanceEn": "A is suitable for model solubility when assumptions hold; C for theory, not as a Q measurement. B hides denominator and meaning of “better”; 1.1→11.0 is a tenfold final value, relative increase 900%, not an unclear “1000% better”. None shows uptake, efficacy or clinical safety. Scientific plausibility, source independence and methodological limits are jointly weighed.\nFresh transfer: Manufacturer funding creates a relevant interest in favourable presentation but does not automatically falsify scientifically traceable pH/solubility data. Disclose funding and require full methods/raw data, selection of pH points, uncertainties and independent checks. A may still support the fictional model under its assumptions; funding may reduce confidence in unsupported generalisations. Computed change 1.1→11 is factor 10 or +900%, without efficacy evidence. B remains unsuitable for “better” because denominator/clinical data are absent; C explains theory without own Q measurements. Source judgment distinguishes these functions and the specific question.",
          "understandingFocusDe": "Intention, Beleglage und fachliche Eignung werden differenziert geprüft statt finanziert gleich falsch zu setzen.",
          "understandingFocusEn": "Intention, evidence and scientific suitability are examined separately rather than equating funding with falsehood."
        }
      ]
    }
  }
}

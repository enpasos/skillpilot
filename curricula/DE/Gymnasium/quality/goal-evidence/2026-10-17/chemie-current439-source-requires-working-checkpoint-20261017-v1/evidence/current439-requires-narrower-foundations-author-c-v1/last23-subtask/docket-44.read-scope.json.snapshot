    "profile": {
      "archetype": "modeling",
      "expectations": [
        {
          "id": "b006-67cd332f-core",
          "essentialUnderstandingDe": "Bindende und freie Elektronenbereiche um ein Zentralatom ordnen sich im EPA-Modell mit möglichst geringer Abstoßung. Elektronenbereichsgeometrie und sichtbare Atomgestalt sind verschieden; ein freies Paar wird nicht als Atom eingezeichnet.",
          "essentialUnderstandingEn": "Bonding and lone electron domains around a central atom arrange to reduce repulsion in VSEPR. Electron-domain geometry differs from the visible atomic shape; a lone pair is not drawn as an atom.",
          "observablePerformanceDe": "Die lernende Person zählt an gegebenen Lewis-Strukturen Elektronenbereiche und freie Paare, leitet einfache Molekülgestalten ab und nennt Modellgrenzen statt aus exakten Winkeln zu raten.",
          "observablePerformanceEn": "The learner counts electron domains and lone pairs in supplied Lewis structures, derives simple molecular shapes and names limits rather than guessing exact angles."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "b006-67cd332f-core"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "lone-pairs",
          "textDe": "Null, ein und zwei freie Paare am Zentralatom verändern die Atomgestalt.",
          "textEn": "Zero, one and two central-atom lone pairs change molecular shape."
        },
        {
          "id": "domain-number",
          "textDe": "Zwei und vier Elektronenbereiche erzeugen unterschiedliche Grundanordnungen.",
          "textEn": "Two and four electron domains produce different base arrangements."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "water-carbon-dioxide",
          "taskDemandDe": "Gegebene Lewis-Bilder zeigen H–O–H mit zwei freien O-Paaren und O=C=O ohne freie C-Paare. Begründe mit EPA die Molekülgestalten.",
          "taskDemandEn": "Supplied Lewis sketches show H–O–H with two O lone pairs and O=C=O with no C lone pairs. Explain molecular shapes using VSEPR.",
          "expectedPerformanceDe": "H2O hat vier O-Bereiche, aber nur zwei sichtbare Bindungspartner und ist gewinkelt; CO2 hat zwei C-Bereiche und ist linear. Doppelbindungen zählen je als ein Bereich.",
          "expectedPerformanceEn": "H2O has four O domains but only two bonded atoms and is bent; CO2 has two C domains and is linear. Each double bond counts as one domain.",
          "understandingFocusDe": "Lewis→EPA mit zwei verschiedenen Domänenzahlen.",
          "understandingFocusEn": "Lewis-to-VSEPR with two domain counts."
        },
        {
          "id": "ammonia-methane-transfer",
          "taskDemandDe": "Neue gegebene Lewis-Bilder: NH3 hat drei N–H-Bindungen und ein freies N-Paar; CH4 vier C–H-Bindungen ohne freies C-Paar. Vergleiche Atomgestalt, ohne exakte Winkel zu behaupten.",
          "taskDemandEn": "Fresh supplied Lewis sketches: NH3 has three N–H bonds and one N lone pair; CH4 has four C–H bonds and no C lone pair. Compare atomic shape without claiming exact angles.",
          "expectedPerformanceDe": "Beide haben vier Elektronenbereiche; NH3 ist trigonal-pyramidal, CH4 tetraedrisch. Das freie N-Paar ist kein vierter Bindungspartner; die Atomgestalt von NH3 bleibt trigonal-pyramidal.",
          "expectedPerformanceEn": "Both have four electron domains; NH3 is trigonal pyramidal while CH4 is tetrahedral. The N lone pair is not a fourth bonded atom; NH3 molecular shape remains trigonal pyramidal.",
          "understandingFocusDe": "Gleiche Domänenzahl bei verschiedener Molekülgestalt testet freie Paare.",
          "understandingFocusEn": "Same domain count with different molecular shapes tests lone-pair reasoning."
        }
      ]
    }
  }

      "evidenceBoundary": {
        "de": "E0/G0-Autorenentwurf. Kontrollierte tatsächliche Herstellung des eigenen Präparats, Reinigung und eigene spezifische Analyse mit Originalprotokoll sind spätere Kompetenzkriterien. Keine Lernendenhandlung, Messung, Human Approval oder Human Trial wurde ausgeführt/behauptet; solche bereits erfolgten Ausführungen sind keine Voraussetzung maschineller M7-QS. Quelle/Kurs/Projektion sowie unabhängige P/A bleiben offen.",
        "en": "E0/G0 author design. Controlled original synthesis, purification and specific own-product analysis with original records are future competence criteria. No learner act, measurement, Human Approval or Human Trial has occurred or is claimed; previously completed execution is no prerequisite for machine M7 QA. Source/course/projection and independent P/A remain open."
      },
      "independenceConditions": {
        "de": "Aufgabenseite und Daten dürfen gezeigt werden; Lösung, Rubrik und Transfererwartung werden bis nach der unabhängigen Antwort zurückgehalten. Im praktischen Teil zählen eigene beobachtete Handlungen, nicht das Vorlesen des Protokolls.",
        "en": "The task and data may be shown; solution, rubric and transfer expectation are withheld until after the independent response. Practical assessment counts original observed actions, not reading out the protocol."
      },
      "criterionToObservableRubric": [
        {
          "expectationId": "e1",
          "criterionAndObservable": {
            "de": "Die Person begründet Trennfolge und Lösemittelwahl, statt nur ein Rezept zu wiederholen.",
            "en": "The learner justifies separation sequence and solvent choice instead of merely repeating a recipe."
          },
          "futureObservation": null,
          "met": null
        },
        {
          "expectationId": "e2",
          "criterionAndObservable": {
            "de": "Die Person filtriert, wäscht, kristallisiert und trocknet eigene gewogene Proben tatsächlich unter Aufsicht.",
            "en": "The learner actually filters, washes, crystallises and dries original weighed samples under supervision."
          },
          "futureObservation": null,
          "met": null
        },
        {
          "expectationId": "e3",
          "criterionAndObservable": {
            "de": "Die Person führt die ASS-Synthese am eigenen Ansatz aus, dokumentiert Reagenzien, tatsächliche Mengen, Reaktion und getrennte Aufarbeitung.",
            "en": "The learner performs ASA synthesis on an original batch and records reagents, actual amounts, reaction and separate work-up."
          },
          "futureObservation": null,
          "met": null
        },
        {
          "expectationId": "e4",
          "criterionAndObservable": {
            "de": "Die Person führt die freie-SA-Referenzanalyse und Schmelztests am eigenen Roh-/Reinprodukt aus; negative/positive Kontrollen und Spike bestimmen die Verwertbarkeit.",
            "en": "The learner performs free-SA reference analysis and melting tests on original crude/purified product; negative/positive controls and spike determine usability."
          },
          "futureObservation": null,
          "met": null
        },
        {
          "expectationId": "e5",
          "criterionAndObservable": {
            "de": "Die Person hält Massenkonstanz, alle analytischen Abzweigungen, Lösungsmengen, Zeiten, Temperaturen, Farbe und Schmelzbereiche unverändert fest.",
            "en": "The learner records constant mass, every analytical withdrawal, solution quantities, times, temperatures, colour and melting ranges unchanged."
          },
          "futureObservation": null,
          "met": null
        },
        {
          "expectationId": "e6",
          "criterionAndObservable": {
            "de": "Die Person berechnet Quellenstoff-bezogene Ausbeute, Teilansatz-Rückgewinnung und freie-SA-Probenanteile getrennt und kennzeichnet nur bedingte ASS-Reinheitskorrekturen.",
            "en": "The learner separately calculates starting-material-based yield, portion-based recovery and free-SA sample fractions and marks only conditional ASA purity corrections."
          },
          "futureObservation": null,
          "met": null
        },
        {
          "expectationId": "e7",
          "criterionAndObservable": {
            "de": "Die Person passt bei neuem Zucker im Salzfall oder feuchter ASS-Lagerung unabhängige Kontrollen an und führt die erforderlichen praktischen Prüfungen selbst aus.",
            "en": "The learner independently adapts controls for sugar in salt or damp ASA storage and personally performs required practical tests."
          },
          "futureObservation": null,
          "met": null
        }
      ]
    }
  ],

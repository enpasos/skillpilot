  "wholeUnchangedPositiveProfiles": [
    {
      "goalId": "018bec90-445f-4a88-b8bc-228f8335dee6",
      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "b006-018bec90-core",
            "essentialUnderstandingDe": "Ein Leiter braucht bewegliche Ladungsträger. In Metallfestkörpern sind Elektronen beweglich, in Salzschmelzen und Salzlösungen Ionen; feste Ionengitter und Zuckerlösungen besitzen unter den gegebenen Bedingungen keine ausreichend beweglichen Ladungsträger.",
            "essentialUnderstandingEn": "Conduction requires mobile charge carriers. Metal solids have mobile electrons, molten and dissolved salts have mobile ions; fixed ionic lattices and sugar solution lack sufficiently mobile carriers under the given conditions.",
            "observablePerformanceDe": "Die lernende Person vergleicht vorgegebene Leitfähigkeitsdaten, ordnet Leiter/Nichtleiter bei gleichem Messaufbau ein und begründet Unterschiede auf Teilchenebene; bloß „flüssig“ reicht nicht.",
            "observablePerformanceEn": "The learner compares supplied conductivity data, classifies conductors/nonconductors under the same test setup and explains particle-level differences; being liquid alone is insufficient."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b006-018bec90-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "state",
            "textDe": "Festes Salz, Salzlösung und Schmelze unterscheiden Beweglichkeit vorhandener Ionen.",
            "textEn": "Solid salt, solution and melt differ in mobility of existing ions."
          },
          {
            "id": "substance",
            "textDe": "Metall, Salz und molekulare Zuckerlösung verlangen verschiedene Ladungsträgerannahmen.",
            "textEn": "Metal, salt and molecular sugar solution require different carrier explanations."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "copper-salt-sugar-data",
            "taskDemandDe": "Ein einheitlicher Niederspannungs-Messaufbau liefert für Kupferdraht hohe, festes NaCl sehr geringe, 0,1 mol/L NaCl-Lösung hohe und gleich konzentrierte Zuckerlösung sehr geringe Leitfähigkeit. Ordne und begründe; Messwerte sind vorgegeben.",
            "taskDemandEn": "A common low-voltage setup gives high conductivity for copper wire, very low for solid NaCl, high for 0.1 mol/L NaCl solution and very low for equally concentrated sugar solution. Classify and explain from supplied data.",
            "expectedPerformanceDe": "Kupfer: mobile Elektronen; NaCl fest: Ionen ortsgebunden; NaCl gelöst: Na+ und Cl− beweglich; Zucker bleibt molekular, die Flüssigkeit allein erklärt Leitung nicht.",
            "expectedPerformanceEn": "Copper: mobile electrons; solid NaCl: fixed ions; dissolved NaCl: mobile Na+ and Cl−; sugar remains molecular, and liquid state alone does not explain conduction.",
            "understandingFocusDe": "Stoff- und Zustandsvergleich trennt Beobachtung von Modell.",
            "understandingFocusEn": "Substance and state comparison separates observation from model."
          },
          {
            "id": "molten-salt-paper-transfer",
            "taskDemandDe": "Ein neuer Papierdatensatz vergleicht festes und geschmolzenes KBr sowie reines Ethanol: nur die Schmelze zeigt deutliches Leiten. Erkläre ohne praktisches Erhitzen, warum Wasser nicht nötig ist und Ethanol trotz Flüssigkeit kaum leitet.",
            "taskDemandEn": "A fresh paper data set compares solid and molten KBr with pure ethanol: only the melt conducts appreciably. Without practical heating, explain why water is unnecessary and liquid ethanol scarcely conducts.",
            "expectedPerformanceDe": "In der KBr-Schmelze sind K+ und Br− beweglich, im Feststoff nicht; Ethanol besteht überwiegend aus neutralen Molekülen. Kein Wasser als angeblicher Ionenerzeuger.",
            "expectedPerformanceEn": "K+ and Br− move in the KBr melt but not the solid; ethanol mostly consists of neutral molecules. Water is not falsely invoked as creating the ions.",
            "understandingFocusDe": "Neue Schmelze testet den Ladungsträgermechanismus unabhängig vom Bild.",
            "understandingFocusEn": "A fresh melt tests the carrier mechanism independently of the image."
          }
        ]
      }
    },
    {
      "goalId": "04fa0ba1-eb6e-53c8-93d4-dfa28bb4b162",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "coupled-electron-roles",
            "essentialUnderstandingDe": "Oxidation ist Elektronenabgabe, Reduktion Elektronenaufnahme. Das Reduktionsmittel gibt Elektronen ab und wird selbst oxidiert; das Oxidationsmittel nimmt Elektronen auf und wird selbst reduziert. Beide Übergänge sind gekoppelt.",
            "essentialUnderstandingEn": "Oxidation is electron loss and reduction electron gain. The reducing agent donates electrons and is itself oxidized; the oxidizing agent accepts electrons and is itself reduced. Both changes are coupled.",
            "observablePerformanceDe": "Die lernende Person verfolgt im gegebenen neuen Teilchenbeispiel die Elektronen, ordnet beide Übergänge und beide Mittel mit Begründung zu und überträgt die Rollen auf andere Teilchen statt Farben oder Stoffnamen auswendig zuzuordnen.",
            "observablePerformanceEn": "The learner tracks electrons in a fresh supplied particle example, assigns both changes and both agents with reasons, and transfers the roles to different species rather than memorizing colours or substance names."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "coupled-electron-roles"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "different-metal-ion-pair",
            "textDe": "Andere Metalle und Metallionen mit vorgegebenem Ladungszustand; Beobachtung und Teilchenmodell unterscheiden.",
            "textEn": "Different metals and metal ions with specified charges; distinguish observation from particle model."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "zinc-copper-supplied-net-reaction",
            "taskDemandDe": "Gegeben ist Zn + Cu²⁺ → Zn²⁺ + Cu; Kupfer wird abgeschieden. Ordne Elektronenabgabe/-aufnahme sowie Oxidations-/Reduktionsmittel zu und begründe die Kopplung.",
            "taskDemandEn": "Given Zn + Cu²⁺ → Zn²⁺ + Cu, copper is deposited. Assign electron loss/gain and the oxidizing/reducing agents, explaining why the changes are coupled.",
            "expectedPerformanceDe": "Zn gibt zwei Elektronen ab: Oxidation, Elektronendonator und Reduktionsmittel. Cu²⁺ nimmt zwei auf: Reduktion, Elektronenakzeptor und Oxidationsmittel. Metallisches Cu ist hier das Reduktionsprodukt, nicht der Akzeptor.",
            "expectedPerformanceEn": "Zn loses two electrons: oxidation, electron donor and reducing agent. Cu²⁺ gains two: reduction, electron acceptor and oxidizing agent. Metallic Cu is the reduction product here, not the acceptor.",
            "understandingFocusDe": "Rollen aus dem Elektronenübergang statt aus dem Namen ableiten.",
            "understandingFocusEn": "Derive roles from electron transfer rather than names."
          },
          {
            "id": "iron-copper-independent-transfer",
            "taskDemandDe": "Ohne gelösten Musterweg ist Fe + Cu²⁺ → Fe²⁺ + Cu vorgegeben. Eine Behauptung lautet: Das Eisen ist das Oxidationsmittel, weil es oxidiert wird. Prüfe sie und erkläre die beiden Elektronenrollen.",
            "taskDemandEn": "Without a worked method, Fe + Cu²⁺ → Fe²⁺ + Cu is supplied. A claim says iron is the oxidizing agent because it is oxidized. Evaluate it and explain both electron roles.",
            "expectedPerformanceDe": "Fe wird durch Abgabe zweier Elektronen oxidiert und wirkt gerade deshalb als Reduktionsmittel; Cu²⁺ ist das Oxidationsmittel und wird reduziert. Die Bezeichnung des Mittels beschreibt seine Wirkung auf den Partner, nicht den eigenen Produktnamen.",
            "expectedPerformanceEn": "Fe is oxidized by losing two electrons and therefore acts as the reducing agent; Cu²⁺ is the oxidizing agent and is reduced. An agent's name describes its effect on the other reactant, not its own product name.",
            "understandingFocusDe": "Frischer Stoffwechsel und begründete Auflösung einer Rollenverwechslung unabhängig vom Bild.",
            "understandingFocusEn": "Fresh species and a reasoned correction of an agent-role confusion independently of the image."
          }
        ]
      }
    },
    {
      "goalId": "1351706f-4ea6-56e9-951b-87b24cbcdee8",
      "wholeProfile": {
        "archetype": "experiment",
        "expectations": [
          {
            "id": "understanding",
            "essentialUnderstandingDe": "Herstellen ist eine beobachtbare Arbeitsroutine. Sie ist vom Erklären der Löslichkeitsgrenze und vom Berechnen eines Mischungsanteils unabhängig prüfbar.",
            "essentialUnderstandingEn": "Preparation is an observable working routine, assessed separately from explaining a solubility limit or calculating a mixture fraction.",
            "observablePerformanceDe": "Ein vollständiger betreuter Aktionslog zeigt getrenntes Tarieren und Abwiegen, vollständiges Übertragen, Rühren, bestätigte Endbeobachtung und Beschriftung nach der bereitgestellten Arbeitsanweisung. Die lernende Person dokumentiert beim alternativen Modul dessen freigegebenes Lösungsmittel und die jeweiligen Schritte; ein Plan ohne durchgeführten Log wird nicht als Ausführung ausgegeben.",
            "observablePerformanceEn": "A complete supervised action log shows separate taring and weighing, complete transfer, stirring, a confirmed final observation and labelling under the supplied instruction. For the alternative module the learner records its permitted solvent and each specified step; a plan without an executed log is not represented as performance."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "understanding"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "changed-conditions",
            "textDe": "In S wählst du versehentlich Wasser statt des freigegebenen ethanolischen Lösungsmittels. Darfst du den erfolgreichen S-Endbefund aus der Vorlage übernehmen?",
            "textEn": "In S you accidentally choose water instead of its permitted ethanolic solvent. May you copy the successful S endpoint from the example?"
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "preparation-salt-water-performed-log",
            "taskDemandDe": "Führe P-1 unter Aufsicht aus oder führe die Simulatoraktionen tatsächlich in der angegebenen Reihenfolge aus. Gib das ausgefüllte Ausführungsprotokoll ab. Eine geplante Schrittfolge oder die Aussage „Salz löst sich“ reicht ohne Durchführung beziehungsweise Simulatorlog nicht aus.",
            "taskDemandEn": "Execute P-1 under supervision or actually issue the simulator actions in sequence. Submit the completed execution log. A planned sequence or “salt dissolves” without execution or a simulator log is insufficient.",
            "expectedPerformanceDe": "Erwartetes erfolgreiches Protokoll: Freigabe geprüft; trockenes Gefäß tariert; 48,0 g Wasser angezeigt; Wasser-Becherglas sicher abgestellt; leere Wägeschale tariert; darin mit sauberem Spatel separat 2,0 g Salz abgewogen und aus der Wägeschale vollständig ins Wasser übertragen; gerührt; Rückmeldung/Beobachtung: keine sichtbaren Kristalle, einheitliche Flüssigkeit ohne getrennte Phase; mit Kochsalzlösung und Datum beschriftet; keine Abweichung. Das ist eine hergestellte Lösung im begrenzten Fall, keine allgemeine Behauptung über beliebige Salz-/Lösungsmittelkombinationen.",
            "expectedPerformanceEn": "Expected successful log: permission checked; dry vessel tared; 48.0 g water displayed; water beaker placed securely; empty weighing dish tared; 2.0 g salt weighed separately in that dish with the clean spatula and transferred completely from the dish into the water; stirred; feedback/observation: no visible crystals, uniform liquid without a separate phase; labelled salt solution and date; no deviation. This documents preparation in the bounded case, not a claim about arbitrary salt/solvent combinations.",
            "understandingFocusDe": "Herstellen ist eine beobachtbare Arbeitsroutine. Sie ist vom Erklären der Löslichkeitsgrenze und vom Berechnen eines Mischungsanteils unabhängig prüfbar.",
            "understandingFocusEn": "Preparation is an observable working routine, assessed separately from explaining a solubility limit or calculating a mixture fraction."
          },
          {
            "id": "preparation-bound-phase-solvent-transfer",
            "taskDemandDe": "Führe die angegebenen Aktionen für L, S und G im moderierten Simulator aus und gib für jedes Modul den vollständigen Aktions-/Rückmeldungslog mit Endbeobachtung und Beschriftung ab. Benenne die jeweils andere Ausgangsphase und das vorgegebene Lösungsmittel. Ersetze keinen Log durch die bloße Behauptung „das ist löslich“.",
            "taskDemandEn": "Execute the specified L, S and G actions in the facilitator-mediated simulator and submit each complete action/feedback log, final observation and label. Identify each changed starting phase and specified solvent. Do not replace a log with the assertion “it is soluble.”",
            "expectedPerformanceDe": "Erwartet werden drei getrennte Logs mit jeweils geprüftem Modul/Freigabe, dem modulspezifischen Lösungsmittel und der vorgeschriebenen Zugabe. L dokumentiert flüssigen Ausgangsstoff in Wasser, danach keine Schlieren; S festen Ausgangsstoff im ethanolischen Lösungsmittel, danach keine Partikel; G gasförmigen Ausgangsstoff in Wasser unter festgehaltenen Modellbedingungen, Kontakt/Mischen/Warten und bestätigte Aufnahme. Alle enden mit inspect und richtiger Beschriftung. Die L-Mengen und Mischhandlung dürfen nicht ungeprüft auf S oder G übertragen werden.",
            "expectedPerformanceEn": "Three separate logs are expected, each with module/permission checked, its specific solvent and prescribed addition. L records a liquid starting substance in water followed by no streaks; S a solid in ethanolic solvent followed by no particles; G a gas in water under fixed model conditions, contact/mixing/waiting and confirmed absorption. Each ends with inspect and its correct label. L’s quantities and mixing action cannot be copied to S or G without using that module’s instruction.",
            "understandingFocusDe": "Herstellen ist eine beobachtbare Arbeitsroutine. Sie ist vom Erklären der Löslichkeitsgrenze und vom Berechnen eines Mischungsanteils unabhängig prüfbar.",
            "understandingFocusEn": "Preparation is an observable working routine, assessed separately from explaining a solubility limit or calculating a mixture fraction."
          }
        ]
      }
    },
    {
      "goalId": "13d4f336-ab16-54a7-9479-c920b458f385",
      "wholeProfile": {
        "archetype": "experiment",
        "expectations": [
          {
            "id": "b004-13d4f336-core",
            "essentialUnderstandingDe": "Schutzregeln haben konkrete Anlässe: Augenschutz gegen Spritzer, freie Arbeitsfläche und geeignete Kennzeichnung gegen Verwechslung sowie Lehrkraftanweisung bei Unsicherheit oder Zwischenfall. Sicheres Arbeiten beginnt vor der Materialhandlung.",
            "essentialUnderstandingEn": "Safety rules address particular risks: eye protection for splashes, clear workspace and labeling against mix-ups, and teacher direction when uncertain or after an incident. Safe work starts before handling materials.",
            "observablePerformanceDe": "Die lernende Person bereitet an einem ungefährlichen, lehrkraftbetreuten Modellplatz ihren Arbeitsplatz vor, prüft Brille und Beschriftung und meldet einen unklaren Behälter, statt eigenmächtig weiterzumachen.",
            "observablePerformanceEn": "At a harmless teacher-supervised model station, the learner prepares the workspace, checks eye protection and labeling, and reports an unclear vessel rather than proceeding independently."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b004-13d4f336-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "phase",
            "textDe": "Vorbereitung und Reaktion auf einen Zwischenfall werden getrennt geprüft.",
            "textEn": "Preparation and response to an incident are tested separately."
          },
          {
            "id": "risk",
            "textDe": "Verwechslung und Spritzer erfordern unterschiedliche unmittelbare Handlungen.",
            "textEn": "Mix-up and splash call for different immediate actions."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "supervised-water-model-station",
            "taskDemandDe": "An einem lehrkraftbetreuten Modellplatz stehen nur Wasser, zwei klar beschriftete Becher und ein unbeschrifteter Becher. Zeige vor Beginn eine sichere Vorbereitung: Schutzbrille korrekt tragen, Arbeitsplatz freimachen, Beschriftung prüfen und den unklaren Becher der Lehrkraft melden; keine Chemikalien oder Flammen.",
            "taskDemandEn": "At a teacher-supervised model station there are only water, two labeled beakers and one unlabeled beaker. Demonstrate safe preparation: wear eye protection correctly, clear the workspace, check labels and report the unlabeled beaker to the teacher; no chemicals or flames.",
            "expectedPerformanceDe": "Die lernende Person führt die sicheren Vorbereitungsschritte tatsächlich aus, verwendet den unbeschrifteten Becher nicht und erläutert die Verwechslungsgefahr.",
            "expectedPerformanceEn": "The learner actually performs the safe preparation, does not use the unlabeled beaker and explains the mix-up risk.",
            "understandingFocusDe": "Beobachtete Anwendung statt Regelaufsagen.",
            "understandingFocusEn": "Observed application rather than rule recitation."
          },
          {
            "id": "fresh-splash-response-card",
            "taskDemandDe": "Eine neue Situationskarte schildert einen unerwarteten Spritzer einer unbekannten Lösung bei einer lehrkraftgeleiteten Schulübung auf Arbeitsfläche und Kleidung; Hautkontakt ist möglich. Entscheide die sofortigen sicheren Schritte für die betroffene Person und begründe, weshalb Du nicht eigenmächtig weiterarbeitest.",
            "taskDemandEn": "A fresh situation card describes an unexpected splash of an unknown solution during a teacher-run school exercise onto the bench and clothing; skin contact is possible. Decide immediate safe steps for the affected person and why you do not continue on your own.",
            "expectedPerformanceDe": "Die lernende Person stoppt die Arbeit, informiert sofort die Lehrkraft und benennt mögliche Haut- und Kleidungskontamination. Betroffene Haut wird unverzüglich mit fließendem Wasser gespült; kontaminierte Kleidung wird unter Lehrkraft-/Ersthelferanweisung zügig abgelegt, ohne weitere Haut zu benetzen. Sie befolgt die örtliche Erste-Hilfe-Regelung und veranlasst nötige weitere Hilfe; sie improvisiert weder Neutralisation noch Entsorgung.",
            "expectedPerformanceEn": "The learner stops work, immediately alerts the teacher and identifies possible skin and clothing contamination. Affected skin is promptly rinsed with running water; contaminated clothing is removed promptly under teacher/first-aider direction without spreading contamination to skin. They follow local first-aid procedures and obtain further help as needed; they do not improvise neutralization or disposal.",
            "understandingFocusDe": "Neue Kontamination prüft sichere Sofortreaktion, einschließlich Haut und Kleidung, nicht bloß Abstand und Meldung.",
            "understandingFocusEn": "A new contamination tests immediate safe action, including skin and clothing, not merely distance and reporting."
          }
        ]
      }
    },
    {
      "goalId": "1bdaf7f2-ff3b-455a-a7fb-95a44642762a",
      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "closed-system-mass-conservation",
            "essentialUnderstandingDe": "Chemische Reaktionen ordnen Atome neu an; die Masse aller einbezogenen Stoffe bleibt erhalten. Eine Waage zeigt die Erhaltung nur für ein vollständig erfasstes System ohne unberücksichtigten Stoffaustausch unmittelbar.",
            "essentialUnderstandingEn": "Chemical reactions rearrange atoms; the mass of all included substances is conserved. A balance directly shows that conservation only when the whole system is accounted for and no material transfer is ignored.",
            "observablePerformanceDe": "Die lernende Person vergleicht Vorher-nachher-Massen, benennt die mitgewogene Systemgrenze und erklärt scheinbare Abweichungen durch einen möglichen Stoffaustausch, statt das Gesetz als bloßen Merksatz zu wiederholen.",
            "observablePerformanceEn": "The learner compares before-and-after masses, states the weighed system boundary, and explains apparent discrepancies through possible material transfer rather than merely reciting the law."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "closed-system-mass-conservation"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "system-boundary",
            "textDe": "Geschlossenes Gefäß wird mit offenem Gefäß verglichen.",
            "textEn": "A closed vessel is compared with an open vessel."
          },
          {
            "id": "gas-transfer",
            "textDe": "Ein Fall hält das entstehende Gas zurück, der andere lässt es entweichen.",
            "textEn": "One case retains generated gas, while the other allows it to escape."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "sealed-flask-before-after",
            "taskDemandDe": "Ein vorbereitetes Protokoll zeigt eine geschlossene Reaktionsflasche samt Auffangballon mit 150 g vor und 150 g nach einer Gasbildung. Werte die Bilanz aus und erkläre, warum die Masse trotz Gasbildung gleich ist.",
            "taskDemandEn": "A supplied record shows a sealed reaction flask with a collecting balloon weighing 150 g both before and after gas formation. Analyze the balance and explain why the mass remains equal despite gas formation.",
            "expectedPerformanceDe": "Die lernende Person vergleicht 150 g mit 150 g für dasselbe gesamte System, erfasst das Gas im Ballon und erklärt, dass keine Atome verschwinden, sondern Stoffe und Teilchen neu angeordnet werden.",
            "expectedPerformanceEn": "The learner compares 150 g with 150 g for the same complete system, includes gas held in the balloon, and explains that atoms do not disappear but are rearranged into different substances and particles.",
            "understandingFocusDe": "Die Massenbilanz gilt für das vollständig mitgewogene System.",
            "understandingFocusEn": "The mass balance applies to the entire weighed system."
          },
          {
            "id": "fresh-open-gas-loss",
            "taskDemandDe": "In einem neuen bereitgestellten Versuch reagiert ein Stoff in einer offenen Schale unter Gasbildung; auf der Waage sinkt die Masse der Schale samt Inhalt von 80 g auf 77 g. Bedeutet das eine Verletzung der Massenerhaltung? Sage die Bilanz für eine vollständig geschlossene Anordnung voraus.",
            "taskDemandEn": "In a fresh supplied experiment, a substance reacts in an open dish and releases gas; the measured dish and contents fall from 80 g to 77 g. Does this violate conservation of mass? Predict the balance for a fully closed arrangement.",
            "expectedPerformanceDe": "Die lernende Person erklärt die 3 g Differenz als möglicherweise entwichene Gasmasse unter der angegebenen Systemgrenze, ohne deren Zusammensetzung zu erfinden. Für eine vollständig geschlossene und mitgewogene Anordnung erwartet sie wieder gleiche Gesamtmassen.",
            "expectedPerformanceEn": "The learner explains the 3 g difference as potentially escaped gas under the stated boundary without inventing its composition, and expects equal total masses for a fully closed, wholly weighed arrangement.",
            "understandingFocusDe": "Eine scheinbare Abnahme ist mit Erhaltung vereinbar, wenn Masse die Messgrenze verlassen hat.",
            "understandingFocusEn": "An apparent decrease is compatible with conservation when mass has left the measured boundary."
          }
        ]
      }
    },
    {
      "goalId": "326d45bf-9f77-57d5-a054-93e76b034dd5",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "b004t-326d-observed-states-and-identity",
            "essentialUnderstandingDe": "Feste Stoffproben behalten unter Alltagsbedingungen ihre Form, Flüssigkeiten fließen und passen sich der Gefäßform an, Gase verteilen sich im verfügbaren Raum. Beim Schmelzen und Erstarren, bei Übergängen zwischen Flüssigkeit und Gas und bei direkten fest-gasförmigen Übergängen ändert ein benannter Stoff seinen Zustand; die Zustandsänderung allein macht daraus keinen anderen Stoff. Sieden mit Blasenbildung im Flüssigkeitsinneren unterscheidet sich vom Verdunsten an der Oberfläche.",
            "essentialUnderstandingEn": "Solid samples retain their shape under ordinary conditions, liquids flow and take the shape of a container, and gases spread through the available space. Melting and freezing, changes between liquid and gas, and direct solid-gas changes alter the state of an identified substance; a change of state alone does not make it a different substance. Boiling with bubbles throughout the liquid differs from evaporation at its surface.",
            "observablePerformanceDe": "Die lernende Person ordnet vorgegebene Beobachtungen einem festen, flüssigen oder gasförmigen Zustand zu, benennt Ausgangs- und Endzustand samt passendem Übergang und begründet anhand der Stoffangaben, warum beim Übergang derselbe Stoff vorliegt. Bei flüssig zu gasförmig unterscheidet sie Sieden von Verdunsten anhand des Beobachtungsorts.",
            "observablePerformanceEn": "The learner assigns supplied observations to solid, liquid or gaseous states, names initial and final states and the matching transition, and uses material information to justify that the substance remains the same. For liquid-to-gas changes, the learner distinguishes boiling from evaporation by where the change is observed."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b004t-326d-observed-states-and-identity"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "observable-state-properties",
            "textDe": "Beobachtungen zu Form, Fließen und Raumerfüllung ersetzen vorgegebene Zustandsnamen; keine Teilchenerklärung ist nötig.",
            "textEn": "Observations of shape, flow and filling space replace supplied state labels; no particle-level explanation is needed."
          },
          {
            "id": "transition-direction-and-place",
            "textDe": "Richtungen fest-flüssig, flüssig-gasförmig und direkt fest-gasförmig sowie Sieden im Volumen gegenüber Verdunsten an der Oberfläche variieren.",
            "textEn": "Solid-liquid, liquid-gas and direct solid-gas directions vary, as does boiling throughout the liquid versus evaporation at its surface."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "water-observation-sequence",
            "taskDemandDe": "Ohne Bild liegen Beobachtungsnotizen zu reinem Wasser vor. A behält als Eisstück seine eigene Form; nach Erwärmen fließt es und nimmt die Form eines Bechers an; beim Abkühlen wird daraus wieder ein formfestes Stück. Ein dünner Wasserfilm auf einer nicht saugenden Unterlage wird ohne Blasen langsam weniger; die Messnotizen weisen Wasserdampf über ihm nach. Eine andere, offene Wasserprobe bildet beim Erwärmen Blasen im Inneren; über ihr entstehen an einer kühlen Oberfläche Wassertropfen. Ordne die beobachteten Zustände und Übergänge zu, begründe Sieden gegenüber Verdunsten mit dem Ort der Beobachtung und erkläre, welche Angabe die Stoffidentität über die Änderungen hinweg stützt. Es ist eine Datenauswertung, kein Versuch.",
            "taskDemandEn": "Without a diagram, notes describe pure water. A keeps its own shape as a piece of ice; after warming it flows and takes a beaker’s shape; cooling makes it a shape-retaining piece again. A thin water film on a non-absorbent surface slowly diminishes without bubbles, and the supplied readings detect water vapour above it. Another open water sample forms bubbles inside when heated; water droplets form on a cool surface above it. Identify the observed states and transitions, distinguish boiling from evaporation using where each is seen, and explain what information supports the same substance throughout. This is data interpretation, not an experiment.",
            "expectedPerformanceDe": "Das formfeste Eis ist fest, das fließende Wasser flüssig und der nachgewiesene Wasserdampf gasförmig. Eis wird beim Erwärmen zu flüssigem Wasser (Schmelzen), beim Abkühlen wieder fest (Erstarren). Der Film verdunstet an der Oberfläche; die Blasen im Flüssigkeitsinneren zeigen Sieden. Wasserdampf kondensiert an der kühlen Oberfläche zu flüssigen Tropfen. Die Notizen benennen die Probe als reines Wasser und verfolgen sie durch die Zustandswechsel; daraus folgt in diesem Fall dieselbe Stoffidentität, nicht ein neuer Stoff allein aus geänderter Form.",
            "expectedPerformanceEn": "The shape-retaining ice is solid, flowing water is liquid, and the detected water vapour is gaseous. Warming ice produces liquid water by melting; cooling freezes it again. The film evaporates at its surface, while bubbles inside the liquid indicate boiling. Water vapour condenses to liquid droplets on the cool surface. The notes identify and follow one pure water sample through the state changes, supporting the same substance here rather than a new substance from changed form alone.",
            "understandingFocusDe": "Drei Zustände aus beobachtbaren Eigenschaften erkennen, mehrere Richtungen deuten und Sieden/Verdunsten ohne Bild unterscheiden.",
            "understandingFocusEn": "Recognise three states from observable properties, interpret several transition directions and distinguish boiling from evaporation without an image."
          },
          {
            "id": "carbon-dioxide-direct-transition-data",
            "taskDemandDe": "Eine Lehrkraft stellt nur Messnotizen zu einer gekennzeichneten reinen Kohlenstoffdioxidprobe aus fachgerecht belüfteten Beobachtungen bei Normaldruck bereit: Ein formfestes Stück wird kleiner, während sich ein farbloses, als Kohlenstoffdioxid nachgewiesenes Gas darüber ausbreitet; die durchgehende Beobachtung zeigt keine Flüssigkeit. Bei einer späteren Abkühlung desselben Gases an einer ausreichend kalten Oberfläche entsteht direkt ein fester Belag; auch hier zeigt die durchgehende Beobachtung weder Tropfen noch einen Flüssigkeitsfilm. Die bereitgestellte Stoffanalyse weist den Belag ebenfalls als Kohlenstoffdioxid aus. Ordne die Zustände und beide direkten Übergänge zu und begründe mit den Proben- und Analysedaten, weshalb dieselbe Stoffart vor und nach den Übergängen vorliegt. Lernende führen keinen Versuch durch.",
            "taskDemandEn": "A teacher supplies measurement notes only for a labelled pure carbon dioxide sample from appropriately ventilated observations at ordinary pressure: a shape-retaining piece shrinks while a colourless gas identified as carbon dioxide spreads above it; continuous observation shows no liquid. When the same gas is later cooled at a sufficiently cold surface, a solid deposit forms directly; continuous observation again shows neither droplets nor a liquid film. The supplied material analysis also identifies the deposit as carbon dioxide. Identify the states and both direct transitions, and use the sample and analysis information to justify the same substance before and after the changes. Learners do not perform the procedure.",
            "expectedPerformanceDe": "Das formfeste Stück und der Belag sind fest; das sich ausbreitende Gas ist gasförmig. Der direkte Weg fest zu gasförmig heißt Sublimieren, der Rückweg gasförmig zu fest Resublimieren. Die gekennzeichnete reine Ausgangsprobe sowie die Analysen von Gas und Belag weisen Kohlenstoffdioxid aus. Die durchgehenden Beobachtungen schließen in beiden Fällen eine flüssige Zwischenphase aus; die Daten stützen somit Zustandsänderungen derselben Stoffart. Eine allgemeine Reaktionsdiagnose ist nicht gefordert.",
            "expectedPerformanceEn": "The shape-retaining piece and deposit are solid; the spreading gas is gaseous. The direct solid-to-gas change is sublimation, and the reverse gas-to-solid change is deposition. The labelled pure starting sample and the analyses of gas and deposit all identify carbon dioxide. Continuous observations exclude a liquid intermediate in both cases, supporting state changes of the same substance. A general reaction diagnosis is not required.",
            "understandingFocusDe": "Neuer Stoffkontext mit beobachtbarer Zustandszuordnung und direktem Übergang; Stoffidentität wird aus gelieferten Daten begründet.",
            "understandingFocusEn": "A new substance context with state assignment from observations and a direct transition; substance identity is justified from supplied data."
          }
        ]
      }
    },
    {
      "goalId": "363c5740-8a3c-50b8-8c3a-5548c80c36ea",
      "wholeProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "structure-model-reasoning",
            "essentialUnderstandingDe": "Bei koordinativer Bindungsbildung stellt ein besetztes nichtbindendes Liganden-Donororbital ein freies Elektronenpaar bereit; ein energetisch geeignetes unbesetztes Orbital am Zentralatom oder Zentralion übernimmt im vorgegebenen qualitativen Modell die Akzeptorrolle. Herkunft des Paars und gemeinsame Bindung sind zu unterscheiden.",
            "essentialUnderstandingEn": "In coordinate-bond formation an occupied ligand nonbonding donor orbital supplies a lone pair; an energetically suitable unoccupied orbital at the central atom or ion takes the acceptor role in the supplied qualitative model. Pair origin and shared bond must be distinguished.",
            "observablePerformanceDe": "Die Person identifiziert im vorgegebenen Kupfer(II)-Tartrat-Ausschnitt das Liganden-O, sein besetztes Donororbital und das ausdrücklich dargestellte unbesetzte Zentralion-Akzeptororbital, erläutert deren Wechselwirkung bei Bindungsbildung und die Rolle der Tartratkomplexierung in der Fehling-Lösung. Das Modell behauptet keine vollständige Komplexgeometrie oder leere Gesamtheit der Cu(II)-d-Orbitale.",
            "observablePerformanceEn": "In the supplied copper(II)-tartrate fragment the learner identifies ligand O, its occupied donor orbital and the explicitly represented unoccupied central-ion acceptor orbital, explains their interaction in bond formation and tartrate complexation in Fehling solution. The model claims neither a complete complex geometry nor that all Cu(II) d orbitals are empty."
          },
          {
            "id": "fresh-application-and-boundary",
            "essentialUnderstandingDe": "Ein vereinfachter Bindungsausschnitt beweist keine eindeutige vollständige Komplexformel; Komplexbildung ist nicht identisch mit der späteren Cu(II)-Reduktion zu Cu2O.",
            "essentialUnderstandingEn": "A simplified bond fragment establishes no unique full complex formula; complex formation is not the subsequent Cu(II) reduction to Cu2O.",
            "observablePerformanceDe": "A liefert im vorgegebenen Modell die benötigte Paarquelle, B nicht. Die Pfeildarstellung einer koordinativen Bindung beschreibt Paarherkunft, nicht automatisch Änderung der Oxidationsstufe. Die spätere Fehling-Redoxreaktion erzeugt Cu(I) in Cu2O; der Ausschnitt allein legt Anzahl/Anordnung aller Liganden nicht fest. HE Q1.2 nennt koordinative Bindung im erhöhten Niveau. Das Profil behauptet keine GK-Pflicht oder empirisch geprüfte vollständige Komplexstruktur.",
            "observablePerformanceEn": "A supplies the required pair in the specified model, B does not. A coordinate-bond arrow describes pair origin, not an automatic change in oxidation state. Later Fehling redox produces Cu(I) in Cu2O; the fragment alone does not determine every ligand number or arrangement. HE Q1.2 lists coordinate bonding at advanced level. The profile claims neither a GK obligation nor an empirically verified full complex structure."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "structure-model-reasoning",
            "fresh-application-and-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "material-variation",
            "textDe": "Ligand mit/ohne verfügbares Elektronenpaar, Koordination versus Redoxnachweis, fragmentarisches Modell versus ganze Komplexstöchiometrie.",
            "textEn": "Ligand with/without an available lone pair, coordination versus redox test, fragmentary model versus full complex stoichiometry."
          },
          {
            "id": "counterexample",
            "textDe": "Ein vereinfachter Bindungsausschnitt beweist keine eindeutige vollständige Komplexformel; Komplexbildung ist nicht identisch mit der späteren Cu(II)-Reduktion zu Cu2O.",
            "textEn": "A simplified bond fragment establishes no unique full complex formula; complex formation is not the subsequent Cu(II) reduction to Cu2O."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-current15-363c5740-case-1",
            "taskDemandDe": "Ein ausdrücklich vereinfachter Ausschnitt zeigt Cu2+ neben einem O-Donoratom des Tartratliganden mit freiem Elektronenpaar. Es wird keine vollständige Strukturformel eines einzigen Fehling-Komplexes vorgegeben. Im zusätzlich vorgegebenen qualitativen Orbitalmodell ist das nichtbindende Donororbital am Liganden-O mit einem Elektronenpaar besetzt; am Zentralion wird ein energetisch geeignetes unbesetztes Akzeptororbital schematisch dargestellt. Das Modell behauptet weder, dass alle Cu(II)-d-Orbitale leer sind, noch eine bestimmte vollständige Komplexgeometrie. Zeichne den Elektronenpaarbeitrag zur Bindung und erläutere die Donator-/Akzeptorrolle und den Zweck der Tartratkomplexierung. Ordne dabei das besetzte Liganden-Donororbital und das unbesetzte Zentralion-Akzeptororbital ausdrücklich zu und erkläre, warum beide für das Modell der Bindungsbildung benötigt werden.",
            "taskDemandEn": "An explicitly simplified fragment shows Cu2+ beside a tartrate-ligand O donor with a lone pair. No full structural formula of a unique Fehling complex is supplied. In the additionally supplied qualitative orbital model, the ligand-O nonbonding donor orbital contains an electron pair; an energetically suitable unoccupied acceptor orbital is represented schematically at the central ion. The model claims neither that all Cu(II) d orbitals are empty nor a particular complete complex geometry. Draw the electron-pair contribution to the bond, explain donor/acceptor roles and the purpose of tartrate complexation. Explicitly identify the occupied ligand donor orbital and unoccupied central-ion acceptor orbital and explain why both are needed in the bond-formation model.",
            "expectedPerformanceDe": "Das O-Paar wird zum akzeptierenden Cu(II)-Zentralion gerichtet; der Ligand ist Elektronenpaardonator. Die Tartratkomplexierung hält Kupfer(II) in der alkalischen Fehling-Lösung löslich und vermeidet die einfache Fällung als Cu(OH)2. Dieser Schritt allein reduziert Cu(II) nicht zu Cu(I). Im vorgegebenen Modell ist das besetzte nichtbindende Ligandenorbital die Paarquelle, das unbesetzte passende Zentralionorbital der Akzeptor; ihre Wechselwirkung erklärt die Ausbildung der gemeinsamen Bindung. Aus dem schematischen Akzeptororbital folgt keine Aussage, dass sämtliche Metall-d-Orbitale leer seien.",
            "expectedPerformanceEn": "The O pair is directed towards accepting central Cu(II); the ligand is electron-pair donor. Tartrate complexation keeps Cu(II) soluble in alkaline Fehling solution, avoiding simple Cu(OH)2 precipitation. This step alone does not reduce Cu(II) to Cu(I). In the supplied model the occupied ligand nonbonding orbital is the pair source and the suitable unoccupied central-ion orbital the acceptor; their interaction explains formation of the shared bond. The schematic acceptor orbital does not imply that all metal d orbitals are empty.",
            "understandingFocusDe": "Nicht behaupten, dass zwei Elektronen aus dem Liganden als freie Ladung auf das Zentralion übertragen werden; Koordination wird als Bindungsmodell erläutert.",
            "understandingFocusEn": "Do not claim that two ligand electrons are transferred as free charge onto the central ion; coordination is explained as a bond model."
          },
          {
            "id": "chem-current15-363c5740-case-2",
            "taskDemandDe": "Frischer Modellvergleich: Ausschnitt A enthält einen Liganden mit verfügbarem O-Elektronenpaar; Ausschnitt B zeigt nur eine gesättigte C-H-Gruppe ohne angegebenes verfügbares Donorpaar. Ein Text setzt den Koordinationspfeil mit Cu2+ → Cu+ gleich. Beurteile beide Donorangebote und korrigiere die Gleichsetzung mit der Redoxreaktion. Nenne die Grenze des Fragmentmodells.",
            "taskDemandEn": "Fresh model comparison: fragment A has a ligand with an available O lone pair; fragment B shows only a saturated C-H group without an available donor pair. A text equates the coordination arrow with Cu2+ → Cu+. Assess both donor proposals and correct the identification with a redox reaction. State the fragment model limitation.",
            "expectedPerformanceDe": "A liefert im vorgegebenen Modell die benötigte Paarquelle, B nicht. Die Pfeildarstellung einer koordinativen Bindung beschreibt Paarherkunft, nicht automatisch Änderung der Oxidationsstufe. Die spätere Fehling-Redoxreaktion erzeugt Cu(I) in Cu2O; der Ausschnitt allein legt Anzahl/Anordnung aller Liganden nicht fest.",
            "expectedPerformanceEn": "A supplies the required pair in the specified model, B does not. A coordinate-bond arrow describes pair origin, not an automatic change in oxidation state. Later Fehling redox produces Cu(I) in Cu2O; the fragment alone does not determine every ligand number or arrangement.",
            "understandingFocusDe": "HE Q1.2 nennt koordinative Bindung im erhöhten Niveau. Das Profil behauptet keine GK-Pflicht oder empirisch geprüfte vollständige Komplexstruktur.",
            "understandingFocusEn": "HE Q1.2 lists coordinate bonding at advanced level. The profile claims neither a GK obligation nor an empirically verified full complex structure."
          }
        ]
      }
    },
    {
      "goalId": "416dfd33-8b43-5c49-903c-9847b95e4208",
      "wholeProfile": {
        "archetype": "experiment",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Masse und Volumen brauchen passende Geräte und eindeutige Einheiten.",
            "essentialUnderstandingEn": "Mass and volume need suitable apparatus and explicit units.",
            "observablePerformanceDe": "Tara und Einwaage tatsächlich korrekt vorführen; notierte Masse mit Einheit statt abgeschriebener Sollmenge. Geeignete Geräte bereitstellen, beschriften und Messbereich passend wählen.",
            "observablePerformanceEn": "Actually demonstrate taring and weighing; record mass with units rather than copying the target. Prepare and label suitable apparatus and choose an appropriate range."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Sachgerechtes Übertragen und Trennen ist eine beobachtbare Handlung.",
            "essentialUnderstandingEn": "Appropriate transfer and separation are observable actions.",
            "observablePerformanceDe": "Volumen auf Augenhöhe ablesen und Filter passend einsetzen; kein Überlaufen oder Vermischen beschrifteter Gefäße. Absetzen, langsames Abgießen und Saugballpipette tatsächlich sachgerecht zeigen.",
            "observablePerformanceEn": "Read at eye level and fit the filter; avoid overflow or mixing labelled vessels. Actually demonstrate settling, slow decanting and bulb pipetting."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "Ein Originalprotokoll trennt eigene Beobachtungen von fremden Lehrdaten.",
            "essentialUnderstandingEn": "An original record distinguishes own observations from external practice data.",
            "observablePerformanceDe": "Eigenes Protokoll enthält Reihenfolge und rohe Beobachtungen; Lehrdaten sind als fremde Übungsdaten markiert. Übertragenes Volumen und Rest mit Einheit sowie Verluste unmittelbar dokumentieren.",
            "observablePerformanceEn": "Own record contains sequence and raw observations; practice data are marked as external. Immediately record transferred and residual volumes with units and losses."
          },
          {
            "id": "e4",
            "essentialUnderstandingDe": "Klarheit, Stoffreinheit und Rückgewinnung sind verschiedene Aussagen.",
            "essentialUnderstandingEn": "Clarity, purity and recovery are different claims.",
            "observablePerformanceDe": "Klarheit von Stoffreinheit unterscheiden und erklären, weshalb Salz durch den Filter gelangt. Begründen, warum fehlende vollständige Rückgewinnung und ungenaue Tropfenzahl keine sichere Messfehlerdiagnose erlauben.",
            "observablePerformanceEn": "Distinguish clarity from purity and explain why salt passes through paper. Explain why incomplete recovery and an imprecise drop count do not uniquely diagnose a reading error."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",
            "e2",
            "e3",
            "e4"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "chemically-meaningful-change",
            "textDe": "Ein neuer Ansatz enthält statt Sand löslichen Zucker. Wähle selbst, ob Filtration noch einen Rückstand liefern sollte, und führe einen entsprechend begründeten Kontrollansatz aus. Erhalte frisch ein Gemisch mit fein verteiltem Sand, das nach 2 min noch trüb ist. Entscheide ohne Methodenvorgabe, wie du klares Wasser gewinnst, und demonstriere die angepasste Handhabung.",
            "textEn": "A fresh batch contains soluble sugar instead of sand. Independently decide whether filtration should retain a solid and carry out a justified control. Receive a fresh mixture of fine sand still cloudy after two minutes. Without a method cue, choose how to obtain clear liquid and demonstrate the adapted handling."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "lab15-01-a",
            "taskDemandDe": "Vollständige eigene Materialien, Protokoll und Daten: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-laboratory-communication-fifteen-current419-whole-author-20261015-v1/materials/thirty-complete-DE-EN-cases.author.json #lab15-01-a. Führe den Ansatz aus und protokolliere deine tatsächlich verwendeten Mengen und Arbeitsschritte. Ordne die Lehrdaten getrennt als Vergleich ein. Erkläre, warum klares Filtrat nicht automatisch reines Wasser ist. Demonstriere anschließend eine eigene korrekte Volumenablesung, ohne die Zahl eines anderen abzuschreiben.",
            "taskDemandEn": "Complete original materials, protocol and data: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-laboratory-communication-fifteen-current419-whole-author-20261015-v1/materials/thirty-complete-DE-EN-cases.author.json #lab15-01-a. Carry out the batch and record your actual quantities and actions. Mark supplied practice data separately for comparison. Explain why clear filtrate need not be pure water. Then demonstrate an independent correct volume reading without copying another person’s value.",
            "expectedPerformanceDe": "Die Waage misst Masse; der Zylinder das Flüssigkeitsvolumen. Der unten liegende Meniskus wird bei Wasser auf Augenhöhe gelesen. Sand bleibt wegen seiner Teilchengröße im Filter, gelöstes Salz passiert mit Wasser. Trübung und Klarheit sind Beobachtungen; gelöstes Salz ist eine begründete Deutung. Nasse Rückstandsmasse wäre keine trockene Sandmasse. Tatsächliche Geschicklichkeit und Dokumentation bleiben bis zur Ausführung unbeobachtet.",
            "expectedPerformanceEn": "The balance measures mass; the cylinder measures liquid volume. Read the bottom of a water meniscus at eye level. Sand is retained by particle size, while dissolved salt passes with water. Cloudiness and clarity are observations; dissolved salt is an inference. Wet residue mass is not dry sand mass. Actual handling and documentation remain unobserved until performance.",
            "understandingFocusDe": "Gebundenes Fallmaterial sha256:237164761cab4389b6d3de236f3193c7708b5db0116db47cb660cf08feea7c5d. Ein neuer Ansatz enthält statt Sand löslichen Zucker. Wähle selbst, ob Filtration noch einen Rückstand liefern sollte, und führe einen entsprechend begründeten Kontrollansatz aus.",
            "understandingFocusEn": "Bound case material sha256:237164761cab4389b6d3de236f3193c7708b5db0116db47cb660cf08feea7c5d. A fresh batch contains soluble sugar instead of sand. Independently decide whether filtration should retain a solid and carry out a justified control."
          },
          {
            "id": "lab15-01-b",
            "taskDemandDe": "Vollständige eigene Materialien, Protokoll und Daten: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-laboratory-communication-fifteen-current419-whole-author-20261015-v1/materials/thirty-complete-DE-EN-cases.author.json #lab15-01-b. Zeige Dekantieren und dosiertes Pipettieren selbst. Notiere die tatsächlich übertragenen Volumina, unerwünschte Körner und Restflüssigkeit. Begründe die Wahl gegenüber sofortigem kräftigem Ausgießen. Kannst du aus zurückbleibender Flüssigkeit auf falsche Volumenablesung schließen?",
            "taskDemandEn": "Complete original materials, protocol and data: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-laboratory-communication-fifteen-current419-whole-author-20261015-v1/materials/thirty-complete-DE-EN-cases.author.json #lab15-01-b. Demonstrate decanting and controlled pipetting yourself. Record actual transferred volumes, unwanted grains and residual liquid. Justify the choice over immediate vigorous pouring. Does residual liquid prove an incorrect volume reading?",
            "expectedPerformanceDe": "Absetzen ermöglicht die Trennung eines Überstands von großen dichten Körnern; Flüssigkeitsreste sind beabsichtigt und beschränken Rückgewinnung. Eine Tropfpipette dosiert, ist aber kein kalibriertes Präzisionsmessgerät. Restflüssigkeit allein beweist keinen Ablesefehler; Benetzung, bewusster Rest und Verschütten sind verschieden. Eigenes Protokoll muss reale Abweichungen enthalten.",
            "expectedPerformanceEn": "Settling allows supernatant to be separated from large dense grains; leaving liquid is intentional and limits recovery. A dropper dispenses but is not a calibrated precision measuring device. Residual liquid alone does not prove a reading error; wetting, a deliberate remainder and spillage differ. The original record must retain actual deviations.",
            "understandingFocusDe": "Gebundenes Fallmaterial sha256:237164761cab4389b6d3de236f3193c7708b5db0116db47cb660cf08feea7c5d. Erhalte frisch ein Gemisch mit fein verteiltem Sand, das nach 2 min noch trüb ist. Entscheide ohne Methodenvorgabe, wie du klares Wasser gewinnst, und demonstriere die angepasste Handhabung.",
            "understandingFocusEn": "Bound case material sha256:237164761cab4389b6d3de236f3193c7708b5db0116db47cb660cf08feea7c5d. Receive a fresh mixture of fine sand still cloudy after two minutes. Without a method cue, choose how to obtain clear liquid and demonstrate the adapted handling."
          }
        ]
      }
    },
    {
      "goalId": "4285d84a-2c9a-4d51-8250-8bed4daf2d2e",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "content-specific-understanding",
            "essentialUnderstandingDe": "Ionen tragen durch Elektronenabgabe/-aufnahme elektrische Ladung; in Salzlösungen transportieren bewegliche Kationen und Anionen Ladung, im festen Ionengitter bleiben sie gebunden.",
            "essentialUnderstandingEn": "Ions carry charge after electron loss/gain; mobile cations and anions transport charge in salt solutions, whereas ions remain bound in the solid lattice.",
            "observablePerformanceDe": "Na+ Kation, Cl− Anion; Protonenzahl unverändert. Gelöste Na+ wandern zum negativen, Cl− zum positiven Pol; beide tragen zum Ladungstransport bei. Im festen Gitter fehlt diese freie Ionenbeweglichkeit.",
            "observablePerformanceEn": "Na+ is cation, Cl− anion; proton counts remain unchanged. Dissolved Na+ migrates to the negative and Cl− to the positive pole; both contribute to charge transport. Solid-lattice ions lack this mobility."
          },
          {
            "id": "fresh-transfer-and-model-boundary",
            "essentialUnderstandingDe": "Geringe Leitfähigkeit der konkreten Zuckerlösung beweist nicht, dass jede molekulare Verbindung in Wasser un-ionisiert bleibt; Säuren bilden eine andere Fallgrenze.",
            "essentialUnderstandingEn": "Low conductivity in this sugar case does not establish that every molecular compound stays un-ionised in water; acids are a different case.",
            "observablePerformanceDe": "2+(−1)+(−1)=0. Mg2+ wandert zum negativen, Cl− zum positiven Pol; im Vergleich sind mobile Ladungsträger im Salzfall vorhanden. Zuckermoleküle liefern hier keine solchen Ionen. Beim Salzlösen werden vorhandene Gitterionen hydratisiert, keine Protonen umgewandelt.",
            "observablePerformanceEn": "2+(−1)+(−1)=0. Mg2+ moves towards the negative, Cl− the positive pole; the salt case has mobile carriers. Sugar molecules here do not supply such ions. Dissolution hydrates existing lattice ions rather than transforming protons."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "content-specific-understanding",
            "fresh-transfer-and-model-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "specific-material-variation",
            "textDe": "Na+/Cl− gegenüber Mg2+/Cl−; ionische und nichtionische Lösung, fest und gelöst.",
            "textEn": "Na+/Cl− versus Mg2+/Cl−; ionic versus nonionic solution, solid versus dissolved."
          },
          {
            "id": "specific-model-limit",
            "textDe": "Geringe Leitfähigkeit der konkreten Zuckerlösung beweist nicht, dass jede molekulare Verbindung in Wasser un-ionisiert bleibt; Säuren bilden eine andere Fallgrenze.",
            "textEn": "Low conductivity in this sugar case does not establish that every molecular compound stays un-ionised in water; acids are a different case."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-next25-4285d84a-case-1",
            "taskDemandDe": "Modell:Na verliert1 Elektron, Cl nimmt1 auf. Vorgegebene Beobachtung: festes NaCl geringe Leitfähigkeit, NaCl-Lösung deutlich höhere. Elektrolysezelle: links negativer, rechts positiver Pol. Erkläre Ladungsbildung, benenne die Ionen und zeichne ihre Wanderungsrichtungen im elektrischen Feld.",
            "taskDemandEn": "Model:Na loses1 electron, Cl gains1. Supplied observation: solid NaCl poorly conducts; its solution conducts much better. Electrolysis cell: left negative, right positive pole. Explain charge formation, name the ions and draw migration directions in the electric field.",
            "expectedPerformanceDe": "Na+ Kation, Cl− Anion; Protonenzahl unverändert. Gelöste Na+ wandern zum negativen, Cl− zum positiven Pol; beide tragen zum Ladungstransport bei. Im festen Gitter fehlt diese freie Ionenbeweglichkeit.",
            "expectedPerformanceEn": "Na+ is cation, Cl− anion; proton counts remain unchanged. Dissolved Na+ migrates to the negative and Cl− to the positive pole; both contribute to charge transport. Solid-lattice ions lack this mobility.",
            "understandingFocusDe": "Strom in der Lösung bedeutet nicht, dass freie Elektronen wie in einem Metalldraht durch Wasser laufen.",
            "understandingFocusEn": "Current in solution does not mean free electrons flowing through water as through a metal wire."
          },
          {
            "id": "chem-next25-4285d84a-case-2",
            "taskDemandDe": "Frischer Vergleich:MgCl2-Lösung enthält Mg2+ und2Cl− pro Verhältnisformel. Eine Zuckerlösung enthält hier ungeladene gelöste Moleküle, kein vorgegebenes Ionisationsmodell. Bilanzierte Ladungen, Richtung beider Ionen und einen begründeten Leitfähigkeitsvergleich angeben. Trenne Lösen eines Salzes von Bildung neuer Atom-Ionen aus Elementen.",
            "taskDemandEn": "Fresh comparison:MgCl2 solution contains Mg2+ and2Cl− per formula unit. The sugar solution here has uncharged dissolved molecules and no supplied ionisation model. Give balanced charges, directions of both ions and a justified conductivity comparison. Distinguish dissolving a salt from forming new atomic ions from elements.",
            "expectedPerformanceDe": "2+(−1)+(−1)=0. Mg2+ wandert zum negativen, Cl− zum positiven Pol; im Vergleich sind mobile Ladungsträger im Salzfall vorhanden. Zuckermoleküle liefern hier keine solchen Ionen. Beim Salzlösen werden vorhandene Gitterionen hydratisiert, keine Protonen umgewandelt.",
            "expectedPerformanceEn": "2+(−1)+(−1)=0. Mg2+ moves towards the negative, Cl− the positive pole; the salt case has mobile carriers. Sugar molecules here do not supply such ions. Dissolution hydrates existing lattice ions rather than transforming protons.",
            "understandingFocusDe": "Geringe Leitfähigkeit der konkreten Zuckerlösung beweist nicht, dass jede molekulare Verbindung in Wasser un-ionisiert bleibt; Säuren bilden eine andere Fallgrenze.",
            "understandingFocusEn": "Low conductivity in this sugar case does not establish that every molecular compound stays un-ionised in water; acids are a different case."
          }
        ]
      }
    },
    {
      "goalId": "448815cc-4127-54b7-96bf-e54b3d2a38c5",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "structure-model-reasoning",
            "essentialUnderstandingDe": "Metallbindung, Ionenbindung und Elektronenpaarbindung unterscheiden sich in Teilchen, Ladungen und Elektronenorganisation; Bindungsmodelle erklären ausgewählte Eigenschaften.",
            "essentialUnderstandingEn": "Metallic, ionic and covalent bonding differ in particles, charges and electron organization; bonding models explain selected properties.",
            "observablePerformanceDe": "Die Person erklärt die Modellbilder für Cu, NaCl und Cl2 und begründet Beweglichkeit von Ladungsträgern statt nur Stoffnamen zuzuordnen.",
            "observablePerformanceEn": "The learner explains model diagrams for Cu, NaCl and Cl2 and reasons about mobile charge carriers instead of merely assigning substance names."
          },
          {
            "id": "fresh-application-and-boundary",
            "essentialUnderstandingDe": "Ein Stoff mit Metallatom ist nicht automatisch ein Metall; Ionen im Feststoff sind nicht automatisch frei beweglich.",
            "essentialUnderstandingEn": "A substance containing a metal atom is not automatically a metal; solid-state ions are not automatically freely mobile.",
            "observablePerformanceDe": "In der Schmelze sind Na+ und Cl− beweglich. CuCl2 hat Ionen und nicht das Modell des elementaren Metalls mit delokalisiertem Elektronengas. O-H in H2O ist eine kovalente Bindung; Wasserstoffbrücken beziehen sich hier auf Wechselwirkungen zwischen Molekülen. Ionenbindung und kovalente Bindung sind Modelle mit Übergängen; aus dem Namen allein wird keine exakte Bindungsenergie abgeleitet.",
            "observablePerformanceEn": "Na+ and Cl− are mobile in the melt. CuCl2 contains ions rather than the elemental metallic electron-gas model. O-H in H2O is a covalent bond; hydrogen bonding here refers to interactions between molecules. Ionic and covalent bonding are models with transitions; names alone establish no exact bond energy."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "structure-model-reasoning",
            "fresh-application-and-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "material-variation",
            "textDe": "Metall versus Metallverbindung; ionischer Feststoff versus Schmelze; intramolekulare versus intermolekulare Wechselwirkung.",
            "textEn": "Metal versus metal compound; ionic solid versus melt; intra- versus intermolecular interaction."
          },
          {
            "id": "counterexample",
            "textDe": "Ein Stoff mit Metallatom ist nicht automatisch ein Metall; Ionen im Feststoff sind nicht automatisch frei beweglich.",
            "textEn": "A substance containing a metal atom is not automatically a metal; solid-state ions are not automatically freely mobile."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-current15-448815cc-case-1",
            "taskDemandDe": "Modelle: Kupfer mit positiven Atomrümpfen/delokalisierten Elektronen; festes NaCl mit Na+/Cl−-Gitter; Cl2 mit gemeinsamem Bindungselektronenpaar. Erkläre die drei Bindungsarten und leite den Unterschied in der Ladungsträgerbeweglichkeit von Cu und festem NaCl her.",
            "taskDemandEn": "Models: copper with positive cores/delocalized electrons; solid NaCl with a Na+/Cl− lattice; Cl2 with a shared bonding electron pair. Explain the three bond types and derive the difference in mobile charge carriers between Cu and solid NaCl.",
            "expectedPerformanceDe": "Cu besitzt bewegliche delokalisierte Elektronen. NaCl wird durch elektrostatische Gitterwechselwirkungen gebunden, seine Ionen sind im festen Gitter ortsgebunden. Cl2 hat eine kovalente Bindung zwischen zwei Atomen; Anziehung zwischen Cl2-Molekülen ist davon verschieden.",
            "expectedPerformanceEn": "Cu has mobile delocalized electrons. NaCl is bound by electrostatic lattice interactions and its solid-state ions are position-bound. Cl2 has a covalent bond between two atoms; attraction between Cl2 molecules is different.",
            "understandingFocusDe": "NaCl wird nicht als Ansammlung einzelner NaCl-Moleküle beschrieben.",
            "understandingFocusEn": "NaCl is not described as an assembly of discrete NaCl molecules."
          },
          {
            "id": "chem-current15-448815cc-case-2",
            "taskDemandDe": "Frischer Fall: NaCl schmilzt; CuCl2 enthält Kupfer, liegt aber als ionischer Feststoff vor. Wasser enthält neutrale H2O-Moleküle. Übertrage die Modelle: Welche Ladungsträger bewegen sich in der NaCl-Schmelze? Warum ist CuCl2 kein Kupfermetall und die O-H-Bindung keine Wasserstoffbrücke?",
            "taskDemandEn": "Fresh case: NaCl melts; CuCl2 contains copper but is an ionic solid. Water contains neutral H2O molecules. Transfer the models: which carriers move in molten NaCl? Why is CuCl2 not copper metal, and why is the O-H bond not a hydrogen bond?",
            "expectedPerformanceDe": "In der Schmelze sind Na+ und Cl− beweglich. CuCl2 hat Ionen und nicht das Modell des elementaren Metalls mit delokalisiertem Elektronengas. O-H in H2O ist eine kovalente Bindung; Wasserstoffbrücken beziehen sich hier auf Wechselwirkungen zwischen Molekülen.",
            "expectedPerformanceEn": "Na+ and Cl− are mobile in the melt. CuCl2 contains ions rather than the elemental metallic electron-gas model. O-H in H2O is a covalent bond; hydrogen bonding here refers to interactions between molecules.",
            "understandingFocusDe": "Ionenbindung und kovalente Bindung sind Modelle mit Übergängen; aus dem Namen allein wird keine exakte Bindungsenergie abgeleitet.",
            "understandingFocusEn": "Ionic and covalent bonding are models with transitions; names alone establish no exact bond energy."
          }
        ]
      }
    },
    {
      "goalId": "4aa3a130-b517-5ac5-87b2-147fe432cadd",
      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "adequacy-for-question",
            "essentialUnderstandingDe": "Daten sind nur für eine Fragestellung angemessen, wenn Messprinzip, Probenbedingungen und benötigte Unterscheidung zusammenpassen.",
            "essentialUnderstandingEn": "Data are adequate for a question only when measurement principle, sample conditions and required distinction fit together.",
            "observablePerformanceDe": "Prüft am Farbtest Selektivität/Blank und am Leitfähigkeitsvergleich Temperatur, Ionensorte und Kontrollprobe; trennt Messantwort von Stoffidentifikation.",
            "observablePerformanceEn": "Checks selectivity/blank for the colour test and temperature, ion type and control for the conductivity comparison; separates measurement response from substance identification."
          },
          {
            "id": "bounded-conclusion",
            "essentialUnderstandingDe": "Eine positive Antwort eines kreuzreaktiven Tests beweist keinen eindeutigen Stoff; ein unkontrollierter Temperaturunterschied beweist keine Konzentrationsdifferenz.",
            "essentialUnderstandingEn": "A positive cross-reactive test does not prove a unique substance; an uncontrolled temperature difference does not prove a concentration difference.",
            "observablePerformanceDe": "Begründet unterstützte und nicht unterstützte Aussagen mit X/Y/Blank bzw. A20/A35/B35 und begrenzt die ±3-Streuung auf das gegebene Modell.",
            "observablePerformanceEn": "Justifies supported and unsupported claims using X/Y/blank or A20/A35/B35 and confines ±3 scatter to the supplied model."
          },
          {
            "id": "fresh-validity-check",
            "essentialUnderstandingDe": "Ein ausgeschlossener Störstoff beseitigt nicht alle Unsicherheit; eine neue ungeladene Matrixkomponente kann Ionenbeweglichkeit verändern.",
            "essentialUnderstandingEn": "Excluding one interferent does not remove all uncertainty; a new uncharged matrix component may change ion mobility.",
            "observablePerformanceDe": "Nennt nach Y-Ausschluss weitere relevante Testgrenzen und entwickelt bei Saccharosezugabe einen temperatur- und matrixgleichen Kontroll-/Kalibriervergleich.",
            "observablePerformanceEn": "Names further relevant test limits after excluding Y and develops a temperature- and matrix-matched control/calibration comparison for added sucrose."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "adequacy-for-question",
            "bounded-conclusion",
            "fresh-validity-check"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "interferent-exclusion",
            "textDe": "Ein bekannter Kreuzreaktant entfällt; andere Interferenzen und Nachweisgrenze bleiben zu prüfen.",
            "textEn": "One known cross-reactant is removed; other interferences and detection limit still need checking."
          },
          {
            "id": "matrix-change",
            "textDe": "Temperaturkontrolle wird um Saccharose-/Viskositäts- und Matrixkontrolle erweitert.",
            "textEn": "Temperature control is extended by sucrose/viscosity and matrix control."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "data-validity-test-not-proof",
            "taskDemandDe": "Beurteile Gültigkeit, geeignete Quellen, Blind-/Positivkontrollen und Tragweite von „U enthält X“. Benenne einen Verfahrensfehler und eine geeignete Folgemethode.\nFrische Variation: Wenn Y ausgeschlossen wird, erkläre, welche weiteren Informationen vor einem eindeutigen Nachweis noch fehlen können.",
            "taskDemandEn": "Assess validity, suitable sources, blank/positive controls and the scope of “U contains X”. Identify a procedure error and a suitable follow-up method.\nFresh variation: If Y is excluded, explain what further information may still be missing before unique proof.",
            "expectedPerformanceDe": "Die Blank-/Positivkontrolle zeigt grundsätzliches Testansprechen; Y macht den Test nicht spezifisch. U-Farbe ist ein Hinweis auf eine reagierende Komponente, kein eindeutiger X-Nachweis. S ist für Spezifität relevanter als das verkürzte Etikett H; unbekannte Verdünnung/Erhitzung kann Signal verändern. Eine unabhängig spezifischere Analyse mit dokumentierten Bedingungen ist nötig. Blindproben korrigieren keinen grundsätzlich unspezifischen Reaktionsmechanismus. Weil X/Y hier keine Stoffidentitäten oder Trennmerkmale haben, darf kein benanntes Gerät ungeprüft als X-spezifisch gelten. Akzeptabel ist eine konkrete kontrollierte Wiederholung mit dokumentierter Verdünnung/Temperatur und eine begründete Planung zur Validierung einer ergänzenden Methode an bekannten X-, Y- und Blindproben. Für einen eindeutigen X-Nachweis muss deren Spezifität erst belegt werden; Wiederholung des unspezifischen Tests allein identifiziert X weiterhin nicht.\nFrischer Transfer: Der Ausschluss von Y beseitigt nur den bekannten Kreuzreaktanten Y. Weitere unbekannte Stoffe, Matrix-/pH-/Temperaturbedingungen, Nachweisgrenze, Empfindlichkeit und Störreaktionen bleiben mögliche Grenzen. Eine positive Antwort ist nur bei dokumentiert validierter Selektivität und passenden Probenbedingungen eine starke Stütze für X. Weitere bekannte X-/Nicht-X-Proben, Blank, geeignete Matrixkontrollen und eine für X validierte unabhängige Methode würden die Aussage verstärken. Eine beliebig genannte zweite Apparatur garantiert noch keine Selektivität. Erhitzen oder Verdünnen kann die tatsächliche Probe verändern; ursprüngliche Probenbedingungen erhalten und kenntlich machen. Kein absoluter Nachweis aller unbekannten Möglichkeiten folgt aus Y-Ausschluss.",
            "expectedPerformanceEn": "Blank/positive controls show that the test responds in principle; Y makes it non-specific. U colour indicates a reacting component, not unique proof of X. S is more relevant to specificity than the shortened label H; unknown dilution/heating may alter the signal. An independent more specific analysis under documented conditions is needed. Blanks do not correct an inherently non-specific reaction mechanism. Because X/Y have no identities or discriminating properties here, no named instrument may be presumed X-specific. Accept a concrete controlled repeat with documented dilution/temperature and a justified plan to validate an additional method against known X, Y and blank samples. Its specificity must first be established for unique proof of X; repeating the non-specific test alone still does not identify X.\nFresh transfer: Excluding Y removes only the known cross-reactant Y. Other unknown substances, matrix/pH/temperature conditions, detection limit, sensitivity and interfering reactions remain possible limits. A positive response strongly supports X only with documented validated selectivity and appropriate sample conditions. Further known X/non-X samples, blank, suitable matrix controls and an independent method validated for X would strengthen the claim. Simply naming a second instrument does not guarantee selectivity. Heating or dilution may change the actual sample; retain and label original sample conditions. Excluding Y does not exclude every unknown possibility absolutely.",
            "understandingFocusDe": "Neue Selektivitätsinformation begrenzt den Nachweisanspruch konkret statt ihn absolut zu machen.",
            "understandingFocusEn": "New selectivity information bounds the identification claim concretely rather than making it absolute."
          },
          {
            "id": "data-validity-temperature-confound",
            "taskDemandDe": "Prüfe, welche Folgerung durch Daten getragen wird, welche Störgröße vorliegt und wie ein gültiger Stoffmengenvergleich verbessert werden kann.\nFrische Variation: Plane den Vergleich, wenn Probe B zusätzlich Saccharose enthält; erläutere die Grenze reiner Leitfähigkeitsdaten.",
            "taskDemandEn": "Assess which conclusion the data support, the confounder present and how to improve a valid amount comparison.\nFresh variation: Plan the comparison if B additionally contains sucrose; explain the limit of conductivity-only data.",
            "expectedPerformanceDe": "Die 500-µS/cm-Differenz ist mit Temperatur gekoppelt; Kontrolle A35 liegt innerhalb grober Streuung bei B35. Daten belegen kein Mehr an Salz in B. Gleiche Temperatur, Standards, Wiederholungen und bekannte Kompensation/gleiches Ionensystem sind nötig. Streuungsangabe ist nicht die vollständige Messunsicherheit; selbst temperaturgleiche Leitfähigkeit wäre bei unbekannten Ionensorten keine eindeutige NaCl-Konzentration.\nFrischer Transfer: Saccharose liefert im beschriebenen Modell keine zusätzlichen dissoziierten Ionen, kann aber Lösungsmatrix und Viskosität und damit die Beweglichkeit vorhandener Ionen verändern. Aus κ lässt sich deshalb weder Saccharosemenge noch gesamter gelöster Stoff direkt bestimmen. Bei gleicher Temperatur NaCl-Kontrollen mit/ohne gleiche Saccharosematrix, geeignete Blanks und eine für diese Matrix validierte Konzentrationskalibrierung vergleichen. Die bereits vorgegebenen A35/B35-Werte enthalten keine neue Saccharosemessung. Eine Behauptung höherer NaCl-Konzentration wäre nur innerhalb geprüfter Ionensorte, Temperatur und Matrix zulässig; die ±3-Wiederholstreuung ersetzt keine Gesamtunsicherheit.",
            "expectedPerformanceEn": "The 500-µS/cm difference is confounded by temperature; A35 control lies within rough scatter of B35. Data do not establish more salt in B. Equal temperature, standards, repeats and known compensation/the same ion system are needed. The scatter estimate is not full measurement uncertainty; even equal-temperature conductivity would not uniquely determine NaCl concentration for unknown ion species.\nFresh transfer: Sucrose supplies no additional dissociated ions in the described model but may change solution matrix and viscosity and therefore mobility of existing ions. κ therefore does not directly determine sucrose amount or total dissolved material. At equal temperature compare NaCl controls with/without the same sucrose matrix, suitable blanks and concentration calibration validated for this matrix. The existing A35/B35 values contain no new sucrose measurement. A claim of higher NaCl concentration would be valid only within checked ion type, temperature and matrix; ±3 repeat scatter is not total uncertainty.",
            "understandingFocusDe": "Temperaturkontrolle allein löst bei neuer Matrix nicht alle Konzentrations-Gültigkeitsfragen.",
            "understandingFocusEn": "Temperature control alone does not resolve every concentration-validity question in a new matrix."
          }
        ]
      }
    },
    {
      "goalId": "5851b53a-162b-5c17-9269-510ee54ad846",
      "wholeProfile": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "b002-5851b53a-core",
            "essentialUnderstandingDe": "Die lokale Klasse des Alkanols bestimmt das erste Carbonylprodukt: primär zu Aldehyd, sekundär zu Keton; ein primäres Aldehyd kann weiter zur Carbonsäure oxidieren.",
            "essentialUnderstandingEn": "The local alkanol class determines the first carbonyl product: primary to aldehyde, secondary to ketone; a primary-derived aldehyde may oxidize further to a carboxylic acid.",
            "observablePerformanceDe": "Die lernende Person zeichnet zu gegebenen Alkanolstrukturen passende Produkte und erklärt mit Änderungen am OH-tragenden C, weshalb die Produkte verschieden sind.",
            "observablePerformanceEn": "The learner draws suitable products for given alkanol structures and explains via changes at the OH-bearing carbon why the products differ."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b002-5851b53a-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "oxidation-depth",
            "textDe": "Primäres Alkanol mit begrenzter und weitergehender Oxidation.",
            "textEn": "A primary alkanol under limited and further oxidation."
          },
          {
            "id": "alkanol-class",
            "textDe": "Sekundäres Alkanol als neuer Vergleich ohne Carbonsäureprodukt.",
            "textEn": "A secondary alkanol as fresh comparison without a carboxylic-acid product."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "ethanol-product-sequence",
            "taskDemandDe": "Vorgegebene Strukturdaten zeigen Ethanol unter begrenzter und weitergehender Oxidation. Zeichne die zwei aufeinanderfolgenden organischen Produkte und erläutere die Strukturänderung.",
            "taskDemandEn": "Supplied structure data show ethanol under limited and further oxidation. Draw the two consecutive organic products and explain structural change.",
            "expectedPerformanceDe": "Die lernende Person zeichnet Ethanal und danach Ethansäure, unterscheidet Aldehyd- und Carboxylgruppe und behauptet nicht, beide entstünden stets zugleich.",
            "expectedPerformanceEn": "The learner draws ethanal then ethanoic acid, distinguishes aldehyde and carboxyl groups, and does not claim both always arise together.",
            "understandingFocusDe": "Reaktionsbedingungen steuern die Tiefe, die Ausgangsstruktur begrenzt Produkte.",
            "understandingFocusEn": "Conditions control oxidation extent while starting structure constrains products."
          },
          {
            "id": "fresh-secondary-product",
            "taskDemandDe": "Ein frischer Fall oxidiert Propan-2-ol unter geeigneten milden Bedingungen. Welches organische Produkt ist plausibel und warum entsteht daraus nicht analog eine Carbonsäure mit demselben C-Gerüst?",
            "taskDemandEn": "A fresh case oxidizes propan-2-ol under suitable mild conditions. Which organic product is plausible, and why does an analogous carboxylic acid not arise with the same carbon skeleton?",
            "expectedPerformanceDe": "Die lernende Person zeichnet Propanon aus dem sekundären OH-C und erklärt, dass das Keton keine weitere analoge C-H-Oxidation am Carbonyl-C besitzt.",
            "expectedPerformanceEn": "The learner draws propanone from the secondary OH-bearing carbon and explains that the ketone lacks an analogous carbonyl-carbon H for further oxidation.",
            "understandingFocusDe": "Neuer Alkanoltyp prüft Struktur-Produkt-Transfer.",
            "understandingFocusEn": "A new alkanol type tests structure-product transfer."
          }
        ]
      }
    },
    {
      "goalId": "67cd332f-9db7-50e1-87f6-172ef3714300",
      "wholeProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "b006-67cd332f-core",
            "essentialUnderstandingDe": "Bindende und freie Elektronenbereiche um ein Zentralatom ordnen sich im EPA-Modell mit möglichst geringer Abstoßung. Elektronenbereichsgeometrie und sichtbare Atomgestalt sind verschieden; ein freies Paar wird nicht als Atom eingezeichnet.",
            "essentialUnderstandingEn": "Bonding and lone electron domains around a central atom arrange to reduce repulsion in VSEPR. Electron-domain geometry differs from the visible atomic shape; a lone pair is not drawn as an atom.",
            "observablePerformanceDe": "Die lernende Person zählt an gegebenen Lewis-Strukturen Elektronenbereiche und freie Paare, leitet einfache Molekülgestalten ab und nennt Modellgrenzen statt aus exakten Winkeln zu raten.",
            "observablePerformanceEn": "The learner counts electron domains and lone pairs in supplied Lewis structures, derives simple molecular shapes and names limits rather than guessing exact angles."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b006-67cd332f-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "lone-pairs",
            "textDe": "Null, ein und zwei freie Paare am Zentralatom verändern die Atomgestalt.",
            "textEn": "Zero, one and two central-atom lone pairs change molecular shape."
          },
          {
            "id": "domain-number",
            "textDe": "Zwei und vier Elektronenbereiche erzeugen unterschiedliche Grundanordnungen.",
            "textEn": "Two and four electron domains produce different base arrangements."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "water-carbon-dioxide",
            "taskDemandDe": "Gegebene Lewis-Bilder zeigen H–O–H mit zwei freien O-Paaren und O=C=O ohne freie C-Paare. Begründe mit EPA die Molekülgestalten.",
            "taskDemandEn": "Supplied Lewis sketches show H–O–H with two O lone pairs and O=C=O with no C lone pairs. Explain molecular shapes using VSEPR.",
            "expectedPerformanceDe": "H2O hat vier O-Bereiche, aber nur zwei sichtbare Bindungspartner und ist gewinkelt; CO2 hat zwei C-Bereiche und ist linear. Doppelbindungen zählen je als ein Bereich.",
            "expectedPerformanceEn": "H2O has four O domains but only two bonded atoms and is bent; CO2 has two C domains and is linear. Each double bond counts as one domain.",
            "understandingFocusDe": "Lewis→EPA mit zwei verschiedenen Domänenzahlen.",
            "understandingFocusEn": "Lewis-to-VSEPR with two domain counts."
          },
          {
            "id": "ammonia-methane-transfer",
            "taskDemandDe": "Neue gegebene Lewis-Bilder: NH3 hat drei N–H-Bindungen und ein freies N-Paar; CH4 vier C–H-Bindungen ohne freies C-Paar. Vergleiche Atomgestalt, ohne exakte Winkel zu behaupten.",
            "taskDemandEn": "Fresh supplied Lewis sketches: NH3 has three N–H bonds and one N lone pair; CH4 has four C–H bonds and no C lone pair. Compare atomic shape without claiming exact angles.",
            "expectedPerformanceDe": "Beide haben vier Elektronenbereiche; NH3 ist trigonal-pyramidal, CH4 tetraedrisch. Das freie N-Paar ist kein vierter Bindungspartner; die Atomgestalt von NH3 bleibt trigonal-pyramidal.",
            "expectedPerformanceEn": "Both have four electron domains; NH3 is trigonal pyramidal while CH4 is tetrahedral. The N lone pair is not a fourth bonded atom; NH3 molecular shape remains trigonal pyramidal.",
            "understandingFocusDe": "Gleiche Domänenzahl bei verschiedener Molekülgestalt testet freie Paare.",
            "understandingFocusEn": "Same domain count with different molecular shapes tests lone-pair reasoning."
          }
        ]
      }
    },
    {
      "goalId": "72236f2c-771e-4ab6-933a-e549ee49d15b",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "72236f2c-understanding-1",
            "essentialUnderstandingDe": "Überwiegend ungestörte und selten stark abgelenkte positiveα-Teilchen passen zu einem großen weitgehend leeren Volumen und einem kleinen positiv geladenen massereichen Kern.",
            "essentialUnderstandingEn": "Mostly undeflected and rarely strongly deflected positive alpha particles fit a large mostly empty volume and a tiny positive massive nucleus.",
            "observablePerformanceDe": "Streubefund und Kernkonzentration kausal verbinden und vom vollgefüllten Atommodell abgrenzen.",
            "observablePerformanceEn": "Connect scattering and nuclear concentration causally and distinguish a filled atom model."
          },
          {
            "id": "72236f2c-understanding-2",
            "essentialUnderstandingDe": "Protonen und Neutronen liegen im Kern, leichte negative Elektronen in der Hülle. Z bestimmt die Protonenzahl und Elementidentität, A die Nukleonenzahl; Neutralität oder eine ausdrücklich gegebene Ionladung bestimmt zusätzlich die Elektronenzahl.",
            "essentialUnderstandingEn": "Protons and neutrons occupy the nucleus and light negative electrons the shell. Z determines proton count and element identity, A the nucleon count; neutrality or an explicitly given ionic charge additionally determines electron count.",
            "observablePerformanceDe": "Für ein gegebenes neutrales Atom Ort, Ladung, relative Masse und Teilchenzahlen beschreiben und bei einer vorgegebenen Ladungsänderung begründen, welche Hüllen- und Kerneigenschaften unverändert bleiben.",
            "observablePerformanceEn": "Describe constituent locations, charges, relative masses and counts for a given neutral atom and explain which shell and nuclear properties remain unchanged under a stipulated charge change."
          },
          {
            "id": "72236f2c-understanding-3",
            "essentialUnderstandingDe": "Streubefund und schematische Skizze liefern keine genaue Elektronenbahn oder eigenständige Neutronenmessung.",
            "essentialUnderstandingEn": "Scattering and a sketch supply neither a precise electron orbit nor an independent neutron measurement.",
            "observablePerformanceDe": "Einen neuen Isotopen- und Ladungsfall mit unveränderter Elementidentität deuten und separat benennen, welche Aussagen aus Z/A/Ladung und welche aus dem tatsächlichen Streubefund beziehungsweise nur einer Skizze folgen.",
            "observablePerformanceEn": "Interpret a new isotope and charge case with unchanged element identity and distinguish what follows from Z/A/charge, from the scattering finding and from a sketch alone."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "72236f2c-understanding-1",
            "72236f2c-understanding-2",
            "72236f2c-understanding-3"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "neutral-to-positive-or-negative-ion",
            "textDe": "Bei festem Z/A von neutralem Atom zu positivem oder negativem Ion wechseln und Elektronenzahl, Kernzusammensetzung und Gesamtladung begründet trennen; Isotopenänderung als anderen Eingriff vergleichen.",
            "textEn": "With fixed Z/A, change a neutral atom to a positive or negative ion and justify the distinction between electron count, nucleus and total charge; compare an isotope change as a different intervention."
          },
          {
            "id": "model-and-evidence-boundary",
            "textDe": "Stoffidentität, Modellgrenze und fehlende reale Evidenz explizit erhalten.",
            "textEn": "Explicitly preserve substance identity, model limits and absent real evidence."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "rutherford-counts",
            "taskDemandDe": "Eigene vereinfachte Modellzählung von 1 000 000 positiv geladenen α-Teilchen an einer dünnen Metallfolie: 999 000 nahezu ungestört, 950 stärker abgelenkt, 50 um mehr als 90° abgelenkt. Es sind erfundene Unterrichtswerte, keine historischen Messzahlen. α-Teilchen sind positiv; gleiche Ladungen stoßen sich ab. Für ein neutrales ²³Na-Atom sind Ordnungszahl11 und Massenzahl23 gegeben. Ordne die drei Befunde dem Kern-Hülle-Modell zu. Erkläre, warum eine gleichmäßig verteilte positive Ladung die seltenen großen Ablenkungen nicht angemessen erklärt. Beschreibe Ort, Ladung und relative Masse von Proton, Neutron und Elektron und bestimme ihre Anzahl im gegebenen neutralen Atom. Nenne eine Modellgrenze. Frischer unabhängiger Transfer: Ein unabhängiger geänderter Fall enthält ein neutrales ²²Na-Atom (Z=11, A=22) und ein ²³Na⁺-Ion (Z=11, A=23, Gesamtladung +1). Vergleiche beide mit dem neutralen ²³Na-Atom des Hauptfalls. Bestimme für alle drei die Protonen-, Neutronen- und Elektronenzahl. Begründe, weshalb eine Elektronenabgabe die Ladung ändert, aber weder ein anderes Element noch eine andere Neutronenzahl erzeugt. Welche Aussage über die konzentrierte positive Kernladung bleibt bestehen? Kann die genaue Neutronen- oder Elektronenzahl aus der angegebenen Folien-Streuzählung allein abgelesen werden? Es wird kein Vergleich exakter Streuhäufigkeiten verschiedener Ionen verlangt.",
            "taskDemandEn": "Own simplified model count for 1,000,000 positive alpha particles at thin metal foil: 999,000 almost undeflected, 950 more strongly deflected, 50 by more than90°. These are invented teaching values, not historical measurements. Alpha particles are positive and like charges repel. A neutral ²³Na atom has atomic number11 and mass number23. Relate the three findings to the core-shell model. Explain why uniformly distributed positive charge inadequately explains rare large deflections. State location, charge and relative mass of proton, neutron and electron and find their numbers in the neutral atom. Name a model limit. Fresh independent transfer: An independent changed case contains neutral ²²Na (Z=11, A=22) and a ²³Na⁺ ion (Z=11, A=23, total charge +1). Compare both with the neutral ²³Na atom in the main case. Determine proton, neutron and electron counts for all three. Explain why losing an electron changes charge without creating a different element or neutron count. Which statement about concentrated positive nuclear charge remains? Can the exact neutron or electron count be read from the supplied foil-scattering tally alone? No comparison of exact scattering frequencies for different ions is required.",
            "expectedPerformanceDe": "Die überwiegend ungestörten Bahnen passen zu einem überwiegend leeren Atomvolumen. Seltene große Ablenkungen erfordern eine stark konzentrierte positive Ladung und Masse im kleinen Kern, nicht eine massive vollgefüllte Kugel. Protonen:Kern,+1, relative Masse≈1; Neutronen:Kern,0,≈1; Elektronen:Hülle,−1,≈1/1836. ²³Na hat11 p,12 n,11 e. Der Versuch allein misst keine Neutronen und liefert kein vollständiges quantenmechanisches Elektronenmodell. Die Teilchennamen sind schulische Atombausteine; Protonen/Neutronen sind im modernen Sinn nicht elementar. Transfer: Neutrales ²³Na: 11 p, 12 n, 11 e; neutrales ²²Na: 11 p, 11 n, 11 e; ²³Na⁺: 11 p, 12 n, 10 e. Die Gesamtladung ergibt sich in Einheiten der Elementarladung aus p−e. Der Isotopenwechsel ändert die Neutronenzahl; Elektronenabgabe ändert die Hülle und Gesamtladung. Z=11 und damit Elementidentität und positive Kernladung bleiben gleich. Der gegebene qualitative Streubefund stützt einen kleinen konzentriert positiven Kern, bestimmt aber nicht allein die konkreten Neutronen- oder Elektronenzahlen der einzeln vorgegebenen Atome/Ionen. Diese folgen hier aus den separat gegebenen Z-, A- und Ladungsangaben.",
            "expectedPerformanceEn": "Mostly undeflected trajectories fit an atomic volume that is mostly empty. Rare large deflections require positive charge and mass concentrated in a tiny nucleus, not a solid filled sphere. Protons:nucleus,+1, relative mass≈1; neutrons:nucleus,0,≈1; electrons:shell,−1,≈1/1836. ²³Na has11 p,12 n,11 e. The experiment alone does not measure neutrons or supply a complete quantum electron model. These are school-level atomic constituents; protons/neutrons are not elementary in the modern sense. Transfer: Neutral ²³Na: 11 p, 12 n, 11 e; neutral ²²Na: 11 p, 11 n, 11 e; ²³Na⁺: 11 p, 12 n, 10 e. Total charge in elementary-charge units is p−e. The isotope change affects neutron count; electron loss affects the shell and total charge. Z=11, element identity and positive nuclear charge remain unchanged. The supplied qualitative scattering pattern supports a small concentrated positive nucleus, but alone does not determine the specific neutron or electron counts of the stipulated individual atoms/ions. Here these counts follow from the separate Z, A and charge information.",
            "understandingFocusDe": "Kern-Hülle-Zusammenhang und Teilcheneigenschaften über einen wirklich geänderten Ladungsfall begründen; Z/A/Ladung, Streubeleg und Modellskizze trennen. E0/G0, keine beobachtete Leistung.",
            "understandingFocusEn": "Justify nuclear-shell relationships and constituent properties under a genuinely changed charge condition; separate Z/A/charge, scattering evidence and sketch. E0/G0, no observed performance."
          },
          {
            "id": "atomic-model-claims",
            "taskDemandDe": "Drei Behauptungen zu einem neutralen ⁴⁰Ca-Atom (Z=20, A=40): A:Alle40Teilchen sind positive Protonen. B:Die Elektronenhülle enthält den größten Teil der Atommasse. C:Ein kleiner positiver Kern mit Elektronenhülle passt zu überwiegend geraden und selten stark abgelenkten Bahnen positiver α-Teilchen. Ein nicht maßstäbliches Kugelbild zeigt einen großen Kern; es legt keine Elektronenbahn fest. Prüfe A–C mit Teilchenzahlen, Ladungen und relativen Massen. Erkläre das Streumuster auf Modellebene und weshalb die Bildgrößen nicht als Größenverhältnis oder gemessene Bahn gelesen werden dürfen. Frischer unabhängiger Transfer: Ein neuer Fall vergleicht ein neutrales ³⁵Cl-Atom mit einem ³⁵Cl⁻-Ion. Für beide gelten Z=17 und A=35; das Ion hat die Gesamtladung −1. Beschreibe für beide Kern und Hülle mit p-, n- und e-Zahlen und erkläre die Ladungsbilanz. Prüfe die Behauptung „Weil Cl⁻ mehr Elektronen hat, muss sein Kern weniger positiv oder seine Neutronenzahl größer sein“. Trenne die Folgerungen aus Z/A/Ladung von der allgemeinen Aussage des vorgelegten Folien-Streuversuchs und von einer bloßen Modellskizze. Elektronenbahnen oder Schalenbesetzungen werden nicht verlangt.",
            "taskDemandEn": "Three claims about neutral ⁴⁰Ca (Z=20, A=40): A:All40particles are positive protons. B:The electron shell contains most atomic mass. C:A small positive nucleus with an electron shell fits mostly straight and rarely strongly deflected positive alpha trajectories. A non-scale ball picture draws a large nucleus and specifies no electron orbit. Assess A–C using particle counts, charges and relative masses. Explain the scattering pattern at model level and why drawn sizes are not physical size ratios or measured trajectories. Fresh independent transfer: A new case compares neutral ³⁵Cl with a ³⁵Cl⁻ ion. Both have Z=17 and A=35; the ion has total charge −1. Describe nucleus and shell for both using proton, neutron and electron counts and explain the charge balance. Assess the claim “Because Cl⁻ has more electrons, its nucleus must be less positive or its neutron count larger.” Separate inferences from Z/A/charge from the general statement supported by the supplied foil-scattering experiment and from a model sketch. No electron orbits or shell-occupancy model is required.",
            "expectedPerformanceDe": "⁴⁰Ca besitzt20 p,20 n im Kern und20 e in der Hülle. A ist falsch:40 ist die Nukleonensumme, nicht Protonenzahl. B ist falsch:Fast alle Masse liegt im Kern, Elektronen sind viel leichter. C ist mit den Befunden vereinbar:großes weitgehend leeres Volumen und kleiner konzentrierter positiver Kern. Große Ablenkung heißt nicht, dass die ganze Hülle massereich ist. Eine Modellskizze veranschaulicht Anordnung; Größen und Elektronenbahnen sind damit nicht gemessen. Transfer: Neutrales ³⁵Cl besitzt 17 p, 18 n und 17 e; ³⁵Cl⁻ besitzt denselben Kern aus 17 p und 18 n, aber 18 e. p−e ist 0 beziehungsweise −1. Die zusätzliche negative Hüllenladung macht die Kernladung nicht kleiner und ändert keine Neutronenzahl; Z und Elementidentität bleiben gleich. Die konkreten Zahlen folgen aus den gegebenen Z/A-/Ladungsangaben. Der qualitative Folienbefund begründet einen kleinen konzentriert positiven Kern, nicht die konkrete Cl-Neutronenzahl, Ionladung oder gezeichnete Elektronenbahn. Die nicht maßstäbliche Skizze ist keine weitere Messung.",
            "expectedPerformanceEn": "⁴⁰Ca has20 p and20 n in the nucleus and20 e in the shell. A is false:40 is the nucleon total, not proton number. B is false:Almost all mass is nuclear and electrons are much lighter. C fits the evidence:large mostly empty volume and a small concentrated positive nucleus. Large deflection does not imply a massive shell. A sketch illustrates arrangement; it measures neither sizes nor electron paths. Transfer: Neutral ³⁵Cl has 17 p, 18 n and 17 e; ³⁵Cl⁻ has the same nucleus with 17 p and 18 n but 18 e. p−e is 0 and −1 respectively. Additional negative shell charge neither reduces nuclear charge nor changes neutron count; Z and element identity stay the same. Specific counts follow from the stipulated Z/A/charge data. The qualitative foil result supports a small concentrated positive nucleus, not the specific chlorine neutron count, ionic charge or drawn electron orbit. A non-scale sketch is not another measurement.",
            "understandingFocusDe": "Kern-Hülle-Zusammenhang und Teilcheneigenschaften über einen wirklich geänderten Ladungsfall begründen; Z/A/Ladung, Streubeleg und Modellskizze trennen. E0/G0, keine beobachtete Leistung.",
            "understandingFocusEn": "Justify nuclear-shell relationships and constituent properties under a genuinely changed charge condition; separate Z/A/charge, scattering evidence and sketch. E0/G0, no observed performance."
          }
        ]
      }
    },
    {
      "goalId": "7d9fcc7f-1c20-5d5b-9cf6-05f6b624dab6",
      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "representation-and-trend",
            "essentialUnderstandingDe": "Tabellen/Diagramme brauchen passend benannte Größen und Einheiten; Mittelwerte dürfen die Streuung der Rohwerte nicht verbergen.",
            "essentialUnderstandingEn": "Tables/graphs require labelled quantities and units; means must not conceal the spread of raw values.",
            "observablePerformanceDe": "Selbst Tabelle oder Diagramm mit 92/64/49 s und Rohwiederholungen erstellen; die neue 50-°C-Streuung erläutern.",
            "observablePerformanceEn": "Create an own table or graph with 92/64/49 s and raw repeats; explain the new 50 °C spread."
          },
          {
            "id": "hypothesis-inference",
            "essentialUnderstandingDe": "Ein Trend stützt eine Hypothese innerhalb der erhobenen Bedingungen; Verwechslung von Geschwindigkeit, Löslichkeit und Leitfähigkeitsmechanismus ist unzulässig.",
            "essentialUnderstandingEn": "A trend supports a hypothesis within the supplied conditions; speed, solubility capacity and conductivity mechanism are distinct.",
            "observablePerformanceDe": "Temperatur-Zeit- und NaCl-Leitfähigkeitsdaten fachlich zur jeweils vorgegebenen Hypothese in Beziehung setzen; mobile Ionen und neutrale Saccharose unterscheiden.",
            "observablePerformanceEn": "Relate temperature/time and NaCl/conductivity data scientifically to their respective supplied hypotheses; distinguish mobile ions and neutral sucrose."
          },
          {
            "id": "confounds-and-transfer",
            "essentialUnderstandingDe": "Streuende Wiederholungen und temperaturabhängige Leitfähigkeit begrenzen die isolierte Deutung einer veränderten Größe.",
            "essentialUnderstandingEn": "Spread in repeats and temperature-dependent conductivity limit isolated interpretation of a changed variable.",
            "observablePerformanceDe": "Bei 80/45 s die Bedingungen begründet prüfen und beide Daten bewahren; bei wärmerer Einzelprobe Konzentrationseinfluss von Temperaturkonfundierung unterscheiden.",
            "observablePerformanceEn": "For 80/45 s justify checking conditions and preserve both data; distinguish concentration effects from temperature confounding in a warmer individual sample."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "representation-and-trend",
            "hypothesis-inference",
            "confounds-and-transfer"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "changed-condition",
            "textDe": "Neue fallgebundene Bedingung/Hypothesenprüfung und eigene begründete Revision statt bloßem Zahlentausch.",
            "textEn": "Fresh case-specific condition/hypothesis check and own reasoned revision rather than mere number substitution."
          },
          {
            "id": "source-and-limit",
            "textDe": "BY C8/C9-Auswertung und C10-Trends/Beziehungen bleiben fallbezogen erhalten. Tabellen und digitale Erfassung können bereits SekI sein; das Werkzeug allein ist keine Oberstufenleistung. Der Quellenanspruch wird nicht auf rein grafisches Ablesen reduziert. Die ausgewertete Ausgangshypothese darf vorgegeben sein; ihre eigene Formulierung ist keine universelle Voraussetzung dieses anderen Leistungsprodukts.",
            "textEn": "Preserve actual source-specific assistance, stage, track and claim limits; the original whole source-scope contract and case-specific conditions are mandatory. Neither supplied data nor author answers evidence real learner performance."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "lower-chemical-data-interpretation-temperature-trend",
            "taskDemandDe": "Erzeuge eine geeignete Tabelle und ein beschriftetes Diagramm, erläutere den Trend und beurteile die Hypothese mit den Wiederholungen. Unterscheide Geschwindigkeit und Löslichkeitsgrenze. Neue Variation: Bei 50 °C werden 80/45 s gemessen: Erkläre, weshalb vor einer Trendbehauptung Versuchsbedingungen geprüft werden müssen.",
            "taskDemandEn": "Create an appropriate table and labelled graph, explain the trend and evaluate the hypothesis using repeats. Distinguish rate and solubility limit. Fresh variation: At 50 °C times are 80/45 s: explain why conditions must be checked before claiming a trend.",
            "expectedPerformanceDe": "Mittelwerte 92/64/49 s; T auf x-Achse, Zeit auf y-Achse mit Einheiten. Zeiten sinken wiederholt deutlich; das stützt die Hypothese im Bereich 20–40 °C. Keine lineare Abnahme für alle Temperaturen und keine größere maximal lösbare Masse sind nachgewiesen. Größere Wiederholungsstreuung wäre im Diagramm sichtbar zu machen. Transfer: Bei 50 °C beträgt der Mittelwert 62,5 s; die Spannweite ist 35 s. Beide Einzelwerte bleiben sichtbar. Das liegt über dem Mittelwert 49 s bei 40 °C, ist aber wegen der großen Streuung kein zuverlässiger Gegenbeweis für die bisherige Tendenz unter kontrollierten Bedingungen. Tatsächliche Temperaturen während des Lösens, Rühren, Korngröße, Massen/Volumina und Endpunkt prüfen; fehlen diese Angaben, bleibt die Ursache offen. Weder den Wert 80 s verwerfen noch 45 s allein zur Bestätigung verwenden.",
            "expectedPerformanceEn": "Means are 92/64/49 s; T on x-axis, time on y-axis with units. Times repeatedly fall clearly; this supports the hypothesis at 20–40 °C. Neither a linear decrease at all temperatures nor a larger maximum dissolvable mass is established. Larger repeat scatter should be visible in the graph. Transfer: At 50 °C the mean is 62.5 s and the range is 35 s. Retain both individual values. This exceeds the 40 °C mean of 49 s, but the large spread prevents a reliable refutation of the previous trend under controlled conditions. Check actual temperatures during dissolution, stirring, grain size, masses/volumes and endpoint; if absent, the cause remains open. Neither discard 80 s nor use 45 s alone as confirmation.",
            "understandingFocusDe": "Die lernende Person kann erhobene oder recherchierte chemische Daten in geeigneten Tabellen oder Diagrammen auswerten, erkennbare Trends und Beziehungen erläutern und begründen, inwiefern die Daten die Ausgangshypothese stützen oder ihr widersprechen. Eigene unabhängige Begründung und tatsächliches gefordertes Leistungsprodukt, keine Wiedergabe der Musterlösung.",
            "understandingFocusEn": "The learner can evaluate experimental or researched chemical data in suitable tables or diagrams, explain observable trends and relationships, and justify how the data support or contradict the initial hypothesis. Own independent reasoning and the actually required performance artifact, not recitation of the worked answer."
          },
          {
            "id": "lower-chemical-data-interpretation-conductivity-series",
            "taskDemandDe": "Wähle eine passende Darstellung, beschreibe Beziehungen und erkläre mit beweglichen Ladungsträgern den Hypothesenbefund; prüfe die Rolle der Vergleichsprobe. Neue Variation: Beschreibe, wie steigende Temperatur bei nur einer Probe die Interpretation stören könnte.",
            "taskDemandEn": "Choose a suitable representation, describe relationships and explain the hypothesis finding using mobile charge carriers; assess the comparison sample. Fresh variation: Describe how rising temperature in just one sample could confound the interpretation.",
            "expectedPerformanceDe": "κ gegen c zeigt wachsende Leitfähigkeit, nahe linear in dieser kleinen Reihe. NaCl liefert bewegliche Ionen, Saccharose überwiegend ungeladene Moleküle; ihr Wert nahe Blindprobe widerlegt „jedes Gelöste leitet gleich“. Der Stoffvergleich unterstützt einen Ionenbezug, bestimmt aber keine unbekannte Salzidentität. Transfer: Eine wärmere Einzelprobe kann durch veränderte Ionenbeweglichkeit eine andere Leitfähigkeit zeigen, ohne dass ihre Konzentration gestiegen ist. Dann ändern sich Konzentration und Temperatur gemeinsam; der Konzentrationseinfluss ist nicht sauber isoliert. Temperatur jeder Probe dokumentieren, vergleichbare Temperatur herstellen oder ein tatsächlich begründetes Temperaturkorrekturverfahren verwenden. Keine erfundene Korrekturzahl einsetzen. Die gegebene 25-°C-Reihe stützt innerhalb ihres Bereichs die NaCl-Hypothese; der Temperaturfehler widerlegt das Ionenmodell nicht.",
            "expectedPerformanceEn": "κ against c shows increasing conductivity, approximately linear within this small series. NaCl supplies mobile ions, sucrose mainly uncharged molecules; its near-blank value contradicts “every dissolved substance conducts equally”. The comparison supports an ion interpretation but does not identify an unknown salt. Transfer: A warmer individual sample can show altered conductivity through ion mobility without an increase in concentration. Concentration and temperature then vary together, so the concentration effect is not isolated. Document each temperature, establish comparable temperatures or use a genuinely justified temperature-correction procedure. Do not invent a correction number. The supplied 25 °C series supports the NaCl hypothesis within its range; the temperature error does not refute the ion model.",
            "understandingFocusDe": "Die lernende Person kann erhobene oder recherchierte chemische Daten in geeigneten Tabellen oder Diagrammen auswerten, erkennbare Trends und Beziehungen erläutern und begründen, inwiefern die Daten die Ausgangshypothese stützen oder ihr widersprechen. Eigene unabhängige Begründung und tatsächliches gefordertes Leistungsprodukt, keine Wiedergabe der Musterlösung.",
            "understandingFocusEn": "The learner can evaluate experimental or researched chemical data in suitable tables or diagrams, explain observable trends and relationships, and justify how the data support or contradict the initial hypothesis. Own independent reasoning and the actually required performance artifact, not recitation of the worked answer."
          }
        ]
      }
    },
    {
      "goalId": "858d56e0-ab8f-51a4-b07e-7d9d94cab8e2",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "b002-858d56e0-core",
            "essentialUnderstandingDe": "Primäre und sekundäre Alkanole besitzen am OH-tragenden C ein H für die übliche Oxidation zu Carbonylverbindungen; tertiären fehlt es, weshalb die analoge milde Oxidation nicht greift.",
            "essentialUnderstandingEn": "Primary and secondary alkanols carry a hydrogen at the OH-bearing carbon for ordinary oxidation to carbonyl compounds; tertiary ones lack it, so the analogous mild oxidation does not occur.",
            "observablePerformanceDe": "Die lernende Person markiert das relevante C-H in gegebenen Strukturen und ordnet primäres, sekundäres und tertiäres Alkanol unter vergleichbaren milden Bedingungen.",
            "observablePerformanceEn": "The learner marks the relevant C-H in supplied structures and classifies primary, secondary, and tertiary alkanols under comparable mild conditions."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b002-858d56e0-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "alkanol-class",
            "textDe": "Primär, sekundär und tertiär werden strukturell unterschieden.",
            "textEn": "Primary, secondary, and tertiary structures are distinguished."
          },
          {
            "id": "branching",
            "textDe": "Ein frischer verzweigter Fall prüft die lokale OH-Umgebung.",
            "textEn": "A fresh branched case tests the local OH environment."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "three-propanol-classes",
            "taskDemandDe": "Vergleiche Propan-1-ol, Propan-2-ol und 2-Methylpropan-2-ol unter üblichen milden Oxidationsbedingungen. Markiere das H am OH-tragenden C.",
            "taskDemandEn": "Compare propan-1-ol, propan-2-ol, and 2-methylpropan-2-ol under ordinary mild oxidation conditions. Mark H on the OH-bearing carbon.",
            "expectedPerformanceDe": "Die lernende Person ordnet primär, sekundär und tertiär zu; die ersten beiden besitzen das relevante C-H, das tertiäre nicht.",
            "expectedPerformanceEn": "The learner classifies primary, secondary, and tertiary; the first two have the relevant C-H, while the tertiary does not.",
            "understandingFocusDe": "Lokale Struktur erklärt den Unterschied in der üblichen Oxidation.",
            "understandingFocusEn": "Local structure explains the difference in ordinary oxidation."
          },
          {
            "id": "fresh-branched-classification",
            "taskDemandDe": "Neue Strukturkarten zeigen 3-Methylbutan-2-ol und 2-Methylbutan-2-ol. Welches lässt sich unter denselben milden Bedingungen zum Carbonyl oxidieren?",
            "taskDemandEn": "New structure cards show 3-methylbutan-2-ol and 2-methylbutan-2-ol. Which can be oxidized to a carbonyl under the same mild conditions?",
            "expectedPerformanceDe": "Die lernende Person erkennt beim ersten das OH-tragende sekundäre C-H und beim zweiten ein tertiäres C ohne H; sie begrenzt die Aussage auf die vorgegebenen Bedingungen.",
            "expectedPerformanceEn": "The learner identifies a secondary OH-bearing C-H in the first and a tertiary carbon without H in the second, qualifying the conclusion to the stated conditions.",
            "understandingFocusDe": "Verzweigung allein ist kein Ersatz für C-H-Prüfung.",
            "understandingFocusEn": "Branching alone is no substitute for checking C-H."
          }
        ]
      }
    },
    {
      "goalId": "8d4ef102-e6a6-4d2e-bb6b-e707d3f2e566",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "b009-8d-substance-identity-diagnostic",
            "essentialUnderstandingDe": "Bei einem physikalischen Vorgang können Zustand, Verteilung oder Aussehen wechseln, ohne dass neue Stoffe entstehen. Bei einer chemischen Reaktion entstehen aus Ausgangsstoffen andere Stoffe mit eigenen Eigenschaften; dabei kann Energie übertragen werden. Blasen, Farb- oder Temperaturänderung sind für sich allein kein Beweis für Stoffneubildung.",
            "essentialUnderstandingEn": "A physical process can change state, distribution or appearance without forming new substances. A chemical reaction forms different substances with their own properties from starting substances and may transfer energy. Bubbles, colour or temperature change alone do not prove that new substances formed.",
            "observablePerformanceDe": "Die lernende Person vergleicht vorgegebene Vorher-/Nachher-Stoffdaten für zwei unbekannte Vorgänge, entscheidet begründet zwischen physikalischem Vorgang und chemischer Reaktion und benennt, welche Einzelbeobachtung ohne Stoffnachweis offenbleibt.",
            "observablePerformanceEn": "The learner compares supplied before-and-after substance data for two unfamiliar processes, justifies which is physical and which is chemical, and identifies which isolated observation remains inconclusive without substance evidence."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b009-8d-substance-identity-diagnostic"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "misleading-observation",
            "textDe": "Gasblasen werden in Fall 1 und Farbwechsel in Fall 2 als möglicher, aber nicht entscheidender Hinweis betrachtet.",
            "textEn": "Bubbles in case 1 and colour change in case 2 are treated as possible but non-decisive clues."
          },
          {
            "id": "substance-comparison",
            "textDe": "Bereits gelöstes CO₂ gegen neu gebildete Reaktionsprodukte; verteilte Farbe gegen neu gebildetes Kupferoxid.",
            "textEn": "Previously dissolved CO₂ versus newly formed reaction products; dispersed dye versus newly formed copper oxide."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "co2-bubbles-two-origins-paper-data",
            "taskDemandDe": "Zwei Lehrkraft-Datensätze zeigen Blasen: A enthält zunächst in Mineralwasser gelöstes CO₂; beim Erwärmen entweicht dasselbe CO₂, und sonstige Stoffanalysen ändern sich nicht. B beschreibt das Mischen von Essig und Natriumhydrogencarbonat; die Ausgangsanalysen zeigen kein freies CO₂, danach sind CO₂ und eine neue gelöste Verbindung nachgewiesen. Entscheide für A und B, was ein physikalischer Vorgang bzw. eine chemische Reaktion ist. Erkläre, warum die Blasen allein die Entscheidung nicht tragen. Nur Papierdaten; keine Mischung oder Erhitzung durchführen.",
            "taskDemandEn": "Two teacher-supplied data sets show bubbles: A initially contains CO₂ dissolved in mineral water; warming releases the same CO₂ and other substance analyses remain unchanged. B describes mixing vinegar and sodium bicarbonate; initial analyses show no free CO₂, and afterwards CO₂ and a new dissolved compound are detected. Decide which is a physical process and which a chemical reaction. Explain why bubbles alone do not settle it. Paper data only; do not mix or heat anything.",
            "expectedPerformanceDe": "Die lernende Person ordnet A als physikalisches Entweichen bereits vorhandenen CO₂ ein und B als chemische Reaktion mit neu gebildeten Stoffen. Sie stützt sich auf die Stoffdaten vor und nach dem Vorgang, nicht auf das gemeinsame Blubbern, und gibt an, dass ein isoliertes Blasenbild ohne Analysen offenbleibt.",
            "expectedPerformanceEn": "The learner identifies A as physical release of pre-existing CO₂ and B as a chemical reaction that forms new substances. They rely on substance data before and after, not the shared bubbling, and say that bubbles alone would leave the classification open.",
            "understandingFocusDe": "Gleiches beobachtbares Signal, unterschiedliche Stoffbilanz und begrenzte Schlusskraft einer Einzelbeobachtung.",
            "understandingFocusEn": "The same visible signal, different substance outcomes and the limit of a single observation."
          },
          {
            "id": "colour-change-two-origins-paper-data",
            "taskDemandDe": "Eine neue Karte vergleicht zwei Farbänderungen: C ist klares Wasser, das nach Zugabe eines blauen Lebensmittelfarbstoffs blau aussieht; die Analyse findet Wasser und denselben Farbstoff unverändert. D sind Kupfer- und Sauerstoffdaten einer beaufsichtigten Vorführung: Nach dem Erhitzen liegt schwarzes Kupferoxid mit anderen Stoffeigenschaften vor, während Kupfer und Sauerstoff umgesetzt wurden. Ordne C und D zu und erkläre, welche Daten mehr aussagen als die Farbe. Nur Datenauswertung; keine eigene Erhitzung.",
            "taskDemandEn": "A new card compares two colour changes: C is clear water that looks blue after blue food dye is added; analysis finds unchanged water and the same dye. D gives copper-and-oxygen data from a supervised demonstration: after heating, black copper oxide with different substance properties is present while copper and oxygen were consumed. Classify C and D and explain which data say more than colour. Interpret data only; do not heat anything yourself.",
            "expectedPerformanceDe": "Die lernende Person ordnet C als physikalisches Mischen ohne neuen Stoff und D als chemische Bildung von Kupferoxid ein. Sie begründet D über neue Stoffeigenschaften und umgesetzte Ausgangsstoffe; dass beide Proben ihre Farbe ändern, reicht jeweils allein nicht aus. Die Wärmezufuhr bei D ist ebenfalls für sich kein Reaktionsbeweis.",
            "expectedPerformanceEn": "The learner identifies C as physical mixing without a new substance and D as chemical formation of copper oxide. They justify D through new substance properties and consumption of starting substances; the colour change shared by both is insufficient on its own. Heating in D is likewise not by itself proof of a reaction.",
            "understandingFocusDe": "Transfer von Gas- auf Farbsignal: Produktidentität statt Farbe oder Wärmezufuhr entscheidet.",
            "understandingFocusEn": "Transfer from gas to colour clues: product identity rather than colour or heating is decisive."
          }
        ]
      }
    },
    {
      "goalId": "91cd4728-b811-562a-970b-18b81dfb4bdf",
      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "b002-91cd4728-core",
            "essentialUnderstandingDe": "Die OH-Gruppe ermöglicht Wasserstoffbrücken, während Alkylreste unpolar wirken; daraus folgen Trends statt ausnahmsloser Aussagen zu Löslichkeit und Siedepunkt.",
            "essentialUnderstandingEn": "The OH group allows hydrogen bonding while alkyl groups are nonpolar; this supports trends rather than exception-free claims about solubility and boiling point.",
            "observablePerformanceDe": "Die lernende Person vergleicht zwei kleine organische Moleküle anhand von Struktur, zwischenmolekularen Kräften und beobachteter Wasserlöslichkeit oder Siedetemperatur.",
            "observablePerformanceEn": "The learner compares two small organic molecules through structure, intermolecular forces, and observed water solubility or boiling temperature."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b002-91cd4728-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "interaction",
            "textDe": "Wasserstoffbrücken werden mit vorwiegenden London-Kräften verglichen.",
            "textEn": "Hydrogen bonding is compared with mainly London forces."
          },
          {
            "id": "chain-length",
            "textDe": "Die Alkylkette wird in einem frischen Fall verlängert.",
            "textEn": "The alkyl chain is lengthened in a fresh case."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "methanol-ethane-mass-controlled",
            "taskDemandDe": "Methanol (M≈32 g/mol) und Ethan (M≈30 g/mol) besitzen ähnliche molare Massen, aber stark verschiedene Siedetemperaturen; Methanol ist mit Wasser mischbar, Ethan kaum löslich. Erkläre diese Unterschiede aus den Molekülstrukturen.",
            "taskDemandEn": "Methanol (M≈32 g/mol) and ethane (M≈30 g/mol) have similar molar masses but very different boiling points; methanol mixes with water, whereas ethane is poorly soluble. Explain the differences from molecular structure.",
            "expectedPerformanceDe": "Die lernende Person erkennt Methanols OH-Gruppe und Wasserstoffbrücken zu Methanol und Wasser, während Ethan nur unpolare Wechselwirkungen bietet. Sie erklärt den Siede- und Löslichkeitstrend trotz ähnlicher molarer Massen.",
            "expectedPerformanceEn": "The learner identifies methanol’s OH group and hydrogen bonding among methanol molecules and with water, whereas ethane offers only nonpolar interactions. They explain boiling and solubility trends despite similar molar masses.",
            "understandingFocusDe": "Struktur-Wirkungs-Beziehung erklärt zwei beobachtete Eigenschaften.",
            "understandingFocusEn": "A structure-interaction link explains two observed properties."
          },
          {
            "id": "fresh-longer-alcohol-solubility",
            "taskDemandDe": "Ein unbekanntes unverzweigtes Alkanol hat sechs statt zwei C-Atome. Vergleiche seine Wasserlöslichkeit qualitativ mit Ethanol und begrenze die Aussage.",
            "taskDemandEn": "An unknown straight-chain alkanol has six instead of two carbons. Compare its water solubility qualitatively with ethanol and qualify the claim.",
            "expectedPerformanceDe": "Die lernende Person erwartet geringere Wasserlöslichkeit wegen des größeren unpolaren Restes trotz gleicher OH-Funktion und behauptet keine exakte Löslichkeitszahl.",
            "expectedPerformanceEn": "The learner expects lower water solubility due to the larger nonpolar part despite the same OH group and gives no invented numerical solubility.",
            "understandingFocusDe": "Ein veränderter Alkylrest prüft das Modell, nicht einen Merksatz.",
            "understandingFocusEn": "A changed alkyl group tests the model rather than a memorized slogan."
          }
        ]
      }
    },
    {
      "goalId": "92c99237-1c74-54fc-bf08-9191656afaa6",
      "wholeProfile": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "b006-92c99237-core",
            "essentialUnderstandingDe": "Eine Summenformel nennt Atomzahlen, aber nicht zwingend Verknüpfung, Elektronenpaare oder räumliche Form. Struktur-, Lewis- und räumliche Darstellungen zeigen diese Aspekte unterschiedlich; Umwandeln braucht zusätzliche gegebene Strukturinformation, wenn Isomere möglich sind.",
            "essentialUnderstandingEn": "A molecular formula gives atom counts but not necessarily connectivity, electron pairs or spatial shape. Structural, Lewis and spatial representations show these differently; conversion needs added structural information when isomers are possible.",
            "observablePerformanceDe": "Die lernende Person überführt eine vorgegebene Molekülstruktur in andere Formeln und begründet die Darstellungswahl anhand einer konkreten Frage.",
            "observablePerformanceEn": "The learner converts a supplied molecular structure into other formulas and justifies representation choice for a concrete question."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b006-92c99237-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "question",
            "textDe": "Atomzahl, Verknüpfung und freie Elektronenpaare verlangen unterschiedliche Darstellungen.",
            "textEn": "Atom count, connectivity and lone pairs require different representations."
          },
          {
            "id": "isomer",
            "textDe": "Gleiche Summenformel kann verschiedene Strukturformeln besitzen.",
            "textEn": "The same molecular formula may have different structural formulas."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "ethanol-ether-isomers",
            "taskDemandDe": "Zwei gegebene Modelle zeigen CH3–CH2–OH und CH3–O–CH3. Gib für beide die Summenformel an, zeichne einfache Struktur- oder Lewis-Formeln und wähle eine Darstellung, die den Unterschied beweist.",
            "taskDemandEn": "Two supplied models show CH3–CH2–OH and CH3–O–CH3. Give both molecular formulas, draw simple structural or Lewis formulas and select a representation that proves their difference.",
            "expectedPerformanceDe": "Beide C2H6O; nur die Verknüpfungsdarstellung trennt Ethanol und Dimethylether. Die Summenformel allein kann nicht in genau eine Struktur rückübersetzt werden; O hat in einer Lewis-Skizze zwei freie Paare.",
            "expectedPerformanceEn": "Both are C2H6O; connectivity distinguishes ethanol and dimethyl ether. The molecular formula alone cannot be inverted into one unique structure; O has two lone pairs in a Lewis sketch.",
            "understandingFocusDe": "Isomerie macht die Grenze der Summenformel sichtbar.",
            "understandingFocusEn": "Isomerism exposes the molecular formula’s limit."
          },
          {
            "id": "ethene-representation-choice",
            "taskDemandDe": "Ein neues Kugel-Stab-Modell zeigt Ethen mit zwei C und vier H sowie C=C. Formuliere Summen- und einfache Strukturformel. Welche Darstellung wählst du für Atomzahl und welche für die Doppelbindung?",
            "taskDemandEn": "A fresh ball-and-stick model shows ethene with two C and four H and C=C. Write molecular and simple structural formulas. Which representation serves atom count and which shows the double bond?",
            "expectedPerformanceDe": "C2H4 gibt die Anzahl, H2C=CH2 die Verknüpfung samt Doppelbindung; ein Modell/Skizze kann räumliche Anordnung andeuten. Die Wahl wird von der Frage begründet, nicht vom Bildstil.",
            "expectedPerformanceEn": "C2H4 gives counts; H2C=CH2 gives connectivity including the double bond; a model may suggest spatial arrangement. Choice follows the question, not image style.",
            "understandingFocusDe": "Neue Molekülklasse prüft Überführung und begründete Wahl.",
            "understandingFocusEn": "A new molecule class tests conversion and justified selection."
          }
        ]
      }
    },
    {
      "goalId": "950c73c6-4ed1-488a-9267-1142e95e0055",
      "wholeProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "spatial-lattice-model",
            "essentialUnderstandingDe": "Ein einfaches NaCl-Gitter ist ein ausgedehntes, elektrisch neutrales Ionengitter. Jedes innere Na⁺ hat sechs nächste Cl⁻ in drei gegenüberliegenden Raumrichtungen; NaCl bezeichnet das Verhältnis 1:1, nicht ein einzelnes NaCl₆-Molekül.",
            "essentialUnderstandingEn": "A simple NaCl lattice is an extended electrically neutral ionic structure. Each internal Na⁺ has six nearest Cl⁻ in three opposite spatial directions; NaCl gives a 1:1 ratio, not a discrete NaCl₆ molecule.",
            "observablePerformanceDe": "Die lernende Person konstruiert oder zeichnet mit vorgegebenem Strukturtyp einen räumlichen Gitterausschnitt, markiert sechs nächste Gegenionen, erklärt den Ausschnitt und unterscheidet Koordinationszahl, Stoffverhältnis und Randartefakte.",
            "observablePerformanceEn": "The learner constructs or draws a spatial lattice fragment for a supplied structure type, marks six nearest counterions, explains the fragment, and distinguishes coordination number, composition ratio and boundary artefacts."
          },
          {
            "id": "forces-and-mobility",
            "essentialUnderstandingDe": "Starke elektrostatische Wechselwirkungen im geordneten Gitter erklären hohe Schmelztemperaturen. Im festen Salz fehlen bewegliche Ladungsträger; in Schmelze oder wässriger Lösung können Ionen wandern. Verschieben von Gitterebenen kann gleich geladene Nachbarn und Abstoßung erzeugen: spröder Bruch.",
            "essentialUnderstandingEn": "Strong electrostatic interactions in the ordered lattice explain high melting temperatures. Solid salt lacks mobile charge carriers; ions can move in its melt or aqueous solution. Sliding lattice planes can bring like charges together and cause repulsion, explaining brittle fracture.",
            "observablePerformanceDe": "Die lernende Person begründet vorgegebene Befunde zu festem, geschmolzenem und gelöstem Salz mit Anordnung, Kräften und Ionenbeweglichkeit und erklärt einen Bruchfall ohne freie Elektronen oder Moleküle im Kristall zu erfinden.",
            "observablePerformanceEn": "The learner explains supplied observations for solid, molten and dissolved salt through arrangement, forces and ion mobility, and explains fracture without inventing free electrons or crystal molecules."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "spatial-lattice-model",
            "forces-and-mobility"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "charge-structure-state",
            "textDe": "Andere vorgegebene Gittertypen und Ionenladungen; feste, geschmolzene und gelöste Zustände; Koordinationszahl aus Strukturangaben, nie aus der Bildfarbe.",
            "textEn": "Other supplied lattice types and ionic charges; solid, molten and dissolved states; coordination from structural information, never image colours."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "nacl-build-and-explain",
            "taskDemandDe": "Gegeben sind Na⁺/Cl⁻-Modellbausteine, das NaCl-Strukturprinzip sowie Befunde: festes Salz leitet nicht, die Schmelze und eine wässrige Lösung leiten; der Kristall ist spröde. Erstelle einen räumlichen Gitterausschnitt, erläutere die sechs nächsten Nachbarn und begründe die drei Stoffbefunde. Das Lernbild darf als Orientierung dienen, ist kein erstelltes Lernendenmodell.",
            "taskDemandEn": "Given Na⁺/Cl⁻ model pieces, the NaCl structural principle and observations that solid salt does not conduct, its melt and aqueous solution conduct, and the crystal is brittle, construct a spatial lattice fragment. Explain the six nearest neighbours and the material observations. The learning image may orient the task; it is not the learner’s constructed model.",
            "expectedPerformanceDe": "Ein eigener räumlicher Ausschnitt zeigt abwechselnde Ladungen und eine fortsetzbare Struktur. Sechs Cl⁻ umgeben ein inneres Na⁺; die Stoffformel bleibt NaCl. Starke Anziehung hält das Gitter zusammen; feste Ionen können nicht durch die Probe wandern, gelöste/geschmolzene schon. Ebenenverschiebung kann gleichnamige Ladungen gegenüberstellen und den Kristall spalten.",
            "expectedPerformanceEn": "An original spatial fragment shows alternating charges and an extendable structure. Six Cl⁻ surround an internal Na⁺; the composition remains NaCl. Strong attraction holds the lattice together; fixed ions cannot migrate through the sample, whereas dissolved or molten ions can. Plane displacement can oppose like charges and split the crystal.",
            "understandingFocusDe": "Räumliches Modell und kausale Struktur-Eigenschafts-Erklärung.",
            "understandingFocusEn": "Spatial modeling and causal structure-property explanation."
          },
          {
            "id": "mgo-given-rocksalt-transfer",
            "taskDemandDe": "Für MgO wird ausdrücklich ein NaCl-artiger Strukturtyp mit sechs nächsten Gegenionen vorgegeben. Ein anderes Salz im Aufgabenblatt hat einen anderen vorgegebenen Strukturtyp. Baue/skizziere den MgO-Ausschnitt, prüfe die Behauptung MgO₆ und erkläre, weshalb Feststoff/Schmelze unterschiedliche Leitung zeigen. Leite keine allgemeine Koordinationszahl aller Salze ab.",
            "taskDemandEn": "MgO is explicitly assigned the NaCl structure type with six nearest counterions; another salt on the task sheet has a different supplied structure type. Construct/sketch the MgO fragment, evaluate the claim MgO₆, and explain the different conduction of solid and melt. Do not infer one coordination number for all salts.",
            "expectedPerformanceDe": "Mg²⁺ und O²⁻ stehen hier im Verhältnis 1:1 in einem ausgedehnten Gitter. Die vorgegebene Koordinationszahl sechs ist eine Nachbarschaftsangabe, keine Summenformel. Erst im geschmolzenen Zustand können die geladenen Ionen durch die Probe wandern; im Feststoff sind sie an Gitterplätze gebunden. Der Strukturtyp anderer Salze muss gesondert bekannt sein.",
            "expectedPerformanceEn": "Mg²⁺ and O²⁻ form a 1:1 extended lattice here. The supplied coordination number six describes neighbours, not a formula. Charged ions can migrate through the melt; in the solid they occupy lattice sites. The structure type of other salts needs separate information.",
            "understandingFocusDe": "Frischer Stoff, eigener Modelltransfer und Prüfung der Modellgrenzen.",
            "understandingFocusEn": "Fresh substance, original modeling transfer and checking model limits."
          }
        ]
      }
    },
    {
      "goalId": "95dc0ee5-a0af-5682-af32-d66e36fbeb50",
      "wholeProfile": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "core-understanding",
            "essentialUnderstandingDe": "Fachsprache verbindet beobachtbare Stoffe mit korrekt bezeichneten Teilchen und Formeln, ohne beide Ebenen gleichzusetzen. Ionengitter, Moleküle, Atome, Ladungen und Verhältniszahlen werden passend verwendet; Alltagssprache muss in eine prüfbare Aussage übersetzt werden.",
            "essentialUnderstandingEn": "Technical language connects observable substances with correctly named particles and formulas without conflating the levels. Ionic lattices, molecules, atoms, charges and ratio numbers are used appropriately; everyday speech is translated into a testable statement.",
            "observablePerformanceDe": "Auf Stoffebene ist nach dem Lösen kein Salzkristall sichtbar, das Salz ist aber weiterhin in der Lösung enthalten. Auf Teilchenebene werden Na+ und Cl− aus dem Gitter getrennt und von Wassermolekülen hydratisiert: NaCl(s) → Na+(aq) + Cl−(aq). NaCl bezeichnet das Ionenverhältnis 1:1, nicht ein einzelnes Salz-Molekül im Kristall. Es entsteht kein Natriummetall. Die beweglichen Ionen erklären die Leitfähigkeit; die Lösung ist insgesamt ladungsneutral.",
            "observablePerformanceEn": "At substance level, no salt crystal remains visible after dissolution, but the salt components remain in solution. At particle level, Na+ and Cl− separate from the lattice and are hydrated by water molecules: NaCl(s) → Na+(aq) + Cl−(aq). NaCl states the 1:1 ion ratio, not an individual salt molecule in the crystal. Sodium metal is not formed. Mobile ions explain conductivity; the whole solution is electrically neutral."
          },
          {
            "id": "fresh-transfer-and-limit",
            "essentialUnderstandingDe": "Kochsalz lösen und Verhältnisformel gegenüber Wasserbildung, Molekülen und Koeffizienten; Ebenenwechsel und Ladungserhaltung. Koeffizienten, Indizes und Ladungen haben verschiedene Bedeutungen; Formeländerung ist kein zulässiges Bilanzieren.",
            "essentialUnderstandingEn": "Dissolving table salt and a ratio formula versus water formation, molecules and coefficients; changing descriptive levels and conserving charge. Coefficients, subscripts and charges have different meanings; changing a species formula is not valid balancing.",
            "observablePerformanceDe": "2 H2 + O2 → 2 H2O bedeutet: zwei Wasserstoffmoleküle reagieren mit einem Sauerstoffmolekül zu zwei Wassermolekülen, entsprechend den Stoffmengenverhältnissen 2:1:2. Links und rechts sind vier H- und zwei O-Atome vorhanden. Der Koeffizient 2 zählt Moleküle oder Stoffmengen, der Index 2 in H2O beschreibt zwei H-Atome pro Molekül; Umsetzen eines Index ändert die Stoffart. Cl− bezeichnet ein Chlorid-Ion mit einer negativen Elementarladung und einem Elektron mehr als ein neutrales Cl-Atom.",
            "observablePerformanceEn": "2 H2 + O2 → 2 H2O means two hydrogen molecules react with one oxygen molecule to form two water molecules, corresponding to the amount ratio 2:1:2. Both sides contain four H and two O atoms. Coefficient 2 counts molecules or amounts; subscript 2 in H2O specifies two H atoms per molecule. Moving a subscript changes the species. Cl− is a chloride ion with one negative elementary charge and one more electron than a neutral Cl atom."
          },
          {
            "id": "systematic-name-to-structure",
            "essentialUnderstandingDe": "Nur im bayerischen Quellenkontext Chemie 13, erhöhtes Anforderungsniveau, C13 Lernbereich 4 (BY/goals/587; technische LK-Ansicht de-by-gym-chemistry-lk-explicit-source-union-author): Ein systematischer Aminosäurename codiert Konnektivität und gegebenenfalls Stereochemie. Formel- und Raumdarstellungen dürfen nur bezeichnete Information übernehmen. Diese spezielle Anforderung ist keine globale Pflicht dieses Lernziels und insbesondere keine zusätzliche SekI-Pflicht.",
            "essentialUnderstandingEn": "Only in the Bavarian source context Chemistry 13, elevated level, C13 learning area 4 (BY/goals/587; technical LK view de-by-gym-chemistry-lk-explicit-source-union-author): a systematic amino acid name encodes connectivity and, when specified, stereochemistry. Formula and spatial representations must not invent unspecified information. This specific requirement is not a global duty of this goal and introduces no additional SekI requirement.",
            "observablePerformanceDe": "Im genannten bayerischen Quellen-/Kurskontext: Dekodiert stereochemisch eindeutige Aminosäurenamen mit einer bereitgestellten Regelkarte selbst in Fischer-Formeln und begründet die Unterbestimmtheit eines Namens ohne Stereodeskriptor. Die beiden unveränderten Fälle systematic-name-to-fischer-alanine-underdetermined und systematic-name-to-fischer-cysteine-serine-transfer konkretisieren dort die Pflicht; außerhalb dieses Kontexts sind sie keine Voraussetzung für den Abschluss dieses Lernziels.",
            "observablePerformanceEn": "In the stated Bavarian source/course context: independently decodes stereochemically specified amino acid names into Fischer formulas with a supplied codebook and explains underdetermination without a stereodescriptor. The unchanged cases systematic-name-to-fischer-alanine-underdetermined and systematic-name-to-fischer-cysteine-serine-transfer specify that duty there; outside this context they are not a prerequisite for completing this goal."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "core-understanding",
            "fresh-transfer-and-limit"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "specific-system-variation",
            "textDe": "Kochsalz lösen und Verhältnisformel gegenüber Wasserbildung, Molekülen und Koeffizienten; Ebenenwechsel und Ladungserhaltung.",
            "textEn": "Dissolving table salt and a ratio formula versus water formation, molecules and coefficients; changing descriptive levels and conserving charge."
          },
          {
            "id": "model-boundary",
            "textDe": "Koeffizienten, Indizes und Ladungen haben verschiedene Bedeutungen; Formeländerung ist kein zulässiges Bilanzieren.",
            "textEn": "Coefficients, subscripts and charges have different meanings; changing a species formula is not valid balancing."
          },
          {
            "id": "by-c13-source587-scoped-name-to-fischer",
            "textDe": "Die beiden Aminosäure-Namensfälle und die zusätzliche Erwartung systematic-name-to-structure sind ausschließlich für BY/goals/587 im bayerischen C13-LK-Quellenkontext der Ansicht de-by-gym-chemistry-lk-explicit-source-union-author verbindlich (separater Quellen-Fallvertrag). Die allgemeinen Pflicht-Erwartungen bleiben überall unverändert; andere SekI-Kontexte verlangen dadurch weder Aminosäuren noch CIP/Fischer.",
            "textEn": "The two amino acid name cases and the additional systematic-name-to-structure expectation are mandatory only for BY/goals/587 in the Bavarian C13 LK source context of view de-by-gym-chemistry-lk-explicit-source-union-author (separate source-case contract). General required expectations remain unchanged everywhere; this introduces no amino acid or CIP/Fischer requirement in other SekI contexts."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-next20-95dc0ee5-case-1",
            "taskDemandDe": "Alltagstext: „Beim Lösen verschwinden die Salz-Moleküle; das Wasser macht daraus Natrium.“ Gegeben sind festes NaCl, eine klare Lösung und Leitfähigkeit der Lösung. Im Teilchenmodell enthält festes NaCl ein Na+/Cl−-Gitter; Wasser besteht aus H2O-Molekülen. Schreibe den Text fachlich korrekt für jüngere Lernende um; trenne Stoff- und Teilchenebene, erläutere NaCl und beschreibe den Lösungsvorgang symbolisch.",
            "taskDemandEn": "Everyday text: “When dissolving, salt molecules disappear; water turns them into sodium.” Supplied observations: solid NaCl, a clear solution and solution conductivity. In the particle model solid NaCl has a Na+/Cl− lattice and water consists of H2O molecules. Rewrite the text correctly for younger learners; distinguish substance and particle levels, explain NaCl and describe dissolution symbolically.",
            "expectedPerformanceDe": "Auf Stoffebene ist nach dem Lösen kein Salzkristall sichtbar, das Salz ist aber weiterhin in der Lösung enthalten. Auf Teilchenebene werden Na+ und Cl− aus dem Gitter getrennt und von Wassermolekülen hydratisiert: NaCl(s) → Na+(aq) + Cl−(aq). NaCl bezeichnet das Ionenverhältnis 1:1, nicht ein einzelnes Salz-Molekül im Kristall. Es entsteht kein Natriummetall. Die beweglichen Ionen erklären die Leitfähigkeit; die Lösung ist insgesamt ladungsneutral.",
            "expectedPerformanceEn": "At substance level, no salt crystal remains visible after dissolution, but the salt components remain in solution. At particle level, Na+ and Cl− separate from the lattice and are hydrated by water molecules: NaCl(s) → Na+(aq) + Cl−(aq). NaCl states the 1:1 ion ratio, not an individual salt molecule in the crystal. Sodium metal is not formed. Mobile ions explain conductivity; the whole solution is electrically neutral.",
            "understandingFocusDe": "Unsichtbar auf Stoffebene bedeutet nicht vernichtet; eine Verhältnisformel ist keine Molekülbehauptung.",
            "understandingFocusEn": "Invisible at substance level does not mean destroyed; a ratio formula does not assert molecules."
          },
          {
            "id": "chem-next20-95dc0ee5-case-2",
            "taskDemandDe": "Frischer Text: „Zwei Wasserstoffe und ein Sauerstoff machen zwei Wasser; die kleine 2 kann überall stehen.“ Gegeben ist die Reaktion gasförmiger H2- und O2-Moleküle zu H2O. In einem zweiten Satz wird „ein Chlorid-Ion“ als „ein Chloratom ohne Ladung“ bezeichnet. Formuliere beide Sätze präzise, erläutere Koeffizient, Index und Ladungssymbol und zeige die erhaltene Atomzahl in der Wasser-Reaktionsgleichung.",
            "taskDemandEn": "Fresh text: “Two hydrogens and one oxygen make two water; the small 2 can be placed anywhere.” The reaction of gaseous H2 and O2 molecules to H2O is supplied. A second sentence calls a chloride ion an uncharged chlorine atom. State both sentences precisely, explain coefficients, subscripts and charge symbols and show atom conservation in the water reaction equation.",
            "expectedPerformanceDe": "2 H2 + O2 → 2 H2O bedeutet: zwei Wasserstoffmoleküle reagieren mit einem Sauerstoffmolekül zu zwei Wassermolekülen, entsprechend den Stoffmengenverhältnissen 2:1:2. Links und rechts sind vier H- und zwei O-Atome vorhanden. Der Koeffizient 2 zählt Moleküle oder Stoffmengen, der Index 2 in H2O beschreibt zwei H-Atome pro Molekül; Umsetzen eines Index ändert die Stoffart. Cl− bezeichnet ein Chlorid-Ion mit einer negativen Elementarladung und einem Elektron mehr als ein neutrales Cl-Atom.",
            "expectedPerformanceEn": "2 H2 + O2 → 2 H2O means two hydrogen molecules react with one oxygen molecule to form two water molecules, corresponding to the amount ratio 2:1:2. Both sides contain four H and two O atoms. Coefficient 2 counts molecules or amounts; subscript 2 in H2O specifies two H atoms per molecule. Moving a subscript changes the species. Cl− is a chloride ion with one negative elementary charge and one more electron than a neutral Cl atom.",
            "understandingFocusDe": "Koeffizienten, Indizes und Ladungen haben verschiedene Bedeutungen; Formeländerung ist kein zulässiges Bilanzieren.",
            "understandingFocusEn": "Coefficients, subscripts and charges have different meanings; changing a species formula is not valid balancing."
          },
          {
            "id": "systematic-name-to-fischer-alanine-underdetermined",
            "taskDemandDe": "Eingabe ist ausschließlich der systematische Name (2S)-2-Aminopropansäure, keine Raumzeichnung. Dekodiere Stamm, Positionszahlen und Aminogruppe zu Konnektivität und Fischer-Projektion. Gegebene Prioritäten am C2: NH2 = 1, COOH = 2, CH3 = 3, H = 4. Regelkarte: Im Fischer-Kreuz zeigt horizontal nach vorn, vertikal nach hinten. Setze COOH nach oben und die Seitenkette nach unten. Für R/S folgt man 1→2→3; zeigt Gruppe 4 nach vorn, wird das Uhrzeigerergebnis umgekehrt. Bei diesen 2-Aminosäuren bedeutet NH2 links L, rechts D; D/L bezeichnet kein Drehvorzeichen. Neutrale Formeln sind Darstellungshilfen. Begründe die Gruppenpositionen und zeichne das Enantiomer. Frisch: Ein zweites Etikett lautet nur „2-Aminopropansäure“ ohne Stereodeskriptor. Zeige, welche Information feststeht und warum keine einzelne Fischer-Konfiguration bestimmt ist. Unterstelle kein Racemat.",
            "taskDemandEn": "The only input is the systematic name (2S)-2-aminopropanoic acid, with no spatial drawing. Decode the parent, locants and amino group into connectivity and a Fischer projection. Given C2 priorities: NH2 = 1, COOH = 2, CH3 = 3, H = 4. Codebook: Fischer horizontal bonds point forward, vertical bonds backward. Put COOH at the top and the side chain at the bottom. For R/S, follow 1→2→3; reverse the clockwise result when group 4 points forward. For these 2-amino acids, amino left means L and right D; D/L does not specify optical rotation. Neutral formulas are representation aids. Justify group positions and draw the enantiomer. Fresh: A second label says only “2-aminopropanoic acid,” without a stereodescriptor. Show what is fixed and why no unique Fischer configuration follows. Do not assume a racemate.",
            "expectedPerformanceDe": "Propansäure ergibt die Kette COOH(C1)–C2–CH3; die Aminogruppe an C2 führt zu HOOC–CH(NH2)–CH3. Mit COOH oben und CH3 unten steht NH2 links und H rechts: 1→2→3 erscheint im Uhrzeigersinn; wegen H nach vorn wird das zu S umgekehrt. Dies ist L-Alanin; das Spiegelbild mit NH2 rechts und H links ist R/D. Ohne Stereodeskriptor ist die Konnektivität bestimmt, aber beide Fischer-Spiegelformen passen. Weder Enantiomerenreinheit noch ein Racemat folgen. Der Name steuert die selbst erstellte Projektion; kein Raumkorsett wurde vorgegeben.",
            "expectedPerformanceEn": "Propanoic acid gives COOH(C1)–C2–CH3; amino at C2 gives HOOC–CH(NH2)–CH3. With COOH at the top and CH3 at the bottom, NH2 is left and H right: 1→2→3 appears clockwise, then reverses because H points forward, giving S. This is L-alanine; the mirror with NH2 right and H left is R/D. Without a stereodescriptor, connectivity is fixed but both mirror Fischer forms fit. Neither enantiomeric purity nor a racemate follows. The name determines the independently constructed projection; no spatial arrangement was supplied.",
            "understandingFocusDe": "Namensdekodierung und stereochemische Spezifikation werden eigenständig nachgewiesen.",
            "understandingFocusEn": "Independently demonstrate name decoding and stereochemical specification."
          },
          {
            "id": "systematic-name-to-fischer-cysteine-serine-transfer",
            "taskDemandDe": "Neuer Namensinput ohne Raumzeichnung: (2R)-2-Amino-3-sulfanylpropansäure. Dekodiere Konnektivität und Seitenkette und zeichne Fischer. Gegebene Prioritäten: NH2 = 1, CH2SH = 2, COOH = 3, H = 4; der Schwefel beim nächsten Vergleich gibt CH2SH Vorrang vor COOH. Regelkarte: Horizontale Fischer-Bindungen zeigen nach vorn, vertikale nach hinten. COOH steht oben, die Seitenkette unten. Für R/S folgt man 1→2→3 und kehrt das Uhrzeigerergebnis um, wenn Gruppe 4 nach vorn zeigt. Bei diesen 2-Aminosäuren bedeutet NH2 links L, rechts D; D/L bestimmt kein Drehvorzeichen. Beurteile „R heißt immer D“. Frischer Transfer: Konstruiere aus (2S)-2-Amino-3-hydroxypropansäure die Projektion. Hier gelten NH2 = 1, COOH = 2, CH2OH = 3, H = 4. Erkläre, welche Namensbestandteile die Konnektivität und welche die räumliche Auswahl bestimmen.",
            "taskDemandEn": "Fresh name input without a spatial drawing: (2R)-2-amino-3-sulfanylpropanoic acid. Decode connectivity and side chain and draw Fischer. Given priorities: NH2 = 1, CH2SH = 2, COOH = 3, H = 4; sulfur at the next comparison places CH2SH ahead of COOH. Codebook: Horizontal Fischer bonds point forward and vertical bonds backward. Put COOH at the top and the side chain at the bottom. For R/S, follow 1→2→3 and reverse the clockwise result if group 4 points forward. For these 2-amino acids, NH2 left means L and right D; D/L does not determine optical rotation. Assess “R always means D.” Fresh transfer: Construct the projection from (2S)-2-amino-3-hydroxypropanoic acid. Here NH2 = 1, COOH = 2, CH2OH = 3, H = 4. Explain which name components fix connectivity and which specify spatial selection.",
            "expectedPerformanceDe": "Der erste Name ergibt HOOC–CH(NH2)–CH2SH. COOH oben, CH2SH unten, NH2 links und H rechts ergeben mit den gegebenen Prioritäten R: L-Cystein. R ist also kein D-Schlagwort. Serin ergibt HOOC–CH(NH2)–CH2OH; COOH oben, CH2OH unten, NH2 links und H rechts ergeben mit der anderen Prioritätsreihenfolge S/L. Stamm und Sulfanyl-/Hydroxyangabe bestimmen Konnektivität, der Stereodeskriptor die räumliche Auswahl. Beide Projektionen werden selbst konstruiert; die Regelkarte ist keine fertige Antwortzeichnung.",
            "expectedPerformanceEn": "The first name gives HOOC–CH(NH2)–CH2SH. COOH top, CH2SH bottom, NH2 left and H right give R with the supplied priorities: L-cysteine. R is therefore not a shortcut for D. Serine gives HOOC–CH(NH2)–CH2OH; COOH top, CH2OH bottom, NH2 left and H right give S/L with its different priority order. The parent and sulfanyl/hydroxy terms determine connectivity; the stereodescriptor selects the spatial configuration. Both projections are constructed independently; the codebook is not a completed answer drawing.",
            "understandingFocusDe": "Neue Seitenkette prüft Namensinterpretation und widerlegt die universelle Gleichsetzung R = D.",
            "understandingFocusEn": "A fresh side chain tests name interpretation and refutes a universal R = D shortcut."
          }
        ]
      }
    },
    {
      "goalId": "973c12d9-d863-5292-8c68-9c80cdacf9e2",
      "wholeProfile": {
        "archetype": "experiment",
        "expectations": [
          {
            "id": "structure-model-reasoning",
            "essentialUnderstandingDe": "Die Fehling-Probe nutzt die reduzierende Wirkung geeigneter Aldehyde: Kupfer(II) wird unter vorgegebenen Bedingungen zu Cu2O reduziert; einfache Ketone verhalten sich anders.",
            "essentialUnderstandingEn": "Fehling testing uses suitable aldehyde reducing activity: copper(II) is reduced to Cu2O under specified conditions; simple ketones behave differently.",
            "observablePerformanceDe": "Für den praktischen Leistungsanteil muss die Person eine tatsächlich beaufsichtigte Durchführung nach einem konkret lokal freigegebenen Lehrkraftprotokoll zeigen: freigegebene Nachweisbedingungen einhalten, Ethanal-/Propanon-Vergleich und Blindkontrolle angemessen behandeln, eigene tatsächliche Beobachtungen getrennt von der Deutung dokumentieren und Aldehydoxidation/Cu(II)-Reduktion begründen. Die beiden fiktiven Papierfälle reichen für diesen praktischen Nachweis nicht aus. Dieser Vertrag verlangt künftige beobachtbare Leistung; er behauptet keine bereits erfolgte Durchführung, menschliche Freigabe oder Erprobung.",
            "observablePerformanceEn": "For the practical performance component, the learner must show actual supervised execution following a specific locally approved teacher protocol: follow its approved test conditions, appropriately handle ethanal/propanone comparison and a blank, document their own actual observations separately from interpretation and justify aldehyde oxidation/Cu(II) reduction. The two fictional paper cases do not suffice for this practical evidence. This contract requires future observable performance; it claims no prior execution, human approval or trial."
          },
          {
            "id": "fresh-application-and-boundary",
            "essentialUnderstandingDe": "Eine positive Fehling-Probe beweist bei beliebigen Gemischen nicht eindeutig einen einfachen Aldehyd; eine Papierdeutung beweist keine tatsächlich ausgeführte Experimentierkompetenz.",
            "essentialUnderstandingEn": "A positive Fehling test in arbitrary mixtures does not uniquely prove a simple aldehyde; paper interpretation does not establish actually demonstrated experimental competence.",
            "observablePerformanceDe": "Positiv belegt hier eine reduzierende Wirkung unter den gegebenen Bedingungen, nicht die Identität Ethanal. Kontrollen und weitere selektive Information über Zusammensetzung/Struktur sind nötig; die Störstoffwarnung verhindert die eindeutige Aldehyd-Keton-Zuordnung im Gemisch. Eine bei reinen einfachen Vergleichsstoffen tragfähige Entscheidung wird nicht uneingeschränkt auf Gemische übertragen.",
            "observablePerformanceEn": "Positive testing establishes reducing activity under the stated conditions, not ethanal identity. Controls and additional selective composition/structure information are needed; the interference warning prevents unique aldehyde/ketone assignment in the mixture. A decision valid for simple pure comparison substances is not transferred unrestrictedly to mixtures."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "structure-model-reasoning",
            "fresh-application-and-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "material-variation",
            "textDe": "Bekannter Aldehyd/Keton, positive und negative Kontrollen, unbekanntes Gemisch mit vorgegebener Störstoffwarnung.",
            "textEn": "Known aldehyde/ketone, positive and negative controls, unknown mixture with a supplied interference warning."
          },
          {
            "id": "counterexample",
            "textDe": "Eine positive Fehling-Probe beweist bei beliebigen Gemischen nicht eindeutig einen einfachen Aldehyd; eine Papierdeutung beweist keine tatsächlich ausgeführte Experimentierkompetenz.",
            "textEn": "A positive Fehling test in arbitrary mixtures does not uniquely prove a simple aldehyde; paper interpretation does not establish actually demonstrated experimental competence."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-current15-973c12d9-case-1",
            "taskDemandDe": "Fiktiver schulischer Nachweisfall; für eine tatsächliche Durchführung wäre ein gesondert freigegebenes Lehrkraftprotokoll nötig. Ethanal als Positivkontrolle, Propanon als Ketonvergleich, Blindansatz. Alle Ansätze werden nach demselben Lehrkraftprotokoll behandelt. Ethanal zeigt ziegelrotes Cu2O, Propanon und Blindansatz nicht. Keine Konzentrationen, Temperaturen oder private Durchführung werden vorgegeben. Erkläre Kontrollwahl, passende Durchführung nach Freigabe und fachliche Deutung; skizziere die Oxidation des Aldehyds und Reduktion des Kupfers. Der praktische Leistungsanteil muss später gesondert als tatsächliche beaufsichtigte Durchführung nach einem konkret lokal freigegebenen Lehrkraftprotokoll mit eigenen Beobachtungen gezeigt werden; erläutere, welche eigene Ausführung und Dokumentation dafür erforderlich sind. Die hier angegebenen Papierbeobachtungen erfüllen diesen Anteil nicht.",
            "taskDemandEn": "Fictional school test case; actual execution would require a separately approved teacher protocol. Ethanal positive control, propanone ketone comparison and blank. All follow the same teacher protocol. Ethanal yields brick-red Cu2O; propanone and blank do not. No concentrations, temperatures or private procedure are supplied. Explain controls, appropriate approved execution and interpretation; sketch aldehyde oxidation and copper reduction. The practical performance component must later be shown separately through actual supervised execution of a specific locally approved teacher protocol with independently observed results; explain what own execution and documentation this requires. The supplied paper observations do not fulfil this component.",
            "expectedPerformanceDe": "Ethanal wird in alkalischem Medium zu Ethanoat oxidiert, Cu(II) zu Cu(I) im Cu2O reduziert. Der Blindansatz prüft Eigenreaktion/Kontamination; der einfache Ketonvergleich zeigt keine gleiche reduzierende Wirkung. Eine spätere tatsächliche Durchführung muss unter dem freigegebenen Lehrkraftprotokoll mit eigener Beobachtung dokumentiert werden. Für den praktischen Anteil müssen die eigene beaufsichtigte Ausführung, die angemessene Behandlung des Vergleichs und der Kontrollen sowie tatsächlich selbst dokumentierte Beobachtungen nach dem konkret lokal freigegebenen Protokoll nachgewiesen werden. Erläuterung und fiktive Papierdaten allein genügen nicht. Weder ein solches heutiges Protokoll noch eine bereits erfolgte Durchführung wird durch dieses Material behauptet.",
            "expectedPerformanceEn": "Ethanal is oxidized to ethanoate in alkaline medium, Cu(II) reduced to Cu(I) in Cu2O. The blank tests background reaction/contamination; the simple ketone control does not show the same reducing behaviour. Later actual execution must follow the approved teacher protocol and document independent observation. The practical component requires demonstrated own supervised execution, appropriate handling of the comparison and controls, and actual independently documented observations following the specific locally approved protocol. Explanation and fictional paper data alone are insufficient. This material claims neither such a currently approved protocol nor a prior actual execution.",
            "understandingFocusDe": "Die hier gelieferten fiktiven Beobachtungen ersetzen diesen praktischen Leistungsanteil nicht; kein Lernender wird als experimentell erfolgreich behauptet.",
            "understandingFocusEn": "The fictional observations do not replace the practical performance component; no learner is claimed experimentally successful."
          },
          {
            "id": "chem-current15-973c12d9-case-2",
            "taskDemandDe": "Frischer unbekannter Lebensmittelmix zeigt im fiktiven Protokoll ebenfalls Cu2O. Der Materialhinweis sagt ausdrücklich: Reduzierende Zucker und bestimmte andere Stoffe können unter Testbedingungen ebenfalls positiv reagieren. Beurteile die Schlussfolgerung, die Probe sei sicher Ethanal; formuliere einen begrenzten Befund und eine passende Kontroll-/Zusatzprüfung.",
            "taskDemandEn": "A fresh unknown food mixture also gives Cu2O in the fictional protocol. The material note explicitly states: reducing sugars and certain other substances may also test positive. Evaluate the conclusion that the sample is certainly ethanal; state a bounded finding and an appropriate control/additional test.",
            "expectedPerformanceDe": "Positiv belegt hier eine reduzierende Wirkung unter den gegebenen Bedingungen, nicht die Identität Ethanal. Kontrollen und weitere selektive Information über Zusammensetzung/Struktur sind nötig; die Störstoffwarnung verhindert die eindeutige Aldehyd-Keton-Zuordnung im Gemisch.",
            "expectedPerformanceEn": "Positive testing establishes reducing activity under the stated conditions, not ethanal identity. Controls and additional selective composition/structure information are needed; the interference warning prevents unique aldehyde/ketone assignment in the mixture.",
            "understandingFocusDe": "Eine bei reinen einfachen Vergleichsstoffen tragfähige Entscheidung wird nicht uneingeschränkt auf Gemische übertragen.",
            "understandingFocusEn": "A decision valid for simple pure comparison substances is not transferred unrestrictedly to mixtures."
          }
        ]
      }
    },
    {
      "goalId": "9b56d01e-c2d7-51d8-b78e-237592c1ed20",
      "wholeProfile": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "angle-only-increment",
            "essentialUnderstandingDe": "Gegebene EPA-Grundanordnungen liefern idealisierte Winkelreferenzen. Freie Paare begründen qualitative Abweichungen, keine exakten Messwerte. Die Molekülgestalt wird vorausgesetzt und nicht erneut abgeschlossen.",
            "essentialUnderstandingEn": "Given VSEPR domain arrangements supply idealized angle references. Lone pairs explain qualitative deviations, not exact measurements. Molecular shape is assumed rather than completed again.",
            "observablePerformanceDe": "Ordnet Referenzwinkel zu gegebenen Geometrien zu, begründet eine Winkelverkleinerung durch freie Paare und nennt die Idealisierungsgrenze. Gestaltklassifikation allein genügt nicht.",
            "observablePerformanceEn": "Assigns reference angles to given geometries, justifies compression by lone pairs and states idealization limits. Shape classification alone is insufficient."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "angle-only-increment"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "given-angle-domain",
            "textDe": "Vorgegebene lineare, planare und tetraedrische Domänen und Molekülgestalten.",
            "textEn": "Supplied linear, planar and tetrahedral domains and molecular shapes."
          },
          {
            "id": "angle-model-boundary",
            "textDe": "Freie Paare und Modellwinkel gegenüber Messbehauptungen.",
            "textEn": "Lone pairs and model angles versus measurement claims."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "epa-angle-only-tetrahedral-reference",
            "taskDemandDe": "Alle Molekülgestalten und Elektronendomänen sind bereits gegeben; ihre erneute Ableitung oder Klassifikation wird nicht geprüft. Referenz: Vier Domänen sind ideal tetraedrisch angeordnet, mit 109,5°. CH4 ist tetraedrisch ohne freie Paare; H2O ist gewinkelt bei vier Domänen und zwei freien Paaren. Ordne den idealen CH4-Winkel zu und erkläre, weshalb der H–O–H-Winkel qualitativ kleiner sein kann. Welcher exakte Messwert folgt daraus nicht? Frischer Transfer: NH3 ist als trigonal-pyramidal mit vier Domänen und einem freien Paar gegeben. Begründe die Richtung der Winkelabweichung vom Referenzwert.",
            "taskDemandEn": "All molecular shapes and electron-domain counts are supplied; their derivation or classification is not assessed again. Reference: Four domains are ideally tetrahedral, with 109.5°. CH4 is tetrahedral without lone pairs; H2O is bent with four domains and two lone pairs. Assign the ideal CH4 angle and explain why H–O–H can be smaller. What exact measured value does this not establish? Fresh transfer: NH3 is given as trigonal pyramidal with four domains and one lone pair. Justify the direction of its angle deviation from the reference.",
            "expectedPerformanceDe": "CH4 hat im idealen tetraedrischen Modell 109,5°. Im einfachen EPA-Modell beanspruchen freie Paare mehr Raum und drücken Bindungsrichtungen zusammen; der H–O–H-Winkel ist gegenüber 109,5° verkleinert. Eine exakte gemessene Winkelzahl folgt daraus nicht. Für das vorgegebene NH3-Modell wird ebenfalls eine Verkleinerung gegenüber dem tetraedrischen Referenzwinkel begründet. Gestalten nur zu benennen genügt nicht.",
            "expectedPerformanceEn": "CH4 has 109.5° in the ideal tetrahedral model. In simple VSEPR, lone pairs occupy more space and compress bond directions; H–O–H is smaller than 109.5°. This does not supply an exact measured angle. For the given NH3 model, likewise justify a reduction from the tetrahedral reference. Merely naming shapes is insufficient.",
            "understandingFocusDe": "Gefordert sind Winkelzuordnung, begründete Abweichung und Modellgrenze. Alle Gestalten sind Eingabedaten.",
            "understandingFocusEn": "The performance is angle assignment, justified deviation and model limits. All shapes are input data."
          },
          {
            "id": "epa-angle-only-linear-planar-transfer",
            "taskDemandDe": "Gegebene Referenzen: linear 180°, trigonal-planar 120°, tetraedrische Domänen 109,5°. CO2 ist linear mit zwei Domänen am C; BH3 ist trigonal-planar mit drei Domänen am B; NH3 ist trigonal-pyramidal mit vier Domänen einschließlich eines freien Paars. Die Formen werden nicht erneut abgefragt. Ordne ideale Winkel zu, begründe, weshalb drei Bindungen bei BH3 und NH3 keine gleichen Winkel erzwingen, und prüfe: „EPA liefert für jedes Molekül den exakten gemessenen Winkel.“ Frische Variation: Eine Messung weicht vom idealen Referenzwinkel ab. Erkläre, weshalb weder Messung noch gesamtes Modell ohne weitere Prüfung verworfen werden dürfen.",
            "taskDemandEn": "Given references: linear 180°, trigonal planar 120°, tetrahedral domains 109.5°. CO2 is linear with two central-carbon domains; BH3 is trigonal planar with three boron domains; NH3 is trigonal pyramidal with four domains including one lone pair. Shapes are not assessed again. Assign ideal angles, explain why three bonds in BH3 and NH3 do not require equal angles, and assess: “VSEPR gives the exact measured angle for every molecule.” Fresh variation: A measurement differs from the ideal reference. Explain why neither the measurement nor the entire model should be discarded without further checks.",
            "expectedPerformanceDe": "CO2 gehört zum linearen 180°- und BH3 zum planaren 120°-Referenzwinkel. NH3 hat tetraedrische Domänen mit 109,5° als Ausgangsideal und einer freipaarbedingten Verkleinerung. Drei Bindungen machen NH3 nicht zu einem 120°-Fall. EPA ist ein idealisierendes Modell; Bedingungen, weitere Einflüsse und Messunsicherheit müssen geprüft werden. Eine Abweichung allein beweist weder einen Messfehler noch ein vollständiges Modellversagen.",
            "expectedPerformanceEn": "CO2 uses the linear 180° reference and BH3 the planar 120° reference. NH3 has tetrahedral domains with 109.5° as baseline and lone-pair compression. Three bonds do not make NH3 a 120° case. VSEPR is an idealized model; conditions, further influences and measurement uncertainty require checks. Deviation alone proves neither measurement error nor complete model failure.",
            "understandingFocusDe": "Frischer Winkelvergleich ohne wiederholte Gestaltklassifikation.",
            "understandingFocusEn": "A fresh angle comparison without repeated shape classification."
          }
        ]
      }
    },
    {
      "goalId": "9b5d6326-d27c-4ece-8c72-debda705464a",
      "wholeProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "core-understanding",
            "essentialUnderstandingDe": "Daltons Atomhypothese ist eine erklärende Modellannahme über Atome und ihre Umgruppierung. Ein Gesetz beschreibt empirische Regelmäßigkeiten, eine Hypothese ist prüfbar und vorläufig; spätere Atomkenntnisse begrenzen einzelne Annahmen, nicht die Nutzbarkeit chemischer Atom-Bilanzen.",
            "essentialUnderstandingEn": "Dalton’s atomic hypothesis is an explanatory assumption about atoms and rearrangement. A law describes empirical regularities and a hypothesis is testable and provisional; later atomic knowledge limits individual assumptions, not the usefulness of chemical atom balances.",
            "observablePerformanceDe": "18,00 g Produktmasse ist die Beobachtung. Massenerhaltung fasst solche Messbefunde als empirische Regelmäßigkeit für das geschlossene chemische System zusammen. Die Atomhypothese erklärt sie durch Erhaltung und Umgruppierung der Atome: links und rechts vier H- und zwei O-Atome. Wasser ist eine Verbindung, kein bloßes Gemisch der Ausgangsgase. Ein passender Befund stützt das Modell, beweist aber nicht alle Annahmen endgültig; neue unabhängige Befunde können Grenzen zeigen. Gesetz und erklärendes Teilchenmodell sind unterschiedliche Aussagen.",
            "observablePerformanceEn": "The observed product mass is 18.00 g. Mass conservation summarizes such measurements as an empirical regularity for the closed chemical system. The atomic hypothesis explains it by conservation and rearrangement: four H and two O atoms on each side. Water is a compound, not merely a mixture of the original gases. A compatible finding supports the model but does not definitively establish all assumptions; new independent evidence can reveal limits. A law and an explanatory particle model are distinct kinds of statement."
          },
          {
            "id": "fresh-transfer-and-limit",
            "essentialUnderstandingDe": "Massenerhaltung bei geschlossener Reaktion gegenüber Isotopen und subatomarer Struktur als Grenzen historischer Modellannahmen. Isotope ändern nicht die Elementzugehörigkeit; die chemische Modellgrenze wird nicht auf Kernreaktionen ausgedehnt.",
            "essentialUnderstandingEn": "Mass conservation in a closed reaction versus isotopes and subatomic structure as limits of historical assumptions. Isotopes do not change element identity; the chemical model is not extended to nuclear reactions.",
            "observablePerformanceDe": "Die historische Vorstellung gleicher Masse aller Atome eines Elements ist wegen Isotopen begrenzt; auch Atome sind nicht strukturlose unteilbare Kugeln, sondern enthalten subatomare Bestandteile. Die Elementidentität folgt heute der Protonenzahl. Für gewöhnliche chemische Reaktionen bleibt die Erhaltung und Umgruppierung der Atome ein tragfähiges Bilanzmodell. Eine konkrete Vermutung über die Elektronenanordnung ist eine prüfbare Hypothese, kein schon bestätigtes Gesetz. Ein Modell kann trotz korrigierter Einzelannahmen in einem begrenzten Anwendungsbereich nützlich bleiben.",
            "observablePerformanceEn": "The historical assumption that all atoms of one element have identical mass is limited by isotopes; atoms are not structureless indivisible spheres but contain subatomic constituents. Element identity is tied to proton number. Conservation and rearrangement remain useful balance models for ordinary chemical reactions. A concrete proposed electron arrangement is a testable hypothesis, not an established law. A model can remain useful in a bounded application despite corrected assumptions."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "core-understanding",
            "fresh-transfer-and-limit"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "specific-system-variation",
            "textDe": "Massenerhaltung bei geschlossener Reaktion gegenüber Isotopen und subatomarer Struktur als Grenzen historischer Modellannahmen.",
            "textEn": "Mass conservation in a closed reaction versus isotopes and subatomic structure as limits of historical assumptions."
          },
          {
            "id": "model-boundary",
            "textDe": "Isotope ändern nicht die Elementzugehörigkeit; die chemische Modellgrenze wird nicht auf Kernreaktionen ausgedehnt.",
            "textEn": "Isotopes do not change element identity; the chemical model is not extended to nuclear reactions."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-next20-9b5d6326-case-1",
            "taskDemandDe": "Fiktiver Versuch: In einem geschlossenen Gefäß reagieren 2,00 g H2 mit 16,00 g O2 vollständig zu 18,00 g Wasser; äußerer Stoffaustausch ist ausgeschlossen. Dalton-Modellannahmen: Stoffe bestehen aus Atomen, bei chemischen Reaktionen werden diese nicht vernichtet, sondern neu angeordnet. Die Formel von Wasser ist H2O. Trenne Beobachtung, Massenerhaltungsgesetz und Atomhypothese. Erkläre die Reaktion mit 2 H2 + O2 → 2 H2O und beurteile, ob ein passender Versuch die Hypothese endgültig beweist.",
            "taskDemandEn": "Fictional experiment: in a closed container 2.00 g H2 reacts completely with 16.00 g O2 to give 18.00 g water; external matter exchange is excluded. Dalton assumptions: substances consist of atoms that are rearranged rather than destroyed in chemical reactions. Water has formula H2O. Distinguish observation, the mass-conservation law and the atomic hypothesis. Explain 2 H2 + O2 → 2 H2O and assess whether one compatible experiment proves the hypothesis definitively.",
            "expectedPerformanceDe": "18,00 g Produktmasse ist die Beobachtung. Massenerhaltung fasst solche Messbefunde als empirische Regelmäßigkeit für das geschlossene chemische System zusammen. Die Atomhypothese erklärt sie durch Erhaltung und Umgruppierung der Atome: links und rechts vier H- und zwei O-Atome. Wasser ist eine Verbindung, kein bloßes Gemisch der Ausgangsgase. Ein passender Befund stützt das Modell, beweist aber nicht alle Annahmen endgültig; neue unabhängige Befunde können Grenzen zeigen. Gesetz und erklärendes Teilchenmodell sind unterschiedliche Aussagen.",
            "expectedPerformanceEn": "The observed product mass is 18.00 g. Mass conservation summarizes such measurements as an empirical regularity for the closed chemical system. The atomic hypothesis explains it by conservation and rearrangement: four H and two O atoms on each side. Water is a compound, not merely a mixture of the original gases. A compatible finding supports the model but does not definitively establish all assumptions; new independent evidence can reveal limits. A law and an explanatory particle model are distinct kinds of statement.",
            "understandingFocusDe": "Die Massenerhaltung bei diesen chemischen Reaktionen ist keine Aussage, dass Atome physikalisch unteilbar sind.",
            "understandingFocusEn": "Mass conservation in these chemical reactions does not imply that atoms are physically indivisible."
          },
          {
            "id": "chem-next20-9b5d6326-case-2",
            "taskDemandDe": "Frischer Befundsatz: Chloratome mit derselben Protonenzahl besitzen unterschiedliche Neutronenzahlen und Massen. Elektronen lassen sich als Bestandteile von Atomen nachweisen. Chemische Reaktionsbilanzen zeigen weiterhin die Erhaltung der Anzahl der Atome jedes Elements. Kernreaktionen werden nicht betrachtet. Benenne zwei Grenzen von Daltons historischem Modell und erkläre, warum die Umgruppierungsidee weiterhin zur Darstellung chemischer Reaktionen taugt. Ordne eine neue Vermutung zum Elektronenaufbau als Hypothese ein.",
            "taskDemandEn": "Fresh evidence: chlorine atoms with the same proton number have different neutron numbers and masses. Electrons are detectable components of atoms. Chemical reaction balances still show conservation of each element’s atom count. Nuclear reactions are excluded. Identify two limitations of Dalton’s historical model and explain why rearrangement still represents chemical reactions usefully. Classify a new proposed electronic structure as a hypothesis.",
            "expectedPerformanceDe": "Die historische Vorstellung gleicher Masse aller Atome eines Elements ist wegen Isotopen begrenzt; auch Atome sind nicht strukturlose unteilbare Kugeln, sondern enthalten subatomare Bestandteile. Die Elementidentität folgt heute der Protonenzahl. Für gewöhnliche chemische Reaktionen bleibt die Erhaltung und Umgruppierung der Atome ein tragfähiges Bilanzmodell. Eine konkrete Vermutung über die Elektronenanordnung ist eine prüfbare Hypothese, kein schon bestätigtes Gesetz. Ein Modell kann trotz korrigierter Einzelannahmen in einem begrenzten Anwendungsbereich nützlich bleiben.",
            "expectedPerformanceEn": "The historical assumption that all atoms of one element have identical mass is limited by isotopes; atoms are not structureless indivisible spheres but contain subatomic constituents. Element identity is tied to proton number. Conservation and rearrangement remain useful balance models for ordinary chemical reactions. A concrete proposed electron arrangement is a testable hypothesis, not an established law. A model can remain useful in a bounded application despite corrected assumptions.",
            "understandingFocusDe": "Isotope ändern nicht die Elementzugehörigkeit; die chemische Modellgrenze wird nicht auf Kernreaktionen ausgedehnt.",
            "understandingFocusEn": "Isotopes do not change element identity; the chemical model is not extended to nuclear reactions."
          }
        ]
      }
    },
    {
      "goalId": "9fc800d1-92d1-5ef6-81c1-33960ae034dd",
      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "traceable-record",
            "essentialUnderstandingDe": "Dokumentation bewahrt Rohwerte und Zuordnung zu Quelle, Probe, Größe, Einheit und Bedingung; fehlende Angaben bleiben als fehlend sichtbar.",
            "essentialUnderstandingEn": "Documentation preserves raw values and links to source, sample, quantity, unit and condition; missing entries remain visibly missing.",
            "observablePerformanceDe": "Eigenständig R1 als strukturierte Tabelle und R2 als getrenntes Ereignis erfassen; keine nachträgliche Temperaturbestätigung oder eigene Messung erfinden.",
            "observablePerformanceEn": "Independently record R1 as a structured table and R2 as a separate event; invent neither retrospective temperature confirmation nor own measurement."
          },
          {
            "id": "observation-interpretation",
            "essentialUnderstandingDe": "Eine Beobachtung bzw. gemeldeter Rohwert unterscheidet sich von einer Modellinterpretation oder berechneten Konzentration.",
            "essentialUnderstandingEn": "An observation or reported raw value differs from a model interpretation or calculated concentration.",
            "observablePerformanceDe": "Beobachtung des Endpunkts und Teilchenerklärung getrennt kennzeichnen; Absorbanzrohdaten, Rechnung, Verdünnung und Konzentration mit Einheiten unterscheiden.",
            "observablePerformanceEn": "Distinguish endpoint observation from particle explanation; separate raw absorbance, calculation, dilution and concentration with units."
          },
          {
            "id": "auditable-change",
            "essentialUnderstandingDe": "Neue Ereignisse und korrigierte Rechenannahmen müssen mit unveränderter Rohbasis und nachvollziehbarer Versionierung dokumentiert werden.",
            "essentialUnderstandingEn": "New events and corrected calculation assumptions need unchanged raw data and traceable versioning.",
            "observablePerformanceDe": "Eigenes Dokumentations-/Rechenprodukt mit Formel und Herkunft abgeben; Faktor-2-/Faktor-4-Rechnung und Änderungshistorie mit nicht gelieferten Metadaten als fehlend festhalten.",
            "observablePerformanceEn": "Submit an own documentation/calculation artifact with formula and provenance; retain factor-2/factor-4 calculations and audit history, marking absent metadata as missing."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "traceable-record",
            "observation-interpretation",
            "auditable-change"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "changed-condition",
            "textDe": "Neue fallgebundene Bedingung/Hypothesenprüfung und eigene begründete Revision statt bloßem Zahlentausch.",
            "textEn": "Fresh case-specific condition/hypothesis check and own reasoned revision rather than mere number substitution."
          },
          {
            "id": "source-and-limit",
            "textDe": "BY C8: Dokumentation nach Anleitung. BY C9 Nicht-NTG (HG, SG, MuG, WWG, SWG): Dokumentation, Auswertung und Veranschaulichung strukturiert nach Anleitung. BY C9 NTG: bei bekannten Sachverhalten selbständig, bei unbekannten mit Hilfestellung. BY C10: selbstständige Dokumentation gemäß der jeweiligen vollständigen Quelle. Eine angeleitete Quellenteilkompetenz ist kein Nachweis der ganzen selbstständigen kanonischen Kompetenz. Digitale Erfassung und Tabellen sind schon in Sek I möglich; tatsächliche eigene Durchführung, digitale Messwerterfassung und die ursprünglichen Partnerpflichten bleiben bei ihrer jeweiligen Quelle offen, wenn nur vorgegebene Daten dokumentiert werden.",
            "textEn": "BY C8: documentation with guidance. BY C9 non-NTG (HG, SG, MuG, WWG, SWG): structured documentation, evaluation and illustration with guidance. BY C9 NTG: independently for familiar subject matter, with assistance for unfamiliar subject matter. BY C10: independent documentation according to the respective whole source. A guided source component does not demonstrate the entire independent canonical competence. Digital acquisition and spreadsheets may already occur in lower secondary; actual own execution, digital measurement acquisition and the original partner obligations remain open for their respective source when only supplied data are documented."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "data-documentation-raw-dissolution",
            "taskDemandDe": "Erzeuge aus R1 ein nachvollziehbares Protokoll mit Tabelle, Einheiten, Herkunft, Bedingungen und Fehlstellen; trenne Beobachtung von Deutung. Neue Variation: Separat bereitgestellte Zusatznotiz R2 (ebenfalls ein fiktiver SkillPilot-Lehrdatensatz, keine echte Messung): Am 7. Oktober 2026 um 10:15 Uhr wird ein neuer unabhängiger Ansatz W3 geprüft, Beobachter N, Thermometer TH1 mit 0,1-°C-Anzeige, Wassertemperatur 20,3 °C vor Zuckerzugabe. Ergänze diese Notiz mit Herkunft R2, Zeitpunkt, neuem Probenbezug und Messbedingung als separates Ereignis. Lass die alte R1-Tabelle unverändert; R2 bestätigt weder nachträglich Temperaturen der alten Proben noch eine eigene Durchführung. Eine echte neue Messung darf nur mit eigenem tatsächlich beobachtetem Ansatz, Gerät und Log als solche ergänzt werden.",
            "taskDemandEn": "Create a traceable record from R1 with table, units, origin, conditions and missing fields; distinguish observation from interpretation. Fresh variation: Separately supplied note R2 (also a fictional SkillPilot teaching dataset, not a real measurement): On 7 October 2026 at 10:15 a new independent sample W3 is checked, observer N, thermometer TH1 with 0.1-°C display resolution, water temperature 20.3 °C before sugar addition. Append this note as a separate event with R2 provenance, time, new sample identity and measurement condition. Preserve the old R1 table; R2 neither retrospectively verifies old sample temperatures nor records own execution. An actual new measurement may only be appended as such for an own genuinely observed sample, instrument and log.",
            "expectedPerformanceDe": "Tabelle enthält alle vier Proben mit T/°C und t/s unverändert; Herkunft R1/SkillPilot-Lehrdatensatz, Beobachter M, Datum „nicht angegeben“. Festbedingungen Masse/Volumen/Rührweise/Endpunkt separat. Blase und Kristall-Endpunkt sind Beobachtungs-/Verfahrenseinträge; Teilchenbewegung ist eine Modell-Deutung. Kein Datum und keine eigenen Messwerte ergänzen. Transfer: Neuer separater R2-Eintrag: Ansatz W3; Herkunft fiktive Zusatznotiz R2; Datum 07.10.2026, 10:15 Uhr; Beobachter N; Gerät TH1, Anzeigeauflösung 0,1 °C; gemeldete Wassertemperatur 20,3 °C vor Zuckerzugabe. Die Anzeigeauflösung ist keine belegte Messunsicherheit. Auflösezeit, Zuckermasse und Rührbedingungen W3 sind in R2 nicht mitgeliefert und bleiben fehlend. R1-Zeilen bleiben unverändert und undatiert. R2 ist ein neues Ereignis, keine Bestätigung alter Temperaturen oder eigener Durchführung.",
            "expectedPerformanceEn": "The table retains all four samples with T/°C and t/s; origin R1/SkillPilot teaching dataset, observer M, date “not supplied”. Fixed mass/volume/stirring/endpoint are separate. Bubble and crystal endpoint are observation/method entries; particle motion is a model interpretation. Do not invent a date or own measurements. Transfer: New separate R2 record: batch W3; provenance fictional supplementary note R2; date 7 October 2026, 10:15; observer N; instrument TH1, display resolution 0.1 °C; reported water temperature 20.3 °C before sugar addition. Display resolution is not an established measurement uncertainty. W3 dissolution time, sugar mass and stirring conditions are absent from R2 and remain missing. R1 rows remain unchanged and undated. R2 is a new event, not confirmation of old temperatures or of own experimental execution.",
            "understandingFocusDe": "Die lernende Person kann experimentell erhobene oder recherchierte chemische Daten strukturiert und nachvollziehbar dokumentieren, Größen und Einheiten, Herkunft und relevante Untersuchungsbedingungen angeben sowie beobachtende Beschreibung und deutende Erklärung unterscheiden. Eigene unabhängige Begründung und tatsächliches gefordertes Leistungsprodukt, keine Wiedergabe der Musterlösung.",
            "understandingFocusEn": "The learner can document experimental or researched chemical data in a structured and transparent way, identify quantities, units, provenance, and relevant investigation conditions, and distinguish descriptive observation from explanatory interpretation. Own independent reasoning and the actually required performance artifact, not recitation of the worked answer."
          },
          {
            "id": "data-documentation-research-calibration",
            "taskDemandDe": "Dokumentiere recherchierte Kalibrations- und Probendaten getrennt mit Quelle/Version, Einheiten und Verdünnungskette; kennzeichne später berechnete Ergebnisse als Berechnung. Neue Variation: Dokumentiere eine nachträgliche Korrektur von „1:2“ auf „1:4“ mit Änderungshistorie und betroffenem Rechenergebnis.",
            "taskDemandEn": "Document researched calibration and sample data separately with source/version, units and dilution chain; mark subsequently calculated results as calculations. Fresh variation: Document a later correction from “1:2” to “1:4” with change history and affected calculated result.",
            "expectedPerformanceDe": "Original A-Werte bleiben dimensionslos; c in mg/L. U7 → Verdünnung 1:2 → U-Messungen ist sichtbar. Mittelwert 0,290 und rückgerechnete ursprüngliche 7,00 mg/L werden in einem Berechnungsabschnitt mit Kalibration vermerkt, nicht als ursprünglich gemessene Konzentration. Quellenangabe D2/SkillPilot/v1, Gerät und Bedingungen stehen im Kopf. Transfer: A-Mittelwert 0,290 und Steigung 0,080 L/mg bleiben unverändert. Die verdünnte Probe ergibt (0,290−0,010)/0,080 = 3,50 mg/L. Alte Rechnung: Faktor 2 → 7,00 mg/L. Korrigierte Rechnung: Faktor 4 → 14,00 mg/L für die ursprüngliche Probe. Im Änderungsprotokoll alte/neue Verdünnungsangabe, Korrekturherkunft, betroffene U7-Rechnung und zwei Versionen getrennt notieren. Zeitpunkt/Autor der Korrektur sind nicht geliefert und werden nicht erfunden. Rohabsorbanzdaten werden nicht geändert; keine Konzentration wurde neu gemessen.",
            "expectedPerformanceEn": "Original A values remain dimensionless; c is in mg/L. U7 → 1:2 dilution → U measurements is visible. Mean 0.290 and back-calculated original 7.00 mg/L are entered in a calculation section with the calibration, not as an originally measured concentration. D2/SkillPilot/v1, instrument and conditions appear in the header. Transfer: Mean absorbance 0.290 and slope 0.080 L/mg remain unchanged. The diluted sample gives (0.290−0.010)/0.080 = 3.50 mg/L. Previous calculation: factor 2 → 7.00 mg/L. Corrected calculation: factor 4 → 14.00 mg/L for the original sample. In the change log distinguish old/new dilution statements, provenance of the correction, the affected U7 calculation and the two versions. The correction time/author are absent and are not invented. Raw absorbance data are unchanged; no concentration was newly measured.",
            "understandingFocusDe": "Die lernende Person kann experimentell erhobene oder recherchierte chemische Daten strukturiert und nachvollziehbar dokumentieren, Größen und Einheiten, Herkunft und relevante Untersuchungsbedingungen angeben sowie beobachtende Beschreibung und deutende Erklärung unterscheiden. Eigene unabhängige Begründung und tatsächliches gefordertes Leistungsprodukt, keine Wiedergabe der Musterlösung.",
            "understandingFocusEn": "The learner can document experimental or researched chemical data in a structured and transparent way, identify quantities, units, provenance, and relevant investigation conditions, and distinguish descriptive observation from explanatory interpretation. Own independent reasoning and the actually required performance artifact, not recitation of the worked answer."
          }
        ]
      }
    },
    {
      "goalId": "a1632ea9-ca04-4f6a-bed2-06b3aa8d38ca",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "content-specific-understanding",
            "essentialUnderstandingDe": "Bei der Bildung einfacher Hauptgruppen-Ionen ändert sich die Elektronenzahl, nicht der Kern; Elektronenabgabe erzeugt positive und Aufnahme negative Ladung. Eine Edelgaskonfiguration ist ein begrenztes Erklärungsmodell.",
            "essentialUnderstandingEn": "Formation of simple main-group ions changes electron number, not the nucleus; electron loss gives positive and gain negative charge. Noble-gas configuration is a bounded explanatory model.",
            "observablePerformanceDe": "Na+ besitzt11 Protonen/10 Elektronen,2|8 wie Ne; Cl−17/18,2|8|8 wie Ar. Kern und Element bleiben erhalten. Die unterschiedlichen Ladungsvorzeichen folgen dem Protonen-Elektronen-Unterschied.",
            "observablePerformanceEn": "Na+ has11 protons/10 electrons,2|8 like Ne; Cl−17/18,2|8|8 like Ar. Nucleus and element remain unchanged. Charge signs follow the proton–electron difference."
          },
          {
            "id": "fresh-transfer-and-model-boundary",
            "essentialUnderstandingDe": "Die Edelgasregel liefert hier einen plausiblen Ionenfall, keine universelle Vorhersage aller Übergangsmetall-Ionen oder Reaktionsenergien.",
            "essentialUnderstandingEn": "Here the noble-gas rule supplies a plausible ion case, not a universal prediction of transition-metal ions or reaction energies.",
            "observablePerformanceDe": "Mg→Mg2++2e−; O+2e−→O2−. Beide2|8, jedoch12 bzw.8 Protonen. Die Person bilanziert Atome, Elektronen und Ladung und benennt die Hauptgruppen-Grenze.",
            "observablePerformanceEn": "Mg→Mg2++2e−; O+2e−→O2−. Both2|8, but12 versus8 protons. The learner balances atoms, electrons and charge and states the main-group limit."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "content-specific-understanding",
            "fresh-transfer-and-model-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "specific-material-variation",
            "textDe": "Na/Cl gegenüber Mg/O; Elektronenzahl, Kernladung und vollständige Außenschale.",
            "textEn": "Na/Cl versus Mg/O; electron number, nuclear charge and a complete outer shell."
          },
          {
            "id": "specific-model-limit",
            "textDe": "Die Edelgasregel liefert hier einen plausiblen Ionenfall, keine universelle Vorhersage aller Übergangsmetall-Ionen oder Reaktionsenergien.",
            "textEn": "Here the noble-gas rule supplies a plausible ion case, not a universal prediction of transition-metal ions or reaction energies."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-next25-a1632ea9-case-1",
            "taskDemandDe": "Na:11 Protonen, Elektronen2|8|1; Cl:17 Protonen,2|8|7. Gegeben sind Na→Na++e− und Cl+e−→Cl− als Teilgleichungen. Leite für beide Ionen Elektronenzahl, Schalenbelegung und Ladung her und erkläre Kation/Anion mit der Edelgasregel.",
            "taskDemandEn": "Na:11 protons, electrons2|8|1; Cl:17 protons,2|8|7. Na→Na++e− and Cl+e−→Cl− are supplied half-equations. Derive each ion’s electron number, shell occupancy and charge; explain cation/anion using the noble-gas rule.",
            "expectedPerformanceDe": "Na+ besitzt11 Protonen/10 Elektronen,2|8 wie Ne; Cl−17/18,2|8|8 wie Ar. Kern und Element bleiben erhalten. Die unterschiedlichen Ladungsvorzeichen folgen dem Protonen-Elektronen-Unterschied.",
            "expectedPerformanceEn": "Na+ has11 protons/10 electrons,2|8 like Ne; Cl−17/18,2|8|8 like Ar. Nucleus and element remain unchanged. Charge signs follow the proton–electron difference.",
            "understandingFocusDe": "Elektronenverlust macht Natrium nicht zum Element Neon; gleiche Elektronenkonfiguration ist nicht gleiche Kernladung.",
            "understandingFocusEn": "Electron loss does not turn sodium into neon; identical electron configuration does not mean identical nuclear charge."
          },
          {
            "id": "chem-next25-a1632ea9-case-2",
            "taskDemandDe": "Frischer Hauptgruppenfall: Mg12 Protonen,2|8|2; O8 Protonen,2|6. Nur einfache Atom-Ionen im schulischen Edelgasmodell werden betrachtet. Formuliere Elektronenabgabe/-aufnahme und erkläre, warum Mg2+ und O2− jeweils10 Elektronen haben, obwohl ihre Ladung verschieden ist.",
            "taskDemandEn": "Fresh main-group case: Mg12 protons,2|8|2; O8 protons,2|6. Only simple atomic ions in the school noble-gas model are considered. Write electron loss/gain and explain why Mg2+ and O2− each have10 electrons despite different charges.",
            "expectedPerformanceDe": "Mg→Mg2++2e−; O+2e−→O2−. Beide2|8, jedoch12 bzw.8 Protonen. Die Person bilanziert Atome, Elektronen und Ladung und benennt die Hauptgruppen-Grenze.",
            "expectedPerformanceEn": "Mg→Mg2++2e−; O+2e−→O2−. Both2|8, but12 versus8 protons. The learner balances atoms, electrons and charge and states the main-group limit.",
            "understandingFocusDe": "Die Edelgasregel liefert hier einen plausiblen Ionenfall, keine universelle Vorhersage aller Übergangsmetall-Ionen oder Reaktionsenergien.",
            "understandingFocusEn": "Here the noble-gas rule supplies a plausible ion case, not a universal prediction of transition-metal ions or reaction energies."
          }
        ]
      }
    },
    {
      "goalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "b005-e0d05c36-core",
            "essentialUnderstandingDe": "Eine bestimmte reine Verbindung hat unabhängig von der hergestellten Produktmenge ein konstantes Massenverhältnis ihrer Elemente. Mehr vorgelegtes Edukt kann unverbraucht bleiben; es ändert nicht die Zusammensetzung desselben Produkts.",
            "essentialUnderstandingEn": "A given pure compound has a constant mass ratio of its elements regardless of product amount. Extra reactant may remain unreacted; it does not change the composition of the same product.",
            "observablePerformanceDe": "Die lernende Person normalisiert zwei Produktmassen-Datensätze und erklärt, warum ein dritter Ansatz mit Eduktüberschuss kein anderes Verhältnis im reinen Produkt belegt.",
            "observablePerformanceEn": "The learner normalizes two product-mass data sets and explains why a third preparation with excess reactant does not establish a new ratio in the pure product."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b005-e0d05c36-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "compound",
            "textDe": "Oxid und Sulfid werden mit verschiedenen Zahlenverhältnissen verglichen.",
            "textEn": "Oxide and sulfide are compared with different numerical ratios."
          },
          {
            "id": "excess",
            "textDe": "Vollständige Umsetzung und unverbrauchter Eduktüberschuss werden getrennt.",
            "textEn": "Complete use and leftover reactant are distinguished."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "copper-oxide-ratio",
            "taskDemandDe": "Zwei Messreihen zu reinem CuO liefern 4,0 g Cu + 1,0 g O → 5,0 g CuO und 8,0 g Cu + 2,0 g O → 10,0 g CuO. Beschreibe das konstante Massenverhältnis; benutze keine Daten aus dem MgO-Bild.",
            "taskDemandEn": "Two data sets for pure CuO give 4.0 g Cu + 1.0 g O → 5.0 g CuO and 8.0 g Cu + 2.0 g O → 10.0 g CuO. Describe the constant mass ratio without using the MgO image.",
            "expectedPerformanceDe": "Die lernende Person erhält Cu:O = 4:1 in beiden Produkten und erklärt, dass verdoppelte Produktmenge nicht die Zusammensetzung ändert.",
            "expectedPerformanceEn": "The learner obtains Cu:O = 4:1 in both products and explains that doubling product mass does not change composition.",
            "understandingFocusDe": "Neues Oxid prüft normierte Verhältnisdeutung.",
            "understandingFocusEn": "A fresh oxide tests normalized ratio reasoning."
          },
          {
            "id": "fresh-iron-sulfide-excess",
            "taskDemandDe": "Bei reiner FeS-Bildung reagieren 7,0 g Fe mit 4,0 g S zu 11,0 g FeS. Ein neuer Ansatz verwendet 14,0 g Fe und 4,0 g S; die Lehrkraft protokolliert 11,0 g FeS und 7,0 g unverbrauchtes Fe. Erkläre Produktverhältnis und Rest.",
            "taskDemandEn": "Pure FeS forms from 7.0 g Fe and 4.0 g S to give 11.0 g FeS. A fresh preparation uses 14.0 g Fe and 4.0 g S; the teacher reports 11.0 g FeS and 7.0 g unreacted Fe. Explain product ratio and residue.",
            "expectedPerformanceDe": "Die lernende Person erhält Fe:S = 7:4 für FeS, erkennt Eisenüberschuss und rechnet nicht die gesamte vorgelegte Eisenmasse in die Produktzusammensetzung hinein.",
            "expectedPerformanceEn": "The learner obtains Fe:S = 7:4 for FeS, identifies excess iron and does not count all supplied iron as part of the product.",
            "understandingFocusDe": "Sulfid-Transfer trennt Eduktansatz und Produktzusammensetzung.",
            "understandingFocusEn": "Sulfide transfer separates starting mixture from product composition."
          }
        ]
      }
    },
    {
      "goalId": "e7c363d4-e02d-4895-8750-ba62c2eb63fe",
      "wholeProfile": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "b005-e7c363d4-core",
            "essentialUnderstandingDe": "Elementsymbole bezeichnen Atomsorten; eine Molekülformel legt Art und Anzahl der Atome in einem Molekül fest. Indizes zählen Atome pro Molekül, Koeffizienten vervielfachen ganze Teilchen; Groß- und Kleinschreibung ändern Symbole.",
            "essentialUnderstandingEn": "Element symbols identify atom types; a molecular formula fixes the types and numbers of atoms in one molecule. Subscripts count atoms per molecule, coefficients multiply whole particles; capitalization changes symbols.",
            "observablePerformanceDe": "Die lernende Person liest neue Symbol-/Formelpaare, bildet aus einem Teilchenbild die Formel und korrigiert eine Verwechslung von Index und Koeffizient.",
            "observablePerformanceEn": "The learner reads fresh symbol/formula pairs, forms a formula from a particle diagram and corrects a subscript/coefficient mix-up."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b005-e7c363d4-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "direction",
            "textDe": "Formel→Teilchenzahl und Teilchenbild→Formel werden gewechselt.",
            "textEn": "Formula-to-particle count and particle-diagram-to-formula directions alternate."
          },
          {
            "id": "notation",
            "textDe": "Elementschreibweise, Index und Koeffizient werden variiert.",
            "textEn": "Element case, subscript and coefficient are varied."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "ammonia-particle-cards",
            "taskDemandDe": "Neue Karten zeigen einzelne N- und H-Atome sowie ein Teilchen mit einem N- und drei H-Atomen. Schreibe die einfache Molekülformel und erkläre den Unterschied zwischen N, H und NH3.",
            "taskDemandEn": "Fresh cards show separate N and H atoms and a particle with one N and three H atoms. Write its simple molecular formula and explain N, H and NH3.",
            "expectedPerformanceDe": "Die lernende Person schreibt NH3, zählt ein N und drei H pro Molekül und liest N/H als Elementsymbole; sie schreibt nicht N3H wegen drei H-Atomen.",
            "expectedPerformanceEn": "The learner writes NH3, counts one N and three H per molecule and reads N/H as element symbols; they do not write N3H because of the three H atoms.",
            "understandingFocusDe": "Neues Molekül prüft Formeln aus Teilchenbildern.",
            "understandingFocusEn": "A fresh molecule tests deriving formulas from particles."
          },
          {
            "id": "fresh-carbon-monoxide-vs-two",
            "taskDemandDe": "Eine neue Zeichnung zeigt zwei getrennte CO-Moleküle, eine andere ein einzelnes CO2-Molekül. Schreibe zu beiden die passende Notation und begründe die unterschiedlichen Atomzahlen.",
            "taskDemandEn": "A fresh drawing shows two separate CO molecules and another shows one CO2 molecule. Write the correct notation for each and explain the different atom counts.",
            "expectedPerformanceDe": "Die lernende Person schreibt 2 CO gegenüber CO2, zählt im ersten Fall zwei C und zwei O insgesamt, im zweiten ein C und zwei O in einem Molekül und ändert keine Elementsymbol-Großschreibung.",
            "expectedPerformanceEn": "The learner writes 2 CO versus CO2, counts two C and two O in total for the first, one C and two O in one molecule for the second, and preserves element-symbol capitalization.",
            "understandingFocusDe": "Index und Koeffizient liefern verschiedene Teilchenstrukturen.",
            "understandingFocusEn": "Subscript and coefficient specify different particle structures."
          }
        ]
      }
    },
    {
      "goalId": "e9d74940-1e0e-4511-9718-4851f49ad7a5",
      "wholeProfile": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "b006-e9d74940-core",
            "essentialUnderstandingDe": "Die Ordnungszahl ist die Protonenzahl eines Atoms; im neutralen Atom entspricht sie auch der Elektronenzahl. Bei einfachen Hauptgruppenatomen deuten Hauptgruppe und Periode auf die Zahl der Außenelektronen und besetzten Schalen.",
            "essentialUnderstandingEn": "Atomic number is an atom’s proton count; in a neutral atom it also equals electron count. For simple main-group atoms, group and period indicate outer-electron and occupied-shell counts.",
            "observablePerformanceDe": "Die lernende Person liest an zwei neuen neutralen Hauptgruppenatomen Ordnungszahl, Protonenzahl, Hauptgruppe, Außenelektronenzahl und Periode aus PSE-Daten und erklärt den Zusammenhang.",
            "observablePerformanceEn": "The learner reads atomic number, proton count, main group, outer-electron count and period for two fresh neutral main-group atoms from periodic-table data and explains their relation."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b006-e9d74940-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "element",
            "textDe": "Hauptgruppe 15 und 2 unterscheiden Valenzelektronen und Perioden.",
            "textEn": "Main groups 15 and 2 vary valence electrons and periods."
          },
          {
            "id": "period",
            "textDe": "Dritte und vierte Periode erfordern unterschiedliche Zahlen besetzter Schalen bei neutralen Atomen.",
            "textEn": "Periods three and four require different occupied-shell counts in neutral atoms."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "phosphorus-periodic-table",
            "taskDemandDe": "Ein PSE-Ausschnitt zeigt neutrales Phosphor-Atom P, Z=15, Hauptgruppe 15, Periode 3. Gib Protonen- und Elektronenzahl, Außenelektronen und einfache Schalenzahl an und begründe aus der Tabellenstellung.",
            "taskDemandEn": "A periodic-table excerpt shows neutral phosphorus P, Z=15, main group 15, period 3. State proton and electron counts, outer electrons and simple shell count, explaining each from its table position.",
            "expectedPerformanceDe": "P hat 15 Protonen und im neutralen Atom 15 Elektronen, fünf Außenelektronen und drei besetzte Schalen im einfachen Modell; die Ordnungszahl ist keine Neutronenzahl.",
            "expectedPerformanceEn": "Neutral P has 15 protons and 15 electrons, five outer electrons and three occupied shells in the simple model; atomic number is not neutron count.",
            "understandingFocusDe": "PSE-Merkmale werden am neutralen Hauptgruppenatom verknüpft.",
            "understandingFocusEn": "Periodic-table features are linked for a neutral main-group atom."
          },
          {
            "id": "calcium-atom-transfer",
            "taskDemandDe": "Ein neuer PSE-Ausschnitt zeigt neutrales Calcium Ca, Z=20, Hauptgruppe 2, Periode 4. Nenne Protonen- und Elektronenzahl sowie Außenelektronen und Schalen. Warum unterscheidet sich Ca von P?",
            "taskDemandEn": "A fresh excerpt shows neutral calcium Ca, Z=20, main group 2, period 4. State proton and electron counts plus outer electrons and shells. Why does Ca differ from P?",
            "expectedPerformanceDe": "Ca hat 20 Protonen und im neutralen Atom 20 Elektronen, zwei Außenelektronen und vier besetzte Schalen. Hauptgruppe und Periode erklären den Unterschied zu P; keine Ionenladung wird verlangt.",
            "expectedPerformanceEn": "Neutral Ca has 20 protons and 20 electrons, two outer electrons and four occupied shells. Group and period explain the difference from P; no ion charge is required.",
            "understandingFocusDe": "Neue Hauptgruppe und Periode prüfen eigenständigen Tabellen-Transfer.",
            "understandingFocusEn": "A new group and period test independent table transfer."
          }
        ]
      }
    },
    {
      "goalId": "eb7537dd-d11b-50e9-a6d7-51a78e96fc4e",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Dispersionskräfte wirken zwischen allen Teilchen; permanente Dipole und H-Brücken fügen spezifische Beiträge hinzu.",
            "essentialUnderstandingEn": "Dispersion acts between all particles; permanent dipoles and hydrogen bonds add specific contributions.",
            "observablePerformanceDe": "Ordnet Wechselwirkungen an gegebenen Paaren mit chemischer Begründung zu.",
            "observablePerformanceEn": "Assigns interactions to supplied pairs with chemical reasoning."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Ionen-Dipol-Kräfte wirken zwischen einem Ion und dem polaren Lösungsmittel.",
            "essentialUnderstandingEn": "Ion–dipole forces act between an ion and a polar solvent.",
            "observablePerformanceDe": "Orientiert Wasser um Kationen/Anionen und trennt Solvatation von Molekülbindung.",
            "observablePerformanceEn": "Orients water around cations/anions and distinguishes solvation from intramolecular bonding."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "Eigenschaften folgen dem Zusammenspiel von Polarität, Polarisierbarkeit und Struktur.",
            "essentialUnderstandingEn": "Properties reflect polarity, polarizability and structure together.",
            "observablePerformanceDe": "Vergleicht Stoffeigenschaften und widerlegt eine unpassende pauschale Rangregel.",
            "observablePerformanceEn": "Compares properties and rejects an unsuitable blanket ranking."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",
            "e2",
            "e3"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "v1",
            "textDe": "Neutrale Moleküle oder solvatisierte Ionen",
            "textEn": "Neutral molecules or solvated ions"
          },
          {
            "id": "v2",
            "textDe": "Größe und H-Brückenfähigkeit",
            "textEn": "Size and hydrogen-bond capability"
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "eb7537dd-case-1",
            "taskDemandDe": "Daten und Bedingungen:\nGegeben: Ethanol CH₃CH₂OH, Dimethylether CH₃OCH₃, Pentan C₅H₁₂ sowie Na⁺/Cl⁻ in Wasser. Ethanol und Dimethylether haben dieselbe Molmasse; Siedepunkte als Unterrichtsdaten: 78°C bzw. −25°C. Wasser hat Oδ−/Hδ+. Im eigenen reinen Ether fehlt ein O–H-Donator; Ether-O kann H-Brücken von Wasser akzeptieren.\nAufgaben:\n1. Ordne für jedes reine Molekül die genannten Wechselwirkungen zu und begründe die H-Brückenunterscheidung.\n2. Beschreibe die Wasserorientierung an Na⁺ und Cl⁻ sowie Ether/Wasser-Wechselwirkung.\n3. Erkläre den Siedepunktunterschied der Isomere und grenze ihn von einer allgemeinen Stoffrangfolge ab.",
            "taskDemandEn": "Data and conditions:\nGiven: ethanol CH₃CH₂OH, dimethyl ether CH₃OCH₃, pentane C₅H₁₂, and Na⁺/Cl⁻ in water. Ethanol/dimethyl ether have equal molar mass; teaching boiling points are 78°C/−25°C. Water has Oδ−/Hδ+. Pure ether lacks an O–H donor; its oxygen can accept hydrogen bonds from water.\nTasks:\n1. Assign the listed interactions to each pure molecular substance and explain the hydrogen-bond distinction.\n2. Describe water orientation around Na⁺/Cl⁻ and ether–water interaction.\n3. Explain the isomers’ boiling-point difference and distinguish it from a universal substance ranking.",
            "expectedPerformanceDe": "1. Alle zeigen Dispersion. Ethanol und Ether sind permanent polar und zeigen Dipol-Dipol-Kräfte; Ethanol besitzt O–H-Donator und O-Akzeptor, daher H-Brücken zwischen seinen Molekülen. Reiner Ether bildet keine entsprechende O–H···O-Kette; Pentan ist unpolar.\n2. Um Na⁺ richtet sich vorzugsweise Oδ− aus, um Cl⁻ Hδ+. Das sind Ionen-Dipol-Wechselwirkungen. Wasser kann über O–H eine H-Brücke zum Ether-O bilden; fehlende Selbst-H-Brücken bedeuten deshalb keine fehlende Wasserwechselwirkung.\n3. Bei vergleichbarer Masse/Größe verlangt das zusätzliche H-Brückennetz des Ethanols mehr Energie zur Trennung der Moleküle. Daraus folgt keine universelle Regel, dass jeder H-Brückenstoff höher siedet als jeder unpolare Stoff; Größe/Polarisierbarkeit und Form bleiben relevant.",
            "expectedPerformanceEn": "1. All show dispersion. Ethanol and ether are polar and have dipole–dipole forces; ethanol has O–H donor and oxygen acceptor, allowing intermolecular hydrogen bonds. Pure ether cannot form corresponding O–H···O chains; pentane is nonpolar.\n2. Oδ− points preferentially toward Na⁺ and Hδ+ toward Cl⁻: ion–dipole interactions. Water can donate O–H hydrogen bonds to ether oxygen; lack of self hydrogen bonding does not imply lack of interaction with water.\n3. At comparable mass/size ethanol’s additional hydrogen-bond network requires more energy for molecular separation. This does not mean every hydrogen-bonding substance boils above every nonpolar substance; size, polarizability and shape still matter.",
            "understandingFocusDe": "Wechselwirkungen folgen Ladung, Molekülpolarität, Donator/Akzeptor und Polarisierbarkeit. Transfer: Ethanol/Ether und Hexan/Aceton widerlegen eine universelle Siedepunktrangfolge. Zwei unabhängige Nachweisschritte können in einer integrierten Leistung auftreten; die zwei Fallvarianten sind keine Pflichtaufgabenquote. Sobald alle Aspekte und selbstständiger Transfer hinreichend gezeigt sind, endet die Prüfung.",
            "understandingFocusEn": "Interactions follow charge, molecular polarity, donor/acceptor roles and polarizability. Transfer: Ethanol/ether and hexane/acetone challenge a universal boiling-point ranking. Two independent demonstration steps can occur in one integrated performance; the two case variants are not a mandatory task quota. Stop assessment once all aspects and independent transfer are sufficiently shown."
          },
          {
            "id": "eb7537dd-case-2",
            "taskDemandDe": "Daten und Bedingungen:\nGegeben Aceton CH₃COCH₃ (58 g/mol, Siedepunkt 56°C) und Hexan C₆H₁₄ (86 g/mol, Siedepunkt 69°C), Methanol CH₃OH sowie Mg²⁺ in Wasser. Carbonyl-Cδ+/Oδ−. Hexan hat größere Elektronenwolke; die Siedepunkte sind gerundete Lehrdaten.\nAufgaben:\n1. Erkläre Wechselwirkungen in Aceton, Hexan und Methanol sowie zwischen Methanol und Aceton.\n2. Beschreibe Mg²⁺-Hydratation und unterscheide sie von H-Brücken zwischen Wassermolekülen.\n3. Bewerte anhand der Daten die Behauptung, permanente Dipole erzwingen immer höhere Siedepunkte.",
            "taskDemandEn": "Data and conditions:\nGiven acetone CH₃COCH₃ (58 g/mol, boiling point 56°C), hexane C₆H₁₄ (86 g/mol, 69°C), methanol CH₃OH and Mg²⁺ in water. Carbonyl Cδ+/Oδ−. Hexane has a larger electron cloud; boiling points are rounded teaching data.\nTasks:\n1. Explain interactions within acetone, hexane and methanol and between methanol/acetone.\n2. Describe Mg²⁺ hydration and distinguish it from water–water hydrogen bonds.\n3. Use the data to evaluate the claim that permanent dipoles always force higher boiling points.",
            "expectedPerformanceDe": "1. Aceton: Dispersion plus Dipol-Dipol, kein eigener O–H-Donator. Hexan: Dispersion. Methanol: Dispersion, permanente Dipole und H-Brücken. Methanol-O–H kann an Aceton-O eine H-Brücke bilden. C=O selbst ist eine intramolekulare Bindung.\n2. Wasser-Oδ− weist zum positiven Mg²⁺; die Anziehung ist Ionen-Dipol. Benachbarte Wassermoleküle können zusätzlich O–H···O-Brücken bilden. Der Ion-Wasser-Kontakt ist keine C=O- oder O–H-Molekülbindung.\n3. Hexan siedet trotz fehlendem permanentem Dipol höher als Aceton. Seine größere polarisierbare Elektronenwolke kann stärkere gesamte Dispersion beitragen. Der Vergleich zeigt das Zusammenspiel, nicht das Fehlen von Dipolkräften im Aceton oder einen allgemeinen Größenbeweis aus nur zwei Stoffen.",
            "expectedPerformanceEn": "1. Acetone: dispersion and dipole–dipole, no O–H donor. Hexane: dispersion. Methanol: dispersion, permanent dipoles and hydrogen bonds. Methanol O–H can donate to acetone oxygen. C=O itself is an intramolecular bond.\n2. Water Oδ− faces positive Mg²⁺, giving ion–dipole attraction. Neighboring water molecules may additionally form O–H···O bonds. Ion–water contact is not a molecular C=O/O–H bond.\n3. Hexane boils above acetone despite lacking a permanent dipole. Its larger polarizable electron cloud can contribute greater total dispersion. The comparison shows combined contributions, not absence of acetone dipole forces or a universal size law inferred from two substances.",
            "understandingFocusDe": "Wechselwirkungen folgen Ladung, Molekülpolarität, Donator/Akzeptor und Polarisierbarkeit. Transfer: Ethanol/Ether und Hexan/Aceton widerlegen eine universelle Siedepunktrangfolge. Zwei unabhängige Nachweisschritte können in einer integrierten Leistung auftreten; die zwei Fallvarianten sind keine Pflichtaufgabenquote. Sobald alle Aspekte und selbstständiger Transfer hinreichend gezeigt sind, endet die Prüfung.",
            "understandingFocusEn": "Interactions follow charge, molecular polarity, donor/acceptor roles and polarizability. Transfer: Ethanol/ether and hexane/acetone challenge a universal boiling-point ranking. Two independent demonstration steps can occur in one integrated performance; the two case variants are not a mandatory task quota. Stop assessment once all aspects and independent transfer are sufficiently shown."
          }
        ]
      }
    },
    {
      "goalId": "f5efab9d-2c61-44ea-b36a-87f873b51fd8",
      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "b006-f5efab9d-core",
            "essentialUnderstandingDe": "Das Bohrsche Energiestufenmodell ordnet Elektronen einfacher Atome Schalen zu. Ein großer Sprung zwischen aufeinanderfolgenden Ionisierungsenergien deutet auf stärker gebundene innere Elektronen hin; die Messung zeichnet keine kreisförmigen Bahnen ab.",
            "essentialUnderstandingEn": "Bohr’s energy-level model allocates electrons of simple atoms to shells. A large jump between successive ionization energies suggests more strongly bound inner electrons; the measurement does not trace circular orbits.",
            "observablePerformanceDe": "Die lernende Person verbindet Ordnungszahl und begrenzte Schalenbelegung mit gegebenen Ionisierungsenergien und benennt die Reichweite des Modells.",
            "observablePerformanceEn": "The learner links atomic number and bounded shell occupation to supplied ionization energies and states the model’s limits."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b006-f5efab9d-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "outer-electrons",
            "textDe": "Ein beziehungsweise zwei Außenelektronen erzeugen einen Sprung nach unterschiedlicher Ionisation.",
            "textEn": "One versus two outer electrons cause a jump after a different ionization step."
          },
          {
            "id": "model-limit",
            "textDe": "Messdaten stützen Energieunterschiede, aber keine wörtlichen Elektronen-Kreisbahnen.",
            "textEn": "Measurements support energy differences, not literal electron circles."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "lithium-ionization-data",
            "taskDemandDe": "Für neutrales Li (Z=3) sind die ersten beiden Ionisierungsenergien rund 520 und 7298 kJ/mol. Gib eine einfache Schalenbelegung an und deute den Sprung.",
            "taskDemandEn": "For neutral Li (Z=3), the first two ionization energies are about 520 and 7298 kJ/mol. Give a simple shell occupancy and interpret the jump.",
            "expectedPerformanceDe": "2,1 Elektronen: Nach Entfernen des Außenelektrons betrifft die zweite Ionisation die innere Schale; Zahlen sind Hinweise auf Bindungsstärke, kein Bahnfotobeweis.",
            "expectedPerformanceEn": "2,1 electrons: after the outer electron is removed, the second ionization reaches the inner shell; the numbers indicate binding strength, not a photo of paths.",
            "understandingFocusDe": "Ein neuer Messdatensatz verbindet Modell und Messung.",
            "understandingFocusEn": "A new measured data set links model and measurement."
          },
          {
            "id": "magnesium-ionization-transfer",
            "taskDemandDe": "Für Mg (Z=12) sind die ersten drei Ionisierungsenergien rund 738, 1451 und 7733 kJ/mol. Schlage eine einfache Schalenbelegung vor und erkläre, was der große Sprung nach der zweiten Entfernung zeigt und nicht zeigt.",
            "taskDemandEn": "For Mg (Z=12), the first three ionization energies are about 738, 1451 and 7733 kJ/mol. Propose a simple shell occupancy and explain what the large jump after the second removal does and does not show.",
            "expectedPerformanceDe": "2,8,2 im einfachen Schalenmodell; zwei äußere Elektronen, danach stärker gebundenes inneres Elektron. Die Messwerte allein liefern keine exakten Orbitalformen oder klassischen Bahnen.",
            "expectedPerformanceEn": "2,8,2 in the simple shell model; two outer electrons, then a more strongly bound inner electron. Values alone give neither exact orbital shapes nor classical paths.",
            "understandingFocusDe": "Sprung an anderer Stelle prüft Transfer und Modellgrenze.",
            "understandingFocusEn": "A jump at another position tests transfer and the model limit."
          }
        ]
      }
    },
    {
      "goalId": "fcc73fb5-7413-557f-aea3-b9692a66ee75",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "b007r-fcc-properties-core",
            "essentialUnderstandingDe": "Stoffe werden durch beobachtete oder unter vergleichbaren Bedingungen bestimmte Eigenschaften beschrieben und nach begründeten Kriterien geordnet. Farbe oder ein anderer Einzelbefund allein sichert eine Stoffidentität oft nicht; Stoffname und Eigenschaft sind verschieden. Aussagen zu Löslichkeit nennen das Lösungsmittel und die Bedingungen.",
            "essentialUnderstandingEn": "Substances are described by observed properties or properties determined under comparable conditions and classified using justified criteria. Colour or another single observation often does not establish identity; a substance name and a property differ. Solubility claims specify the solvent and conditions.",
            "observablePerformanceDe": "Die lernende Person erstellt aus sicheren vorgegebenen Beobachtungen eine kleine Eigenschaftsübersicht, ordnet Proben nach einem genannten Merkmal und erklärt die Grenze einer Zuordnung aus nur einem Merkmal.",
            "observablePerformanceEn": "The learner builds a small property summary from safe supplied observations, groups samples by a named property and explains the limit of classification from one property alone."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b007r-fcc-properties-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "sample-property",
            "textDe": "Magnetismus und Oberflächenglanz bei Feststoffen wechseln zu Dichte und Fließverhalten bei Flüssigkeiten.",
            "textEn": "Magnetism and surface lustre for solids change to density and flow behaviour for liquids."
          },
          {
            "id": "evidence-strength",
            "textDe": "Ein einzelnes gemeinsames Merkmal wird gegen eine Kombination unterscheidender Merkmale geprüft.",
            "textEn": "A single shared property is checked against a combination of distinguishing properties."
          },
          {
            "id": "controlled-solvent-conditions",
            "textDe": "Gleiches Wasser, gleiche Stoffmenge und Temperatur sind für die konkrete Löslichkeitsaussage gebunden.",
            "textEn": "The same water, material amount and temperature are tied to the specific solubility claim."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "new-solid-sample-table",
            "taskDemandDe": "Drei sichere, vorbereitete Feststoffproben A, B, C sind gegeben: A ist dunkelgrau, glänzend und wird von einem Magneten angezogen; B ist silbrig glänzend und nicht magnetisch; C ist hell, körnig, matt und nicht magnetisch. Erstelle eine Eigenschaftstabelle, ordne die Proben nach Magnetismus und begründe, weshalb ‚nicht magnetisch‘ B und C nicht gleichsetzt. Keine unbekannte Probe anfassen oder schmecken.",
            "taskDemandEn": "Three safe prepared solid samples A, B and C have supplied observations: A is dark grey, shiny and attracted by a magnet; B is silvery and shiny but non-magnetic; C is light-coloured, granular, dull and non-magnetic. Make a property table, group them by magnetism and explain why 'non-magnetic' does not make B and C the same substance. Do not handle or taste unknown samples.",
            "expectedPerformanceDe": "A wird als magnetisch, B und C werden als nicht magnetisch geordnet. Die Person hält Farbe/Glanz/Körnigkeit getrennt fest und erklärt, dass B und C trotz gemeinsamer Nichtmagnetisierung in anderen Merkmalen verschieden sind; aus diesen wenigen Befunden wird keine sichere Stoffidentität behauptet.",
            "expectedPerformanceEn": "A is grouped as magnetic, B and C as non-magnetic. The learner records colour, lustre and graininess separately and explains that B and C differ in other properties despite their shared non-magnetism; they do not claim certain identity from these limited observations.",
            "understandingFocusDe": "Eigenschaften beschreiben, nach einem expliziten Kriterium ordnen und die Grenze eines Einzelmerkmals erklären.",
            "understandingFocusEn": "Describe properties, classify by an explicit criterion and explain the limit of a single property."
          },
          {
            "id": "fresh-colourless-liquid-data",
            "taskDemandDe": "Zwei neue, verschlossene und beschriftete Flüssigkeitsproben X und Y sind beide farblos und klar. Vorgegebene Messdaten bei 20 °C: X hat 1,00 g/mL und fließt leicht, Y hat 1,26 g/mL und fließt deutlich zäher. Beschreibe und ordne die Proben anhand von zwei geeigneten Eigenschaften; begründe, weshalb die gleiche Farbe keine Gleichheit belegt. Keine eigene Geschmacks- oder Geruchsprobe.",
            "taskDemandEn": "Two new sealed, labelled liquid samples X and Y are both colourless and clear. Supplied data at 20 °C say X has density 1.00 g/mL and flows readily; Y has density 1.26 g/mL and flows much more slowly. Describe and compare the samples using two suitable properties and explain why the same colour does not prove identity. No tasting or smelling samples.",
            "expectedPerformanceDe": "Beide sind farblos/klar, aber Y ist bei gleicher Temperatur dichter und zähflüssiger als X. Die Person trennt gemeinsame von unterscheidenden Eigenschaften, nennt die 20-°C-Bedingung und vergibt ohne weitere Daten keine Stoffnamen.",
            "expectedPerformanceEn": "Both are colourless and clear, but Y is denser and more viscous than X at the same temperature. The learner separates shared from distinguishing properties, states the 20 °C condition and does not assign substance names without more evidence.",
            "understandingFocusDe": "Unabhängiger Transfer von Feststoffbeobachtungen auf Flüssigkeitsdaten und Vergleich unter gleichen Bedingungen.",
            "understandingFocusEn": "Independent transfer from solid observations to liquid data and comparison under common conditions."
          },
          {
            "id": "controlled-solubility-three-solids",
            "taskDemandDe": "Drei ungefährliche, beschriftete Feststoffe werden jeweils mit 5 g in getrennte Becher mit 100 mL Wasser bei 20 °C gegeben und gleich lang gerührt. Vorgegebene Beobachtungen: Zucker verschwindet ohne Bodensatz, Sand bleibt sichtbar am Boden, Speisesalz verschwindet ohne Bodensatz. Ordne nach Wasserlöslichkeit unter diesen Bedingungen und erkläre, welche Stoffe du durch dieses eine Merkmal noch nicht voneinander unterscheiden kannst. Keine Geschmacksprobe.",
            "taskDemandEn": "Three harmless labelled solids are added separately, 5 g each, to 100 mL of water at 20 °C and stirred for the same time. Supplied observations: sugar disappears with no sediment, sand remains visible at the bottom, table salt disappears with no sediment. Group them by solubility in water under these conditions and explain which materials this one property still fails to distinguish. No tasting.",
            "expectedPerformanceDe": "Zucker und Speisesalz werden als in dieser Menge und bei 20 °C wasserlöslich, Sand als nicht merklich wasserlöslich geordnet. Die Person nennt Wasser, gleiche Menge und Temperatur als Vergleichsbedingungen und behauptet nicht, Zucker und Salz durch Löslichkeit allein unterscheiden zu können.",
            "expectedPerformanceEn": "Sugar and table salt are grouped as soluble in water at the stated amount and 20 °C, while sand is not noticeably soluble. The learner states water, equal amounts and temperature as comparison conditions and does not claim that solubility alone distinguishes sugar from salt.",
            "understandingFocusDe": "Kontrollierter Löslichkeitsvergleich, zweiter löslicher Stoff und Grenze der Stoffidentifikation aus einem Merkmal.",
            "understandingFocusEn": "Controlled solubility comparison, a second soluble material and the limit of identification from one property."
          }
        ]
      }
    }
  ],

        "variationAxes": [
          {
            "id": "occupancy",
            "textDe": "Bindende und antibindende Elektronenbelegung werden verändert.",
            "textEn": "Bonding and antibonding electron occupancy are changed."
          },
          {
            "id": "species",
            "textDe": "Neutrales Molekül und Molekülion werden verglichen.",
            "textEn": "A neutral molecule and a molecular ion are compared."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "nitrogen-mo-count",
            "taskDemandDe": "Ein vorgegebenes korrekt geordnetes N2-MO-Schema enthält acht bindende und zwei antibindende Valenzelektronen. Berechne die Bindungsordnung und erkläre ihre Modellbedeutung.",
            "taskDemandEn": "A correctly ordered supplied N2 MO scheme has eight bonding and two antibonding valence electrons. Calculate bond order and explain its model meaning.",
            "expectedPerformanceDe": "Die lernende Person berechnet (8−2)/2=3 und deutet dies als Dreifachbindungs-Tendenz im einfachen MO-Modell, nicht als exakt gemessene Bindungsenergie.",
            "expectedPerformanceEn": "The learner calculates (8−2)/2=3 and interprets a triple-bond tendency in the simple MO model, not an exactly measured bond energy.",
            "understandingFocusDe": "Elektronenbesetzung bestimmt die Modell-Bindungsordnung.",
            "understandingFocusEn": "Electron occupancy determines model bond order."
          },
          {
            "id": "fresh-oxygen-cation",
            "taskDemandDe": "Ein frisches O2-Schema hat acht bindende und vier antibindende Valenzelektronen. Für O2+ wird eines aus einem antibindenden Orbital entfernt. Vergleiche die Bindungsordnung.",
            "taskDemandEn": "A fresh O2 scheme has eight bonding and four antibonding valence electrons. O2+ loses one from an antibonding orbital. Compare bond order.",
            "expectedPerformanceDe": "Die lernende Person erhält 2 für O2 und 2,5 für O2+ und erklärt die modellhaft stärkere Bindungstendenz nach Entfernen eines antibindenden Elektrons.",
            "expectedPerformanceEn": "The learner gets 2 for O2 and 2.5 for O2+ and explains stronger model bonding tendency after removing an antibonding electron.",
            "understandingFocusDe": "Neues Ion prüft regelgeleiteten Transfer.",
            "understandingFocusEn": "A new ion tests rule-based transfer."
          }
        ]
      }
    },
    {
      "goalId": "b8d3b453-d638-5518-aab0-d84ec2e8567c",
      "profile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "structure-model-reasoning",
            "essentialUnderstandingDe": "Aromatische Delokalisierung stabilisiert das System; elektrophile Substitution kann nach zwischenzeitlichem Verlust die Aromatizität wiederherstellen.",
            "essentialUnderstandingEn": "Aromatic delocalization stabilizes the system; electrophilic substitution can restore aromaticity after temporary loss.",
            "observablePerformanceDe": "Die Person vergleicht Benzen und Alken, begründet den Unterschied bei Addition/Substitution und zeichnet den Wiederherstellungsschritt.",
            "observablePerformanceEn": "The learner compares benzene with an alkene, explains the addition/substitution difference and draws restoration of aromaticity."
          },
          {
            "id": "fresh-application-and-boundary",
            "essentialUnderstandingDe": "Ein Kekulé-Bild bedeutet keine drei voneinander unabhängigen gewöhnlichen Doppelbindungen; ohne Reaktionsbedingungen lässt sich keine beliebige Reaktionsgeschwindigkeit vorhersagen.",
            "essentialUnderstandingEn": "A Kekulé drawing does not imply three independent ordinary double bonds; arbitrary reaction rates cannot be predicted without conditions.",
            "observablePerformanceDe": "Für die vorgegebene elektrophile Substitution lautet die Gesamtbilanz C6H6 + Br2 → C6H5Br + HBr. Der H-Verlust und die Wiederherstellung der π-Delokalisierung gehören zusammen. Die Additionsformel C6H6Br2 beschreibt nicht das gezeichnete Substitutionsprodukt. Andere Reaktionsbedingungen können andere Vorgänge ermöglichen; der Fall prüft nur die ausdrücklich vorgegebene elektrophile Erstsubstitution.",
            "observablePerformanceEn": "For the specified electrophilic substitution the overall balance is C6H6 + Br2 → C6H5Br + HBr. H loss and restored π delocalization belong together. The addition formula C6H6Br2 does not describe the drawn substitution product. Other conditions may permit different processes; this case addresses only the explicitly specified initial electrophilic substitution."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "structure-model-reasoning",
            "fresh-application-and-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "material-variation",
            "textDe": "Addition versus elektrophile Erstsubstitution; Benzen versus isolierte C=C; delokalisiertes System gegenüber lokalisiertem Zwischenmodell.",
            "textEn": "Addition versus initial electrophilic substitution; benzene versus isolated C=C; delocalized system versus localized intermediate model."
          },
          {
            "id": "counterexample",
            "textDe": "Ein Kekulé-Bild bedeutet keine drei voneinander unabhängigen gewöhnlichen Doppelbindungen; ohne Reaktionsbedingungen lässt sich keine beliebige Reaktionsgeschwindigkeit vorhersagen.",
            "textEn": "A Kekulé drawing does not imply three independent ordinary double bonds; arbitrary reaction rates cannot be predicted without conditions."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-current15-b8d3b453-case-1",
            "taskDemandDe": "Papiervergleich: Ethen wird im einfachen Modell mit Br2 addiert. Für Benzen ist eine elektrophile Bromierung mit geeignetem Lewis-Säure-Katalysator als Reaktionsbedingung vorgegeben. Erkläre, warum bei Benzen die Substitution fachlich sinnvoll ist, und markiere den vorübergehenden Verlust und die Wiederherstellung des aromatischen Systems.",
            "taskDemandEn": "Paper comparison: ethene undergoes simple addition with Br2. For benzene, electrophilic bromination with an appropriate Lewis-acid catalyst is specified. Explain why substitution is appropriate for benzene and mark temporary loss and restoration of the aromatic system.",
            "expectedPerformanceDe": "Der elektrophile Angriff erzeugt ein nicht vollständig aromatisches σ-Komplex-Modell. Abgabe des H+ am substituierten C stellt die delokalisierte π-Struktur wieder her; insgesamt ersetzt Br ein H. Eine vollständige Addition würde das aromatische System dauerhaft verändern.",
            "expectedPerformanceEn": "Electrophilic attack gives a nonfully aromatic σ-complex model. Loss of H+ from the substituted C restores delocalized π structure; overall Br replaces H. Full addition would persistently alter the aromatic system.",
            "understandingFocusDe": "Reaktionsbedingungen sind gegeben; aus dem Benzen-Strukturbild wird keine Reaktion ohne geeignete Aktivierung behauptet.",
            "understandingFocusEn": "Conditions are specified; the benzene structure alone is not claimed to react without appropriate activation."
          },
          {
            "id": "chem-current15-b8d3b453-case-2",
            "taskDemandDe": "Ein Autor schlägt für die Erstbromierung C6H6 + Br2 → C6H6Br2 vor, zeichnet aber anschließend einen aromatischen Brombenzenring C6H5Br und HBr. Behebe den Widerspruch zwischen Stoffbilanz und Modell und begründe, welche Beschreibung das aromatische Endprodukt erhält.",
            "taskDemandEn": "An author proposes C6H6 + Br2 → C6H6Br2 for initial bromination but then draws aromatic bromobenzene C6H5Br and HBr. Resolve the contradiction between stoichiometry and model and justify which description preserves the aromatic final product.",
            "expectedPerformanceDe": "Für die vorgegebene elektrophile Substitution lautet die Gesamtbilanz C6H6 + Br2 → C6H5Br + HBr. Der H-Verlust und die Wiederherstellung der π-Delokalisierung gehören zusammen. Die Additionsformel C6H6Br2 beschreibt nicht das gezeichnete Substitutionsprodukt.",
            "expectedPerformanceEn": "For the specified electrophilic substitution the overall balance is C6H6 + Br2 → C6H5Br + HBr. H loss and restored π delocalization belong together. The addition formula C6H6Br2 does not describe the drawn substitution product.",
            "understandingFocusDe": "Andere Reaktionsbedingungen können andere Vorgänge ermöglichen; der Fall prüft nur die ausdrücklich vorgegebene elektrophile Erstsubstitution.",
            "understandingFocusEn": "Other conditions may permit different processes; this case addresses only the explicitly specified initial electrophilic substitution."
          }
        ]
      }
    },

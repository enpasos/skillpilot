    "expectations": [
      {
        "id": "5cd8b2a2-whole-1",
        "essentialUnderstandingDe": "GC trennt durch mobile Gasphase und unterschiedliche Wechselwirkungen/Verteilung an der stationären Phase.",
        "essentialUnderstandingEn": "GC separates using a mobile gas phase and different interactions/partition at the stationary phase.",
        "observablePerformanceDe": "Erkläre Trägergas, stationäre Phase und methodenabhängige Retention fachsprachlich am vollständigen GC-Material. Keine tatsächliche Geräteausführung wird verlangt oder behauptet.",
        "observablePerformanceEn": "Explain carrier gas, stationary phase and method-dependent retention scientifically using the complete GC material. Actual instrument execution is neither required nor asserted."
      },
      {
        "id": "5cd8b2a2-whole-2",
        "essentialUnderstandingDe": "Passende Referenzzeiten erlauben begrenzte Identifizierung, keine eindeutige Struktur oder unkalibrierte Menge.",
        "essentialUnderstandingEn": "Matched reference times permit bounded identification, not unique structure or uncalibrated amounts.",
        "observablePerformanceDe": "Ordne die gegebenen gleichen Methodenbedingungen zu. Löse einen frischen Trägergas- oder Ko-Elutionswechsel mit geeigneten neuen Belegen; tR ist keinRf. Beide Aspekte können in einer vollständigen Aufgabe unabhängig sichtbar sein, keine Aufgabenquote.",
        "observablePerformanceEn": "Assign under the supplied matched method conditions. Solve a fresh carrier-gas or co-elution change using suitable new evidence;tR is notRf. Both aspects may be independently shown within one complete task, no task quota."
      }

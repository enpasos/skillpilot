  "synthesis": {
    "synthesisId": "chemie-current12-native-paired-5b1bb5d9-07b1-5ba9-b320-cc97be917c60-20261017-v1",
    "authority": "ai_synthesis",
    "synthesizedBy": "Codex technical assembler of actual fresh independent native A/B D12; no new scientific review or human attestation",
    "synthesizedAt": "2026-10-17T10:22:02.737Z",
    "rationaleDe": "Technische Zusammenführung der beiden tatsächlich abgeschlossenen, unabhängigen nativen D-Reviews: Beide behalten den exakten aktuellen deutschen und englischen Zieltext bei. Die Evidence-Fassung der zweiten Runde wird unverändert übernommen; beide Originalrecords bleiben vollständig gebunden. Es entsteht kein neues fachliches Review und keine Freigabe anderer Gates.",
    "rationaleEn": "Technical assembly of the two actually completed independent native D reviews: both retain the exact current German and English goal wording. The second round evidence is retained verbatim and both complete original records remain bound. This adds no scientific review and approves no other gate.",
    "understandingEvidence": {
      "essentialUnderstandingDe": "Chemische Quelleninformation ist nach Frage, Adressat und Situation auszuwählen und zu strukturieren; Werbeaussage, Modellbefund und fachliche Erklärung haben unterschiedliche Belegfunktionen und Grenzen.",
      "essentialUnderstandingEn": "Chemical source information is selected and structured for the question, audience and situation; advertising, model findings and scientific explanations have distinct evidential functions and limits.",
      "observablePerformanceDe": "Erstellt eine eigene begründete Auswahl und adressatengerechte Information aus den S- oder T-Quellen, nennt Herkunft und Bezugsgrößen und dokumentiert auf dem tatsächlich recherchepflichtigen Weg zusätzlich eigenes Suchen, Lesen und Zitieren.",
      "observablePerformanceEn": "Creates an own justified selection and audience-appropriate note from the S or T sources, identifies origin and reference quantities and additionally records own searching, reading and citation on a route that actually requires research.",
      "transferExpectationDe": "Passt die Quelleninformation für ein Hausmeisterteam oder einen Mehrwegvergleich an und begründet, welche zusätzlichen Oberflächen-, Nutzungs-, Reinigungs- oder Transportangaben dafür erforderlich sind.",
      "transferExpectationEn": "Adapts the source information for a caretaker team or reuse comparison and explains which additional surface, use, cleaning or transport information is required."
    },
    "dissent": [
      {
        "dissentId": "synthesis-dissent-4ae8acc26e3e5b1cbd28d71bf0faee9ce4fb30057aa53eb47f01ead81ecd630d",
        "source": "both",
        "textDe": "Die beiden aktuellen keep-Reviews unterscheiden sich in understandingEvidence, rationale; das Manifest wählt ausdrücklich die Evidence-Fassung der zweiten Runde.",
        "textEn": "The two current keep reviews differ in understandingEvidence, rationale; the manifest explicitly selects the evidence formulation from the second round.",

    {
      "id": "e22a34d4-ac1e-5afe-8f77-0dfa4fd9f44f",
      "shortKey": "canonical_chemistry_complexometric_edta_titration",
      "title": "Komplexometrische EDTA-Titrationen durchführen",
      "titleEn": "Perform complexometric EDTA titrations",
      "description": "Die lernende Person kann komplexometrische Titrationen mit EDTA-Lösung durchführen und auswerten, um Konzentrationen von Metall-Kationen in wässrigen Lösungen zu bestimmen.",
      "descriptionEn": "The learner can perform and evaluate complexometric titrations with EDTA solution to determine concentrations of metal cations in aqueous solutions.",
      "requires": [
        "363c5740-8a3c-50b8-8c3a-5548c80c36ea",

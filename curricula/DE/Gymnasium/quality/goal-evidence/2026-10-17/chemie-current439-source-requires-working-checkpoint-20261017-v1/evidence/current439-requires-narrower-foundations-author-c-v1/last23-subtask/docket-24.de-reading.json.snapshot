      "variationAxes": [
        {
          "id": "given-angle-domain",
          "textDe": "Vorgegebene lineare, planare und tetraedrische Domänen und Molekülgestalten."
        },
        {
          "id": "angle-model-boundary",
          "textDe": "Freie Paare und Modellwinkel gegenüber Messbehauptungen."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "epa-angle-only-tetrahedral-reference",
          "taskDemandDe": "Alle Molekülgestalten und Elektronendomänen sind bereits gegeben; ihre erneute Ableitung oder Klassifikation wird nicht geprüft. Referenz: Vier Domänen sind ideal tetraedrisch angeordnet, mit 109,5°. CH4 ist tetraedrisch ohne freie Paare; H2O ist gewinkelt bei vier Domänen und zwei freien Paaren. Ordne den idealen CH4-Winkel zu und erkläre, weshalb der H–O–H-Winkel qualitativ kleiner sein kann. Welcher exakte Messwert folgt daraus nicht? Frischer Transfer: NH3 ist als trigonal-pyramidal mit vier Domänen und einem freien Paar gegeben. Begründe die Richtung der Winkelabweichung vom Referenzwert.",
          "expectedPerformanceDe": "CH4 hat im idealen tetraedrischen Modell 109,5°. Im einfachen EPA-Modell beanspruchen freie Paare mehr Raum und drücken Bindungsrichtungen zusammen; der H–O–H-Winkel ist gegenüber 109,5° verkleinert. Eine exakte gemessene Winkelzahl folgt daraus nicht. Für das vorgegebene NH3-Modell wird ebenfalls eine Verkleinerung gegenüber dem tetraedrischen Referenzwinkel begründet. Gestalten nur zu benennen genügt nicht.",
          "understandingFocusDe": "Gefordert sind Winkelzuordnung, begründete Abweichung und Modellgrenze. Alle Gestalten sind Eingabedaten."
        },
        {
          "id": "epa-angle-only-linear-planar-transfer",
          "taskDemandDe": "Gegebene Referenzen: linear 180°, trigonal-planar 120°, tetraedrische Domänen 109,5°. CO2 ist linear mit zwei Domänen am C; BH3 ist trigonal-planar mit drei Domänen am B; NH3 ist trigonal-pyramidal mit vier Domänen einschließlich eines freien Paars. Die Formen werden nicht erneut abgefragt. Ordne ideale Winkel zu, begründe, weshalb drei Bindungen bei BH3 und NH3 keine gleichen Winkel erzwingen, und prüfe: „EPA liefert für jedes Molekül den exakten gemessenen Winkel.“ Frische Variation: Eine Messung weicht vom idealen Referenzwinkel ab. Erkläre, weshalb weder Messung noch gesamtes Modell ohne weitere Prüfung verworfen werden dürfen.",
          "expectedPerformanceDe": "CO2 gehört zum linearen 180°- und BH3 zum planaren 120°-Referenzwinkel. NH3 hat tetraedrische Domänen mit 109,5° als Ausgangsideal und einer freipaarbedingten Verkleinerung. Drei Bindungen machen NH3 nicht zu einem 120°-Fall. EPA ist ein idealisierendes Modell; Bedingungen, weitere Einflüsse und Messunsicherheit müssen geprüft werden. Eine Abweichung allein beweist weder einen Messfehler noch ein vollständiges Modellversagen.",
          "understandingFocusDe": "Frischer Winkelvergleich ohne wiederholte Gestaltklassifikation."
        }
      ]
    }

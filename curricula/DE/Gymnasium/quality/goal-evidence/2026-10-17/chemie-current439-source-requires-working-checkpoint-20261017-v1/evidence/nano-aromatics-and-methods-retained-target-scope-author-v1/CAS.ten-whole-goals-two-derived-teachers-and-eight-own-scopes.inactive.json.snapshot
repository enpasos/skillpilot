        "type": "atomic",
        "id": "1df17884-96ae-57d7-9da9-dbebd082596f",
        "shortKey": "canonical_chemistry_sek1_criteria_based_decision_making",
        "title": "Chemische Handlungsoptionen kriteriengeleitet bewerten",
        "titleEn": "Evaluate chemical action options using criteria",
        "description": "Die lernende Person kann bei einer chemisch relevanten Alltags- oder Gesellschaftsentscheidung ethische, ökologische, ökonomische, soziale und sicherheitsbezogene Kriterien ableiten, Chancen und Risiken beurteilen, begründete Handlungsoptionen formulieren und mit einer passenden Entscheidungsstrategie abwägen. Sie überprüft Entscheidung, Kriterien und Strategie und reflektiert Möglichkeiten und Grenzen chemischer Sichtweisen.",
        "descriptionEn": "The learner can derive ethical, environmental, economic, social, and safety-related criteria for a chemistry-related everyday or societal decision, assess opportunities and risks, formulate justified options, and weigh them using a suitable decision strategy. They review the decision, criteria, and strategy and reflect on the possibilities and limits of chemical perspectives.",
        "requires": [
          "431a0f03-f28a-5e56-a61f-000336d0b410"
        ],
        "dimensionTags": {
          "framework": "canonical-gymnasium-chemistry",
          "demandLevel": "AB3",
          "processCompetencies": [
            "PK5_BEWERTEN",
            "PK4_KOMMUNIZIEREN"
          ],
          "guidingIdeas": [
            "BC_REAKTION"
          ],
          "phase": "GLOBAL",
          "area": "Erkenntnisgewinnung und Kommunikation",
          "topicCode": "CANONICAL.CHEMISTRY.SEK1.CRITERIA_BASED_DECISION_MAKING"
        },
        "examples": [],
        "resourceLinks": [
          {
            "type": "goal-visualization",
            "resourceType": "image",
            "role": "primary",
            "skillpilotId": "1df17884-96ae-57d7-9da9-dbebd082596f",
            "title": "Visualisierung: Chemische Handlungsoptionen kriteriengeleitet bewerten",
            "url": "/assets/goal-visualizations/chemie/1df17884-96ae-57d7-9da9-dbebd082596f/1df17884-96ae-57d7-9da9-dbebd082596f.jpg",
            "provider": "Google Gemini / Nano Banana Pro",
            "description": "Mehrweg-Glas, Mehrweg-Kunststoff und Einweg-Kunststoff werden mit Transport, Umläufen, Reinigung, Recycling und mehreren gewichtbaren Kriterien verglichen. Chancen und Risiken führen zu einer offenen, kontextabhängig zu begründenden Entscheidung; die Waage behauptet keine objektive Gesamtumweltzahl.",
            "altText": "Getränkebehälter, Prüfgrößen, gewichtbare Kriterien und eine offene kontextabhängige Entscheidung.",
            "lang": "de",
            "license": "CC-BY-4.0",
            "reviewStatus": "pilot"
          }
        ]
      },

  "profile": {
    "archetype": "procedure",
    "expectations": [
      {
        "id": "whole-duty-1",
        "essentialUnderstandingDe": "Für die angegebene Reaktionsgleichung stehen im Gleichgewichtsquotienten die Produktgrößen im Zähler und die Eduktgrößen im Nenner. Aktivitäten beziehungsweise im Modell zulässige Konzentrationsgrößen tragen die stöchiometrischen Exponenten.",
        "essentialUnderstandingEn": "For the specified reaction equation, product quantities form the numerator and reactant quantities the denominator of the equilibrium quotient. Activities or model-permitted concentration quantities carry the stoichiometric powers.",
        "observablePerformanceDe": "Formuliert für die gegebene Gleichung den MWG-Ausdruck mit korrekten Stoffgrößen und Potenzen und nennt bei einer Bilanzaufgabe den zulässigen Konzentrationsbereich.",
        "observablePerformanceEn": "Writes the mass action expression for the supplied equation using correct species quantities and powers and states the admissible concentration range in a balance problem."
      },
      {
        "id": "whole-duty-2",
        "essentialUnderstandingDe": "Bei gegebener Temperatur verbindet K die Gleichgewichtszusammensetzung mit dem Massenwirkungsgesetz; Stoffbilanz und nichtnegative Konzentrationen begrenzen eine aus K berechnete Lösung.",
        "essentialUnderstandingEn": "At a given temperature, K relates equilibrium composition through mass action; material balance and nonnegative concentrations constrain a solution calculated from K.",
        "observablePerformanceDe": "Berechnet K aus vorgegebenen Gleichgewichtsdaten oder bestimmt aus K und Stoffbilanz die Gleichgewichtskonzentrationen und prüft sie durch Einsetzen.",
        "observablePerformanceEn": "Calculates K from supplied equilibrium data or determines equilibrium concentrations from K and material balance and checks them by substitution."
      },
      {
        "id": "whole-duty-3",
        "essentialUnderstandingDe": "Der Zahlenwert von K gehört zur angegebenen Reaktionsrichtung und Modellkonvention. Er beschreibt Gleichgewichtslage, nicht Reaktionsgeschwindigkeit oder zwingend vollständigen Umsatz; für die umgekehrte Gleichung gilt die reziproke Konstante.",
        "essentialUnderstandingEn": "The value of K belongs to the specified reaction direction and model convention. It describes equilibrium position, not reaction rate or necessarily complete conversion; the reversed equation has the reciprocal constant.",
        "observablePerformanceDe": "Deutet den Gleichgewichtszahlenwert mit Bezug auf die angegebene Gleichung und begründet bei deren Umkehrung die reziproke Konstante, ohne vollständigen Umsatz oder eine Reaktionsgeschwindigkeit zu behaupten.",
        "observablePerformanceEn": "Interprets the equilibrium value with reference to the specified equation and explains the reciprocal constant when that equation is reversed, without claiming complete conversion or a reaction rate."
      },
      {
        "id": "whole-duty-4",
        "essentialUnderstandingDe": "Q beschreibt die aktuelle Zusammensetzung und kann sich bei Stoffzugabe ändern, während K bei gleicher Temperatur unverändert bleibt. Q<K beziehungsweise Q>K bestimmt im gegebenen Modell die Netto-Hin- beziehungsweise Rückrichtung.",
        "essentialUnderstandingEn": "Q describes the current composition and may change after feed addition while K remains unchanged at the same temperature. In the stated model, Q<K and Q>K determine the net forward and reverse directions respectively.",
        "observablePerformanceDe": "Bestimmt nach einer vorgegebenen Zusammensetzungsänderung Q, vergleicht Q mit K und begründet Netto-Reaktionsrichtung und die Unveränderlichkeit von K bei gleicher Temperatur.",
        "observablePerformanceEn": "Determines Q after a supplied composition change, compares Q with K and explains the net direction and why K remains unchanged at the same temperature."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "whole-duty-1",
        "whole-duty-2",
        "whole-duty-3",
        "whole-duty-4"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "whole-case-material",
        "textDe": "Homogenes Estermodell / Gleichgewichtskonzentration aus Stoffbilanz",
        "textEn": "Homogeneous ester model / Equilibrium concentration from balance"
      },
      {
        "id": "independent-transfer",
        "textDe": "Frisches homogenes 1:1:1:1-System bei fester Temperatur mit den im Gleichgewicht gemessenen Konzentrationen cP=cQ=0,10 und cR=cS=0,50 mol/L: bestimme K für P+Q⇌R+S und für die umgekehrte Gleichung. / Frisch: Start je 0,60 mol/L, K=4, gleiche Reaktion.",
        "textEn": "Fresh homogeneous 1:1:1:1 system at a fixed temperature with measured equilibrium concentrations cP=cQ=0.10 and cR=cS=0.50 mol/L: determine K for P+Q⇌R+S and its reverse. / Fresh: initial concentrations each 0.60 mol/L, K=4, same reaction."
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "q3-02-a",
        "taskDemandDe": "Idealisierte homogene Lösung: Säure + Alkohol ⇌ Ester + Wasser, stöchiometrisch 1:1:1:1. Gleichgewicht bei T: c(Säure)=c(Alkohol)=0,20 mol/L, c(Ester)=c(Wasser)=0,40 mol/L; Aktivitäten werden durch c/c° mit c°=1 mol/L angenähert. Formuliere das MWG, berechne K und interpretiere die Lage. Berechne den Quotienten unmittelbar nach Verdopplung der Säurekonzentration. Unterscheide ihn von K. Separater Transfer: Frisches homogenes 1:1:1:1-System bei fester Temperatur mit den im Gleichgewicht gemessenen Konzentrationen cP=cQ=0,10 und cR=cS=0,50 mol/L: bestimme K für P+Q⇌R+S und für die umgekehrte Gleichung.",
        "expectedPerformanceDe": "K=(cE/c°)(cW/c°)/[(cS/c°)(cA/c°)]=0,40²/0,20²=4. Produkte sind im Verhältnis des MWG begünstigt, nicht quantitativ vollständig gebildet. Unmittelbar nach Säurezugabe ist Q=0,16/(0,40·0,20)=2<K; der Nettoverlauf geht nach rechts, bis Q wieder 4 ist. Bei unverändertem T bleibt K=4. Transferantwort: K=25; für die Rückgleichung 1/25=0,04. Die Interpretation gehört immer zur angegebenen Reaktionsgleichung. Scoring /10: 2P: Alle vier Stoffe mit richtigen Potenzen einbeziehen.; 2P: K=4 aus Gleichgewichtsdaten berechnen.; 2P: Zahlenwert ohne vollständigen Umsatz oder Geschwindigkeitsaussage deuten.; 2P: Q=2 und konstantes K=4 unterscheiden.; 2P: K=25; für die Rückgleichung 1/25=0,04. Die Interpretation gehört immer zur angegebenen Reaktionsgleichung.",
        "understandingFocusDe": "Nachweis des ganzen aktuellen Ziels durch ausreichend gezeigte zusammenhängende Fachleistung; keine Zusatzaufgabenquote. Vorhandene Fälle sind Alternativen und gezielte Ergänzungen. Synthetische Autorenmaterialien belegen keine tatsächliche Experimentdurchführung oder Lernendenleistung. Quellenanteile bleiben einzeln begrenzt.",
        "taskDemandEn": "Idealized homogeneous solution: acid + alcohol ⇌ ester + water, stoichiometry 1:1:1:1. At equilibrium at T: c(acid)=c(alcohol)=0.20 mol/L and c(ester)=c(water)=0.40 mol/L; activities are approximated by c/c° with c°=1 mol/L. Write the mass action expression, calculate K and interpret equilibrium position. Calculate the quotient immediately after doubling acid concentration. Distinguish it from K. Separate transfer: Fresh homogeneous 1:1:1:1 system at a fixed temperature with measured equilibrium concentrations cP=cQ=0.10 and cR=cS=0.50 mol/L: determine K for P+Q⇌R+S and its reverse.",
        "expectedPerformanceEn": "K=(cE/c°)(cW/c°)/[(cS/c°)(cA/c°)]=0.40²/0.20²=4. Products are favoured in the mass action ratio, not formed completely. Immediately after acid addition Q=0.16/(0.40·0.20)=2<K; net reaction proceeds right until Q returns to 4. At unchanged T, K stays 4. Transfer response: K=25; for the reverse equation 1/25=0.04. Interpretation always belongs to the specified reaction equation. Scoring /10: 2P: Include all four species with correct powers.; 2P: Calculate K=4 from equilibrium data.; 2P: Interpret the number without claiming complete conversion or a rate.; 2P: Distinguish Q=2 and constant K=4.; 2P: K=25; for the reverse equation 1/25=0.04. Interpretation always belongs to the specified reaction equation.",
        "understandingFocusEn": "Evidence for the whole current goal through sufficiently demonstrated connected scientific performance; no extra-task quota. Available cases are alternatives and targeted additions. Synthetic author material proves no actual experiment execution or learner performance. Source contributions remain individually bounded."
      },
      {
        "id": "q3-02-b",
        "taskDemandDe": "Homogenes Modell A+B⇌C+D bei T, K=9. Anfang: je 1,00 mol/L A und B, kein C oder D; gleichbleibendes Volumen. Zulässiger Umsatz x liegt zwischen 0 und 1,00 mol/L. Berechne alle Gleichgewichtskonzentrationen mit MWG und Bilanz. Prüfe deine Lösung durch Einsetzen und interpretiere K. Eine andere Probe bei gleichem T hat Q=18; deute sie. Separater Transfer: Frisch: Start je 0,60 mol/L, K=4, gleiche Reaktion.",
        "expectedPerformanceDe": "cA=cB=1−x, cC=cD=x. 9=x²/(1−x)²; für nichtnegative Konzentrationen x/(1−x)=3, also x=0,75 mol/L. A/B je 0,25, C/D je 0,75; 0,75²/0,25²=9. Das produktbegünstigte Gleichgewicht enthält trotzdem A/B. Q=18>K bedeutet Nettoverlauf nach links; es ist kein neues K. Transferantwort: x/(0,60−x)=2, x=0,40; Edukte je0,20 und Produkte je0,40 mol/L. K bleibt trotz anderer Startmengen4. Scoring /10: 2P: Bilanz und zulässigen Bereich angeben.; 2P: MWG korrekt lösen und alle Konzentrationen nennen.; 2P: Einsetzprobe und begrenzte K-Interpretation leisten.; 2P: Q>K als Rückverschiebung bei unverändertem K deuten.; 2P: x/(0,60−x)=2, x=0,40; Edukte je0,20 und Produkte je0,40 mol/L. K bleibt trotz anderer Startmengen4.",
        "understandingFocusDe": "Nachweis des ganzen aktuellen Ziels durch ausreichend gezeigte zusammenhängende Fachleistung; keine Zusatzaufgabenquote. Vorhandene Fälle sind Alternativen und gezielte Ergänzungen. Synthetische Autorenmaterialien belegen keine tatsächliche Experimentdurchführung oder Lernendenleistung. Quellenanteile bleiben einzeln begrenzt.",
        "taskDemandEn": "Homogeneous model A+B⇌C+D at T, K=9. Initially A and B are each 1.00 mol/L, with no C or D; constant volume. Allowed conversion x lies between 0 and 1.00 mol/L. Calculate all equilibrium concentrations using mass action and balance. Check by substitution and interpret K. Another sample at the same T has Q=18; interpret it. Separate transfer: Fresh: initial concentrations each 0.60 mol/L, K=4, same reaction.",
        "expectedPerformanceEn": "cA=cB=1−x and cC=cD=x. 9=x²/(1−x)²; for nonnegative concentrations x/(1−x)=3, so x=0.75 mol/L. A/B are each 0.25 and C/D each 0.75; 0.75²/0.25²=9. Product-favoured equilibrium still contains A/B. Q=18>K means net reaction left; it is not a new K. Transfer response: x/(0.60−x)=2, x=0.40; reactants each0.20 and products each0.40 mol/L. K remains4 despite different initial amounts. Scoring /10: 2P: State balance and allowed range.; 2P: Solve mass action correctly and state all concentrations.; 2P: Check by substitution and give bounded interpretation of K.; 2P: Interpret Q>K as reverse shift at unchanged K.; 2P: x/(0.60−x)=2, x=0.40; reactants each0.20 and products each0.40 mol/L. K remains4 despite different initial amounts.",
        "understandingFocusEn": "Evidence for the whole current goal through sufficiently demonstrated connected scientific performance; no extra-task quota. Available cases are alternatives and targeted additions. Synthetic author material proves no actual experiment execution or learner performance. Source contributions remain individually bounded."
      }
    ]
  },

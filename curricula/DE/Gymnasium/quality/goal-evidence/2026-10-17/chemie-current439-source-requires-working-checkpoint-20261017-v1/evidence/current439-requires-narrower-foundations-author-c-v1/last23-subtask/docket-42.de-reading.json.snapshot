    "profile": {
      "archetype": "representation",
      "expectations": [
        {
          "id": "e1",
          "essentialUnderstandingDe": "Die Ladung am amphiphilen Kopf bestimmt die Tensidklasse,nicht das Gegenion.",
          "observablePerformanceDe": "In6a und6b leitet sie anionische, kationische und nichtionische Klassen aus Kopfgruppen ab; bei einem zusätzlichen protonierbaren Amin nutzt sie die vorgegebenen pH-Daten statt eine permanente Ladung anzunehmen."
        },
        {
          "id": "e2",
          "essentialUnderstandingDe": "Ein ungeladener polarer Tensidkopf kann durch OH- oder Ethergruppen mit Wasser wechselwirken; formale Kopfladung und Gesamtneutralität des Salzes sind unterschiedliche Aussagen.",
          "observablePerformanceDe": "In6a und6b markiert die lernende Person Kopf, Kette und Gegenion, erklärt die Hydratation eines Ethoxylat- oder Glucosidkopfs und begründet die drei kanonischen Tensidklassen."
        },
        {
          "id": "e3",
          "essentialUnderstandingDe": "pH und Mischbedingungen begrenzen ausStruktur abgeleitete Aussagen.",
          "observablePerformanceDe": "In6a und6b unterscheidet sie einen Gegenionenaustausch von einer pH-bedingten Kopfladungsänderung und benennt fehlende Daten für quantitative Löslichkeits- oder Leistungsbehauptungen."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "e1",
          "e2",
          "e3"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "energy20-06-a-transfer",
          "textDe": "Entferne eine Ethoxyeinheit ausC und ersetze Na+ inA durchK+. Welche Klasse bleibt, welche quantitative Eigenschaft ist ohne Daten offen?"
        },
        {
          "id": "energy20-06-b-transfer",
          "textDe": "Ersetze den Glucosidkopf von L durch eine angegebene ungeladene Ethoxykette und ersetze Na+ in K durch K+. Begründe, welche Zuordnungen bleiben und welche quantitative Löslichkeits- oder Leistungsangabe neue Stoffdaten benötigt."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "energy20-06-a",
          "taskDemandDe": "Ganzes eigenes Material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json #energy20-06-a. OrdneA/B/C begründet als anionisch, kationisch oder nichtionisch zu. Markiere Kopf, Schwanz und Gegenion. Erkläre die Wechselwirkung vonC mit Wasser und warumD kein Tensid ist. Sage eine mögliche Folge einerA/B-Mischung voraus, ohne alle Mischungen als unlöslich zu behandeln.",
          "expectedPerformanceDe": "A trägt den negativen Sulfatester-Kopf, Na+ist Gegenion; B den positiven quartären Ammoniumkopf mit Br−. C hat eine polare sauerstoffreiche Ethoxyregion ohne formale Ladung. Neutralität des gesamten Salzes ändert die Kopfklasse nicht. NaCl fehlt der lipophile Schwanz. Entgegengesetzte Köpfe können abhängig von Konzentration/Zusammensetzung Ionenpaare oder schwerlösliche Komplexe bilden. Die Klasse beweist keine bestimmte Waschleistung.",
          "understandingFocusDe": "Entferne eine Ethoxyeinheit ausC und ersetze Na+ inA durchK+. Welche Klasse bleibt, welche quantitative Eigenschaft ist ohne Daten offen?"
        },
        {
          "id": "energy20-06-b",
          "taskDemandDe": "Ganzes eigenes Material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json #energy20-06-b. Charakterisiere K, G und L aus dem Aufbau als anionisch, kationisch oder nichtionisch. Markiere jeweils Kopf, Kette und gegebenenfalls Gegenion und begründe, wie die Kopfregion mit Wasser wechselwirkt. Erkläre am zusätzlichen Amin, warum die pH-Angabe eine Klassifizierung beeinflussen kann, ein quartärer Ammoniumkopf aber nicht auf dieselbe Weise protoniert wird.",
          "expectedPerformanceDe": "K trägt eine negativ geladene Sulfonatgruppe mit Na+ als Gegenion; G trägt den positiven quartären Ammoniumkopf mit Cl−. L besitzt einen ungeladenen OH-reichen polaren Kopf, der Wasserstoffbrücken mit Wasser bilden kann. Die unpolare Kette vermittelt Wechselwirkung mit unpolaren Stoffen. Gesamtneutralität der Salze ändert die Kopfladung nicht. E kann durch Protonierung kationisch werden; ohne pH-/Stoffdaten ist es nicht als permanent kationisch einzuordnen. Die drei Zuordnungen enthalten keinen Beweis gleicher Waschleistung oder Umweltverträglichkeit.",
          "understandingFocusDe": "Ersetze den Glucosidkopf von L durch eine angegebene ungeladene Ethoxykette und ersetze Na+ in K durch K+. Begründe, welche Zuordnungen bleiben und welche quantitative Löslichkeits- oder Leistungsangabe neue Stoffdaten benötigt."
        }
      ]
    }

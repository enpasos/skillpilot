    "profile": {
      "archetype": "representation",
      "expectations": [
        {
          "id": "e1",
          "essentialUnderstandingDe": "Die Ladung am amphiphilen Kopf bestimmt die Tensidklasse,nicht das Gegenion.",
          "essentialUnderstandingEn": "Charge on the amphiphilic head determines class,not the counterion.",
          "observablePerformanceDe": "In6a und6b leitet sie anionische, kationische und nichtionische Klassen aus Kopfgruppen ab; bei einem zusätzlichen protonierbaren Amin nutzt sie die vorgegebenen pH-Daten statt eine permanente Ladung anzunehmen.",
          "observablePerformanceEn": "In6a and6b the learner derives anionic, cationic and nonionic classes from head groups; for an additional protonatable amine, supplied pH data prevent assuming permanent charge."
        },
        {
          "id": "e2",
          "essentialUnderstandingDe": "Ein ungeladener polarer Tensidkopf kann durch OH- oder Ethergruppen mit Wasser wechselwirken; formale Kopfladung und Gesamtneutralität des Salzes sind unterschiedliche Aussagen.",
          "essentialUnderstandingEn": "An uncharged polar surfactant head can interact with water through OH or ether groups; formal head charge differs from overall salt neutrality.",
          "observablePerformanceDe": "In6a und6b markiert die lernende Person Kopf, Kette und Gegenion, erklärt die Hydratation eines Ethoxylat- oder Glucosidkopfs und begründet die drei kanonischen Tensidklassen.",
          "observablePerformanceEn": "In6a and6b the learner identifies head, tail and counterion, explains hydration of an ethoxylate or glucoside head, and justifies the three canonical surfactant classes."
        },
        {
          "id": "e3",
          "essentialUnderstandingDe": "pH und Mischbedingungen begrenzen ausStruktur abgeleitete Aussagen.",
          "essentialUnderstandingEn": "pH/mixing conditions limit structural inferences.",
          "observablePerformanceDe": "In6a und6b unterscheidet sie einen Gegenionenaustausch von einer pH-bedingten Kopfladungsänderung und benennt fehlende Daten für quantitative Löslichkeits- oder Leistungsbehauptungen.",
          "observablePerformanceEn": "In6a and6b the learner distinguishes counterion substitution from a pH-dependent change in head charge and identifies missing data for quantitative solubility or performance claims."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "e1",
          "e2",
          "e3"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "energy20-06-a-transfer",
          "textDe": "Entferne eine Ethoxyeinheit ausC und ersetze Na+ inA durchK+. Welche Klasse bleibt, welche quantitative Eigenschaft ist ohne Daten offen?",
          "textEn": "Remove one ethoxy unit fromC and replaceNa+ byK+ inA. Decide which class remains and which quantitative properties cannot follow from structure alone."
        },
        {
          "id": "energy20-06-b-transfer",
          "textDe": "Ersetze den Glucosidkopf von L durch eine angegebene ungeladene Ethoxykette und ersetze Na+ in K durch K+. Begründe, welche Zuordnungen bleiben und welche quantitative Löslichkeits- oder Leistungsangabe neue Stoffdaten benötigt.",
          "textEn": "Replace the glucoside head of L with a specified uncharged ethoxy chain and change Na+ to K+ in K. Justify which classifications remain and which quantitative solubility or performance claims require new substance data."

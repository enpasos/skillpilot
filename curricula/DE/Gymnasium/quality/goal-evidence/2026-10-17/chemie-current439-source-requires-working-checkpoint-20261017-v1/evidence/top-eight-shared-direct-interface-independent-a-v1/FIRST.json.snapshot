      "pairIndex": 12,
      "dependentGoalId": "70b12d1c-abaf-45c6-ae9e-b571e9cbc126",
      "dependentTitle": "Elektrolyse einfacher Salze deuten",
      "originalPrerequisiteId": "22133f29-ef02-4408-8f8d-2bbea3275d91",

    {
      "goalId": "7371c82e-6668-5ddc-ba78-347113fcddf8",
      "titleDe": "Fettverwendung kriteriengeleitet bewerten",
      "goalFingerprint": "sha256:48158d684d086b515ae6480cd03b71cfefcad7cba2f8842d9dd0fe9453d3cc6e",
      "pageFingerprint": "sha256:2202458519e9847632b5f1ba98e968515b98461153ef02bab86bccb797547285",
      "profileFingerprint": "sha256:5edd6d6d2631d08774044250145f6165f0f1a0ae5ed9a7b500e95a92dfd08312",
      "D": {
        "recommendation": "keep",
        "reasonDe": "Ein fachlich zusammenhängendes Bewertungsziel verbindet Fettstruktur und fallbezogene Nutzungsentscheidungen. Die Struktur/Eigenschaft-Voraussetzung und das Fett-Elterncluster sind passend; DE/EN gleichwertig. HE2024 S.39 nennt Ernährung und nachwachsenden Rohstoff ausdrücklich.",
        "proposedDescriptionDe": null,
        "proposedDescriptionEn": null
      },
      "ownCounterprobesDe": "Beide Öle bleiben trotz unterschiedlicher cis-Anteile verseifbare Triacylglyceride. Dreifach längere Oxidationszeit ist im Dossier belegt, aber kein universelles gesund/ungesund-Ranking. Paraffin widerlegt den Schluss lange C/H-Kette genügt für Nahrungsfett.",
      "P": {
        "recommendation": "suitable_ai_candidate",
        "reasonDe": "Alle drei Fälle enthalten operative Materialien und konkrete erwartete Begründungen. Der Ernährungsfall verlangt Verdauungsbausteine/Energiespeicherung; die übrigen Fälle erzwingen Funktion, Preis und Lieferkettenrisiko samt offener Gewichtung. Synthetische Daten sind keine Markt- oder Ernährungsstudie.",
        "machineDesignReviewOnly": true,
        "learnerTrialsObserved": 0,
        "preserveCurrentStatus": true,
        "sourceScopeNotAutomaticallyGlobal": true
      },
      "visualization": {

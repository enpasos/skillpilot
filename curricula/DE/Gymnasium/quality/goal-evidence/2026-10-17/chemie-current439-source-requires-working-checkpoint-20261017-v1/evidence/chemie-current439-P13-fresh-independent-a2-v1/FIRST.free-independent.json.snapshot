    {
      "goalId": "058dca74-1b57-5eb3-9c94-1c7b6cc795ad",
      "titleDe": "Proteinlöslichkeit und Denaturierung erklären",
      "goalFingerprint": "sha256:0a7730571fc9116f1aa42f8b251b72bb933de758b8a62e3380f624165906eac8",

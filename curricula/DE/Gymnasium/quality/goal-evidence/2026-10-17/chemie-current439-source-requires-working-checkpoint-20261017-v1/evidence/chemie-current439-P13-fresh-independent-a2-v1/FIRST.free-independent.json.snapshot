    {
      "goalId": "95dc0ee5-a0af-5682-af32-d66e36fbeb50",
      "titleDe": "Chemische Fach- und Symbolsprache ebenengerecht verwenden",
      "goalFingerprint": "sha256:0a2700c260fbc3ad421ab3a383a44231869bd398dff5b056b51e768401e8a5ab",
      "pageFingerprint": "sha256:a90b708be2cdb52b71c49132eb7ae6cdb3799b2f647e907fe241b33eb709ef50",
      "profileFingerprint": "sha256:d4e17ea8529b74d4861ead99ff9c3d499872984a32f2bfc5b1369a50b5063a6b",
      "D": {
        "recommendation": "keep",
        "reasonDe": "Die Beschreibung verbindet einen einzigen darstellungsbezogenen Ebenenwechsel: Alltag, beobachtbarer Stoff, Teilchen und Symbol. DE/EN sind inhaltsgleich. Die Formel-Grundlage ist als Voraussetzung vorhanden; das Sek-I-Kommunikationscluster passt.",
        "proposedDescriptionDe": null,
        "proposedDescriptionEn": null
      },
      "ownCounterprobesDe": "NaCl ist ein Verhältnis, kein diskretes Molekül des Kristalls; H2/O2 zu Wasser braucht 2:1:2 und erhält 4 H/2 O. Eigene CIP-Gegenprobe: NH2 links/COOH oben ergibt bei Alanin und Serin S, bei Cystein wegen CH2SH vor COOH R; daher kein R=D-Schluss. Ohne Stereodeskriptor folgt auch kein Racemat.",
      "P": {
        "recommendation": "suitable_ai_candidate",
        "reasonDe": "Die allgemeinen beiden Fälle verlangen selbst formulierte Erklärung und Fehlerkorrektur. Die Aminosäurefälle erlauben trotz Regelkarte selbständige Namensdekodierung; der BY-C13-Fischer-Satz wurde im offiziellen HTML gelesen. Diese Zusatzpflicht bleibt ausdrücklich BY/C13/LK-Quellenkontext und ist keine globale Sek-I-Abschlussbedingung.",
        "machineDesignReviewOnly": true,
        "learnerTrialsObserved": 0,
        "preserveCurrentStatus": true,
        "sourceScopeNotAutomaticallyGlobal": true
      },
      "visualization": {
        "recommendation": "keep",
        "reasonDe": "Wassermolekülmodell, H2O-Index und Stoff-/Teilchenwechsel stimmen. Der Pfeil wird als Darstellungswechsel gelesen, nicht als chemische Umwandlung. KEEP.",

{
  "role": "SEALED independent free scientific first judgement for exact frozen Mixed18 Round A; written before native candidate serialization or other Mixed18 reviewer results",
  "goals": [
    {
      "goalId": "f85b4651-50ea-5b42-b193-3465c05257a7",
      "currentDescriptionDe": "Die lernende Person kann einfache MO-Diagramme (z. B. O2, N2) interpretieren und Bindungsordnung ableiten.",
      "currentDescriptionEn": "The learner can interpret simple MO diagrams (e.g. O2, N2) and derive bond order.",
      "scientificDecision": "keep",
      "profileRecommendation": "revise",
      "scientificRationale": "Die Beschreibung benennt eine klar prüfbare Modellleistung. O2 mit acht bindenden und vier antibindenden Valenzelektronen ergibt BO=2 und zwei ungepaarte Elektronen; N2 ergibt BO=3. Die aktuelle O2-Abbildung ist fachlich konsistent. Das P muss zusätzlich tatsächlich lesbare, korrekt geordnete Diagrammobjekte anbieten: bereits mitgeteilte Summenzahlen allein zeigen noch keine eigenständige Interpretation des Diagramms. Dies betrifft die Ausgestaltung der Evidenz, nicht die Richtigkeit des D-Textes.",
      "understanding": {
        "essentialUnderstandingDe": "Bindende und antibindende MO-Besetzung wirken entgegengesetzt auf die modellierte Bindungsordnung.",
        "essentialUnderstandingEn": "Bonding and antibonding MO occupation contribute oppositely to model bond order.",
        "observablePerformanceDe": "An einem vorgelegten Diagramm die Besetzung selbst zählen, (Nb−Na)/2 begründen und den Befund begrenzt deuten; O2:2, N2:3.",
        "observablePerformanceEn": "Independently count occupations in a supplied diagram, justify (Nb−Na)/2 and interpret the result with limits; O2:2, N2:3.",
        "transferExpectationDe": "Für ein neues Ion die entfernte oder zusätzliche Elektronenbesetzung bestimmen und daraus die Änderung der Bindungsordnung ableiten; O2+ ergibt 2,5.",
        "transferExpectationEn": "For an unfamiliar ion determine which occupation changes and derive the bond-order change; O2+ gives 2.5."
      },
      "contextualBoundary": "BY C12 eA belegt MO-Schemata. Der aktuelle HE2024_0-Abschnitt Q1.1 allein enthält keine MO-Pflicht; die eigene Erweiterung bleibt erhalten. Struktur-Eigenschafts-Vorwissen ist Anschluss, keine bereits vorhandene MO-Leistung."
    },
    {
      "goalId": "9decc36b-a69a-5599-a9f0-fcebdf0203d8",
      "currentDescriptionDe": "Die lernende Person kann an vorgegebenen Molekülpaaren mit gleicher Konstitution anhand ihrer räumlichen Anordnung begründen, ob Stereoisomerie vorliegt, und gegebenenfalls den passenden Stereoisomerietyp zuordnen.",
      "currentDescriptionEn": "The learner can use supplied pairs of molecules with the same constitution to explain from their spatial arrangements whether stereoisomerism is present and, where applicable, assign the appropriate type of stereoisomerism.",
      "scientificDecision": "keep",
      "profileRecommendation": "none",
      "scientificRationale": "Gleiche Konstitution wird sinnvoll vorausgesetzt; die Leistung verlangt eine räumliche Begründung statt bloßer Namenswiedergabe. E/Z am geeigneten Alken, fehlende E/Z-Bedingung bei Prop-1-en und echte Spiegelbild-/Drehungsvergleiche bilden unterschiedliche Entscheidungen. Das Bild zeigt konsistente Typbeispiele. Eine ausformulierte absolute Gesamttaxonomie oder R/S-Benennung muss nicht neu in dieses Atom gezogen werden.",
      "understanding": {
        "essentialUnderstandingDe": "Stereoisomerie beruht auf unterschiedlicher räumlicher Anordnung bei gleicher Konstitution; Spiegelbildlichkeit und E/Z-Bedingungen sind getrennt zu prüfen.",
        "essentialUnderstandingEn": "Stereoisomerism concerns different spatial arrangements at equal connectivity; mirror relationships and E/Z conditions require separate checks.",
        "observablePerformanceDe": "Vorgelegte Paare vergleichen, Deckung durch Rotation prüfen und E/Z beziehungsweise Enantiomerie aus der Anordnung begründen; gleiche Darstellung nach Drehung bleibt identisch.",
        "observablePerformanceEn": "Compare supplied pairs, test superposability by rotation and justify E/Z or enantiomerism from arrangement; rotation of one representation does not create an enantiomer.",
        "transferExpectationDe": "Auf ein neues geeignetes Molekülpaar übertragen und bei fehlenden verschiedenen Substituenten an einem Alken-C eine E/Z-Zuordnung begründet ablehnen.",
        "transferExpectationEn": "Transfer to a new suitable pair and reject E/Z assignment when one alkene carbon lacks different substituents."
      },
      "contextualBoundary": "Stereozentren sind direkter Anschluss. Konfiguration/Konformation bleibt als eigener nachfolgender Kontext; das Bild ersetzt kein selbst bearbeitetes räumliches Paar."
    },
    {
      "goalId": "b8d3b453-d638-5518-aab0-d84ec2e8567c",
      "currentDescriptionDe": "Die lernende Person kann die Reaktivität aromatischer Systeme anhand ihrer Elektronendelokalisierung begründen.",
      "currentDescriptionEn": "The learner can explain the reactivity of aromatic systems in terms of their electron delocalization.",
      "scientificDecision": "keep",
      "profileRecommendation": "revise",
      "scientificRationale": "Delokalisierung und Rückgewinnung des aromatischen Systems begründen die hier gewählte elektrophile Substitution; die Darstellung des einfach geladenen sigma-Komplexes und der H+-Abspaltung ist konsistent. Beide gebundenen P-Fälle behandeln aber dieselbe Benzol/Br2-Umsetzung, der zweite überwiegend deren falsch bilanzierte Wiedergabe. Die verlangte frische selbstständige Übertragung sollte an einem wirklich neu vorgelegten chemischen Vergleich oder geänderten Elektrophil gezeigt werden, ohne daraus eine zusätzliche starre Fallquote zu machen.",
      "understanding": {
        "essentialUnderstandingDe": "Aromatische Delokalisierung stabilisiert das Ausgangssystem; elektrophiler Angriff hebt sie zeitweise auf und Deprotonierung stellt sie wieder her.",
        "essentialUnderstandingEn": "Aromatic delocalisation stabilises the starting system; electrophilic attack temporarily interrupts it and deprotonation restores it.",
        "observablePerformanceDe": "Benzol unter geeigneten Bromierungsbedingungen mit einem Alken vergleichen, sigma-Komplex, Substitutionsprodukt und Stoff-/Ladungsbilanz erklären.",
        "observablePerformanceEn": "Compare benzene under suitable bromination conditions with an alkene and explain the sigma complex, substitution product and atom/charge balance.",
        "transferExpectationDe": "An einem unvertrauten elektrophilen Vergleich selbst begründen, ob die vorgeschlagene Produktbildung Aromatizität wiederherstellt; Aussagen auf die angegebenen Bedingungen begrenzen.",
        "transferExpectationEn": "In an unfamiliar electrophilic comparison independently explain whether proposed product formation restores aromaticity, bounded by stated conditions."
      },
      "contextualBoundary": "HE Q1.1 LK und BY C12 eA stützen den Zusammenhang. Erweiterte Orbitalmodellierung hat hier einen eigenen direkten Nachfolger; nicht als bereits geleistete Voraussetzung ausgeben."
    },
    {
      "goalId": "94a62b39-d4a2-5882-99d1-6886ead07726",
      "currentDescriptionDe": "Die lernende Person kann passive und aktive Korrosionsschutzmaßnahmen, insbesondere Beschichtungen, Schutzschichten, galvanische Kopplung und Opferanoden, erläutern und ökologisch sowie ökonomisch bewerten.",
      "currentDescriptionEn": "The learner can explain passive and active corrosion protection measures, including coatings, protective layers, galvanic coupling, and sacrificial anodes, and evaluate them ecologically and economically.",
      "scientificDecision": "keep",
      "profileRecommendation": "none",
      "scientificRationale": "Die Beschreibung verbindet Funktionsprinzip und begründete Bewertung. Die ganzen Modellfälle unterscheiden Barriere, beschädigte edle/unedle Überzüge sowie elektrische Isolation. Die Richtung des Elektronenflusses von Zn zum Stahl ist richtig; Verbrauch und notwendiger Metall-/Elektrolytkontakt begrenzen Schutz. Modellkosten allein erlauben keine gesamte Ökobilanz. Das Bild darf seine knappen Bewertungslabels nicht als allgemeine Produkt- oder Lebensdauerwerte ausgeben.",
      "understanding": {
        "essentialUnderstandingDe": "Passiver Schutz begrenzt den Stoffkontakt; kathodischer Schutz verändert elektrochemische Teilprozesse und benötigt einen geschlossenen wirksamen Stromweg.",
        "essentialUnderstandingEn": "Passive protection limits contact with the environment; cathodic protection changes electrochemical processes and needs an effective closed current path.",
        "observablePerformanceDe": "An Zn/Fe/Cu-Modellen Anode und Kathode, Elektronen- und Ionentransport, Beschädigung und Materialverbrauch begründen und Kosten-/Umweltkriterien getrennt abwägen.",
        "observablePerformanceEn": "For Zn/Fe/Cu models justify anode/cathode, electron and ion transport, damage and material consumption, then weigh cost and environmental criteria separately.",
        "transferExpectationDe": "Bei verbrauchter oder elektrisch abgetrennter Opferanode das Urteil revidieren und verbleibende Barrierewirkung von aktivem Schutz unterscheiden.",
        "transferExpectationEn": "Revise the judgement for a consumed or electrically disconnected sacrificial anode, separating remaining barrier action from active protection."
      },
      "contextualBoundary": "Keine eigene Durchführung wird hier behauptet. Ein Standardpotenzial ist unter veränderten Film-/Oberflächenbedingungen kein alleiniger Nachweis einer realen Korrosionsgeschwindigkeit."
    },
    {
      "goalId": "9fef5c29-62bc-5ada-b96b-6885bcb049cb",
      "currentDescriptionDe": "Die lernende Person kann das Phosphat-Puffersystem beschreiben und die Wirkung mithilfe von Le Chatelier begründen.",
      "currentDescriptionEn": "The learner can describe the phosphate buffer system and justify the effect using Le Chatelier's principle.",
      "scientificDecision": "keep",
      "profileRecommendation": "none",
      "scientificRationale": "Phosphatpaar und Le-Chatelier-Deutung bilden ein kohärentes qualitatives Ziel. Die aktuelle P-Fassung definiert die geschlossene Grenze nach der Zugabe und endliche Reserven ausdrücklich; richtige Säure-/Basenreaktionen und begrenzte biologische Bedeutung werden verlangt. Die Bildteilchen sind eine symbolische Veranschaulichung und keine Konzentrationsdarstellung; das gezeichnete offene Glas allein definiert nicht die operative Modellgrenze.",
      "understanding": {
        "essentialUnderstandingDe": "H2PO4−/HPO4²− fängt begrenzte Säure- oder Basenzugaben durch korrespondierende Protolysepartner ab.",
        "essentialUnderstandingEn": "H2PO4−/HPO4²− responds to limited acid or base additions through conjugate proton-transfer partners.",
        "observablePerformanceDe": "HPO4²−+H3O+→H2PO4−+H2O und H2PO4−+OH−→HPO4²−+H2O formulieren und die begrenzte pH-Änderung qualitativ begründen.",
        "observablePerformanceEn": "Write HPO4²−+H3O+→H2PO4−+H2O and H2PO4−+OH−→HPO4²−+H2O and qualitatively explain the limited pH change.",
        "transferExpectationDe": "Säurezugabe auf Basenzugabe und nahezu erschöpfte Pufferkomponente übertragen; keine unveränderten pH-Werte oder vollständige Blutregulation behaupten.",
        "transferExpectationEn": "Transfer acid addition to base addition and near-depletion, without claiming unchanged pH or complete blood regulation."
      },
      "contextualBoundary": "HE Q3.4 führt dieses Beispiel auf grundlegendem Niveau; Henderson-Hasselbalch und offene Systeme bleiben getrennte Anforderungen. Brønsted und Le Chatelier tragen das Vorwissen."
    },
    {
      "goalId": "801790f9-be3a-51fe-9b0f-3452c1bba887",
      "currentDescriptionDe": "Die lernende Person kann offene, geschlossene und isolierte Systeme unterscheiden und Energieerhaltung qualitativ erklären.",
      "currentDescriptionEn": "The learner can distinguish open, closed, and isolated systems and qualitatively explain conservation of energy.",
      "scientificDecision": "keep",
      "profileRecommendation": "none",
      "scientificRationale": "Offen/geschlossen/isoliert und Energieerhaltung sind in DE/EN deckungsgleich prüfbar. Der aktuelle Kolben-/Starrgefäßtransfer verlangt echte Grenz- und Arbeitsargumentation. Wärmeisolierung allein wird zutreffend nicht mit vollständiger Isolation gleichgesetzt. Das Bild verwendet die Konvention positiver Energiezufuhr konsistent und behauptet kein Verschwinden von Energie.",
      "understanding": {
        "essentialUnderstandingDe": "Stoff- und Energieaustausch bestimmen die gewählte Systemart; Wärme und Arbeit übertragen Energie über eine definierte Grenze.",
        "essentialUnderstandingEn": "Matter and energy exchange determine the selected system type; heat and work transfer energy across a defined boundary.",
        "observablePerformanceDe": "Offenes Wassergefäß, gasdichtes wärmetauschendes Gefäß und vollständig abgeschirmtes Gesamtmodell begründet klassifizieren und Energieflüsse erklären.",
        "observablePerformanceEn": "Justifiably classify open water, a gas-tight heat-exchanging vessel and a fully shielded total model, explaining energy flows.",
        "transferExpectationDe": "Bei gleichem Wärmeeintrag ein starres Gasmodell mit einem arbeitenden Kolben vergleichen und nach Erweiterung der Grenze Energieerhaltung neu bilanzieren.",
        "transferExpectationEn": "For equal heat input compare a rigid gas model with a working piston, then reconsider conservation after enlarging the boundary."
      },
      "contextualBoundary": "HE Q4.1 qualitativ; MV/RP thermodynamische Systemarten. Weder das qualitative Atom noch seine Illustration belegen die spätere quantitative Enthalpieleistung."
    },
    {
      "goalId": "4a08f31f-204c-5339-9d9f-5d2af28d5d5c",
      "currentDescriptionDe": "Die lernende Person kann Reaktionsenthalpien mit dem Satz von Hess und einfachen Kalorimetrieansätzen bestimmen.",
      "currentDescriptionEn": "The learner can determine reaction enthalpies using Hess's law and simple calorimetry approaches.",
      "scientificDecision": "keep",
      "profileRecommendation": "none",
      "scientificRationale": "Hess und Kalorimetrie sind zwei Wege derselben Enthalpienbestimmung. Die vollständig gelesenen Salz-/ST-Zeitreihen und Neutralisationsmaterialien trennen synthetische Rechnung von echter Ausführung. −110,5 kJ/mol CO, −56,16 kJ/mol Neutralisationsumsatz und die pV-Modelle sind rechnerisch konsistent. Quellenspezifische praktische Operatoren und Molbasis bleiben erhalten; die fakultative RP-Vertiefung wird ausdrücklich nicht als allgemeine amtliche LK-Pflicht ausgegeben.",
      "understanding": {
        "essentialUnderstandingDe": "Enthalpie ist eine Zustandsgröße; Reaktionsgleichung, Phasen, Temperatur und Stoffmengenbasis bestimmen den Vergleich. Kalorimetrische Wärme braucht eine passende System-/Arbeitsbilanz.",
        "essentialUnderstandingEn": "Enthalpy is a state function; reaction equation, phases, temperature and amount basis define comparison. Calorimetric heat requires the appropriate system/work balance.",
        "observablePerformanceDe": "Hess-Gleichungen umkehren/skalieren/addieren; aus tatsächlichen freigegebenen Messungen inklusive Blindprobe, Ccal, Vorzeichen und Unsicherheit eine molare Enthalpie bestimmen.",
        "observablePerformanceEn": "Reverse/scale/add Hess equations; derive a molar enthalpy from actual authorised measurements with blank, Ccal, signs and uncertainty.",
        "transferExpectationDe": "Reaktion, Phase oder starre/isobare Grenze selbstständig wechseln; Δ(pV) von ΔV und molare Größen von extensiver Mengenänderung unterscheiden.",
        "transferExpectationEn": "Independently change reaction, phase or rigid/isobaric boundary; distinguish Δ(pV) from ΔV and molar quantities from extensive amount changes."
      },
      "contextualBoundary": "HE Q4.1: Kalorimetrieprinzip. ST Original2022 S38/46: konkret Mg und NH4HCO3 mit verdünnter HCl ausführen. MV gedruckt19/20: molar GK/LK, nichtmolar zusätzlich LK. RP45/46: pV ausdrücklich optionale Vertiefung. Göttingen2159/1333 tatsächlich gelesen; Autorenanpassungen und synthetische Werte sind keine Quellenmessungen. Keine zusätzliche starre Versuchslaufquote ableiten."
    },
    {
      "goalId": "a76ab487-4663-5005-8454-cb3196f3773b",
      "currentDescriptionDe": "Die lernende Person kann die Gewinnung von Glucose aus stärkehaltigen Pflanzen, den Aufbau eines Glucosemoleküls und die Umwandlung zu Ethanol durch Gärung beschreiben und Nutzen-Risiko-Aspekte bewerten.",
      "currentDescriptionEn": "The learner can describe the production of glucose from starch-containing plants,the structure of a glucose molecule and its conversion to ethanol by fermentation,and evaluate benefits and risks of its use.",
      "scientificDecision": "keep",
      "profileRecommendation": "none",
      "scientificRationale": "Das qualitative Ziel verbindet eine konkrete Herstellungskette, bereitgestellte Glucosestruktur und begründete Nutzen/Risiko-Bewertung. Ganze aktuelle Karten spezifizieren G eindeutig als offene D-Glucose (OH rechts-links-rechts-rechts), mit überwiegenden Ringformen in Wasser. Der Cellulose-/Enzymwechsel und die Trennung von Reaktion und Isolierung liefern fachlichen Transfer. Rechen- oder eigenständige D/L-Klassifikationspflichten wären hier eine zusätzliche Kompetenz.",
      "understanding": {
        "essentialUnderstandingDe": "Stärkehydrolyse liefert Glucose; alkoholische Gärung wandelt Glucose zu Ethanol und CO2 um. Struktur und Prozessgrenzen begrenzen Schlussfolgerungen.",
        "essentialUnderstandingEn": "Starch hydrolysis supplies glucose; alcoholic fermentation converts glucose into ethanol and CO2. Structure and process boundaries limit inferences.",
        "observablePerformanceDe": "Die Herstellungskette und Karte G erklären, fünf OH und CHO der offenen Form erkennen sowie einen Nutzen und konkrete Lebenszyklusgrenzen abwägen.",
        "observablePerformanceEn": "Explain the production chain and card G, recognise five OH groups and CHO in the open form, and weigh a benefit against specific life-cycle limits.",
        "transferExpectationDe": "Bei Cellulose mit ungeeignetem Enzym den fehlenden gesicherten Glucosezulauf erklären; geringere isolierte Ethanolmenge nicht mit fehlender Gärung gleichsetzen.",
        "transferExpectationEn": "For cellulose with an unsuitable enzyme explain the missing assured glucose supply; do not equate lower isolated ethanol with absent fermentation."
      },
      "contextualBoundary": "HE Q4.2 ist offiziell fakultativ und bleibt im breiten verfassten SkillPilot-Ziel enthalten. Keine individuelle Themenwahl und keine allgemeine CO2-Neutralität ableiten."
    },
    {
      "goalId": "0cf2ffe1-a988-5ffb-ab37-0ac7d58b23dd",
      "currentDescriptionDe": "Die lernende Person kann Energieumwandlungen in Brennstoffzellen und Verbrennungskraftwerken vergleichen und ökologische, ökonomische sowie soziale Perspektiven in eine begründete Bewertung einbeziehen.",
      "currentDescriptionEn": "The learner can compare energy conversions in fuel cells and combustion power plants and include ecological, economic, and social perspectives in a justified evaluation.",
      "scientificDecision": "keep",
      "profileRecommendation": "none",
      "scientificRationale": "Der D-Text trifft die mehrperspektivische Kompetenz. Vollständige Energy20-10a/b-Materialien normieren Ausgangsnutzen bzw. markieren beim KWK-Fall die nötige Neudimensionierung. 1,143 gegenüber 0,414 kgCO2e und Winter70/50%, Sommer50/30% stimmen mit den fiktiven Daten überein. Die Strommixänderung kehrt nur den bedingten Klimavergleich um; Kosten und Sozialurteile folgen daraus nicht.",
      "understanding": {
        "essentialUnderstandingDe": "Redoxbasierte elektrische Arbeit und Wärme-Arbeit-Umwandlung haben unterschiedliche Pfade; Gesamtbewertung verlangt gleiche Dienstleistung und offen gelegte Vorketten.",
        "essentialUnderstandingEn": "Redox-based electrical work and heat-to-work conversion use different paths; overall evaluation needs equivalent service and disclosed upstream chains.",
        "observablePerformanceDe": "Energiepfade erklären, Vorkette und tatsächlich genutzte Wärme rechnerisch berücksichtigen und ökologische, ökonomische sowie soziale Kriterien mit Wertannahmen gewichten.",
        "observablePerformanceEn": "Explain conversion paths, account numerically for upstream supply and actually used heat, and weight ecological, economic and social criteria with stated value assumptions.",
        "transferExpectationDe": "Bei geändertem H2-Strommix oder Wärmenetz das Urteil auf gleicher Nutzengrenze revidieren, Wärme nicht doppelt gutschreiben und fehlende Daten sichtbar halten.",
        "transferExpectationEn": "Revise the judgement for changed hydrogen electricity or a heat network at equivalent service, avoiding double heat credits and retaining visible data gaps."
      },
      "contextualBoundary": "BY C12 eA formuliert die drei Perspektiven ausdrücklich. Das Kohlekraftwerksbild illustriert einen möglichen Verbrennungspfad; die ganzen Modellfälle verwenden teils Gas, ohne daraus reale Technikranglisten abzuleiten."
    },
    {
      "goalId": "d465d82b-4bf2-5527-bb7c-dad5a92605fe",
      "currentDescriptionDe": "Die lernende Person kann anionische, kationische und nichtionische Tenside anhand ihres Aufbaus charakterisieren.",
      "currentDescriptionEn": "The learner can characterize anionic, cationic, and nonionic surfactants based on their structure.",
      "scientificDecision": "keep",
      "profileRecommendation": "none",
      "scientificRationale": "Die Kopfgruppenstruktur trägt die drei Klassenzuordnungen. Vollständige Karten enthalten Sulfatester/Sulfonat, quartäres Ammonium und ungeladene Ethoxy-/Glucosidköpfe. Gegenionenaustausch ändert nicht die Kopfklasse; protonierbare Amine benötigen pH-/Stoffdaten. Bild und D bleiben auf strukturelle Charakterisierung begrenzt und behaupten keine gemessene Waschleistung.",
      "understanding": {
        "essentialUnderstandingDe": "Amphiphile Kopfregion und lipophiler Rest wirken zusammen; die formale Ladung der Kopfgruppe bestimmt die hier behandelte Tensidklasse.",
        "essentialUnderstandingEn": "An amphiphilic head region and lipophilic tail act together; formal head-group charge determines the surfactant class treated here.",
        "observablePerformanceDe": "An neuen Strukturkarten Kopf, Kette und Gegenion markieren, die drei Klassen begründen und Wasserwechselwirkungen ungeladener polarer Köpfe erklären.",
        "observablePerformanceEn": "Mark head, tail and counterion on unfamiliar structural cards, justify the three classes and explain water interactions of uncharged polar heads.",
        "transferExpectationDe": "Kopfstruktur, Ethoxylierung oder pH ändern und Klassenerhalt von möglicher Eigenschaftsänderung unterscheiden; keine quantitative Leistung ohne Stoffdaten ableiten.",
        "transferExpectationEn": "Change head structure, ethoxylation or pH and distinguish class retention from possible property changes; infer no quantitative performance without substance data."
      },
      "contextualBoundary": "Micellenbildung ist tragfähiges Vorwissen. Die Beispielauswahl der HE-Waschmittelroute bleibt Auswahl, keine vollständige Tensidtaxonomie."
    },
    {
      "goalId": "a78aacf9-92ea-5627-8776-a595111f754c",
      "currentDescriptionDe": "Die lernende Person kann Funktionen von Enthärtern, Bleichsystemen, Enzymen und Hilfsstoffen erklären.",
      "currentDescriptionEn": "The learner can explain functions of softeners, bleaching systems, enzymes, and auxiliaries.",
      "scientificDecision": "revise",
      "profileRecommendation": "none",
      "scientificRationale": "Der DE-Text und die aktuellen ganzen Fälle meinen Wasserenthärtung durch Builder, nicht Gewebeweichspülung. Im EN-D-Text ist das unqualifizierte softeners dafür fachlich mehrdeutig; die konkrete Funktion muss als water softeners/builders eindeutig bleiben. Die übrigen Gruppen und das Funktionsniveau bleiben erhalten. P und Bild unterscheiden Hydrolyse, Härteionenbindung, Oxidation und Fluoreszenz zutreffend.",
      "understanding": {
        "essentialUnderstandingDe": "Builder vermindern freie Härteionen; Bleichsysteme, Enzyme und Hilfsstoffe erfüllen chemisch verschiedene Aufgaben.",
        "essentialUnderstandingEn": "Builders reduce free hardness ions; bleaching systems, enzymes and auxiliaries fulfil chemically different functions.",
        "observablePerformanceDe": "Kontrollbeobachtungen den Funktionen zuordnen und proteolytische Hydrolyse, Oxidationsbleiche, Wasserenthärtung und optische Weißwirkung unterscheiden.",
        "observablePerformanceEn": "Assign controlled observations to functions and distinguish proteolytic hydrolysis, oxidative bleaching, water softening and optical whitening.",
        "transferExpectationDe": "Bei geändertem Fleck oder empfindlicher Faser/Farbe Komponenten neu auswählen und deren Grenzen begründen; gefährliche Hypochlorit-Säuremischung zurückweisen.",
        "transferExpectationEn": "For a changed stain or sensitive fibre/dye reconsider ingredients and justify limits; reject dangerous acid/hypochlorite mixing."
      },
      "contextualBoundary": "HE Q4.3 fakultative Route, breite eigene Zielaufnahme bleibt erhalten. Keine reale Rezepturfreigabe aus den fiktiven Karten.",
      "proposedCompleteDescriptionDe": "Die lernende Person kann Funktionen von Wasserenthärtern (Buildern), Bleichsystemen, Enzymen und Hilfsstoffen erklären.",
      "proposedCompleteDescriptionEn": "The learner can explain the functions of water softeners (builders), bleaching systems, enzymes and auxiliaries."
    },
    {
      "goalId": "cc5a626a-dc85-57e2-b422-259f92901545",
      "currentDescriptionDe": "Die lernende Person kann biologische Abbauwege geeigneter Tenside anhand ihrer funktionellen Gruppen beschreiben, beispielsweise Hydrolyse, endständige Oxidation und mikrobielle Kettenverkürzung, und Primärabbau, Zwischenprodukte sowie Mineralisierung unterscheiden.",
      "currentDescriptionEn": "The learner can describe biological degradation pathways of suitable surfactants using their functional groups, for example hydrolysis, terminal oxidation and microbial chain shortening, and distinguish primary degradation, intermediates and mineralisation.",
      "scientificDecision": "keep",
      "profileRecommendation": "none",
      "scientificRationale": "Das aktuelle Atom grenzt geeignete Tenside und funktionelle Gruppen ausdrücklich ab. Die operative aktuelle P-Fassung unterscheidet nun tatsächlich Ausgangsstoffentfernung, Verlust der Oberflächenaktivität, Zwischenprodukte, Sorption und Mineralisierung. Eine gesättigte lineare C12-Kette liefert nach Aktivierung modellhaft sechs Acetyl-Einheiten über fünf Verkürzungszyklen; das ist noch keine CO2-Bilanz. Verzweigung oder aromatischer Kern erlauben keine ungeprüfte Wegübertragung.",
      "understanding": {
        "essentialUnderstandingDe": "Funktionelle Gruppen und Mikroorganismen/Bedingungen ermöglichen stoffspezifische Abbauschritte; Primärabbau und vollständige Mineralisierung sind verschiedene Aussagen.",
        "essentialUnderstandingEn": "Functional groups and microbial conditions enable substance-specific degradation; primary degradation and complete mineralisation are different claims.",
        "observablePerformanceDe": "Esterhydrolyse, Alkohol-Aldehyd-Säure-Oxidation und C2-Verkürzung am geeigneten Modell erklären und C-Bilanz sowie Oberflächenaktivitätsdaten zur Aussagegrenze nutzen.",
        "observablePerformanceEn": "Explain ester hydrolysis, alcohol-aldehyde-acid oxidation and C2 shortening in a suitable model, using carbon balance and surface-activity data to limit claims.",
        "transferExpectationDe": "Für verzweigte Kette oder sorbierte Alkylphenolprodukte die Übertragbarkeit neu prüfen und Rückgang im Wasser von Molekülabbau unterscheiden.",
        "transferExpectationEn": "Reassess transfer to a branched chain or sorbed alkylphenol products, distinguishing disappearance from water from destruction of molecules."
      },
      "contextualBoundary": "HE Q4.3 LK nennt Wege als Beispiele. Ältere reine Split-Vorlagen enthalten andere wissenschaftliche Formulierungen; allein die aktuellen P-Körper gelten operativ. Das Cartoonbild ist keine allgemeine Kopfspaltungs- oder vollständige Mineralisierungsgarantie."
    },
    {
      "goalId": "b208b1a5-c609-53a1-8add-979417a93b7d",
      "currentDescriptionDe": "Die lernende Person kann ausgewählte Bindungs- und Wechselwirkungstypen zwischen Farbstoff-Molekülen und Faser-Molekülen beschreiben und die Eignung von Farbstoffen als Textilfarbstoff beurteilen.",
      "currentDescriptionEn": "The learner can describe selected bonding and interaction types between dye molecules and fiber molecules and evaluate the suitability of dyes as textile dyes.",
      "scientificDecision": "keep",
      "profileRecommendation": "none",
      "scientificRationale": "Das Ziel ist als bedingte Struktur-Eignungs-Bewertung prüfbar. Aktuelle vollständige Fälle unterscheiden ionische Anziehung an protonierter Wolle, mögliche H-Brücken, kovalente Reaktivfarbstoffbindung an Cellulose und intermolekulare Aufnahme in Polyester. Kovalente Fixierung verhindert weder Photochemie noch Faserabbau. Das Bild ist ein Modell: die zwischen roten Farbstoffsymbolen gestrichelten Linien im Polyesterpanel belegen selbst keine Farbstoff-Faser-Kräfte.",
      "understanding": {
        "essentialUnderstandingDe": "Fixierung hängt von passenden Farbstoff- und Fasergruppen sowie dem Bad ab; kovalente Reaktion und intermolekulare Anziehung sind verschiedene Bindungsarten.",
        "essentialUnderstandingEn": "Fixation depends on compatible dye/fibre groups and bath conditions; covalent reaction and intermolecular attraction are different bonding modes.",
        "observablePerformanceDe": "Gegebene Gruppen und Ladungen auswerten, eine Bindungs-/Wechselwirkungsroute zuordnen und Eignung inklusive Löslichkeit sowie begrenzter Waschbeständigkeit begründen.",
        "observablePerformanceEn": "Analyse supplied groups/charges, assign a bonding or interaction route and justify suitability including solubility and limited wash-resistance predictions.",
        "transferExpectationDe": "Bei anderer Faser, pH-Änderung oder fehlender Reaktivgruppe die Auswahl neu begründen; Einlagerung und irreversible Farbbeständigkeit nicht gleichsetzen.",
        "transferExpectationEn": "Reconsider a changed fibre, pH or missing reactive group; do not equate uptake with irreversible colour permanence."
      },
      "contextualBoundary": "BY C13 eA nennt ausgewählte Wechselwirkungstypen. Küpenfärbungsdurchführung ist ein eigener Quelloperator und wird durch diese Modellleistung nicht als erfüllt ausgegeben."
    },
    {
      "goalId": "188bd684-e894-5753-8a50-798220b04d97",
      "currentDescriptionDe": "Die lernende Person kann die wirtschaftliche Bedeutung der Farbstoffe für die Entwicklung der chemischen Industrie beurteilen.",
      "currentDescriptionEn": "The learner can assess the economic significance of dyes for the development of the chemical industry.",
      "scientificDecision": "keep",
      "profileRecommendation": "revise",
      "scientificRationale": "Die Beschreibung bewahrt die reale historisch-wirtschaftliche Beurteilung aus BY C13 eA. Beide aktuell gebundenen P-Fälle sind ausdrücklich erfundene historische/Archivmodelle. Sie üben sinnvolle Mechanismen und Kausalitätskritik, belegen aber für sich keine tatsächliche historische Bedeutung der Farbstoffindustrie. P sollte einen belegten realen historischen Fall mit Herkunft, wirtschaftlichen Größen und Quellenkritik einbinden; fiktive Transferdaten können bleiben. Der D-Text braucht deshalb keine fachliche Verengung.",
      "understanding": {

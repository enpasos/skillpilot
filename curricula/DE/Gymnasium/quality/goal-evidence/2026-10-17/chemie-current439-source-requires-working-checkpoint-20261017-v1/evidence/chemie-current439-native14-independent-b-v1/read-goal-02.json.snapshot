  "P": {
    "archetype": "experiment",
    "expectations": [
      {
        "id": "e1",
        "essentialUnderstandingDe": "Küpenfärbung macht einen schwer löslichen oxidierten Farbstoff durch Reduktion löslich und oxidiert ihn nach Faseraufnahme wieder.",
        "essentialUnderstandingEn": "Vat dyeing reduces an insoluble oxidized dye to a soluble form and reoxidizes it after fiber uptake.",
        "observablePerformanceDe": "Erklärt Reihenfolge, Redoxwechsel und Löslichkeit ohne Stoffumwandlung zu verwechseln.",
        "observablePerformanceEn": "Explains sequence, redox change and solubility without conflating them."
      },
      {
        "id": "e2",
        "essentialUnderstandingDe": "Kontrollen und Sauerstoffkontakt prüfen das Funktionsmodell.",
        "essentialUnderstandingEn": "Controls and oxygen exposure test the operating model.",
        "observablePerformanceDe": "Begründet einen Vergleich und trennt Beobachtung von Interpretation.",
        "observablePerformanceEn": "Justifies a comparison and separates observation from interpretation."
      },
      {
        "id": "e3",
        "essentialUnderstandingDe": "Durchführung erfordert tatsächlich beobachtete sichere Handlungen und ein eigenes Rohprotokoll.",
        "essentialUnderstandingEn": "Execution requires actually observed safe actions and an original raw log.",
        "observablePerformanceDe": "Führt den freigegebenen Mikroversuch unter Aufsicht aus und dokumentiert reale Beobachtungen.",
        "observablePerformanceEn": "Carries out the approved microscale experiment under supervision and records real observations."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [

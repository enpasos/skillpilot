[
  {
    "goalId": "018bec90-445f-4a88-b8bc-228f8335dee6",
    "wholeProfile": {
      "archetype": "data",
      "expectations": [
        {
          "id": "b006-018bec90-core",
          "essentialUnderstandingDe": "Ein Leiter braucht bewegliche Ladungsträger. In Metallfestkörpern sind Elektronen beweglich, in Salzschmelzen und Salzlösungen Ionen; feste Ionengitter und Zuckerlösungen besitzen unter den gegebenen Bedingungen keine ausreichend beweglichen Ladungsträger.",
          "essentialUnderstandingEn": "Conduction requires mobile charge carriers. Metal solids have mobile electrons, molten and dissolved salts have mobile ions; fixed ionic lattices and sugar solution lack sufficiently mobile carriers under the given conditions.",
          "observablePerformanceDe": "Die lernende Person vergleicht vorgegebene Leitfähigkeitsdaten, ordnet Leiter/Nichtleiter bei gleichem Messaufbau ein und begründet Unterschiede auf Teilchenebene; bloß „flüssig“ reicht nicht.",
          "observablePerformanceEn": "The learner compares supplied conductivity data, classifies conductors/nonconductors under the same test setup and explains particle-level differences; being liquid alone is insufficient."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "b006-018bec90-core"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "state",
          "textDe": "Festes Salz, Salzlösung und Schmelze unterscheiden Beweglichkeit vorhandener Ionen.",
          "textEn": "Solid salt, solution and melt differ in mobility of existing ions."
        },
        {
          "id": "substance",
          "textDe": "Metall, Salz und molekulare Zuckerlösung verlangen verschiedene Ladungsträgerannahmen.",
          "textEn": "Metal, salt and molecular sugar solution require different carrier explanations."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "copper-salt-sugar-data",
          "taskDemandDe": "Ein einheitlicher Niederspannungs-Messaufbau liefert für Kupferdraht hohe, festes NaCl sehr geringe, 0,1 mol/L NaCl-Lösung hohe und gleich konzentrierte Zuckerlösung sehr geringe Leitfähigkeit. Ordne und begründe; Messwerte sind vorgegeben.",
          "taskDemandEn": "A common low-voltage setup gives high conductivity for copper wire, very low for solid NaCl, high for 0.1 mol/L NaCl solution and very low for equally concentrated sugar solution. Classify and explain from supplied data.",
          "expectedPerformanceDe": "Kupfer: mobile Elektronen; NaCl fest: Ionen ortsgebunden; NaCl gelöst: Na+ und Cl− beweglich; Zucker bleibt molekular, die Flüssigkeit allein erklärt Leitung nicht.",
          "expectedPerformanceEn": "Copper: mobile electrons; solid NaCl: fixed ions; dissolved NaCl: mobile Na+ and Cl−; sugar remains molecular, and liquid state alone does not explain conduction.",
          "understandingFocusDe": "Stoff- und Zustandsvergleich trennt Beobachtung von Modell.",
          "understandingFocusEn": "Substance and state comparison separates observation from model."
        },
        {
          "id": "molten-salt-paper-transfer",
          "taskDemandDe": "Ein neuer Papierdatensatz vergleicht festes und geschmolzenes KBr sowie reines Ethanol: nur die Schmelze zeigt deutliches Leiten. Erkläre ohne praktisches Erhitzen, warum Wasser nicht nötig ist und Ethanol trotz Flüssigkeit kaum leitet.",
          "taskDemandEn": "A fresh paper data set compares solid and molten KBr with pure ethanol: only the melt conducts appreciably. Without practical heating, explain why water is unnecessary and liquid ethanol scarcely conducts.",
          "expectedPerformanceDe": "In der KBr-Schmelze sind K+ und Br− beweglich, im Feststoff nicht; Ethanol besteht überwiegend aus neutralen Molekülen. Kein Wasser als angeblicher Ionenerzeuger.",
          "expectedPerformanceEn": "K+ and Br− move in the KBr melt but not the solid; ethanol mostly consists of neutral molecules. Water is not falsely invoked as creating the ions.",
          "understandingFocusDe": "Neue Schmelze testet den Ladungsträgermechanismus unabhängig vom Bild.",
          "understandingFocusEn": "A fresh melt tests the carrier mechanism independently of the image."
        }
      ]
    }
  },
  {
    "goalId": "04fa0ba1-eb6e-53c8-93d4-dfa28bb4b162",
    "wholeProfile": {
      "archetype": "concept",
      "expectations": [
        {
          "id": "coupled-electron-roles",
          "essentialUnderstandingDe": "Oxidation ist Elektronenabgabe, Reduktion Elektronenaufnahme. Das Reduktionsmittel gibt Elektronen ab und wird selbst oxidiert; das Oxidationsmittel nimmt Elektronen auf und wird selbst reduziert. Beide Übergänge sind gekoppelt.",
          "essentialUnderstandingEn": "Oxidation is electron loss and reduction electron gain. The reducing agent donates electrons and is itself oxidized; the oxidizing agent accepts electrons and is itself reduced. Both changes are coupled.",
          "observablePerformanceDe": "Die lernende Person verfolgt im gegebenen neuen Teilchenbeispiel die Elektronen, ordnet beide Übergänge und beide Mittel mit Begründung zu und überträgt die Rollen auf andere Teilchen statt Farben oder Stoffnamen auswendig zuzuordnen.",
          "observablePerformanceEn": "The learner tracks electrons in a fresh supplied particle example, assigns both changes and both agents with reasons, and transfers the roles to different species rather than memorizing colours or substance names."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "coupled-electron-roles"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "different-metal-ion-pair",
          "textDe": "Andere Metalle und Metallionen mit vorgegebenem Ladungszustand; Beobachtung und Teilchenmodell unterscheiden.",
          "textEn": "Different metals and metal ions with specified charges; distinguish observation from particle model."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "zinc-copper-supplied-net-reaction",
          "taskDemandDe": "Gegeben ist Zn + Cu²⁺ → Zn²⁺ + Cu; Kupfer wird abgeschieden. Ordne Elektronenabgabe/-aufnahme sowie Oxidations-/Reduktionsmittel zu und begründe die Kopplung.",
          "taskDemandEn": "Given Zn + Cu²⁺ → Zn²⁺ + Cu, copper is deposited. Assign electron loss/gain and the oxidizing/reducing agents, explaining why the changes are coupled.",
          "expectedPerformanceDe": "Zn gibt zwei Elektronen ab: Oxidation, Elektronendonator und Reduktionsmittel. Cu²⁺ nimmt zwei auf: Reduktion, Elektronenakzeptor und Oxidationsmittel. Metallisches Cu ist hier das Reduktionsprodukt, nicht der Akzeptor.",
          "expectedPerformanceEn": "Zn loses two electrons: oxidation, electron donor and reducing agent. Cu²⁺ gains two: reduction, electron acceptor and oxidizing agent. Metallic Cu is the reduction product here, not the acceptor.",
          "understandingFocusDe": "Rollen aus dem Elektronenübergang statt aus dem Namen ableiten.",
          "understandingFocusEn": "Derive roles from electron transfer rather than names."
        },
        {
          "id": "iron-copper-independent-transfer",
          "taskDemandDe": "Ohne gelösten Musterweg ist Fe + Cu²⁺ → Fe²⁺ + Cu vorgegeben. Eine Behauptung lautet: Das Eisen ist das Oxidationsmittel, weil es oxidiert wird. Prüfe sie und erkläre die beiden Elektronenrollen.",
          "taskDemandEn": "Without a worked method, Fe + Cu²⁺ → Fe²⁺ + Cu is supplied. A claim says iron is the oxidizing agent because it is oxidized. Evaluate it and explain both electron roles.",
          "expectedPerformanceDe": "Fe wird durch Abgabe zweier Elektronen oxidiert und wirkt gerade deshalb als Reduktionsmittel; Cu²⁺ ist das Oxidationsmittel und wird reduziert. Die Bezeichnung des Mittels beschreibt seine Wirkung auf den Partner, nicht den eigenen Produktnamen.",
          "expectedPerformanceEn": "Fe is oxidized by losing two electrons and therefore acts as the reducing agent; Cu²⁺ is the oxidizing agent and is reduced. An agent's name describes its effect on the other reactant, not its own product name.",
          "understandingFocusDe": "Frischer Stoffwechsel und begründete Auflösung einer Rollenverwechslung unabhängig vom Bild.",
          "understandingFocusEn": "Fresh species and a reasoned correction of an agent-role confusion independently of the image."
        }
      ]
    }
  },
  {
    "goalId": "1351706f-4ea6-56e9-951b-87b24cbcdee8",
    "wholeProfile": {
      "archetype": "experiment",
      "expectations": [
        {
          "id": "understanding",
          "essentialUnderstandingDe": "Herstellen ist eine beobachtbare Arbeitsroutine. Sie ist vom Erklären der Löslichkeitsgrenze und vom Berechnen eines Mischungsanteils unabhängig prüfbar.",
          "essentialUnderstandingEn": "Preparation is an observable working routine, assessed separately from explaining a solubility limit or calculating a mixture fraction.",
          "observablePerformanceDe": "Ein vollständiger betreuter Aktionslog zeigt getrenntes Tarieren und Abwiegen, vollständiges Übertragen, Rühren, bestätigte Endbeobachtung und Beschriftung nach der bereitgestellten Arbeitsanweisung. Die lernende Person dokumentiert beim alternativen Modul dessen freigegebenes Lösungsmittel und die jeweiligen Schritte; ein Plan ohne durchgeführten Log wird nicht als Ausführung ausgegeben.",
          "observablePerformanceEn": "A complete supervised action log shows separate taring and weighing, complete transfer, stirring, a confirmed final observation and labelling under the supplied instruction. For the alternative module the learner records its permitted solvent and each specified step; a plan without an executed log is not represented as performance."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "understanding"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "changed-conditions",
          "textDe": "In S wählst du versehentlich Wasser statt des freigegebenen ethanolischen Lösungsmittels. Darfst du den erfolgreichen S-Endbefund aus der Vorlage übernehmen?",
          "textEn": "In S you accidentally choose water instead of its permitted ethanolic solvent. May you copy the successful S endpoint from the example?"
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "preparation-salt-water-performed-log",
          "taskDemandDe": "Führe P-1 unter Aufsicht aus oder führe die Simulatoraktionen tatsächlich in der angegebenen Reihenfolge aus. Gib das ausgefüllte Ausführungsprotokoll ab. Eine geplante Schrittfolge oder die Aussage „Salz löst sich“ reicht ohne Durchführung beziehungsweise Simulatorlog nicht aus.",
          "taskDemandEn": "Execute P-1 under supervision or actually issue the simulator actions in sequence. Submit the completed execution log. A planned sequence or “salt dissolves” without execution or a simulator log is insufficient.",
          "expectedPerformanceDe": "Erwartetes erfolgreiches Protokoll: Freigabe geprüft; trockenes Gefäß tariert; 48,0 g Wasser angezeigt; Wasser-Becherglas sicher abgestellt; leere Wägeschale tariert; darin mit sauberem Spatel separat 2,0 g Salz abgewogen und aus der Wägeschale vollständig ins Wasser übertragen; gerührt; Rückmeldung/Beobachtung: keine sichtbaren Kristalle, einheitliche Flüssigkeit ohne getrennte Phase; mit Kochsalzlösung und Datum beschriftet; keine Abweichung. Das ist eine hergestellte Lösung im begrenzten Fall, keine allgemeine Behauptung über beliebige Salz-/Lösungsmittelkombinationen.",
          "expectedPerformanceEn": "Expected successful log: permission checked; dry vessel tared; 48.0 g water displayed; water beaker placed securely; empty weighing dish tared; 2.0 g salt weighed separately in that dish with the clean spatula and transferred completely from the dish into the water; stirred; feedback/observation: no visible crystals, uniform liquid without a separate phase; labelled salt solution and date; no deviation. This documents preparation in the bounded case, not a claim about arbitrary salt/solvent combinations.",
          "understandingFocusDe": "Herstellen ist eine beobachtbare Arbeitsroutine. Sie ist vom Erklären der Löslichkeitsgrenze und vom Berechnen eines Mischungsanteils unabhängig prüfbar.",
          "understandingFocusEn": "Preparation is an observable working routine, assessed separately from explaining a solubility limit or calculating a mixture fraction."
        },
        {
          "id": "preparation-bound-phase-solvent-transfer",
          "taskDemandDe": "Führe die angegebenen Aktionen für L, S und G im moderierten Simulator aus und gib für jedes Modul den vollständigen Aktions-/Rückmeldungslog mit Endbeobachtung und Beschriftung ab. Benenne die jeweils andere Ausgangsphase und das vorgegebene Lösungsmittel. Ersetze keinen Log durch die bloße Behauptung „das ist löslich“.",
          "taskDemandEn": "Execute the specified L, S and G actions in the facilitator-mediated simulator and submit each complete action/feedback log, final observation and label. Identify each changed starting phase and specified solvent. Do not replace a log with the assertion “it is soluble.”",
          "expectedPerformanceDe": "Erwartet werden drei getrennte Logs mit jeweils geprüftem Modul/Freigabe, dem modulspezifischen Lösungsmittel und der vorgeschriebenen Zugabe. L dokumentiert flüssigen Ausgangsstoff in Wasser, danach keine Schlieren; S festen Ausgangsstoff im ethanolischen Lösungsmittel, danach keine Partikel; G gasförmigen Ausgangsstoff in Wasser unter festgehaltenen Modellbedingungen, Kontakt/Mischen/Warten und bestätigte Aufnahme. Alle enden mit inspect und richtiger Beschriftung. Die L-Mengen und Mischhandlung dürfen nicht ungeprüft auf S oder G übertragen werden.",
          "expectedPerformanceEn": "Three separate logs are expected, each with module/permission checked, its specific solvent and prescribed addition. L records a liquid starting substance in water followed by no streaks; S a solid in ethanolic solvent followed by no particles; G a gas in water under fixed model conditions, contact/mixing/waiting and confirmed absorption. Each ends with inspect and its correct label. L’s quantities and mixing action cannot be copied to S or G without using that module’s instruction.",
          "understandingFocusDe": "Herstellen ist eine beobachtbare Arbeitsroutine. Sie ist vom Erklären der Löslichkeitsgrenze und vom Berechnen eines Mischungsanteils unabhängig prüfbar.",
          "understandingFocusEn": "Preparation is an observable working routine, assessed separately from explaining a solubility limit or calculating a mixture fraction."
        }
      ]
    }
  },
  {
    "goalId": "13d4f336-ab16-54a7-9479-c920b458f385",
    "wholeProfile": {
      "archetype": "experiment",
      "expectations": [
        {
          "id": "b004-13d4f336-core",
          "essentialUnderstandingDe": "Schutzregeln haben konkrete Anlässe: Augenschutz gegen Spritzer, freie Arbeitsfläche und geeignete Kennzeichnung gegen Verwechslung sowie Lehrkraftanweisung bei Unsicherheit oder Zwischenfall. Sicheres Arbeiten beginnt vor der Materialhandlung.",
          "essentialUnderstandingEn": "Safety rules address particular risks: eye protection for splashes, clear workspace and labeling against mix-ups, and teacher direction when uncertain or after an incident. Safe work starts before handling materials.",
          "observablePerformanceDe": "Die lernende Person bereitet an einem ungefährlichen, lehrkraftbetreuten Modellplatz ihren Arbeitsplatz vor, prüft Brille und Beschriftung und meldet einen unklaren Behälter, statt eigenmächtig weiterzumachen.",
          "observablePerformanceEn": "At a harmless teacher-supervised model station, the learner prepares the workspace, checks eye protection and labeling, and reports an unclear vessel rather than proceeding independently."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "b004-13d4f336-core"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "phase",
          "textDe": "Vorbereitung und Reaktion auf einen Zwischenfall werden getrennt geprüft.",
          "textEn": "Preparation and response to an incident are tested separately."
        },
        {
          "id": "risk",
          "textDe": "Verwechslung und Spritzer erfordern unterschiedliche unmittelbare Handlungen.",
          "textEn": "Mix-up and splash call for different immediate actions."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "supervised-water-model-station",
          "taskDemandDe": "An einem lehrkraftbetreuten Modellplatz stehen nur Wasser, zwei klar beschriftete Becher und ein unbeschrifteter Becher. Zeige vor Beginn eine sichere Vorbereitung: Schutzbrille korrekt tragen, Arbeitsplatz freimachen, Beschriftung prüfen und den unklaren Becher der Lehrkraft melden; keine Chemikalien oder Flammen.",
          "taskDemandEn": "At a teacher-supervised model station there are only water, two labeled beakers and one unlabeled beaker. Demonstrate safe preparation: wear eye protection correctly, clear the workspace, check labels and report the unlabeled beaker to the teacher; no chemicals or flames.",
          "expectedPerformanceDe": "Die lernende Person führt die sicheren Vorbereitungsschritte tatsächlich aus, verwendet den unbeschrifteten Becher nicht und erläutert die Verwechslungsgefahr.",
          "expectedPerformanceEn": "The learner actually performs the safe preparation, does not use the unlabeled beaker and explains the mix-up risk.",
          "understandingFocusDe": "Beobachtete Anwendung statt Regelaufsagen.",
          "understandingFocusEn": "Observed application rather than rule recitation."
        },
        {
          "id": "fresh-splash-response-card",
          "taskDemandDe": "Eine neue Situationskarte schildert einen unerwarteten Spritzer einer unbekannten Lösung bei einer lehrkraftgeleiteten Schulübung auf Arbeitsfläche und Kleidung; Hautkontakt ist möglich. Entscheide die sofortigen sicheren Schritte für die betroffene Person und begründe, weshalb Du nicht eigenmächtig weiterarbeitest.",
          "taskDemandEn": "A fresh situation card describes an unexpected splash of an unknown solution during a teacher-run school exercise onto the bench and clothing; skin contact is possible. Decide immediate safe steps for the affected person and why you do not continue on your own.",
          "expectedPerformanceDe": "Die lernende Person stoppt die Arbeit, informiert sofort die Lehrkraft und benennt mögliche Haut- und Kleidungskontamination. Betroffene Haut wird unverzüglich mit fließendem Wasser gespült; kontaminierte Kleidung wird unter Lehrkraft-/Ersthelferanweisung zügig abgelegt, ohne weitere Haut zu benetzen. Sie befolgt die örtliche Erste-Hilfe-Regelung und veranlasst nötige weitere Hilfe; sie improvisiert weder Neutralisation noch Entsorgung.",
          "expectedPerformanceEn": "The learner stops work, immediately alerts the teacher and identifies possible skin and clothing contamination. Affected skin is promptly rinsed with running water; contaminated clothing is removed promptly under teacher/first-aider direction without spreading contamination to skin. They follow local first-aid procedures and obtain further help as needed; they do not improvise neutralization or disposal.",
          "understandingFocusDe": "Neue Kontamination prüft sichere Sofortreaktion, einschließlich Haut und Kleidung, nicht bloß Abstand und Meldung.",
          "understandingFocusEn": "A new contamination tests immediate safe action, including skin and clothing, not merely distance and reporting."
        }
      ]
    }
  },
  {
    "goalId": "1bdaf7f2-ff3b-455a-a7fb-95a44642762a",
    "wholeProfile": {
      "archetype": "data",
      "expectations": [
        {
          "id": "closed-system-mass-conservation",
          "essentialUnderstandingDe": "Chemische Reaktionen ordnen Atome neu an; die Masse aller einbezogenen Stoffe bleibt erhalten. Eine Waage zeigt die Erhaltung nur für ein vollständig erfasstes System ohne unberücksichtigten Stoffaustausch unmittelbar.",
          "essentialUnderstandingEn": "Chemical reactions rearrange atoms; the mass of all included substances is conserved. A balance directly shows that conservation only when the whole system is accounted for and no material transfer is ignored.",
          "observablePerformanceDe": "Die lernende Person vergleicht Vorher-nachher-Massen, benennt die mitgewogene Systemgrenze und erklärt scheinbare Abweichungen durch einen möglichen Stoffaustausch, statt das Gesetz als bloßen Merksatz zu wiederholen.",
          "observablePerformanceEn": "The learner compares before-and-after masses, states the weighed system boundary, and explains apparent discrepancies through possible material transfer rather than merely reciting the law."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "closed-system-mass-conservation"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "system-boundary",
          "textDe": "Geschlossenes Gefäß wird mit offenem Gefäß verglichen.",
          "textEn": "A closed vessel is compared with an open vessel."
        },
        {
          "id": "gas-transfer",
          "textDe": "Ein Fall hält das entstehende Gas zurück, der andere lässt es entweichen.",
          "textEn": "One case retains generated gas, while the other allows it to escape."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "sealed-flask-before-after",
          "taskDemandDe": "Ein vorbereitetes Protokoll zeigt eine geschlossene Reaktionsflasche samt Auffangballon mit 150 g vor und 150 g nach einer Gasbildung. Werte die Bilanz aus und erkläre, warum die Masse trotz Gasbildung gleich ist.",
          "taskDemandEn": "A supplied record shows a sealed reaction flask with a collecting balloon weighing 150 g both before and after gas formation. Analyze the balance and explain why the mass remains equal despite gas formation.",
          "expectedPerformanceDe": "Die lernende Person vergleicht 150 g mit 150 g für dasselbe gesamte System, erfasst das Gas im Ballon und erklärt, dass keine Atome verschwinden, sondern Stoffe und Teilchen neu angeordnet werden.",
          "expectedPerformanceEn": "The learner compares 150 g with 150 g for the same complete system, includes gas held in the balloon, and explains that atoms do not disappear but are rearranged into different substances and particles.",
          "understandingFocusDe": "Die Massenbilanz gilt für das vollständig mitgewogene System.",
          "understandingFocusEn": "The mass balance applies to the entire weighed system."
        },
        {
          "id": "fresh-open-gas-loss",
          "taskDemandDe": "In einem neuen bereitgestellten Versuch reagiert ein Stoff in einer offenen Schale unter Gasbildung; auf der Waage sinkt die Masse der Schale samt Inhalt von 80 g auf 77 g. Bedeutet das eine Verletzung der Massenerhaltung? Sage die Bilanz für eine vollständig geschlossene Anordnung voraus.",
          "taskDemandEn": "In a fresh supplied experiment, a substance reacts in an open dish and releases gas; the measured dish and contents fall from 80 g to 77 g. Does this violate conservation of mass? Predict the balance for a fully closed arrangement.",
          "expectedPerformanceDe": "Die lernende Person erklärt die 3 g Differenz als möglicherweise entwichene Gasmasse unter der angegebenen Systemgrenze, ohne deren Zusammensetzung zu erfinden. Für eine vollständig geschlossene und mitgewogene Anordnung erwartet sie wieder gleiche Gesamtmassen.",
          "expectedPerformanceEn": "The learner explains the 3 g difference as potentially escaped gas under the stated boundary without inventing its composition, and expects equal total masses for a fully closed, wholly weighed arrangement.",
          "understandingFocusDe": "Eine scheinbare Abnahme ist mit Erhaltung vereinbar, wenn Masse die Messgrenze verlassen hat.",
          "understandingFocusEn": "An apparent decrease is compatible with conservation when mass has left the measured boundary."
        }
      ]
    }
  },
  {
    "goalId": "326d45bf-9f77-57d5-a054-93e76b034dd5",
    "wholeProfile": {
      "archetype": "concept",
      "expectations": [
        {
          "id": "b004t-326d-observed-states-and-identity",
          "essentialUnderstandingDe": "Feste Stoffproben behalten unter Alltagsbedingungen ihre Form, Flüssigkeiten fließen und passen sich der Gefäßform an, Gase verteilen sich im verfügbaren Raum. Beim Schmelzen und Erstarren, bei Übergängen zwischen Flüssigkeit und Gas und bei direkten fest-gasförmigen Übergängen ändert ein benannter Stoff seinen Zustand; die Zustandsänderung allein macht daraus keinen anderen Stoff. Sieden mit Blasenbildung im Flüssigkeitsinneren unterscheidet sich vom Verdunsten an der Oberfläche.",
          "essentialUnderstandingEn": "Solid samples retain their shape under ordinary conditions, liquids flow and take the shape of a container, and gases spread through the available space. Melting and freezing, changes between liquid and gas, and direct solid-gas changes alter the state of an identified substance; a change of state alone does not make it a different substance. Boiling with bubbles throughout the liquid differs from evaporation at its surface.",
          "observablePerformanceDe": "Die lernende Person ordnet vorgegebene Beobachtungen einem festen, flüssigen oder gasförmigen Zustand zu, benennt Ausgangs- und Endzustand samt passendem Übergang und begründet anhand der Stoffangaben, warum beim Übergang derselbe Stoff vorliegt. Bei flüssig zu gasförmig unterscheidet sie Sieden von Verdunsten anhand des Beobachtungsorts.",
          "observablePerformanceEn": "The learner assigns supplied observations to solid, liquid or gaseous states, names initial and final states and the matching transition, and uses material information to justify that the substance remains the same. For liquid-to-gas changes, the learner distinguishes boiling from evaporation by where the change is observed."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "b004t-326d-observed-states-and-identity"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "observable-state-properties",
          "textDe": "Beobachtungen zu Form, Fließen und Raumerfüllung ersetzen vorgegebene Zustandsnamen; keine Teilchenerklärung ist nötig.",
          "textEn": "Observations of shape, flow and filling space replace supplied state labels; no particle-level explanation is needed."
        },
        {
          "id": "transition-direction-and-place",
          "textDe": "Richtungen fest-flüssig, flüssig-gasförmig und direkt fest-gasförmig sowie Sieden im Volumen gegenüber Verdunsten an der Oberfläche variieren.",
          "textEn": "Solid-liquid, liquid-gas and direct solid-gas directions vary, as does boiling throughout the liquid versus evaporation at its surface."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "water-observation-sequence",
          "taskDemandDe": "Ohne Bild liegen Beobachtungsnotizen zu reinem Wasser vor. A behält als Eisstück seine eigene Form; nach Erwärmen fließt es und nimmt die Form eines Bechers an; beim Abkühlen wird daraus wieder ein formfestes Stück. Ein dünner Wasserfilm auf einer nicht saugenden Unterlage wird ohne Blasen langsam weniger; die Messnotizen weisen Wasserdampf über ihm nach. Eine andere, offene Wasserprobe bildet beim Erwärmen Blasen im Inneren; über ihr entstehen an einer kühlen Oberfläche Wassertropfen. Ordne die beobachteten Zustände und Übergänge zu, begründe Sieden gegenüber Verdunsten mit dem Ort der Beobachtung und erkläre, welche Angabe die Stoffidentität über die Änderungen hinweg stützt. Es ist eine Datenauswertung, kein Versuch.",
          "taskDemandEn": "Without a diagram, notes describe pure water. A keeps its own shape as a piece of ice; after warming it flows and takes a beaker’s shape; cooling makes it a shape-retaining piece again. A thin water film on a non-absorbent surface slowly diminishes without bubbles, and the supplied readings detect water vapour above it. Another open water sample forms bubbles inside when heated; water droplets form on a cool surface above it. Identify the observed states and transitions, distinguish boiling from evaporation using where each is seen, and explain what information supports the same substance throughout. This is data interpretation, not an experiment.",
          "expectedPerformanceDe": "Das formfeste Eis ist fest, das fließende Wasser flüssig und der nachgewiesene Wasserdampf gasförmig. Eis wird beim Erwärmen zu flüssigem Wasser (Schmelzen), beim Abkühlen wieder fest (Erstarren). Der Film verdunstet an der Oberfläche; die Blasen im Flüssigkeitsinneren zeigen Sieden. Wasserdampf kondensiert an der kühlen Oberfläche zu flüssigen Tropfen. Die Notizen benennen die Probe als reines Wasser und verfolgen sie durch die Zustandswechsel; daraus folgt in diesem Fall dieselbe Stoffidentität, nicht ein neuer Stoff allein aus geänderter Form.",
          "expectedPerformanceEn": "The shape-retaining ice is solid, flowing water is liquid, and the detected water vapour is gaseous. Warming ice produces liquid water by melting; cooling freezes it again. The film evaporates at its surface, while bubbles inside the liquid indicate boiling. Water vapour condenses to liquid droplets on the cool surface. The notes identify and follow one pure water sample through the state changes, supporting the same substance here rather than a new substance from changed form alone.",
          "understandingFocusDe": "Drei Zustände aus beobachtbaren Eigenschaften erkennen, mehrere Richtungen deuten und Sieden/Verdunsten ohne Bild unterscheiden.",
          "understandingFocusEn": "Recognise three states from observable properties, interpret several transition directions and distinguish boiling from evaporation without an image."
        },
        {
          "id": "carbon-dioxide-direct-transition-data",
          "taskDemandDe": "Eine Lehrkraft stellt nur Messnotizen zu einer gekennzeichneten reinen Kohlenstoffdioxidprobe aus fachgerecht belüfteten Beobachtungen bei Normaldruck bereit: Ein formfestes Stück wird kleiner, während sich ein farbloses, als Kohlenstoffdioxid nachgewiesenes Gas darüber ausbreitet; die durchgehende Beobachtung zeigt keine Flüssigkeit. Bei einer späteren Abkühlung desselben Gases an einer ausreichend kalten Oberfläche entsteht direkt ein fester Belag; auch hier zeigt die durchgehende Beobachtung weder Tropfen noch einen Flüssigkeitsfilm. Die bereitgestellte Stoffanalyse weist den Belag ebenfalls als Kohlenstoffdioxid aus. Ordne die Zustände und beide direkten Übergänge zu und begründe mit den Proben- und Analysedaten, weshalb dieselbe Stoffart vor und nach den Übergängen vorliegt. Lernende führen keinen Versuch durch.",
          "taskDemandEn": "A teacher supplies measurement notes only for a labelled pure carbon dioxide sample from appropriately ventilated observations at ordinary pressure: a shape-retaining piece shrinks while a colourless gas identified as carbon dioxide spreads above it; continuous observation shows no liquid. When the same gas is later cooled at a sufficiently cold surface, a solid deposit forms directly; continuous observation again shows neither droplets nor a liquid film. The supplied material analysis also identifies the deposit as carbon dioxide. Identify the states and both direct transitions, and use the sample and analysis information to justify the same substance before and after the changes. Learners do not perform the procedure.",
          "expectedPerformanceDe": "Das formfeste Stück und der Belag sind fest; das sich ausbreitende Gas ist gasförmig. Der direkte Weg fest zu gasförmig heißt Sublimieren, der Rückweg gasförmig zu fest Resublimieren. Die gekennzeichnete reine Ausgangsprobe sowie die Analysen von Gas und Belag weisen Kohlenstoffdioxid aus. Die durchgehenden Beobachtungen schließen in beiden Fällen eine flüssige Zwischenphase aus; die Daten stützen somit Zustandsänderungen derselben Stoffart. Eine allgemeine Reaktionsdiagnose ist nicht gefordert.",
          "expectedPerformanceEn": "The shape-retaining piece and deposit are solid; the spreading gas is gaseous. The direct solid-to-gas change is sublimation, and the reverse gas-to-solid change is deposition. The labelled pure starting sample and the analyses of gas and deposit all identify carbon dioxide. Continuous observations exclude a liquid intermediate in both cases, supporting state changes of the same substance. A general reaction diagnosis is not required.",
          "understandingFocusDe": "Neuer Stoffkontext mit beobachtbarer Zustandszuordnung und direktem Übergang; Stoffidentität wird aus gelieferten Daten begründet.",
          "understandingFocusEn": "A new substance context with state assignment from observations and a direct transition; substance identity is justified from supplied data."
        }
      ]
    }
  },
  {
    "goalId": "363c5740-8a3c-50b8-8c3a-5548c80c36ea",
    "wholeProfile": {
      "archetype": "modeling",
      "expectations": [
        {
          "id": "structure-model-reasoning",
          "essentialUnderstandingDe": "Bei koordinativer Bindungsbildung stellt ein besetztes nichtbindendes Liganden-Donororbital ein freies Elektronenpaar bereit; ein energetisch geeignetes unbesetztes Orbital am Zentralatom oder Zentralion übernimmt im vorgegebenen qualitativen Modell die Akzeptorrolle. Herkunft des Paars und gemeinsame Bindung sind zu unterscheiden.",
          "essentialUnderstandingEn": "In coordinate-bond formation an occupied ligand nonbonding donor orbital supplies a lone pair; an energetically suitable unoccupied orbital at the central atom or ion takes the acceptor role in the supplied qualitative model. Pair origin and shared bond must be distinguished.",
          "observablePerformanceDe": "Die Person identifiziert im vorgegebenen Kupfer(II)-Tartrat-Ausschnitt das Liganden-O, sein besetztes Donororbital und das ausdrücklich dargestellte unbesetzte Zentralion-Akzeptororbital, erläutert deren Wechselwirkung bei Bindungsbildung und die Rolle der Tartratkomplexierung in der Fehling-Lösung. Das Modell behauptet keine vollständige Komplexgeometrie oder leere Gesamtheit der Cu(II)-d-Orbitale.",
          "observablePerformanceEn": "In the supplied copper(II)-tartrate fragment the learner identifies ligand O, its occupied donor orbital and the explicitly represented unoccupied central-ion acceptor orbital, explains their interaction in bond formation and tartrate complexation in Fehling solution. The model claims neither a complete complex geometry nor that all Cu(II) d orbitals are empty."
        },
        {
          "id": "fresh-application-and-boundary",
          "essentialUnderstandingDe": "Ein vereinfachter Bindungsausschnitt beweist keine eindeutige vollständige Komplexformel; Komplexbildung ist nicht identisch mit der späteren Cu(II)-Reduktion zu Cu2O.",
          "essentialUnderstandingEn": "A simplified bond fragment establishes no unique full complex formula; complex formation is not the subsequent Cu(II) reduction to Cu2O.",
          "observablePerformanceDe": "A liefert im vorgegebenen Modell die benötigte Paarquelle, B nicht. Die Pfeildarstellung einer koordinativen Bindung beschreibt Paarherkunft, nicht automatisch Änderung der Oxidationsstufe. Die spätere Fehling-Redoxreaktion erzeugt Cu(I) in Cu2O; der Ausschnitt allein legt Anzahl/Anordnung aller Liganden nicht fest. HE Q1.2 nennt koordinative Bindung im erhöhten Niveau. Das Profil behauptet keine GK-Pflicht oder empirisch geprüfte vollständige Komplexstruktur.",
          "observablePerformanceEn": "A supplies the required pair in the specified model, B does not. A coordinate-bond arrow describes pair origin, not an automatic change in oxidation state. Later Fehling redox produces Cu(I) in Cu2O; the fragment alone does not determine every ligand number or arrangement. HE Q1.2 lists coordinate bonding at advanced level. The profile claims neither a GK obligation nor an empirically verified full complex structure."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "structure-model-reasoning",
          "fresh-application-and-boundary"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "material-variation",
          "textDe": "Ligand mit/ohne verfügbares Elektronenpaar, Koordination versus Redoxnachweis, fragmentarisches Modell versus ganze Komplexstöchiometrie.",
          "textEn": "Ligand with/without an available lone pair, coordination versus redox test, fragmentary model versus full complex stoichiometry."
        },
        {
          "id": "counterexample",
          "textDe": "Ein vereinfachter Bindungsausschnitt beweist keine eindeutige vollständige Komplexformel; Komplexbildung ist nicht identisch mit der späteren Cu(II)-Reduktion zu Cu2O.",
          "textEn": "A simplified bond fragment establishes no unique full complex formula; complex formation is not the subsequent Cu(II) reduction to Cu2O."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "chem-current15-363c5740-case-1",
          "taskDemandDe": "Ein ausdrücklich vereinfachter Ausschnitt zeigt Cu2+ neben einem O-Donoratom des Tartratliganden mit freiem Elektronenpaar. Es wird keine vollständige Strukturformel eines einzigen Fehling-Komplexes vorgegeben. Im zusätzlich vorgegebenen qualitativen Orbitalmodell ist das nichtbindende Donororbital am Liganden-O mit einem Elektronenpaar besetzt; am Zentralion wird ein energetisch geeignetes unbesetztes Akzeptororbital schematisch dargestellt. Das Modell behauptet weder, dass alle Cu(II)-d-Orbitale leer sind, noch eine bestimmte vollständige Komplexgeometrie. Zeichne den Elektronenpaarbeitrag zur Bindung und erläutere die Donator-/Akzeptorrolle und den Zweck der Tartratkomplexierung. Ordne dabei das besetzte Liganden-Donororbital und das unbesetzte Zentralion-Akzeptororbital ausdrücklich zu und erkläre, warum beide für das Modell der Bindungsbildung benötigt werden.",
          "taskDemandEn": "An explicitly simplified fragment shows Cu2+ beside a tartrate-ligand O donor with a lone pair. No full structural formula of a unique Fehling complex is supplied. In the additionally supplied qualitative orbital model, the ligand-O nonbonding donor orbital contains an electron pair; an energetically suitable unoccupied acceptor orbital is represented schematically at the central ion. The model claims neither that all Cu(II) d orbitals are empty nor a particular complete complex geometry. Draw the electron-pair contribution to the bond, explain donor/acceptor roles and the purpose of tartrate complexation. Explicitly identify the occupied ligand donor orbital and unoccupied central-ion acceptor orbital and explain why both are needed in the bond-formation model.",
          "expectedPerformanceDe": "Das O-Paar wird zum akzeptierenden Cu(II)-Zentralion gerichtet; der Ligand ist Elektronenpaardonator. Die Tartratkomplexierung hält Kupfer(II) in der alkalischen Fehling-Lösung löslich und vermeidet die einfache Fällung als Cu(OH)2. Dieser Schritt allein reduziert Cu(II) nicht zu Cu(I). Im vorgegebenen Modell ist das besetzte nichtbindende Ligandenorbital die Paarquelle, das unbesetzte passende Zentralionorbital der Akzeptor; ihre Wechselwirkung erklärt die Ausbildung der gemeinsamen Bindung. Aus dem schematischen Akzeptororbital folgt keine Aussage, dass sämtliche Metall-d-Orbitale leer seien.",
          "expectedPerformanceEn": "The O pair is directed towards accepting central Cu(II); the ligand is electron-pair donor. Tartrate complexation keeps Cu(II) soluble in alkaline Fehling solution, avoiding simple Cu(OH)2 precipitation. This step alone does not reduce Cu(II) to Cu(I). In the supplied model the occupied ligand nonbonding orbital is the pair source and the suitable unoccupied central-ion orbital the acceptor; their interaction explains formation of the shared bond. The schematic acceptor orbital does not imply that all metal d orbitals are empty.",
          "understandingFocusDe": "Nicht behaupten, dass zwei Elektronen aus dem Liganden als freie Ladung auf das Zentralion übertragen werden; Koordination wird als Bindungsmodell erläutert.",
          "understandingFocusEn": "Do not claim that two ligand electrons are transferred as free charge onto the central ion; coordination is explained as a bond model."
        },
        {
          "id": "chem-current15-363c5740-case-2",
          "taskDemandDe": "Frischer Modellvergleich: Ausschnitt A enthält einen Liganden mit verfügbarem O-Elektronenpaar; Ausschnitt B zeigt nur eine gesättigte C-H-Gruppe ohne angegebenes verfügbares Donorpaar. Ein Text setzt den Koordinationspfeil mit Cu2+ → Cu+ gleich. Beurteile beide Donorangebote und korrigiere die Gleichsetzung mit der Redoxreaktion. Nenne die Grenze des Fragmentmodells.",
          "taskDemandEn": "Fresh model comparison: fragment A has a ligand with an available O lone pair; fragment B shows only a saturated C-H group without an available donor pair. A text equates the coordination arrow with Cu2+ → Cu+. Assess both donor proposals and correct the identification with a redox reaction. State the fragment model limitation.",
          "expectedPerformanceDe": "A liefert im vorgegebenen Modell die benötigte Paarquelle, B nicht. Die Pfeildarstellung einer koordinativen Bindung beschreibt Paarherkunft, nicht automatisch Änderung der Oxidationsstufe. Die spätere Fehling-Redoxreaktion erzeugt Cu(I) in Cu2O; der Ausschnitt allein legt Anzahl/Anordnung aller Liganden nicht fest.",
          "expectedPerformanceEn": "A supplies the required pair in the specified model, B does not. A coordinate-bond arrow describes pair origin, not an automatic change in oxidation state. Later Fehling redox produces Cu(I) in Cu2O; the fragment alone does not determine every ligand number or arrangement.",
          "understandingFocusDe": "HE Q1.2 nennt koordinative Bindung im erhöhten Niveau. Das Profil behauptet keine GK-Pflicht oder empirisch geprüfte vollständige Komplexstruktur.",
          "understandingFocusEn": "HE Q1.2 lists coordinate bonding at advanced level. The profile claims neither a GK obligation nor an empirically verified full complex structure."
        }
      ]
    }
  },
  {
    "goalId": "416dfd33-8b43-5c49-903c-9847b95e4208",
    "wholeProfile": {
      "archetype": "experiment",
      "expectations": [
        {
          "id": "e1",
          "essentialUnderstandingDe": "Masse und Volumen brauchen passende Geräte und eindeutige Einheiten.",
          "essentialUnderstandingEn": "Mass and volume need suitable apparatus and explicit units.",
          "observablePerformanceDe": "Tara und Einwaage tatsächlich korrekt vorführen; notierte Masse mit Einheit statt abgeschriebener Sollmenge. Geeignete Geräte bereitstellen, beschriften und Messbereich passend wählen.",
          "observablePerformanceEn": "Actually demonstrate taring and weighing; record mass with units rather than copying the target. Prepare and label suitable apparatus and choose an appropriate range."
        },
        {
          "id": "e2",
          "essentialUnderstandingDe": "Sachgerechtes Übertragen und Trennen ist eine beobachtbare Handlung.",
          "essentialUnderstandingEn": "Appropriate transfer and separation are observable actions.",
          "observablePerformanceDe": "Volumen auf Augenhöhe ablesen und Filter passend einsetzen; kein Überlaufen oder Vermischen beschrifteter Gefäße. Absetzen, langsames Abgießen und Saugballpipette tatsächlich sachgerecht zeigen.",
          "observablePerformanceEn": "Read at eye level and fit the filter; avoid overflow or mixing labelled vessels. Actually demonstrate settling, slow decanting and bulb pipetting."
        },
        {
          "id": "e3",
          "essentialUnderstandingDe": "Ein Originalprotokoll trennt eigene Beobachtungen von fremden Lehrdaten.",
          "essentialUnderstandingEn": "An original record distinguishes own observations from external practice data.",
          "observablePerformanceDe": "Eigenes Protokoll enthält Reihenfolge und rohe Beobachtungen; Lehrdaten sind als fremde Übungsdaten markiert. Übertragenes Volumen und Rest mit Einheit sowie Verluste unmittelbar dokumentieren.",
          "observablePerformanceEn": "Own record contains sequence and raw observations; practice data are marked as external. Immediately record transferred and residual volumes with units and losses."
        },
        {
          "id": "e4",
          "essentialUnderstandingDe": "Klarheit, Stoffreinheit und Rückgewinnung sind verschiedene Aussagen.",
          "essentialUnderstandingEn": "Clarity, purity and recovery are different claims.",
          "observablePerformanceDe": "Klarheit von Stoffreinheit unterscheiden und erklären, weshalb Salz durch den Filter gelangt. Begründen, warum fehlende vollständige Rückgewinnung und ungenaue Tropfenzahl keine sichere Messfehlerdiagnose erlauben.",
          "observablePerformanceEn": "Distinguish clarity from purity and explain why salt passes through paper. Explain why incomplete recovery and an imprecise drop count do not uniquely diagnose a reading error."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "e1",
          "e2",
          "e3",
          "e4"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "chemically-meaningful-change",
          "textDe": "Ein neuer Ansatz enthält statt Sand löslichen Zucker. Wähle selbst, ob Filtration noch einen Rückstand liefern sollte, und führe einen entsprechend begründeten Kontrollansatz aus. Erhalte frisch ein Gemisch mit fein verteiltem Sand, das nach 2 min noch trüb ist. Entscheide ohne Methodenvorgabe, wie du klares Wasser gewinnst, und demonstriere die angepasste Handhabung.",
          "textEn": "A fresh batch contains soluble sugar instead of sand. Independently decide whether filtration should retain a solid and carry out a justified control. Receive a fresh mixture of fine sand still cloudy after two minutes. Without a method cue, choose how to obtain clear liquid and demonstrate the adapted handling."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "lab15-01-a",
          "taskDemandDe": "Vollständige eigene Materialien, Protokoll und Daten: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-laboratory-communication-fifteen-current419-whole-author-20261015-v1/materials/thirty-complete-DE-EN-cases.author.json #lab15-01-a. Führe den Ansatz aus und protokolliere deine tatsächlich verwendeten Mengen und Arbeitsschritte. Ordne die Lehrdaten getrennt als Vergleich ein. Erkläre, warum klares Filtrat nicht automatisch reines Wasser ist. Demonstriere anschließend eine eigene korrekte Volumenablesung, ohne die Zahl eines anderen abzuschreiben.",
          "taskDemandEn": "Complete original materials, protocol and data: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-laboratory-communication-fifteen-current419-whole-author-20261015-v1/materials/thirty-complete-DE-EN-cases.author.json #lab15-01-a. Carry out the batch and record your actual quantities and actions. Mark supplied practice data separately for comparison. Explain why clear filtrate need not be pure water. Then demonstrate an independent correct volume reading without copying another person’s value.",
          "expectedPerformanceDe": "Die Waage misst Masse; der Zylinder das Flüssigkeitsvolumen. Der unten liegende Meniskus wird bei Wasser auf Augenhöhe gelesen. Sand bleibt wegen seiner Teilchengröße im Filter, gelöstes Salz passiert mit Wasser. Trübung und Klarheit sind Beobachtungen; gelöstes Salz ist eine begründete Deutung. Nasse Rückstandsmasse wäre keine trockene Sandmasse. Tatsächliche Geschicklichkeit und Dokumentation bleiben bis zur Ausführung unbeobachtet.",
          "expectedPerformanceEn": "The balance measures mass; the cylinder measures liquid volume. Read the bottom of a water meniscus at eye level. Sand is retained by particle size, while dissolved salt passes with water. Cloudiness and clarity are observations; dissolved salt is an inference. Wet residue mass is not dry sand mass. Actual handling and documentation remain unobserved until performance.",
          "understandingFocusDe": "Gebundenes Fallmaterial sha256:237164761cab4389b6d3de236f3193c7708b5db0116db47cb660cf08feea7c5d. Ein neuer Ansatz enthält statt Sand löslichen Zucker. Wähle selbst, ob Filtration noch einen Rückstand liefern sollte, und führe einen entsprechend begründeten Kontrollansatz aus.",
          "understandingFocusEn": "Bound case material sha256:237164761cab4389b6d3de236f3193c7708b5db0116db47cb660cf08feea7c5d. A fresh batch contains soluble sugar instead of sand. Independently decide whether filtration should retain a solid and carry out a justified control."
        },
        {
          "id": "lab15-01-b",
          "taskDemandDe": "Vollständige eigene Materialien, Protokoll und Daten: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-laboratory-communication-fifteen-current419-whole-author-20261015-v1/materials/thirty-complete-DE-EN-cases.author.json #lab15-01-b. Zeige Dekantieren und dosiertes Pipettieren selbst. Notiere die tatsächlich übertragenen Volumina, unerwünschte Körner und Restflüssigkeit. Begründe die Wahl gegenüber sofortigem kräftigem Ausgießen. Kannst du aus zurückbleibender Flüssigkeit auf falsche Volumenablesung schließen?",
          "taskDemandEn": "Complete original materials, protocol and data: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-laboratory-communication-fifteen-current419-whole-author-20261015-v1/materials/thirty-complete-DE-EN-cases.author.json #lab15-01-b. Demonstrate decanting and controlled pipetting yourself. Record actual transferred volumes, unwanted grains and residual liquid. Justify the choice over immediate vigorous pouring. Does residual liquid prove an incorrect volume reading?",
          "expectedPerformanceDe": "Absetzen ermöglicht die Trennung eines Überstands von großen dichten Körnern; Flüssigkeitsreste sind beabsichtigt und beschränken Rückgewinnung. Eine Tropfpipette dosiert, ist aber kein kalibriertes Präzisionsmessgerät. Restflüssigkeit allein beweist keinen Ablesefehler; Benetzung, bewusster Rest und Verschütten sind verschieden. Eigenes Protokoll muss reale Abweichungen enthalten.",
          "expectedPerformanceEn": "Settling allows supernatant to be separated from large dense grains; leaving liquid is intentional and limits recovery. A dropper dispenses but is not a calibrated precision measuring device. Residual liquid alone does not prove a reading error; wetting, a deliberate remainder and spillage differ. The original record must retain actual deviations.",
          "understandingFocusDe": "Gebundenes Fallmaterial sha256:237164761cab4389b6d3de236f3193c7708b5db0116db47cb660cf08feea7c5d. Erhalte frisch ein Gemisch mit fein verteiltem Sand, das nach 2 min noch trüb ist. Entscheide ohne Methodenvorgabe, wie du klares Wasser gewinnst, und demonstriere die angepasste Handhabung.",
          "understandingFocusEn": "Bound case material sha256:237164761cab4389b6d3de236f3193c7708b5db0116db47cb660cf08feea7c5d. Receive a fresh mixture of fine sand still cloudy after two minutes. Without a method cue, choose how to obtain clear liquid and demonstrate the adapted handling."
        }
      ]
    }
  },
  {
    "goalId": "4285d84a-2c9a-4d51-8250-8bed4daf2d2e",
    "wholeProfile": {
      "archetype": "concept",
      "expectations": [
        {
          "id": "content-specific-understanding",
          "essentialUnderstandingDe": "Ionen tragen durch Elektronenabgabe/-aufnahme elektrische Ladung; in Salzlösungen transportieren bewegliche Kationen und Anionen Ladung, im festen Ionengitter bleiben sie gebunden.",
          "essentialUnderstandingEn": "Ions carry charge after electron loss/gain; mobile cations and anions transport charge in salt solutions, whereas ions remain bound in the solid lattice.",
          "observablePerformanceDe": "Na+ Kation, Cl− Anion; Protonenzahl unverändert. Gelöste Na+ wandern zum negativen, Cl− zum positiven Pol; beide tragen zum Ladungstransport bei. Im festen Gitter fehlt diese freie Ionenbeweglichkeit.",
          "observablePerformanceEn": "Na+ is cation, Cl− anion; proton counts remain unchanged. Dissolved Na+ migrates to the negative and Cl− to the positive pole; both contribute to charge transport. Solid-lattice ions lack this mobility."
        },
        {
          "id": "fresh-transfer-and-model-boundary",
          "essentialUnderstandingDe": "Geringe Leitfähigkeit der konkreten Zuckerlösung beweist nicht, dass jede molekulare Verbindung in Wasser un-ionisiert bleibt; Säuren bilden eine andere Fallgrenze.",
          "essentialUnderstandingEn": "Low conductivity in this sugar case does not establish that every molecular compound stays un-ionised in water; acids are a different case.",
          "observablePerformanceDe": "2+(−1)+(−1)=0. Mg2+ wandert zum negativen, Cl− zum positiven Pol; im Vergleich sind mobile Ladungsträger im Salzfall vorhanden. Zuckermoleküle liefern hier keine solchen Ionen. Beim Salzlösen werden vorhandene Gitterionen hydratisiert, keine Protonen umgewandelt.",
          "observablePerformanceEn": "2+(−1)+(−1)=0. Mg2+ moves towards the negative, Cl− the positive pole; the salt case has mobile carriers. Sugar molecules here do not supply such ions. Dissolution hydrates existing lattice ions rather than transforming protons."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "content-specific-understanding",
          "fresh-transfer-and-model-boundary"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "specific-material-variation",
          "textDe": "Na+/Cl− gegenüber Mg2+/Cl−; ionische und nichtionische Lösung, fest und gelöst.",
          "textEn": "Na+/Cl− versus Mg2+/Cl−; ionic versus nonionic solution, solid versus dissolved."
        },
        {
          "id": "specific-model-limit",
          "textDe": "Geringe Leitfähigkeit der konkreten Zuckerlösung beweist nicht, dass jede molekulare Verbindung in Wasser un-ionisiert bleibt; Säuren bilden eine andere Fallgrenze.",
          "textEn": "Low conductivity in this sugar case does not establish that every molecular compound stays un-ionised in water; acids are a different case."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "chem-next25-4285d84a-case-1",
          "taskDemandDe": "Modell:Na verliert1 Elektron, Cl nimmt1 auf. Vorgegebene Beobachtung: festes NaCl geringe Leitfähigkeit, NaCl-Lösung deutlich höhere. Elektrolysezelle: links negativer, rechts positiver Pol. Erkläre Ladungsbildung, benenne die Ionen und zeichne ihre Wanderungsrichtungen im elektrischen Feld.",
          "taskDemandEn": "Model:Na loses1 electron, Cl gains1. Supplied observation: solid NaCl poorly conducts; its solution conducts much better. Electrolysis cell: left negative, right positive pole. Explain charge formation, name the ions and draw migration directions in the electric field.",
          "expectedPerformanceDe": "Na+ Kation, Cl− Anion; Protonenzahl unverändert. Gelöste Na+ wandern zum negativen, Cl− zum positiven Pol; beide tragen zum Ladungstransport bei. Im festen Gitter fehlt diese freie Ionenbeweglichkeit.",
          "expectedPerformanceEn": "Na+ is cation, Cl− anion; proton counts remain unchanged. Dissolved Na+ migrates to the negative and Cl− to the positive pole; both contribute to charge transport. Solid-lattice ions lack this mobility.",
          "understandingFocusDe": "Strom in der Lösung bedeutet nicht, dass freie Elektronen wie in einem Metalldraht durch Wasser laufen.",
          "understandingFocusEn": "Current in solution does not mean free electrons flowing through water as through a metal wire."
        },
        {
          "id": "chem-next25-4285d84a-case-2",
          "taskDemandDe": "Frischer Vergleich:MgCl2-Lösung enthält Mg2+ und2Cl− pro Verhältnisformel. Eine Zuckerlösung enthält hier ungeladene gelöste Moleküle, kein vorgegebenes Ionisationsmodell. Bilanzierte Ladungen, Richtung beider Ionen und einen begründeten Leitfähigkeitsvergleich angeben. Trenne Lösen eines Salzes von Bildung neuer Atom-Ionen aus Elementen.",
          "taskDemandEn": "Fresh comparison:MgCl2 solution contains Mg2+ and2Cl− per formula unit. The sugar solution here has uncharged dissolved molecules and no supplied ionisation model. Give balanced charges, directions of both ions and a justified conductivity comparison. Distinguish dissolving a salt from forming new atomic ions from elements.",
          "expectedPerformanceDe": "2+(−1)+(−1)=0. Mg2+ wandert zum negativen, Cl− zum positiven Pol; im Vergleich sind mobile Ladungsträger im Salzfall vorhanden. Zuckermoleküle liefern hier keine solchen Ionen. Beim Salzlösen werden vorhandene Gitterionen hydratisiert, keine Protonen umgewandelt.",
          "expectedPerformanceEn": "2+(−1)+(−1)=0. Mg2+ moves towards the negative, Cl− the positive pole; the salt case has mobile carriers. Sugar molecules here do not supply such ions. Dissolution hydrates existing lattice ions rather than transforming protons.",
          "understandingFocusDe": "Geringe Leitfähigkeit der konkreten Zuckerlösung beweist nicht, dass jede molekulare Verbindung in Wasser un-ionisiert bleibt; Säuren bilden eine andere Fallgrenze.",
          "understandingFocusEn": "Low conductivity in this sugar case does not establish that every molecular compound stays un-ionised in water; acids are a different case."
        }
      ]
    }
  },
  {
    "goalId": "448815cc-4127-54b7-96bf-e54b3d2a38c5",
    "wholeProfile": {
      "archetype": "concept",
      "expectations": [
        {
          "id": "structure-model-reasoning",
          "essentialUnderstandingDe": "Metallbindung, Ionenbindung und Elektronenpaarbindung unterscheiden sich in Teilchen, Ladungen und Elektronenorganisation; Bindungsmodelle erklären ausgewählte Eigenschaften.",
          "essentialUnderstandingEn": "Metallic, ionic and covalent bonding differ in particles, charges and electron organization; bonding models explain selected properties.",
          "observablePerformanceDe": "Die Person erklärt die Modellbilder für Cu, NaCl und Cl2 und begründet Beweglichkeit von Ladungsträgern statt nur Stoffnamen zuzuordnen.",
          "observablePerformanceEn": "The learner explains model diagrams for Cu, NaCl and Cl2 and reasons about mobile charge carriers instead of merely assigning substance names."
        },
        {
          "id": "fresh-application-and-boundary",
          "essentialUnderstandingDe": "Ein Stoff mit Metallatom ist nicht automatisch ein Metall; Ionen im Feststoff sind nicht automatisch frei beweglich.",
          "essentialUnderstandingEn": "A substance containing a metal atom is not automatically a metal; solid-state ions are not automatically freely mobile.",
          "observablePerformanceDe": "In der Schmelze sind Na+ und Cl− beweglich. CuCl2 hat Ionen und nicht das Modell des elementaren Metalls mit delokalisiertem Elektronengas. O-H in H2O ist eine kovalente Bindung; Wasserstoffbrücken beziehen sich hier auf Wechselwirkungen zwischen Molekülen. Ionenbindung und kovalente Bindung sind Modelle mit Übergängen; aus dem Namen allein wird keine exakte Bindungsenergie abgeleitet.",
          "observablePerformanceEn": "Na+ and Cl− are mobile in the melt. CuCl2 contains ions rather than the elemental metallic electron-gas model. O-H in H2O is a covalent bond; hydrogen bonding here refers to interactions between molecules. Ionic and covalent bonding are models with transitions; names alone establish no exact bond energy."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "structure-model-reasoning",
          "fresh-application-and-boundary"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "material-variation",
          "textDe": "Metall versus Metallverbindung; ionischer Feststoff versus Schmelze; intramolekulare versus intermolekulare Wechselwirkung.",
          "textEn": "Metal versus metal compound; ionic solid versus melt; intra- versus intermolecular interaction."
        },
        {
          "id": "counterexample",
          "textDe": "Ein Stoff mit Metallatom ist nicht automatisch ein Metall; Ionen im Feststoff sind nicht automatisch frei beweglich.",
          "textEn": "A substance containing a metal atom is not automatically a metal; solid-state ions are not automatically freely mobile."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "chem-current15-448815cc-case-1",
          "taskDemandDe": "Modelle: Kupfer mit positiven Atomrümpfen/delokalisierten Elektronen; festes NaCl mit Na+/Cl−-Gitter; Cl2 mit gemeinsamem Bindungselektronenpaar. Erkläre die drei Bindungsarten und leite den Unterschied in der Ladungsträgerbeweglichkeit von Cu und festem NaCl her.",
          "taskDemandEn": "Models: copper with positive cores/delocalized electrons; solid NaCl with a Na+/Cl− lattice; Cl2 with a shared bonding electron pair. Explain the three bond types and derive the difference in mobile charge carriers between Cu and solid NaCl.",
          "expectedPerformanceDe": "Cu besitzt bewegliche delokalisierte Elektronen. NaCl wird durch elektrostatische Gitterwechselwirkungen gebunden, seine Ionen sind im festen Gitter ortsgebunden. Cl2 hat eine kovalente Bindung zwischen zwei Atomen; Anziehung zwischen Cl2-Molekülen ist davon verschieden.",
          "expectedPerformanceEn": "Cu has mobile delocalized electrons. NaCl is bound by electrostatic lattice interactions and its solid-state ions are position-bound. Cl2 has a covalent bond between two atoms; attraction between Cl2 molecules is different.",
          "understandingFocusDe": "NaCl wird nicht als Ansammlung einzelner NaCl-Moleküle beschrieben.",
          "understandingFocusEn": "NaCl is not described as an assembly of discrete NaCl molecules."
        },
        {
          "id": "chem-current15-448815cc-case-2",
          "taskDemandDe": "Frischer Fall: NaCl schmilzt; CuCl2 enthält Kupfer, liegt aber als ionischer Feststoff vor. Wasser enthält neutrale H2O-Moleküle. Übertrage die Modelle: Welche Ladungsträger bewegen sich in der NaCl-Schmelze? Warum ist CuCl2 kein Kupfermetall und die O-H-Bindung keine Wasserstoffbrücke?",
          "taskDemandEn": "Fresh case: NaCl melts; CuCl2 contains copper but is an ionic solid. Water contains neutral H2O molecules. Transfer the models: which carriers move in molten NaCl? Why is CuCl2 not copper metal, and why is the O-H bond not a hydrogen bond?",
          "expectedPerformanceDe": "In der Schmelze sind Na+ und Cl− beweglich. CuCl2 hat Ionen und nicht das Modell des elementaren Metalls mit delokalisiertem Elektronengas. O-H in H2O ist eine kovalente Bindung; Wasserstoffbrücken beziehen sich hier auf Wechselwirkungen zwischen Molekülen.",
          "expectedPerformanceEn": "Na+ and Cl− are mobile in the melt. CuCl2 contains ions rather than the elemental metallic electron-gas model. O-H in H2O is a covalent bond; hydrogen bonding here refers to interactions between molecules.",
          "understandingFocusDe": "Ionenbindung und kovalente Bindung sind Modelle mit Übergängen; aus dem Namen allein wird keine exakte Bindungsenergie abgeleitet.",
          "understandingFocusEn": "Ionic and covalent bonding are models with transitions; names alone establish no exact bond energy."
        }
      ]
    }
  },
  {
    "goalId": "4aa3a130-b517-5ac5-87b2-147fe432cadd",
    "wholeProfile": {
      "archetype": "data",
      "expectations": [
        {
          "id": "adequacy-for-question",
          "essentialUnderstandingDe": "Daten sind nur für eine Fragestellung angemessen, wenn Messprinzip, Probenbedingungen und benötigte Unterscheidung zusammenpassen.",
          "essentialUnderstandingEn": "Data are adequate for a question only when measurement principle, sample conditions and required distinction fit together.",
          "observablePerformanceDe": "Prüft am Farbtest Selektivität/Blank und am Leitfähigkeitsvergleich Temperatur, Ionensorte und Kontrollprobe; trennt Messantwort von Stoffidentifikation.",
          "observablePerformanceEn": "Checks selectivity/blank for the colour test and temperature, ion type and control for the conductivity comparison; separates measurement response from substance identification."
        },
        {
          "id": "bounded-conclusion",
          "essentialUnderstandingDe": "Eine positive Antwort eines kreuzreaktiven Tests beweist keinen eindeutigen Stoff; ein unkontrollierter Temperaturunterschied beweist keine Konzentrationsdifferenz.",
          "essentialUnderstandingEn": "A positive cross-reactive test does not prove a unique substance; an uncontrolled temperature difference does not prove a concentration difference.",
          "observablePerformanceDe": "Begründet unterstützte und nicht unterstützte Aussagen mit X/Y/Blank bzw. A20/A35/B35 und begrenzt die ±3-Streuung auf das gegebene Modell.",
          "observablePerformanceEn": "Justifies supported and unsupported claims using X/Y/blank or A20/A35/B35 and confines ±3 scatter to the supplied model."
        },
        {
          "id": "fresh-validity-check",
          "essentialUnderstandingDe": "Ein ausgeschlossener Störstoff beseitigt nicht alle Unsicherheit; eine neue ungeladene Matrixkomponente kann Ionenbeweglichkeit verändern.",
          "essentialUnderstandingEn": "Excluding one interferent does not remove all uncertainty; a new uncharged matrix component may change ion mobility.",
          "observablePerformanceDe": "Nennt nach Y-Ausschluss weitere relevante Testgrenzen und entwickelt bei Saccharosezugabe einen temperatur- und matrixgleichen Kontroll-/Kalibriervergleich.",
          "observablePerformanceEn": "Names further relevant test limits after excluding Y and develops a temperature- and matrix-matched control/calibration comparison for added sucrose."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "adequacy-for-question",
          "bounded-conclusion",
          "fresh-validity-check"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "interferent-exclusion",
          "textDe": "Ein bekannter Kreuzreaktant entfällt; andere Interferenzen und Nachweisgrenze bleiben zu prüfen.",
          "textEn": "One known cross-reactant is removed; other interferences and detection limit still need checking."
        },
        {
          "id": "matrix-change",
          "textDe": "Temperaturkontrolle wird um Saccharose-/Viskositäts- und Matrixkontrolle erweitert.",
          "textEn": "Temperature control is extended by sucrose/viscosity and matrix control."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "data-validity-test-not-proof",
          "taskDemandDe": "Beurteile Gültigkeit, geeignete Quellen, Blind-/Positivkontrollen und Tragweite von „U enthält X“. Benenne einen Verfahrensfehler und eine geeignete Folgemethode.\nFrische Variation: Wenn Y ausgeschlossen wird, erkläre, welche weiteren Informationen vor einem eindeutigen Nachweis noch fehlen können.",
          "taskDemandEn": "Assess validity, suitable sources, blank/positive controls and the scope of “U contains X”. Identify a procedure error and a suitable follow-up method.\nFresh variation: If Y is excluded, explain what further information may still be missing before unique proof.",
          "expectedPerformanceDe": "Die Blank-/Positivkontrolle zeigt grundsätzliches Testansprechen; Y macht den Test nicht spezifisch. U-Farbe ist ein Hinweis auf eine reagierende Komponente, kein eindeutiger X-Nachweis. S ist für Spezifität relevanter als das verkürzte Etikett H; unbekannte Verdünnung/Erhitzung kann Signal verändern. Eine unabhängig spezifischere Analyse mit dokumentierten Bedingungen ist nötig. Blindproben korrigieren keinen grundsätzlich unspezifischen Reaktionsmechanismus. Weil X/Y hier keine Stoffidentitäten oder Trennmerkmale haben, darf kein benanntes Gerät ungeprüft als X-spezifisch gelten. Akzeptabel ist eine konkrete kontrollierte Wiederholung mit dokumentierter Verdünnung/Temperatur und eine begründete Planung zur Validierung einer ergänzenden Methode an bekannten X-, Y- und Blindproben. Für einen eindeutigen X-Nachweis muss deren Spezifität erst belegt werden; Wiederholung des unspezifischen Tests allein identifiziert X weiterhin nicht.\nFrischer Transfer: Der Ausschluss von Y beseitigt nur den bekannten Kreuzreaktanten Y. Weitere unbekannte Stoffe, Matrix-/pH-/Temperaturbedingungen, Nachweisgrenze, Empfindlichkeit und Störreaktionen bleiben mögliche Grenzen. Eine positive Antwort ist nur bei dokumentiert validierter Selektivität und passenden Probenbedingungen eine starke Stütze für X. Weitere bekannte X-/Nicht-X-Proben, Blank, geeignete Matrixkontrollen und eine für X validierte unabhängige Methode würden die Aussage verstärken. Eine beliebig genannte zweite Apparatur garantiert noch keine Selektivität. Erhitzen oder Verdünnen kann die tatsächliche Probe verändern; ursprüngliche Probenbedingungen erhalten und kenntlich machen. Kein absoluter Nachweis aller unbekannten Möglichkeiten folgt aus Y-Ausschluss.",
          "expectedPerformanceEn": "Blank/positive controls show that the test responds in principle; Y makes it non-specific. U colour indicates a reacting component, not unique proof of X. S is more relevant to specificity than the shortened label H; unknown dilution/heating may alter the signal. An independent more specific analysis under documented conditions is needed. Blanks do not correct an inherently non-specific reaction mechanism. Because X/Y have no identities or discriminating properties here, no named instrument may be presumed X-specific. Accept a concrete controlled repeat with documented dilution/temperature and a justified plan to validate an additional method against known X, Y and blank samples. Its specificity must first be established for unique proof of X; repeating the non-specific test alone still does not identify X.\nFresh transfer: Excluding Y removes only the known cross-reactant Y. Other unknown substances, matrix/pH/temperature conditions, detection limit, sensitivity and interfering reactions remain possible limits. A positive response strongly supports X only with documented validated selectivity and appropriate sample conditions. Further known X/non-X samples, blank, suitable matrix controls and an independent method validated for X would strengthen the claim. Simply naming a second instrument does not guarantee selectivity. Heating or dilution may change the actual sample; retain and label original sample conditions. Excluding Y does not exclude every unknown possibility absolutely.",
          "understandingFocusDe": "Neue Selektivitätsinformation begrenzt den Nachweisanspruch konkret statt ihn absolut zu machen.",
          "understandingFocusEn": "New selectivity information bounds the identification claim concretely rather than making it absolute."
        },
        {
          "id": "data-validity-temperature-confound",
          "taskDemandDe": "Prüfe, welche Folgerung durch Daten getragen wird, welche Störgröße vorliegt und wie ein gültiger Stoffmengenvergleich verbessert werden kann.\nFrische Variation: Plane den Vergleich, wenn Probe B zusätzlich Saccharose enthält; erläutere die Grenze reiner Leitfähigkeitsdaten.",
          "taskDemandEn": "Assess which conclusion the data support, the confounder present and how to improve a valid amount comparison.\nFresh variation: Plan the comparison if B additionally contains sucrose; explain the limit of conductivity-only data.",
          "expectedPerformanceDe": "Die 500-µS/cm-Differenz ist mit Temperatur gekoppelt; Kontrolle A35 liegt innerhalb grober Streuung bei B35. Daten belegen kein Mehr an Salz in B. Gleiche Temperatur, Standards, Wiederholungen und bekannte Kompensation/gleiches Ionensystem sind nötig. Streuungsangabe ist nicht die vollständige Messunsicherheit; selbst temperaturgleiche Leitfähigkeit wäre bei unbekannten Ionensorten keine eindeutige NaCl-Konzentration.\nFrischer Transfer: Saccharose liefert im beschriebenen Modell keine zusätzlichen dissoziierten Ionen, kann aber Lösungsmatrix und Viskosität und damit die Beweglichkeit vorhandener Ionen verändern. Aus κ lässt sich deshalb weder Saccharosemenge noch gesamter gelöster Stoff direkt bestimmen. Bei gleicher Temperatur NaCl-Kontrollen mit/ohne gleiche Saccharosematrix, geeignete Blanks und eine für diese Matrix validierte Konzentrationskalibrierung vergleichen. Die bereits vorgegebenen A35/B35-Werte enthalten keine neue Saccharosemessung. Eine Behauptung höherer NaCl-Konzentration wäre nur innerhalb geprüfter Ionensorte, Temperatur und Matrix zulässig; die ±3-Wiederholstreuung ersetzt keine Gesamtunsicherheit.",
          "expectedPerformanceEn": "The 500-µS/cm difference is confounded by temperature; A35 control lies within rough scatter of B35. Data do not establish more salt in B. Equal temperature, standards, repeats and known compensation/the same ion system are needed. The scatter estimate is not full measurement uncertainty; even equal-temperature conductivity would not uniquely determine NaCl concentration for unknown ion species.\nFresh transfer: Sucrose supplies no additional dissociated ions in the described model but may change solution matrix and viscosity and therefore mobility of existing ions. κ therefore does not directly determine sucrose amount or total dissolved material. At equal temperature compare NaCl controls with/without the same sucrose matrix, suitable blanks and concentration calibration validated for this matrix. The existing A35/B35 values contain no new sucrose measurement. A claim of higher NaCl concentration would be valid only within checked ion type, temperature and matrix; ±3 repeat scatter is not total uncertainty.",
          "understandingFocusDe": "Temperaturkontrolle allein löst bei neuer Matrix nicht alle Konzentrations-Gültigkeitsfragen.",
          "understandingFocusEn": "Temperature control alone does not resolve every concentration-validity question in a new matrix."
        }
      ]
    }
  },
  {
    "goalId": "5851b53a-162b-5c17-9269-510ee54ad846",
    "wholeProfile": {
      "archetype": "representation",
      "expectations": [
        {
          "id": "b002-5851b53a-core",
          "essentialUnderstandingDe": "Die lokale Klasse des Alkanols bestimmt das erste Carbonylprodukt: primär zu Aldehyd, sekundär zu Keton; ein primäres Aldehyd kann weiter zur Carbonsäure oxidieren.",
          "essentialUnderstandingEn": "The local alkanol class determines the first carbonyl product: primary to aldehyde, secondary to ketone; a primary-derived aldehyde may oxidize further to a carboxylic acid.",
          "observablePerformanceDe": "Die lernende Person zeichnet zu gegebenen Alkanolstrukturen passende Produkte und erklärt mit Änderungen am OH-tragenden C, weshalb die Produkte verschieden sind.",
          "observablePerformanceEn": "The learner draws suitable products for given alkanol structures and explains via changes at the OH-bearing carbon why the products differ."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "b002-5851b53a-core"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "oxidation-depth",
          "textDe": "Primäres Alkanol mit begrenzter und weitergehender Oxidation.",
          "textEn": "A primary alkanol under limited and further oxidation."
        },
        {
          "id": "alkanol-class",
          "textDe": "Sekundäres Alkanol als neuer Vergleich ohne Carbonsäureprodukt.",
          "textEn": "A secondary alkanol as fresh comparison without a carboxylic-acid product."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "ethanol-product-sequence",
          "taskDemandDe": "Vorgegebene Strukturdaten zeigen Ethanol unter begrenzter und weitergehender Oxidation. Zeichne die zwei aufeinanderfolgenden organischen Produkte und erläutere die Strukturänderung.",
          "taskDemandEn": "Supplied structure data show ethanol under limited and further oxidation. Draw the two consecutive organic products and explain structural change.",
          "expectedPerformanceDe": "Die lernende Person zeichnet Ethanal und danach Ethansäure, unterscheidet Aldehyd- und Carboxylgruppe und behauptet nicht, beide entstünden stets zugleich.",
          "expectedPerformanceEn": "The learner draws ethanal then ethanoic acid, distinguishes aldehyde and carboxyl groups, and does not claim both always arise together.",
          "understandingFocusDe": "Reaktionsbedingungen steuern die Tiefe, die Ausgangsstruktur begrenzt Produkte.",
          "understandingFocusEn": "Conditions control oxidation extent while starting structure constrains products."
        },
        {
          "id": "fresh-secondary-product",
          "taskDemandDe": "Ein frischer Fall oxidiert Propan-2-ol unter geeigneten milden Bedingungen. Welches organische Produkt ist plausibel und warum entsteht daraus nicht analog eine Carbonsäure mit demselben C-Gerüst?",
          "taskDemandEn": "A fresh case oxidizes propan-2-ol under suitable mild conditions. Which organic product is plausible, and why does an analogous carboxylic acid not arise with the same carbon skeleton?",
          "expectedPerformanceDe": "Die lernende Person zeichnet Propanon aus dem sekundären OH-C und erklärt, dass das Keton keine weitere analoge C-H-Oxidation am Carbonyl-C besitzt.",
          "expectedPerformanceEn": "The learner draws propanone from the secondary OH-bearing carbon and explains that the ketone lacks an analogous carbonyl-carbon H for further oxidation.",
          "understandingFocusDe": "Neuer Alkanoltyp prüft Struktur-Produkt-Transfer.",
          "understandingFocusEn": "A new alkanol type tests structure-product transfer."
        }
      ]
    }
  },
  {
    "goalId": "67cd332f-9db7-50e1-87f6-172ef3714300",
    "wholeProfile": {
      "archetype": "modeling",
      "expectations": [
        {
          "id": "b006-67cd332f-core",
          "essentialUnderstandingDe": "Bindende und freie Elektronenbereiche um ein Zentralatom ordnen sich im EPA-Modell mit möglichst geringer Abstoßung. Elektronenbereichsgeometrie und sichtbare Atomgestalt sind verschieden; ein freies Paar wird nicht als Atom eingezeichnet.",
          "essentialUnderstandingEn": "Bonding and lone electron domains around a central atom arrange to reduce repulsion in VSEPR. Electron-domain geometry differs from the visible atomic shape; a lone pair is not drawn as an atom.",
          "observablePerformanceDe": "Die lernende Person zählt an gegebenen Lewis-Strukturen Elektronenbereiche und freie Paare, leitet einfache Molekülgestalten ab und nennt Modellgrenzen statt aus exakten Winkeln zu raten.",
          "observablePerformanceEn": "The learner counts electron domains and lone pairs in supplied Lewis structures, derives simple molecular shapes and names limits rather than guessing exact angles."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "b006-67cd332f-core"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "lone-pairs",
          "textDe": "Null, ein und zwei freie Paare am Zentralatom verändern die Atomgestalt.",
          "textEn": "Zero, one and two central-atom lone pairs change molecular shape."
        },
        {
          "id": "domain-number",
          "textDe": "Zwei und vier Elektronenbereiche erzeugen unterschiedliche Grundanordnungen.",
          "textEn": "Two and four electron domains produce different base arrangements."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "water-carbon-dioxide",
          "taskDemandDe": "Gegebene Lewis-Bilder zeigen H–O–H mit zwei freien O-Paaren und O=C=O ohne freie C-Paare. Begründe mit EPA die Molekülgestalten.",
          "taskDemandEn": "Supplied Lewis sketches show H–O–H with two O lone pairs and O=C=O with no C lone pairs. Explain molecular shapes using VSEPR.",
          "expectedPerformanceDe": "H2O hat vier O-Bereiche, aber nur zwei sichtbare Bindungspartner und ist gewinkelt; CO2 hat zwei C-Bereiche und ist linear. Doppelbindungen zählen je als ein Bereich.",
          "expectedPerformanceEn": "H2O has four O domains but only two bonded atoms and is bent; CO2 has two C domains and is linear. Each double bond counts as one domain.",
          "understandingFocusDe": "Lewis→EPA mit zwei verschiedenen Domänenzahlen.",
          "understandingFocusEn": "Lewis-to-VSEPR with two domain counts."
        },
        {
          "id": "ammonia-methane-transfer",
          "taskDemandDe": "Neue gegebene Lewis-Bilder: NH3 hat drei N–H-Bindungen und ein freies N-Paar; CH4 vier C–H-Bindungen ohne freies C-Paar. Vergleiche Atomgestalt, ohne exakte Winkel zu behaupten.",
          "taskDemandEn": "Fresh supplied Lewis sketches: NH3 has three N–H bonds and one N lone pair; CH4 has four C–H bonds and no C lone pair. Compare atomic shape without claiming exact angles.",
          "expectedPerformanceDe": "Beide haben vier Elektronenbereiche; NH3 ist trigonal-pyramidal, CH4 tetraedrisch. Das freie N-Paar ist kein vierter Bindungspartner; die Atomgestalt von NH3 bleibt trigonal-pyramidal.",
          "expectedPerformanceEn": "Both have four electron domains; NH3 is trigonal pyramidal while CH4 is tetrahedral. The N lone pair is not a fourth bonded atom; NH3 molecular shape remains trigonal pyramidal.",
          "understandingFocusDe": "Gleiche Domänenzahl bei verschiedener Molekülgestalt testet freie Paare.",
          "understandingFocusEn": "Same domain count with different molecular shapes tests lone-pair reasoning."
        }
      ]
    }
  },
  {
    "goalId": "72236f2c-771e-4ab6-933a-e549ee49d15b",
    "wholeProfile": {
      "archetype": "concept",
      "expectations": [
        {
          "id": "72236f2c-understanding-1",
          "essentialUnderstandingDe": "Überwiegend ungestörte und selten stark abgelenkte positiveα-Teilchen passen zu einem großen weitgehend leeren Volumen und einem kleinen positiv geladenen massereichen Kern.",
          "essentialUnderstandingEn": "Mostly undeflected and rarely strongly deflected positive alpha particles fit a large mostly empty volume and a tiny positive massive nucleus.",
          "observablePerformanceDe": "Streubefund und Kernkonzentration kausal verbinden und vom vollgefüllten Atommodell abgrenzen.",
          "observablePerformanceEn": "Connect scattering and nuclear concentration causally and distinguish a filled atom model."
        },
        {
          "id": "72236f2c-understanding-2",
          "essentialUnderstandingDe": "Protonen und Neutronen liegen im Kern, leichte negative Elektronen in der Hülle. Z bestimmt die Protonenzahl und Elementidentität, A die Nukleonenzahl; Neutralität oder eine ausdrücklich gegebene Ionladung bestimmt zusätzlich die Elektronenzahl.",
          "essentialUnderstandingEn": "Protons and neutrons occupy the nucleus and light negative electrons the shell. Z determines proton count and element identity, A the nucleon count; neutrality or an explicitly given ionic charge additionally determines electron count.",
          "observablePerformanceDe": "Für ein gegebenes neutrales Atom Ort, Ladung, relative Masse und Teilchenzahlen beschreiben und bei einer vorgegebenen Ladungsänderung begründen, welche Hüllen- und Kerneigenschaften unverändert bleiben.",
          "observablePerformanceEn": "Describe constituent locations, charges, relative masses and counts for a given neutral atom and explain which shell and nuclear properties remain unchanged under a stipulated charge change."
        },
        {
          "id": "72236f2c-understanding-3",
          "essentialUnderstandingDe": "Streubefund und schematische Skizze liefern keine genaue Elektronenbahn oder eigenständige Neutronenmessung.",
          "essentialUnderstandingEn": "Scattering and a sketch supply neither a precise electron orbit nor an independent neutron measurement.",
          "observablePerformanceDe": "Einen neuen Isotopen- und Ladungsfall mit unveränderter Elementidentität deuten und separat benennen, welche Aussagen aus Z/A/Ladung und welche aus dem tatsächlichen Streubefund beziehungsweise nur einer Skizze folgen.",
          "observablePerformanceEn": "Interpret a new isotope and charge case with unchanged element identity and distinguish what follows from Z/A/charge, from the scattering finding and from a sketch alone."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "72236f2c-understanding-1",
          "72236f2c-understanding-2",
          "72236f2c-understanding-3"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "neutral-to-positive-or-negative-ion",
          "textDe": "Bei festem Z/A von neutralem Atom zu positivem oder negativem Ion wechseln und Elektronenzahl, Kernzusammensetzung und Gesamtladung begründet trennen; Isotopenänderung als anderen Eingriff vergleichen.",
          "textEn": "With fixed Z/A, change a neutral atom to a positive or negative ion and justify the distinction between electron count, nucleus and total charge; compare an isotope change as a different intervention."
        },
        {
          "id": "model-and-evidence-boundary",
          "textDe": "Stoffidentität, Modellgrenze und fehlende reale Evidenz explizit erhalten.",
          "textEn": "Explicitly preserve substance identity, model limits and absent real evidence."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "rutherford-counts",
          "taskDemandDe": "Eigene vereinfachte Modellzählung von 1 000 000 positiv geladenen α-Teilchen an einer dünnen Metallfolie: 999 000 nahezu ungestört, 950 stärker abgelenkt, 50 um mehr als 90° abgelenkt. Es sind erfundene Unterrichtswerte, keine historischen Messzahlen. α-Teilchen sind positiv; gleiche Ladungen stoßen sich ab. Für ein neutrales ²³Na-Atom sind Ordnungszahl11 und Massenzahl23 gegeben. Ordne die drei Befunde dem Kern-Hülle-Modell zu. Erkläre, warum eine gleichmäßig verteilte positive Ladung die seltenen großen Ablenkungen nicht angemessen erklärt. Beschreibe Ort, Ladung und relative Masse von Proton, Neutron und Elektron und bestimme ihre Anzahl im gegebenen neutralen Atom. Nenne eine Modellgrenze. Frischer unabhängiger Transfer: Ein unabhängiger geänderter Fall enthält ein neutrales ²²Na-Atom (Z=11, A=22) und ein ²³Na⁺-Ion (Z=11, A=23, Gesamtladung +1). Vergleiche beide mit dem neutralen ²³Na-Atom des Hauptfalls. Bestimme für alle drei die Protonen-, Neutronen- und Elektronenzahl. Begründe, weshalb eine Elektronenabgabe die Ladung ändert, aber weder ein anderes Element noch eine andere Neutronenzahl erzeugt. Welche Aussage über die konzentrierte positive Kernladung bleibt bestehen? Kann die genaue Neutronen- oder Elektronenzahl aus der angegebenen Folien-Streuzählung allein abgelesen werden? Es wird kein Vergleich exakter Streuhäufigkeiten verschiedener Ionen verlangt.",
          "taskDemandEn": "Own simplified model count for 1,000,000 positive alpha particles at thin metal foil: 999,000 almost undeflected, 950 more strongly deflected, 50 by more than90°. These are invented teaching values, not historical measurements. Alpha particles are positive and like charges repel. A neutral ²³Na atom has atomic number11 and mass number23. Relate the three findings to the core-shell model. Explain why uniformly distributed positive charge inadequately explains rare large deflections. State location, charge and relative mass of proton, neutron and electron and find their numbers in the neutral atom. Name a model limit. Fresh independent transfer: An independent changed case contains neutral ²²Na (Z=11, A=22) and a ²³Na⁺ ion (Z=11, A=23, total charge +1). Compare both with the neutral ²³Na atom in the main case. Determine proton, neutron and electron counts for all three. Explain why losing an electron changes charge without creating a different element or neutron count. Which statement about concentrated positive nuclear charge remains? Can the exact neutron or electron count be read from the supplied foil-scattering tally alone? No comparison of exact scattering frequencies for different ions is required.",
          "expectedPerformanceDe": "Die überwiegend ungestörten Bahnen passen zu einem überwiegend leeren Atomvolumen. Seltene große Ablenkungen erfordern eine stark konzentrierte positive Ladung und Masse im kleinen Kern, nicht eine massive vollgefüllte Kugel. Protonen:Kern,+1, relative Masse≈1; Neutronen:Kern,0,≈1; Elektronen:Hülle,−1,≈1/1836. ²³Na hat11 p,12 n,11 e. Der Versuch allein misst keine Neutronen und liefert kein vollständiges quantenmechanisches Elektronenmodell. Die Teilchennamen sind schulische Atombausteine; Protonen/Neutronen sind im modernen Sinn nicht elementar. Transfer: Neutrales ²³Na: 11 p, 12 n, 11 e; neutrales ²²Na: 11 p, 11 n, 11 e; ²³Na⁺: 11 p, 12 n, 10 e. Die Gesamtladung ergibt sich in Einheiten der Elementarladung aus p−e. Der Isotopenwechsel ändert die Neutronenzahl; Elektronenabgabe ändert die Hülle und Gesamtladung. Z=11 und damit Elementidentität und positive Kernladung bleiben gleich. Der gegebene qualitative Streubefund stützt einen kleinen konzentriert positiven Kern, bestimmt aber nicht allein die konkreten Neutronen- oder Elektronenzahlen der einzeln vorgegebenen Atome/Ionen. Diese folgen hier aus den separat gegebenen Z-, A- und Ladungsangaben.",
          "expectedPerformanceEn": "Mostly undeflected trajectories fit an atomic volume that is mostly empty. Rare large deflections require positive charge and mass concentrated in a tiny nucleus, not a solid filled sphere. Protons:nucleus,+1, relative mass≈1; neutrons:nucleus,0,≈1; electrons:shell,−1,≈1/1836. ²³Na has11 p,12 n,11 e. The experiment alone does not measure neutrons or supply a complete quantum electron model. These are school-level atomic constituents; protons/neutrons are not elementary in the modern sense. Transfer: Neutral ²³Na: 11 p, 12 n, 11 e; neutral ²²Na: 11 p, 11 n, 11 e; ²³Na⁺: 11 p, 12 n, 10 e. Total charge in elementary-charge units is p−e. The isotope change affects neutron count; electron loss affects the shell and total charge. Z=11, element identity and positive nuclear charge remain unchanged. The supplied qualitative scattering pattern supports a small concentrated positive nucleus, but alone does not determine the specific neutron or electron counts of the stipulated individual atoms/ions. Here these counts follow from the separate Z, A and charge information.",
          "understandingFocusDe": "Kern-Hülle-Zusammenhang und Teilcheneigenschaften über einen wirklich geänderten Ladungsfall begründen; Z/A/Ladung, Streubeleg und Modellskizze trennen. E0/G0, keine beobachtete Leistung.",
          "understandingFocusEn": "Justify nuclear-shell relationships and constituent properties under a genuinely changed charge condition; separate Z/A/charge, scattering evidence and sketch. E0/G0, no observed performance."
        },
        {
          "id": "atomic-model-claims",
          "taskDemandDe": "Drei Behauptungen zu einem neutralen ⁴⁰Ca-Atom (Z=20, A=40): A:Alle40Teilchen sind positive Protonen. B:Die Elektronenhülle enthält den größten Teil der Atommasse. C:Ein kleiner positiver Kern mit Elektronenhülle passt zu überwiegend geraden und selten stark abgelenkten Bahnen positiver α-Teilchen. Ein nicht maßstäbliches Kugelbild zeigt einen großen Kern; es legt keine Elektronenbahn fest. Prüfe A–C mit Teilchenzahlen, Ladungen und relativen Massen. Erkläre das Streumuster auf Modellebene und weshalb die Bildgrößen nicht als Größenverhältnis oder gemessene Bahn gelesen werden dürfen. Frischer unabhängiger Transfer: Ein neuer Fall vergleicht ein neutrales ³⁵Cl-Atom mit einem ³⁵Cl⁻-Ion. Für beide gelten Z=17 und A=35; das Ion hat die Gesamtladung −1. Beschreibe für beide Kern und Hülle mit p-, n- und e-Zahlen und erkläre die Ladungsbilanz. Prüfe die Behauptung „Weil Cl⁻ mehr Elektronen hat, muss sein Kern weniger positiv oder seine Neutronenzahl größer sein“. Trenne die Folgerungen aus Z/A/Ladung von der allgemeinen Aussage des vorgelegten Folien-Streuversuchs und von einer bloßen Modellskizze. Elektronenbahnen oder Schalenbesetzungen werden nicht verlangt.",
          "taskDemandEn": "Three claims about neutral ⁴⁰Ca (Z=20, A=40): A:All40particles are positive protons. B:The electron shell contains most atomic mass. C:A small positive nucleus with an electron shell fits mostly straight and rarely strongly deflected positive alpha trajectories. A non-scale ball picture draws a large nucleus and specifies no electron orbit. Assess A–C using particle counts, charges and relative masses. Explain the scattering pattern at model level and why drawn sizes are not physical size ratios or measured trajectories. Fresh independent transfer: A new case compares neutral ³⁵Cl with a ³⁵Cl⁻ ion. Both have Z=17 and A=35; the ion has total charge −1. Describe nucleus and shell for both using proton, neutron and electron counts and explain the charge balance. Assess the claim “Because Cl⁻ has more electrons, its nucleus must be less positive or its neutron count larger.” Separate inferences from Z/A/charge from the general statement supported by the supplied foil-scattering experiment and from a model sketch. No electron orbits or shell-occupancy model is required.",
          "expectedPerformanceDe": "⁴⁰Ca besitzt20 p,20 n im Kern und20 e in der Hülle. A ist falsch:40 ist die Nukleonensumme, nicht Protonenzahl. B ist falsch:Fast alle Masse liegt im Kern, Elektronen sind viel leichter. C ist mit den Befunden vereinbar:großes weitgehend leeres Volumen und kleiner konzentrierter positiver Kern. Große Ablenkung heißt nicht, dass die ganze Hülle massereich ist. Eine Modellskizze veranschaulicht Anordnung; Größen und Elektronenbahnen sind damit nicht gemessen. Transfer: Neutrales ³⁵Cl besitzt 17 p, 18 n und 17 e; ³⁵Cl⁻ besitzt denselben Kern aus 17 p und 18 n, aber 18 e. p−e ist 0 beziehungsweise −1. Die zusätzliche negative Hüllenladung macht die Kernladung nicht kleiner und ändert keine Neutronenzahl; Z und Elementidentität bleiben gleich. Die konkreten Zahlen folgen aus den gegebenen Z/A-/Ladungsangaben. Der qualitative Folienbefund begründet einen kleinen konzentriert positiven Kern, nicht die konkrete Cl-Neutronenzahl, Ionladung oder gezeichnete Elektronenbahn. Die nicht maßstäbliche Skizze ist keine weitere Messung.",
          "expectedPerformanceEn": "⁴⁰Ca has20 p and20 n in the nucleus and20 e in the shell. A is false:40 is the nucleon total, not proton number. B is false:Almost all mass is nuclear and electrons are much lighter. C fits the evidence:large mostly empty volume and a small concentrated positive nucleus. Large deflection does not imply a massive shell. A sketch illustrates arrangement; it measures neither sizes nor electron paths. Transfer: Neutral ³⁵Cl has 17 p, 18 n and 17 e; ³⁵Cl⁻ has the same nucleus with 17 p and 18 n but 18 e. p−e is 0 and −1 respectively. Additional negative shell charge neither reduces nuclear charge nor changes neutron count; Z and element identity stay the same. Specific counts follow from the stipulated Z/A/charge data. The qualitative foil result supports a small concentrated positive nucleus, not the specific chlorine neutron count, ionic charge or drawn electron orbit. A non-scale sketch is not another measurement.",
          "understandingFocusDe": "Kern-Hülle-Zusammenhang und Teilcheneigenschaften über einen wirklich geänderten Ladungsfall begründen; Z/A/Ladung, Streubeleg und Modellskizze trennen. E0/G0, keine beobachtete Leistung.",
          "understandingFocusEn": "Justify nuclear-shell relationships and constituent properties under a genuinely changed charge condition; separate Z/A/charge, scattering evidence and sketch. E0/G0, no observed performance."
        }
      ]
    }
  },
  {
    "goalId": "7d9fcc7f-1c20-5d5b-9cf6-05f6b624dab6",
    "wholeProfile": {
      "archetype": "data",
      "expectations": [
        {
          "id": "representation-and-trend",
          "essentialUnderstandingDe": "Tabellen/Diagramme brauchen passend benannte Größen und Einheiten; Mittelwerte dürfen die Streuung der Rohwerte nicht verbergen.",
          "essentialUnderstandingEn": "Tables/graphs require labelled quantities and units; means must not conceal the spread of raw values.",
          "observablePerformanceDe": "Selbst Tabelle oder Diagramm mit 92/64/49 s und Rohwiederholungen erstellen; die neue 50-°C-Streuung erläutern.",
          "observablePerformanceEn": "Create an own table or graph with 92/64/49 s and raw repeats; explain the new 50 °C spread."
        },
        {
          "id": "hypothesis-inference",
          "essentialUnderstandingDe": "Ein Trend stützt eine Hypothese innerhalb der erhobenen Bedingungen; Verwechslung von Geschwindigkeit, Löslichkeit und Leitfähigkeitsmechanismus ist unzulässig.",
          "essentialUnderstandingEn": "A trend supports a hypothesis within the supplied conditions; speed, solubility capacity and conductivity mechanism are distinct.",
          "observablePerformanceDe": "Temperatur-Zeit- und NaCl-Leitfähigkeitsdaten fachlich zur jeweils vorgegebenen Hypothese in Beziehung setzen; mobile Ionen und neutrale Saccharose unterscheiden.",
          "observablePerformanceEn": "Relate temperature/time and NaCl/conductivity data scientifically to their respective supplied hypotheses; distinguish mobile ions and neutral sucrose."
        },
        {
          "id": "confounds-and-transfer",
          "essentialUnderstandingDe": "Streuende Wiederholungen und temperaturabhängige Leitfähigkeit begrenzen die isolierte Deutung einer veränderten Größe.",
          "essentialUnderstandingEn": "Spread in repeats and temperature-dependent conductivity limit isolated interpretation of a changed variable.",
          "observablePerformanceDe": "Bei 80/45 s die Bedingungen begründet prüfen und beide Daten bewahren; bei wärmerer Einzelprobe Konzentrationseinfluss von Temperaturkonfundierung unterscheiden.",
          "observablePerformanceEn": "For 80/45 s justify checking conditions and preserve both data; distinguish concentration effects from temperature confounding in a warmer individual sample."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "representation-and-trend",
          "hypothesis-inference",
          "confounds-and-transfer"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "changed-condition",
          "textDe": "Neue fallgebundene Bedingung/Hypothesenprüfung und eigene begründete Revision statt bloßem Zahlentausch.",
          "textEn": "Fresh case-specific condition/hypothesis check and own reasoned revision rather than mere number substitution."
        },
        {
          "id": "source-and-limit",
          "textDe": "BY C8/C9-Auswertung und C10-Trends/Beziehungen bleiben fallbezogen erhalten. Tabellen und digitale Erfassung können bereits SekI sein; das Werkzeug allein ist keine Oberstufenleistung. Der Quellenanspruch wird nicht auf rein grafisches Ablesen reduziert. Die ausgewertete Ausgangshypothese darf vorgegeben sein; ihre eigene Formulierung ist keine universelle Voraussetzung dieses anderen Leistungsprodukts.",
          "textEn": "Preserve actual source-specific assistance, stage, track and claim limits; the original whole source-scope contract and case-specific conditions are mandatory. Neither supplied data nor author answers evidence real learner performance."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "lower-chemical-data-interpretation-temperature-trend",
          "taskDemandDe": "Erzeuge eine geeignete Tabelle und ein beschriftetes Diagramm, erläutere den Trend und beurteile die Hypothese mit den Wiederholungen. Unterscheide Geschwindigkeit und Löslichkeitsgrenze. Neue Variation: Bei 50 °C werden 80/45 s gemessen: Erkläre, weshalb vor einer Trendbehauptung Versuchsbedingungen geprüft werden müssen.",
          "taskDemandEn": "Create an appropriate table and labelled graph, explain the trend and evaluate the hypothesis using repeats. Distinguish rate and solubility limit. Fresh variation: At 50 °C times are 80/45 s: explain why conditions must be checked before claiming a trend.",
          "expectedPerformanceDe": "Mittelwerte 92/64/49 s; T auf x-Achse, Zeit auf y-Achse mit Einheiten. Zeiten sinken wiederholt deutlich; das stützt die Hypothese im Bereich 20–40 °C. Keine lineare Abnahme für alle Temperaturen und keine größere maximal lösbare Masse sind nachgewiesen. Größere Wiederholungsstreuung wäre im Diagramm sichtbar zu machen. Transfer: Bei 50 °C beträgt der Mittelwert 62,5 s; die Spannweite ist 35 s. Beide Einzelwerte bleiben sichtbar. Das liegt über dem Mittelwert 49 s bei 40 °C, ist aber wegen der großen Streuung kein zuverlässiger Gegenbeweis für die bisherige Tendenz unter kontrollierten Bedingungen. Tatsächliche Temperaturen während des Lösens, Rühren, Korngröße, Massen/Volumina und Endpunkt prüfen; fehlen diese Angaben, bleibt die Ursache offen. Weder den Wert 80 s verwerfen noch 45 s allein zur Bestätigung verwenden.",
          "expectedPerformanceEn": "Means are 92/64/49 s; T on x-axis, time on y-axis with units. Times repeatedly fall clearly; this supports the hypothesis at 20–40 °C. Neither a linear decrease at all temperatures nor a larger maximum dissolvable mass is established. Larger repeat scatter should be visible in the graph. Transfer: At 50 °C the mean is 62.5 s and the range is 35 s. Retain both individual values. This exceeds the 40 °C mean of 49 s, but the large spread prevents a reliable refutation of the previous trend under controlled conditions. Check actual temperatures during dissolution, stirring, grain size, masses/volumes and endpoint; if absent, the cause remains open. Neither discard 80 s nor use 45 s alone as confirmation.",
          "understandingFocusDe": "Die lernende Person kann erhobene oder recherchierte chemische Daten in geeigneten Tabellen oder Diagrammen auswerten, erkennbare Trends und Beziehungen erläutern und begründen, inwiefern die Daten die Ausgangshypothese stützen oder ihr widersprechen. Eigene unabhängige Begründung und tatsächliches gefordertes Leistungsprodukt, keine Wiedergabe der Musterlösung.",
          "understandingFocusEn": "The learner can evaluate experimental or researched chemical data in suitable tables or diagrams, explain observable trends and relationships, and justify how the data support or contradict the initial hypothesis. Own independent reasoning and the actually required performance artifact, not recitation of the worked answer."
        },
        {
          "id": "lower-chemical-data-interpretation-conductivity-series",
          "taskDemandDe": "Wähle eine passende Darstellung, beschreibe Beziehungen und erkläre mit beweglichen Ladungsträgern den Hypothesenbefund; prüfe die Rolle der Vergleichsprobe. Neue Variation: Beschreibe, wie steigende Temperatur bei nur einer Probe die Interpretation stören könnte.",
          "taskDemandEn": "Choose a suitable representation, describe relationships and explain the hypothesis finding using mobile charge carriers; assess the comparison sample. Fresh variation: Describe how rising temperature in just one sample could confound the interpretation.",
          "expectedPerformanceDe": "κ gegen c zeigt wachsende Leitfähigkeit, nahe linear in dieser kleinen Reihe. NaCl liefert bewegliche Ionen, Saccharose überwiegend ungeladene Moleküle; ihr Wert nahe Blindprobe widerlegt „jedes Gelöste leitet gleich“. Der Stoffvergleich unterstützt einen Ionenbezug, bestimmt aber keine unbekannte Salzidentität. Transfer: Eine wärmere Einzelprobe kann durch veränderte Ionenbeweglichkeit eine andere Leitfähigkeit zeigen, ohne dass ihre Konzentration gestiegen ist. Dann ändern sich Konzentration und Temperatur gemeinsam; der Konzentrationseinfluss ist nicht sauber isoliert. Temperatur jeder Probe dokumentieren, vergleichbare Temperatur herstellen oder ein tatsächlich begründetes Temperaturkorrekturverfahren verwenden. Keine erfundene Korrekturzahl einsetzen. Die gegebene 25-°C-Reihe stützt innerhalb ihres Bereichs die NaCl-Hypothese; der Temperaturfehler widerlegt das Ionenmodell nicht.",
          "expectedPerformanceEn": "κ against c shows increasing conductivity, approximately linear within this small series. NaCl supplies mobile ions, sucrose mainly uncharged molecules; its near-blank value contradicts “every dissolved substance conducts equally”. The comparison supports an ion interpretation but does not identify an unknown salt. Transfer: A warmer individual sample can show altered conductivity through ion mobility without an increase in concentration. Concentration and temperature then vary together, so the concentration effect is not isolated. Document each temperature, establish comparable temperatures or use a genuinely justified temperature-correction procedure. Do not invent a correction number. The supplied 25 °C series supports the NaCl hypothesis within its range; the temperature error does not refute the ion model.",
          "understandingFocusDe": "Die lernende Person kann erhobene oder recherchierte chemische Daten in geeigneten Tabellen oder Diagrammen auswerten, erkennbare Trends und Beziehungen erläutern und begründen, inwiefern die Daten die Ausgangshypothese stützen oder ihr widersprechen. Eigene unabhängige Begründung und tatsächliches gefordertes Leistungsprodukt, keine Wiedergabe der Musterlösung.",
          "understandingFocusEn": "The learner can evaluate experimental or researched chemical data in suitable tables or diagrams, explain observable trends and relationships, and justify how the data support or contradict the initial hypothesis. Own independent reasoning and the actually required performance artifact, not recitation of the worked answer."
        }
      ]
    }
  },
  {
    "goalId": "858d56e0-ab8f-51a4-b07e-7d9d94cab8e2",
    "wholeProfile": {

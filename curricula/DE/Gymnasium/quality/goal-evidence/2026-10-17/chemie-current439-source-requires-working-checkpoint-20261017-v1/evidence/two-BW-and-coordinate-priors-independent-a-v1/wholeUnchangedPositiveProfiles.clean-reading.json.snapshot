        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "direction",
          "textDe": "Formel→Teilchenzahl und Teilchenbild→Formel werden gewechselt.",
          "textEn": "Formula-to-particle count and particle-diagram-to-formula directions alternate."
        },
        {
          "id": "notation",
          "textDe": "Elementschreibweise, Index und Koeffizient werden variiert.",
          "textEn": "Element case, subscript and coefficient are varied."

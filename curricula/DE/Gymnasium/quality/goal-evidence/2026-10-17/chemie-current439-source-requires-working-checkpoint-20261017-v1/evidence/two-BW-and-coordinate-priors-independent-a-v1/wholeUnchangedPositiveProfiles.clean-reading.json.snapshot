      ],
      "applicationCaseBriefs": [
        {
          "id": "water-methane-shapes",
          "taskDemandDe": "Für CH4 und H2O liegen Lewis-Formeln vor. Bestimme Domänenzahl, Molekülgeometrie und einen qualitativen Winkelvergleich.",
          "taskDemandEn": "Lewis formulas for CH4 and H2O are supplied. Determine domain counts, molecular geometries, and a qualitative angle comparison.",
          "expectedPerformanceDe": "Die lernende Person erkennt vier Domänen bei beiden, aber tetraedrisches CH4 und gewinkeltes H2O; freie Paare am O verkleinern den H-O-H-Winkel gegenüber 109,5°.",
          "expectedPerformanceEn": "The learner recognizes four domains in both but tetrahedral CH4 and bent H2O; lone pairs on O reduce H-O-H below 109.5°.",
          "understandingFocusDe": "Domänenanordnung und Molekülform sind verschieden.",
          "understandingFocusEn": "Domain arrangement and molecular shape differ."
        },
        {
          "id": "fresh-ammonia-boron",
          "taskDemandDe": "Neue Strukturkarten zeigen NH3 und BH3. Sage ihre Molekülformen voraus und erkläre, warum beide trotz drei Bindungen nicht dieselbe Geometrie haben.",
          "taskDemandEn": "Fresh structures show NH3 and BH3. Predict shapes and explain why three bonds do not give the same geometry.",
          "expectedPerformanceDe": "Die lernende Person ordnet NH3 wegen eines freien Paars als trigonal-pyramidal und BH3 ohne freies Paar als trigonal-planar ein; sie begründet den Winkelunterschied qualitativ.",
          "expectedPerformanceEn": "The learner classifies NH3 with one lone pair as trigonal pyramidal and BH3 without a lone pair as trigonal planar and explains the angle difference qualitatively.",
          "understandingFocusDe": "Neuer Stoffvergleich verlangt Domänenzählung.",
          "understandingFocusEn": "A fresh molecular comparison requires domain counting."
        }
      ]
    }
  },
  {
    "goalId": "9b5d6326-d27c-4ece-8c72-debda705464a",
    "wholeProfile": {
      "archetype": "modeling",
      "expectations": [
        {
          "id": "core-understanding",
          "essentialUnderstandingDe": "Daltons Atomhypothese ist eine erklärende Modellannahme über Atome und ihre Umgruppierung. Ein Gesetz beschreibt empirische Regelmäßigkeiten, eine Hypothese ist prüfbar und vorläufig; spätere Atomkenntnisse begrenzen einzelne Annahmen, nicht die Nutzbarkeit chemischer Atom-Bilanzen.",
          "essentialUnderstandingEn": "Dalton’s atomic hypothesis is an explanatory assumption about atoms and rearrangement. A law describes empirical regularities and a hypothesis is testable and provisional; later atomic knowledge limits individual assumptions, not the usefulness of chemical atom balances.",
          "observablePerformanceDe": "18,00 g Produktmasse ist die Beobachtung. Massenerhaltung fasst solche Messbefunde als empirische Regelmäßigkeit für das geschlossene chemische System zusammen. Die Atomhypothese erklärt sie durch Erhaltung und Umgruppierung der Atome: links und rechts vier H- und zwei O-Atome. Wasser ist eine Verbindung, kein bloßes Gemisch der Ausgangsgase. Ein passender Befund stützt das Modell, beweist aber nicht alle Annahmen endgültig; neue unabhängige Befunde können Grenzen zeigen. Gesetz und erklärendes Teilchenmodell sind unterschiedliche Aussagen.",
          "observablePerformanceEn": "The observed product mass is 18.00 g. Mass conservation summarizes such measurements as an empirical regularity for the closed chemical system. The atomic hypothesis explains it by conservation and rearrangement: four H and two O atoms on each side. Water is a compound, not merely a mixture of the original gases. A compatible finding supports the model but does not definitively establish all assumptions; new independent evidence can reveal limits. A law and an explanatory particle model are distinct kinds of statement."
        },
        {
          "id": "fresh-transfer-and-limit",
          "essentialUnderstandingDe": "Massenerhaltung bei geschlossener Reaktion gegenüber Isotopen und subatomarer Struktur als Grenzen historischer Modellannahmen. Isotope ändern nicht die Elementzugehörigkeit; die chemische Modellgrenze wird nicht auf Kernreaktionen ausgedehnt.",
          "essentialUnderstandingEn": "Mass conservation in a closed reaction versus isotopes and subatomic structure as limits of historical assumptions. Isotopes do not change element identity; the chemical model is not extended to nuclear reactions.",
          "observablePerformanceDe": "Die historische Vorstellung gleicher Masse aller Atome eines Elements ist wegen Isotopen begrenzt; auch Atome sind nicht strukturlose unteilbare Kugeln, sondern enthalten subatomare Bestandteile. Die Elementidentität folgt heute der Protonenzahl. Für gewöhnliche chemische Reaktionen bleibt die Erhaltung und Umgruppierung der Atome ein tragfähiges Bilanzmodell. Eine konkrete Vermutung über die Elektronenanordnung ist eine prüfbare Hypothese, kein schon bestätigtes Gesetz. Ein Modell kann trotz korrigierter Einzelannahmen in einem begrenzten Anwendungsbereich nützlich bleiben.",
          "observablePerformanceEn": "The historical assumption that all atoms of one element have identical mass is limited by isotopes; atoms are not structureless indivisible spheres but contain subatomic constituents. Element identity is tied to proton number. Conservation and rearrangement remain useful balance models for ordinary chemical reactions. A concrete proposed electron arrangement is a testable hypothesis, not an established law. A model can remain useful in a bounded application despite corrected assumptions."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "core-understanding",
          "fresh-transfer-and-limit"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "specific-system-variation",
          "textDe": "Massenerhaltung bei geschlossener Reaktion gegenüber Isotopen und subatomarer Struktur als Grenzen historischer Modellannahmen.",
          "textEn": "Mass conservation in a closed reaction versus isotopes and subatomic structure as limits of historical assumptions."
        },
        {
          "id": "model-boundary",
          "textDe": "Isotope ändern nicht die Elementzugehörigkeit; die chemische Modellgrenze wird nicht auf Kernreaktionen ausgedehnt.",
          "textEn": "Isotopes do not change element identity; the chemical model is not extended to nuclear reactions."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "chem-next20-9b5d6326-case-1",
          "taskDemandDe": "Fiktiver Versuch: In einem geschlossenen Gefäß reagieren 2,00 g H2 mit 16,00 g O2 vollständig zu 18,00 g Wasser; äußerer Stoffaustausch ist ausgeschlossen. Dalton-Modellannahmen: Stoffe bestehen aus Atomen, bei chemischen Reaktionen werden diese nicht vernichtet, sondern neu angeordnet. Die Formel von Wasser ist H2O. Trenne Beobachtung, Massenerhaltungsgesetz und Atomhypothese. Erkläre die Reaktion mit 2 H2 + O2 → 2 H2O und beurteile, ob ein passender Versuch die Hypothese endgültig beweist.",
          "taskDemandEn": "Fictional experiment: in a closed container 2.00 g H2 reacts completely with 16.00 g O2 to give 18.00 g water; external matter exchange is excluded. Dalton assumptions: substances consist of atoms that are rearranged rather than destroyed in chemical reactions. Water has formula H2O. Distinguish observation, the mass-conservation law and the atomic hypothesis. Explain 2 H2 + O2 → 2 H2O and assess whether one compatible experiment proves the hypothesis definitively.",
          "expectedPerformanceDe": "18,00 g Produktmasse ist die Beobachtung. Massenerhaltung fasst solche Messbefunde als empirische Regelmäßigkeit für das geschlossene chemische System zusammen. Die Atomhypothese erklärt sie durch Erhaltung und Umgruppierung der Atome: links und rechts vier H- und zwei O-Atome. Wasser ist eine Verbindung, kein bloßes Gemisch der Ausgangsgase. Ein passender Befund stützt das Modell, beweist aber nicht alle Annahmen endgültig; neue unabhängige Befunde können Grenzen zeigen. Gesetz und erklärendes Teilchenmodell sind unterschiedliche Aussagen.",
          "expectedPerformanceEn": "The observed product mass is 18.00 g. Mass conservation summarizes such measurements as an empirical regularity for the closed chemical system. The atomic hypothesis explains it by conservation and rearrangement: four H and two O atoms on each side. Water is a compound, not merely a mixture of the original gases. A compatible finding supports the model but does not definitively establish all assumptions; new independent evidence can reveal limits. A law and an explanatory particle model are distinct kinds of statement.",
          "understandingFocusDe": "Die Massenerhaltung bei diesen chemischen Reaktionen ist keine Aussage, dass Atome physikalisch unteilbar sind.",
          "understandingFocusEn": "Mass conservation in these chemical reactions does not imply that atoms are physically indivisible."
        },
        {
          "id": "chem-next20-9b5d6326-case-2",
          "taskDemandDe": "Frischer Befundsatz: Chloratome mit derselben Protonenzahl besitzen unterschiedliche Neutronenzahlen und Massen. Elektronen lassen sich als Bestandteile von Atomen nachweisen. Chemische Reaktionsbilanzen zeigen weiterhin die Erhaltung der Anzahl der Atome jedes Elements. Kernreaktionen werden nicht betrachtet. Benenne zwei Grenzen von Daltons historischem Modell und erkläre, warum die Umgruppierungsidee weiterhin zur Darstellung chemischer Reaktionen taugt. Ordne eine neue Vermutung zum Elektronenaufbau als Hypothese ein.",
          "taskDemandEn": "Fresh evidence: chlorine atoms with the same proton number have different neutron numbers and masses. Electrons are detectable components of atoms. Chemical reaction balances still show conservation of each element’s atom count. Nuclear reactions are excluded. Identify two limitations of Dalton’s historical model and explain why rearrangement still represents chemical reactions usefully. Classify a new proposed electronic structure as a hypothesis.",
          "expectedPerformanceDe": "Die historische Vorstellung gleicher Masse aller Atome eines Elements ist wegen Isotopen begrenzt; auch Atome sind nicht strukturlose unteilbare Kugeln, sondern enthalten subatomare Bestandteile. Die Elementidentität folgt heute der Protonenzahl. Für gewöhnliche chemische Reaktionen bleibt die Erhaltung und Umgruppierung der Atome ein tragfähiges Bilanzmodell. Eine konkrete Vermutung über die Elektronenanordnung ist eine prüfbare Hypothese, kein schon bestätigtes Gesetz. Ein Modell kann trotz korrigierter Einzelannahmen in einem begrenzten Anwendungsbereich nützlich bleiben.",
          "expectedPerformanceEn": "The historical assumption that all atoms of one element have identical mass is limited by isotopes; atoms are not structureless indivisible spheres but contain subatomic constituents. Element identity is tied to proton number. Conservation and rearrangement remain useful balance models for ordinary chemical reactions. A concrete proposed electron arrangement is a testable hypothesis, not an established law. A model can remain useful in a bounded application despite corrected assumptions.",
          "understandingFocusDe": "Isotope ändern nicht die Elementzugehörigkeit; die chemische Modellgrenze wird nicht auf Kernreaktionen ausgedehnt.",
          "understandingFocusEn": "Isotopes do not change element identity; the chemical model is not extended to nuclear reactions."
        }
      ]
    }
  },
  {
    "goalId": "9fc800d1-92d1-5ef6-81c1-33960ae034dd",
    "wholeProfile": {
      "archetype": "data",
      "expectations": [
        {
          "id": "traceable-record",
          "essentialUnderstandingDe": "Dokumentation bewahrt Rohwerte und Zuordnung zu Quelle, Probe, Größe, Einheit und Bedingung; fehlende Angaben bleiben als fehlend sichtbar.",
          "essentialUnderstandingEn": "Documentation preserves raw values and links to source, sample, quantity, unit and condition; missing entries remain visibly missing.",
          "observablePerformanceDe": "Eigenständig R1 als strukturierte Tabelle und R2 als getrenntes Ereignis erfassen; keine nachträgliche Temperaturbestätigung oder eigene Messung erfinden.",
          "observablePerformanceEn": "Independently record R1 as a structured table and R2 as a separate event; invent neither retrospective temperature confirmation nor own measurement."
        },
        {
          "id": "observation-interpretation",
          "essentialUnderstandingDe": "Eine Beobachtung bzw. gemeldeter Rohwert unterscheidet sich von einer Modellinterpretation oder berechneten Konzentration.",
          "essentialUnderstandingEn": "An observation or reported raw value differs from a model interpretation or calculated concentration.",
          "observablePerformanceDe": "Beobachtung des Endpunkts und Teilchenerklärung getrennt kennzeichnen; Absorbanzrohdaten, Rechnung, Verdünnung und Konzentration mit Einheiten unterscheiden.",
          "observablePerformanceEn": "Distinguish endpoint observation from particle explanation; separate raw absorbance, calculation, dilution and concentration with units."
        },

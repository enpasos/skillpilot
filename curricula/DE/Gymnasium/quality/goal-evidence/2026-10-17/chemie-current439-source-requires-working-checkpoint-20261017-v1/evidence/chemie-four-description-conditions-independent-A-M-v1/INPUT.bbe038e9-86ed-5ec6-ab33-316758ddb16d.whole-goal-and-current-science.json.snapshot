      },
      "evidenceProfile": {
        "goalId": "bbe038e9-86ed-5ec6-ab33-316758ddb16d",
        "goalFingerprint": "sha256:d1ccfae8b009cefacfa199c09987cf12b48231f3f66692541799a427ec264600",
        "profileRuleVersion": "positive-understanding-evidence-v2",
        "profileFingerprint": "sha256:6336e55426acff8ca8186ad8f3153e2e7348a5f96159ba32a6f7222f6e3e5286",
        "status": "needs_human_review",
        "reviewAuthority": "ai_candidate",
        "evidenceLevel": "E1",
        "maximumClaimScope": "G1",
        "profile": {
          "archetype": "modeling",
          "expectations": [
            {
              "id": "content-specific-understanding",
              "essentialUnderstandingDe": "Im einfachen Elektronenpaarbindungsmodell überlappen einfach besetzte Atomorbitale; ein gemeinsames entgegengesetzt besetztes Paar kann die Kerne binden, wobei auch Abstoßung und ein günstiger Kernabstand berücksichtigt werden.",
              "essentialUnderstandingEn": "In the simple covalent-pair model, singly occupied atomic orbitals overlap; a shared oppositely occupied pair can bind nuclei, with repulsion and a favourable internuclear distance also considered.",
              "observablePerformanceDe": "Die einfach besetzten1s-Orbitale tragen zum gemeinsamen bindenden Paar bei; Elektronendichte zwischen Kernen und elektrostatische Anziehung senken die Energie bis zum Gleichgewichtsabstand. Bei zu großer Annäherung überwiegt Abstoßung; Stabilität ist kein monotoner Abstandseffekt.",
              "observablePerformanceEn": "Singly occupied1s orbitals contribute to the shared bonding pair; density between nuclei and electrostatic attraction lower energy to an equilibrium distance. Excessive approach makes repulsion dominate; stability is not monotonic in separation."
            },
            {
              "id": "fresh-transfer-and-model-boundary",
              "essentialUnderstandingDe": "Der Fall beansprucht keine universelle Regel, dass jede Bindung ausschließlich aus zwei einfach besetzten Ausgangsorbitalen entsteht; koordinative Bindung ist getrennt.",
              "essentialUnderstandingEn": "The case does not claim that every bond starts only from two singly occupied orbitals; coordinate bonding is separate.",
              "observablePerformanceDe": "Je ein Elektron aus passenden einfach besetzten Orbitalen ergibt im Modell ein gemeinsames bindendes Paar mit entgegengesetzten Spins. Die anderenCl-Paare werden nicht zu zusätzlichenH–Cl-Bindungen. Das Modell erklärt Zusammenhalt, keine exakte Bindungsenergie oder vollständige MO-Verteilung.",
              "observablePerformanceEn": "One electron from each suitable singly occupied orbital gives a shared bonding pair with opposite spins in the model. OtherCl pairs do not become extraH–Cl bonds. The model explains cohesion, not exact bond energy or the full MO distribution."
            }
          ],
          "coverageExpectations": {
            "requiredExpectationIds": [
              "content-specific-understanding",
              "fresh-transfer-and-model-boundary"
            ],
            "alternativeExpectationGroups": [],
            "minimumIndependentDemonstrations": 2,
            "freshVariationRequired": true,
            "independentTransferRequired": true
          },
          "variationAxes": [
            {
              "id": "specific-material-variation",
              "textDe": "H–H gegenüberH–Cl; gemeinsame Paarbesetzung und stabiler Abstand statt bloßer Wolkenkontakt.",
              "textEn": "H–H versusH–Cl; shared pair occupancy and stable distance rather than mere cloud contact."
            },
            {
              "id": "specific-model-limit",
              "textDe": "Der Fall beansprucht keine universelle Regel, dass jede Bindung ausschließlich aus zwei einfach besetzten Ausgangsorbitalen entsteht; koordinative Bindung ist getrennt.",
              "textEn": "The case does not claim that every bond starts only from two singly occupied orbitals; coordinate bonding is separate."
            }
          ],
          "applicationCaseBriefs": [
            {
              "id": "chem-next25-bbe038e9-case-1",
              "taskDemandDe": "ZweiH-Atome mit je1s¹. Gegebenes Modell:Energie sinkt bei Annäherung zunächst, erreicht ein Minimum und steigt bei zu kleinem Kernabstand. Im bindenden Überlappungsbereich stehen zwei Elektronen mit entgegengesetztem Spin. ErkläreH2-Zusammenhalt anhand Überlappung, Paar und Energieminimum; korrigiere „je näher die Kerne, desto stabiler“.",
              "taskDemandEn": "TwoH atoms each1s¹. Supplied model:energy first falls on approach, reaches a minimum and rises at very short separation. The bonding overlap has two electrons of opposite spin. ExplainH2 cohesion using overlap, the pair and energy minimum; correct “closer nuclei always mean greater stability”.",
              "expectedPerformanceDe": "Die einfach besetzten1s-Orbitale tragen zum gemeinsamen bindenden Paar bei; Elektronendichte zwischen Kernen und elektrostatische Anziehung senken die Energie bis zum Gleichgewichtsabstand. Bei zu großer Annäherung überwiegt Abstoßung; Stabilität ist kein monotoner Abstandseffekt.",
              "expectedPerformanceEn": "Singly occupied1s orbitals contribute to the shared bonding pair; density between nuclei and electrostatic attraction lower energy to an equilibrium distance. Excessive approach makes repulsion dominate; stability is not monotonic in separation.",
              "understandingFocusDe": "Ein Elektronenpaar gehört im Bindungsmodell nicht ausschließlich einem einzelnenH-Atom.",
              "understandingFocusEn": "A bonding-model electron pair belongs exclusively to neither individualH atom."
            },
            {
              "id": "chem-next25-bbe038e9-case-2",
              "taskDemandDe": "Frisches einfaches Modell:H1s¹ und ein passend gerichtetes einfach besetztesCl-Valenzorbital. Die übrigenCl-Valenzelektronen bleiben hier nichtbindende Paare; Überlappung ist ausdrücklich räumlich möglich. Erkläre die neueH–Cl-Bindung und den Unterschied zwischen bindendem und nichtbindendem Paar. Nenne eine Grenze dieses einfachen Modells.",
              "taskDemandEn": "Fresh simple model:H1s¹ and a suitably oriented singly occupiedCl valence orbital. The remainingCl valence electrons are nonbonding pairs here; spatial overlap is specified as possible. Explain the newH–Cl bond and distinguish bonding from nonbonding pairs. State one limitation of the simple model.",
              "expectedPerformanceDe": "Je ein Elektron aus passenden einfach besetzten Orbitalen ergibt im Modell ein gemeinsames bindendes Paar mit entgegengesetzten Spins. Die anderenCl-Paare werden nicht zu zusätzlichenH–Cl-Bindungen. Das Modell erklärt Zusammenhalt, keine exakte Bindungsenergie oder vollständige MO-Verteilung.",
              "expectedPerformanceEn": "One electron from each suitable singly occupied orbital gives a shared bonding pair with opposite spins in the model. OtherCl pairs do not become extraH–Cl bonds. The model explains cohesion, not exact bond energy or the full MO distribution.",
              "understandingFocusDe": "Der Fall beansprucht keine universelle Regel, dass jede Bindung ausschließlich aus zwei einfach besetzten Ausgangsorbitalen entsteht; koordinative Bindung ist getrennt.",
              "understandingFocusEn": "The case does not claim that every bond starts only from two singly occupied orbitals; coordinate bonding is separate."
            }
          ]
        }
      }
    },

  "delta": {
    "descriptionEn": {
      "old": "The learner can explain the cohesion of atoms in molecules through the overlap of singly occupied orbitals.",
      "new": "The learner can explain the cohesion of atoms in molecules in the simple electron-pair bonding model through the overlap of singly occupied orbitals."
    },
    "description": {
      "old": "Die lernende Person kann den Zusammenhalt von Atomen in Molekülen durch die Überlagerung einfach besetzter Orbitale erklären.",
      "new": "Die lernende Person kann den Zusammenhalt von Atomen in Molekülen im einfachen Elektronenpaarbindungsmodell durch Überlagerung einfach besetzter Orbitale erklären."
    }
  }
}

    {
      "goalId": "a25a19ed-aec3-59cc-ae28-31d98746cb9d",
      "goalFingerprint": "sha256:481b784fe3b066675baf5739fecd465d4f51f0e37e910e853afd7d6199692a2c",
      "pageFingerprint": "sha256:f2490693dd51d38332e0a72124a44e5281a2934876254429bc16319da1e32579",
      "decision": "keep",
      "evidenceProfileRecommendation": "none",
      "rationale": "Körperwirkung, schrittweiser Abbau und situationsbezogene Risikobeurteilung sind eine zusammenhängende evidenzgestützte Entscheidung. DE/EN sind gleichwertig. P unterscheidet akute und langfristige Folgen, äußere Anwendung und Konsum sowie allgemeines Risiko und Individualdiagnose; das Bild endet sichtbar als Teilweg bei Acetat. NIH bestätigt den beschriebenen Stoffweg; es wird keine sichere Menge oder Fahrzeit abgeleitet.",
      "understandingEvidence": {
        "essentialUnderstandingDe": "Ethanol kann Funktionen beeinträchtigen; sein oxidativer Abbau über schädliches Ethanal zu Acetat ist schrittweise und beweist keine sofortige Unbedenklichkeit.",
        "essentialUnderstandingEn": "Ethanol can impair bodily functions; oxidative metabolism through harmful ethanal to acetate proceeds in steps and does not establish immediate harmlessness.",
        "observablePerformanceDe": "Mit bereitgestellter Information akute und längerfristige Wirkungen unterscheiden, das Abbauschema deuten und eine konkrete Sicherheitsentscheidung begründen.",
        "observablePerformanceEn": "Use supplied information to distinguish acute and longer-term effects, interpret the metabolic scheme and justify a concrete safety decision.",
        "transferExpectationDe": "Eine neue Werbe- oder Verkehrssituation anhand von Aufnahmeweg und Beleggrenzen beurteilen, ohne Individualdiagnose oder feste Abbauzeit zu erfinden.",
        "transferExpectationEn": "Assess a new advertising or traffic situation using exposure route and evidence limits without inventing a diagnosis or fixed elimination time."
      },

  "P": {
    "archetype": "representation",
    "expectations": [
      {
        "id": "actual-transform",
        "essentialUnderstandingDe": "Überführen von Information schafft ein eigenes Darstellungsprodukt, das chemische Beziehungen neu organisiert und die Zielgruppe berücksichtigt.",
        "essentialUnderstandingEn": "Transforming information creates an own representation product reorganising chemical relations for the audience.",
        "observablePerformanceDe": "Erzeugt aus dem NaCl-Text ein beschriftetes Teilchen-/Prozessschema und aus Betriebsdaten eine eigene digitale Grafik; begründet Form und Zielgruppensprache.",
        "observablePerformanceEn": "Produces a labelled particle/process scheme from the NaCl text and an own digital chart from operating data; justifies form and audience language."
      },
      {
        "id": "preserve-chemistry-reference",
        "essentialUnderstandingDe": "Eine geeignete Darstellung erhält Zustände, Ladungs-/Stoffbilanz, Einheiten und Bezugsmenge und trennt fachliche Größen mit unterschiedlichen Dimensionen.",
        "essentialUnderstandingEn": "A suitable representation preserves states, charge/material balance, units and reference quantity and separates scientific quantities of different dimensions.",
        "observablePerformanceDe": "Zeigt gleich viele Na⁺/Cl⁻, s/aq und bewegliche Ionen bzw. getrennt kg Frischlösemittel/kg akzeptiertem Produkt und kWh/kg mit nachvollziehbaren Achsen.",
        "observablePerformanceEn": "Shows equal numbers of Na⁺/Cl⁻, s/aq and mobile ions or separately kg fresh solvent/kg accepted product and kWh/kg with traceable axes."
      },
      {
        "id": "choice-and-limits-transfer",
        "essentialUnderstandingDe": "Jede Darstellungsform erhält bestimmte Aussagen und vereinfacht andere; eine neue Zielgruppe ändert notwendige Detailtiefe, nicht die Daten oder Reaktion.",
        "essentialUnderstandingEn": "Every representation retains certain claims and simplifies others; a new audience changes necessary detail, not the data or reaction.",
        "observablePerformanceDe": "Begründet erhaltene Aussagen und Grenzen und passt für Oberstufenprotokoll bzw. Verfahrenstechniker die Darstellung an, ohne Hydrogenerzeugung oder addierten Ökoscore zu erfinden.",
        "observablePerformanceEn": "Justifies preserved claims and limits and adapts representation for an upper-secondary record or process engineers without inventing hydrogen formation or an added eco score."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "actual-transform",
        "preserve-chemistry-reference",
        "choice-and-limits-transfer"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "audience-detail",
        "textDe": "Klasse 8 wird durch Oberstufenlabor ersetzt; Zustände und Ladungsbilanz bleiben erhalten.",
        "textEn": "Grade 8 is replaced by an upper-secondary laboratory; states and charge balance remain preserved."
      },
      {
        "id": "technical-view",
        "textDe": "Öffentliche Grafik erhält für Verfahrenstechniker klare Bilanz-/Systemgrenzen ohne neue Zahlen.",
        "textEn": "A public chart gains clear balance/system boundaries for process engineers without new numbers."
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "chemical-representation-transformation-reaction-process-map",
        "taskDemandDe": "Überführe den Text tatsächlich in eine verständliche Prozessdarstellung mit beschriftetem Teilchen-/Zustandsschema und kurzem Erklärungstext. Begründe Auswahl, Fachsprache, Adressat und erhaltene/begrenzte Aussagen.\nFrische Variation: Passe dieselben Informationen für ein Oberstufenprotokoll an, ohne eine andere chemische Reaktion zu erfinden.",
        "taskDemandEn": "Actually transform the text into an understandable process representation with labelled particle/state scheme and short explanation. Justify selection, terminology, audience and preserved/limited statements.\nFresh variation: Adapt the same information to an upper-secondary record without inventing a different chemical reaction.",
        "expectedPerformanceDe": "Produkt enthält „festes Ionengitter → Wasserzugabe → bewegliche gelöste Ionen“, positive/negative Ionen in gleichem Verhältnis, Zustände s/aq erklärt und Leitfähigkeit über Beweglichkeit/Ladung erläutert. Für Klasse 8 „bewegliche geladene Teilchen“ zusätzlich zum Fachwort verwenden. Schema bewahrt Ladungsbilanz, vereinfacht räumliche Hydratation/Geschwindigkeit und zeigt keine echte atomare Fotografie. Fachtext bloß kopieren wäre kein Überführen.\nFrischer Transfer: Für ein Oberstufenprotokoll das eigene Schema zu NaCl(s)→Na⁺(aq)+Cl⁻(aq) mit sauberer Zustandslegende, Ladungsbilanz und einem Text zur Verteilung/hydratisierten Beweglichkeit ausarbeiten. Im Schema bleiben gleich viele einwertige positive/negative Ionen; das Gitter besteht schon aus Ionen. Hydratation kann als erklärendes Modell ergänzt werden, nicht als neue gemessene Reaktion. Keine H2-Bildung oder Ladungserzeugung wird erfunden. Fachsprache und kompakte Diagramm-/Textverknüpfung passen zum Protokoll; der Bildmaßstab und vereinfachte Hydratation sind kenntlich. Tatsächlich eigenes überarbeitetes Produkt aufbewahren und begründen, welche Aussagen erhalten bleiben und welche Geschwindigkeit/3D-Details es nicht zeigt.",
        "expectedPerformanceEn": "Product contains “solid ionic lattice → water added → mobile dissolved ions”, positive/negative ions in equal ratio, explained s/aq states and conductivity through mobility/charge. For grade 8 use “mobile charged particles” alongside technical terms. Scheme preserves charge balance, simplifies spatial hydration/rate and is not an actual atomic photograph. Merely copying the text is not transformation.\nFresh transfer: For an upper-secondary record develop the own NaCl(s)→Na⁺(aq)+Cl⁻(aq) scheme with a clear state legend, charge balance and text on distribution/hydrated mobility. Equal numbers of singly positive/negative ions remain; the lattice already consists of ions. Hydration may be added as an explanatory model, not a newly measured reaction. No H2 formation or charge creation is invented. Scientific terminology and compact diagram/text linkage fit the record; identify image scale and simplified hydration. Retain an actually own revised product and justify which statements remain and which rate/3D details it does not show.",
        "understandingFocusDe": "Tatsächliches Überführen erhält Stoff-/Ladungsbilanz und passt Detaillierung an die fachliche Zielgruppe an.",
        "understandingFocusEn": "Actual transformation preserves material/charge balance and adapts detail to the scientific audience."
      },
      {
        "id": "chemical-representation-transformation-data-to-public-chart",
        "taskDemandDe": "Überführe Daten tatsächlich in eine geeignete digitale Grafik mit kurzer öffentlicher Erklärung, eindeutigen Bezugsgrößen und Quellen-/Modellangabe. Begründe Darstellungsform und was die Grafik nicht entscheiden kann.\nFrische Variation: Publikum sind nun Verfahrenstechniker: Welche zusätzliche Darstellung/Detailinformation ist sinnvoll, ohne die Daten zu ändern?",
        "taskDemandEn": "Actually transform data into a suitable digital chart with a short public explanation, unambiguous reference quantities and source/model note. Justify representation and what the chart cannot decide.\nFresh variation: Audience is now process engineers: what additional representation/detail is appropriate without changing the data?",
        "expectedPerformanceDe": "Zwei getrennte kleine Diagramme oder Tabelle mit getrennten Skalen/Einheiten: B weniger Frischlösemittel, mehr Energie je kg akzeptiertem Produkt. Eigene digitale Datei muss vorliegen; gleiche Achsennullpunkte verhindern Übertreibung. Erklärung „Zwei Kriterien ändern sich gegensätzlich; ohne Wirkungsfaktoren keine Gesamtumweltzahl“. Modellquelle nennen, Rundung 2,22 kenntlich. Ein einziges unbeschriftetes Balkenpaar oder addierte Einheiten verfälscht.\nFrischer Transfer: Für Verfahrenstechniker dieselben vier gegebenen spezifischen Werte in eine getrennte Stoff-/Energiebilanztabelle mit Systemgrenze „je kg akzeptiertes Produkt“ überführen. Ein eigenes Flussschema kann Frischzufuhr, Trennung/Rückführung und Energiebedarf qualitativ zeigen; Mengen unbekannter Ströme bleiben offen. Interne Rückführung ist kein weiterer Frischverbrauch. Skalen/Einheiten getrennt halten, 2,22 als gerundeten Modellwert kennzeichnen und fehlende Ausbeute-/Verlust-/Wirkungsdaten nennen. Kein Wirkungsfaktor oder Gesamt-Ökoscore wird erfunden. Die technische Darstellung ist wegen ihrer nachvollziehbaren Bilanzgrenze geeignet, während eine öffentliche Kurzgraphik Details reduziert. Eigenes digitales Produkt tatsächlich erzeugen; fremde fertige Grafik allein genügt nicht.",
        "expectedPerformanceEn": "Two separate small charts or a table with separate scales/units: B less fresh solvent, more energy per kg accepted product. Own digital file must exist; common axis zero points avoid exaggeration. Explain “Two criteria change in opposite directions; without impact factors there is no overall environmental number”. Cite model source and mark rounding 2.22. One unlabelled bar pair or added units distorts.\nFresh transfer: For process engineers transform the same four supplied specific values into a separate material/energy balance table with system boundary “per kg accepted product”. An own flow scheme may qualitatively show fresh input, separation/circulation and energy demand; quantities of unknown streams remain open. Internal circulation is not further fresh consumption. Keep scales/units separate, label 2.22 as a rounded model value and name missing yield/loss/impact data. No impact factor or total eco score is invented. The technical representation is suitable because its balance boundary is traceable, whereas a public short chart reduces detail. Actually create an own digital product; somebody else’s completed chart is insufficient.",
        "understandingFocusDe": "Neue technische Darstellungsform erhält Daten/Bezugsgrößen und macht Systemgrenzen statt erfundener Details deutlich.",
        "understandingFocusEn": "A new technical representation preserves data/reference quantities and makes system limits explicit rather than inventing details."
      }
    ]
  }
}

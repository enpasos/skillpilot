      "currentCaseVerbatimEqual": true,
      "scientificMaterial": {
        "goalId": "4a08f31f-204c-5339-9d9f-5d2af28d5d5c",
        "case": {
          "id": "st-named-calorimetry-execution",
          "taskDemandDe": "Verbindliche ST-Verfahren als betreuter, lehrkraftfreigegebener Auftrag: Magnesium und Ammoniumhydrogencarbonat jeweils mit verdünnter Salzsäure. Autoren-Mikromaßstab: getrennt je 20,0 mL HCl 0,20 mol/L im offenen Kalorimeter, einmal 0,0243 g Mg, einmal 0,0791 g NH4HCO3. Säure ist überschüssig; bereitetes C_cal/Temperatursensor. Schutzbrille; keine Zündquelle, kein direkter Gasnachweis, nie gasdicht schließen (H2 bzw. CO2); Lehrkraft regelt Rückstände. Plane, führe beide Reaktionen aus und protokolliere eigene Temperatur-Zeit-Kurven, Massen und Kontroll-/Wiederholungswerte. Formuliere die Stoffgleichungen mit Phasen, berechne die jeweiligen molaren Enthalpien und erkläre, warum Gasbildung allein weder Vorzeichen noch Spontanität bestimmt. Synthetische Vergleichsdaten stehen im vollständigen Fall und sind keine eigenen Beobachtungen.",
          "taskDemandEn": "ST-required methods as a supervised teacher-authorised task: magnesium and ammonium hydrogen carbonate each with dilute hydrochloric acid. Author microscale: separate runs of 20.0 mL HCl 0.20 mol/L in open calorimeters, one with 0.0243 g Mg and one with 0.0791 g NH4HCO3. Acid is in excess; supplied C_cal/temperature sensor. Goggles; no ignition source/direct gas test, never seal gas-tight (H2 or CO2); follow teacher disposal. Plan and execute both reactions, recording actual temperature/time traces, masses, controls and repeats. Give equations with phases, calculate molar enthalpies and explain why gas formation alone establishes neither sign nor spontaneity. Synthetic comparison data are supplied in the whole case and are not your observations.",
          "expectedPerformanceDe": "Mg(s)+2 HCl(aq)->MgCl2(aq)+H2(g); NH4HCO3(s)+HCl(aq)->NH4Cl(aq)+CO2(g)+H2O(l). Bei jeweils 0,00100 mol im synthetischen Modell, m≈20,0243 bzw. 20,0791 g, c_p=4,18 und C_cal=25,0 J/K, ΔT=+4,20 bzw. -0,350 K: etwa -456,55 bzw. +38,13 kJ/mol. Eine Gleichung wird pro Mol des begrenzenden Feststoffs bilanziert. Eigene Ausführung/T(t)/Kontrolle ist verpflichtend; kleine ΔT macht den endothermen Wert besonders unsicher. Gas entführt Stoff/Energie; bei offenen Kalorimetern muss der Einfluss diskutiert werden. Gasbildung allein ist kein Enthalpie- oder Spontanitätsbeweis.",
          "expectedPerformanceEn": "Mg(s)+2 HCl(aq)->MgCl2(aq)+H2(g); NH4HCO3(s)+HCl(aq)->NH4Cl(aq)+CO2(g)+H2O(l). Synthetic model with 0.00100 mol each, m≈20.0243 or 20.0791 g, c_p=4.18 and C_cal=25.0 J/K, ΔT=+4.20 or -0.350 K gives about -456.55 or +38.13 kJ/mol. Use one mole of limiting solid as the reaction basis. Actual execution/T(t)/controls are required; small ΔT makes the endothermic result especially uncertain. Escaping gas transports matter/energy, whose effect in open calorimetry must be discussed. Gas formation alone proves neither enthalpy sign nor spontaneity.",
          "understandingFocusDe": "Genau die verlangten ST-Schülerversuche ausführen und Stoff-/Energiebilanz getrennt deuten.",
          "understandingFocusEn": "Execute the specifically required ST experiments and distinguish matter/energy balances."
        },
        "materialAndData": {
          "de": "Verbindliche ST-Verfahren als betreuter, lehrkraftfreigegebener Auftrag: Magnesium und Ammoniumhydrogencarbonat jeweils mit verdünnter Salzsäure. Autoren-Mikromaßstab: getrennt je 20,0 mL HCl 0,20 mol/L im offenen Kalorimeter, einmal 0,0243 g Mg, einmal 0,0791 g NH4HCO3. Säure ist überschüssig; bereitetes C_cal/Temperatursensor. Schutzbrille; keine Zündquelle, kein direkter Gasnachweis, nie gasdicht schließen (H2 bzw. CO2); Lehrkraft regelt Rückstände.",
          "en": "ST-required methods as a supervised teacher-authorised task: magnesium and ammonium hydrogen carbonate each with dilute hydrochloric acid. Author microscale: separate runs of 20.0 mL HCl 0.20 mol/L in open calorimeters, one with 0.0243 g Mg and one with 0.0791 g NH4HCO3. Acid is in excess; supplied C_cal/temperature sensor. Goggles; no ignition source/direct gas test, never seal gas-tight (H2 or CO2); follow teacher disposal."
        },
        "modelAnswer": {
          "de": "Mg(s)+2 HCl(aq)->MgCl2(aq)+H2(g); NH4HCO3(s)+HCl(aq)->NH4Cl(aq)+CO2(g)+H2O(l). Bei jeweils 0,00100 mol im synthetischen Modell, m≈20,0243 bzw. 20,0791 g, c_p=4,18 und C_cal=25,0 J/K, ΔT=+4,20 bzw. -0,350 K: etwa -456,55 bzw. +38,13 kJ/mol. Eine Gleichung wird pro Mol des begrenzenden Feststoffs bilanziert. Eigene Ausführung/T(t)/Kontrolle ist verpflichtend; kleine ΔT macht den endothermen Wert besonders unsicher. Gas entführt Stoff/Energie; bei offenen Kalorimetern muss der Einfluss diskutiert werden. Gasbildung allein ist kein Enthalpie- oder Spontanitätsbeweis.",
          "en": "Mg(s)+2 HCl(aq)->MgCl2(aq)+H2(g); NH4HCO3(s)+HCl(aq)->NH4Cl(aq)+CO2(g)+H2O(l). Synthetic model with 0.00100 mol each, m≈20.0243 or 20.0791 g, c_p=4.18 and C_cal=25.0 J/K, ΔT=+4.20 or -0.350 K gives about -456.55 or +38.13 kJ/mol. Use one mole of limiting solid as the reaction basis. Actual execution/T(t)/controls are required; small ΔT makes the endothermic result especially uncertain. Escaping gas transports matter/energy, whose effect in open calorimetry must be discussed. Gas formation alone proves neither enthalpy sign nor spontaneity."
        },
        "rubric": {
          "maximumPoints": 5,
          "criteria": [
            {
              "points": 1,
              "aspectDe": "Beide konkret verlangten realen Reaktionen ausführen.",
              "aspectEn": "Execute both specifically required actual reactions."
            },
            {
              "points": 1,
              "aspectDe": "Stoffgleichungen, begrenzenden Stoff und molare Basis angeben.",
              "aspectEn": "Give equations, limiting species and molar basis."
            },
            {
              "points": 1,
              "aspectDe": "Eigene T(t)-Kurven mit Kontrollen auswerten.",
              "aspectEn": "Evaluate actual T(t) curves with controls."
            },
            {
              "points": 1,
              "aspectDe": "Vorzeichen, Calorimeterbeitrag und Beispielrechnung korrekt verwenden.",
              "aspectEn": "Correctly use signs, calorimeter contribution and model arithmetic."
            },
            {
              "points": 1,
              "aspectDe": "Gastransport und geringe Temperaturdifferenz als Grenzen erläutern.",
              "aspectEn": "Explain gas transport and small temperature difference as limits."
            }
          ],
          "fullCreditEvidenceDe": "Mg(s)+2 HCl(aq)->MgCl2(aq)+H2(g); NH4HCO3(s)+HCl(aq)->NH4Cl(aq)+CO2(g)+H2O(l). Bei jeweils 0,00100 mol im synthetischen Modell, m≈20,0243 bzw. 20,0791 g, c_p=4,18 und C_cal=25,0 J/K, ΔT=+4,20 bzw. -0,350 K: etwa -456,55 bzw. +38,13 kJ/mol. Eine Gleichung wird pro Mol des begrenzenden Feststoffs bilanziert. Eigene Ausführung/T(t)/Kontrolle ist verpflichtend; kleine ΔT macht den endothermen Wert besonders unsicher. Gas entführt Stoff/Energie; bei offenen Kalorimetern muss der Einfluss diskutiert werden. Gasbildung allein ist kein Enthalpie- oder Spontanitätsbeweis.",
          "fullCreditEvidenceEn": "Mg(s)+2 HCl(aq)->MgCl2(aq)+H2(g); NH4HCO3(s)+HCl(aq)->NH4Cl(aq)+CO2(g)+H2O(l). Synthetic model with 0.00100 mol each, m≈20.0243 or 20.0791 g, c_p=4.18 and C_cal=25.0 J/K, ΔT=+4.20 or -0.350 K gives about -456.55 or +38.13 kJ/mol. Use one mole of limiting solid as the reaction basis. Actual execution/T(t)/controls are required; small ΔT makes the endothermic result especially uncertain. Escaping gas transports matter/energy, whose effect in open calorimetry must be discussed. Gas formation alone proves neither enthalpy sign nor spontaneity."
        },

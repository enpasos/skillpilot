        "Matched1cm capped cuvettes",
        "10.00mL preparation tubes/volumetric vessels and0.25–5.00mL calibrated pipettes",
        "Thermometer, timer, labels, pipetting aid, waste vessel"
      ],
      "instructorStocks": {
        "lowFe": "0.00200mol/L Fe(NO₃)₃",
        "highFe": "0.200mol/L Fe(NO₃)₃",
        "SCN": "0.00200mol/L KSCN",
        "matrix": "0.100mol/L HNO₃; all three supplied stock solutions use this same dilute matrix, freshly prepared by the instructor",
        "chlorideAdded": false,
        "learnerConcentratedAcidPreparation": false
      },
      "preparations": [

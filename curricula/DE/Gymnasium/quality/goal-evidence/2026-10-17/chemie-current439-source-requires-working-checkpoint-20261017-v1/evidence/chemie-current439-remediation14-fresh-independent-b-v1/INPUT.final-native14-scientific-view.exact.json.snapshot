          "visualization": {
            "resourceType": "image",
            "title": "Visualisierung: Stoffkreisläufe mit Reaktionen und physikalischen Vorgängen beschreiben",
            "url": "/assets/goal-visualizations/chemie/c0f1bf09-5a70-5006-b1e9-e91f786a63bf/c0f1bf09-5a70-5006-b1e9-e91f786a63bf.png",
            "altText": "Didaktische Visualisierung zum Lernziel \"Stoffkreisläufe mit Reaktionen und physikalischen Vorgängen beschreiben\". Die lernende Person kann verschiedene Typen chemischer Reaktionen und physikalischer Vorgänge nutzen, um Stoffkreisläufe in Natur und Technik fachlich zu beschreiben.",
            "originalDigest": "sha256:65cdc6d849de53b37ee2c47909455f876844c4f48fc425c70a15194e40790e7c",

        "evidenceProfile": {
          "goalId": "e20d205f-03a4-5f96-b456-9b20460605a2",
          "goalFingerprint": "sha256:9ff3425b376074e63ed2149a0ca9c8b837aaf8b1c2582e37f10d9d57b6f7bf7e",
          "reviewInputFingerprint": "sha256:8a67c33b0f0c76940ef44d6d8062696b82c378ff2495de6e32492508536f2355",
          "profileRuleVersion": "positive-understanding-evidence-v2",
          "profileFingerprint": "sha256:76f22db7df98261eda5234fa0fb7722c4ce78687ffa2f2e7b08e3893182f9c19",
          "status": "needs_human_review",

  "P": {
    "archetype": "concept",
    "expectations": [
      {
        "id": "whole-historical-current-chain",
        "essentialUnderstandingDe": "Chemische Produkte, Methoden, Verfahren und Erkenntnisse wirken in historischen UND aktuellen gesellschaftlichen Zusammenhängen zusammen.",
        "essentialUnderstandingEn": "Chemical products, methods, processes and knowledge interact in historical AND current societal settings.",
        "observablePerformanceDe": "Ordnet für Ammoniak bzw. Kühlung jeweils Produkt, Analyse-/Kontrollmethode, technisches Verfahren und Wissen der historischen Entwicklung und dem heutigen Entscheidungskontext zu.",
        "observablePerformanceEn": "Relates product, analysis/control method, technical process and knowledge for ammonia or cooling to historical development and today’s decision context."
      },
      {
        "id": "three-perspective-evaluation",
        "essentialUnderstandingDe": "Nachhaltigkeitsbewertung verbindet ökologische, ökonomische und soziale Perspektiven mit gleicher Bezugsleistung; gute Einzelindikatoren ersetzen keine Gesamtabwägung.",
        "essentialUnderstandingEn": "Sustainability evaluation combines environmental, economic and social perspectives for equal reference service; good individual indicators do not replace a full judgment.",
        "observablePerformanceDe": "Bewertet Ressourcen/Verluste, Kosten und fairen Wissenszugang bzw. Ozon/Klima, Betrieb/Sicherheit und Zugang; trennt Modellzahlen, historische Quellen und fehlende Wirkungsdaten.",
        "observablePerformanceEn": "Evaluates resources/losses, cost and fair knowledge access or ozone/climate, operation/safety and access; separates model numbers, historical sources and missing impact data."
      },
      {
        "id": "own-action-and-fresh-change",
        "essentialUnderstandingDe": "Eigenes Handeln beeinflusst eine begrenzte Wirkungskette; gleiche Wissenszugänge oder neue Leckagedaten verändern gezielt Teile der Bewertung.",
        "essentialUnderstandingEn": "Own action affects a bounded chain of impacts; equal knowledge access or new leakage data selectively changes parts of evaluation.",
        "observablePerformanceDe": "Reflektiert eigene mögliche Informations-/Nutzungs-/Meldehandlungen und aktualisiert bei geteiltem Wissen bzw. neuer Leckage die ökologische, ökonomische und soziale Begründung ohne eigenmächtige chemische Anwendung.",
        "observablePerformanceEn": "Reflects on own possible information/use/reporting actions and updates environmental, economic and social justification for shared knowledge or new leakage without unauthorised chemical application."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [

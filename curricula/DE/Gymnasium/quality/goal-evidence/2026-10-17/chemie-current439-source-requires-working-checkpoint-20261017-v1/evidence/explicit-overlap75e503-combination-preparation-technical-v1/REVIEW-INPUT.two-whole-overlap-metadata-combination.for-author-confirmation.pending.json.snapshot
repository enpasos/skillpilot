              ],
              "viewIds": [
                "de-nw-gym-chemistry-gk",
                "de-nw-gym-chemistry-lk"
              ],
              "role": "already-authored-own-acquisition-topic",
              "officialWholeSourceCredit": false,
              "sourceContextAndLimits": "NW SekI pp18/26 has own questions/testable hypotheses, progressively framed; NW upper pp23-24 and33-34 distinguish EF from qualification theory-guided expectations. This ordinary question/hypothesis teacher is actually required by503dedcb and stays a target in the two NW views. No independent NW override; later compiler derivation from the supported upper acquisition must be actually measured. It does not certify a complete experiment or source phase completion.",
              "wholeUnchangedAcquisitionScope": "Own everyday question and justified observation-testable hypothesis, supporting/counterfindings, controls and fresh size/oxygen-access confounds. No actual experiment fabricated.",
              "compilerScopeSemantics": "No independent override. Actual 503dedcb-0efc-5e6b-bbc9-20761a0951f5 requires this existing ordinary teacher; future actual derived eligibility must be measured.",
              "ownerPolicyBoundary": "16Oct Chemistry owner policy retains authored topics before later topic-selection flow; no actual learner choice, assumed mastery or universal official duty is asserted.",
              "nativeAndPerformanceBoundary": "P/SEM/M/card/image final bindings and full native/source/practical/digital performance remain separate; AI author candidate, no Human/M7 acceptance."
            }

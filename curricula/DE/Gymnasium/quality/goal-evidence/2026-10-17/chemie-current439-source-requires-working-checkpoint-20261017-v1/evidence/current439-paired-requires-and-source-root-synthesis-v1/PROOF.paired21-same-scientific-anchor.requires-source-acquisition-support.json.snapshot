      "AWholeScientificDockets": [
        {
          "docketInstanceId": "goal-e7c363d4-e02d-4895-8750-ba62c2eb63fe-required-by-11bea4c6-7b8a-47e0-8293-2eb1ce34cf66::6::e7c363d4-e02d-4895-8750-ba62c2eb63fe::DE-RP",
          "candidateGoalId": "e7c363d4-e02d-4895-8750-ba62c2eb63fe",
          "jurisdiction": "DE-RP",
          "decision": "approve",
          "thisPhysicalEdgeDecision": "approve",
          "thisPhysicalEdgeNecessityRationale": "Independently writing and checking balanced equations requires interpreting element symbols and molecular formulas, counting atoms and distinguishing indices from coefficients. Those are the prerequisite's whole symbolic operations; without them coefficient adjustment could silently change substance identity.",
          "routeNecessityReview": [
            {
              "prerequisiteGoalId": "e7c363d4-e02d-4895-8750-ba62c2eb63fe",
              "dependentGoalId": "11bea4c6-7b8a-47e0-8293-2eb1ce34cf66",
              "groupIndex": 68,
              "reviewGroupId": "goal-e7c363d4-e02d-4895-8750-ba62c2eb63fe-required-by-11bea4c6-7b8a-47e0-8293-2eb1ce34cf66",
              "physicalDecision": "approve",
              "rationale": "Independently writing and checking balanced equations requires interpreting element symbols and molecular formulas, counting atoms and distinguishing indices from coefficients. Those are the prerequisite's whole symbolic operations; without them coefficient adjustment could silently change substance identity."
            }
          ],
          "sourceDecision": "approve_qualified_acquisition_support",
          "concreteJurisdictionReason": "The original TF6 competencies explicitly explain neutralisation in formula language, and the conceptual row describes neutralisation with reaction equations. Interpreting/forming correct formulas and distinguishing indices from coefficients is necessary to that symbolic explanation. PDF p.78 and printed p.76 are distinguished.",
          "mechanicallySelectedOriginalAnchor": {
            "anchorId": "anchor-0a15e169c67dd860c25a",
            "endpointGoalId": "11bea4c6-7b8a-47e0-8293-2eb1ce34cf66",
            "sourceCellId": "4eb03df6-9416-5dc8-8957-a9cd3d5ce6a9::rp-chem-seki-rp-ch-seki-2014-tf06-sauren-und-laugen-006-a9a4d378",
            "sourceGoalId": "rp-chem-seki-rp-ch-seki-2014-tf06-sauren-und-laugen-006-a9a4d378",
            "sourceOperationAsExtracted": "zentrale Basiskonzepte und Fachbegriffe des Themenfeldes fachsprachlich verwenden: Fachbegriffe: Auf der Stoffebene: Die Verwendung von sauren und alkalischen Lösungen beruht auf ihren Reaktionen (z. B. Neutralisationen, Reaktionen mit Kalk und unedlen Metallen). (SEF) Indikatoren zeigen durch charakteristische Farben unterIndikator, pH-Wert schiedliche pH-Wert-Bereiche an. Bei chemischen Reaktionen wandeln sich Stoffe um. Säuren bilden mit Wasser saure Lösungen. Säure, saure Lösung (Säure Alkalien bilden mit Wasser alkalische Lösungen (Laugen). i. e. S.) Bei der Neutralisation heben sich Säuren und Laugen in ihBase/Alkalien, alkalische rer Wirkung auf. (CR) Lösung (Lauge) Neutralisation Auf der Teilchenebene: Saure Lösungen enthalten mehr oder weniger OxoniumOxonium-Kation, Kationen. Alkalische Lösungen enthalten mehr oder weniger Hydroxid-Anion Hydroxid-Anionen. (TMS) Bei der Neutralisationsreaktion reagieren Oxonium-Kationen mit Hydroxid-Anionen zu Wassermolekülen. Protonenübertragung, Neutralisationsreaktionen werden mit Reaktionsgleichungen Donator-Akzeptor-Prinzip beschrieben. (CR) 76",
            "sourceRefAsExtracted": "RP-CH-SEKI-2014 S. 78",
            "sourceSpanAsExtracted": "Themenfeld 6: Säuren und Laugen, Source-Ziel 6",
            "courseLevelAsExtracted": "GK_LK",
            "sourceTagsAsExtracted": [
              "jurisdiction:DE-RP",
              "stage:SekI",
              "topic:tf06-sauren-und-laugen",
              "courseLevel:GK_LK"
            ],

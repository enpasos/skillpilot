    "wholeTeacherScience": [
      {
        "goalId": "11bea4c6-7b8a-47e0-8293-2eb1ce34cf66",
        "judgment": "KEEP",
        "reason": "Given formulas/ionic charges, coefficients rather than indices, atom/charge conservation, electron cancellation, new Al/Ca charge-ratio transfer: actual symbolic equation acquisition. No experiment is inferred."
      },
      {
        "goalId": "22133f29-ef02-4408-8f8d-2bbea3275d91",
        "judgment": "KEEP",
        "reason": "Oxidation numbers, half-equations and matching electron counts, plus fresh explicitly acidic permanganate/Fe transfer. It is the genuine balancing foundation retained for photosynthesis and electrolysis; all provided profile facets remain intact for both tagged courses."
      },
      {
        "goalId": "642d5ea5-b62f-50c8-b0bd-cf132619725f",
        "judgment": "KEEP",
        "reason": "Closed electronic/ionic paths, oxygen reduction, barrier versus sacrificial action, local area/aeration and contact/maintenance conditions: coherent actual corrosion acquisition. Only the one applicable BY-LK placement is added; two NI placements remain open."
      },
      {
        "goalId": "70b12d1c-abaf-45c6-ae9e-b571e9cbc126",
        "judgment": "KEEP",
        "reason": "NaCl melt and constrained aqueous CuCl2 models, ion/electrode paths, balanced equations and water-product limits: actual simple-electrolysis acquisition, not a memorization-only repair. No real chlorine experiment is claimed."
      },
      {
        "goalId": "8ceb1749-fce0-584f-a2b8-0a309282329a",
        "judgment": "KEEP",
        "reason": "Fractionation separates existing molecules by boiling behaviour; thermal cracking changes molecules into conditional alkane/alkene mixtures, with balanced model/transfer and yield limits. Entire old P is preserved at the new one BY-LK foundation target."
      },
      {
        "goalId": "a530ee7d-1002-5f02-ae05-a9d46410ac78",
        "judgment": "KEEP",
        "reason": "Qualitative breaking costs versus formation release, same-amount net contribution and hypothetical free-atom bookkeeping limits. Distinct exo/endo paper cases support the qualitative enthalpy target. Six placements are supported; HB remains excluded."
      }
    ],

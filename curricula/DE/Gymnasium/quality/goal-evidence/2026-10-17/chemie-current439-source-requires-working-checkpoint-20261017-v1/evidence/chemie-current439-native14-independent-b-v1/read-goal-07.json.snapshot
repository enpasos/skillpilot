    },
    "variationAxes": [
      {
        "id": "out-of-range",
        "textDe": "Absorbanz überschreitet den oberen Standard; Gültigkeitsflag und weitere Messanforderung werden digital sichtbar.",
        "textEn": "Absorbance exceeds the upper standard; a validity flag and further measurement requirement are digitally visible."

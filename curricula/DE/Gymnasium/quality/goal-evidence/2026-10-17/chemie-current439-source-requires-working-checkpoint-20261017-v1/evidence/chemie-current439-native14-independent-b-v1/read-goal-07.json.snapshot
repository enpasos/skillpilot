  "P": {
    "archetype": "data",
    "expectations": [
      {
        "id": "actual-digital-analysis",
        "essentialUnderstandingDe": "Digitale Auswertung macht Rechenweg, Rohdaten und Modellannahmen nachvollziehbar; eine gelesene fertige Grafik zeigt keine eigene Nutzung.",
        "essentialUnderstandingEn": "Digital evaluation makes computation, raw data and assumptions traceable; reading a completed chart does not show own tool use.",
        "observablePerformanceDe": "Erstellt eine eigene Datei mit den markierten Modell-Rohdaten, Formeln, Scatterplot/Regression, Einheiten und überprüfbaren Zellbezügen für Kalibrierung und Kinetik.",
        "observablePerformanceEn": "Creates an own file with labelled model raw data, formulas, scatterplot/regression, units and checkable cell references for calibration and kinetics."
      },
      {
        "id": "mathematical-chemical-inference",
        "essentialUnderstandingDe": "Lineare Kalibrierung und logarithmierte Konzentrations-Zeit-Beziehung beantworten unterschiedliche chemische Fragen unter begrenzten Modellannahmen.",
        "essentialUnderstandingEn": "Linear calibration and log concentration–time relations answer different chemical questions under bounded model assumptions.",
        "observablePerformanceDe": "Ermittelt mit Offset die Modellkonzentration 7 mg/L sowie k≈0,05 min⁻¹ und Halbwertszeit≈13,86 min, interpretiert Residuen und stellt den mathematisch-chemischen Zusammenhang zur Hypothese her.",
        "observablePerformanceEn": "Obtains model concentration 7 mg/L with an offset and k≈0.05 min⁻¹ and half-life≈13.86 min, interprets residuals and connects mathematics and chemistry to the hypothesis."
      },
      {
        "id": "fresh-digital-decision",
        "essentialUnderstandingDe": "Außerhalb kalibrierter Daten oder bei einer veränderten Datenreihe müssen Gültigkeit und Modellpassung erneut geprüft werden; Streuung ist nicht Gesamtunsicherheit.",
        "essentialUnderstandingEn": "Outside calibration data or after changing a dataset validity and model fit must be checked again; scatter is not total uncertainty.",
        "observablePerformanceDe": "Bearbeitet A=0,650 als formal berechenbaren, aber nicht berichtbaren Bereichsfehler und c20=0,050 als neue markierte Datenversion; berechnet erneut, dokumentiert Residuen und begründet Unterstützung oder begrenzten Gegenbefund.",
        "observablePerformanceEn": "Handles A=0.650 as a formally computable but unreportable range error and c20=0.050 as a new labelled data version; recalculates, documents residuals and justifies support or a bounded counterfinding."
      }
    ],
    "coverageExpectations": {

      "exactSelectedOwnerContextIssue": "chemie:chemie-current435-seventeen-pending-descriptions-20261016-v1-strict-resolutions: cc5a626a-dc85-57e2-b422-259f92901545: Current V3 context for cc5a626a-dc85-57e2-b422-259f92901545 disagrees with the canonical goal",
      "exactBilingualFinalTextDifferences": [],
      "exactCanonicalContextDifferences": [
        {
          "field": "applicability.jurisdiction",
          "before": [
            "DE-BY",

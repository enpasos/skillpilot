    {
      "goalId": "cc5a626a-dc85-57e2-b422-259f92901545",
      "titleDe": "Biologische Abbauwege von Tensiden beschreiben",
      "full439Position": 329,
      "selectedUniqueOwnerIndexPath": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-current435-seventeen-pending-description-native-technical-20261016-v1/native-seventeen/resolution-index.json",

  "profile": {
    "archetype": "data",
    "expectations": [
      {
        "id": "e1",
        "essentialUnderstandingDe": "Wirkungsgrad ist nutzbarerOutput geteilt durchInput an einer erklärten Grenze.",
        "essentialUnderstandingEn": "Efficiency is useful output/input at an explicit boundary.",
        "observablePerformanceDe": "energy20-13-a: Drei verschiedene Nutzengrenzen ausdrücklich definieren. energy20-13-b: Strom-/Brennstoff- und Radarbeitsgrenzen korrekt auswählen.",
        "observablePerformanceEn": "energy20-13-a: Explicitly define three useful-output boundaries. energy20-13-b: Select electricity/fuel/wheel-work boundaries correctly."
      },
      {
        "id": "e2",
        "essentialUnderstandingDe": "Teil- und Kettenwirkungsgrade werden auf einer deklarierten Energiebezugsbasis aus tatsächlich genutztem Output berechnet; nicht nachgefragte Wärme ist kein genutzter Dienst.",
        "essentialUnderstandingEn": "Partial and chain efficiencies use a declared energy basis and actual useful output; undemanded heat is not used service.",
        "observablePerformanceDe": "energy20-13-a: 30/80/50% und60/85/70% korrekt berechnen. energy20-13-b: 82%,32,8%,25% und gemeinsame15kWh-Servicebasis herleiten.",
        "observablePerformanceEn": "energy20-13-a: Correctly calculate30/80/50% and60/85/70%. energy20-13-b: Derive82%,32.8%,25% and common15kWh service."
      },
      {
        "id": "e3",
        "essentialUnderstandingDe": "Teil- und Kettenwirkungsgrade brauchen gleiche Nutzfunktion und Fehlergrenze.",
        "essentialUnderstandingEn": "Partial/chain efficiencies need equal service and error boundaries.",
        "observablePerformanceDe": "energy20-13-a: Energieerhaltung, Nutzung, Vergleichsbasis und absolute Fehlergrenzen auseinanderhalten. energy20-13-b: Verschiedene Nutzfunktionen und einmalige Verlustbilanz erklären; kein Umwelturteil aus einem Teilwirkungsgrad.",
        "observablePerformanceEn": "energy20-13-a: Separate energy conservation, service, comparison basis and absolute error bounds. energy20-13-b: Explain different service functions and count losses once; no environmental verdict from one partial efficiency."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "e1",
        "e2",
        "e3"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "energy20-13-a-transfer",
        "textDe": "Der Wärmebedarf wächst auf5MJ und die Stromnachfrage sinkt. Bestimme neu, welche Kennzahl für diesen Dienst relevant ist, statt einen festen Sieger ausηel abzuleiten.",
        "textEn": "Heat demand rises to5MJ while electricity demand falls. Reconsider the relevant metric instead of choosing a permanent winner fromηel."
      },
      {
        "id": "energy20-13-b-transfer",
        "textDe": "Strom kommt nun direkt aus einerPV-Anlage. Sage, welche bekannte Teilwirkungsgradmessung bleibt und welche Primärenergie-Konvention neu deklariert werden muss.",
        "textEn": "Electricity now comes directly fromPV. Identify the unchanged measured partial efficiency and the primary-energy convention requiring a new declaration."
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "energy20-13-a",
        "taskDemandDe": "Ganzes eigenes Material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-four-context-satisfied-current422-positive-and-atomic-informed-20261015-v1/materials/four-whole-cases8.targeted-informed-successor.json #energy20-13-a,sha256:e1e84ffeff7db7534372949e9cf38f5dfd2a95546fcfba6d07ee177e369098bf. Berechne elektrische, nominelle Gesamt- und bedarfsbezogene Gesamtwirkungsgrade. Vergleiche auf gemeinsamer Eingangs- oder Servicebasis und erkläre, warum WandlerB nicht85%nutzbare Energie liefert, wenn Wärmebedarf fehlt. Bestimme aus den vorgegebenen Fehlergrenzen passende Wirkungsgradintervalle; zähle den festen Wärmebedarf nicht als weitere Messunsicherheit.",
        "taskDemandEn": "Whole own material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-four-context-satisfied-current422-positive-and-atomic-informed-20261015-v1/materials/four-whole-cases8.targeted-informed-successor.json #energy20-13-a,sha256:e1e84ffeff7db7534372949e9cf38f5dfd2a95546fcfba6d07ee177e369098bf. Calculate electrical,nominal-total and demand-adjusted efficiencies. Compare on a common input/service basis and explain whyB does not deliver85%useful energy when heat demand is absent. Derive efficiency intervals from the given error bounds; do not treat the fixed heat demand as an extra measurement uncertainty.",
        "expectedPerformanceDe": "A:ηel30%, nominell80%, mit2MJBedarf50%. B:ηel60%, nominell85%, mit2MJBedarf70%. Bei gleichem20MJ-Eingang entsprichtA zwei Durchgängen und anderem Serviceumfang; dieser Vergleich muss ausdrücklich bezeichnet werden. Wirkungsgrade sind dimensionslose Anteile, nichtMJ-Werte; ungenutzte Wärme bleibt Energie, aber keine für diese Nachfrage genutzte Arbeit/Wärme. Unsicherheiten verhindern hier nicht den großen Stromunterschied, aber eine feinere Rangfolge braucht Fehlerrechnung und einheitliche Grenze. Bei den ausdrücklich exakten Eingängen ergeben sich für A elektrisch29–31%, nominell78–82% und bedarfsbezogen49–51%; für B59,5–60,5%,84–86% und69,5–70,5%. Für die nominale Summe werden die beiden absoluten Fehlergrenzen konservativ addiert. Bei2MJBedarf liegt selbst die kleinste verfügbare Wärme über dem Bedarf: nur die Stromfehlergrenze wirkt auf den bedarfsbezogenen Zähler. Ohne Wärmenutzung liefert B60% elektrischen Nutzen, nicht85%. Im Transfer mit5MJWärmebedarf wären bei vollständig genutztem Strom die nominalen Werte relevant; sinkende Stromnachfrage ohne Zahlen erlaubt keinen neuen eindeutigen Gesamtnutzen.",
        "expectedPerformanceEn": "A:electrical30%,nominal80%,with2MJ demand50%. B:electrical60%,nominal85%,with2MJ demand70%. Equal20MJ input means twoA cycles and a different service total,which must be declared. Efficiencies are dimensionless fractions,notMJ. Unused heat remains energy but is not useful service for this demand. Uncertainty does not erase the large electrical difference;fine rankings need error analysis/common boundaries. With the explicitly exact inputs, A has electrical29–31%, nominal78–82% and demand-adjusted49–51%; B has59.5–60.5%,84–86% and69.5–70.5%. For nominal sums, conservatively add both absolute output error bounds. At2MJ heat demand even the smallest heat output exceeds demand, so only the electricity error bound affects the demand-adjusted numerator. With no heat use, B supplies60% electrical service, not85%. In the5MJ-heat transfer, nominal values apply if all electricity is used; an unspecified reduction in electricity demand prevents a unique new useful-output result.",
        "understandingFocusDe": "Der Wärmebedarf wächst auf5MJ und die Stromnachfrage sinkt. Bestimme neu, welche Kennzahl für diesen Dienst relevant ist, statt einen festen Sieger ausηel abzuleiten.",
        "understandingFocusEn": "Heat demand rises to5MJ while electricity demand falls. Reconsider the relevant metric instead of choosing a permanent winner fromηel."
      },
      {
        "id": "energy20-13-b",
        "taskDemandDe": "Ganzes eigenes Material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-four-context-satisfied-current422-positive-and-atomic-informed-20261015-v1/materials/four-whole-cases8.targeted-informed-successor.json #energy20-13-b,sha256:e1e84ffeff7db7534372949e9cf38f5dfd2a95546fcfba6d07ee177e369098bf. Berechne Steckdose-Rad, Primärenergie-Rad und Brennstoff-Rad-Wirkungsgrad. Normiere für einen Vergleich beide auf15kWh Radarbeit. Prüfe die Behauptung „82%ist direkt mit25%vergleichbar, also ist die ganze Kette82%“. Erkläre zusätzlich, weshalb die80%/5% aus dem Übersichtskontext verschiedene Nutzfunktionen betreffen und keinen allgemeinen Anwendungssieger festlegen.",
        "taskDemandEn": "Whole own material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-four-context-satisfied-current422-positive-and-atomic-informed-20261015-v1/materials/four-whole-cases8.targeted-informed-successor.json #energy20-13-b,sha256:e1e84ffeff7db7534372949e9cf38f5dfd2a95546fcfba6d07ee177e369098bf. Calculate socket-to-wheel,primary-to-wheel and fuel-to-wheel efficiencies. Normalise both to15kWh wheel work. Evaluate“82%can directly be compared with25%,so the entire chain is82%”. Also explain why the overview’s80%/5% use different service functions and cannot select a universal application winner.",
        "expectedPerformanceDe": "ηsocket=16,4/20=82%; Primärinput20/0,4=50kWh,ηgesamt32,8%. Brennstoff-Rad-Pfad15/60=25%. Für15kWhRad benötigtEV15/0,82≈18,293kWhSteckdosenstrom und45,732kWhPrimärenergie; Verbrennungspfad60kWh.82%beschreibt eine engere Grenze als25%Brennstoff-Rad. Ein anderer Strombereitstellungsweg verändert Primärenergiedefinition und Bilanz; die Daten zeigen keine vollständige Ökobilanz. Die40%-Strecke endet bereits an der Steckdose; ihre Verluste werden einmal berücksichtigt. Brennstoffgewinnung beider Wege und Herstellungsbilanzen sind nicht nachgewiesen. Die80% eines Motors und5% einer Lampe sind korrekt als numerische Anteile verschiedener definierter Nutzformen lesbar; mechanische Arbeit und Licht sind keine austauschbare Dienstleistung. Daraus folgt kein allgemeines Umwelt- oder Einsatzranking.",
        "expectedPerformanceEn": "Socket efficiency16.4/20=82%;primary input20/0.4=50kWh,total32.8%. Fuel-to-wheel path15/60=25%. For15kWh wheels,EV needs15/0.82≈18.293kWh socket and45.732kWh primary;combustion60kWh.82%uses a narrower boundary than fuel-to-wheel25%. Another electricity route changes primary-energy conventions/accounting;this is not a completeLCA. The40% path already ends at the socket, so count its losses once. Fuel extraction for both routes and manufacturing inventories are not established. A motor’s80% and a lamp’s5% are numerical fractions of different defined service forms; mechanical work and light are not interchangeable services. They establish no universal environmental or application ranking.",
        "understandingFocusDe": "Strom kommt nun direkt aus einerPV-Anlage. Sage, welche bekannte Teilwirkungsgradmessung bleibt und welche Primärenergie-Konvention neu deklariert werden muss.",
        "understandingFocusEn": "Electricity now comes directly fromPV. Identify the unchanged measured partial efficiency and the primary-energy convention requiring a new declaration."
      }
    ]
  },

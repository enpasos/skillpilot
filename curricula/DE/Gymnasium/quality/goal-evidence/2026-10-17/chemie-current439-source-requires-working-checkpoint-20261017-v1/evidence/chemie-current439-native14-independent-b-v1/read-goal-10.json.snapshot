    "archetype": "concept",
    "expectations": [
      {
        "id": "chemical-function",
        "essentialUnderstandingDe": "Chemische Anwendungen erfüllen Funktionen durch Stoffeigenschaften, Trennvorgänge, Reaktion oder Energieumwandlung.",
        "essentialUnderstandingEn": "Chemical applications fulfil functions through material properties, separation, reaction or energy conversion.",
        "observablePerformanceDe": "Erklärt Flockung/Korrosionsschutz sowie Verpackungsbarriere/Batterie anhand der bereitgestellten chemischen Zusammenhänge.",
        "observablePerformanceEn": "Explains flocculation/corrosion protection and packaging barriers/batteries using the supplied chemical relations."
      },
      {
        "id": "societal-human-environment",
        "essentialUnderstandingDe": "Der Nutzen einer Anwendung ist mit Bedingungen und möglichen Folgen für Mensch und Umwelt verbunden.",
        "essentialUnderstandingEn": "The benefit of an application is connected with conditions and possible consequences for people and the environment.",
        "observablePerformanceDe": "Diskutiert Wasser-/Materialschutz, Lebensmittelverluste oder Energieversorgung zusammen mit Reststoffen, Migration, Sicherheit, Rohstoff- und Rückgewinnungsfragen.",
        "observablePerformanceEn": "Discusses water/material protection, food losses or energy supply together with residues, migration, safety, resources and recovery."
      },
      {
        "id": "fresh-function-limits",
        "essentialUnderstandingDe": "Ein Materialname garantiert keine allgemeine Wirkung; Abbaubedingungen und unterschiedliche Funktionsanforderungen können ein Urteil verändern.",
        "essentialUnderstandingEn": "A material name guarantees no general effect; degradation conditions and different functional requirements can change a judgment.",
        "observablePerformanceDe": "Begrenzt den Begriff biologisch abbaubar anhand benötigter Bedingungen und erläutert chemisch zwei gesellschaftliche Anwendungen mit widersprechenden Barriere-/Durchlässigkeitsanforderungen.",
        "observablePerformanceEn": "Bounds the term biodegradable through required conditions and chemically explains two societal applications with opposing barrier/permeability requirements."
      }
    ],

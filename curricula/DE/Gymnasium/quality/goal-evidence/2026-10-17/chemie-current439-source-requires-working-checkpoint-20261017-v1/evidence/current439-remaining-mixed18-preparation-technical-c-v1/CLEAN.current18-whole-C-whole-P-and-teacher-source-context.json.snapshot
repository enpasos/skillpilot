        "goalFingerprint": "sha256:73fed7cc4495065b177881a98ad74f77b8d784a7c931aecc023f7e7d3cb2b930",
        "reviewInputFingerprint": "sha256:2abc5bd1cd275a073b9e08ec5e5b5e483aec6eec81e97fb71ea62d1ee8889098",
        "profileFingerprint": "sha256:8a9cf59b9f5d20dcbe5217fc190ca0cf037d429ccfa861c0109c84bd4c6c5adf",
        "status": "needs_human_review",

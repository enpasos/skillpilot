        "reviewedAt": "2026-10-16T18:54:46.347264+00:00",
        "reviewer": "/root/chemie_native9_fresh_independent_a_20261016",
        "reason": "Actual complete DE/EN closed phosphate-buffer materials supply species and acid/base pulses. Bronsted1c142+LeChatelier5a24 are sufficient for qualitative reserve/balance explanation.5/5+1 gives6/4 or4/6; doubled reserve11/9;2/8+3acid gives5/5. NoHH/pKa/interference/clinical-selection duty. HE common optional phosphate theme remains owner-targeted. Separate outsideBY acquisition holds remain outside this P-design claim. Own current-context synthesis tmp/chemie-m7-resumed-20261016/HE-final-six-P-current-context-independent-a-v1/FIRST.own-final-six-P-current-context.before-record-serialization.json sha256:67ffb7e96e5c9abce5d06260753f92276d67c117a1d7071fe8d46e4785420cf6; original frozen whole-context science tmp/chemie-m7-resumed-20261016/HE-admission-current-independent-a-v1/FIRST.exact-HE-seven-wholes-four-views-source-and-admission.independent-a.science.frozen.json sha256:6a7f4dc40b4639ceb61849724b88a8cc644ea8dd1f7f163e148ddc47cc04b2ed. Whole profile/cases/criteria and unchanged actual resourcebytes retained. New own review identity/date bind the actual current requires/tags; no historical reviewer is reassigned. No new formalD/V/human/learner/whole-course acceptance is claimed.",
        "evidenceLevel": "E1",
        "maximumClaimScope": "G1",
        "reviewRunIds": [],
        "dissent": [],
        "profile": {
          "archetype": "concept",
          "expectations": [
            {
              "id": "phosphate-gk-c1-r1",
              "essentialUnderstandingDe": "Geschlossener Phosphatpuffer: Teilchen und Verschiebung",
              "essentialUnderstandingEn": "Closed phosphate buffer: particles and equilibrium shifts",
              "observablePerformanceDe": "Partner, Gleichgewicht und beide Abfangreaktionen sind richtig und erklärt.",
              "observablePerformanceEn": "Correctly explain partners, equilibrium and both buffering reactions."
            },
            {
              "id": "phosphate-gk-c1-r2",
              "essentialUnderstandingDe": "Geschlossener Phosphatpuffer: Teilchen und Verschiebung",
              "essentialUnderstandingEn": "Closed phosphate buffer: particles and equilibrium shifts",
              "observablePerformanceDe": "Le Chatelier und Teilchenschema zeigen die korrekten Änderungen; kleiner pH-Effekt wird von unverändertem pH unterschieden.",
              "observablePerformanceEn": "Le Chatelier and particle schemes show the correct changes, distinguishing a small pH change from no change."
            },
            {
              "id": "phosphate-gk-c1-r3",
              "essentialUnderstandingDe": "Geschlossener Phosphatpuffer: Teilchen und Verschiebung",
              "essentialUnderstandingEn": "Closed phosphate buffer: particles and equilibrium shifts",
              "observablePerformanceDe": "Endliche Vorräte, Geschlossenheit und eine konkret begrenzte biologische Bedeutung werden getrennt beurteilt.",
              "observablePerformanceEn": "Distinguish finite reserves, closed conditions and one bounded biological role."
            }
          ],
          "coverageExpectations": {
            "requiredExpectationIds": [
              "phosphate-gk-c1-r1",
              "phosphate-gk-c1-r2",
              "phosphate-gk-c1-r3"
            ],
            "alternativeExpectationGroups": [],
            "minimumIndependentDemonstrations": 2,
            "freshVariationRequired": true,
            "independentTransferRequired": true
          },
          "variationAxes": [
            {
              "id": "acid-versus-base",
              "textDe": "Säurezugabe durch Basenzugabe an getrennten geschlossenen Phosphatportionen ersetzen.",
              "textEn": "Replace acid addition with base addition in separate closed phosphate portions."
            },
            {
              "id": "reserve-boundary",
              "textDe": "Begrenzte Last mit Erschöpfung und dem Missverständnis eines unveränderlichen pH vergleichen.",
              "textEn": "Compare limited loading with depletion and the misconception of invariant pH."
            }
          ],
          "applicationCaseBriefs": [
            {
              "id": "phosphate-acid",
              "taskDemandDe": "Erkläre für H2PO4−/HPO4²− im geschlossenen Modell die begrenzte Säurezugabe mit Gleichgewicht, Abfangreaktion und Teilchenschema.",
              "taskDemandEn": "Explain a limited acid addition to a closed H2PO4−/HPO4²− buffer using equilibrium, reaction and particle scheme.",
              "expectedPerformanceDe": "HPO4²−+H3O+→H2PO4−+H2O; das Gleichgewicht verschiebt zum protonierten Partner. Die Phosphatbilanz bleibt erhalten, der pH fällt begrenzt und bleibt nicht exakt gleich.",
              "expectedPerformanceEn": "HPO4²−+H3O+→H2PO4−+H2O; equilibrium shifts towards the protonated partner. Phosphate balance is conserved and pH falls modestly rather than remaining exactly fixed.",
              "understandingFocusDe": "Le Chatelier an konkreten Partneränderungen statt bloßem Schlagwort.",
              "understandingFocusEn": "Apply Le Chatelier through concrete partner changes rather than a slogan."
            },
            {
              "id": "phosphate-base-and-limits",
              "taskDemandDe": "Übertrage auf begrenzte OH−-Zugabe; widerlege unendliche Pufferreserve und grenze die Enzym-/Biologieanalogie ein.",
              "taskDemandEn": "Transfer to limited OH− addition, reject infinite reserve and bound the enzyme/biology analogy.",
              "expectedPerformanceDe": "H2PO4−+OH−→HPO4²−+H2O. Der pH steigt weniger als im ungepufferten Modell; endliche Partnerbestände begrenzen die Wirkung. Geschlossenheit bedeutet fehlenden weiteren Austausch, nicht unbegrenzte Stabilität oder ein Modell des gesamten Bluts.",
              "expectedPerformanceEn": "H2PO4−+OH−→HPO4²−+H2O. pH rises less than in the unbuffered model; finite partner amounts limit action. Closed means no further exchange, not unlimited stability or a model of the whole blood system.",
              "understandingFocusDe": "Geänderte Belastungsrichtung und ehrliche Systemgrenzen ohne HH-Rechenpflicht.",
              "understandingFocusEn": "Changed loading direction and explicit system limits without compulsory HH calculation."
            }
          ]
        }
      },

  "profile": {
    "archetype": "concept",
    "expectations": [
      {
        "id": "whole-duty-1",
        "essentialUnderstandingDe": "Eine größere Konzentration reagierender Teilchen erhöht im betrachteten Stoßmodell typischerweise die Begegnungshäufigkeit. Daraus folgt ohne Kenntnis des Mechanismus kein universelles quantitatives Geschwindigkeitsgesetz.",
        "essentialUnderstandingEn": "A higher concentration of reacting particles typically increases encounter frequency in the collision model considered. Without the mechanism, this does not establish a universal quantitative rate law.",
        "observablePerformanceDe": "Konzentration mit Begegnungshäufigkeit erklären. Weitere mögliche Aufgabenvariation: Zerteilungsfehler richtig auf Oberfläche beziehen.",
        "observablePerformanceEn": "Explain concentration through encounter frequency. Further possible task variation: Correct division error using surface."
      },
      {
        "id": "whole-duty-2",
        "essentialUnderstandingDe": "Bei gleicher Masse derselben Substanz bleibt die Stoffmenge durch Zerteilung gleich. Feinere Verteilung vergrößert die zugängliche Oberfläche für heterogene Kontakte.",
        "essentialUnderstandingEn": "At equal mass of the same substance, dividing it does not change its amount. Finer division increases accessible surface for heterogeneous contacts.",
        "observablePerformanceDe": "Zerteilung mit Oberfläche statt Gesamtmenge erklären. Weitere mögliche Aufgabenvariation: Konzentrationswirkung qualitativ statt universal quantitativ beschreiben.",
        "observablePerformanceEn": "Explain division through surface rather than total amount. Further possible task variation: Describe concentration qualitatively rather than universally quantitatively."
      },
      {
        "id": "whole-duty-3",
        "essentialUnderstandingDe": "Höhere Temperatur verändert die Bewegungs- und Energieverteilung und erhöht im gegebenen Modell besonders den Anteil ausreichend energiereicher Stöße. Die Aussage setzt unveränderte relevante Stoff- und Katalysatorstruktur voraus.",
        "essentialUnderstandingEn": "Higher temperature changes motion and energy distribution and, in the supplied model, particularly increases the fraction of sufficiently energetic collisions. The claim assumes unchanged relevant substance and catalyst structure.",
        "observablePerformanceDe": "Temperatur mit Anteil wirksamer Stöße verknüpfen. Weitere mögliche Aufgabenvariation: Temperatur/Energieverteilung und wirksame Stöße erklären.",
        "observablePerformanceEn": "Connect temperature with fraction of effective collisions. Further possible task variation: Explain temperature/energy distribution and effective collisions."
      },
      {
        "id": "whole-duty-4",
        "essentialUnderstandingDe": "Stoffart und Bindungsumbau beeinflussen die Aktivierungsbarriere; eine passende Orientierung ist eine zusätzliche Bedingung für erfolgreiche Stöße. Gleiche Gesamtzahl von Begegnungen bedeutet daher nicht gleiche Reaktionsgeschwindigkeit.",
        "essentialUnderstandingEn": "Substance type and bond rearrangement affect the activation barrier; suitable orientation is an additional condition for successful collisions. Equal total encounters therefore do not imply equal reaction rates.",
        "observablePerformanceDe": "Stoffart,Orientierung/Barriere und Modellgrenzen nennen. Weitere mögliche Aufgabenvariation: Stoffart/Bindungsbarrieren und Orientierung einbeziehen.",
        "observablePerformanceEn": "State species,orientation/barrier and model limits. Further possible task variation: Include species/bond barriers and orientation."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "whole-duty-1",
        "whole-duty-2",
        "whole-duty-3",
        "whole-duty-4"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "whole-case-material",
        "textDe": "Vier Faktoren mit kontrollierten Modellvergleichen / Fehlerhafte Ratebegründungen korrigieren",
        "textEn": "Four factors with controlled model comparisons / Correct faulty rate explanations"
      },
      {
        "id": "independent-transfer",
        "textDe": "Frisch: ein Enzym wird stark erhitzt und verliert Struktur. Muss die Rate steigen? / Frisch: Rate steigt nach Zugabe einer dritten Substanz,aber Konzentration der Edukte bleibt gleich. Beweist das die Konzentrationserklärung?",
        "textEn": "Fresh:an enzyme is strongly heated and loses its structure. Must rate increase? / Fresh:rate rises after addition of a third substance,but reactant concentrations stay equal. Does this prove the concentration explanation?"
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "q3-19-a",
        "taskDemandDe": "Vier hypothetische Vergleiche bei sonst gleichen Bedingungen: mehr reagierende Teilchen pro Volumen; gleiche Feststoffmasse feiner verteilt; höhere Temperatur ohne Phasenwechsel/Denaturierung; zwei Stoffarten mit unterschiedlich stabilen Bindungen und gleichem Kollisionsangebot. Keine Versuchsausführung. Erkläre für Konzentration,Zerteilungsgrad,Temperatur und Stoffart qualitative Geschwindigkeitsänderungen auf Teilchenebene mit Stoßtheorie. Begrenze universelle Aussagen. Separater Transfer: Frisch: ein Enzym wird stark erhitzt und verliert Struktur. Muss die Rate steigen?",
        "expectedPerformanceDe": "Mehr Konzentration erhöht typischerweise Begegnungen je Zeit. Feinere Feststoffe bieten mehr zugängliche Oberfläche für heterogene Kontakte,nicht mehr Gesamtstoffmenge. HöhereT erhöht mittlere Bewegung und vor allem Anteil ausreichend energiereicher Stöße. Stoffart beeinflusst Bindungsumbau,Aktivierungsbarriere und geeignete Orientierung; gleiche Anzahl Stöße bedeutet nicht gleiche erfolgreiche Zahl. Die Erklärung gilt bei den Kontrollen,nicht als universelles Konzentrationsgesetz oder unbegrenzte Temperaturregel. Transferantwort: Nein; Denaturierung verändert den wirksamen Katalysator. Die zuvor angenommene unveränderte Stoff-/Katalysatorstruktur gilt nicht. Scoring /10: 2P: Konzentration mit Begegnungshäufigkeit erklären.; 2P: Zerteilung mit Oberfläche statt Gesamtmenge erklären.; 2P: Temperatur mit Anteil wirksamer Stöße verknüpfen.; 2P: Stoffart,Orientierung/Barriere und Modellgrenzen nennen.; 2P: Nein; Denaturierung verändert den wirksamen Katalysator. Die zuvor angenommene unveränderte Stoff-/Katalysatorstruktur gilt nicht.",
        "understandingFocusDe": "Nachweis des ganzen aktuellen Ziels durch ausreichend gezeigte zusammenhängende Fachleistung; keine Zusatzaufgabenquote. Vorhandene Fälle sind Alternativen und gezielte Ergänzungen. Synthetische Autorenmaterialien belegen keine tatsächliche Experimentdurchführung oder Lernendenleistung. Quellenanteile bleiben einzeln begrenzt.",
        "taskDemandEn": "Four hypothetical comparisons with other conditions fixed:more reacting particles per volume;same solid mass more finely divided;higher temperature without phase change/denaturation;two species with differently stable bonds and equal collision supply. No experiment execution. Explain qualitative rate changes for concentration,division,temperature and species at particle level using collision theory. Bound universal statements. Separate transfer: Fresh:an enzyme is strongly heated and loses its structure. Must rate increase?",
        "expectedPerformanceEn": "Higher concentration typically increases encounters per time. Finer solids provide more accessible surface for heterogeneous contacts,not more total amount. HigherT increases mean motion and particularly fraction of sufficiently energetic collisions. Species affects bond rearrangement,activation barrier and suitable orientation;equal collision counts do not mean equal successful counts. Explanation applies under controls,not as a universal concentration law or unlimited temperature rule. Transfer response: No;denaturation changes the effective catalyst. The previous assumption of unchanged species/catalyst structure no longer holds. Scoring /10: 2P: Explain concentration through encounter frequency.; 2P: Explain division through surface rather than total amount.; 2P: Connect temperature with fraction of effective collisions.; 2P: State species,orientation/barrier and model limits.; 2P: No;denaturation changes the effective catalyst. The previous assumption of unchanged species/catalyst structure no longer holds.",
        "understandingFocusEn": "Evidence for the whole current goal through sufficiently demonstrated connected scientific performance; no extra-task quota. Available cases are alternatives and targeted additions. Synthetic author material proves no actual experiment execution or learner performance. Source contributions remain individually bounded."
      },
      {
        "id": "q3-19-b",
        "taskDemandDe": "Synthetische Aussagen: „Pulver reagiert schneller,weil es mehr Mol enthält“ bei gleicher Masse; „doppelte Konzentration verdoppelt jede Rate“; „jede Kollision ist erfolgreich“; „wärmer bedeutet nur mehr Stöße,keine andere Energieverteilung“. Vergleiche zwei Stoffarten mit verschiedenen Bindungen. Korrigiere alle Aussagen mit Stoßtheorie und erkläre zusätzlich die Stoffartabhängigkeit. Gib für jeden der vier Faktoren eine kontrollierte qualitative Begründung. Separater Transfer: Frisch: Rate steigt nach Zugabe einer dritten Substanz,aber Konzentration der Edukte bleibt gleich. Beweist das die Konzentrationserklärung?",
        "expectedPerformanceDe": "Bei gleicher Masse derselben Substanz bleibt n gleich; Pulver vergrößert Kontaktfläche. Konzentration erhöht mögliche Begegnungen,jedoch hängt exakte Rate vom Mechanismus/Rategesetz ab. Erfolgreiche Stöße benötigen passende Orientierung und genügend Energie; andere Stoffarten besitzen andere Bindungen/Barrieren. Erwärmung verschiebt die Energieverteilung und erhöht den Anteil über der Barriere. Veränderungen sind bei sonst konstanten Bedingungen zu beurteilen. Transferantwort: Nein; mögliche Katalyse/Mechanismusänderung muss geprüft werden. Ein Konzentrationseffekt ohne Konzentrationsänderung ist nicht belegt. Scoring /10: 2P: Zerteilungsfehler richtig auf Oberfläche beziehen.; 2P: Konzentrationswirkung qualitativ statt universal quantitativ beschreiben.; 2P: Temperatur/Energieverteilung und wirksame Stöße erklären.; 2P: Stoffart/Bindungsbarrieren und Orientierung einbeziehen.; 2P: Nein; mögliche Katalyse/Mechanismusänderung muss geprüft werden. Ein Konzentrationseffekt ohne Konzentrationsänderung ist nicht belegt.",
        "understandingFocusDe": "Nachweis des ganzen aktuellen Ziels durch ausreichend gezeigte zusammenhängende Fachleistung; keine Zusatzaufgabenquote. Vorhandene Fälle sind Alternativen und gezielte Ergänzungen. Synthetische Autorenmaterialien belegen keine tatsächliche Experimentdurchführung oder Lernendenleistung. Quellenanteile bleiben einzeln begrenzt.",
        "taskDemandEn": "Synthetic claims:“powder reacts faster because it contains more moles”at equal mass;“double concentration doubles every rate”;“every collision succeeds”;“warming only means more collisions,not changed energy distribution”.Compare two species with different bonds. Correct all claims using collision theory and additionally explain species dependence. Give a controlled qualitative reason for each of the four factors. Separate transfer: Fresh:rate rises after addition of a third substance,but reactant concentrations stay equal. Does this prove the concentration explanation?",
        "expectedPerformanceEn": "At equal mass of the same substance n stays equal;powder enlarges contact surface. Concentration increases possible encounters,but exact rate depends on mechanism/rate law. Successful collisions need suitable orientation and sufficient energy;different species have different bonds/barriers. Warming shifts energy distribution and raises fraction above the barrier. Assess changes with other conditions fixed. Transfer response: No;possible catalysis/mechanism change needs checking. Concentration effect without concentration change is not established. Scoring /10: 2P: Correct division error using surface.; 2P: Describe concentration qualitatively rather than universally quantitatively.; 2P: Explain temperature/energy distribution and effective collisions.; 2P: Include species/bond barriers and orientation.; 2P: No;possible catalysis/mechanism change needs checking. Concentration effect without concentration change is not established.",
        "understandingFocusEn": "Evidence for the whole current goal through sufficiently demonstrated connected scientific performance; no extra-task quota. Available cases are alternatives and targeted additions. Synthetic author material proves no actual experiment execution or learner performance. Source contributions remain individually bounded."
      }
    ]
  },

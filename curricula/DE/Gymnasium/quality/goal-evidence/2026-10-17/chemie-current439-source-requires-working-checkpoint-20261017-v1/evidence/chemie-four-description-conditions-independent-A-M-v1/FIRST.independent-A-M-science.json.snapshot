  "records": [
    {
      "goalId": "64a5bb87-358d-5a22-958a-f66ba5521cd5",
      "title": "Proteinquellen nachhaltig und quellenkritisch bewerten",
      "newDescriptionDe": "Die lernende Person kann tierische und pflanzliche Proteinquellen anhand selbst recherchierter Informationen unter ökologischen, ökonomischen und ethischen Gesichtspunkten vergleichen und die Informationen auf fachliche Richtigkeit, Vertrauenswürdigkeit und Intention prüfen.",
      "newDescriptionEn": "The learner can compare animal and plant protein sources using independently researched information from ecological, economic and ethical perspectives, and assess the information for scientific accuracy, trustworthiness and intent.",
      "atomicityStatus": "atomic",
      "semanticAtomic": true,
      "memoryStatus": "no_memory_needed",
      "memoryUseful": false,
      "newCardsRequired": false,
      "newMemoryGoalsRequired": false,
      "newVisibilityObligations": false,
      "currentProfileBodyChangedByAuthorCandidate": false,
      "currentProfileFingerprint": "sha256:d744cb32f4db5452ce370cf5cfc6d063d19b59615134d0a7a0d2b9db19f99a90",
      "input": {
        "path": "/mnt/e/skillpilot-chemie-L7-20261017/chemie-four-description-conditions-independent-A-M-v1/INPUT.64a5bb87-358d-5a22-958a-f66ba5521cd5.whole-goal-and-current-science.json",
        "sha256": "318672357a4b444d35b1a6619a2a0a12b6e1f16aeb4952fac25f79cf4fa7c0d6"
      },
      "atomicityRationale": "Die eine Leistung bleibt ein quellenkritisch begründeter Vergleich von Proteinquellen für einen erklärten Zweck. Eigene Informationsbeschaffung liefert die überprüfbare Datenbasis desselben Urteils; Quellenprüfung bestimmt deren Belastbarkeit, und ökologische, ökonomische sowie ethische Kriterien bestimmen das begründete Gewicht. Die Ergänzung „anhand selbst recherchierter Informationen“ macht die bereits in beiden vollständigen P-Fällen geforderte tatsächliche Recherche explizit. Sie ergänzt weder Ernährungsberatung noch eine selbständige allgemeine Informationskompetenzprüfung ohne Proteinvergleich. Die unveränderte Voraussetzung zum kriteriengeleiteten Abwägen trägt diese zusammenhängende Bewertung.",
      "memoryRationale": "Tatsächlich recherchierte Deklarationen, Preise, Umweltindikatoren und Quellenintention sind kontext- und zeitabhängige Daten; sie sollen erhoben, normalisiert und kritisch geprüft werden. Ein festes Fakten- oder Ranglisten-Deck wäre dafür kein Ersatz und könnte Datenlücken verschleiern. P fordert ausdrücklich Suchweg, Originalquellen, Gegenquelle, Funktionsgleichheit und ein gewogenes Urteil im neuen Verarbeitungskontext. Die beschreibende Ergänzung erzeugt keine zusätzliche Formel- oder Kriterien-Abrufpflicht. Daher bleibt no_memory_needed fachlich richtig; tatsächliche individuelle Recherche muss später durch eingereichte Arbeit belegt werden und wird hier nicht als durchgeführt behauptet.",
      "concreteCurrentPReference": [
        "Selbst beschaffte pflanzliche/tierische Produktdeklarationen plus unabhängige Quelle; Suchweg, Herkunft und Intention dokumentieren",
        "Neuer Verarbeitungs-/Nutzungskontext verlangt neue Quellenerhebung und erneute Prüfung aller drei Bewertungsdimensionen"
      ],
      "newCompactRecallItemRequired": false
    },
    {
      "goalId": "92c99237-1c74-54fc-bf08-9191656afaa6",
      "title": "Moleküldarstellungen situationsgerecht umwandeln",
      "newDescriptionDe": "Die lernende Person kann auf Grundlage ausreichender Strukturinformationen verschiedene Formeldarstellungen von Molekülen ineinander überführen und situationsgerecht eine geeignete Darstellung auswählen.",
      "newDescriptionEn": "The learner can convert different formula representations of molecules into one another using sufficient structural information and select an appropriate representation for the situation.",
      "atomicityStatus": "atomic",
      "semanticAtomic": true,
      "memoryStatus": "no_memory_needed",
      "memoryUseful": false,
      "newCardsRequired": false,
      "newMemoryGoalsRequired": false,
      "newVisibilityObligations": false,
      "currentProfileBodyChangedByAuthorCandidate": false,
      "currentProfileFingerprint": "sha256:201ed66ceb12bbf901db8490a85bde96d83034912f79b8fd7ca1039adb4b5bac",
      "input": {
        "path": "/mnt/e/skillpilot-chemie-L7-20261017/chemie-four-description-conditions-independent-A-M-v1/INPUT.92c99237-1c74-54fc-bf08-9191656afaa6.whole-goal-and-current-science.json",
        "sha256": "9c66ce88032a84c8742c7b053aea34127a9b248ff1d927b312e18941934e7071"
      },
      "atomicityRationale": "Überführen und situationsgerechtes Auswählen sind zwei Seiten derselben Darstellungsleistung: Welche bereits bekannte Strukturinformation lässt sich in welcher Repräsentation ausdrücken? Die neue Bedingung ausreichender Strukturinformationen verhindert die unzulässige eindeutige Rückübersetzung einer bloßen Summenformel, fügt aber kein zweites Stoffgebiet hinzu. P verwendet konkret Ethanol/Dimethylether bei gleicher Summenformel sowie ein gegebenes Ethenmodell. Atomzahlen, Verknüpfung und freie Paare sind Vergleichsaspekte einer Moleküldarstellung; es entstehen keine getrennten Nomenklatur-, Synthese- oder Isomerie-Berechnungsziele.",
      "memoryRationale": "Eine passende Struktur ist zu lesen und in eine andere Darstellung zu übertragen; ein Molekülnamen-/Formelkatalog muss weder neu gelernt noch ohne Vorlage abgerufen werden. Der Fall C2H6O zeigt durch Vergleich zweier gegebener Strukturen, weshalb Formelwissen allein gerade nicht reicht. Die neue Einschränkung bezeichnet vorhandene Information und deren Grenze, keinen neuen Abruffakt. Die Symbolsprache bleibt unveränderte Voraussetzung. Ein eigenes Deck für Beispielmoleküle oder eine Liste von Darstellungsnamen ist hier nicht notwendig; no_memory_needed bleibt nach erneuter Prüfung angemessen.",
      "concreteCurrentPReference": [
        "Gegebene Strukturen CH3–CH2–OH und CH3–O–CH3 mit gleicher Summenformel C2H6O vergleichen",
        "Aus vorgegebenem Ethen-Kugel-Stab-Modell C2H4 und H2C=CH2 gewinnen und die Darstellungswahl begründen"
      ],
      "newCompactRecallItemRequired": false
    },
    {
      "goalId": "a78aacf9-92ea-5627-8776-a595111f754c",
      "title": "Zusammensetzung moderner Waschmittel",
      "newDescriptionDe": "Die lernende Person kann Funktionen von Wasserenthärtern (Buildern), Bleichsystemen, Enzymen und Hilfsstoffen erklären.",
      "newDescriptionEn": "The learner can explain the functions of water softeners (builders), bleaching systems, enzymes and auxiliaries.",
      "atomicityStatus": "atomic",
      "semanticAtomic": true,
      "memoryStatus": "no_memory_needed",
      "memoryUseful": false,
      "newCardsRequired": false,
      "newMemoryGoalsRequired": false,
      "newVisibilityObligations": false,
      "currentProfileBodyChangedByAuthorCandidate": false,
      "currentProfileFingerprint": "sha256:96fc278aa9b694e17f8d605752eca443a0bc6ad2cf5127b545bf8c68221c6e9c",
      "input": {
        "path": "/mnt/e/skillpilot-chemie-L7-20261017/chemie-four-description-conditions-independent-A-M-v1/INPUT.a78aacf9-92ea-5627-8776-a595111f754c.whole-goal-and-current-science.json",
        "sha256": "45e743e5b1060d83c426c0734c3e19372137704d8a7835a72234b61a605290af"
      },
      "atomicityRationale": "Die unveränderte gemeinsame Leistung ist, die verschiedenen Funktionsgruppen innerhalb einer Waschmittelformulierung chemisch zu unterscheiden und ihre Eignung zu erklären. „Wasserenthärter (Builder)“ benennt dieselbe zuvor als Builder geführte Funktionsgruppe verständlicher; Bleichsystem, Enzym und Hilfsstoff werden nicht zu zusätzlichen Herstellungs- oder eigenständigen Prüfverfahren erweitert. P verknüpft Enthärtung, substratspezifische Hydrolyse, Oxidation und optische Wirkung in der Interpretation derselben Komponenten-/Kontrollfälle. Die funktionalen Vergleichskategorien sind für diese Formulierungsfrage zusammengehörig; eine Aufteilung würde den hier verlangten Funktionsvergleich zerlegen.",
      "memoryRationale": "Die Präzisierung Wasserenthärter/Builder ist keine neue Stoffliste und keine neue Forderung, Rezeptur, Handelsnamen, Konzentrationen oder Reaktionsgleichungen auswendig zu reproduzieren. In den vollständig gelesenen Fällen werden konkrete Inhalts-/Kontrollinformationen genutzt, um Härteionenbindung, passende Enzymwirkung, Bleichwirkung und Fluoreszenz zu unterscheiden. Ein memorierter Komponentenname reicht bei geändertem Fleck oder Material nicht. Die bestehende Tensidstruktur-Voraussetzung bleibt unverändert; kein neuer eigener Kartenbedarf folgt aus dem erklärenden deutschen Begriff. Die bisherige No-Memory-Entscheidung bleibt aus diesen fachlichen Gründen bestehen.",
      "concreteCurrentPReference": [
        "Builder reduziert freie Härteionen; Protease/Lipase passend zu Protein-/Fettfleck statt universeller Enzymwirkung",
        "Wolle/weiße Baumwolle bzw. empfindlicher Farbstoff ändern die funktional begründete Komponentenwahl; Aufhellen entfernt keine Schmutzmasse"
      ],
      "newCompactRecallItemRequired": false
    },
    {
      "goalId": "bbe038e9-86ed-5ec6-ab33-316758ddb16d",
      "title": "Elektronenpaarbindung mit Orbitalüberlappung erklären",
      "newDescriptionDe": "Die lernende Person kann den Zusammenhalt von Atomen in Molekülen im einfachen Elektronenpaarbindungsmodell durch Überlagerung einfach besetzter Orbitale erklären.",
      "newDescriptionEn": "The learner can explain the cohesion of atoms in molecules in the simple electron-pair bonding model through the overlap of singly occupied orbitals.",
      "atomicityStatus": "atomic",
      "semanticAtomic": true,
      "memoryStatus": "no_memory_needed",
      "memoryUseful": false,
      "newCardsRequired": false,
      "newMemoryGoalsRequired": false,
      "newVisibilityObligations": false,
      "currentProfileBodyChangedByAuthorCandidate": false,
      "currentProfileFingerprint": "sha256:6336e55426acff8ca8186ad8f3153e2e7348a5f96159ba32a6f7222f6e3e5286",
      "input": {
        "path": "/mnt/e/skillpilot-chemie-L7-20261017/chemie-four-description-conditions-independent-A-M-v1/INPUT.bbe038e9-86ed-5ec6-ab33-316758ddb16d.whole-goal-and-current-science.json",
        "sha256": "71a1166f4c4f8dfc8033038110c235bbc7800a7ffd4602ed1582b10f207b0ac5"
      },
      "atomicityRationale": "Ein einziger Erklärungsgegenstand bleibt der Zusammenhalt zweier Atome durch ein gemeinsames bindendes Elektronenpaar bei passender Orbitalüberlappung. Die neue ausdrückliche Beschränkung auf das einfache Elektronenpaarbindungsmodell ist eine Geltungsbedingung derselben Erklärung, keine zweite Routine. Die vollständig gelesenen P-Fälle H–H und H–Cl variieren dieselbe Paarbildung und den günstigen Kernabstand; bindende und nichtbindende Paare sowie Abstoßung begrenzen dieselbe Modellbehauptung. Die unveränderte Kern-Hülle-Voraussetzung und contains:[] begründen keinen zusätzlichen eigenständigen Zielteil. Eine universelle Vollständigkeit für koordinative Bindung oder MO-Theorie wird gerade nicht verlangt.",
      "memoryRationale": "Die Ergänzung verlangt keine neue auswendig abzurufende Konfiguration, Formel, Bindungsenergie oder Liste. Die Leistung besteht darin, am jeweils bereitgestellten Orbital-/Energiemodell Paarbildung, Anziehung, Abstoßung und Modellgrenze zusammenhängend zu erklären. Eine Karte mit einem Satz zur Überlappung würde dieses Verständnis weder nachweisen noch die Modellgrenze ersetzen. Grundbegriffe der Elektronen-/Atomdarstellung bleiben Teil der bestehenden Voraussetzungen. Deshalb ist eine eigene SRS-Karte für dieses Ziel nicht notwendig; die frühere No-Memory-Entscheidung bleibt nach eigener Prüfung fachlich passend.",
      "concreteCurrentPReference": [
        "H2 aus zwei vorgegebenen 1s¹-Atomen, Energieminimum und Widerlegung monoton zunehmender Stabilität",
        "H–Cl aus ausdrücklich räumlich möglichen einfach besetzten Orbitalen, übrige Cl-Paare nichtbindend"
      ],
      "newCompactRecallItemRequired": false
    }
  ],

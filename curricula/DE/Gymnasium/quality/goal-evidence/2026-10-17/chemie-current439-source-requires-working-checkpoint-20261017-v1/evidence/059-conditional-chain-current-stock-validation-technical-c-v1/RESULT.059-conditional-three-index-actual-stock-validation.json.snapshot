          "reviewCriteriaFingerprint": "sha256:4ed61d2a8c7eb84dd13315427d46989b4750f58620481e19023b145935025835",
          "landscapeId": "c436b994-8f44-5134-b9f8-0c9f5d6a5ba0",
          "goalId": "059acb11-29b3-5645-ac4c-b4214dc41a2d",
          "goalFingerprint": "sha256:58836619dbd564293bfe8a2e8a9ed2dae150faa0a8742c59542f5b650d685941",
          "reviewInputFingerprint": "sha256:a30c747975b45f5c4c520694f48a837a7471b14161b9a2606266ac6fde14419d",
          "profileFingerprint": "sha256:1dc6f6df8d781543a4b0059fb6735f0818202274991ce202a87aa4b38d7e75e8",
          "status": "needs_human_review",
          "reviewAuthority": "ai_candidate",
          "reviewedAt": "2026-10-16T11:55:14.893521+00:00",
          "reviewer": "/root/chemie_native15_fresh_independent_b_20261016; independent AI compatibility reviewer of these five Root-authored description successors",
          "reason": "Alle vier vorhandenen Erwartungen bleiben vollständig: Stoffmengenhalbierung, Gleichgewichtsverhältnis, Basen-pOH-Konversion und Domänengrenze. Die beiden ganzen DE/EN-Material-/Auftrags-/Lösungs-/Rubrikfälle sind unabhängig vom Bild tragfähig. HCl-Gegenbeispiel bleibt echter Domänentransfer; keine Übertragung von pH=pKa auf starke Säure oder pH=pKb auf Base. Independently frozen scientific compatibility: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-native17-five-description-successors-fresh-independent-B-compatibility-20261016-v1/FIRST.five-current-descriptions-independent-compatibility.science.frozen.json sha256:aee4e1f0e57719ca92e5cff86325e46a4337d76c1b516d7f5b41664404d4f3ac; existing whole profile and case design retained. No new learner work, experiment, source/course or D approval.",
          "evidenceLevel": "E0",
          "maximumClaimScope": "G0",
          "reviewRunIds": [],
          "dissent": [
            "Limited resource-binding successor only; all whole profile fields, case briefs, expectations and levels inside the immutable original record remain preserved.",
            "Prospective E0/G0 technical record, needs_human_review and ai_candidate; no new full scientific vote, V vote, actual learner/experiment performance or human attestation.",
            "This record binds the retained whole P design to one independently examined description successor. Historical experiment/generation levels, if any, are preserved in the before-row CAS; this new binding claims E0/G0 and no observed learner performance."
          ],
          "profile": {
            "archetype": "data",
            "expectations": [
              {
                "id": "stoichiometric-half-point",
                "essentialUnderstandingDe": "Der Halbpunkt liegt bei der Hälfte des stöchiometrischen Äquivalenzvolumens; dort sind die formalen Mengen des schwachen Partners und seines Konjugierten gleich.",
                "essentialUnderstandingEn": "The half point is half the stoichiometric equivalence volume; there, formal amounts of the weak species and its conjugate are equal.",
                "observablePerformanceDe": "Die lernende Person bilanziert 2.000 mmol HA bzw. 1.000 mmol B und begründet die Halbvolumina 10.00 bzw. 5.00 mL anhand der umgesetzten Stoffmengen.",
                "observablePerformanceEn": "The learner balances 2.000 mmol HA or 1.000 mmol B and justifies half volumes of 10.00 or 5.00 mL using amounts reacted."
              },
              {
                "id": "equal-ratio-equilibrium",
                "essentialUnderstandingDe": "Das gemeinsame Volumen macht aus gleichen Puffermengen ein Konzentrationsverhältnis eins; daraus folgt die passende pH/pKS- oder pOH/pKB-Beziehung.",
                "essentialUnderstandingEn": "Shared volume turns equal buffer amounts into a concentration ratio of one, yielding the appropriate pH/pKa or pOH/pKb relation.",
                "observablePerformanceDe": "Sie leitet für HA/A− pH≈pKS aus dem MWG ab und erklärt mit 0.500/1.500 mmol, weshalb das Viertelvolumen pH≈4.323 statt pKS liefert.",
                "observablePerformanceEn": "The learner derives pH≈pKa for HA/A− from mass action and uses 0.500/1.500 mmol to explain why the quarter volume gives pH≈4.323 rather than pKa."
              },
              {
                "id": "base-half-point-conversion",
                "essentialUnderstandingDe": "Bei einer schwachen Base liefert der Halbpunkt pOH≈pKB; pH und pKB sind nicht dieselbe Größe.",
                "essentialUnderstandingEn": "For a weak base, the half point gives pOH≈pKb; pH and pKb are different quantities.",
                "observablePerformanceDe": "Sie nutzt pH 9.20 und pKw 14.00 zu pKB(B)=4.80 und pKS(BH+)=9.20 und begründet beide Werte über Kb und die konjugierte Säure.",
                "observablePerformanceEn": "The learner uses pH 9.20 and pKw 14.00 to obtain pKb(B)=4.80 and pKa(BH+)=9.20, justifying both through Kb and the conjugate acid."
              },
              {
                "id": "half-point-domain",
                "essentialUnderstandingDe": "Das Pufferargument gilt für ein geeignetes schwaches konjugiertes Paar; weder Äquivalenz noch der Mittelwert von pH-Daten noch halbe Neutralisation starker HCl ersetzt diese Bedingung.",
                "essentialUnderstandingEn": "The buffer argument requires a suitable weak conjugate pair; equivalence, an average of pH data or half-neutralizing strong HCl does not replace that condition.",

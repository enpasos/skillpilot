          "bindingMatchesArchivedResolution": true,
          "actualSource": {
            "binding": {
              "campaignId": "chemie-current435-final-five-descriptions-20261016-v1-b",
              "campaignDigest": "sha256:2008bf641f7138bd1f43d7f0947da5481e7be3f8d752226cca91d69a86d08824",
              "roundId": "chemie-current435-final-five-descriptions-20261016-v1-first-pass-b",
              "independenceGroupId": "chemie-current435-final-five-descriptions-20261016-v1-independent-b",
              "reviewInputFingerprint": "sha256:9d340acfaaf8256087917c05454610ce512de5fa2195882adf48a7c17995b2fd",
              "goalReviewContextFingerprint": "sha256:d959474204bc0e961be12051ff2e0a98da6f429fb0924178c7895cf0660dc8bf",
              "batchId": "chemie-current435-final-five-descriptions-20261016-v1-first-pass-b.batch-001",
              "runId": "chemie-native5-contentonly-fresh-independent-b2-20261016-v1",
              "runManifestDigest": "sha256:2e42faa8177da700fa2beb3b3423354d64d080c5df6d8868b51f41f0ae248a20",
              "resultsDigest": "sha256:45ed1a75818ea507f027007a2dde3f60cd8184b04f702f86be0fcd16ec47cb6f",
              "recordId": "chemie-native5-contentonly-fresh-independent-b2-20261016-v1.059acb11-29b3-5645-ac4c-b4214dc41a2d",
              "recordDigest": "sha256:a4ea22765ad1011c9c8606540aaf391b69fa76bbbbcdda660dfe1efe79a02651"
            },
            "decision": "keep",
            "record": {
              "$schema": "https://skillpilot.com/schemas/goal-description-review/v1/goal-description-review-record.schema.json",
              "schemaVersion": 1,
              "recordId": "chemie-native5-contentonly-fresh-independent-b2-20261016-v1.059acb11-29b3-5645-ac4c-b4214dc41a2d",
              "runId": "chemie-native5-contentonly-fresh-independent-b2-20261016-v1",
              "campaignId": "chemie-current435-final-five-descriptions-20261016-v1-b",
              "roundId": "chemie-current435-final-five-descriptions-20261016-v1-first-pass-b",
              "bundleFingerprint": "sha256:a9361b151e8ae4dcf1d6a381ed80aa0871725f47f9962a5e595bbd5b8d492c8b",
              "bookDigest": "sha256:227e215e61394c6bcf88b6746ff542c2164ac01e82a278c9ad818497a85089ed",
              "goalId": "059acb11-29b3-5645-ac4c-b4214dc41a2d",
              "goalFingerprint": "sha256:58836619dbd564293bfe8a2e8a9ed2dae150faa0a8742c59542f5b650d685941",
              "pageFingerprint": "sha256:10864bef5342903286e9f4d0fdb36f113fa426787ca01fcbc5e42665f8fc87be",
              "currentTitleDe": "Halbtitration zur pK-Bestimmung nutzen",
              "currentTitleEn": "Use half-titration to determine pK values",
              "currentDescriptionDe": "Die lernende Person kann das Prinzip der Halbtitration für geeignete schwache Säuren oder Basen anhand des konjugierten Säure-Base-Paares erläutern und deren pKS- beziehungsweise pKB-Werte aus pH- beziehungsweise pOH-Daten am Halbäquivalenzpunkt bestimmen.",
              "currentDescriptionEn": "The learner can explain half-titration for suitable weak acids or bases using the conjugate acid–base pair and determine their pKa or pKb values from pH or pOH data, respectively, at the half-equivalence point.",
              "decision": "keep",
              "understandingEvidence": {
                "essentialUnderstandingDe": "Bei halbem stöchiometrischem Äquivalenzvolumen liegen für ein geeignetes schwaches konjugiertes Paar näherungsweise gleiche Mengen beider Partner vor. Ihr Konzentrationsverhältnis eins liefert aus dem Protolysegleichgewicht pH≈pKS für die schwache Säure beziehungsweise pOH≈pKB für die schwache Base; ein pH-Mittelwert oder der Äquivalenzpunkt ersetzt diese Bedingung nicht.",
                "essentialUnderstandingEn": "At half the stoichiometric equivalence volume, an appropriate weak conjugate pair has approximately equal amounts of both species. Their concentration ratio of one gives pH≈pKa for the weak acid or pOH≈pKb for the weak base from the protolysis equilibrium; an average pH or the equivalence point does not replace that condition.",
                "observablePerformanceDe": "Die lernende Person bestimmt den Halbpunkt aus den Stoffmengen, leitet die passende Halbpunktbeziehung aus dem Gleichgewicht her und ermittelt pKS oder pKB aus den Daten. Sie unterscheidet Halb-, Viertel- und Äquivalenzpunkt und begründet bei der Base die Umrechnung von pH zu pOH unter dem gegebenen pKw.",
                "observablePerformanceEn": "The learner locates the half point from amount balances, derives the appropriate half-point relation from equilibrium and determines pKa or pKb from the data. They distinguish half, quarter and equivalence points and justify converting pH to pOH for the base using the supplied pKw.",
                "transferExpectationDe": "Beim unabhängigen Wechsel von einer schwachen Säure zu einer schwachen Base wählt die lernende Person die richtige Messgröße und leitet die Auswertung neu her. Beim Gegenfall einer halbneutralisierten starken Säure erklärt sie, warum das geeignete schwache Pufferpaar fehlt und die Ableseregel nicht gilt.",
                "transferExpectationEn": "On independently changing from a weak acid to a weak base, the learner chooses the correct measured quantity and rederives the interpretation. For half-neutralised strong acid, they explain why the required weak buffer pair is absent and the shortcut is invalid."
              },
              "rationale": "Die Beschreibung begrenzt die Halbtitration auf geeignete schwache Säuren/Basen und knüpft die pK-Bestimmung an das konjugierte Paar am Halbäquivalenzpunkt. „pH beziehungsweise pOH“ und „pKS beziehungsweise pKB“ sind richtig zugeordnet und in EN ausdrücklich durch respectively verbunden. Säure- und Basenvariante sind Anwendungen desselben Gleichgewichtsprinzips. Both complete bilingual cases include amounts, data, solutions and four rubric criteria. The acid case requires equilibrium justification and rejection of quarter-volume or arithmetic midpoint substitution; the base/strong-acid case changes the chemical condition. Model ideal-buffer data are identified as model data. The profile does not assert real measurements or learner results. Actual physical PDF page 6 was viewed. The illustrative weak-acid curve distinguishes Veq/2 from Veq and labels the equal-concentration condition and pH=pKS. The description properly extends to the base variant using pOH; the acid image is a teaching example rather than a universal curve. Machine candidate only; no observed learner performance, human approval or complete external source/projection verification claimed. Scientific judgment frozen before stock metadata access.",
              "evidenceProfileContract": "positive-understanding-evidence-v2",
              "evidenceProfileRecommendation": "none",
              "recordStatus": "candidate",
              "reviewAuthority": "ai_candidate"
            }
          }
        }
      ],

        "evidenceProfile": {
          "$schema": "https://skillpilot.com/schemas/goal-evidence/v2/goal-evidence-profile.schema.json",
          "schemaVersion": 2,
          "reviewId": "chemie-five-description-compatibility-independent-b-20261016-v1",

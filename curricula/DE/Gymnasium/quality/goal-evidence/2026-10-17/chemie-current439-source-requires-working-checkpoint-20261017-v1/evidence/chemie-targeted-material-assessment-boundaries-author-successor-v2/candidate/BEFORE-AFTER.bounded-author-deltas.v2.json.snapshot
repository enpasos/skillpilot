      "fields": {
        "taskDemandDe": {
          "before": "Deute T05-C1/C2 an den vollständig gelieferten Tabellen. Ordne Stärke und Spezies zu, unterscheide Halbpunkt, Äquivalenz und Neutralität und begründe geeignete Indikatorkandidaten.",
          "after": "Deute ausschließlich die beigefügten Auswertungsfassungen v2 T05-C1/C2 mit vollständig vorgegebenen Tabellen. Ordne Stärke und Spezies zu, unterscheide Halbpunkt, Äquivalenz und Neutralität und begründe Indikatorkandidaten. Benötigte pH-/pK-Werte und der Temperaturvergleich sind gegeben; keine pH-Rechnung und keine Rechenrubrik der separat erhaltenen Originalfälle werden übernommen."
        },
        "taskDemandEn": {
          "before": "Interpret the complete T05-C1/C2 tables. Classify strength/species, distinguish halfpoint, equivalence and neutrality, and justify indicator candidates.",
          "after": "Use only the attached interpretation-only v2 projections T05-C1/C2 with fully supplied tables. Classify strength/species, distinguish halfpoint, equivalence and neutrality, and justify indicator candidates. Required pH/pK values and the temperature comparison are given; inherit no pH calculation or calculation rubric from the separately retained originals."
        }
      }
    },
    {

      "resourceLinks": [
        {
          "type": "goal-visualization",
          "resourceType": "image",
          "role": "primary",
          "skillpilotId": "b95cdf98-fc97-5a94-b133-878922d28156",
          "title": "Visualisierung: Erdölprodukte in Alltag, Technik und Umwelt bewerten",
          "url": "/assets/goal-visualizations/chemie/b95cdf98-fc97-5a94-b133-878922d28156/b95cdf98-fc97-5a94-b133-878922d28156.jpg",
          "provider": "Google Gemini / Nano Banana Pro",
          "description": "Visualisierung zum Lernziel: Erdölprodukte in Alltag, Technik und Umwelt bewerten.",
          "altText": "Übersicht: Erdöl wird in einer Raffinerie und weiteren Verarbeitungsschritten für Kraftstoffe, Kunststoffe, Heizöl, pharmazeutische und kosmetische Grundstoffe, Schmierstoffe, Bitumen für Straßenasphalt, Grundchemikalien und synthetischen Reifenkautschuk genutzt. Darunter stehen Beispiele möglicher Folgen: CO2 aus Verbrennung, langlebiger Plastikmüll und Mikroplastik, Ölunfälle sowie Verbrauch endlicher Ressourcen. Die Waage steht für begründete Bewertung; das Bild enthält keine vollständige Ökobilanz.",
          "lang": "de",
          "license": "AI-generated, SkillPilot-curated",
          "reviewStatus": "pilot"
        }
      ],
      "extendedData": {
        "provenance": {

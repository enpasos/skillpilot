        "sourceRef": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-current435-course-terminal-route-and-practical-author-remediation-20261016-v1/author-practical-design/wholegoals/ac75b416-70d5-50f8-a913-475943d21a55.author-draft.json",
        "extendedData": {

        "extendedData": {
          "applicabilityMappingInheritance": "boundary",
          "provenance": {
            "authorCandidatePackage": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/chemie-b008-phase-local-inquiry-model-society-terminal-author-20261010-v1",
            "authorRole": "Original AUTHOR final machine-content candidate; inactive; no independent approval",

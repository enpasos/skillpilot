        "extendedData": {
          "provenance": {
            "sourceLandscapeId": "2f391ba2-ba1e-40e4-a8d2-dff049516c13",
            "sourceLandscapeTitle": "Chemie Oberstufe (Hessen, KC 2024)",
            "sourceGoalId": "e79ff97f-ca1a-4b09-b00c-f7d8a5ec7847",
            "splitFromCanonicalGoalId": "c21d430b-424d-5b13-adf6-999f2490d2dc",

  "currentExpectationMeanings": {
    "q1": {
      "id": "q1",
      "essentialUnderstandingDe": "Kurvenform und Richtung liefern begrenzte Modellinformationen.",
      "essentialUnderstandingEn": "Curve direction and shape supply bounded model information.",
      "observablePerformanceDe": "Die lernende Person beschreibt Verlauf und Stärkehinweise mit tatsächlichen Daten und vermeidet eindeutige Stoffidentifikation ohne weitere Befunde.",
      "observablePerformanceEn": "Describe shape and strength clues from actual data, avoiding unsupported unique substance identification."
    },
    "q2": {
      "id": "q2",
      "essentialUnderstandingDe": "Äquivalenz, Halbäquivalenz und Pufferbereich sind verschiedene Begriffe und nur im passenden System vorhanden.",
      "essentialUnderstandingEn": "Equivalence, half-equivalence and buffer regions differ and apply only in suitable systems.",
      "observablePerformanceDe": "Sie erkennt vorhandene Bereiche und erläutert die pH-bestimmenden Teilchen; ein Halbvolumen allein ist kein pK-Beweis.",
      "observablePerformanceEn": "Identify regions present and explain pH-controlling species; a half-volume alone does not prove pKa."
    },
    "q3": {
      "id": "q3",
      "essentialUnderstandingDe": "Indikatorendpunkt, chemische Äquivalenz und temperaturabhängige Neutralität sind zu unterscheiden.",
      "essentialUnderstandingEn": "Indicator endpoint, chemical equivalence and temperature-dependent neutrality differ.",
      "observablePerformanceDe": "Sie begründet anhand des gegebenen Kurvenverlaufs und der Intervalle die Indikatorwahl und Grenzen eines behaupteten Volumenfehlers.",
      "observablePerformanceEn": "Use the supplied curve and intervals to justify an indicator choice and limit volume-error claims."
    },
    "q4": {
      "id": "q4",
      "essentialUnderstandingDe": "Menge, Stärke und Stoffklasse erzeugen unterschiedliche Kurvenaussagen.",
      "essentialUnderstandingEn": "Amount, strength and substance class yield distinct curve conclusions.",
      "observablePerformanceDe": "Sie erklärt im vorgelegten Vergleich Gemeinsamkeiten und Unterschiede von Puffer-, Äquivalenz- und Überschussbereichen.",
      "observablePerformanceEn": "Explain similarities and differences in buffer, equivalence and excess regions for the supplied comparison."
    }
  },

      "reviewGroupId": "goal-e0d05c36-eaac-4c75-8ead-3fd5bdafefca-required-by-e675fa94-6e23-59c0-b376-4340bf44c00e",
      "originalZeroBasedGroupIndex": 63,
      "originalOneBasedGroupNumber": 64,
      "priorBExactPhysicalRecord": {
        "groupIndex": 63,
        "reviewGroupId": "goal-e0d05c36-eaac-4c75-8ead-3fd5bdafefca-required-by-e675fa94-6e23-59c0-b376-4340bf44c00e",
        "prerequisiteGoalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
        "directDependentGoalId": "e675fa94-6e23-59c0-b376-4340bf44c00e",
        "physicalNecessityDecision": "reject",
        "scientificNecessityRationaleDe": "Die Formelaufträge liefern konkrete Elementmassen und Gasdaten und verlangen deren atombezogene Auswertung. Die vollständige vorgelagerte vergleichende Oxid-/Sulfidkompetenz einschließlich Eduktüberschuss ist nicht nötig; eine stöchiometrische Teilidee ersetzt deren ganzen Umfang nicht.",

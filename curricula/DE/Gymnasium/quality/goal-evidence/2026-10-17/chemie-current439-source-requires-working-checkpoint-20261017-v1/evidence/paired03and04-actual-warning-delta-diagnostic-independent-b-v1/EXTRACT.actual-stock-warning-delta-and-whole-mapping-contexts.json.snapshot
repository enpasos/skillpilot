            "authorCandidatePackage": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-seven-source-atomicity-whole-author-successor-20261016-v1/split-three"
          },
          "applicabilityMappingInheritance": "boundary",
          "applicabilityOverrides": {

          "id": "alkene",
          "textDe": "Symmetrisches Ethen und unsymmetrisches Propen werden verglichen.",
          "textEn": "Symmetric ethene and asymmetric propene are compared."
        },
        {
          "id": "regio",
          "textDe": "Eindeutiges und bedingt regioselektives Produkt werden getrennt.",
          "textEn": "Unambiguous and conditionally regioselective products are separated."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "ethene-hbr-mechanism",
          "taskDemandDe": "Zeichne für Ethen und HBr unter ionischen Bedingungen den Angriff der π-Bindung auf H, den Bromid-Angriff und das gesättigte Produkt.",
          "taskDemandEn": "For ethene with HBr under ionic conditions, draw π-bond attack on H, bromide attack, and the saturated product.",
          "expectedPerformanceDe": "Die lernende Person erhält Bromethan und zeigt plausible Elektronenpfeile sowie den Verlust der C=C-Doppelbindung.",
          "expectedPerformanceEn": "The learner obtains bromoethane and shows plausible electron arrows and loss of the C=C double bond.",
          "understandingFocusDe": "Bindungsänderungen belegen die Addition.",
          "understandingFocusEn": "Bond changes demonstrate addition."
        },
        {
          "id": "fresh-propene-hbr",
          "taskDemandDe": "Eine neue Aufgabe gibt Propen und HBr ohne Peroxide unter ionischen Bedingungen vor. Skizziere die bevorzugte mögliche Zwischenstufe und begründe ein Hauptprodukt; nenne die Bedingungsgrenze.",
          "taskDemandEn": "A fresh task gives propene and HBr without peroxides under ionic conditions. Sketch the more plausible intermediate and justify a major product; state the condition limit.",
          "expectedPerformanceDe": "Die lernende Person begründet die sekundäre Carbokation-Zwischenstufe und 2-Brompropan als Hauptprodukt; sie behauptet keine bedingungsunabhängige Universalregel.",
          "expectedPerformanceEn": "The learner justifies the secondary carbocation intermediate and 2-bromopropane as a major product without making a condition-independent universal rule.",
          "understandingFocusDe": "Unsymmetrie prüft mechanistische Begründung.",
          "understandingFocusEn": "Asymmetry tests mechanistic reasoning."
        }
      ]

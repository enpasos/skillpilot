      "expectations": [
        {
          "id": "concentration-dispersion",
          "essentialUnderstandingDe": "Tensidkonzentration beeinflusst Grenzflächenbelegung, Micellenbildung und Dispergierung. Mehr Tensid oder mehr Schaum bedeutet nicht unbegrenzt bessere Reinigung.",
          "observablePerformanceDe": "Bereitgestellte Konzentrations-/Dispersionsdaten unter vorgegebenen Bedingungen erklären und sinnvolle Dosierungen begründen."
        },
        {
          "id": "hardness-temperature-factors",
          "essentialUnderstandingDe": "Calcium- und Magnesiumionen können mit Seifen schwer lösliche Kalkseifen bilden und verfügbare Seifenanionen vermindern. Temperatur beeinflusst Lösung, Beweglichkeit und die jeweils gegebenen Stoffeigenschaften; ihre Wirkung ist nicht universell monoton.",
          "observablePerformanceDe": "Härte und Temperatur von Konzentration als unabhängige Faktoren unterscheiden, Calciumseifenbildung bilanzieren und einen kontrollierten Vergleich deuten."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "concentration-dispersion",
          "hardness-temperature-factors"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "changed-chemical-case",
          "textDe": "Neue kontrollierte Kombinationen von Härte, Temperatur und Konzentration; Daten erklären und jeweils nur einen Faktor variieren."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "soap-hardness-concentration-series",
          "taskDemandDe": "Gegeben sind gleiche Ölverschmutzung und Temperatur. In weichem Wasser verbessert eine Seifenkonzentrationsreihe die Dispersion bis zu einem Plateau; bei Ca²⁺ treten Niederschlag und schwächere Dispersion auf. Erkläre Micellen/Dispergierung und formuliere die Calciumseifenreaktion.",
          "expectedPerformanceDe": "2 RCOO⁻ + Ca²⁺ → Ca(RCOO)₂(s) ist ladungs- und stoffbilanziert. Präzipitation vermindert verfügbare Seife. Die Konzentrationsdaten passen zu Grenzflächenbelegung/Micellen; ein Plateau und Schaum allein sind kein Beleg unbegrenzter Reinigung.",
          "understandingFocusDe": "Härte und Konzentration mechanistisch verbinden."
        },
        {
          "id": "controlled-temperature-replan",
          "taskDemandDe": "Eine neue Tabelle variiert bei gleichem Tensid, Wasser und Schmutz getrennt Temperatur und Dosis. Moderate Erwärmung verbessert im Modell die Dispersion, oberhalb einer vorgegebenen Stoffgrenze nimmt sie ab; zusätzliche Dosis hilft nur in einem Bereich. Erkläre die Daten und plane einen Vergleich, der Härte als Ursache prüft.",
          "expectedPerformanceDe": "Löslichkeit/Beweglichkeit und die vorgegebene Stoffgrenze erklären die Temperaturdaten; Konzentration wirkt über verfügbare Grenzflächen-/Micellenbildung. Für den Härtevergleich bleiben Temperatur, Dosis und Schmutz gleich, nur Ca/Mg-Gehalt ändert sich. Keine universelle Regel heißer=immer besser oder Schaum=Waschwirkung.",
          "understandingFocusDe": "Frischer Mehrfaktor-/Kontrolltransfer."
        }
      ]
    }

        },
        {
          "pairKey": "1dc15fa2-fca4-56b0-b5c1-4d215613dde0::DE-HH",
          "jurisdiction": "DE-HH",
          "decision": "approve",
          "scientificReasonDe": "Die gemeinsame Studienstufenspalte verlangt die Konzentrationsbestimmung und Auswertung von Säure-Base-Titrationen. Für die eigenen Äquivalenz- und Aliquotrechnungen des aktuellen Profils ist der Stoffmengenbegriff erforderlich; die zusätzliche LK-Kurvenberechnung wird nicht als GK-Beweis benutzt.",
          "selectedEndpointAnchorId": "anchor-158806f0a887c180feb0",
          "sourceRefExact": "Hamburg Bildungsplan Studienstufe Chemie 2022, 1.3, S. 26.",

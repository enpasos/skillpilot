      "jurisdictionJudgments": [
        {
          "pairKey": "1dc15fa2-fca4-56b0-b5c1-4d215613dde0::DE-NW",
          "jurisdiction": "DE-NW",
          "decision": "approve",
          "scientificReasonDe": "Beide Originalkursabschnitte verlangen die experimentelle Konzentrationsbestimmung durch Säure-Base-Titration samt Berechnungen. Das aktuelle Profil verlangt n=cV, stöchiometrischen Reaktionsfaktor und Aliquotkorrektur; dazu muss n als Teilchenzahlmaß und nicht als Masse oder Volumen verstanden werden. GK und LK werden mit eigenen Originalankern belegt.",
          "selectedEndpointAnchorId": "anchor-0bb33d51fd81444bf363",
          "sourceRefExact": "Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Leistungskurs, Säuren, Basen und analytische Verfahren, Bewertungskompetenz, S. 48.",
          "rawOriginalCourse": "LK",
          "fullPairRecord": "FIRST-JURISDICTION-PAIR-DECISIONS.frozen.json#1dc15fa2-fca4-56b0-b5c1-4d215613dde0::DE-NW"
        },
        {
          "pairKey": "1dc15fa2-fca4-56b0-b5c1-4d215613dde0::DE-SH",
          "jurisdiction": "DE-SH",
          "decision": "approve",
          "scientificReasonDe": "Die gemeinsame Originalspalte nennt die quantitative Konzentrationsbestimmung durch Titration. Gerade deren c-V-Reaktionsfaktor-Auswertung im aktuellen Profil benötigt die Stoffmenge als Teilchenzahlmaß. Der LK-Zusatz zu detaillierten Titrationskurven wird dafür nicht auf den GK übertragen.",
          "selectedEndpointAnchorId": "anchor-2c9a95078b96a361ee85",
          "sourceRefExact": "Schleswig-Holstein Fachanforderungen Chemie Sekundarstufe I/II 2022, 3.2 Chemie und Umwelt, S. 65.",

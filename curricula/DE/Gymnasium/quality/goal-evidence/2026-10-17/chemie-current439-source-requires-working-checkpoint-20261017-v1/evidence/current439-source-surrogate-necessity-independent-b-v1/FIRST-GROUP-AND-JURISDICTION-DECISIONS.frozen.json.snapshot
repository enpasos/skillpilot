        },
        {
          "pairKey": "1dc15fa2-fca4-56b0-b5c1-4d215613dde0::DE-MV",
          "jurisdiction": "DE-MV",
          "decision": "approve",
          "scientificReasonDe": "Die Originalseite verlangt Konzentrationsberechnungen und ein Schülerexperiment zur Säure-Base-Titration im gemeinsamen Teil. Die aktuellen Zahlenaufgaben rechnen Reaktionsstoffmengen aus c und V; n als Teilchenzahlmaß ist dafür unverzichtbar. Die gedruckte S.24 ist PDF-S.28.",
          "selectedEndpointAnchorId": "anchor-2c9f5243fb7a8a7140b3",
          "sourceRefExact": "Rahmenplan Chemie Qualifikationsphase gymnasiale Oberstufe Mecklenburg-Vorpommern 2022 Erprobungsfassung, Qualifikationsphase, Qualifikationsphase: Atombau und Redoxreaktionen, S. 27",

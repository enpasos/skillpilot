    {
      "groupIndex": 9,
      "reviewGroupId": "goal-17acbdec-5274-510f-8588-0eac164ebbe5-required-by-3fb7dea4-f832-5e23-b518-68b13a655b92",
      "prerequisiteGoalId": "17acbdec-5274-510f-8588-0eac164ebbe5",
      "directDependentGoalId": "3fb7dea4-f832-5e23-b518-68b13a655b92",
      "physicalNecessityDecision": "reject",
      "scientificNecessityRationaleDe": "Die abhängigen HBr-Additionen werden an Ethen/Propen unter ionischen Bedingungen erklärt. Der vollständige vorherige Alkan-/Alken-Halogenvergleich einschließlich radikalischer Substitution ist dafür nicht erforderlich; zudem benötigt Kunststoffklassifikation diesen Additionsmechanismus nicht.",
      "prerequisiteCaseIds": [
        "ethane-ethene-halogen",
        "fresh-propene-cyclohexane"
      ],
      "dependentCaseIds": [
        "ethene-hbr-mechanism",
        "fresh-propene-hbr"
      ],
      "jurisdictionJudgments": [
        {
          "pairKey": "17acbdec-5274-510f-8588-0eac164ebbe5::DE-NW",
          "jurisdiction": "DE-NW",
          "decision": "reject",
          "scientificReasonDe": "Die abhängigen HBr-Additionen werden an Ethen/Propen unter ionischen Bedingungen erklärt. Der vollständige vorherige Alkan-/Alken-Halogenvergleich einschließlich radikalischer Substitution ist dafür nicht erforderlich; zudem benötigt Kunststoffklassifikation diesen Additionsmechanismus nicht. Kunststoffklassen werden aus gegebenen Ketten-/Netzstrukturen und thermisch-mechanischen Daten bestimmt. HBr-Addition samt Carbokation und Elektronenpfeilen ist hierfür kein benötigter Inhalt. Der konkrete Endanker (Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Grundkurs, Moderne Werkstoffe, Sachkompetenz, S. 44., Rohkurs GK) kann diese fachlich unnötige volle Zwischenkompetenz nicht in eine notwendige Vorleistung verwandeln.",
          "selectedEndpointAnchorId": "anchor-07d08c6d46a820557bce",
          "sourceRefExact": "Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Grundkurs, Moderne Werkstoffe, Sachkompetenz, S. 44.",
          "rawOriginalCourse": "GK",
          "fullPairRecord": "FIRST-JURISDICTION-PAIR-DECISIONS.frozen.json#17acbdec-5274-510f-8588-0eac164ebbe5::DE-NW"
        },
        {
          "pairKey": "17acbdec-5274-510f-8588-0eac164ebbe5::DE-HB",
          "jurisdiction": "DE-HB",
          "decision": "hold",
          "scientificReasonDe": "Die Bremer Granularität und Bestandszählung bleiben offen; der konkrete Einzelanker liefert keine whole97-Freigabe und belegt nicht automatisch den gesamten aktuellen Operatorumfang. Konkreter ursprünglicher Anker: Bremen Bildungsplan Chemie Gymnasiale Oberstufe 2022, 3.2-E-KUNSTSTOFFE, S. 19; Rohkurs GK_LK.",
          "selectedEndpointAnchorId": "anchor-37bdaf16fd14b78c9144",

    {
      "groupIndex": 12,
      "reviewGroupId": "goal-1e5a4b89-69f1-5379-811e-c8ec76faad2a-required-by-2924f784-5261-54e8-93ee-49ac3b3cd300",
      "prerequisiteGoalId": "1e5a4b89-69f1-5379-811e-c8ec76faad2a",
      "directDependentGoalId": "2924f784-5261-54e8-93ee-49ac3b3cd300",
      "physicalNecessityDecision": "approve",
      "scientificNecessityRationaleDe": "Der molare-Volumenauftrag gilt für unterschiedliche ideale Gase und verlangt passenden T/p-Bezug und erhaltene Stoffmenge. Die gemeinsame Volumen-pro-mol-Beziehung bei gleichem T/p setzt genau Avogadros Teilchenzahlvergleich voraus; ohne diese Bedingung wäre die Übertragung des Vm unbegründet.",
      "prerequisiteCaseIds": [
        "hydrogen-oxygen-one-litre",
        "mismatched-temperature-fresh"
      ],
      "dependentCaseIds": [
        "molar-volume-reference-state",
        "closed-volume-change-fresh"
      ],
      "jurisdictionJudgments": [
        {
          "pairKey": "1e5a4b89-69f1-5379-811e-c8ec76faad2a::DE-BW",
          "jurisdiction": "DE-BW",
          "decision": "approve",
          "scientificReasonDe": "Das Original fordert das universelle molare Volumen unter gleichen Bedingungen. Das aktuelle abhängige Profil muss erklären, warum sich ein gemeinsames Volumen auf gleiche Stoffmengen verschiedener Gase bezieht. Genau dies ist der Inhalt des Avogadro-Vorwissens, ohne eine zusätzliche kinetische Herleitung zu verlangen.",
          "selectedEndpointAnchorId": "anchor-e3ed5a1c546657413368",
          "sourceRefExact": "Bildungsplan 2016 Gymnasium Chemie Baden-Wuerttemberg, 3.2.2.2 (7), S. 21.",
          "rawOriginalCourse": "unspecified",
          "fullPairRecord": "FIRST-JURISDICTION-PAIR-DECISIONS.frozen.json#1e5a4b89-69f1-5379-811e-c8ec76faad2a::DE-BW"
        },
        {
          "pairKey": "1e5a4b89-69f1-5379-811e-c8ec76faad2a::DE-BB",
          "jurisdiction": "DE-BB",
          "decision": "approve",
          "scientificReasonDe": "Im Original der Einführungsphase werden Stoffmenge, Gasvolumen und molare Größen verknüpft. Im aktuellen Profil ist nicht nur Einsetzen gefragt: Es begründet die Gas-Unabhängigkeit des molaren Volumens bei gleichem T,p. Dafür ist der Avogadro-Zusammenhang notwendig.",
          "selectedEndpointAnchorId": "anchor-63fa28b4560798054dd3",
          "sourceRefExact": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.1.1 Chemische Reaktionen quantitativ betrachtet, S. 18.",

        },
        {
          "pairKey": "22133f29-ef02-4408-8f8d-2bbea3275d91::DE-SN",
          "jurisdiction": "DE-SN",
          "decision": "hold",
          "scientificReasonDe": "Das aktuelle sächsische Quelleninventar und die Deckung der vollständigen aktuellen Kompetenz sind noch nicht geklärt; ein einzelner ursprünglicher Inhalt trägt keine Freigabe des ganzen Bestands. Konkreter ursprünglicher Anker: Lehrplan Gymnasium Chemie Sachsen 2025, Jahrgangsstufe 12 Leistungskurs, Elektrochemische Reaktionen, PDF-S. 56; Rohkurs LK.",
          "selectedEndpointAnchorId": "anchor-0090b93247f481b670c3",

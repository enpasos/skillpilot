    {
      "groupIndex": 10,
      "reviewGroupId": "goal-1bdaf7f2-ff3b-455a-a7fb-95a44642762a-required-by-e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
      "prerequisiteGoalId": "1bdaf7f2-ff3b-455a-a7fb-95a44642762a",
      "directDependentGoalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
      "physicalNecessityDecision": "reject",
      "scientificNecessityRationaleDe": "Die CuO-/FeS-Daten liefern Edukt- und Produktmassen einschließlich Rest; deren konstante Zusammensetzung lässt sich unmittelbar normieren. Die gesamte vorherige Kompetenz zu offenen/geschlossenen Gas-Massenbilanzversuchen ist dafür nicht notwendig.",
      "prerequisiteCaseIds": [
        "sealed-flask-before-after",
        "fresh-open-gas-loss"
      ],
      "dependentCaseIds": [
        "copper-oxide-ratio",
        "fresh-iron-sulfide-excess"
      ],
      "jurisdictionJudgments": [
        {
          "pairKey": "1bdaf7f2-ff3b-455a-a7fb-95a44642762a::DE-HH",
          "jurisdiction": "DE-HH",
          "decision": "reject",
          "scientificReasonDe": "Die CuO-/FeS-Daten liefern Edukt- und Produktmassen einschließlich Rest; deren konstante Zusammensetzung lässt sich unmittelbar normieren. Die gesamte vorherige Kompetenz zu offenen/geschlossenen Gas-Massenbilanzversuchen ist dafür nicht notwendig. Das Dalton-Profil kann Gesetz, Hypothese und Umgruppierung am gegebenen Wasser-Massenbeispiel erläutern. Zuvor konstante Massenverhältnisse an Oxid UND Sulfid selbst erkennen zu müssen ist dafür kein notwendiger Inhalt. Rutherford-Befunde und Atom-/Ionenzahlen können aus dem gegebenen Streu- und Teilchenmodell erschlossen werden. Daltons Atomhypothese einschließlich formaler Gesetz/Hypothese-Abgrenzung und chemischer Massenbilanz ist kein notwendiger Erwerbsschritt. Der konkrete Endanker (Hamburg Bildungsplan Gymnasium Sekundarstufe I Chemie, 3.1-UF-J10, S. 19., Rohkurs unspecified) kann diese fachlich unnötige volle Zwischenkompetenz nicht in eine notwendige Vorleistung verwandeln.",
          "selectedEndpointAnchorId": "anchor-0ed6eecc4c1f267e4053",
          "sourceRefExact": "Hamburg Bildungsplan Gymnasium Sekundarstufe I Chemie, 3.1-UF-J10, S. 19.",
          "rawOriginalCourse": "unspecified",
          "fullPairRecord": "FIRST-JURISDICTION-PAIR-DECISIONS.frozen.json#1bdaf7f2-ff3b-455a-a7fb-95a44642762a::DE-HH"
        }
      ]
    },
    {

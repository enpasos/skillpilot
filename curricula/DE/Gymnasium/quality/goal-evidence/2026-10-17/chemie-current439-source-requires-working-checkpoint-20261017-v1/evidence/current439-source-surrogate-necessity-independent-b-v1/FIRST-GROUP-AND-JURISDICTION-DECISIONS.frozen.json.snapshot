    {
      "groupIndex": 41,
      "reviewGroupId": "goal-70b12d1c-abaf-45c6-ae9e-b571e9cbc126-required-by-fd7977bf-1d8e-5c5e-9c37-bd76bb2ffeef",
      "prerequisiteGoalId": "70b12d1c-abaf-45c6-ae9e-b571e9cbc126",
      "directDependentGoalId": "fd7977bf-1d8e-5c5e-9c37-bd76bb2ffeef",
      "physicalNecessityDecision": "approve",
      "scientificNecessityRationaleDe": "Das abhängige Elektrolyseprofil verlangt selbst NaCl-Schmelze und festgelegte wässrige CuCl2-Elektrolyse, Ionenwege, Elektrodenreaktionen und erzwungenen Stoffumsatz. Die einfache Salz-Elektrolysekompetenz ist damit vollständig notwendiger Bestandteil; der Galvanikvergleich erweitert sie.",
      "prerequisiteCaseIds": [
        "chem-next25-70b12d1c-case-1",
        "chem-next25-70b12d1c-case-2"
      ],
      "dependentCaseIds": [
        "sodium-chloride-melt-data",
        "aqueous-copper-chloride-observed-products"
      ],
      "jurisdictionJudgments": [
        {
          "pairKey": "70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-NI",
          "jurisdiction": "DE-NI",
          "decision": "approve",
          "scientificReasonDe": "Das Original erläutert das Prinzip der Elektrolyse im gemeinsamen Kursbereich. Das aktuelle vertiefte Profil vergleicht Elektrolyse und galvanische Zelle anhand der umgekehrten Elektrodenprozesse. Dafür ist die vorgelagerte qualitative Zuordnung von Stoffumsatz, Elektroden und Energiezufuhr erforderlich; die LK-Faraday-Erweiterung wird nicht verwendet.",
          "selectedEndpointAnchorId": "anchor-38520c21424c07ad3c4c",
          "sourceRefExact": "Niedersachsen Kerncurriculum Chemie gymnasiale Oberstufe 2022, Elektronenübertragungsreaktionen, S. 26.",
          "rawOriginalCourse": "GK_LK",
          "fullPairRecord": "FIRST-JURISDICTION-PAIR-DECISIONS.frozen.json#70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-NI"
        },
        {
          "pairKey": "70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-SH",
          "jurisdiction": "DE-SH",
          "decision": "approve",
          "scientificReasonDe": "Die gemeinsame Originalspalte verlangt Elektrolyse und die Energieumwandlung im Vergleich mit galvanischen Zellen. Die aktuellen Vergleichsaufgaben bauen zwingend auf den grundlegenden Elektrodenreaktionen und der erzwungenen Richtung auf. Die quantitative LK-Erweiterung wird dabei nicht auf gA ausgeweitet.",
          "selectedEndpointAnchorId": "anchor-036b2f3e6b0e011387f8",
          "sourceRefExact": "Schleswig-Holstein Fachanforderungen Chemie Sekundarstufe I/II 2022, 3.2 Chemie und Energie, S. 67.",
          "rawOriginalCourse": "GK_LK",
          "fullPairRecord": "FIRST-JURISDICTION-PAIR-DECISIONS.frozen.json#70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-SH"
        },
        {
          "pairKey": "70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-HH",
          "jurisdiction": "DE-HH",
          "decision": "approve",
          "scientificReasonDe": "Das Original verlangt im gemeinsamen Bereich die Beschreibung des Elektrolyseprinzips und den Vergleich zur galvanischen Zelle. Das aktuelle Profil muss dafür bereits Anode/Kathode, Stoffumsatz und Energiezufuhr der einfachen Salzelektrolyse verstehen. Faraday steht im Zusatzbereich und ist für diese Zustimmung kein Grundkursbeleg.",
          "selectedEndpointAnchorId": "anchor-02c5d8af6057b96dc218",
          "sourceRefExact": "Hamburg Bildungsplan Studienstufe Chemie 2022, 3.3, S. 33.",
          "rawOriginalCourse": "GK_LK",
          "fullPairRecord": "FIRST-JURISDICTION-PAIR-DECISIONS.frozen.json#70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-HH"
        },
        {
          "pairKey": "70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-MV",
          "jurisdiction": "DE-MV",
          "decision": "approve",
          "scientificReasonDe": "Die Originalseite nennt die wässrige Elektrolyse mit Elektrodenreaktionen und verlangt den Vergleich der Elektrolysezelle mit galvanischer Zelle im gemeinsamen Teil. Diese konkrete Gegenüberstellung benötigt im aktuellen Profil das grundlegende Verständnis der erzwungenen Salz-Elektrolyse. Der folgende zusätzliche LK-Teil wird nicht verallgemeinert.",
          "selectedEndpointAnchorId": "anchor-16b2bd5656cab2875ca5",
          "sourceRefExact": "Rahmenplan Chemie Qualifikationsphase gymnasiale Oberstufe Mecklenburg-Vorpommern 2022 Erprobungsfassung, Qualifikationsphase, Qualifikationsphase: Galvanische Elemente, S. 28",
          "rawOriginalCourse": "GK_LK",
          "fullPairRecord": "FIRST-JURISDICTION-PAIR-DECISIONS.frozen.json#70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-MV"
        },
        {
          "pairKey": "70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-RP",
          "jurisdiction": "DE-RP",
          "decision": "approve",
          "scientificReasonDe": "Die Originalseite führt Elektrolyse und Elektrodenprozesse im Fundamentum für Grund- und Leistungsfach. Die extrahierte LK-Markierung beschreibt die tatsächliche Spaltenzuordnung nicht zutreffend. Das aktuelle Vergleichsprofil braucht die grundlegenden Stoff- und Ladungsprozesse der Elektrolyse; Faraday bleibt LK-Additum.",
          "selectedEndpointAnchorId": "anchor-1c2d2cc7959849edef3a",
          "sourceRefExact": "RP-CH-SEKII-2022 S. 26",
          "rawOriginalCourse": "LK",
          "fullPairRecord": "FIRST-JURISDICTION-PAIR-DECISIONS.frozen.json#70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-RP"
        },
        {
          "pairKey": "70b12d1c-abaf-45c6-ae9e-b571e9cbc126::DE-SL",
          "jurisdiction": "DE-SL",
          "decision": "hold",
          "scientificReasonDe": "Für den konkreten oberen Saarland-Elektrolyseanker fehlt im exakten Paket das zugehörige GK-/LK-Original. Die gelesenen Klasse-8- und EP-NW-Partner schließen diese Lücke nicht. Physikalische Notwendigkeit der einfachen Elektrolyse ersetzt den fehlenden Kurs-/Programmbeleg nicht.",
          "selectedEndpointAnchorId": "anchor-0341dc21997fb4d49fd6",
          "sourceRefExact": "SL-CH-SEKII-LK-2023-2025 S. 59",
          "rawOriginalCourse": "LK",

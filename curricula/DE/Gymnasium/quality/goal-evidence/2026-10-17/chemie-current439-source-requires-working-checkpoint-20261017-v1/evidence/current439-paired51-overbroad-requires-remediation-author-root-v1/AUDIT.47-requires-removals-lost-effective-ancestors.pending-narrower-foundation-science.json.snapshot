        "extendedData": {
          "provenance": {
            "sourceLandscapeId": "ff1ca997-b6cc-5ece-8e13-5498b4bbf808",
            "sourceLandscapeTitle": "Chemie Gymnasium (Bayern, LehrplanPLUS)",
            "sourceGoalId": "d0b3dadb-f9a8-59f5-9b0a-ad722d250020"

              ],
              "role": "authored-acquisition-foundation",
              "officialWholeSourceCredit": false,
              "sourceContext": "Original HB Bildungsplan Chemie GyO2022, printed/physical p30, Thema3.1 Energetik: Bindungsenthalpie appears in the right general Verbindliche Fachbegriffe column, outside the separate LK additions. Left general duties explain enthalpy-change laws, calculate from standard formation enthalpies, apply Hess and state the first law. P37 lists Thema3.1 among compulsory themes in all courses.",
              "sourceLimit": "The complete qualitative a530 goal/P is an explicit SkillPilot operational foundation; the source term is not an exact mapping of every case, model-limit demand or a mandatory numerical bond-energy-sum procedure. It supplies no substitute for separate calorimetry/measurement/quantitative energetics duties.",
              "acquisitionScope": "Whole unchanged qualitative bond-breaking/bond-forming explanation: supplied same-amount energy bars, net exothermic/endothermic comparison on fresh methane/water cases, and free-atom bookkeeping/model-path limit. No numerical bond-energy sum or hazardous execution is required.",
              "existingDependentGoalId": "3e433dae-99f9-5a95-ad63-d5fa0b5f6836",
              "existingRequiresRoute": "3e433dae-99f9-5a95-ad63-d5fa0b5f6836 -> a530ee7d-1002-5f02-ae05-a9d46410ac78",
              "compilerScopeSemantics": "No applicability override or source mapping is added. The existing HB-applicable ordinary dependent3e433 requires a530 in the pinned nine-prior candidate. The stock compiler propagates ordinary requires jurisdiction; actual final fixed-point output remains unobserved. Metadata itself does not enforce stage/course filtering; both current view scopes are CrossStage.",
              "topicChoiceBoundary": "This is a foundation for an already authored target, included under the owner policy before a future topic selector. No individual learner selection or universal new official duty is claimed."
            }
          ]
        },
        "examples": [],
        "resourceLinks": [
          {
            "type": "goal-visualization",
            "resourceType": "image",

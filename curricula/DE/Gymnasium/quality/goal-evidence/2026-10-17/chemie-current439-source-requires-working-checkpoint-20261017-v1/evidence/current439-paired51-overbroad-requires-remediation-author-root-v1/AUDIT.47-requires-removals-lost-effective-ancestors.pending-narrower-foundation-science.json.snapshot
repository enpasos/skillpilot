        ],
        "extendedData": {
          "applicabilityMappingInheritance": "boundary",
          "provenance": {
            "splitFromCanonicalGoalId": "49b13b33-34b7-5e4e-861c-b21082cb9922",
            "authorCandidatePackage": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-06/chemie-b008-twenty-six-native-source-preparation-author-v11",
            "routineCandidateKey": "data-validity",

    {
      "goalId": "431a0f03-f28a-5e56-a61f-000336d0b410",
      "currentWholeProfileBody": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "independent-arguments",
            "essentialUnderstandingDe": "Relevante Kriterien und fachlich gestützte eigene Pro-/Kontra-Argumente entstehen aus vergleichbaren Daten, nicht allein aus vorgegebenen Listen.",
            "essentialUnderstandingEn": "Relevant criteria and scientifically supported own arguments arise from comparable data, not just supplied lists.",
            "observablePerformanceDe": "Selbst je ein konkretes Pro-/Kontra-Argument zu F/G und E/M entwickeln und mit dem vorgegebenen Pauschalargument vergleichen.",
            "observablePerformanceEn": "Independently develop specific arguments for and against F/G and E/M and compare them with the supplied blanket argument."
          },
          {
            "id": "weighted-judgment",
            "essentialUnderstandingDe": "Kriteriengewichtung, Mindestanforderungen, Systemgrenzen und nicht vergleichbare Einheiten bestimmen die Reichweite eines Urteils.",
            "essentialUnderstandingEn": "Criterion weights, minimum requirements, system boundaries and incomparable units determine a judgment’s scope.",
            "observablePerformanceDe": "90-%-Entfernungsziel oder eigenes begründetes Gewicht offenlegen; Wiederverwendungsszenarien unterscheiden und Transport-/Wascheinheiten nicht addieren.",
            "observablePerformanceEn": "State the 90% removal threshold or own justified weights; distinguish reuse scenarios and do not add transport/washing units."
          },
          {
            "id": "revised-argument",
            "essentialUnderstandingDe": "Eine veränderte chemisch relevante Bedingung verändert bestimmte Argumente und verlangt konkrete Neugewichtung.",
            "essentialUnderstandingEn": "A changed chemically relevant condition alters specific arguments and requires explicit revised weighting.",
            "observablePerformanceDe": "Bei 18 kWh das Energieargument selbst neu entwickeln, Kosten/Rückstandslimits erhalten und das eigene Urteil aktualisieren; fehlende gemeinsame Folgenindikatoren begründen.",
            "observablePerformanceEn": "Independently revise the energy argument at 18 kWh, retain cost/residue limits and update the own judgment; justify missing common impact indicators."
          }

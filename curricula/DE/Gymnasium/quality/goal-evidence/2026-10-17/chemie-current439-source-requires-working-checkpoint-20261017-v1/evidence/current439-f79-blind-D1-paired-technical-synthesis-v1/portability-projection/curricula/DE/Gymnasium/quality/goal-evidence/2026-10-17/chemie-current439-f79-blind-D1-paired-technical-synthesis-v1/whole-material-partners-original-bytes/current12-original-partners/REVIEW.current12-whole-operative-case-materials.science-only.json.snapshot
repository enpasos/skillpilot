    {
      "goalId": "1f354a60-be44-512b-8f8b-f67c8c456035",
      "currentWholeProfileBody": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "coherent-explanation-argument",
            "essentialUnderstandingDe": "Eine fachliche Erklärung verbindet chemische Theorie mit Bedingungen und Daten; frühe Produktmenge und Leitfähigkeit sind keine voraussetzungslosen Gleichgewichts-/Konzentrationsbeweise.",
            "essentialUnderstandingEn": "A scientific explanation connects chemical theory with conditions and data; early product amount and conductivity are not unconditional proofs of equilibrium/concentration.",
            "observablePerformanceDe": "Erklärt Geschwindigkeit versus Gleichgewicht bzw. Ionenkonzentration versus Temperatur und begründet den Standpunkt mit den konkreten Kontrolldaten.",
            "observablePerformanceEn": "Explains rate versus equilibrium or ion concentration versus temperature and justifies a standpoint using the specific control data."
          },
          {
            "id": "actual-constructive-exchange",
            "essentialUnderstandingDe": "Konstruktiver Austausch nimmt tatsächliche Partnerbeiträge auf und beantwortet ihre fachliche Bedeutung; ein vorgedruckter Dialog ist kein Austausch.",
            "essentialUnderstandingEn": "Constructive exchange receives actual partner contributions and responds to their scientific meaning; a preprinted dialogue is not an exchange.",
            "observablePerformanceDe": "Dokumentiert einen echten Dialog mit eigener Rückfrage, tatsächlicher Partnerantwort und passender Folgeantwort; klärt fehlende Daten respektvoll.",
            "observablePerformanceEn": "Documents an actual dialogue with an own question, actual partner reply and appropriate follow-up; respectfully clarifies missing data."
          },
          {
            "id": "own-standpoint-review",
            "essentialUnderstandingDe": "Ein eigener Standpunkt wird anhand fachlicher Argumente ausdrücklich reflektiert und bei tragfähiger neuer Evidenz korrigiert.",
            "essentialUnderstandingEn": "An own standpoint is explicitly reflected on using scientific arguments and corrected when sound new evidence supports this.",
            "observablePerformanceDe": "Benennt eigene Anfangsaussage und deren fachliche Prüfung; reagiert auf neue Katalysator- oder temperaturgleiche Daten mit begründeter Beibehaltung/Einschränkung/Korrektur.",
            "observablePerformanceEn": "Names own initial statement and its scientific examination; responds to new catalyst or equal-temperature data with justified retention/restriction/correction."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "coherent-explanation-argument",
            "actual-constructive-exchange",
            "own-standpoint-review"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "partner-objection",
            "textDe": "Eine neue Partnerbehauptung zur Hinreaktion verlangt responsive Erklärung beider Reaktionsrichtungen.",
            "textEn": "A new partner claim about the forward reaction needs a responsive explanation of both directions."
          },
          {
            "id": "new-data",
            "textDe": "Neue temperaturgleiche, geprüfte Daten können eine zuvor gerechtfertigte Einschränkung ändern.",
            "textEn": "New checked equal-temperature data can change a previously justified restriction."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "upper-scientific-discourse-catalyst-discussion",
            "taskDemandDe": "Erkläre dem Partner fachlich den Unterschied von Geschwindigkeit und Gleichgewicht. Frage konstruktiv nach seinem Beleg, gehe auf seine Antwort ein und reflektiere/korrigiere einen eigenen Anfangssatz, falls nötig. Halte echten Dialog oder Moderatorprotokoll fest.\nFrische Variation: Partner behauptet nun „Katalysator macht nur Hinreaktion schneller“: Reagiere fachlich und konstruktiv mit Blick auf Gleichgewicht.",
            "taskDemandEn": "Scientifically explain to the partner the difference between rate and equilibrium. Constructively ask about their evidence, respond to their reply and reflect/correct an initial own statement if needed. Retain an actual dialogue or moderator log.\nFresh variation: Partner now claims “a catalyst only speeds the forward reaction”: respond scientifically and constructively considering equilibrium.",
            "expectedPerformanceDe": "Beispiel Antwort: „Dein früher C-Wert zeigt eine höhere Annäherungsgeschwindigkeit. Für K brauchen wir die Gleichgewichtskonzentrationen; beide erreichen hier denselben C-Endwert. Welche A/B-Werte liegen dann vor?“ Rückfrage anerkennen: gleicher C-Wert allein braucht gleiche Bilanz/Volumen/Anfangsbedingungen; mit gegebenen Bedingungen unterstützt er gleiche Gleichgewichtslage. Eigene pauschale Aussage „Katalysatoren erzeugen mehr Produkt“ auf frühen Zeitpunkt begrenzen. Ein vorgeschriebener Beispiel-Dialog ersetzt keinen tatsächlichen Austausch.\nFrischer Transfer: Fachliche Referenz für eine responsive Antwort: „Woran würdest du am Gleichgewicht erkennen, dass nur die Hinreaktion beschleunigt wird?“ Die tatsächliche Antwort aufnehmen. Ein geeigneter Katalysator ermöglicht einen alternativen Weg für Hin- und Rückrichtung. Würde bei gleichem Gleichgewicht nur eine Richtung dauerhaft schneller, entstünde ein Netto-Umsatz; das widerspräche gleicher Gleichgewichtslage. Gleiche Langzeitbedingungen und K bleiben, die Annäherung kann schneller sein. Die eigene Anfangsaussage „mehr Produkt“ auf den frühen Zeitpunkt einschränken bzw. eine richtige Aussage ausdrücklich anhand der Argumente beibehalten. Dies ist eine mögliche wissenschaftliche Reaktion, kein aufgezeichneter Dialog; tatsächliche Partnerantwort und eigene Folgeantwort müssen im Moderatorlog entstehen.",
            "expectedPerformanceEn": "Example reply: “Your early C value shows faster approach. For K we need equilibrium concentrations; both reach the same C endpoint here. What A/B values are then present?” Acknowledge the follow-up: equal C alone needs equal balance/volume/initial conditions; with the given conditions it supports the same equilibrium position. Restrict an own broad statement “catalysts make more product” to the early time. A prescribed example dialogue does not replace actual exchange.\nFresh transfer: Scientific reference for a responsive reply: “How would you recognise at equilibrium that only the forward reaction speeds up?” Receive the actual answer. A suitable catalyst permits an alternative pathway for forward and reverse directions. If only one direction remained faster at the same equilibrium, there would be net conversion, contradicting the unchanged equilibrium position. Equal long-time conditions and K remain; approach may be faster. Restrict an own initial “more product” statement to early time, or explicitly retain a correct statement from the arguments. This is a possible scientific response, not a recorded dialogue; actual partner reply and own follow-up must arise in the moderator log.",
            "understandingFocusDe": "Theoriegestützte Erklärung, echter Austausch und eigene Standpunktreflexion bleiben drei beobachtbare Leistungen.",
            "understandingFocusEn": "Theory-based explanation, actual exchange and own standpoint reflection remain three observable performances."
          },
          {
            "id": "upper-scientific-discourse-conductivity-debate",
            "taskDemandDe": "Führe einen fachlich konstruktiven Dialog: erkläre, argumentiere mit Kontrolle, höre/frage nach, reagiere auf eine echte Gegenfrage und überprüfe einen eigenen Standpunkt. Dokumentiere Beiträge getrennt nach Sprecher.\nFrische Variation: Partner liefert neue Daten bei gleicher Temperatur: Prüfe die Evidenz und ändere deinen Standpunkt, wenn sie es trägt.",
            "taskDemandEn": "Conduct a scientifically constructive dialogue: explain, argue from the control, listen/ask, respond to an actual counter-question and review an own standpoint. Document contributions by speaker.\nFresh variation: Partner supplies new equal-temperature data: examine evidence and change your standpoint if supported.",
            "expectedPerformanceDe": "Kontrolle A35 ≈ B35 begrenzt Salzbehauptung, Temperatureffekt ist plausibel. Frage: „Vergleichen wir wirklich gleiche Temperaturen und Ionensorten?“ Partnerantwort aufnehmen und darauf antworten; bei eigener früherer Annahme gleicher Temperatur diese sichtbar korrigieren. Bei unbekannter Ionensorte reicht κ selbst temperaturgleich nicht für eindeutige NaCl-Menge. Modellantwort gibt fachliche Referenz, nicht einen erfundenen gelungenen Dialog.\nFrischer Transfer: Frische offen synthetische Gesprächskarte: A und B bei 20 °C, gleiche bekannte Ionensorte/Matrix, geprüfte Standards, A=1800 und B=2100 µS/cm, Wiederholstreuung jeweils etwa ±3. Die alte Temperaturkonfundierung ist für diesen neuen Vergleich kontrolliert; 300 ist deutlich größer als die gegebene Streuung. Als Referenzantwort: „Damit nehme ich meine Temperaturerklärung für diese neue Differenz zurück. Unter geprüfter gleicher Matrix und passender Konzentrationskalibrierung spricht der Wert für mehr NaCl, bestimmt aber ohne Kalibrierung keine exakte Menge.“ Tatsächliche Partnerdaten zuerst auf ihre Bedingungen prüfen, Rückfrage stellen, Antwort aufnehmen und die eigene frühere Position ausdrücklich ändern/einschränken. Neue Karte ist keine echte Partnerreaktion oder Messung; ±3 ist keine Gesamtunsicherheit.",
            "expectedPerformanceEn": "A35 ≈ B35 control limits the salt claim; temperature effect is plausible. Ask: “Are we comparing equal temperatures and ion species?” Receive the partner’s answer and respond; visibly correct an earlier own equal-temperature assumption if present. For unknown ions even equal-temperature κ does not uniquely give NaCl amount. The reference gives scientific guidance, not an invented successful dialogue.\nFresh transfer: Fresh openly synthetic discussion card: A and B at 20 °C, the same known ion type/matrix, checked standards, A=1800 and B=2100 µS/cm, repeat scatter about ±3 each. The old temperature confound is controlled for this new comparison; 300 is much larger than the given scatter. Reference reply: “I withdraw my temperature explanation for this new difference. With checked equal matrix and appropriate concentration calibration this supports more NaCl, but without calibration does not determine its exact amount.” First inspect actual partner data for conditions, ask a follow-up, receive the reply and explicitly revise/restrict the own earlier position. The fresh card is no actual partner response or measurement; ±3 is not total uncertainty.",
            "understandingFocusDe": "Eine fachlich tragfähige neue Bedingung verändert den eigenen Standpunkt; reale Wechselbeiträge bleiben erforderlich.",
            "understandingFocusEn": "A scientifically sound new condition changes the own standpoint; actual exchanged contributions remain required."
          }
        ]
      },
      "wholeCurrentOperativeCasesAndAuthoredReferenceResponses": [
        {
          "caseKey": "upper-scientific-discourse-catalyst-discussion",
          "wholeOperativeCase": {

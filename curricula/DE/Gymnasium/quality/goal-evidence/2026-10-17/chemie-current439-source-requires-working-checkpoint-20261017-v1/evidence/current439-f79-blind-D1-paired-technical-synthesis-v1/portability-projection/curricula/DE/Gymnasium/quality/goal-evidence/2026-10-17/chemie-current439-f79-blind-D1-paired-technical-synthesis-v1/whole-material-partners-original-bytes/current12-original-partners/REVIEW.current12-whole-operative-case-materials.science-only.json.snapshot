  "goals": [
    {
      "goalId": "e81a4aed-9695-533e-8eb7-7a0c714346ea",
      "currentWholeProfileBody": {
        "archetype": "experiment",
        "expectations": [
          {
            "id": "guided-safe-action",
            "essentialUnderstandingDe": "Ein vorgegebenes Untersuchungsverfahren liefert nur bei tatsächlich sicher ausgeführten, vergleichbaren Schritten einen prüfbaren Befund.",
            "essentialUnderstandingEn": "A prescribed procedure yields a testable finding only through actually safe, comparable execution.",
            "observablePerformanceDe": "Führt nach konkreter Lehrkraftfreigabe die vorgegebenen Leitfähigkeits- oder Auflösungsschritte aus, kontrolliert Variablen und hält tatsächliche Handlung, Abweichung und Stopp fest.",
            "observablePerformanceEn": "After specific teacher release executes the prescribed conductivity or dissolution steps, controls variables and records actual action, deviation and stop."
          },
          {
            "id": "own-observation-record",
            "essentialUnderstandingDe": "Eigene Beobachtungen und Messwerte sind von Referenzdaten, Geräteauflösung und vollständig bekannter Unsicherheit zu unterscheiden.",
            "essentialUnderstandingEn": "Own observations and readings differ from reference data, instrument resolution and fully known uncertainty.",
            "observablePerformanceDe": "Protokolliert eigene Zeit-/Temperatur- oder Leitfähigkeitswerte mit Einheiten, Blank/Rinsung bzw. definiertem Endpunkt und Wiederholung; Musterwerte werden als Muster bezeichnet. Standardprüfung mit0–5000µS/cm im ganzen1970–2010-Bereich bei25°C, tatsächlichen Bereich/Modus/Gerätespezifikation protokollieren; Auflösung nicht als Genauigkeit.",
            "observablePerformanceEn": "Records own time/temperature or conductivity readings with units, blank/rinsing or defined endpoint and repeat; labels reference values as references. Log the standard check on0–5000µS/cm over1970–2010 at25°C with actual range/mode/instrument specification; resolution is not accuracy."
          },
          {
            "id": "hypothesis-and-confound",
            "essentialUnderstandingDe": "Mobile Ionen erklären Leitfähigkeit; Auflösungsdauer hängt unter anderem von Temperatur, Körnung und Rühren ab.",
            "essentialUnderstandingEn": "Mobile ions explain conductivity; dissolution time depends on temperature, grain size and stirring among other factors.",
            "observablePerformanceDe": "Bezieht eigene Ergebnisse auf die Hypothese, erklärt die passenden chemischen Zusammenhänge und entwirft zur frischen Störvariable einen sicheren Kontrollvergleich.",
            "observablePerformanceEn": "Relates own results to the hypothesis, explains the appropriate chemical relations and designs a safe control comparison for the fresh confound."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "guided-safe-action",
            "own-observation-record",
            "hypothesis-and-confound"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,

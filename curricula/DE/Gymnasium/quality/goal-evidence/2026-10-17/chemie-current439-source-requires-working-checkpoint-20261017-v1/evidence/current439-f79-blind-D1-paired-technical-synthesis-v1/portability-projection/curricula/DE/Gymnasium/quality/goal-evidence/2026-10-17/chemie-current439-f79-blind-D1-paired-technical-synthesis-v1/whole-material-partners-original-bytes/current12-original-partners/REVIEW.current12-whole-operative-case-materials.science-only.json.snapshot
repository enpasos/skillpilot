        "expectations": [
          {
            "id": "atom-periodicity-equilibrium",
            "essentialUnderstandingDe": "Modelle machen unterschiedliche chemische Beziehungen zugänglich; Schalengeometrie erklärt qualitative Periodizität, Q/K-Massenbilanz eine Gleichgewichtslage.",
            "essentialUnderstandingEn": "Models make different chemical relations accessible; shell geometry explains qualitative periodicity, Q/K mass balance an equilibrium position.",
            "observablePerformanceDe": "Wählt und nutzt tatsächlich analoge Atommodelle und eigene digitale Gleichgewichtstabelle, prüft Na/Mg-Daten und x=0,20 und verändert für K=2 die gültige Lösung.",
            "observablePerformanceEn": "Actually chooses and uses analogue atom models and an own digital equilibrium table, examines Na/Mg data and x=0.20 and changes the valid solution for K=2."
          },
          {
            "id": "bonding-complex-geometry",
            "essentialUnderstandingDe": "Bindungspolarität und räumliche Geometrie wirken zusammen; Konnektivität allein beschreibt Kontakte komplexer organischer Moleküle nicht ausreichend.",
            "essentialUnderstandingEn": "Bond polarity and spatial geometry work together; connectivity alone does not adequately describe contacts of complex organic molecules.",
            "observablePerformanceDe": "Prüft CO2/H2O-Dipole und ordnet im komplexen Ammonium-/Amid-/Phenylgerüst tatsächlich räumliche, flexible/planare Abschnitte und geeignete Rezeptorkontakte zu. Nutzt das konkrete28-Atom-L/L2-Koordinaten-/Verbindungskit mit eigener räumlicher Registrierung und Abstands-/Winkelprotokoll.",
            "observablePerformanceEn": "Examines CO2/H2O dipoles and actually maps spatial flexible/planar regions and appropriate receptor contacts in the complex ammonium/amide/phenyl scaffold. Uses the actual28-atom L/L2 coordinate/connectivity kit with own spatial registration and distance/angle log."
          },
          {
            "id": "receptor-and-enzyme",
            "essentialUnderstandingDe": "Rezeptorbelegung ist keine nachgewiesene Aktivierung; Substrat-Enzym-Modell braucht Bindung, Anpassung und chemische Umsetzung ohne Enzymverbrauch.",
            "essentialUnderstandingEn": "Receptor occupancy is not demonstrated activation; a substrate–enzyme model needs binding, adjustment and chemical conversion without consuming the enzyme.",
            "observablePerformanceDe": "Erstellt eigene θ-Tabelle 0/0,5/0,75, vergleicht L/L2 und S/I, zeigt Esterhydrolyse mit H2O und erhaltenem E und begrenzt Aussagen zu Wirkung und Kinetik.",
            "observablePerformanceEn": "Creates own θ table 0/0.5/0.75, compares L/L2 and S/I, shows ester hydrolysis with H2O and retained E and bounds claims about effects and kinetics."
          },
          {
            "id": "test-limits-development",
            "essentialUnderstandingDe": "Eine Modellprüfung benötigt Vergleich, Beobachtung und Annahmen; Weiterentwicklung adressiert konkret fehlende Aktivitäten, Dynamik, Lösungsmittel oder Reaktionsschritte.",
            "essentialUnderstandingEn": "A model test needs comparison, observation and assumptions; development targets specifically missing activities, dynamics, solvent or reaction steps.",
            "observablePerformanceDe": "Begründet Möglichkeiten, Grenzen und Weiterentwicklung aller Pflichtkontexte; unterscheidet Modellarbeit von Realexperiment und bewertet zusätzliche Bindungsgruppe ohne korrigierte Geometrie.",
            "observablePerformanceEn": "Justifies power, limits and development of all mandatory contexts; distinguishes model work from real experimentation and evaluates an added binding group without corrected geometry."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "atom-periodicity-equilibrium",
            "bonding-complex-geometry",

        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "reaction-ratio-and-endpoint",
          "textDe": "Einprotonige und unter den gegebenen Bedingungen zweiprotonig neutralisierte Säure; vorgegebene pH-Sprungbereiche gegenüber Indikatorbereich vergleichen.",
          "textEn": "Monoprotic acid and an acid neutralized diprotically under the supplied conditions; compare provided pH-jump and indicator ranges."
        },
        {
          "id": "process-versus-data",
          "textDe": "Praktische beobachtete Durchführung und unabhängiger datenbasierter Transfer werden getrennt als Evidenzarten benannt.",
          "textEn": "Actual observed practical conduct and independent data-based transfer are identified as different evidence kinds."
        },
        {
          "id": "acquired-concentration-reference",
          "textDe": "Die Konzentrationsbeziehung wird erstmals aus Bedeutung und Einheiten entwickelt; keine gegebene Formel ersetzt den Erwerb.",
          "textEn": "Acquire concentration relations from meaning and units; a given formula does not replace learning."

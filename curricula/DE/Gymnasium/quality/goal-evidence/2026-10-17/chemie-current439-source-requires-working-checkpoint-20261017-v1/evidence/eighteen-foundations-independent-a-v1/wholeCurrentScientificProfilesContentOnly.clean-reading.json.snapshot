    "goalId": "e22a34d4-ac1e-5afe-8f77-0dfa4fd9f44f",
    "wholeProfile": {
      "archetype": "experiment",
      "expectations": [
        {
          "id": "e1",
          "essentialUnderstandingDe": "Unter festgelegten pH- und Matrixbedingungen bindet EDTA die erfassten Metallionen im Verhältnis 1:1; Puffer und Metallindikator ermöglichen einen auswertbaren Endpunkt.",
          "essentialUnderstandingEn": "Under specified pH and matrix conditions, EDTA binds the measured metal ions in a 1:1 ratio; buffer and metal indicator enable an interpretable endpoint.",
          "observablePerformanceDe": "Die lernende Person erklärt Komplexbildung, bedingte Stabilität und Indikatorverdrängung und begrenzt den Befund auf die Ca/Mg-Summe.",
          "observablePerformanceEn": "The learner explains complex formation, conditional stability and indicator displacement, limiting the result to the Ca/Mg sum."
        },
        {
          "id": "e2",
          "essentialUnderstandingDe": "Eine durchgeführte Titration erfordert beobachtetes sachgerechtes Handeln; eine gelesene Verbrauchstabelle belegt diese Handlung nicht.",
          "essentialUnderstandingEn": "Performing a titration requires observed competent handling; reading a titer table does not demonstrate that action.",
          "observablePerformanceDe": "Sie stellt nach tatsächlicher örtlicher Freigabe Verdünnungen und Aliquote her, bedient die Bürette und dokumentiert pH, Ablesungen und kontrollierten Farbumschlag. Ohne reale Beobachtung bleibt dieser Nachweis offen.",

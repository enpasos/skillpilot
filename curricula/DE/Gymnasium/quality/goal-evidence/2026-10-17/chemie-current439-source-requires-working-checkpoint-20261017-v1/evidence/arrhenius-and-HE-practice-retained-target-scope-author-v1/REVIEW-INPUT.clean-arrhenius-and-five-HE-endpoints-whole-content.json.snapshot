              ],
              "phase": "GLOBAL",
              "area": "Grundlagen",
              "topicCode": "CANONICAL.CHEMISTRY.SEK1.ACID_BASE"
            },
            "applicability": {
              "jurisdiction": [
                "DE-BB",

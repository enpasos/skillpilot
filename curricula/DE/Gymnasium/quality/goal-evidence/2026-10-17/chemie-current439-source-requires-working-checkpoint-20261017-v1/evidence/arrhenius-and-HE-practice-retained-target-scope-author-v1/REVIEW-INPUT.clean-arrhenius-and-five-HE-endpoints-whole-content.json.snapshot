        {
          "wholeGoal": {
            "id": "42391b16-bbae-5c77-84e1-d488e714167b",
            "shortKey": "canonical_chemistry_b008_lower_independently_planned_hypothesis_investigation",
            "applicability": {
              "jurisdiction": [
                "DE-BY",
                "DE-HE",
                "DE-NI",

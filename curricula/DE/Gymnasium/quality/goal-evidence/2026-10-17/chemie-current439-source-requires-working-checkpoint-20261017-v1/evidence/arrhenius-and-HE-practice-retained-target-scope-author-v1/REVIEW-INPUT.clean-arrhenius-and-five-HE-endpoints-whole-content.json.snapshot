        {
          "wholeGoal": {
            "id": "3259bf7f-4af4-58ae-8190-9aec07ec476f",
            "shortKey": "canonical_chemistry_bw_practical_assessment_1",
            "title": "Konzentrationsvariation praktisch durchführen und auswerten",
            "titleEn": "Carry out and evaluate a concentration variation",
            "description": "Die lernende Person kann den vorgegebenen BW-Praktikumsversuch sicher und regelgetreu tatsächlich durchführen, die eigene überprüfbare Durchführung protokollieren und ihre Ergebnisse fachlich begründet mit den angegebenen Modellgrenzen auswerten.",

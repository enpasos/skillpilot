      "wholeExistingRequiredTeachers": [
        {
          "id": "d2d735de-bede-5310-8aeb-8bb7562c7b75",
          "shortKey": "canonical_chemistry_bw_practical_1",
          "title": "Konzentrationsbedingte Gleichgewichtsverschiebungen experimentell untersuchen",
          "titleEn": "Investigate concentration-induced equilibrium shifts experimentally",
          "description": "Die lernende Person kann an einem vorgegebenen homogenen Gleichgewicht eine einzelne Konzentrationsänderung unter den vorgegebenen Sicherheitsbedingungen experimentell untersuchen, Vergleichsbeobachtungen mit einer Referenz protokollieren und die beobachtete Verschiebung mit dem Prinzip von Le Chatelier unter Angabe der Grenzen des verwendeten Modells erklären.",
          "descriptionEn": "The learner can experimentally investigate a single concentration change in a specified homogeneous equilibrium under the prescribed safety conditions, record observations against a reference, and explain the observed shift using Le Chatelier’s principle while stating the limits of the model used.",

            "type": "atomic",
            "examples": [],
            "resourceLinks": [
              {
                "type": "goal-visualization",
                "resourceType": "image",
                "role": "primary",
                "skillpilotId": "20f92ba0-f7f4-5407-bb96-07e30da9002f",
                "title": "Visualisierung: Massenwirkungsgesetz anwenden",
                "url": "/assets/goal-visualizations/chemie/20f92ba0-f7f4-5407-bb96-07e30da9002f/20f92ba0-f7f4-5407-bb96-07e30da9002f.jpg",
                "provider": "Google Gemini / Nano Banana Pro",
                "description": "Visualisierung zum Lernziel: Massenwirkungsgesetz anwenden.",

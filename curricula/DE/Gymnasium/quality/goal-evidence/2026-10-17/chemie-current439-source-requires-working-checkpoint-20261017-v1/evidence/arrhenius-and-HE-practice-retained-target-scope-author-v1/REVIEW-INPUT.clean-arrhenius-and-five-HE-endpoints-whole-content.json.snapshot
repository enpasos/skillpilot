              }
            ],
            "extendedData": {
              "applicabilityMappingInheritance": "boundary",
              "provenance": {
                "splitFromCanonicalGoalId": "f660c91a-fa14-5010-94cf-068d785c7fd2",
                "authorCandidatePackage": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-06/chemie-b008-twenty-six-native-source-preparation-author-v11",
                "routineCandidateKey": "upper-scientific-validity",
                "sourceBindingStatus": "prospective_partial_components_only_no_national_clearance"
              }
            },
            "title": "Wissenschaftliche Gültigkeitskriterien anwenden",
            "titleEn": "Apply criteria of scientific validity",
            "description": "Die lernende Person kann die Gültigkeit chemischer Erkenntnisse und die Möglichkeiten und Grenzen des Erkenntnisgewinnungsprozesses anhand von Reproduzierbarkeit, Falsifizierbarkeit, Intersubjektivität, logischer Konsistenz und Vorläufigkeit begründet reflektieren. Dabei unterscheidet sie belastbare Gegenbefunde von fehlgeschlagener Durchführung oder unzuverlässiger Messung.",
            "descriptionEn": "The learner can reflect with justification on the validity of chemical findings and the possibilities and limits of inquiry using reproducibility, falsifiability, intersubjectivity, logical consistency, and provisionality. They distinguish robust counterevidence from failed procedures or unreliable measurements.",
            "requires": [
              "a8800c36-d13c-5f63-962c-cf18c3795c63",
              "4aa3a130-b517-5ac5-87b2-147fe432cadd"
            ]
          },
          "wholeProfile": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "five-validity-principles",
                "essentialUnderstandingDe": "Reproduzierbarkeit, Falsifizierbarkeit, Intersubjektivität, logische Konsistenz und Vorläufigkeit begrenzen die Gültigkeit naturwissenschaftlicher Erkenntnisse gemeinsam.",
                "essentialUnderstandingEn": "Reproducibility, falsifiability, intersubjectivity, logical consistency and provisionality jointly constrain scientific validity.",
                "observablePerformanceDe": "Wendet alle fünf Aspekte am reproduzierten Gegenbefund und am Gleichgewichtsfall konkret an: prüfbare Bedingung, geteiltes Verfahren, Wiederholung, widerspruchsfreie Folgerung und begrenzte Geltung.",
                "observablePerformanceEn": "Applies all five aspects concretely to the repeated counterfinding and equilibrium case: testable condition, shared procedure, repeat, consistent inference and bounded validity."
              },
              {
                "id": "valid-counterfinding",
                "essentialUnderstandingDe": "Ein zuverlässiger Befund unter den beanspruchten Bedingungen kann eine universelle Vorhersage widerlegen; Verfahrensfehler oder andere Bedingungen sind davon zu unterscheiden.",
                "essentialUnderstandingEn": "A reliable finding under the claimed conditions can refute a universal prediction; procedural failures or different conditions must be distinguished.",
                "observablePerformanceDe": "Unterscheidet Rate 8,9 statt etwa 6 bei geprüfter Kalibrierung von ungeprüftem Gerät sowie Q=7 direkt nach Zugabe vom Gleichgewicht K=4 bei 25 °C.",
                "observablePerformanceEn": "Distinguishes rate 8.9 rather than about 6 with checked calibration from an unchecked instrument, and Q=7 immediately after addition from equilibrium K=4 at 25 °C."
              },
              {
                "id": "revise-scope",
                "essentialUnderstandingDe": "Bestätigung einzelner Fälle beweist keine universelle Theorie; eine Temperaturabhängigkeit erfordert eine ausdrücklich neue, prüfbare Aussage.",
                "essentialUnderstandingEn": "Confirmation of individual cases does not prove a universal theory; temperature dependence needs an explicitly new, testable statement.",
                "observablePerformanceDe": "Begrenzt die Schlussfolgerung bei fehlender Kalibrierung und formuliert für 35 °C eine neue K(T)-Frage, ohne einen 25-°C-Befund automatisch zu widerlegen.",
                "observablePerformanceEn": "Bounds the conclusion when calibration is absent and formulates a new K(T) question for 35 °C without automatically refuting a 25-°C finding."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "five-validity-principles",
                "valid-counterfinding",
                "revise-scope"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "measurement-validation",
                "textDe": "Ein reproduzierter Gegenbefund verliert die Geräteprüfung; die wissenschaftliche Bewertung wird konditional.",
                "textEn": "A repeated counterfinding loses its instrument check; scientific evaluation becomes conditional."
              },
              {
                "id": "temperature-scope",
                "textDe": "Geltung bei 25 °C wird von neuen Gleichgewichtsdaten bei 35 °C getrennt.",
                "textEn": "Validity at 25 °C is separated from new equilibrium data at 35 °C."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "upper-scientific-validity-reliable-counterresult",
                "taskDemandDe": "Reflektiere H ausdrücklich anhand Reproduzierbarkeit, Falsifizierbarkeit, Intersubjektivität, logischer Konsistenz und Vorläufigkeit. Unterscheide bestätigten Gegenbefund von bloßem Geräteausfall und erkläre die Reichweite.\nFrische Variation: Ersetze die Standards des dritten Teams durch fehlende Kalibration: Welche Schlussfolgerung muss jetzt offen bleiben?",
                "taskDemandEn": "Reflect on H explicitly using reproducibility, falsifiability, intersubjectivity, logical consistency and provisionality. Distinguish a confirmed counter-result from simple instrument failure and explain scope.\nFresh variation: Replace the third team’s standards with missing calibration: what conclusion must now remain open?",
                "expectedPerformanceDe": "Reproduzierbarkeit: zwei Teams bestätigen Verdopplung, drittes reproduziert Abweichung. Falsifizierbarkeit: H sagt ein prüfbares Verhältnis 2 voraus; verlässliche 8,9/3,0 ≈ 2,97 unter passenden Bedingungen widerspricht der universellen H. Intersubjektivität: veröffentlichte Standards/Protokolle ermöglichen fremde Prüfung. Konsistenz: universelles H und gültiger Gegenbefund sind gemeinsam nicht haltbar. Vorläufigkeit: H muss im belegten Umfang eingeschränkt/ersetzt werden; nicht alle Kinetikmodelle sind dadurch falsch. Defekter Sensor ohne gültige Kontrolle wäre noch kein Gegenbefund.\nFrischer Transfer: Fehlt der dritte Geräte-/Kalibrierbeleg, ist die Verlässlichkeit von 8,9 noch offen: Wiederholung derselben fehlerhaften Messung würde den Fehler nicht ausschließen. Damit ist der universelle Faktor-2-Satz durch diesen Datensatz nicht bereits zuverlässig falsifiziert. Die ersten beiden Teams stützen ihn unter ihren Bedingungen, beweisen ihn aber nicht universell. Für Reproduzierbarkeit und intersubjektive Prüfung fehlen nun nachvollziehbare Kalibrierung/Protokoll; die Vorhersage bleibt falsifizierbar, ihre Bewertung vorläufig und logisch konditional. Gleiche Bedingungen, geeignet geprüfte Standards und unabhängige Wiederholung verlangen; alte Daten erhalten. Ein dann bestätigter Wert um 8,9 bei c=2 gegenüber etwa 3 bei c=1 wäre ein konkreter Gegenbefund zur universellen Verdoppelung.",
                "expectedPerformanceEn": "Reproducibility: two teams confirm doubling, the third reproduces deviation. Falsifiability: H predicts testable ratio 2; reliable 8.9/3.0 ≈ 2.97 under suitable conditions contradicts universal H. Intersubjectivity: published standards/protocols allow others to check. Consistency: universal H and a valid counter-result cannot both hold. Provisionality: H must be restricted/replaced within the demonstrated scope; not all kinetic models are thereby false. A broken sensor without valid controls would not yet be a counter-result.\nFresh transfer: Without the third instrument/calibration receipt, reliability of 8.9 remains open: repeating the same faulty measurement would not exclude its error. This dataset therefore does not already reliably falsify the universal factor-2 statement. The first two teams support it under their conditions but do not prove it universally. Reproducibility and intersubjective scrutiny now lack traceable calibration/protocol; the prediction remains falsifiable, evaluation provisional and logically conditional. Require equal conditions, suitable checked standards and independent repeats; preserve old data. A then confirmed reading near 8.9 at c=2 compared with about 3 at c=1 would be a specific counterfinding to universal doubling.",
                "understandingFocusDe": "Alle fünf Gültigkeitsaspekte unterscheiden fehlende Validierung und tatsächlich belastbare Falsifikation.",
                "understandingFocusEn": "All five validity aspects distinguish missing validation from actually reliable falsification."
              },
              {
                "id": "upper-scientific-validity-equilibrium-revision",
                "taskDemandDe": "Bewerte mit allen fünf Gültigkeitskriterien die Ergebnisse und den behaupteten Gegenbefund. Gib eine tatsächlich falsifizierbare weitere Prüfung und Grenzen der bisherigen Bestätigung an.\nFrische Variation: Wenn K bei 35 °C anders ist: Begründe, weshalb dies nicht den 25-°C-Satz falsifiziert.",
                "taskDemandEn": "Assess results and claimed counter-result using all five validity criteria. State a genuinely falsifiable further test and limits of current corroboration.\nFresh variation: If K differs at 35 °C, explain why this does not falsify the 25-°C statement.",
                "expectedPerformanceDe": "Wiederholte und unabhängige Übereinstimmung unterstützt Reproduzierbarkeit/Intersubjektivität; gemeinsames Protokoll ermöglicht Kontrolle. Z prüft einen Nichtgleichgewichtszustand, nicht die Modellvorhersage K nach Einstellung; kein gültiger Widerspruch. Konsistenz verlangt passende Bedingungen; Falsifizierbarkeit wäre ein verlässliches Q außerhalb Unsicherheit nach Einstellung bei 25 °C. Vorläufig bestätigt, nicht endgültig bewiesen und nicht automatisch auf andere Temperaturen/Stoffsysteme übertragen.\nFrischer Transfer: Die Ausgangsaussage K=4 gilt für die angegebene Reaktion bei 25 °C. Ein anderes K bei 35 °C widerspricht dieser eingeschränkten Aussage nicht. K ist temperaturabhängig; die Beobachtung motiviert eine neue explizite K(T)-Hypothese, z. B. mit vorgegebener Richtung/Begründung aus zusätzlichen thermodynamischen Daten. Ohne solche Daten wird keine Richtung erfunden. Temperatur, erreichten Gleichgewichtszustand, gleiche Reaktionsdefinition und messbare Aktivitäten/Näherungen dokumentieren und unabhängig wiederholen. Reproduzierbarkeit und intersubjektive Prüfung prüfen die neue Aussage; Falsifizierbarkeit braucht einen konkreten Gegenbefund, logische Konsistenz trennt Temperaturbereiche und Vorläufigkeit hält den begrenzten Geltungsbereich offen.",
                "expectedPerformanceEn": "Repeated independent agreement supports reproducibility/intersubjectivity; shared protocol enables checking. Z tests a non-equilibrium state, not the prediction K after equilibration; no valid contradiction. Consistency requires matching conditions; falsifiability would be reliable Q outside uncertainty after equilibration at 25 °C. Provisionally corroborated, not finally proven and not automatically applicable to other temperatures/substance systems.\nFresh transfer: The starting statement K=4 applies to the specified reaction at 25 °C. A different K at 35 °C does not contradict that restricted statement. K depends on temperature; the observation motivates a new explicit K(T) hypothesis, for example with a supplied direction/justification from additional thermodynamic data. Without such data no direction is invented. Document temperature, attained equilibrium, same reaction definition and measurable activities/approximations and repeat independently. Reproducibility and intersubjective checks examine the new statement; falsifiability needs a specific counterfinding, logical consistency separates temperature ranges and provisionality keeps the bounded scope open.",
                "understandingFocusDe": "Gleichgewichtsdaten unter anderen Bedingungen führen zu neuer prüfbarer Aussage statt falscher 25-°C-Widerlegung.",
                "understandingFocusEn": "Equilibrium data under changed conditions lead to a new testable statement rather than false refutation at 25 °C."
              }
            ]
          },
          "beforeRole": "absent",
          "afterRole": "target",
          "currentCompiledApplicability": {
            "jurisdiction": [
              "DE-BY"
            ]
          }
        },

            "expectations": [
              {
                "id": "duty-reference-definition",
                "essentialUnderstandingDe": "Relative Referenzdefinition mit SHE = 0 V, Reduktionskonvention, angegebenen Standardzuständen/Temperatur erklären; 0 V nicht als fehlende Grenzfläche oder absolute Ein-Elektrodenmessung deuten. Ein Begriff oder Tabellenwert allein reicht nicht. / Relative Referenzdefinition mit SHE = 0 V, Reduktionskonvention, angegebenen Standardzuständen/Temperatur erklären; 0 V nicht als fehlende Grenzfläche oder absolute Ein-Elektrodenmessung deuten. Ein Begriff oder Tabellenwert allein reicht nicht.",
                "observablePerformanceDe": "q3-10-a: Relative Referenzdefinition mit SHE = 0 V, Reduktionskonvention, angegebenen Standardzuständen/Temperatur erklären; 0 V nicht als fehlende Grenzfläche oder absolute Ein-Elektrodenmessung deuten. Ein Begriff oder Tabellenwert allein reicht nicht. q3-10-b: Relative Referenzdefinition mit SHE = 0 V, Reduktionskonvention, angegebenen Standardzuständen/Temperatur erklären; 0 V nicht als fehlende Grenzfläche oder absolute Ein-Elektrodenmessung deuten. Ein Begriff oder Tabellenwert allein reicht nicht.",
                "essentialUnderstandingEn": "Explain the relative SHE = 0 V reference, reduction convention and stated standard states/temperature; do not equate 0 V with no interface or an absolute one-electrode measurement. A term or table entry alone is insufficient. / Explain the relative SHE = 0 V reference, reduction convention and stated standard states/temperature; do not equate 0 V with no interface or an absolute one-electrode measurement. A term or table entry alone is insufficient.",
                "observablePerformanceEn": "q3-10-a: Explain the relative SHE = 0 V reference, reduction convention and stated standard states/temperature; do not equate 0 V with no interface or an absolute one-electrode measurement. A term or table entry alone is insufficient. q3-10-b: Explain the relative SHE = 0 V reference, reduction convention and stated standard states/temperature; do not equate 0 V with no interface or an absolute one-electrode measurement. A term or table entry alone is insufficient."
              },
              {
                "id": "duty-c1",
                "essentialUnderstandingDe": "Reduktionspotenziale und freiwillige Richtung richtig interpretieren. / Negative Vorschlagsrichtung korrekt beurteilen.",
                "observablePerformanceDe": "q3-10-a: Reduktionspotenziale und freiwillige Richtung richtig interpretieren. q3-10-b: Negative Vorschlagsrichtung korrekt beurteilen.",
                "essentialUnderstandingEn": "Interpret reduction potentials and spontaneous direction correctly. / Evaluate negative proposed direction correctly.",
                "observablePerformanceEn": "q3-10-a: Interpret reduction potentials and spontaneous direction correctly. q3-10-b: Evaluate negative proposed direction correctly."
              },
              {
                "id": "duty-c2",
                "essentialUnderstandingDe": "Halb-/Gesamtgleichungen und Zellspannung korrekt. / Freiwillige Reaktion und1,93V berechnen.",
                "observablePerformanceDe": "q3-10-a: Halb-/Gesamtgleichungen und Zellspannung korrekt. q3-10-b: Freiwillige Reaktion und1,93V berechnen.",
                "essentialUnderstandingEn": "Give correct half/total equations and cell voltage. / Calculate spontaneous reaction and1.93V.",
                "observablePerformanceEn": "q3-10-a: Give correct half/total equations and cell voltage. q3-10-b: Calculate spontaneous reaction and1.93V."
              },
              {
                "id": "duty-c3",
                "essentialUnderstandingDe": "Elektroden und äußeren Elektronenfluss erklären. / Elektroden/Elektronen und Ionentransport getrennt erklären.",
                "observablePerformanceDe": "q3-10-a: Elektroden und äußeren Elektronenfluss erklären. q3-10-b: Elektroden/Elektronen und Ionentransport getrennt erklären.",
                "essentialUnderstandingEn": "Explain electrodes and external electron flow. / Explain electrodes/electrons and ion transport separately.",
                "observablePerformanceEn": "q3-10-a: Explain electrodes and external electron flow. q3-10-b: Explain electrodes/electrons and ion transport separately."
              },
              {
                "id": "duty-c4",

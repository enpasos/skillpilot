                "url": "/assets/goal-visualizations/chemie/4aa3a130-b517-5ac5-87b2-147fe432cadd/4aa3a130-b517-5ac5-87b2-147fe432cadd.png",
                "provider": "OpenAI / ChatGPT-Codex integrated image_gen tool",

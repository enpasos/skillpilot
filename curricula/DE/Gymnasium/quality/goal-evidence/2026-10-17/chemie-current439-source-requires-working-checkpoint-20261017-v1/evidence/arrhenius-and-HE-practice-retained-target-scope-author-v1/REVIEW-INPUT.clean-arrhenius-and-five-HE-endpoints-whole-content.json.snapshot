  "wholeSixteenOriginalMethodMaterialCasesContentOnly": [
    {
      "caseKey": "lower-chemical-question-hypothesis-warm-water",
      "candidateKey": "lower-chemical-question-hypothesis",
      "originalFamilyGoalId": "91238ba1-5c63-50c7-a4fd-9bbe492c6b61",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "In einer Küche verschwinden gleiche Zuckermengen beim Umrühren unterschiedlich schnell. Verfügbar wären gleich große Becher, Zucker, Wasser, Thermometer und Uhr. Es gibt noch keine formulierte Frage, Vermutung oder Messreihe.",
        "en": "In a kitchen, equal amounts of sugar disappear at different speeds during stirring. Equal beakers, sugar, water, a thermometer and a clock could be used. No question, hypothesis or measurement series has been formulated."
      },
      "learnerTask": {
        "de": "Formuliere selbst eine chemisch untersuchbare Frage und eine begründete Hypothese. Beschreibe einen stützenden und einen widersprechenden beobachtbaren Befund bei passenden Vergleichsbedingungen; behaupte keinen bereits durchgeführten Versuch.",
        "en": "Formulate your own chemically investigable question and justified hypothesis. Describe an observable supporting and contradicting result under appropriate comparison conditions; do not claim an experiment has already been performed."
      },
      "expectedAnswer": {
        "de": "Mögliche eigene Formulierung: Löst sich dieselbe Zuckermasse bei gleichem Wasservolumen und gleichem Rühren bei 40 °C schneller als bei 20 °C? Hypothese: Die Auflösezeit ist bei 40 °C kürzer; höhere Temperatur kann die Teilchenbewegung und den Lösungsvorgang beschleunigen. Wiederholt kürzere Zeiten bei sonst gleichen Bedingungen stützen; wiederholt gleiche oder längere Zeiten bei hinreichender Messgenauigkeit widersprechen dieser konkreten Vorhersage. Es wird Lösungsgeschwindigkeit, nicht automatisch Gleichgewichts-Löslichkeit untersucht.",
        "en": "One possible own formulation: Does the same mass of sugar dissolve faster at 40 °C than at 20 °C when water volume and stirring are equal? Hypothesis: Dissolution takes less time at 40 °C; higher temperature can increase particle motion and speed up dissolution. Repeated shorter times under otherwise equal conditions support it; repeated equal or longer times at sufficient precision contradict this prediction. This tests dissolution rate, not automatically equilibrium solubility."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "lower-chemical-question-hypothesis-warm-water-C1",
          "meaning": {
            "de": "Eigenständig formulierte Frage benennt veränderbare Einflussgröße und beobachtbares chemisches Phänomen.",
            "en": "The independently worded question identifies a changeable variable and observable chemical phenomenon."
          }
        },
        {
          "criterionKey": "lower-chemical-question-hypothesis-warm-water-C2",
          "meaning": {
            "de": "Eigene Hypothese ist prüfbar und begründet, nicht bloß ausgewählt.",
            "en": "The own hypothesis is testable and justified, not merely selected."
          }
        },
        {
          "criterionKey": "lower-chemical-question-hypothesis-warm-water-C3",
          "meaning": {
            "de": "Stützender und widersprechender Befund beziehen sich auf dieselbe Vorhersage und kontrollierte Bedingungen.",
            "en": "Supporting and contradicting results address the same prediction and controlled conditions."
          }
        }
      ],
      "transfer": {
        "de": "Formuliere für große Zuckerkristalle gegenüber zerdrückten Kristallen eine neue Frage und Vorhersage; halte Temperatur und Rühren fest.",
        "en": "Formulate a new question and prediction for large sugar crystals versus crushed crystals; hold temperature and stirring constant."
      },
      "sourceOperatorScopeContractDe": "BY C8/C9: einfach strukturierte chemische Fragen und beobachtungsprüfbare Hypothesen. Keine bloße Auswahl einer vorgegebenen Vermutung als eigene Formulierungsleistung; keine automatische Erledigung der SekII-Theoriepflicht."
    },
    {
      "caseKey": "lower-chemical-question-hypothesis-browning",
      "candidateKey": "lower-chemical-question-hypothesis",
      "originalFamilyGoalId": "91238ba1-5c63-50c7-a4fd-9bbe492c6b61",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "Ein angeschnittener Apfel wird unterschiedlich stark braun. Vorhanden sind gleichartige Apfelstücke, Wasser, Zitronensaft und Kamera; chemische Ursache und geeignete Vergleichsfrage sind noch offen. Lebensmittel werden im Versuch nicht gegessen.",
        "en": "Cut apple surfaces become brown to different extents. Similar apple pieces, water, lemon juice and a camera are available; the chemical cause and suitable comparison question remain open. Experimental food is not eaten."
      },
      "learnerTask": {
        "de": "Entwickle selbst Frage, Hypothese und Begründung zu einer veränderbaren Behandlung. Lege fest, welches sichtbare Ergebnis stützen oder widersprechen würde und was beim Vergleich gleich bleiben muss.",
        "en": "Develop your own question, hypothesis and justification about a changeable treatment. Specify a visible result that would support or contradict it and what must remain equal."
      },
      "expectedAnswer": {
        "de": "Beispiel: Verringert gleichmäßig aufgebrachter Zitronensaft gegenüber Wasser die Braunfärbung nach 20 Minuten? Hypothese: Ja, weil eine veränderte chemische Umgebung die an der Bräunung beteiligten Vorgänge hemmen könnte. Weniger Braunfärbung stützt, gleich starke oder stärkere wiederholte Färbung widerspricht unter gleicher Sorte, Fläche, Menge und Lagerung. Ein sichtbarer Unterschied allein identifiziert weder den einzelnen Wirkstoff noch den Mechanismus.",
        "en": "Example: Does evenly applied lemon juice reduce browning after 20 minutes compared with water? Hypothesis: Yes, because a changed chemical environment might inhibit processes involved in browning. Less browning supports it; equally strong or stronger repeated browning contradicts it at equal variety, area, liquid quantity and storage. A visible difference alone identifies neither the individual active substance nor the mechanism."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "lower-chemical-question-hypothesis-browning-C1",
          "meaning": {
            "de": "Frage und Hypothese werden selbst erzeugt.",
            "en": "The question and hypothesis are independently generated."
          }
        },
        {
          "criterionKey": "lower-chemical-question-hypothesis-browning-C2",
          "meaning": {
            "de": "Behandlung, Beobachtungszeit und Vergleich sind konkret prüfbar.",
            "en": "Treatment, observation time and comparison are concretely testable."
          }
        },
        {
          "criterionKey": "lower-chemical-question-hypothesis-browning-C3",
          "meaning": {
            "de": "Kausalbegründung bleibt als Vermutung gekennzeichnet; Ergebnisgrenzen sind benannt.",
            "en": "The causal explanation remains a hypothesis; limits of results are identified."
          }
        }
      ],
      "transfer": {
        "de": "Übertrage die Frage auf Sauerstoffzugang mit offenem und abgedecktem Gefäß; erkläre eine neue Störgröße.",
        "en": "Transfer the question to oxygen access using open and covered containers; explain a new confounder."
      },
      "sourceOperatorScopeContractDe": "BY C8/C9: einfach strukturierte chemische Fragen und beobachtungsprüfbare Hypothesen. Keine bloße Auswahl einer vorgegebenen Vermutung als eigene Formulierungsleistung; keine automatische Erledigung der SekII-Theoriepflicht."
    },
    {
      "caseKey": "upper-theory-based-question-hypothesis-weak-acid",
      "candidateKey": "upper-theory-based-question-hypothesis",
      "originalFamilyGoalId": "91238ba1-5c63-50c7-a4fd-9bbe492c6b61",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "Zwei Lösungen einer einprotonigen schwachen Säure haben unterschiedliche Konzentrationen. Gegeben: HA ⇌ H⁺ + A⁻; Ka = [H⁺][A⁻]/[HA] und für geringe Dissoziation [H⁺] ≈ √(Ka·c0). Temperatur und Säureart können konstant gehalten werden. Noch keine Forschungsfrage oder Hypothese.",
        "en": "Two solutions of a monoprotic weak acid have different concentrations. Given: HA ⇌ H⁺ + A⁻; Ka = [H⁺][A⁻]/[HA], and for small dissociation [H⁺] ≈ √(Ka·c0). Temperature and acid identity can be held constant. No research question or hypothesis is given."
      },
      "learnerTask": {
        "de": "Formuliere selbst eine Frage und eine theoriegestützte Hypothese für zehnfache Verdünnung. Leite eine quantitative Vorhersage ab und erläutere geeigneten Gegenbefund und Gültigkeitsbedingungen.",
        "en": "Formulate your own question and theory-based hypothesis for tenfold dilution. Derive a quantitative prediction and explain a suitable counter-result and validity conditions."
      },
      "expectedAnswer": {
        "de": "Beispiel: Wie ändert zehnfache Verdünnung den pH, solange die Näherung gilt? [H⁺] sinkt um √10, pH steigt um 0,5. Der Dissoziationsanteil nimmt zu, dennoch sinkt [H⁺]. Wiederholter pH-Anstieg nahe 0,5 stützt; verlässlich ausbleibender oder entgegengesetzter Anstieg bei gültiger Näherung widerspricht. Bei sehr starker Verdünnung werden Wasserautoprotolyse und Näherungsfehler relevant, nicht automatisch eine Widerlegung des Massenwirkungsgesetzes.",
        "en": "Example: How does tenfold dilution change pH while the approximation holds? [H⁺] decreases by √10, so pH rises by 0.5. The dissociated fraction increases while [H⁺] decreases. A repeated rise near 0.5 supports it; a reliably absent or opposite rise within valid approximation conditions contradicts it. At very high dilution, water autoionisation and approximation error matter; this does not automatically refute the law of mass action."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "upper-theory-based-question-hypothesis-weak-acid-C1",
          "meaning": {
            "de": "Selbst formulierte Frage und Hypothese nennen den Theoriebezug.",
            "en": "Own question and hypothesis explicitly use theory."
          }
        },
        {
          "criterionKey": "upper-theory-based-question-hypothesis-weak-acid-C2",
          "meaning": {
            "de": "Vorhersage pH +0,5 wird aus √c und Logarithmus abgeleitet.",
            "en": "The +0.5 pH prediction is derived from √c and the logarithm."
          }
        },
        {
          "criterionKey": "upper-theory-based-question-hypothesis-weak-acid-C3",
          "meaning": {
            "de": "Gegenbefund setzt verlässliche Messung und gültige Modellbedingungen voraus.",
            "en": "A counter-result requires reliable measurement and valid model conditions."
          }
        }
      ],
      "transfer": {
        "de": "Entwickle eine abweichende Vorhersage für eine vollständig dissoziierte starke Säure und dieselbe Verdünnung.",
        "en": "Develop the contrasting prediction for a fully dissociated strong acid and the same dilution."
      },
      "sourceOperatorScopeContractDe": "BY C11.1.3 und C12/C13 E1/E2/E3 verlangen ausdrücklich theoriegeleitete bzw. theoriebasierte Hypothesen. Der Theoriebezug ist verbindlich und wird nicht auf anspruchsvolle Zusatzfälle verschoben; NI SekII-Prozessanspruch bleibt separat zuzuordnen."
    },
    {
      "caseKey": "upper-theory-based-question-hypothesis-equilibrium",
      "candidateKey": "upper-theory-based-question-hypothesis",
      "originalFamilyGoalId": "91238ba1-5c63-50c7-a4fd-9bbe492c6b61",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "Ein geschlossenes Reaktionssystem besitzt A + B ⇌ C + D. Bei konstanter Temperatur gilt K = [C][D]/([A][B]); anfänglich ist Q = K. Eine zusätzliche Menge A kann eingebracht werden; Volumenänderung ist vernachlässigbar. Es werden keine konkreten Stoffe gehandhabt.",
        "en": "A closed reaction system has A + B ⇌ C + D. At constant temperature K = [C][D]/([A][B]); initially Q = K. Additional A can be introduced; volume change is negligible. No actual substances are handled."
      },
      "learnerTask": {
        "de": "Identifiziere selbst eine chemische Frage zur Störung und formuliere mit dem Massenwirkungsgesetz eine Hypothese. Leite Richtung und erwartbares Messsignal sowie einen Gegenbefund her.",
        "en": "Identify your own chemical question about the perturbation and formulate a hypothesis using the law of mass action. Derive the direction, expected measured signal and a counter-result."
      },
      "expectedAnswer": {
        "de": "Beispiel: Ändert zusätzliche A-Zufuhr die Gleichgewichtskonzentration von C? Unmittelbar wird der Nenner größer, Q < K; die Nettoreaktion läuft vorwärts, bis wieder Q = K. Erwartet wird eine gegenüber dem alten Gleichgewicht höhere C-Konzentration. Gegenbefund wäre unter tatsächlich gleicher Temperatur, geschlossenem System und nach Relaxation ein verlässlich nicht gestiegener C-Wert. K wird durch A-Zugabe bei fester Temperatur nicht größer; die Umstellung ist keine Behauptung vollständiger Umsetzung.",
        "en": "Example: Does adding A change the equilibrium concentration of C? Immediately the denominator increases, so Q < K; the net reaction proceeds forward until Q = K again. A higher C concentration than at the old equilibrium is predicted. A counter-result would be a reliably non-increased C value after relaxation in a genuinely closed system at unchanged temperature. Adding A at fixed temperature does not increase K; re-equilibration does not imply complete conversion."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "upper-theory-based-question-hypothesis-equilibrium-C1",
          "meaning": {
            "de": "Eigene Frage und Hypothese statt bloßer Wiederholung einer gelieferten Vermutung.",
            "en": "Own question and hypothesis, not repetition of a supplied conjecture."
          }
        },
        {
          "criterionKey": "upper-theory-based-question-hypothesis-equilibrium-C2",
          "meaning": {
            "de": "Q/K begründet Richtung; K und Konzentrationsverhältnis werden unterschieden.",
            "en": "Q/K justifies direction; K and concentration ratio are distinguished."
          }
        },
        {
          "criterionKey": "upper-theory-based-question-hypothesis-equilibrium-C3",
          "meaning": {
            "de": "Verlässlicher Gegenbefund und Bedingungen werden zusammen angegeben.",
            "en": "A reliable counter-result and its conditions are specified together."
          }
        }
      ],
      "transfer": {
        "de": "Formuliere eine zweite Hypothese für Entfernen von C; erkläre, weshalb ein Katalysator allein K nicht verändert.",
        "en": "Formulate a second hypothesis for removal of C; explain why a catalyst alone does not change K."
      },
      "sourceOperatorScopeContractDe": "BY C11.1.3 und C12/C13 E1/E2/E3 verlangen ausdrücklich theoriegeleitete bzw. theoriebasierte Hypothesen. Der Theoriebezug ist verbindlich und wird nicht auf anspruchsvolle Zusatzfälle verschoben; NI SekII-Prozessanspruch bleibt separat zuzuordnen."
    },
    {
      "caseKey": "upper-hypothesis-investigation-acid-analysis",
      "candidateKey": "upper-hypothesis-investigation",
      "originalFamilyGoalId": "91238ba1-5c63-50c7-a4fd-9bbe492c6b61",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "Lehrkraft stellt nach stoffbezogener Freigabe verdünnte einprotonige Essigsäure-Proben A/B, standardisierte 0,0100-mol/L-NaOH mit Chargen-/Standardisierungsangaben, 10,00-mL-Vollpipette mit Pipettierhilfe, 25-mL-Bürette mit 0,1-mL-Teilung, standfestes Stativ mit passender Bürettenklemme, beschriftete 100-mL-Erlenmeyerkolben sowie 50-mL-Becher für die pH-Route, Messzylinder und deionisiertes Spül-/Verdünnungswasser bereit. Für die pH-Route darf ein Aliquot mit derselben dokumentierten Menge Wasser so verdünnt werden, dass Elektrode/Junktion vollständig bedeckt sind; die zugesetzte Säurestoffmenge bleibt erhalten. pH-Meter mit passender Elektrode, Temperaturfühler und Geräteanleitung; frische beschriftete Puffer pH 4,01/7,00/10,01 bei 25 °C mit Charge/Gültigkeit und Temperaturtabelle, getrennte Kalibrier-/Spülbecher. Vor Untersuchung Geräteanleitung zur Kalibration und Kontrolle befolgen; Puffer und Proben bei 25,0 ± 0,5 °C angleichen und Temperatur dokumentieren. Bereitgestelltes freigegebenes Indikatormenü mit Etiketten: Phenolphthalein-Lösung 1 % in Ethanol, Umschlag pH 8,2–9,8, farblos zu rosa/rot; Methylorange-Lösung 0,1 %, Umschlag pH 3,1–4,4, rot zu gelb-orange. Nur von der Lehrkraft festgelegte kleine Tropfenmenge verwenden; Gebinde/Betriebsanweisungen und Entsorgung sind stoffbezogen freizugeben. Phenolphthalein kann für den alkalischen Endpunkt dieser schwachen Säure passend sein; Eignung und Endpunktabweichung sind anhand der eigenen pH-Kurve zu prüfen, nicht allein aus dem Namen abzuleiten. Hypothese vorgegeben: B enthält etwa doppelt so viele Säureäquivalente pro Volumen wie A. HA + OH⁻ → A⁻ + H2O (1:1); pH-Kurve/Endpunkt und Stoffmengenbilanz leisten unterschiedliche Beiträge. Keine Verkostung/Arzneimittelanalyse. Bereitstellung und Kalibrationsvorgaben sind kein Ausführungsnachweis.",
        "en": "After substance-specific authorisation the teacher supplies dilute monoprotic acetic-acid samples A/B, standardised 0.0100-mol/L NaOH with batch/standardisation information, 10.00-mL volumetric pipette with filler, 25-mL burette with 0.1-mL divisions, stable stand with suitable burette clamp, labelled 100-mL conical flasks and 50-mL beakers for the pH route, measuring cylinder and deionised rinse/dilution water. For the pH route, an aliquot may be diluted by the same documented water volume to cover electrode/junction fully; the added amount of acid is preserved. pH meter with suitable electrode, temperature probe and instructions; fresh labelled pH 4.01/7.00/10.01 buffers at 25 °C with batch/validity and temperature table, separate calibration/rinse beakers. Follow the instrument calibration/check instructions before investigation, equilibrate buffers/samples to 25.0 ± 0.5 °C and record temperature. Supplied authorised indicator menu with labels: phenolphthalein solution 1% in ethanol, transition pH 8.2–9.8, colourless to pink/red; methyl orange solution 0.1%, transition pH 3.1–4.4, red to yellow-orange. Use only the small drop amount specified by the teacher; containers/operating instructions and disposal require substance-specific authorisation. Phenolphthalein may suit the alkaline endpoint of this weak acid; assess suitability and endpoint bias against the own pH curve rather than inferring it from the name alone. Supplied hypothesis: B contains about twice as many acid equivalents per volume as A. HA + OH⁻ → A⁻ + H2O (1:1); pH curve/endpoint and amount balance contribute differently. No tasting/medicine analysis. Provision/calibration instructions are not an execution receipt."
      },
      "learnerTask": {
        "de": "Wähle begründet Indikator-/pH-Analyse und ein quantitatives Titrierverfahren. Plane größtenteils selbst Proben, Blind-/Kontrollprüfung und Wiederholungen, lasse den Plan freigeben und führe ihn tatsächlich aus. Protokolliere qualitative Umschlagbeobachtung, pH-/Volumendaten und berechne aus eigenen Werten das A/B-Verhältnis.",
        "en": "Justify choice of indicator/pH analysis and quantitative titration. Largely independently plan samples, blank/control checks and repeats, obtain authorisation and actually perform the experiment. Record qualitative colour change, pH/volume data and calculate the A/B ratio from own values."
      },
      "expectedAnswer": {
        "de": "Ein akzeptabler Plan verwendet je gleiche 10,00-mL-Aliquote, standardisierte Lauge, saubere vorbereitete Geräte, geeigneten schwache-Säure-Endpunkt und wiederholte Volumina. Referenz: 8,00 mL A und 16,00 mL B ergeben cA = 0,00800 mol/L, cB = 0,0160 mol/L und Verhältnis 2,00. Die echte Durchführung und eigenen Rohwerte müssen davon unabhängig dokumentiert sein. pH allein beweist wegen des Dissoziationsgleichgewichts kein Konzentrationsverhältnis 2; geeignete Stoffmengenanalyse schon innerhalb ihrer Unsicherheit. Die Indikatorwahl nutzt den angegebenen Umschlagsbereich und die eigene Kurve: Methylorange schlägt in dieser schwachen-Säure-Titration vor dem alkalischen Äquivalenzbereich um; Phenolphthalein verlangt einen kontrollierten ersten schwachen Umschlag und Prüfung der Endpunktabweichung. Kalibration mit aktuellen Puffern wird tatsächlich protokolliert; ihre Nominalwerte sind keine Probenmessung.",
        "en": "An acceptable plan uses equal 10.00-mL aliquots, standardised base, clean prepared instruments, an endpoint suitable for a weak acid and repeated volumes. Reference: 8.00 mL for A and 16.00 mL for B yield cA = 0.00800 mol/L, cB = 0.0160 mol/L and ratio 2.00. Actual execution and own raw values must be independently recorded. pH alone does not prove a concentration ratio of 2 because of dissociation equilibrium; an appropriate amount analysis can within its uncertainty. Indicator choice uses the stated transition range and own curve: methyl orange changes before the alkaline equivalence region in this weak-acid titration; phenolphthalein requires a controlled first faint colour change and assessment of endpoint bias. Actually log calibration with current buffers; their nominal values are not sample readings."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "upper-hypothesis-investigation-acid-analysis-C1",
          "meaning": {
            "de": "Analysenwahl und eigenständiger praktischer Plan werden fachlich begründet. Indikatorwahl verwendet Identität, Umschlagsbereich/Farbe und eigene pH-Kurve; pH-Kalibration wird nachvollziehbar dokumentiert.",
            "en": "Analytical choice and independent practical plan are scientifically justified. Indicator choice uses identity, transition range/colour and own pH curve; pH calibration is traceably documented."
          }
        },
        {
          "criterionKey": "upper-hypothesis-investigation-acid-analysis-C2",
          "meaning": {
            "de": "Qualitative und quantitative Teile werden tatsächlich nach Freigabe ausgeführt.",
            "en": "Qualitative and quantitative parts are actually performed after authorisation."
          }
        },
        {
          "criterionKey": "upper-hypothesis-investigation-acid-analysis-C3",
          "meaning": {
            "de": "Echte Rohdaten/Einheiten, Endpunkt und Wiederholung sind nachvollziehbar.",
            "en": "Actual raw data/units, endpoint and repeats are traceable."
          }
        },
        {
          "criterionKey": "upper-hypothesis-investigation-acid-analysis-C4",
          "meaning": {
            "de": "Stoffmengenrechnung aus eigenen Daten und begrenzter Hypothesenvergleich sind korrekt.",
            "en": "Amount calculation from own data and bounded hypothesis comparison are correct."
          }
        }
      ],
      "transfer": {
        "de": "Plane eine Prüfung für falsch konzentrierte Lauge; erläutere deren Wirkung auf absolute Konzentration und A/B-Verhältnis.",
        "en": "Plan a check for incorrect base concentration; explain its effect on absolute concentrations and the A/B ratio."
      },
      "sourceOperatorScopeContractDe": "BY C11.1.2/.3 verlangt Analysenmethoden und eigenständige praktische Ausführung. Dieses Kind prüft ausschließlich tatsächliche experimentelle Durchführung. Die modellbasierte Alternative in C12/13 E4/E5 bleibt am getrennten upper-model-use-criticism erhalten; der erfolgreiche Modelltest zählt nicht als ausgeführtes Experiment und umgekehrt. Quellenspezifische Alternativwege benötigen explizite target-/Routenbindungen; eine generische gemeinsame UND-Pflicht wird nicht erfunden. Auch eine bereitgestellte theoriegestützte Hypothese erlaubt die selbstständige praktische Planungs-/Durchführungsleistung. Eigene theoriegestützte Hypothesengenerierung wird nur im sie tatsächlich verlangenden integrierten Quellenweg, etwa C11.1.3, zusätzlich gebunden und bleibt am unveränderten upper-theory-based-question-hypothesis verpflichtend. Sie ist keine universelle prerequisite-Kante des experimentellen Erfolgsprodukts."
    },
    {
      "caseKey": "upper-hypothesis-investigation-colour-analysis",
      "candidateKey": "upper-hypothesis-investigation",
      "originalFamilyGoalId": "91238ba1-5c63-50c7-a4fd-9bbe492c6b61",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "Freigegebenes betreutes Analysenkit für spätere echte Ausführung: ausdrücklich Brilliant Blue FCF / Acid Blue 9 (CAS 3844-45-9); fertig hergestellte verdünnte wässrige Blindprobe und Standards 0/2/4/6 mg/L sowie Probe U mit unbekannter Konzentration, bekannten Stoff-/Chargenangaben. Kein Lernender wiegt Farbstoffpulver ein. Batteriebetriebenes Photometer bei etwa 630 nm, passende 1-cm-Küvetten, beschriftete Proben-/Spülgefäße, deionisiertes Verdünnungswasser, getrennte saubere 10,00-mL-Vollpipetten (Fehlergrenze ±0,02 mL) mit Pipettierhilfen und 20,00-mL-Messkolben (Fehlergrenze ±0,02 mL, USP-zertifizierte Geräte oder dokumentiertes gleichwertiges Gerät). Gerätelabels, Referenztemperatur und Auslauf-/Warteanleitung liegen bei; erst gefüllter Messkolben mit 10,00 mL Aliquot plus Auffüllen bis 20,00 mL nach Mischen liefert den nominalen Verdünnungsfaktor 2. Pipettierhilfe allein ist kein Volumenmessgerät. Lehrmodellkalibration A = 0,010 + 0,080·c (c in mg/L), nur 0–6 mg/L; Hypothese: U liegt bei 3–4 mg/L. Anbieter-Spektraldaten nennen ein Maximum nahe 629 nm in ihrer Referenzlösung; das ist keine Sicherheitsfreigabe oder tatsächliche Kit-Kalibration. Eigene tatsächlich gemessene Standards müssen bei echter Untersuchung die synthetische Gleichung ersetzen; Blindwert, Gerätewellenlänge, Küvettenorientierung und Wiederholungen dokumentieren. Aktuelle Betriebsanweisung/Gefährdungsbeurteilung und lokale Entsorgung sind vor Durchführung zwingend. Diese Zusammenstellung behauptet keine erfolgte Ausführung.",
        "en": "Authorised supervised analytical kit for later actual execution: explicitly Brilliant Blue FCF / Acid Blue 9 (CAS 3844-45-9); prepared dilute aqueous blank and 0/2/4/6 mg/L standards and sample U with unknown concentration, known substance/batch information. Learners do not weigh dye powder. Battery-powered photometer at approximately 630 nm, suitable 1-cm cuvettes, labelled sample/rinse vessels, deionised dilution water, separate clean 10.00-mL volumetric pipettes (error limit ±0.02 mL) with fillers and 20.00-mL volumetric flasks (error limit ±0.02 mL, USP-certified apparatus or documented equivalent). Instrument labels, reference temperature and delivery/wait instructions are supplied; a flask containing a 10.00-mL aliquot diluted to the 20.00-mL mark and mixed gives the nominal dilution factor 2. A pipette filler alone is not a volumetric instrument. Teaching-model calibration A = 0.010 + 0.080·c (c in mg/L), valid only at 0–6 mg/L; hypothesis: U is at 3–4 mg/L. Supplier spectral data give a maximum near 629 nm in their reference solution; this is neither safety authorisation nor actual kit calibration. Own actually measured standards must replace the synthetic equation in real investigation; record blank, instrument wavelength, cuvette orientation and repeats. Current operating instructions/hazard assessment and local disposal are mandatory before execution. This provision claims no execution already performed."
      },
      "learnerTask": {
        "de": "Plane selbst qualitative Farbprüfung und quantitative photometrische Analyse mit Blindprobe, Kalibration und Wiederholung. Lass den konkret stoffbezogenen Plan freigeben, führe ihn tatsächlich aus und dokumentiere deine Werte. Begründe, wie die Methode die Hypothese prüft und wann verdünnt werden müsste.",
        "en": "Independently plan qualitative colour checks and quantitative photometric analysis with blank, calibration and repeats. Obtain authorisation of the substance-specific plan, actually perform it and document your values. Justify how the method tests the hypothesis and when dilution would be necessary."
      },
      "expectedAnswer": {
        "de": "Ein möglicher Plan vergleicht Farbe und Blindprobe unter gleichen Bedingungen, prüft Standards, misst U wiederholt in sauberen Küvetten und nutzt die gültige Kalibration. Referenz U = 0,290 ergibt (0,290−0,010)/0,080 = 3,50 mg/L. Echte U-Werte erst bei Durchführung eintragen. Ähnliche Farbe allein identifiziert X nicht eindeutig. Außerhalb des linearen Bereichs ist eine bekannte Verdünnung und Rückrechnung nötig; Durchführung darf nicht durch Modellrechnung ersetzt werden.",
        "en": "A possible plan compares colour and blank under equal conditions, checks standards, repeatedly measures U in clean cuvettes and uses valid calibration. Reference U = 0.290 gives (0.290−0.010)/0.080 = 3.50 mg/L. Enter actual U values only during execution. Similar colour alone does not identify X uniquely. Outside the linear range, a known dilution and back-calculation are required; actual execution cannot be replaced by model arithmetic."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "upper-hypothesis-investigation-colour-analysis-C1",
          "meaning": {
            "de": "Qualitative Beobachtung und quantitative Analysenplanung sind enthalten.",
            "en": "Qualitative observation and quantitative analytical planning are included."
          }
        },
        {
          "criterionKey": "upper-hypothesis-investigation-colour-analysis-C2",
          "meaning": {
            "de": "Konkrete Stoff-/Gerätefreigabe, sichere echte Durchführung und eigener Log liegen vor.",
            "en": "Actual substance/instrument authorisation, safe real execution and own log are present."
          }
        },
        {
          "criterionKey": "upper-hypothesis-investigation-colour-analysis-C3",
          "meaning": {
            "de": "Blindwert, Standards, Wiederholung und Bereich werden kontrolliert. Bei erforderlicher echter Verdünnung sind eigene Aliquot-/Endvolumina, Geräteangaben und Rückrechnungsfaktor dokumentiert.",
            "en": "Blank, standards, repeats and range are controlled. Where actual dilution is required, own aliquot/final volumes, instrument information and back-calculation factor are recorded."
          }
        },
        {
          "criterionKey": "upper-hypothesis-investigation-colour-analysis-C4",
          "meaning": {
            "de": "Auswertung verwendet Kalibrationsoffset und passende Einheiten.",
            "en": "Evaluation uses calibration offset and appropriate units."
          }
        },
        {
          "criterionKey": "upper-colour-actual-calibration",
          "meaning": {
            "de": "Die echte Probe wird nur mit tatsächlich gemessener eigener Standardreihe ausgewertet; die Referenzgleichung zählt nicht als reale Kit-Kalibration.",
            "en": "The actual sample is evaluated only with actually measured own standards; the reference equation is not real kit calibration."
          }
        }
      ],
      "transfer": {
        "de": "Begründe für den bereitgestellten Modellwert A = 0,810, weshalb die gültige Kalibration 0–6 mg/L mit ihrem oberen Modellwert A = 0,490 keine Auswertung der unverdünnten Probe erlaubt. Wähle eine zweifache Verdünnung als ersten Prüfversuch: 10,00 mL Aliquot im 20,00-mL-Messkolben bis Marke auffüllen und mischen; erläutere die Gerätefehlergrenzen. Dieser Vorschlag garantiert noch keinen Wert im gültigen Bereich. Erst eine neue tatsächliche In-Bereich-Messung mit eigener gültiger Kalibration erlaubt die Bestimmung von cverdünnt und die Rückrechnung cunverdünnt = 2·cverdünnt. Liegt der neue Wert weiterhin außerhalb, ist eine weitere bekannte Verdünnung und eine neue gültige Messung erforderlich; den Gesamtfaktor dokumentieren. Aus A = 0,810 wird weder die ursprüngliche Konzentration noch der neue Messwert extrapoliert. Modellplanung ersetzt keine Durchführung. Echte Ausführung verlangt Freigabe, eigenen Volumenlog und eigene Messwerte.",
        "en": "For the supplied model value A = 0.810, explain why the valid 0–6 mg/L calibration with its upper model value A = 0.490 does not permit evaluation of the undiluted sample. Choose a twofold dilution as an initial trial: dilute a 10.00-mL aliquot to the mark in a 20.00-mL flask and mix; explain instrument error limits. This proposal does not yet guarantee a value within the valid range. Only a new actual in-range reading using own valid calibration permits determination of cdiluted and back-calculation cundiluted = 2·cdiluted. If the new reading remains outside the range, another known dilution and a new valid reading are required; record the overall factor. Neither original concentration nor the new reading is extrapolated from A = 0.810. Model planning does not replace execution. Actual execution requires authorisation, own volume log and own readings."
      },
      "sourceOperatorScopeContractDe": "BY C11.1.2/.3 verlangt Analysenmethoden und eigenständige praktische Ausführung. Dieses Kind prüft ausschließlich tatsächliche experimentelle Durchführung. Die modellbasierte Alternative in C12/13 E4/E5 bleibt am getrennten upper-model-use-criticism erhalten; der erfolgreiche Modelltest zählt nicht als ausgeführtes Experiment und umgekehrt. Quellenspezifische Alternativwege benötigen explizite target-/Routenbindungen; eine generische gemeinsame UND-Pflicht wird nicht erfunden. Auch eine bereitgestellte theoriegestützte Hypothese erlaubt die selbstständige praktische Planungs-/Durchführungsleistung. Eigene theoriegestützte Hypothesengenerierung wird nur im sie tatsächlich verlangenden integrierten Quellenweg, etwa C11.1.3, zusätzlich gebunden und bleibt am unveränderten upper-theory-based-question-hypothesis verpflichtend. Sie ist keine universelle prerequisite-Kante des experimentellen Erfolgsprodukts."
    },
    {
      "caseKey": "upper-quantitative-hypothesis-data-evaluation-digital-calibration",
      "candidateKey": "upper-quantitative-hypothesis-data-evaluation",
      "originalFamilyGoalId": "49b13b33-34b7-5e4e-861c-b21082cb9922",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "Modellreihe bei 520 nm und 1,00 cm: c = 0/2/4/6 mg/L, A = 0,010/0,170/0,330/0,490. U = 0,291/0,289 nach 1:2-Verdünnung. Hypothese: Ursprüngliche Probe enthält 7,0 ± 0,5 mg/L X. Eine Tabellenkalkulation ist verfügbar; Rohdaten sind synthetisch.",
        "en": "Model series at 520 nm and 1.00 cm: c = 0/2/4/6 mg/L, A = 0.010/0.170/0.330/0.490. U = 0.291/0.289 after 1:2 dilution. Hypothesis: Original sample contains 7.0 ± 0.5 mg/L X. A spreadsheet is available; raw data are synthetic."
      },
      "learnerTask": {
        "de": "Erzeuge tatsächlich eine Tabellenkalkulationsdatei mit Rohdaten, Streudiagramm, linearer Regression einschließlich Offset, Probenauswertung und dokumentiertem Verdünnungsfaktor. Begründe mathematische Wahl, Interpolation und Hypothesenbefund.",
        "en": "Actually create a spreadsheet file with raw data, scatter graph, linear regression including offset, sample evaluation and documented dilution factor. Justify mathematical choice, interpolation and hypothesis finding."
      },
      "expectedAnswer": {
        "de": "Steigung 0,080 L/mg, Offset 0,010; A-Mittel 0,290, cverdünnt = 3,50 mg/L, cOriginal = 7,00 mg/L. Beispiel Zellformeln AVERAGE(Probenspalte), SLOPE(A;c), INTERCEPT(A;c), (Amean−b)/m*2; lokalisierte Äquivalente zulässig. U liegt innerhalb der Kalibration. Abweichungen ±0,001 A entsprechen hier ±0,0125 mg/L verdünnt (nur Streuungsbeitrag), nicht vollständiger Unsicherheit. Daten stützen die Bereichshypothese; Chemie/Optik und Mathematik verbinden Kalibration und Stoffkonzentration.",
        "en": "Slope 0.080 L/mg, intercept 0.010; mean A 0.290, cdiluted = 3.50 mg/L, coriginal = 7.00 mg/L. Example cell formulas AVERAGE(sample column), SLOPE(A;c), INTERCEPT(A;c), (Amean−b)/m*2; localised equivalents accepted. U is within calibration. Deviations ±0.001 A correspond here to ±0.0125 mg/L diluted (scatter contribution only), not full uncertainty. Data support the interval hypothesis; chemistry/optics and mathematics connect calibration and concentration."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "upper-quantitative-hypothesis-data-evaluation-digital-calibration-C1",
          "meaning": {
            "de": "Echte digitale Rechendatei/Diagramm mit Formeln liegt als Produkt vor, nicht nur vorgestellte Werkzeugnutzung.",
            "en": "An actual digital calculation file/graph with formulas exists, not merely imagined tool use."
          }
        },
        {
          "criterionKey": "upper-quantitative-hypothesis-data-evaluation-digital-calibration-C2",
          "meaning": {
            "de": "Regression, Offset und Verdünnung sind korrekt und begründet.",
            "en": "Regression, offset and dilution are correct and justified."
          }
        },
        {
          "criterionKey": "upper-quantitative-hypothesis-data-evaluation-digital-calibration-C3",
          "meaning": {
            "de": "Chemischer/optischer Zusammenhang und Hypothesenbezug werden erläutert.",
            "en": "Chemical/optical relationship and hypothesis connection are explained."
          }
        },
        {
          "criterionKey": "upper-quantitative-hypothesis-data-evaluation-digital-calibration-C4",
          "meaning": {
            "de": "Unsicherheit, Bereich und Modellherkunft werden angemessen eingeschränkt.",
            "en": "Uncertainty, range and model provenance are appropriately bounded."
          }
        }
      ],
      "transfer": {
        "de": "Berechne digital neu für A = 0,650 und erkläre, warum die direkte Extrapolation keine gültige Analyse ist.",
        "en": "Recalculate digitally for A = 0.650 and explain why direct extrapolation is not a valid analysis."
      },
      "sourceOperatorScopeContractDe": "BY C11-Tabellenkalkulation, C12/C13 S17 und E8/E11: angemessene Mathematik, digitale Auswertung, quantitative Interpretation und fachübergreifender Hypothesenbezug sind verbindliche Leistungsbedingungen. Ein Einstiegsdiagramm allein belegt diese Leistung nicht; fehlerhafte Messung wird nicht unbesehen als theoretische Falsifizierung ausgegeben."
    },
    {
      "caseKey": "upper-quantitative-hypothesis-data-evaluation-digital-kinetics",
      "candidateKey": "upper-quantitative-hypothesis-data-evaluation",
      "originalFamilyGoalId": "49b13b33-34b7-5e4e-861c-b21082cb9922",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "Isotherme Lehrdaten einer Reaktion: t = 0/10/20/30 min; cA = 0,1000/0,06065/0,03679/0,02231 mol/L. Hypothese: dcA/dt = −k·cA mit konstantem k. Gegeben integrierte Gleichung ln(cA/cA0) = −kt. Datei soll Rohdaten erhalten; relative Logarithmen sind dimensionslos.",
        "en": "Isothermal teaching data for a reaction: t = 0/10/20/30 min; cA = 0.1000/0.06065/0.03679/0.02231 mol/L. Hypothesis: dcA/dt = −k·cA with constant k. Given integrated relation ln(cA/cA0) = −kt. The file must retain raw data; relative logarithms are dimensionless."
      },
      "learnerTask": {
        "de": "Wähle und erzeuge eine digitale quantitative Auswertung, prüfe die Hypothese über eine geeignete Linearisierung und Residuen, interpretiere k und Halbwertszeit und benenne Gültigkeitsbedingungen.",
        "en": "Choose and create a digital quantitative evaluation, test the hypothesis using appropriate linearisation and residuals, interpret k and half-life and state validity conditions."
      },
      "expectedAnswer": {
        "de": "LN(c/c0) ergibt ungefähr 0/−0,500/−1,000/−1,500; Regression gegen t liefert k ≈ 0,0500 min⁻¹, t1/2 = ln2/k ≈ 13,86 min. In der Tabellenkalkulation LN(B2/$B$2), Regression und Residuenformel verwenden; gerundete Eingangsdaten erzeugen kleine Residuen. Die Daten sind konsistent mit erster Ordnung unter isothermen Bedingungen, beweisen keine einzigartige Reaktionsmechanik. Eine krumme c-t-Kurve allein widerlegt erste Ordnung gerade nicht.",
        "en": "LN(c/c0) gives approximately 0/−0.500/−1.000/−1.500; regression against t yields k ≈ 0.0500 min⁻¹, t1/2 = ln2/k ≈ 13.86 min. Use spreadsheet LN(B2/$B$2), regression and a residual formula; rounded inputs generate small residuals. Data are consistent with first order under isothermal conditions, not proof of a unique reaction mechanism. A curved c-t graph alone does not refute first order."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "upper-quantitative-hypothesis-data-evaluation-digital-kinetics-C1",
          "meaning": {
            "de": "Tatsächliche digitale Datei enthält Rohdaten, dimensionslose Log-Werte, Fit und Residuen.",
            "en": "An actual digital file contains raw data, dimensionless log values, fit and residuals."
          }
        },
        {
          "criterionKey": "upper-quantitative-hypothesis-data-evaluation-digital-kinetics-C2",
          "meaning": {
            "de": "Verfahren wird aus Kinetik und Mathematik begründet; k/Einheit und Halbwertszeit sind richtig.",
            "en": "Method is justified from kinetics and mathematics; k/unit and half-life are correct."
          }
        },
        {
          "criterionKey": "upper-quantitative-hypothesis-data-evaluation-digital-kinetics-C3",
          "meaning": {
            "de": "Hypothese und Reichweite werden mit Bedingungen und Residuen beurteilt.",
            "en": "Hypothesis and scope are assessed using conditions and residuals."
          }
        }
      ],
      "transfer": {
        "de": "Ersetze den 20-min-Wert durch 0,0500 mol/L; untersuche Residuum und mögliche Mess-/Temperaturfehler, bevor du das Modell verlässlich verwirfst.",
        "en": "Replace the 20-min value with 0.0500 mol/L; inspect the residual and possible measurement/temperature errors before reliably rejecting the model."
      },
      "sourceOperatorScopeContractDe": "BY C11-Tabellenkalkulation, C12/C13 S17 und E8/E11: angemessene Mathematik, digitale Auswertung, quantitative Interpretation und fachübergreifender Hypothesenbezug sind verbindliche Leistungsbedingungen. Ein Einstiegsdiagramm allein belegt diese Leistung nicht; fehlerhafte Messung wird nicht unbesehen als theoretische Falsifizierung ausgegeben."
    },
    {
      "caseKey": "foreign-inquiry-process-and-reach-metal-displacement",
      "candidateKey": "foreign-inquiry-process-and-reach",
      "originalFamilyGoalId": "f660c91a-fa14-5010-94cf-068d785c7fd2",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "Fiktives Archiv F1: Frage „Ändert ein Eisennagel eine Kupferionenlösung?“ Methode: neuer gereinigter Nagel, blau gefärbte bekannte Cu²⁺-Lösung, Parallelbecher ohne Nagel, gleiche Temperatur; Bericht: rötlicher Belag am Nagel, geringere Blaufärbung nach 30 min, Blindvergleich unverändert. Archivdeutung: Elektronenübertragung Fe → Fe²⁺, Cu²⁺ → Cu. Konzentrationen und Belaganalyse fehlen; kein eigener Versuch verlangt.",
        "en": "Fictional archive F1: Question “Does an iron nail change a copper-ion solution?” Method: fresh cleaned nail, blue known Cu²⁺ solution, parallel beaker without nail, equal temperature; report: reddish coating on nail, weaker blue colour after 30 min, blank comparison unchanged. Archive interpretation: electron transfer Fe → Fe²⁺, Cu²⁺ → Cu. Concentrations and coating analysis are missing; no own experiment is requested."
      },
      "learnerTask": {
        "de": "Erkläre den fremden Erkenntnisweg und die Rolle der Kontrolle. Welche Aussagen sind chemisch begründet und welche bleiben offen? Trenne beobachtete Farbänderung von Modellinterpretation.",
        "en": "Explain the external inquiry process and role of the control. Which statements are chemically justified and which remain open? Separate observed colour change from model interpretation."
      },
      "expectedAnswer": {
        "de": "Frage führt zum Stoffvergleich mit/ohne Eisen; Beobachtungen sprechen für eine Veränderung durch Eisen. Redoxgleichung Fe + Cu²⁺ → Fe²⁺ + Cu ist eine passende Deutung unter bekannten Stoffbedingungen, Belagfarbe allein identifiziert das Produkt nicht abschließend. Ohne quantitative Daten ist keine vollständige Umsatzbilanz möglich; keine eigene Durchführung oder allgemeine Umweltbewertung nachgewiesen.",
        "en": "The question leads to comparison with/without iron; observations suggest iron causes a change. Fe + Cu²⁺ → Fe²⁺ + Cu is a suitable interpretation under known substance conditions, but coating colour alone does not finally identify the product. Without quantitative data a complete conversion balance is impossible; neither own execution nor general environmental evaluation is established."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "foreign-inquiry-process-and-reach-metal-displacement-C1",
          "meaning": {
            "de": "Frage, Methode, Beobachtung und Interpretation werden als zusammenhängender Weg erläutert.",
            "en": "Question, method, observation and interpretation are explained as a connected process."
          }
        },
        {
          "criterionKey": "foreign-inquiry-process-and-reach-metal-displacement-C2",
          "meaning": {
            "de": "Kontrolle und offene Identifikations-/Mengenfragen werden begründet.",
            "en": "Control and unresolved identification/amount questions are justified."
          }
        },
        {
          "criterionKey": "foreign-inquiry-process-and-reach-metal-displacement-C3",
          "meaning": {
            "de": "Fremdprozess wird nicht als eigene Untersuchung ausgegeben.",
            "en": "External inquiry is not presented as own investigation."
          }
        }
      ],
      "transfer": {
        "de": "Welche zusätzliche Analyse würde die Produktzuordnung stärken, ohne aus ihr eine gesellschaftliche Risikoentscheidung abzuleiten?",
        "en": "What additional analysis would strengthen product identification without turning it into a societal risk decision?"
      },
      "sourceOperatorScopeContractDe": "Vorgegebene oder historische Erkenntniswege können ohne eigene Durchführung analysiert werden. Die Reichweite der Erkenntnisgewinnung bleibt prüfbar. Dieser Abschluss behauptet keine Reflexion einer eigenen Untersuchung und keine vollständige E12-Kriterienleistung."
    },
    {
      "caseKey": "foreign-inquiry-process-and-reach-gas-identity",
      "candidateKey": "foreign-inquiry-process-and-reach",
      "originalFamilyGoalId": "f660c91a-fa14-5010-94cf-068d785c7fd2",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "Fiktives Archiv F2: Forscher vergleichen Gasentwicklung nach Zugabe bekannter verdünnter Säure zu Kalkstücken und zu Glasperlen. Nur Kalk zeigt Blasen; das abgeführte Gas trübt eine freigegebene Kalkwasserprobe. Archiv nennt CO₂; Angaben zu Gasreinheit, Säuremenge und vollständigem Umsatz fehlen. Daten dienen ausschließlich der Analyse eines fremden Erkenntniswegs.",
        "en": "Fictional archive F2: Researchers compare gas evolution after adding known dilute acid to limestone and glass beads. Only limestone bubbles; collected gas clouds an authorised limewater sample. Archive names CO₂; gas purity, acid amount and complete conversion are unspecified. Data solely analyse an external inquiry process."
      },
      "learnerTask": {
        "de": "Rekonstruiere Frage, Vergleichsversuch, Nachweisindiz und Schluss. Erläutere chemisch beantwortbare Fragen und zwei Grenzen; führe den Versuch nicht eigenmächtig aus.",
        "en": "Reconstruct question, comparison experiment, identification indication and conclusion. Explain chemically answerable questions and two limits; do not independently perform the experiment."
      },
      "expectedAnswer": {
        "de": "Vergleich fragt nach säureabhängiger Reaktion des Carbonats; Glas kontrolliert unspezifische Zugabeeffekte. Blasen zeigen Gasentwicklung, Kalkwassertrübung passt zu CO₂ unter bekannten Reaktionsbedingungen. Keine Menge, Reinheit oder vollständige Stoffbilanz folgt daraus. Chemie kann Gasbildung/Identität weiter untersuchen, aber nicht allein die gesellschaftliche Akzeptanz eines Abbauvorhabens entscheiden.",
        "en": "The comparison asks about acid-induced carbonate reaction; glass controls non-specific addition effects. Bubbles show gas evolution, limewater clouding is consistent with CO₂ under known reaction conditions. Amount, purity and full material balance do not follow. Chemistry can further investigate gas formation/identity but cannot alone decide societal acceptance of a quarry project."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "foreign-inquiry-process-and-reach-gas-identity-C1",
          "meaning": {
            "de": "Beobachtung und Schluss werden mit geeignetem Vergleich verknüpft.",
            "en": "Observation and conclusion are linked through a suitable comparison."
          }
        },
        {
          "criterionKey": "foreign-inquiry-process-and-reach-gas-identity-C2",
          "meaning": {
            "de": "Chemische Reichweite und Unsicherheiten sind konkret.",
            "en": "Chemical scope and uncertainties are specific."
          }
        },
        {
          "criterionKey": "foreign-inquiry-process-and-reach-gas-identity-C3",
          "meaning": {
            "de": "Keine eigene praktische Leistung oder vollständige Nachweissicherheit wird behauptet.",
            "en": "Neither own practical performance nor complete identification certainty is claimed."
          }
        }
      ],
      "transfer": {
        "de": "Wie verändert eine positive Glas-Kontrolle die Deutung? Begründe eine Prüfung auf Verunreinigung.",
        "en": "How does a positive glass control change interpretation? Justify a contamination check."
      },
      "sourceOperatorScopeContractDe": "Vorgegebene oder historische Erkenntniswege können ohne eigene Durchführung analysiert werden. Die Reichweite der Erkenntnisgewinnung bleibt prüfbar. Dieser Abschluss behauptet keine Reflexion einer eigenen Untersuchung und keine vollständige E12-Kriterienleistung."
    },
    {
      "caseKey": "own-inquiry-process-reflection-own-guided-sugar",
      "candidateKey": "own-inquiry-process-reflection",
      "originalFamilyGoalId": "f660c91a-fa14-5010-94cf-068d785c7fd2",
      "materialOrigin": "SkillPilot-authored teaching scenario; numbers are supplied model/reference data, not learner measurements",
      "suppliedMaterial": {
        "de": "Eigener tatsächlich durchgeführter Zucker-Temperaturversuch aus dem angegebenen Fall. Erforderlich: dein unverändertes Rohprotokoll, beobachteter Handlungslog und Freigabe; noch keine eigenen Werte in diesem Paket.",
        "en": "Your own actually performed sugar/temperature experiment from the named case. Required: unchanged own raw log, observed action log and authorisation; this package contains no own learner values."
      },
      "learnerTask": {
        "de": "Beziehe deine echten Ergebnisse auf deine Ausgangsfrage/Hypothese. Begründe die angewandten Methoden, identifiziere Unsicherheiten und leite zwei konkrete weitere Verbesserungen ab. Kennzeichne vorgegebene Schritte als vorgegeben; ohne eigenen Ausführungslog bleibt die Leistung offen.",
        "en": "Relate your actual results to your initial question/hypothesis. Justify methods used, identify uncertainties and derive two specific further improvements. Identify supplied steps as supplied; without own execution log the performance remains open."
      },
      "expectedAnswer": {
        "de": "Zuckerfall: Gleiches Rühren und Temperaturvergleich prüfen Auflösezeit; eigener Zeitpunkt-Endpunkt und Temperaturdrift begrenzen. Verbesserungen: Endpunkt vorab operationalisieren/filmen und Temperatur eng halten. Ionenfall: Blind-/Salz-/Zuckervergleich plus Reihe prüfen Ionenwirkung und Konzentration; Temperaturdrift/Verschleppung begrenzen; Verbesserungen: frische gespülte Sonde, randomisierte Reihenfolge und gleiche Temperatur. In beiden Fällen müssen Aussagen wirklich zu den eigenen Rohwerten passen; unerwartete Daten werden nicht ersetzt. Die angeleitete eigene Durchführung zählt als eigene Untersuchung, ohne eigene Planung vorzutäuschen.",
        "en": "Sugar case: equal stirring and temperature comparison test dissolution time; own endpoint timing and temperature drift limit results. Improvements: define/film the endpoint beforehand and tightly control temperature. Ion case: blank/salt/sugar comparison plus series test ion effect and concentration; temperature drift/carryover limit results; improvements: clean rinsed probe, randomised order and equal temperature. In either case statements must genuinely match own raw values; unexpected data are not replaced. Own guided execution counts as own investigation without pretending own planning."
      },
      "requiredAssessmentCriteria": [
        {
          "criterionKey": "own-inquiry-process-reflection-own-guided-sugar-C1",
          "meaning": {
            "de": "Eigener tatsächlich ausgeführter Vorfall ist durch Roh-/Handlungslog gebunden.",
            "en": "Own actually performed preceding case is bound through raw/action log."
          }
        },
        {
          "criterionKey": "own-inquiry-process-reflection-own-guided-sugar-C2",
          "meaning": {
            "de": "Ergebnisse werden konkret mit eigener Frage/Hypothese verbunden.",
            "en": "Results are specifically connected with own question/hypothesis."
          }
        },
        {
          "criterionKey": "own-inquiry-process-reflection-own-guided-sugar-C3",
          "meaning": {
            "de": "Angewandte Methoden, Grenzen und begründete Verbesserungen folgen aus dem eigenen Fall.",
            "en": "Methods used, limits and justified improvements follow from own case."
          }
        },
        {
          "criterionKey": "own-inquiry-process-reflection-own-guided-sugar-C4",
          "meaning": {
            "de": "Vorgegebene versus selbst geplante Schritte werden wahrheitsgemäß unterschieden.",
            "en": "Supplied versus independently planned steps are honestly distinguished."
          }
        }
      ],
      "transfer": {
        "de": "Wähle anhand deiner tatsächlichen Abweichung eine neue Untersuchung, die eine verbleibende Unsicherheit gezielt reduziert.",
        "en": "Choose a new investigation based on your actual deviation that specifically reduces a remaining uncertainty."
      },
      "sourceOperatorScopeContractDe": "Die eigene Untersuchung ist eine verbindliche Eingangsbedingung für diese Reflexionsleistung; ein fertiger Fremdfall schließt sie nicht. Die Reflexion der Untersuchung ist vom getrennten SekII-Abschluss zu Reproduzierbarkeit/Falsifizierbarkeit/Intersubjektivität/Konsistenz/Vorläufigkeit abgegrenzt. Eine selbst durchgeführte angeleitete Untersuchung ist als eigene Untersuchung zulässig. Eigene Durchführung und Reflexion bleiben verbindlich; die selbstständige Versuchsplanung ist nur in der dafür verpflichtenden Quellen-/Fallbindung erforderlich. Bei einer angeleiteten eigenen Durchführung wird die Anwendung der vorgegebenen Verfahren begründet; nicht selbst getroffene Planungsentscheidungen werden nicht als eigene behauptet."
    },

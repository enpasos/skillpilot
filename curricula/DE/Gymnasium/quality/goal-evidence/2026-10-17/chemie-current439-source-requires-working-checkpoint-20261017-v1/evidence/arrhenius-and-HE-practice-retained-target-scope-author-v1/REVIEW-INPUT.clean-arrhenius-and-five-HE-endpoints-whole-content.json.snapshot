        {
          "physicalPageOneBased": 25,
          "wholeLiteralLayoutText": "HMKB                                                                 Kerncurriculum\nChemie                                                        gymnasiale Oberstufe\n\n\nE 11 ◼ stellen bei der Interpretation von Untersuchungsbefunden fachübergreifende Be­\n       züge her.\n\n\n\n\n                                                                                        25\n",
          "ownPageExtractionPin": {
            "path": "/mnt/e/skillpilot-chemie-L7-20261017/arrhenius-and-HE-practice-retained-target-scope-author-v1/DE-HE-physical-25.whole.layout.txt",

      "wholeRelevantRequiresClosure": [
        {
          "wholeGoal": {
            "id": "04fa0ba1-eb6e-53c8-93d4-dfa28bb4b162",
            "title": "Redoxbegriffe sicher anwenden",
            "titleEn": "Apply redox terms confidently",

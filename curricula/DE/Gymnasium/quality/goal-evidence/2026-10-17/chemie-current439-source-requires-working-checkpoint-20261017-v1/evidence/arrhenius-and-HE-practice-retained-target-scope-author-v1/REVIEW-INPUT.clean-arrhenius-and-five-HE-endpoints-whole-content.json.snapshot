            "extendedData": {
              "applicabilityMappingInheritance": "boundary",
              "provenance": {
                "splitFromCanonicalGoalId": "53fd1bfd-facb-54ae-b2dc-f667ed1414fc",
                "authorCandidatePackage": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/chemie-b007-two-current206-targeted-author-successor-20261010-v1",

        "examData": {
          "reviewStatus": "released",
          "reviewNote": "Machine-only task content readiness after two actual independent whole DE/EN task, solution, rubric and current native-context KEEP reviews. The immutable author source is retained. This does not establish human approval, classroom trial or actual learner execution. Actual verifiable supervised execution remains indispensable to the 10/10 pass.",
          "coveredGoalIds": [

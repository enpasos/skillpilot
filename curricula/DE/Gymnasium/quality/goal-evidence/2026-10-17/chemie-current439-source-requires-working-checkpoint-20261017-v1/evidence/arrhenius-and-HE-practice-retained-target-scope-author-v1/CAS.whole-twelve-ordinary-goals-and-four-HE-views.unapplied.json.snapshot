              {
                "path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/chemie-q3-three-BW-practical-terminal-native-independent-a-20261010-v1/FIRST.whole-three-tasks-and-current-native.verdict.json",
                "sha256": "sha256:144aa361bdfea99d5c1f9918fc4f13a8052049961b2baed6781239da2696818f",

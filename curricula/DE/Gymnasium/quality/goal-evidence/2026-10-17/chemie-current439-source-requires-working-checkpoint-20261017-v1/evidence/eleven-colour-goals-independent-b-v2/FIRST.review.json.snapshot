  "separate188OneDEFieldDecision": {
    "decision": "KEEP",
    "changedLeaf": "/applicationCaseBriefs/1/taskDemandDe",
    "beforeWholeDigest": "ebb2d0feef13902cb14085e4ce410f2a7376d91fd654bfb8544afead51ec4838",
    "afterWholeDigest": "39aca87b8c3591fa0f76d74c4f398f98e0c868966a977de1eb0687b8e138f1e9",
    "reasonDe": "Marktanteil ist nicht Umsatzanteil einer Sparte am Firmenumsatz. V2nennt dieseBezugsgröße und konstanten Gesamtumsatz eindeutig; die Frage vermeidet nur den falschen Schluss auf den Gesamtumsatz und verbietet keinen zutreffenden Rückgang der Sparte. AlleanderenDE/ENFelder,Fälle,Zahlen,Erwartungen,Transfers exakt erhalten. BeiGesamtumsatzT fälltFarbstoffumsatz von0.70T auf0.35T:−35Prozentpunkte Anteil,−50Prozent Spartenumsatz; andereSparten+0.35T."
  },
  "sourceBoundaries": [

      "externalPrerequisites": [],
      "externalReverseRequires": [
        {
          "goalId": "8b2d351e-e44f-5385-9b89-13ef54b5918f",
          "title": "Temperaturabhängige Löslichkeit und Kristallbildung untersuchen",
          "canonicalUrl": "https://skillpilot.com/lernzielbuch?landscape=c436b994-8f44-5134-b9f8-0c9f5d6a5ba0&edition=curricular-atomic-v1#goal-8b2d351e-e44f-5385-9b89-13ef54b5918f"
        }
      ],
      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Löslichkeit und Sättigung aus Daten erklären",
        "url": "/assets/goal-visualizations/chemie/413040cd-ba74-5227-948c-a778b0bd0f56/413040cd-ba74-5227-948c-a778b0bd0f56.png",
        "altText": "Bei 20 Grad Celsius zeigen zwei Gefäße denselben Stoff und dieselbe Lösungsmittelmenge. Links kann sich noch Stoff lösen; rechts bleibt bei Sättigung ein ungelöster Feststoffrest am Boden. Die Flüssigkeit darüber ist in beiden Fällen homogen.",
        "originalDigest": "sha256:12ef7e530ae7d42c09907db1f9b32e62c8b6fe20f7980a883e9d6e865a1ffd3d",
        "qaStatus": "review_candidate",
        "approvedForPublication": false
      }
    },
    "profile": {
      "archetype": "data",
      "expectations": [
        {
          "id": "understanding",
          "essentialUnderstandingDe": "Die Löslichkeitsgrenze gilt für eine bestimmte Stoffkombination und Temperatur. Sättigung kann auch ohne sichtbaren Bodensatz vorliegen; Rühren verändert nicht automatisch die Gleichgewichtsgrenze.",
          "essentialUnderstandingEn": "A solubility limit applies to a specified substance pair and temperature. Saturation can occur without visible residue; stirring does not automatically change the equilibrium limit.",
          "observablePerformanceDe": "Die lernende Person bestimmt aus der vorgegebenen Löslichkeit die Kapazität der jeweiligen Wassermenge, trennt gelöste Masse und Bodensatz und begründet ungesättigt beziehungsweise gesättigt einschließlich des klaren Grenzfalls. Sie bilanziert die zusätzliche Wassermenge, statt weitere Löslichkeit allein aus längerem Rühren oder aus einer Temperaturänderung ohne neue Daten zu behaupten.",
          "observablePerformanceEn": "The learner derives capacity for the given water mass from the supplied solubility, distinguishes dissolved mass from residue and justifies unsaturated or saturated states including the clear limiting case. They balance additional water rather than claiming more solubility from stirring longer or from a temperature change without new data."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "understanding"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "changed-conditions",
          "textDe": "Bei 20 °C wurden nur 20,0 g U in 80,0 g Wasser gegeben. Ein Mitschüler behauptet: „Dieser Stoff macht immer Bodensatz.“ Begründe den neuen Fall.",
          "textEn": "At 20 °C only 20.0 g U was added to 80.0 g water. A classmate claims “This substance always leaves residue.” Explain the new case."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "solubility-clear-saturated-countercase",
          "taskDemandDe": "Bestimme für A und B die maximal lösbare Menge, begründe gesättigt/ungesättigt und berechne die zusätzlich lösbare Menge T. Beurteile „Ohne Bodensatz ist jede Lösung ungesättigt“.",
          "taskDemandEn": "Determine the maximum dissolvable amount for A and B, justify saturated/unsaturated and calculate how much more T can dissolve. Assess “Every solution without residue is unsaturated.”",
          "expectedPerformanceDe": "Für 40,0 g Wasser beträgt die Grenze 24,0 × 40,0/100,0 = 9,6 g T. A ist ungesättigt: noch 9,6 − 7,2 = 2,4 g können sich lösen. B ist bereits an der Grenze und damit gesättigt; zusätzlich 0 g. Dass B klar und ohne Bodensatz ist, ändert die Grenzmenge nicht. Die Behauptung ist falsch.",
          "expectedPerformanceEn": "For 40.0 g water the limit is 24.0 × 40.0/100.0 = 9.6 g T. A is unsaturated: another 9.6 − 7.2 = 2.4 g can dissolve. B is at the limit and saturated; another 0 g can dissolve. Its clear appearance without residue does not change the limiting amount. The claim is false.",
          "understandingFocusDe": "Die Löslichkeitsgrenze gilt für eine bestimmte Stoffkombination und Temperatur. Sättigung kann auch ohne sichtbaren Bodensatz vorliegen; Rühren verändert nicht automatisch die Gleichgewichtsgrenze.",
          "understandingFocusEn": "A solubility limit applies to a specified substance pair and temperature. Saturation can occur without visible residue; stirring does not automatically change the equilibrium limit."
        },
        {
          "id": "solubility-residue-water-and-temperature",
          "taskDemandDe": "Bestimme zunächst gelöste Menge, Rest und Sättigung. Kann bloß längeres Rühren den Rest unter denselben Gleichgewichtsbedingungen vollständig lösen? Bestimme dann den Zustand nach Änderung A. Nenne für B die fehlende entscheidende Angabe.",
          "taskDemandEn": "First determine dissolved amount, residue and saturation. Can simply stirring longer dissolve all residue under the same equilibrium conditions? Then determine the state after A and name the decisive missing value for B.",
          "expectedPerformanceDe": "Zunächst sind maximal 30,0 × 80,0/100,0 = 24,0 g gelöst; 32,0 − 24,0 = 8,0 g bleiben als Rest. Die Flüssigkeitsphase ist gesättigt. Noch mehr Rühren ändert unter den ausdrücklich bereits erreichten Gleichgewichtsbedingungen die Grenze nicht. Nach A: 120,0 g Wasser, Grenze 36,0 g; alle 32,0 g lösen sich, 4,0 g zusätzliche Kapazität, ungesättigt. Für B brauche ich die Löslichkeit bei 40 °C; ich darf die 20-°C-Grenze weder unverändert übernehmen noch eine bestimmte Zunahme erraten.",
          "expectedPerformanceEn": "Initially at most 30.0 × 80.0/100.0 = 24.0 g is dissolved; 32.0 − 24.0 = 8.0 g remains. The liquid phase is saturated. More stirring does not change the limit under explicitly attained equilibrium conditions. After A: 120.0 g water, limit 36.0 g; all 32.0 g dissolves, with 4.0 g further capacity, so unsaturated. B requires solubility at 40 °C; I may neither reuse the 20 °C limit unchanged nor guess a particular increase.",
          "understandingFocusDe": "Die Löslichkeitsgrenze gilt für eine bestimmte Stoffkombination und Temperatur. Sättigung kann auch ohne sichtbaren Bodensatz vorliegen; Rühren verändert nicht automatisch die Gleichgewichtsgrenze.",
          "understandingFocusEn": "A solubility limit applies to a specified substance pair and temperature. Saturation can occur without visible residue; stirring does not automatically change the equilibrium limit."
        }
      ]
    }
  },
  {
    "index": 2,
    "goalId": "a25a19ed-aec3-59cc-ae28-31d98746cb9d",
    "titleDe": "Ethanolwirkungen im Körper und Alltagsrisiken einordnen",
    "titleEn": "Interpret bodily effects of ethanol and everyday risks",
    "descriptionDe": "Die lernende Person kann anhand bereitgestellter Informationen Wirkungen von Ethanol im menschlichen Körper und seinen schrittweisen oxidativen Abbau erläutern und daraus Gesundheits- und Sicherheitsrisiken einer konkreten Alltagssituation fachlich begründet beurteilen.",
    "descriptionEn": "The learner can use supplied information to explain effects of ethanol in the human body and its stepwise oxidative metabolism, and use this to give a scientifically reasoned assessment of health and safety risks in a concrete everyday situation.",

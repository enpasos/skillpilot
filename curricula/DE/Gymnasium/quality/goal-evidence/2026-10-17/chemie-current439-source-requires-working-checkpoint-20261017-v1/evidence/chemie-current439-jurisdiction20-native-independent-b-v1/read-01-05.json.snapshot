      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Herstellung und Struktur von Silikonen für Polymervergleiche erklären",
        "url": "/assets/goal-visualizations/chemie/a96e9b3d-a02d-54f8-a3d3-318e0ea5180c/a96e9b3d-a02d-54f8-a3d3-318e0ea5180c.png",
        "altText": "Zwei Dimethylsilandiolmoleküle kondensieren zu einem endgruppenrichtigen Disiloxan und Wasser. Darunter zeigen drei schematische Felder freie Silikonölketten, ein vernetztes Elastomer beim Dehnen und einen Wassertropfen an methylhaltigen Oberflächengruppen.",
        "originalDigest": "sha256:f5f699a9e679ab9437dcdfbb09f6c3ee93932ce1f051e44004f11d0be68860dd",
        "qaStatus": "review_candidate",
        "approvedForPublication": false
      }
    },
    "profile": {
      "archetype": "modeling",
      "expectations": [
        {
          "id": "e1",
          "essentialUnderstandingDe": "Silanol-Kondensation erklärt das Siloxanrückgrat; endliche Ketten haben passende Endgruppen und eine bilanzierte Wasserabgabe.",
          "essentialUnderstandingEn": "Silanol condensation accounts for the siloxane backbone; finite chains retain correct end groups and a balanced water release.",
          "observablePerformanceDe": "Beschreibt und bilanziert eine vorgegebene endliche Kette, prüft Si/O-Valenzen.",
          "observablePerformanceEn": "Describes and balances a supplied finite chain and checks Si/O valences."
        },
        {
          "id": "e2",
          "essentialUnderstandingDe": "Silikonrückgrat, organische Seitengruppen und kohlenstoffbasiertes Vergleichsrückgrat sind unterscheidbare Bauprinzipien.",
          "essentialUnderstandingEn": "Silicone backbone, organic side groups and a carbon-based comparison backbone are distinct building principles.",
          "observablePerformanceDe": "Vergleicht PDMS-Si–O/Methyl mit einem gegebenen PE-C–C-Modell, ohne Silikon mit Silicium gleichzusetzen. Vergleicht zusätzlich die bereitgestellten Eigenschaftsbeobachtungen von rückstellendem vernetztem PDMS und bleibend verformtem PE bei gleichen Bedingungen; leitet keine universelle Eigenschaft allein aus der Rückgratbezeichnung ab.",
          "observablePerformanceEn": "Compares PDMS Si–O/methyl against supplied PE C–C without equating silicone and silicon. Also compares supplied property observations of recovering crosslinked PDMS and permanently deformed PE under equal conditions; infers no universal property solely from the backbone label."
        },
        {
          "id": "e3",
          "essentialUnderstandingDe": "Lineare Ketten und kovalente Netzwerke erklären unterschiedliche Eigenschaftsprofile; der Werkstoffvergleich bleibt an Struktur und Bedingung gebunden.",
          "essentialUnderstandingEn": "Linear chains and covalent networks explain different property profiles; material comparison remains structure/condition-bound.",
          "observablePerformanceDe": "Erklärt Öl/Rückstellung und begründet die Werkstoffwahl bei geänderter Vernetzung statt eine universelle Polymer-Rangfolge zu behaupten.",
          "observablePerformanceEn": "Explains oil/recovery and justifies material choice after changed crosslinking instead of asserting a universal polymer ranking."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "e1",
          "e2",
          "e3"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "v1",
          "textDe": "Endliche Kettenlänge und Wasserbilanz",
          "textEn": "Finite chain length and water balance"
        },
        {
          "id": "v2",
          "textDe": "Lineares gegenüber vernetztem Material",
          "textEn": "Linear versus crosslinked material"
        },
        {
          "id": "v3",
          "textDe": "Werkstoffanforderung und Datengrenze",
          "textEn": "Material requirement and data limit"
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "e560-formation-case-1",
          "taskDemandDe": "1. Beschreibe die Silanol-Kondensation durch eine vollständige Formel des Trimers samt Wasser und prüfe die Si/O-Valenzen. 2. Vergleiche Siloxanrückgrat und organische Seitengruppen mit dem PE-Modell. 3. Erkläre Öl gegenüber Elastomer anhand der Vernetzung und begründe unter den gegebenen Bedingungen eine Dichtungsauswahl. Was ändert sich, wenn dieselbe PDMS-Kette zunächst nicht vernetzt ist?",
          "taskDemandEn": "1. Describe silanol condensation using a complete trimer formula including water and check Si/O valences. 2. Compare the siloxane backbone and organic side groups with the PE model. 3. Explain oil versus elastomer through crosslinking and justify a seal choice under the supplied conditions. What changes if the same PDMS chain is initially uncrosslinked?",
          "expectedPerformanceDe": "3 HO–Si(CH₃)₂–OH → HO–Si(CH₃)₂–O–Si(CH₃)₂–O–Si(CH₃)₂–OH + 2 H₂O. Jedes Si trägt vier Einfachbindungen; Brücken-O zwei, terminaler OH-Sauerstoff Si und H. Das Si–O-Rückgrat mit Methylgruppen unterscheidet sich vom C–C-Rückgrat des PE-Modells. Gleiche Methylgruppen beweisen kein gleiches Rückgrat. Nicht vernetzte Ketten können gegeneinander gleiten; kovalente Netzpunkte begrenzen das Gleiten und ermöglichen im gegebenen Elastomer Rückstellung. Daher ist für die geforderte Formstabilität das gegebene vernetzte PDMS geeignet, das Öl nicht. Vernetzung verändert Verhalten bei derselben Polymerchemie; daraus folgt keine pauschale Überlegenheit aller Silikone gegenüber allen kohlenstoffbasierten Polymeren.",
          "expectedPerformanceEn": "3 HO–Si(CH₃)₂–OH → HO–Si(CH₃)₂–O–Si(CH₃)₂–O–Si(CH₃)₂–OH + 2 H₂O. Each Si has four single bonds; bridge O has two, terminal OH oxygen bonds to Si and H. The Si–O backbone with methyl groups differs from the C–C backbone of supplied PE. Identical methyl groups would not establish an identical backbone. Uncrosslinked chains can slide relative to each other; covalent network points restrict sliding and allow recovery in the supplied elastomer. Thus the given crosslinked PDMS suits the required shape stability, whereas the oil does not. Crosslinking changes behaviour at the same polymer chemistry; this does not prove universal superiority of all silicones over all carbon-based polymers.",
          "understandingFocusDe": "Formuliert endgruppenrichtiges Trimer und zwei H₂O; erklärt Si-Vierbindigkeit und O-Zweibindigkeit. / Vergleicht PDMS-Si–O mit Methylgruppen ausdrücklich mit PE-C–C und trennt Rückgrat von Seitengruppen. / Erklärt gleitende Ölketten gegenüber kovalenten Netzpunkten und begründet Dichtung/Rückstellung auch beim Wechsel zur unvernetzten Variante.",
          "understandingFocusEn": "Gives correctly terminated trimer and two H₂O; explains four bonds at Si and two at O. / Explicitly compares PDMS Si–O with methyl groups against PE C–C and distinguishes backbone from side groups. / Explains sliding oil chains versus covalent network points and justifies seal/recovery including the change to an uncrosslinked variant."
        },
        {
          "id": "e560-formation-case-2",
          "taskDemandDe": "1. Stelle die vollständige endliche Tetramer-Kondensation samt Wasser auf und erkläre den Unterschied zwischen Rückgratverknüpfung und zusätzlichen Netzpunkten. 2. Vergleiche die Molekülbauprinzipien mit PE und ausdrücklich die beobachteten Eigenschaften unter denselben Prüfbedingungen: rückstellendes vernetztes PDMS gegenüber bleibend verformtem PE. Erkläre, was dieser Fallvergleich zeigt und was die Rückgratbezeichnung allein nicht beweist. 3. Erkläre die geänderte Rückstellung anhand der Netzstruktur. Beurteile: „Das Silikon stellt hier zurück, also ist jedes Silikon für jede Beanspruchung besser als PE.“",
          "taskDemandEn": "1. Write the complete finite tetramer condensation including water and explain backbone linkage versus additional network points. 2. Compare molecular building principles with PE and explicitly compare observed properties under the same testing conditions: recovering crosslinked PDMS versus permanently deformed PE. Explain what this case comparison shows and what the backbone label alone does not establish. 3. Explain changed recovery through network structure. Assess: “This silicone recovers here, so every silicone is better than PE under every type of loading.”",
          "expectedPerformanceDe": "4 HO–Si(CH₃)₂–OH → HO–Si(CH₃)₂–O–Si(CH₃)₂–O–Si(CH₃)₂–O–Si(CH₃)₂–OH + 3 H₂O. Drei neue Si–O–Si-Brücken entstehen in der offenen Kette; End-OH bleiben. Si–O mit organischen Methylgruppen ist nicht das C–C-Rückgrat von PE. Im gegebenen direkten Eigenschaftsvergleich stellt das vernetzte PDMS nach Dehnung zurück, während die PE-Probe unter denselben Prüfbedingungen bleibende Formänderung zeigt. Die Daten belegen diesen Unterschied der beiden konkreten Proben; das C–C-Rückgrat allein wird nicht als Ursache jeder PE-Verformung oder als Beweis eines allgemeinen Eigenschaftsurteils ausgegeben. Zusätzliche kovalente Verbindungen zwischen Ketten sind ein anderes Strukturmerkmal als bloß mehr Kettenlänge. Sie begrenzen im Fall das gegenseitige Gleiten und erklären die Rückstellung. Für diese Beanspruchung kann die vernetzte Probe geeigneter sein; der unvernetzte Ölzustand und fehlende Wärme-/Langzeitdaten verhindern eine allgemeine Rangfolge sämtlicher Silikone und kohlenstoffbasierter Polymere.",
          "expectedPerformanceEn": "4 HO–Si(CH₃)₂–OH → HO–Si(CH₃)₂–O–Si(CH₃)₂–O–Si(CH₃)₂–O–Si(CH₃)₂–OH + 3 H₂O. Three new Si–O–Si bridges form in the open chain; terminal OH groups remain. Si–O with organic methyl groups is not the PE C–C backbone. In the supplied direct property comparison, crosslinked PDMS recovers after extension while the PE specimen shows permanent deformation under the same testing conditions. The data establish this difference between the two particular specimens; the C–C backbone alone is not treated as the cause of every PE deformation or as proof of a general property conclusion. Additional covalent links between chains are distinct from merely greater chain length. They restrict relative sliding in this case and explain recovery. For this loading the crosslinked specimen may be more suitable; uncrosslinked oil and missing heat/long-term data prevent a universal ranking of all silicones and carbon-based polymers.",
          "understandingFocusDe": "Gibt vollständiges Tetramer mit drei H₂O und korrekten Endgruppen/Si–O-Brücken an. / Vergleicht Siloxan-Si–O/Methyl mit PE-C–C und trennt Kettenbildung von zusätzlichen Netzverknüpfungen. Vergleicht außerdem die beobachtete PDMS-Rückstellung ausdrücklich mit bleibender PE-Verformung unter gleichen Prüfbedingungen und begrenzt den Befund auf diese Proben; das Rückgrat allein erklärt nicht jede PE-Eigenschaft. / Erklärt Rückstellung und begrenzt die Werkstoffwahl auf gegebene Struktur, Beanspruchung und tatsächlich vorhandene Daten.",
          "understandingFocusEn": "Gives complete tetramer with three H₂O and correct end groups/Si–O bridges. / Compares siloxane Si–O/methyl with PE C–C and separates chain formation from additional network links. Also explicitly compares observed PDMS recovery with permanent PE deformation under equal testing conditions and bounds the observation to these specimens; the backbone alone does not explain every PE property. / Explains recovery and limits material choice to given structure, loading and available data."
        }
      ]
    }
  },

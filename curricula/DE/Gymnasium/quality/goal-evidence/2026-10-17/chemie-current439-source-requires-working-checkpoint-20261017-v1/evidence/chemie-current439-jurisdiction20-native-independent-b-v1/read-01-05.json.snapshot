    "profile": {
      "archetype": "procedure",
      "expectations": [
        {
          "id": "e1",
          "essentialUnderstandingDe": "Spritzgießen, Tiefziehen, Kalandrieren und Extrudieren unterscheiden Werkzeug, Ausgangsform und kontinuierliche/zyklische Formgebung.",
          "essentialUnderstandingEn": "Injection moulding, thermoforming, calendering and extrusion differ in tooling, starting form and continuous/cyclic shaping.",
          "observablePerformanceDe": "Beschreibt alle vier Wege und ordnet geeignete Produktgeometrien begründet zu.",
          "observablePerformanceEn": "Describes all four routes and assigns suitable product geometries with reasons."
        },
        {
          "id": "e2",
          "essentialUnderstandingDe": "Fließfähigkeit, Dehnbarkeit und thermisches Fenster müssen zur Methode passen.",
          "essentialUnderstandingEn": "Flowability, extensibility and thermal window must suit the method.",
          "observablePerformanceDe": "Begründet Verfahrenswahl anhand gegebener Materialdaten und trennt Umformen von Zersetzung.",
          "observablePerformanceEn": "Justifies process choice using supplied material data and distinguishes shaping from decomposition."
        },
        {
          "id": "e3",
          "essentialUnderstandingDe": "Geänderte Vernetzung oder Produktgeometrie kann eine Verfahrenswahl unbrauchbar machen.",
          "essentialUnderstandingEn": "Changed crosslinking or product geometry can invalidate a process choice.",
          "observablePerformanceDe": "Überträgt die Auswahl auf neues Material oder neue Form und benennt notwendige Prozessprüfung.",
          "observablePerformanceEn": "Transfers selection to a new material or shape and identifies a required process test."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "e1",
          "e2",
          "e3"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,

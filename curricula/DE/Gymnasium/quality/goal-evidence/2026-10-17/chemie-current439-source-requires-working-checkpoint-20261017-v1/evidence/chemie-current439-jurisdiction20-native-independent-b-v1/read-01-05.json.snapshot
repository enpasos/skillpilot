      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Nanoskalige Silikonoberflächen materialgestützt beurteilen",
        "url": "/assets/goal-visualizations/chemie/6413429b-53d8-5ad1-9af6-d0e562cbf0f5/6413429b-53d8-5ad1-9af6-d0e562cbf0f5.png",
        "altText": "Zwei gleich geneigte, orange beschichtete Unterlagen zeigen bei gleicher Silikonchemie einen stärker ausgebreiteten ruhenden Tropfen auf einer glatten Oberfläche und einen kompakteren beweglichen Tropfen auf einer strukturierten Oberfläche. Ein vergrößerter Schichtquerschnitt markiert 40 nm als vertikale Schichtdicke, ausdrücklich keine Partikelgröße. Die Darstellung belegt weder Schmutzentfernung noch dauerhafte Selbstreinigung.",
        "originalDigest": "sha256:241fd5bbbf3a80a1dea330e59fe4e3bf313018af91e4322b478cd0c623b31643",
        "qaStatus": "review_candidate",
        "approvedForPublication": false
      }
    },
    "profile": {
      "archetype": "modeling",
      "expectations": [
        {
          "id": "e1",
          "essentialUnderstandingDe": "Silikone können in nanoskaligen Oberflächenanwendungen relevant sein; Schichtdicke und Partikelgröße sind unterschiedliche Größen.",
          "essentialUnderstandingEn": "Silicones can be relevant in nanoscale surface applications; film thickness and particle size are different dimensions.",
          "observablePerformanceDe": "Erläutert eine materialgestützte Nano-Anwendung und trennt Dicke von separat belegter oder unbelegter Partikelgröße.",
          "observablePerformanceEn": "Explains a material-based nano application and separates thickness from independently evidenced or unsupported particle size."
        },
        {
          "id": "e2",
          "essentialUnderstandingDe": "Benetzung hängt von Silikonchemie und Oberflächenstruktur ab; eine gleiche Dicke allein erklärt keine gleiche Benetzung.",
          "essentialUnderstandingEn": "Wetting depends on silicone chemistry and surface structure; equal thickness alone does not account for equal wetting.",
          "observablePerformanceDe": "Nutzt die Gleichchemie-Strukturvariation und Gleichdicken-Chemiekontrolle; trennt Kontaktwinkel von Abrollwinkel.",
          "observablePerformanceEn": "Uses same-chemistry structural variation and equal-thickness chemistry control; distinguishes contact angle from roll-off angle."
        },
        {
          "id": "e3",
          "essentialUnderstandingDe": "Daten zu Tropfenbewegung stützen begrenzte Funktionsaussagen, beweisen aber keine Schmutzentfernung oder dauerhafte Selbstreinigung.",
          "essentialUnderstandingEn": "Droplet-motion data support bounded functional claims but establish neither dirt removal nor durable self-cleaning.",
          "observablePerformanceDe": "Beurteilt bei geänderter Struktur eine Anwendungsbehauptung und nennt den fehlenden passenden Funktions-/Belastungsnachweis.",
          "observablePerformanceEn": "Assesses an application claim after changed structure and identifies missing relevant functional/loading evidence."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "e1",
          "e2",
          "e3"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "v1",
          "textDe": "Schichtdicke gegenüber unabhängiger Partikelmessung",
          "textEn": "Film thickness versus independent particle measurement"
        },
        {
          "id": "v2",
          "textDe": "Gleiche Chemie, andere Oberflächenstruktur",
          "textEn": "Same chemistry, different surface structure"
        },
        {
          "id": "v3",
          "textDe": "Kontaktwinkel, Abrollen und tatsächlicher Funktionsnachweis",
          "textEn": "Contact angle, roll-off and actual function evidence"
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "e560-nanosurface-case-1",
          "taskDemandDe": "1. Erläutere an diesem Beispiel die Bedeutung von Silikonen für eine nanoskalige Oberflächenanwendung: Welche chemischen und strukturellen Hinweise können Wasserabweisung und bewegliche Tropfen erklären? 2. Vergleiche glatt/nanostrukturiert und die hydrophile Kontrolle. Trägt die Schichtdicke allein das Benetzungsurteil? 3. Prüfe „40 nm Dicke beweist 40 nm Silikonpartikel und eine dauerhaft selbstreinigende Oberfläche“. Begründe, welche Aussagen gestützt sind und welche weitere Beobachtung nötig wäre.",
          "taskDemandEn": "1. Explain silicone relevance for a nanoscale surface application in this example: which chemistry/structure evidence can account for water repellency and mobile drops? 2. Compare smooth/nanostructured surfaces and the hydrophilic control. Does film thickness alone establish wetting behaviour? 3. Evaluate “40 nm thickness proves 40 nm silicone particles and a permanently self-cleaning surface.” Explain supported claims and a needed further observation.",
          "expectedPerformanceDe": "Eine nanoskalige Siloxanschicht kann als funktionale Oberfläche genutzt werden. Organische Methylgruppen sind mit Wasserabweisung vereinbar; bei gleicher Silikonchemie zeigen geänderte Oberflächenstruktur und 105°/35° gegenüber 155°/5°, dass Chemie allein nicht das gesamte Verhalten festlegt. Der kleinere Abrollwinkel unterstützt beweglichere Tropfen unter den gegebenen Bedingungen. Die hydrophile 40-nm-Kontrolle zeigt, dass gleiche Dicke nicht gleiche Benetzung bedeutet. 40 nm ist eine Schichtdimension, kein gemessener Partikeldurchmesser. Bewegliche Tropfen machen die Anwendung für wasserabweisende/gegebenenfalls reinigende Oberflächen interessant, beweisen aber weder tatsächlichen Schmutzabtrag noch Dauerhaftigkeit. Dafür sind passende Beobachtungen zum Schmutzabtrag und zum Verhalten nach Abrieb nötig; Nano bedeutet nicht automatisch mehr Funktion oder Sicherheit.",
          "expectedPerformanceEn": "A nanoscale siloxane film can provide a functional surface. Organic methyl groups are compatible with water repellency; at the same silicone chemistry, changed structure and 105°/35° versus 155°/5° show that chemistry alone does not determine all behaviour. Smaller roll-off angle supports more mobile drops under the stated conditions. The hydrophilic 40-nm control shows that equal thickness does not mean equal wetting. The 40 nm value is a film dimension, not a measured particle diameter. Mobile drops make such surfaces relevant for water-repellent/potentially cleaning applications but establish neither actual dirt removal nor durability. Appropriate dirt-removal observations and behaviour after abrasion are needed; nano does not automatically mean greater function or safety.",
          "understandingFocusDe": "Erklärt Nano-Oberflächenanwendung über Silikonchemie und Struktur; trennt Schichtdicke von fehlendem Partikeldurchmesser. / Interpretiert die kontrollierte Strukturvariation und die hydrophile Gleichdickenkontrolle; Chemie und Struktur tragen getrennte Bezüge. / Leitet beweglichere Tropfen aus dem kleineren Abrollwinkel ab und begrenzt Selbstreinigung/Dauerhaftigkeit wegen fehlendem Schmutz-/Abriebnachweis.",
          "understandingFocusEn": "Explains nanoscale surface application using silicone chemistry and structure; separates film thickness from missing particle diameter. / Interprets controlled structural variation and hydrophilic equal-thickness control; chemistry and structure contribute distinct links. / Uses smaller roll-off angle to infer more mobile drops and limits cleaning/durability claims because dirt/abrasion evidence is missing."
        },
        {
          "id": "e560-nanosurface-case-2",
          "taskDemandDe": "1. Beschreibe die mögliche Bedeutung der Silikonoberfläche für die Anwendung und unterscheide die beiden Größenangaben 80 nm und 45 nm. 2. Erläutere, was aus A/B bei gleicher Chemie über die Wirkung der Struktur folgt. Beurteile „B hat immer noch einen großen Kontaktwinkel, also rollen Tropfen so leicht ab wie bei A“. 3. Prüfe, ob A oder B damit dauerhaft selbstreinigend ist, und gib ein begrenztes Anwendungsurteil mit einer konkret nötigen weiteren Beobachtung.",
          "taskDemandEn": "1. Describe possible silicone-surface relevance for the application and distinguish the 80 nm and 45 nm dimensions. 2. Explain what A/B at the same chemistry show about structural effects. Evaluate “B still has a large contact angle, so drops roll off as easily as in A.” 3. Assess whether A or B is thereby permanently self-cleaning and give a bounded application conclusion with a specific further observation needed.",
          "expectedPerformanceDe": "Die 80 nm betreffen die Schicht; 45 nm ist eine separat ausgewiesene Partikelgröße ausschließlich für C. Ohne die Zusatzangabe dürfte man keine Partikelgröße aus 80 nm ableiten. Silikonchemie und passende Oberflächenstruktur können zur nanoskaligen Funktionalisierung beitragen. A/B haben gleiche Chemie, aber andere Struktur und stark unterschiedliche Abrollwinkel. Ein hoher Kontaktwinkel in B bedeutet nach den Angaben nicht gleich leichte Tropfenbewegung: 40° verlangt deutlich mehr Neigung als 5°. Die hydrophile Gleichdickenkontrolle verhindert eine Erklärung allein aus der Dicke. A erscheint für bewegliche Tropfen unter den gegebenen Bedingungen günstiger; echter Schmutztransport, Abrieb- oder Langzeitbeständigkeit bleiben unbelegt. Eine Beobachtung des Schmutzabtrags vor/nach Belastung würde die funktionale Anwendung prüfen. Das Urteil ist daten- und zustandsgebunden, keine Behauptung über alle Silikonprodukte.",
          "expectedPerformanceEn": "The 80 nm refers to the film; 45 nm is separately stated particle size only for C. Without that extra information, particle size could not be inferred from 80 nm. Silicone chemistry and suitable surface structure can contribute to nanoscale functionalization. A/B have the same chemistry but different structure and very different roll-off angles. High contact angle in B does not mean equally easy droplet movement: 40° requires much greater tilt than 5°. The hydrophilic equal-thickness control prevents a thickness-only explanation. A appears better for mobile drops under the supplied conditions; actual dirt transport, abrasion resistance or long-term stability remain unsupported. Observing dirt removal before/after loading would test the functional application. The conclusion is data/state-bound, not a statement about every silicone product.",
          "understandingFocusDe": "Verbindet Silikon-Oberflächenfunktion mit Materialdaten und unterscheidet 80-nm-Schicht von separat gemessenen 45-nm-Partikeln in C. / Erklärt bei gleicher Chemie die Strukturänderung und trennt hohen Kontaktwinkel von leichtem Abrollen anhand 150°/40° gegenüber 155°/5°. / Begründet ein zustandsgebundenes Anwendungsurteil und benennt fehlenden Schmutzabtrag/Belastungsnachweis statt Nano-Selbstreinigung vorauszusetzen.",
          "understandingFocusEn": "Connects silicone surface function to material data and separates 80-nm film from independently measured 45-nm particles in C. / Explains structural change at constant chemistry and distinguishes high contact angle from easy rolling using 150°/40° versus 155°/5°. / Justifies a state-bound application conclusion and identifies missing dirt-removal/loading evidence rather than assuming nano self-cleaning."
        }
      ]
    }
  },
  {
    "index": 5,
    "goalId": "6eba90b5-d4a6-5625-be61-e7f30f7eb964",
    "titleDe": "Kunststoff-Verarbeitungsverfahren beschreiben",
    "titleEn": "Describe plastic processing methods",
    "descriptionDe": "Die lernende Person kann Verarbeitungsverfahren für Kunststoffe wie Spritzgießen, Tiefziehen, Kalandrieren und Extrudieren beschreiben und mit Materialeigenschaften verknüpfen.",
    "descriptionEn": "The learner can describe plastic processing methods such as injection moulding, thermoforming, calendering, and extrusion and link them to material properties.",
    "canonicalContext": {
      "shortKey": "canonical_chemistry_upper_plastic_processing_methods",
      "phase": "Q2",
      "core": false,
      "weight": 1,
      "tags": [
        "LK",
        "SekII",
        "canonical"
      ],
      "competencyRefs": [],
      "sourceRef": null,
      "dimensionTags": {
        "framework": "canonical-gymnasium-chemistry",
        "demandLevel": "AB2",
        "processCompetencies": [
          "PK4_KOMMUNIZIEREN",
          "PK5_BEWERTEN"
        ],
        "guidingIdeas": [
          "BC_AUFBAU",

    {
      "decision": "approve",
      "sourceScientificReasonDe": "Das Original fordert das universelle molare Volumen unter gleichen Bedingungen. Das aktuelle abhängige Profil muss erklären, warum sich ein gemeinsames Volumen auf gleiche Stoffmengen verschiedener Gase bezieht. Genau dies ist der Inhalt des Avogadro-Vorwissens, ohne eine zusätzliche kinetische Herleitung zu verlangen.",
      "primaryPrefix": "3ae66c",
      "actualPDFPages": [
        23
      ],
      "originalCourseStageProgram": "Klassen 9/10/11, gemeinsamer Sek-I-Standard",
      "witnessAnchorIds": [

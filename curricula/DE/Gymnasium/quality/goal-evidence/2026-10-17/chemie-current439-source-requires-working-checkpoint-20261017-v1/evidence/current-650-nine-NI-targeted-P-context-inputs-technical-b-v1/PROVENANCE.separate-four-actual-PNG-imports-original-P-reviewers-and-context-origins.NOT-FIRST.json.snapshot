        "reason": "Interpretation und Bindungsordnungsableitung sind eine zusammenhängende MO-Modellleistung. Das sichtbare O2-Schema ist kein Ersatz für frische Elektronenbelegung. Zwei unabhängige, vom bestehenden Bild nicht ablesbare Fälle prüfen fachlichen Transfer. KI-Kandidat bleibt needs_human_review, keine menschliche Freigabe.",
        "evidenceLevel": "E1",
        "maximumClaimScope": "G1",
        "reviewRunIds": [],
        "dissent": [],
        "profile": {
          "archetype": "data",
          "expectations": [
            {
              "id": "b003-f85b4651-core",
              "essentialUnderstandingDe": "MO-Diagramme zeigen besetzte bindende und antibindende Orbitale; die Bindungsordnung ergibt sich aus der halben Differenz ihrer Elektronenzahlen, mit Modellgrenzen bei Stabilität und Magnetismus.",
              "essentialUnderstandingEn": "MO diagrams show occupied bonding and antibonding orbitals; bond order is half the difference in electron counts, with model limits for stability and magnetism.",
              "observablePerformanceDe": "Die lernende Person zählt Elektronen in einem vorgegebenen O2- oder N2-Schema, berechnet die Bindungsordnung und verknüpft die Besetzung mit einer qualitativen Aussage.",
              "observablePerformanceEn": "The learner counts electrons in a supplied O2 or N2 scheme, computes bond order, and connects occupancy to a qualitative claim."
            }
          ],
          "coverageExpectations": {
            "requiredExpectationIds": [
              "b003-f85b4651-core"
            ],
            "alternativeExpectationGroups": [],
            "minimumIndependentDemonstrations": 2,
            "freshVariationRequired": true,
            "independentTransferRequired": true
          },
          "variationAxes": [
            {
              "id": "occupancy",
              "textDe": "Bindende und antibindende Elektronenbelegung werden verändert.",
              "textEn": "Bonding and antibonding electron occupancy are changed."
            },
            {
              "id": "species",
              "textDe": "Neutrales Molekül und Molekülion werden verglichen.",
              "textEn": "A neutral molecule and a molecular ion are compared."
            }
          ],
          "applicationCaseBriefs": [
            {
              "id": "nitrogen-mo-count",
              "taskDemandDe": "Ein vorgegebenes korrekt geordnetes N2-MO-Schema enthält acht bindende und zwei antibindende Valenzelektronen. Berechne die Bindungsordnung und erkläre ihre Modellbedeutung.",
              "taskDemandEn": "A correctly ordered supplied N2 MO scheme has eight bonding and two antibonding valence electrons. Calculate bond order and explain its model meaning.",
              "expectedPerformanceDe": "Die lernende Person berechnet (8−2)/2=3 und deutet dies als Dreifachbindungs-Tendenz im einfachen MO-Modell, nicht als exakt gemessene Bindungsenergie.",
              "expectedPerformanceEn": "The learner calculates (8−2)/2=3 and interprets a triple-bond tendency in the simple MO model, not an exactly measured bond energy.",
              "understandingFocusDe": "Elektronenbesetzung bestimmt die Modell-Bindungsordnung.",
              "understandingFocusEn": "Electron occupancy determines model bond order."
            },
            {
              "id": "fresh-oxygen-cation",
              "taskDemandDe": "Ein frisches O2-Schema hat acht bindende und vier antibindende Valenzelektronen. Für O2+ wird eines aus einem antibindenden Orbital entfernt. Vergleiche die Bindungsordnung.",
              "taskDemandEn": "A fresh O2 scheme has eight bonding and four antibonding valence electrons. O2+ loses one from an antibonding orbital. Compare bond order.",
              "expectedPerformanceDe": "Die lernende Person erhält 2 für O2 und 2,5 für O2+ und erklärt die modellhaft stärkere Bindungstendenz nach Entfernen eines antibindenden Elektrons.",
              "expectedPerformanceEn": "The learner gets 2 for O2 and 2.5 for O2+ and explains stronger model bonding tendency after removing an antibonding electron.",
              "understandingFocusDe": "Neues Ion prüft regelgeleiteten Transfer.",
              "understandingFocusEn": "A new ion tests rule-based transfer."
            }
          ]
        }
      },

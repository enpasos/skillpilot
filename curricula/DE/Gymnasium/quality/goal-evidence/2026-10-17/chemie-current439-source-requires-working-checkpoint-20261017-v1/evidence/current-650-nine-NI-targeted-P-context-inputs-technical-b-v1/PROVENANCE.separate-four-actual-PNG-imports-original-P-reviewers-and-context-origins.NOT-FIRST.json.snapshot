      "originalWholeRecord": {
        "$schema": "https://skillpilot.com/schemas/goal-evidence/v2/goal-evidence-profile.schema.json",
        "schemaVersion": 2,
        "reviewId": "chemie-b008-current517-whole38-paired-reviewed-inactive-v1",

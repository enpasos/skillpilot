        "goalFingerprint": "sha256:8b8e10c8986185b84c28ed8f2287a62e3f0fb894dd9701e83a02702df90969ab",
        "reviewInputFingerprint": "sha256:cee94efb756ac4b8020eacf52f8c953a2ed948150b2ce4a472668738c37df411",
        "profileFingerprint": "sha256:764a1b12133c4cd69a6fb2717d63b5e3bbd7e52bb032d83382cb37ce4847942f",
        "status": "needs_human_review",

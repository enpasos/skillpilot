        "goalFingerprint": "sha256:bd2b6671612c8df991dbeca4dbb4f8c0c3152f241b4d2bf7065902195177750b",
        "reviewInputFingerprint": "sha256:e25eb3cb17435078a37aedb5697e7d26787bbd87cb80bf5574c78d1629da228d",

        "reviewCriteriaFingerprint": "sha256:4ed61d2a8c7eb84dd13315427d46989b4750f58620481e19023b145935025835",
        "landscapeId": "c436b994-8f44-5134-b9f8-0c9f5d6a5ba0",
        "goalId": "b95cdf98-fc97-5a94-b133-878922d28156",
        "goalFingerprint": "sha256:50c21cd059d30a57847a38a32f05722831d0b3c789c13d79b92c70018f02c5bb",
        "reviewInputFingerprint": "sha256:3bcf2103d57a0173dfb3e6ff99cf7401b28188ab836599c10bbecb26fd9ae2b2",
        "profileFingerprint": "sha256:6dcf5de14561b736fe6938a9a14eb785fa8c7b38a7e19bf70e5d63783b365f0d",
        "status": "needs_human_review",
        "reviewAuthority": "ai_candidate",
        "reviewedAt": "2026-10-05T00:39:23.116529+00:00",
        "reviewer": "Codex integration of two independent current D-before-P reviews and targeted P successor checks",
        "reason": "Erdölprodukte werden funktionsbezogen und mit unterschiedlichen Umweltpfaden beurteilt; Fälle bleiben für den belegten bayerischen Sek-I-Ursprung zugänglich. Inaktiver KI-Kandidat: needs_human_review, E1/G1; keine menschliche Freigabe oder Lernendenbewährung. Aktuelle Integration nach zwei unabhängigen Beschreibungsreviews und separaten fachlichen P-Prüfungen einschließlich gezielter Nachprüfung des v2-Nachfolgers. Status bleibt ai_candidate/needs_human_review; kein menschlicher oder lernendenbezogener Nachweis.",
        "evidenceLevel": "E1",
        "maximumClaimScope": "G1",
        "reviewRunIds": [],
        "dissent": [],
        "profile": {
          "archetype": "modeling",
          "expectations": [
            {
              "id": "petroleum-application-impact",
              "essentialUnderstandingDe": "Erdöl liefert sowohl Brennstoffe als auch stoffliche Grundprodukte. Die Funktion eines Produkts erklärt seinen Nutzen; Verbrennung, Verluste und Entsorgung erzeugen unterschiedliche Umweltfolgen. Eine begründete Einschätzung verbindet Verwendung und konkrete Folgen ohne alle Erdölprodukte gleichzusetzen.",
              "essentialUnderstandingEn": "Petroleum supplies both fuels and material feedstocks. Product function explains utility; combustion, losses and disposal create different environmental consequences. A justified assessment connects use with specific consequences without treating all petroleum products alike.",
              "observablePerformanceDe": "Die lernende Person ordnet neue Produkte ihrer Verwendung zu und schätzt je einen begründeten Nutzen, einen Umweltpfad und eine situationsgerechte Begrenzung ab.",
              "observablePerformanceEn": "The learner assigns fresh products to uses and assesses a justified benefit, an environmental pathway and a suitable limitation for each situation."
            }
          ],
          "coverageExpectations": {
            "requiredExpectationIds": [
              "petroleum-application-impact"
            ],
            "alternativeExpectationGroups": [],
            "minimumIndependentDemonstrations": 2,
            "freshVariationRequired": true,
            "independentTransferRequired": true
          },
          "variationAxes": [
            {
              "id": "material-versus-fuel",
              "textDe": "Brennstoff und langlebiger Werkstoff werden nach ihrer tatsächlichen Nutzung verglichen.",
              "textEn": "Fuel and durable material are compared according to actual use."
            },
            {
              "id": "release-route",
              "textDe": "Verbrennungsemissionen werden von Stoffverlusten in Wasser oder Boden unterschieden.",
              "textEn": "Combustion emissions are distinguished from material losses to water or soil."
            }
          ],
          "applicationCaseBriefs": [
            {
              "id": "fuel-and-petroleum-plastic",
              "taskDemandDe": "Ordne Diesel im Bus und einen wiederverwendeten Kunststoffbehälter aus Erdölgrundstoffen ihren Einsatzbereichen zu. Ein Kurzdatensatz nennt CO2 bei der Dieselverbrennung und Kunststoffabfall bei schlechter Entsorgung. Beurteile Nutzen und je eine Umweltfolge; prüfe „Jedes Erdölprodukt wird bei seiner Nutzung verbrannt“.",
              "taskDemandEn": "Assign diesel in a bus and a reused plastic container made from petroleum feedstocks to their uses. A short dataset reports CO2 from diesel combustion and plastic waste from poor disposal. Assess benefits and one environmental consequence each; test “every petroleum product is burned during use”.",
              "expectedPerformanceDe": "Die lernende Person unterscheidet Energiebereitstellung von stofflicher Nutzung, verbindet Diesel mit direkter CO2-Freisetzung und den Behälter mit Nutzungsdauer/Abfallpfad. Sie erklärt den Nutzen Transport bzw. wiederholte Aufbewahrung und widerlegt die Gleichsetzung; sie behauptet keine vollständige Ökobilanz aus diesen Einzelangaben.",
              "expectedPerformanceEn": "The learner distinguishes energy use from material use, links diesel to direct CO2 release and the container to lifetime/waste pathways. They explain transport and repeated storage benefits and reject the conflation, without claiming a complete lifecycle assessment from these few data.",
              "understandingFocusDe": "Zwei Nutzungsformen begründen unterschiedliche Umweltpfade.",
              "understandingFocusEn": "Two forms of use explain different environmental pathways."
            },
            {
              "id": "fresh-lubricant-and-road-surface",
              "taskDemandDe": "Ein unabhängiger Fall betrifft Schmieröl in einer Maschine und Bitumen in einer Straße. Erkläre die Verwendung, vergleiche anhand bereitgestellter Angaben Abrieb, Ölleckage und lange Nutzungsdauer und begründe eine Maßnahme. Prüfe, ob allein „nicht verbrannt“ genügt, beide Produkte als umweltfolgenfrei einzustufen.",
              "taskDemandEn": "An independent case concerns lubricating oil in a machine and bitumen in a road. Explain their uses, compare supplied information on abrasion, oil leakage and long service life, and justify one measure. Decide whether “not burned” alone makes both environmentally harmless.",
              "expectedPerformanceDe": "Die lernende Person ordnet Reibungsminderung/Schutz bzw. Bindung des Straßenmaterials zu, verknüpft Leckage mit Boden-/Wasserbelastung und Abrieb mit Stoffeintrag. Sie begründet z. B. Leckagekontrolle und sachgerechte Altölerfassung, erkennt den Nutzen langer Lebensdauer und verlangt zusätzliche Herstellungs-/Entsorgungsdaten für ein Gesamturteil.",
              "expectedPerformanceEn": "The learner identifies friction reduction/protection and binding road material, links leaks to soil/water pollution and abrasion to material release. They justify leak control and proper used-oil collection, recognize long service life and request production/disposal data for an overall judgment.",
              "understandingFocusDe": "Eine neue Verwendung verhindert die pauschale Brennstoffschablone.",
              "understandingFocusEn": "A fresh use prevents a blanket fuel-based explanation."
            }
          ]
        }
      },
      "originalReviewer": "Codex integration of two independent current D-before-P reviews and targeted P successor checks",

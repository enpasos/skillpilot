      "originalWholeRecord": {
        "$schema": "https://skillpilot.com/schemas/goal-evidence/v2/goal-evidence-profile.schema.json",
        "schemaVersion": 2,
        "reviewId": "chemie-current403-four-profile-author-20261013-v1",

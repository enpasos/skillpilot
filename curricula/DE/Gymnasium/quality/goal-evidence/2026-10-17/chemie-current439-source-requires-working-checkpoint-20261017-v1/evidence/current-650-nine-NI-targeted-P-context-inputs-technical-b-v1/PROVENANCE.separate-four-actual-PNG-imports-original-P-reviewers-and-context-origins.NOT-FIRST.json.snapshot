        "goalFingerprint": "sha256:fd439e6043e209dd0c527be4c70810e318d2a0a812e589473802b03a43339e3b",
        "reviewInputFingerprint": "sha256:d563c76b9a3e6382acc9309ea9950ec9989a6b16098dcfec0dfb8c6df183c3ab",
        "profileFingerprint": "sha256:7c4ae9dd9a787187184cca45b621fe351e596f2080e0d1ba94f3c7e1a6fe3c57",
        "status": "needs_human_review",
        "reviewAuthority": "ai_candidate",
        "reviewedAt": "2026-10-16T06:12:43.892469+00:00",
        "reviewer": "Independent Codex scientific reviewer / task chemie_pa9_fresh_science_20261016",
        "reason": "Fraktionierung und thermisches Cracken werden als Trennung versus Stoffumwandlung qualitativ beschrieben, typische Produktklassen passend zugeordnet und Modellgrenzen an atomar korrekten Beispielen gezeigt. Der Nachfragefall enthält den erforderlichen geänderten Prozessentscheid. Die Bilanzvariation des ersten Falls allein wäre zu wenig. Das direkte Rohstoffziel liefert Vorkommen/Förderung. Siedebereiche, Gemischcharakter und einfache Formeln werden im Material bereitgestellt; ein reales Destillieren oder Cracken wird nicht verlangt. Technical normal serialization of sealed FIRSTScience; designed_not_learner_observed; E0/G0; no new independent vote.",
        "evidenceLevel": "E0",
        "maximumClaimScope": "G0",
        "reviewRunIds": [],
        "dissent": [
          "HE G9 10.4 und HE E.4 nennen beide Verfahren. Der aktuelle Text kann mit derselben qualitativen Unterscheidung in SekI und SekII bearbeitet werden; keine apparative oder produktspezifische Zusatzpflicht wird aus den Karten freigegeben. Andere Quelle-/Partnerpflichten bleiben separat.",
          "FIRSTScience support concerns a prospective whole-goal design only; no real learner work or experiment was observed. Separate source/course/partner/memory holds remain."
        ],
        "profile": {
          "archetype": "concept",
          "expectations": [
            {
              "id": "8ceb1749-understanding-1",
              "essentialUnderstandingDe": "Fraktionierte Destillation trennt ein Gemisch nach Siedeverhalten; Fraktionen bleiben Gemische und Moleküle werden im Trennmodell nicht gespalten.",
              "essentialUnderstandingEn": "Fractional distillation separates a mixture by boiling behaviour; fractions remain mixtures and molecules are not cleaved in this separation model.",
              "observablePerformanceDe": "Leichte/schwere Fraktionen im Temperaturgefälle begründet zuordnen.",
              "observablePerformanceEn": "Place light/heavy fractions in the gradient with reasons."
            },
            {
              "id": "8ceb1749-understanding-2",
              "essentialUnderstandingDe": "Thermisches Cracken verändert Kohlenwasserstoffmoleküle und bildet typischerweise kürzere Alkane/Alkene in bedingungsabhängigen Gemischen.",
              "essentialUnderstandingEn": "Thermal cracking changes hydrocarbon molecules, typically forming shorter alkanes/alkenes in condition-dependent mixtures.",
              "observablePerformanceDe": "Ein vereinfachtes Beispiel atomar prüfen und mögliche Produkte ohne universelle Ausbeutebehauptung zuordnen.",
              "observablePerformanceEn": "Check atoms in a simplified example and classify possible products without universal yield claims."
            },
            {
              "id": "8ceb1749-understanding-3",
              "essentialUnderstandingDe": "Massenbilanz erlaubt Reaktionsschemata, legt aber weder das reale Produktspektrum noch die Prozessausbeute fest.",
              "essentialUnderstandingEn": "Mass balance permits schemes but determines neither real product distribution nor process yield.",
              "observablePerformanceDe": "Eine neue Fraktions-/Crackvariation fachlich unterscheiden und fehlende Produktdaten benennen.",
              "observablePerformanceEn": "Distinguish a fresh fraction/cracking variation and name absent product data."
            }
          ],
          "coverageExpectations": {
            "requiredExpectationIds": [
              "8ceb1749-understanding-1",
              "8ceb1749-understanding-2",
              "8ceb1749-understanding-3"
            ],
            "alternativeExpectationGroups": [],
            "minimumIndependentDemonstrations": 2,
            "freshVariationRequired": true,
            "independentTransferRequired": true
          },
          "variationAxes": [
            {
              "id": "whole-case-and-fresh-input",
              "textDe": "Geänderte Stoff-/Teilchen-/Modellangaben selbst deuten; keine Musterantwort unverändert übernehmen.",
              "textEn": "Interpret changed substance/particle/model inputs independently rather than copying an answer."
            },
            {
              "id": "model-and-evidence-boundary",
              "textDe": "Stoffidentität, Modellgrenze und fehlende reale Evidenz explizit erhalten.",
              "textEn": "Explicitly preserve substance identity, model limits and absent real evidence."
            }
          ],
          "applicationCaseBriefs": [
            {
              "id": "refinery-separate-convert",
              "taskDemandDe": "Ein fiktives Rohölgemisch enthält Stoffgruppen mit unterschiedlichen Siedebereichen. Bei der fraktionierten Destillation wird unten heißer und oben kühler betrieben; Fraktionen haben überlappende Siedebereiche und sind Gemische. Ein zweiter Prozess erhitzt eine schwere Kohlenwasserstofffraktion unter thermischen Crackbedingungen ohne Sauerstoffzufuhr. Vereinfachtes Beispiel: C₁₂H₂₆→C₈H₁₈+C₄H₈. Keine Temperatur-/Geräteanleitung und kein Durchführungsauftrag. Erkläre die Aufgaben beider Prozesse und ordne leichte/kondensierende bzw.schwere Fraktionen im Temperaturgefälle ein. Prüfe das vereinfachte Crackbeispiel auf Atomzahl, ordne die Produkte als Alkan/Alken ein und erkläre, warum weder Fraktionierung noch eine Einzelgleichung ein reines Endprodukt oder reales festes Produktspektrum garantieren. Frischer Transfer:Prüfe den neuen Modellweg C₁₂H₂₆→C₆H₁₄+C₆H₁₂. Kannst du allein aus gleicher Gesamtformel entscheiden, welcher der beiden Wege in einer Raffinerie überwiegt?",
              "taskDemandEn": "A fictional crude mixture has groups with different boiling ranges. In fractional distillation the bottom is hotter and top cooler; fractions have overlapping boiling ranges and remain mixtures. A second process heats a heavy hydrocarbon fraction under thermal cracking conditions without oxygen supply. Simplified example:C₁₂H₂₆→C₈H₁₈+C₄H₈. No operating temperatures, apparatus instructions or execution task are supplied. Explain each process and place lighter-condensing and heavier fractions in the temperature gradient. Check atom balance in the cracking example, classify products as alkane/alkene and explain why neither fractionation nor a single equation guarantees a pure end product or fixed real product spectrum. Fresh transfer:Check the fresh model route C₁₂H₂₆→C₆H₁₄+C₆H₁₂. Can equal total composition tell you which of the two routes dominates in a refinery?",
              "expectedPerformanceDe": "Fraktionierung trennt überwiegend nach Siedeverhalten, ohne im Modell Moleküle umzubauen. Höher siedende schwere Anteile kondensieren eher im heißeren unteren Bereich, niedrig siedende leichte Anteile höher im kühleren Bereich; sehr leichte Gase können gasförmig austreten. Thermisches Cracken verändert Moleküle und bildet kürzere Kohlenwasserstoffe. C12=8+4, H26=18+8; Octan ist Alkan, C₄H₈ kann hier als Alken-Produkt dargestellt werden (Summenformel allein beweist außerhalb des Beispiels keine Struktur). Fraktionen bleiben Gemische; reale Crackprodukte hängen von Stoffgemisch und Prozessbedingungen ab. Cracken ist keine Verbrennung, Sauerstoff fehlt. Transfer:C12=6+6, H26=14+12, daher atomar möglich. Hexan und ein passendes Hexen sind mögliche Modellprodukte. Die Bilanz bestimmt weder Ausbeute noch Verteilung; dafür fehlen Feed-/Bedingungs-/Analysedaten. Kein einzelnes Crackprodukt wird aus der Bilanz zwingend vorhergesagt.",
              "expectedPerformanceEn": "Fractionation separates mainly by boiling behaviour without rebuilding molecules in this model. Higher-boiling heavier portions condense in the hotter lower region and lower-boiling lighter portions higher in the cooler region; very light gases may exit as gas. Thermal cracking changes molecules into shorter hydrocarbons. C12=8+4, H26=18+8; octane is an alkane and C₄H₈ can represent an alkene product here (the molecular formula alone does not establish structure outside this example). Fractions remain mixtures and real cracking products depend on feed and conditions. Cracking is not combustion:oxygen is absent. Transfer:C12=6+6, H26=14+12, so atom balance permits it. Hexane and a suitable hexene are possible model products. Balance establishes neither yield nor distribution; feed, operating and analytical data are absent. No single cracking product follows necessarily from balance.",
              "understandingFocusDe": "Ganzes Lernziel mit begründeter Übertragung; Autorenentwurf ohne beobachtete Lernendenleistung.",
              "understandingFocusEn": "Whole goal with reasoned transfer; author design without observed learner performance."
            },
            {
              "id": "refinery-fault-model",
              "taskDemandDe": "Ein fiktiver Text behauptet:(1)Eine Destillationsfraktion ist stets ein Reinstoff.(2)Im kühleren Kolonnenkopf sammelt sich zuerst die am höchsten siedende Schwerölgruppe.(3)Thermisches Cracken macht aus langen Kohlenwasserstoffen nur kürzere Alkane.(4)C₁₀H₂₂→C₅H₁₂+C₅H₁₀ ist ein mögliches vereinfachtes Crackbeispiel. Produkte3/4 sind Modellfragen, keine echte Raffineriemessung. Korrigiere den Text mit einer zusammenhängenden Erklärung von Fraktionierung und thermischem Cracken. Prüfe Gleichung4 und ordne typische Produkte zu. Unterscheide eine Trennung vorhandener Moleküle von ihrer chemischen Veränderung. Frischer Transfer:In einem neuen Szenario wird mehr leichte Kohlenwasserstofffraktion benötigt, als das gegebene Rohöl enthält. Erzeugt intensiveres Destillieren allein aus Schweröl zusätzliche kurze Moleküle? Welcher Unterschied bleibt, wenn nur die Abzugshöhe verändert wird?",
              "taskDemandEn": "A fictional text claims:(1)A distillation fraction is always pure.(2)The highest-boiling heavy-oil group first collects at the cooler column top.(3)Thermal cracking makes only shorter alkanes.(4)C₁₀H₂₂→C₅H₁₂+C₅H₁₀ is a possible simplified cracking example. Items3/4 are model questions, not refinery measurements. Correct the text with a connected explanation of fractionation and thermal cracking. Check equation4 and classify typical products. Distinguish separating existing molecules from chemical changes. Fresh transfer:A fresh scenario needs more light hydrocarbon fraction than the crude contains. Does more intensive distillation alone make extra short molecules from heavy oil? What remains different if only the withdrawal height changes?",
              "expectedPerformanceDe": "(1)Falsch:Fraktionen sind Stoffgemische mit Siedebereichen.(2)Falsch:Hochsiedende Anteile kondensieren eher tiefer bei höherer Temperatur; leichtere niedriger siedende Anteile gelangen höher.(3)Falsch:Alkene gehören zu typischen Crackprodukten, neben Alkanen und weiteren vom Verfahren abhängigen Stoffen.(4)C10=5+5, H22=12+10; Pentan und als Beispiel ein Penten sind bilanziert möglich. Fraktionierung erzeugt diese Molekülspaltung nicht. Real entsteht ein Gemisch; eine Gleichung ist keine vollständige Prozessvorhersage. Transfer:Nein:Destillation kann vorhandene Komponenten anders trennen/abziehen, aber im betrachteten Trennmodell keine langen Moleküle in kurze umwandeln. Cracken kann schwere Moleküle chemisch umsetzen; Produktspektrum und Ausbeute bleiben bedingungsabhängig. Andere Abzugshöhe verändert die Fraktionszusammensetzung, nicht die chemische Identität durch Spaltung.",
              "expectedPerformanceEn": "(1)False:Fractions are mixtures with boiling ranges.(2)False:High-boiling portions tend to condense lower at higher temperature; lower-boiling portions reach higher regions.(3)False:Alkenes are typical cracking products alongside alkanes and condition-dependent other substances.(4)C10=5+5, H22=12+10; pentane and, for example, a pentene are atom-balanced possibilities. Fractionation does not cause this molecular cleavage. Real products are mixtures; a single equation is no full process prediction. Transfer:No:Distillation can separate or withdraw existing components differently but does not cleave long molecules in this separation model. Cracking can convert heavy molecules chemically; product distribution and yield remain conditional. Changing withdrawal height changes fraction composition, not identity by molecular cleavage.",
              "understandingFocusDe": "Ganzes Lernziel mit begründeter Übertragung; Autorenentwurf ohne beobachtete Lernendenleistung.",
              "understandingFocusEn": "Whole goal with reasoned transfer; author design without observed learner performance."
            }
          ]
        }
      },
      "originalReviewer": "Independent Codex scientific reviewer / task chemie_pa9_fresh_science_20261016",
      "originalReviewedAt": "2026-10-16T06:12:43.892469+00:00",
      "originalReviewId": "chemie-p3-genuine-first-normal-binding-20261016-v1",
      "originalScienceReasonRetainedOnlyHereNotInCleanInput": "Fraktionierung und thermisches Cracken werden als Trennung versus Stoffumwandlung qualitativ beschrieben, typische Produktklassen passend zugeordnet und Modellgrenzen an atomar korrekten Beispielen gezeigt. Der Nachfragefall enthält den erforderlichen geänderten Prozessentscheid. Die Bilanzvariation des ersten Falls allein wäre zu wenig. Das direkte Rohstoffziel liefert Vorkommen/Förderung. Siedebereiche, Gemischcharakter und einfache Formeln werden im Material bereitgestellt; ein reales Destillieren oder Cracken wird nicht verlangt. Technical normal serialization of sealed FIRSTScience; designed_not_learner_observed; E0/G0; no new independent vote.",
      "embeddedOriginalSciencePathPins": [],

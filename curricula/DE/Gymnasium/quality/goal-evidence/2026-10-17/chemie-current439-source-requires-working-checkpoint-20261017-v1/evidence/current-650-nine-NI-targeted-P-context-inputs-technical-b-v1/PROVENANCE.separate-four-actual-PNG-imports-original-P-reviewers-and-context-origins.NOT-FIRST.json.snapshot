        "reviewCriteriaFingerprint": "sha256:4ed61d2a8c7eb84dd13315427d46989b4750f58620481e19023b145935025835",
        "landscapeId": "c436b994-8f44-5134-b9f8-0c9f5d6a5ba0",
        "goalId": "642d5ea5-b62f-50c8-b0bd-cf132619725f",
        "goalFingerprint": "sha256:b7c42d91c4b9f0c6afe0d0924b46d90e366999d3ae13d1795a3f556f22e836fd",
        "reviewInputFingerprint": "sha256:f0524a95208e8d70b166ec806b4c5a079fba38b97febe4d65858f8b7f2c4b3b5",
        "profileFingerprint": "sha256:9447f6a303f3345b0e6551951b55660cd3154eeb16b56a6bd7001ed3c69c7e52",
        "status": "needs_human_review",
        "reviewAuthority": "ai_candidate",
        "reviewedAt": "2026-10-15T15:10:44.780Z",
        "reviewer": "Independent reviewer A, separate P role, Codex GPT-6 (runtime snapshot not exposed)",
        "reason": "642d5ea5 — suitable existing material, E1/G1.** Cases 03-a/b cover coupled anodic/cathodic processes, correct oxygen-reduction balance, coating damage, contact continuity and differential aeration. They require causal explanation, not an E° ranking alone. The changed acidic cathode and impressed-current conditions test transfer; passivation and kinetic limits prevent unsupported protection-rate claims. Partner goals retain full economic/ecological judgment and dedicated acid/oxygen classification.",
        "evidenceLevel": "E1",
        "maximumClaimScope": "G1",
        "reviewRunIds": [
          "chemie-equilibrium16-final-native-independent-a-p-run-20261015-v1"
        ],
        "dissent": [],
        "profile": {
          "archetype": "concept",
          "expectations": [
            {
              "id": "e1",
              "essentialUnderstandingDe": "Korrosion ist eine räumlich gekoppelte Oxidation und Reduktion mit elektronischer und ionischer Verbindung.",
              "essentialUnderstandingEn": "Corrosion couples spatially separated oxidation/reduction through electronic and ionic paths.",
              "observablePerformanceDe": "eqrk16-03-a: Beide Lokalelemente mit korrektem Sauerstoffreduktionsweg erklären. eqrk16-03-b: Metallischen und elektrolytischen Kreis als Schutzbedingung zeigen.",
              "observablePerformanceEn": "eqrk16-03-a: Explain both local cells with balanced oxygen reduction. eqrk16-03-b: Identify metallic and electrolytic paths as protection conditions."
            },
            {
              "id": "e2",
              "essentialUnderstandingDe": "Opferanoden schützen durch bevorzugte Oxidation und kathodische Polarisation, Beschichtungen durch Barrierewirkung.",
              "essentialUnderstandingEn": "Sacrificial anodes protect by preferential oxidation/cathodic polarisation; coatings act as barriers.",
              "observablePerformanceDe": "eqrk16-03-a: Barrierewirkung, Opferwirkung und Defektflächen vergleichen. eqrk16-03-b: Differenzbelüftung mit getrennten lokalen Reaktionsorten begründen.",
              "observablePerformanceEn": "eqrk16-03-a: Compare barrier protection, sacrificial action and defect areas. eqrk16-03-b: Explain differential aeration through separate reaction sites."
            },
            {
              "id": "e3",
              "essentialUnderstandingDe": "Werkstoffpaarung, Sauerstoff und Beschichtungsdefekte verändern den lokalen Angriff, ohne dass Standardpotenziale die Rate allein festlegen.",
              "essentialUnderstandingEn": "Material pairing, oxygen and coating defects change local attack; standard potentials alone do not determine its rate.",
              "observablePerformanceDe": "eqrk16-03-a: Thermodynamische Richtung von unbekannter Korrosionsrate trennen. eqrk16-03-b: Überprüfbaren Wartungsplan ohne erfundene Daten entwickeln.",
              "observablePerformanceEn": "eqrk16-03-a: Separate thermodynamic tendency from unknown corrosion rate. eqrk16-03-b: Develop a testable maintenance plan without invented results."
            }
          ],
          "coverageExpectations": {
            "requiredExpectationIds": [
              "e1",
              "e2",
              "e3"
            ],
            "alternativeExpectationGroups": [],
            "minimumIndependentDemonstrations": 2,
            "freshVariationRequired": true,
            "independentTransferRequired": true
          },
          "variationAxes": [
            {
              "id": "eqrk16-03-a-transfer",
              "textDe": "Ersetze belüftetes neutrales Wasser durch sauerstoffarmes saures Medium. Welche kathodische Teilreaktion kann nun wichtig werden, und welche frühere Sauerstoffbegründung muss neu geprüft werden?",
              "textEn": "Replace aerated neutral water with oxygen-poor acidic solution. Which cathodic half-reaction can become important and which oxygen-based explanation must be reconsidered?"
            },
            {
              "id": "eqrk16-03-b-transfer",
              "textDe": "Eine Gleichstromquelle ersetzt die Zinkanode durch eine Fremdstromanlage. Begründe benötigte Polung am Stahl und warum sich der Wartungsbefund „Zinkverbrauch“ nicht einfach überträgt.",
              "textEn": "An external DC supply replaces the sacrificial zinc system. Justify the steel polarity and explain why the zinc-consumption maintenance rule no longer transfers directly."
            }
          ],
          "applicationCaseBriefs": [
            {
              "id": "eqrk16-03-a",
              "taskDemandDe": "Vollständiges eigenes Material: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-equilibrium-redox-kinetics16-current422-whole-material-author-20261015-v1/materials/thirty-two-whole-DE-EN-cases.final-science-and-prose.author.json #eqrk16-03-a; sha256:86dc6b7640368abf7dbd12b51f4cdf48aba1731f7f543169a30c14261c3ccd2e. Erkläre beide Lokalelemente mit Teilgleichungen und Elektronen-/Ionenwegen. Entscheide, welche Schicht auch nach Verletzung Opferwirkung besitzt. Begründe einen möglichen Flächeneffekt und die Grenzen einer allein aus E° berechneten Korrosionsprognose.",
              "taskDemandEn": "Complete own material: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-equilibrium-redox-kinetics16-current422-whole-material-author-20261015-v1/materials/thirty-two-whole-DE-EN-cases.final-science-and-prose.author.json #eqrk16-03-a; sha256:86dc6b7640368abf7dbd12b51f4cdf48aba1731f7f543169a30c14261c3ccd2e. Explain both local cells with half-reactions and electron/ion paths. Decide which coating retains sacrificial protection after damage. Discuss a possible area effect and limitations of predicting corrosion solely from E°.",
              "expectedPerformanceDe": "Zink: Zn→Zn2++2e−; Elektronen gelangen durch Metall zum Stahl, dort O2+2H2O+4e−→4OH−. Stahl wird kathodisch geschützt, solange der Zinkkontakt und Elektrolytleitweg bestehen. Bei Zinn ist freigelegtes Eisen die bevorzugte Anode: Fe→Fe2++2e−, Sauerstoffreduktion an edlerer Zinnfläche. Große Kathodenfläche bei kleiner Eisenanode kann den lokalen Angriff verstärken; konkrete Rate benötigt Polarisation, Transport, Passivierung und Geometrie. Ionenwanderung im Wasser erhält Ladungsbilanz; Elektronen laufen nicht als freie Elektronen durch die Salzlösung. Rostbildung umfasst weitere Hydroxid-/Oxidationsschritte, nicht bloß Fe→Fe2+.",
              "expectedPerformanceEn": "With zinc: Zn→Zn2++2e−; electrons pass through metal to steel, where O2+2H2O+4e−→4OH− occurs. Steel is cathodically protected while metallic/electrolytic paths remain. With tin, exposed iron is the preferred anode:Fe→Fe2++2e−, with oxygen reduction on nobler tin. A large cathode with a small iron anode can intensify local attack; actual rate also requires polarisation, transport, passivation and geometry. Ionic motion maintains charge balance in water; free electrons do not travel through the salt solution. Rust formation includes further hydroxide/oxidation chemistry.",
              "understandingFocusDe": "Ersetze belüftetes neutrales Wasser durch sauerstoffarmes saures Medium. Welche kathodische Teilreaktion kann nun wichtig werden, und welche frühere Sauerstoffbegründung muss neu geprüft werden?",
              "understandingFocusEn": "Replace aerated neutral water with oxygen-poor acidic solution. Which cathodic half-reaction can become important and which oxygen-based explanation must be reconsidered?"
            },
            {
              "id": "eqrk16-03-b",
              "taskDemandDe": "Vollständiges eigenes Material: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-equilibrium-redox-kinetics16-current422-whole-material-author-20261015-v1/materials/thirty-two-whole-DE-EN-cases.final-science-and-prose.author.json #eqrk16-03-b; sha256:86dc6b7640368abf7dbd12b51f4cdf48aba1731f7f543169a30c14261c3ccd2e. Begründe Schutz oder fehlenden Schutz in A/B und leite Anoden-/Kathodenorte im Belüftungselement ab. Plane eine überprüfbare Wartungsentscheidung einschließlich Anodenverbrauch und Kontrollen; erfinde keine gemessene Schutzwirkung. Ist „mehr Sauerstoff bedeutet an jedem Ort mehr Eisenauflösung“ tragfähig?",
              "taskDemandEn": "Complete own material: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-equilibrium-redox-kinetics16-current422-whole-material-author-20261015-v1/materials/thirty-two-whole-DE-EN-cases.final-science-and-prose.author.json #eqrk16-03-b; sha256:86dc6b7640368abf7dbd12b51f4cdf48aba1731f7f543169a30c14261c3ccd2e. Explain protection or its absence in A/B and locate anodic/cathodic sites in the differential-aeration cell. Plan a testable maintenance decision including anode consumption and controls; do not invent measured protection. Assess “more oxygen means more iron dissolution at every location”.",
              "expectedPerformanceDe": "A ermöglicht einen äußeren metallischen Elektronenweg; Zink oxidiert bevorzugt. In B fehlt dieser Weg, daher schützt allein das benachbarte Zink den Tank nicht verlässlich. Am sauerstoffreichen Rand wird die kathodische Sauerstoffreduktion begünstigt, im sauerstoffärmeren Zentrum kann Eisen anodisch aufgelöst werden; gekoppelte Orte widerlegen die einfache Ortsregel. Wartung prüft Kontakt, verbleibende Masse/Geometrie, Elektrolytleitfähigkeit und Potential unter definierten Bedingungen; Austausch vor Verbrauch. Abtrag und Potentialmessung mit/ohne Kontakt und ohne Zink bei kontrolliertem Sauerstoff erlauben eine reale Prüfung. Passivierung und örtliche Strömung können die Situation ändern; keine Erfolgsbehauptung aus dem Plan.",
              "expectedPerformanceEn": "A supplies a metallic electron path and zinc preferentially oxidises. B lacks that path; adjacent zinc alone does not reliably protect the tank. Oxygen reduction is favoured at the oxygen-rich rim while iron can dissolve anodically in the oxygen-poor centre; coupled sites defeat the simple location rule. Maintenance checks contact, remaining mass/geometry, conductivity and potential under defined conditions; replace before depletion. Controlled loss/potential comparisons with/without contact and without zinc can test actual protection. Passivation/flow may change the outcome; a plan is not a successful trial.",
              "understandingFocusDe": "Eine Gleichstromquelle ersetzt die Zinkanode durch eine Fremdstromanlage. Begründe benötigte Polung am Stahl und warum sich der Wartungsbefund „Zinkverbrauch“ nicht einfach überträgt.",
              "understandingFocusEn": "An external DC supply replaces the sacrificial zinc system. Justify the steel polarity and explain why the zinc-consumption maintenance rule no longer transfers directly."
            }
          ]
        }
      },
      "originalReviewer": "Independent reviewer A, separate P role, Codex GPT-6 (runtime snapshot not exposed)",

          "expectations": [
            {
              "id": "whole-duty-1",
              "essentialUnderstandingDe": "Belastete gleichzeitige Messbedingungen und jeweils konstante Intervalldaten als Berechnungsannahmen angeben.",
              "essentialUnderstandingEn": "State loaded simultaneous measurement conditions and constant interval data as calculation assumptions.",
              "observablePerformanceDe": "Belastete gleichzeitige Messbedingungen und jeweils konstante Intervalldaten als Berechnungsannahmen angeben.",

      "originalWholeRecord": {
        "$schema": "https://skillpilot.com/schemas/goal-evidence/v2/goal-evidence-profile.schema.json",
        "schemaVersion": 2,
        "reviewId": "chemie-current-eight-native-positive-independent-a-20261006-v3",
        "goalFingerprintRuleVersion": "goal-evidence-v1",
        "profileRuleVersion": "positive-understanding-evidence-v2",
        "reviewCriteriaFingerprint": "sha256:4ed61d2a8c7eb84dd13315427d46989b4750f58620481e19023b145935025835",
        "landscapeId": "c436b994-8f44-5134-b9f8-0c9f5d6a5ba0",
        "goalId": "9decc36b-a69a-5599-a9f0-fcebdf0203d8",
        "goalFingerprint": "sha256:881725c14f6fdc54b32a2c1c098b57a668e39ddafb8fc4887a42642e7d18730c",
        "reviewInputFingerprint": "sha256:68757e86b56460ecba986ff0e034b557039fe2f48e227b2f47ff66cddd4e5dde",
        "profileFingerprint": "sha256:4cca77e1f59ce8ebc854a6ef028d9f4a63b1e6205842eadbed8cedc96aa0d98c",
        "status": "needs_human_review",
        "reviewAuthority": "ai_candidate",
        "reviewedAt": "2026-10-06T19:19:13.142Z",
        "reviewer": "codex-independent-targeted-positive-review-a",
        "reason": "Eigene aktuelle P-A-Fachprüfung aller vollständigen Profil-/Fallfelder: Profil-/Fallchemie bleibt KEEP; aktualisierter DE/EN-Zieltext beschreibt ausdrücklich vorgegebene Molekülpaare gleicher Konstitution und deren räumliche Anordnung. But-2-en Z/E versus Prop-1-en ohne E/Z sowie Alanin-Spiegelbild versus bloße Rotation decken Klassifikation und Begründung mit geforderter eigener räumlicher Darstellung ab. HE-LK-/Q2-Grenzen bleiben erhalten. Keine menschliche Freigabe, keine heutige Lernendenleistung, keine aktive D/P/A/M/V-Integration.",
        "evidenceLevel": "E1",
        "maximumClaimScope": "G1",
        "reviewRunIds": [],
        "dissent": [],
        "profile": {
          "archetype": "representation",
          "expectations": [
            {
              "id": "structure-model-reasoning",
              "essentialUnderstandingDe": "Stereoisomere besitzen gleiche Konnektivität, aber verschiedene räumliche Anordnung; E/Z-Geometrie und Enantiomerie entstehen aus unterschiedlichen Strukturbedingungen.",
              "essentialUnderstandingEn": "Stereoisomers have the same connectivity but different spatial arrangements; E/Z geometry and enantiomerism arise from different structural conditions.",
              "observablePerformanceDe": "Die Person begründet aus vollständigen Strukturmodellen gleiche Konnektivität, räumliche Verschiedenheit und die passende Isomerieklasse.",
              "observablePerformanceEn": "The learner justifies identical connectivity, spatial difference and the appropriate isomerism class using complete structural models."
            },
            {
              "id": "fresh-application-and-boundary",
              "essentialUnderstandingDe": "Eine andere Zeichenlage desselben Moleküls ist nicht automatisch ein Isomer; zwei gleiche Substituenten an einem Alken-C schließen E/Z in diesem einfachen Fall aus.",
              "essentialUnderstandingEn": "A different drawing orientation is not automatically an isomer; two identical substituents on one alkene C rule out E/Z in this simple case.",
              "observablePerformanceDe": "A/B bilden wegen eines tetraedrischen C mit vier verschiedenen Gruppen nicht deckungsgleiche Spiegelbilder, also Enantiomere. A/C sind nach Rotation dasselbe Molekül. Die Konnektivität bleibt in allen Modellen gleich; E/Z beschreibt diese tetraedrischen Fälle nicht. Das Material wird durch eigene räumliche Skizzen/Modellhandlungen vervollständigt; eine bloße Wiederholung des Namens Enantiomer genügt nicht.",
              "observablePerformanceEn": "A/B are nonsuperimposable mirror images because a tetrahedral C has four different groups, hence enantiomers. A/C are the same molecule after rotation. Connectivity is unchanged throughout; E/Z does not describe these tetrahedral cases. The material is completed through independent spatial sketches/model actions; merely repeating the word enantiomer is insufficient."
            }
          ],
          "coverageExpectations": {
            "requiredExpectationIds": [
              "structure-model-reasoning",
              "fresh-application-and-boundary"
            ],
            "alternativeExpectationGroups": [],
            "minimumIndependentDemonstrations": 2,
            "freshVariationRequired": true,
            "independentTransferRequired": true
          },
          "variationAxes": [
            {
              "id": "material-variation",
              "textDe": "Doppelbindungsgeometrie, tetraedrische Spiegelbilder und durch Rotation deckungsgleiche Darstellungen.",
              "textEn": "Double-bond geometry, tetrahedral mirror images and drawings superimposable through rotation."
            },
            {
              "id": "counterexample",
              "textDe": "Eine andere Zeichenlage desselben Moleküls ist nicht automatisch ein Isomer; zwei gleiche Substituenten an einem Alken-C schließen E/Z in diesem einfachen Fall aus.",
              "textEn": "A different drawing orientation is not automatically an isomer; two identical substituents on one alkene C rule out E/Z in this simple case."
            }
          ],
          "applicationCaseBriefs": [
            {
              "id": "chem-current15-9decc36b-case-1",
              "taskDemandDe": "Für But-2-en sind zwei ebene Modelle vorgegeben: in A liegen beide CH3-Gruppen auf derselben Seite von C=C, in B auf entgegengesetzten Seiten. Für Prop-1-en stehen zwei gleiche H am endständigen Alken-C. Ordne A/B dem Z/E-Typ zu und begründe, warum die gleiche Entscheidung nicht auf Prop-1-en übertragbar ist.",
              "taskDemandEn": "Two planar but-2-ene models are supplied: in A both CH3 groups are on the same side of C=C, in B on opposite sides. Prop-1-ene has two identical H at the terminal alkene C. Assign A/B to Z/E and explain why that assignment cannot be transferred to prop-1-ene.",
              "expectedPerformanceDe": "Bei But-2-en hat CH3 an jedem Alken-C höhere Priorität als H: A ist Z, B E; beide haben gleiche Konnektivität. Prop-1-en besitzt an einem Alken-C zwei gleiche H, sodass dort keine E/Z-Paarbildung möglich ist.",
              "expectedPerformanceEn": "In but-2-ene CH3 has higher priority than H at each alkene C: A is Z, B E; connectivity is identical. Prop-1-ene has two identical H at one alkene C, preventing an E/Z pair.",
              "understandingFocusDe": "HE Q1.1 weist die erweiterte E/Z-Betrachtung dem LK zu; der Fall erzeugt keine nationale GK-Pflicht.",
              "understandingFocusEn": "HE Q1.1 assigns extended E/Z to LK; this case creates no national GK obligation."
            },
            {
              "id": "chem-current15-9decc36b-case-2",
              "taskDemandDe": "Ein tetraedrisches Alaninmodell trägt am α-C NH2, H, CH3, COOH. Modell B ist das echte Spiegelbild von A; ein drittes Modell C entsteht allein durch räumliche Drehung von A. Ordne A/B und A/C ein und begründe die Unterscheidung von Spiegelung und Rotation.",
              "taskDemandEn": "A tetrahedral alanine model bears NH2, H, CH3, COOH at α-C. Model B is its actual mirror image; a third model C is obtained solely by rotating A in space. Classify A/B and A/C and explain the distinction between reflection and rotation.",
              "expectedPerformanceDe": "A/B bilden wegen eines tetraedrischen C mit vier verschiedenen Gruppen nicht deckungsgleiche Spiegelbilder, also Enantiomere. A/C sind nach Rotation dasselbe Molekül. Die Konnektivität bleibt in allen Modellen gleich; E/Z beschreibt diese tetraedrischen Fälle nicht.",
              "expectedPerformanceEn": "A/B are nonsuperimposable mirror images because a tetrahedral C has four different groups, hence enantiomers. A/C are the same molecule after rotation. Connectivity is unchanged throughout; E/Z does not describe these tetrahedral cases.",
              "understandingFocusDe": "Das Material wird durch eigene räumliche Skizzen/Modellhandlungen vervollständigt; eine bloße Wiederholung des Namens Enantiomer genügt nicht.",
              "understandingFocusEn": "The material is completed through independent spatial sketches/model actions; merely repeating the word enantiomer is insufficient."
            }
          ]
        }
      },
      "originalReviewer": "codex-independent-targeted-positive-review-a",
      "originalReviewedAt": "2026-10-06T19:19:13.142Z",
      "originalReviewId": "chemie-current-eight-native-positive-independent-a-20261006-v3",
      "originalScienceReasonRetainedOnlyHereNotInCleanInput": "Eigene aktuelle P-A-Fachprüfung aller vollständigen Profil-/Fallfelder: Profil-/Fallchemie bleibt KEEP; aktualisierter DE/EN-Zieltext beschreibt ausdrücklich vorgegebene Molekülpaare gleicher Konstitution und deren räumliche Anordnung. But-2-en Z/E versus Prop-1-en ohne E/Z sowie Alanin-Spiegelbild versus bloße Rotation decken Klassifikation und Begründung mit geforderter eigener räumlicher Darstellung ab. HE-LK-/Q2-Grenzen bleiben erhalten. Keine menschliche Freigabe, keine heutige Lernendenleistung, keine aktive D/P/A/M/V-Integration.",
      "embeddedOriginalSciencePathPins": [],

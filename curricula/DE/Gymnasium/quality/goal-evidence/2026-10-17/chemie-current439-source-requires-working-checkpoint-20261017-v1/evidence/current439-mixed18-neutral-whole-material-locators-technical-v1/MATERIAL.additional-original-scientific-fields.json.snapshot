      "scientificMaterial": {
        "id": "energy20-06-b",
        "goalId": "d465d82b-4bf2-5527-bb7c-dad5a92605fe",
        "title": "pH-abhängigeAmine und Zwitterionen",
        "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
        "imageRequired": false,
        "materialsDe": "Eigene Karten: E=C12H25NH2, unterpH9 überwiegendC12H25NH3+; F=C12H25N+(CH3)2−CH2COO− bei Modell-pH7; G=C12H25N+(CH3)3 bleibt beipH7/12 positiv. Diese pH-Eigenschaften sind bereitgestellte Stoffdaten. Partnerziel e874 trägt den zwitterionischen Quellenanteil.",
        "materialsEn": "Own cards:E=C12H25NH2,largelyC12H25NH3+ belowpH9;F=C12H25N+(CH3)2−CH2COO− at modelpH7;G=C12H25N+(CH3)3 remains positive atpH7/12 here. ThepH behaviour is supplied substance data,not inferred from tail length. Partnere874 carries the zwitterionic source clause.",
        "taskDe": "VergleicheE undG bei pH-Wechsel und charakterisiereF gegenüber dem nichtionischenC aus6a. Warum bedeutet Nettoladung0 nicht Ladungsfreiheit? Erhalte den zusätzlichen Quellenpartner, statt die ganze Vierklassenquelle allein d465 zuzuschreiben.",
        "taskEn": "CompareE/G acrosspH and characteriseF without equating it with nonionicC. Explain why net zero onF does not mean no charges. Distinguish this partner’s zwitterion clause from d465’s three-class goal;do not remove the source partner.",
        "workedReasoningDe": "E wird durch Protonierung kationisch; höhererpH verschiebt zum ungeladenen Amin. G ist quartär und nicht dasselbe Säure-Base-Paar. F trägt gleichzeitig positive und negative Kopfstellen und ist zwitterionisch, nicht nichtionisch. D465 umfasst drei Klassen; derBB/BE-Vierklassenbullet bleibt nur mit dem Partner gedeckt. OhnepH istE nicht eindeutig als permanent kationisch einzuordnen.",
        "workedReasoningEn": "E can become cationic by protonation;higherpH shifts toward uncharged amine. G is quaternary,not the same acid-base pair. F simultaneously contains positive and negative head sites;net zero is zwitterionic,not nonionic. D465 still assesses structural characterisation of anionic/cationic/nonionic species;the BB/BE four-class source clause requires its whole partner union,not d465 alone.",
        "freshIndependentTransferDe": "Für eine neue Probe fehltpH. Welche Bedingung braucht dieE-Zuordnung, welcheG-Aussage bleibt dennoch gültig?",
        "freshIndependentTransferEn": "A sample has no reportedpH. Identify the missing condition forE and the unchanged statement aboutG;avoid assigning every amine a pH-independent class.",
        "criterionToObservableRubric": [
          {
            "criterionId": "e1",
            "observableDe": "Protonierbares Amin von quartärem Ammonium unterscheiden.",
            "observableEn": "Distinguish protonatable amine from quaternary ammonium.",
            "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
          },
          {
            "criterionId": "e2",
            "observableDe": "Zwitterionische Ladungstrennung von Nichtionizität abgrenzen.",
            "observableEn": "Distinguish zwitterionic charge separation from nonionic structure.",
            "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
          },
          {
            "criterionId": "e3",
            "observableDe": "pH-/Stoffdatengrenze und Quellenpartner erhalten.",
            "observableEn": "Retain substance-data/pH limits and source partners.",
            "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
          }
        ]
      }
    },

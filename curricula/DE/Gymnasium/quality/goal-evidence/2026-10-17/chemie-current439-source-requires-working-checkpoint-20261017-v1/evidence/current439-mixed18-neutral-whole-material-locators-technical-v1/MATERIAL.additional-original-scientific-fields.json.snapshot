      ],
      "scientificMaterial": {
        "caseId": "b208b1a5-case-1",
        "goalId": "b208b1a5-c609-53a1-8add-979417a93b7d",
        "titleDe": "Anionischer Farbstoff auf Wolle",
        "titleEn": "Anionic dye on wool",
        "dataOrigin": "Original invented idealized teaching data unless an explicitly attributed primary reference is named; no measured experiment or learner result",
        "languageParity": "Complete DE/EN data, task, answer, rubric and demand spans",
        "dataDe": "Modell im sauren Färbebad: Wollprotein trägt –NH₃⁺-Gruppen; Baumwollcellulose überwiegend ungeladene –OH-Gruppen. Farbstoff D besitzt zwei –SO₃⁻-Gruppen und H-Brücken-Akzeptoren. Beide Proben werden gleich gespült; keine kovalente Reaktion.",
        "dataEn": "Model in an acidic dye bath: wool protein carries –NH₃⁺ groups; cotton cellulose has mostly uncharged –OH groups. Dye D has two –SO₃⁻ groups and hydrogen-bond acceptors. Both samples are rinsed equally; no covalent reaction.",
        "taskDe": "1. Beschreibe die elektrostatischen und möglichen Wasserstoffbrücken-Wechselwirkungen von D mit beiden Fasern; unterscheide sie von kovalenter Bindung.\n2. Beurteile die bevorzugte Eignung für Wolle gegenüber Baumwolle unter den angegebenen Bedingungen und nenne eine Grenze der Waschbeständigkeitsvorhersage.",
        "taskEn": "1. Describe electrostatic and possible hydrogen-bond interactions of D with both fibers; distinguish them from covalent bonding.\n2. Assess preferred suitability for wool rather than cotton under these conditions and state one limit of predicting wash resistance.",
        "modelAnswerDe": "1. D⁻-Gruppen werden von Woll–NH₃⁺ elektrostatisch angezogen. Zusätzlich sind H-Brücken zwischen geeigneten Faser-Donoren und D-Akzeptoren möglich. Cellulose bietet –OH für H-Brücken, aber hier keine positiven Fixierstellen. Keine der Wechselwirkungen ist eine neu gebildete kovalente Farbstoff-Faser-Bindung.\n2. Wolle besitzt hier zusätzliche ionische Anziehung und ist daher günstiger für D. Dies ist keine Garantie: konkrete Bindungsstärke, Farbstoffgröße, pH des Waschbads oder Konkurrenz durch Wasser fehlen. Die bloße Anzahl von –OH-Gruppen belegt keine stärkere Fixierung an Baumwolle.",
        "modelAnswerEn": "1. D anionic groups are electrostatically attracted to wool –NH₃⁺. Hydrogen bonds may also form between suitable fiber donors and dye acceptors. Cellulose offers –OH groups for hydrogen bonding but no positive fixation sites here. Neither interaction is a newly formed covalent dye-fiber bond.\n2. Wool provides additional ionic attraction and is favored for D here. This is not a guarantee: actual interaction strength, dye size, wash-bath pH or competition from water are unknown. Merely counting –OH groups does not establish stronger cotton fixation.",
        "expectationIds": [
          "e1",
          "e2"
        ],
        "visualizationRequired": false,
        "practicalExecutionRequired": false,
        "rubric": [
          {
            "criterionId": "b208b1a5-case-1-r1",
            "expectationIds": [
              "e1"
            ],
            "taskClauseDe": "Beschreibe die elektrostatischen und möglichen Wasserstoffbrücken-Wechselwirkungen von D mit beiden Fasern; unterscheide sie von kovalenter Bindung.",
            "taskClauseEn": "Describe electrostatic and possible hydrogen-bond interactions of D with both fibers; distinguish them from covalent bonding.",
            "criterionDe": "D⁻-Gruppen werden von Woll–NH₃⁺ elektrostatisch angezogen. Zusätzlich sind H-Brücken zwischen geeigneten Faser-Donoren und D-Akzeptoren möglich. Cellulose bietet –OH für H-Brücken, aber hier keine positiven Fixierstellen. Keine der Wechselwirkungen ist eine neu gebildete kovalente Farbstoff-Faser-Bindung.",
            "criterionEn": "D anionic groups are electrostatically attracted to wool –NH₃⁺. Hydrogen bonds may also form between suitable fiber donors and dye acceptors. Cellulose offers –OH groups for hydrogen bonding but no positive fixation sites here. Neither interaction is a newly formed covalent dye-fiber bond.",
            "maximumPoints": 2,
            "partialCreditDe": "1 Punkt für einen fachlich richtigen, ausdrücklich verlangten Teil; 2 für den vollständigen Nachweis; 0 für fehlenden oder falschen Nachweis. Ausführungspunkte setzen die benannte reale Beobachtung voraus.",
            "partialCreditEn": "1 point for a correct explicitly requested part; 2 for complete evidence; 0 for missing or wrong evidence. Execution credit requires the stated real observation.",
            "creditBasis": "written-explicit-task",
            "taskSpanDe": {
              "start": 3,
              "end": 151
            },
            "taskSpanEn": {
              "start": 3,
              "end": 128
            }
          },
          {
            "criterionId": "b208b1a5-case-1-r2",
            "expectationIds": [
              "e2"
            ],
            "taskClauseDe": "Beurteile die bevorzugte Eignung für Wolle gegenüber Baumwolle unter den angegebenen Bedingungen und nenne eine Grenze der Waschbeständigkeitsvorhersage.",
            "taskClauseEn": "Assess preferred suitability for wool rather than cotton under these conditions and state one limit of predicting wash resistance.",
            "criterionDe": "Wolle besitzt hier zusätzliche ionische Anziehung und ist daher günstiger für D. Dies ist keine Garantie: konkrete Bindungsstärke, Farbstoffgröße, pH des Waschbads oder Konkurrenz durch Wasser fehlen.",
            "criterionEn": "Wool provides additional ionic attraction and is favored for D here. This is not a guarantee: actual interaction strength, dye size, wash-bath pH or competition from water are unknown.",
            "maximumPoints": 2,
            "partialCreditDe": "1 Punkt für einen fachlich richtigen, ausdrücklich verlangten Teil; 2 für den vollständigen Nachweis; 0 für fehlenden oder falschen Nachweis. Ausführungspunkte setzen die benannte reale Beobachtung voraus.",
            "partialCreditEn": "1 point for a correct explicitly requested part; 2 for complete evidence; 0 for missing or wrong evidence. Execution credit requires the stated real observation.",
            "creditBasis": "written-explicit-task",
            "taskSpanDe": {
              "start": 155,
              "end": 308
            },
            "taskSpanEn": {
              "start": 132,
              "end": 262
            }
          }
        ],
        "maximumPoints": 4,
        "optionalModelRemarksDe": [
          {
            "text": "Die bloße Anzahl von –OH-Gruppen belegt keine stärkere Fixierung an Baumwolle.",
            "graded": false,
            "criterionId": "b208b1a5-case-1-r2"
          }
        ],
        "optionalModelRemarksEn": [
          {
            "text": "Merely counting –OH groups does not establish stronger cotton fixation.",
            "graded": false,
            "criterionId": "b208b1a5-case-1-r2"
          }
        ],
        "gradingBoundary": "Only explicitly demanded evidence earns credit. A case maps requested aspects, not automatic full profile completion. Observe practical actions separately; missing actual observation means those points remain unavailable."
      }

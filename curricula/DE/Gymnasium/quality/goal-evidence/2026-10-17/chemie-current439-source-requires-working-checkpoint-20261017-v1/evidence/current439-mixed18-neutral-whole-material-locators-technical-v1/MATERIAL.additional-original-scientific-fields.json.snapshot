      "scientificMaterial": {
        "caseId": "chem-current15-b8d3b453-case-1",
        "goalId": "b8d3b453-d638-5518-aab0-d84ec2e8567c",
        "materialKind": "explicit_authored_school_model_case",
        "material": {
          "de": "Papiervergleich: Ethen wird im einfachen Modell mit Br2 addiert. Für Benzen ist eine elektrophile Bromierung mit geeignetem Lewis-Säure-Katalysator als Reaktionsbedingung vorgegeben.",
          "en": "Paper comparison: ethene undergoes simple addition with Br2. For benzene, electrophilic bromination with an appropriate Lewis-acid catalyst is specified."
        },
        "taskDemand": {
          "de": "Erkläre, warum bei Benzen die Substitution fachlich sinnvoll ist, und markiere den vorübergehenden Verlust und die Wiederherstellung des aromatischen Systems.",
          "en": "Explain why substitution is appropriate for benzene and mark temporary loss and restoration of the aromatic system."
        },
        "expectedPerformance": {
          "de": "Der elektrophile Angriff erzeugt ein nicht vollständig aromatisches σ-Komplex-Modell. Abgabe des H+ am substituierten C stellt die delokalisierte π-Struktur wieder her; insgesamt ersetzt Br ein H. Eine vollständige Addition würde das aromatische System dauerhaft verändern.",
          "en": "Electrophilic attack gives a nonfully aromatic σ-complex model. Loss of H+ from the substituted C restores delocalized π structure; overall Br replaces H. Full addition would persistently alter the aromatic system."
        },
        "specificBoundaryOrCounterexample": {
          "de": "Reaktionsbedingungen sind gegeben; aus dem Benzen-Strukturbild wird keine Reaktion ohne geeignete Aktivierung behauptet.",
          "en": "Conditions are specified; the benzene structure alone is not claimed to react without appropriate activation."
        },
        "sourceRequirementReference": {
          "jurisdiction": "DE-HE",
          "stage": "SekII",
          "physicalPages": [
            38
          ],
          "printedPages": [
            38
          ],
          "topicCode": "Q1.1",
          "courseScope": "LK",
          "limit": "Aromatic structure/reactivity and electrophilic substitution; no broad GK obligation.",
          "sourceDecision": "AUTHOR_SCOPE_INPUT_NOT_INDEPENDENT_SOURCE_APPROVAL",
          "activeSourceMappingsUnchanged": true
        }
      }
    },

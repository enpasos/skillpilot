      "scientificMaterial": {
        "caseId": "q3-17-a",
        "goalId": "94a62b39-d4a2-5882-99d1-6886ead07726",
        "title": {
          "de": "Beschichtung und Opferanode vergleichen",
          "en": "Compare coating and sacrificial anode"
        },
        "material": {
          "de": "Modell Stahlteil in neutraler feuchter Umgebung. Optionen: Polymerbeschichtung Kosten2, intakt Barriere, beschädigt lokale freie Fe-Fläche; Zn-Opferanode Kosten3, metallisch gekoppelt und ionischer Kontakt, Zn²⁺/Zn−0,76V<Fe²⁺/Fe−0,44V, begrenzter Verbrauchsvorrat. Umweltbelastungen von Beschichtung und Metallfreisetzung sind nicht quantitativ gegeben.",
          "en": "Model steel part in neutral moist environment. Options:polymer coating cost2,intact barrier,damaged local exposedFe area;Zn sacrificial anode cost3,metallic coupling and ionic contact,Zn²⁺/Zn−0.76V<Fe²⁺/Fe−0.44V,finite consumable supply. Environmental impacts of coating and metal release are not quantified."
        },
        "task": {
          "de": "Erläutere passive und aktive Schutzmechanismen einschließlich Schutzfilm,galvanischer Kopplung und Opferanode. Bewerte ökologisch und ökonomisch unter Beschädigungs-/Wartungsbedingungen.",
          "en": "Explain passive and active protection including protective film,galvanic coupling and sacrificial anode. Evaluate ecologically and economically under damage/maintenance conditions."
        },
        "modelResponse": {
          "de": "Intakte Beschichtung trennt Fe von Umgebung; dichte Schutzschichten hemmen Transport. Beschädigung kann Barrierewirkung verlieren. Zn oxidiert gekoppelt als Anode, liefert Elektronen an kathodisch geschütztes Fe; Lösung trägt Ionen. Zn wird verbraucht, deshalb Wartung nötig. Beschichtung ist günstiger, Opferanode kann Defekte tolerieren, beide haben Material-/Entsorgungsaufwand. Ohne Umweltzahlen ist kein allgemeiner Gesamtsieger begründet; Lebensdauer und Wartungszugang bestimmen das Urteil.",
          "en": "Intact coating separatesFe from environment;dense protective layers inhibit transport. Damage can remove barrier protection. CoupledZn oxidizes as anode,supplying electrons to cathodically protectedFe;solution carries ions. Zn is consumed,so maintenance is needed. Coating is cheaper,sacrificial anode may tolerate defects,and both have material/disposal demand. Without environmental numbers no universal winner is justified;service life and maintenance access shape judgment."
        },
        "scoring": {
          "maximumPoints": 10,
          "criteria": [
            {
              "id": "c1",
              "points": 2,
              "criterion": {
                "de": "Passive Barriere/Schutzfilm und Defektgrenze erklären.",
                "en": "Explain passive barrier/film and defect limit."
              }
            },
            {
              "id": "c2",
              "points": 2,
              "criterion": {
                "de": "Galvanische Polarität,Elektronen-/Ionenweg richtig.",
                "en": "Give correct galvanic polarity,electron/ion paths."
              }
            },
            {
              "id": "c3",
              "points": 2,
              "criterion": {
                "de": "Opferanodenverbrauch und Wartung erläutern.",
                "en": "Explain sacrificial-anode consumption and maintenance."
              }
            },
            {
              "id": "c4",
              "points": 2,
              "criterion": {
                "de": "Ökologie/Ökonomie materialgestützt bedingt abwägen.",
                "en": "Weigh ecology/economics conditionally using material."
              }
            },
            {
              "id": "fresh-transfer",
              "points": 2,
              "criterion": {
                "de": "Nein; aktive Elektronenquelle fehlt, passive Barriere ist lokal offen. Eine konkrete Wartungs-/Neubewertung ist nötig, kein unbefristeter Schutz.",
                "en": "No;active electron source is absent and passive barrier locally open. Specific maintenance/reassessment is needed,no indefinite protection."
              }
            }
          ],
          "rule": {
            "de": "Punkte ausschließlich für ausdrücklich gezeigte Fachleistung. Volle Punkte pro Kriterium nur bei Begründung und korrekter Darstellung; ein richtiger Fachbegriff allein genügt nicht. Modellantworten sind Autorenbeispiele, keine Lernendenleistung.",
            "en": "Award points only for explicitly demonstrated scientific performance. Full credit per criterion requires reasoning and correct representation; a correct term alone is insufficient. Model responses are author examples, not learner performance."
          }
        },
        "freshTransfer": {
          "task": {
            "de": "Frisch: Zn ist verbraucht; Beschichtung beschädigt. Besteht Schutz automatisch weiter?",
            "en": "Fresh:Zn is consumed and coating damaged. Does protection automatically continue?"
          },
          "modelResponse": {
            "de": "Nein; aktive Elektronenquelle fehlt, passive Barriere ist lokal offen. Eine konkrete Wartungs-/Neubewertung ist nötig, kein unbefristeter Schutz.",
            "en": "No;active electron source is absent and passive barrier locally open. Specific maintenance/reassessment is needed,no indefinite protection."
          },
          "independentAdministration": true,
          "releaseModelOnlyAfterSubmission": true
        }
      }
    },

      "scientificMaterial": {
        "caseId": "chem-current15-9decc36b-case-1",
        "goalId": "9decc36b-a69a-5599-a9f0-fcebdf0203d8",
        "materialKind": "explicit_authored_school_model_case",
        "material": {
          "de": "Für But-2-en sind zwei ebene Modelle vorgegeben: in A liegen beide CH3-Gruppen auf derselben Seite von C=C, in B auf entgegengesetzten Seiten. Für Prop-1-en stehen zwei gleiche H am endständigen Alken-C.",
          "en": "Two planar but-2-ene models are supplied: in A both CH3 groups are on the same side of C=C, in B on opposite sides. Prop-1-ene has two identical H at the terminal alkene C."
        },
        "taskDemand": {
          "de": "Ordne A/B dem Z/E-Typ zu und begründe, warum die gleiche Entscheidung nicht auf Prop-1-en übertragbar ist.",
          "en": "Assign A/B to Z/E and explain why that assignment cannot be transferred to prop-1-ene."
        },
        "expectedPerformance": {
          "de": "Bei But-2-en hat CH3 an jedem Alken-C höhere Priorität als H: A ist Z, B E; beide haben gleiche Konnektivität. Prop-1-en besitzt an einem Alken-C zwei gleiche H, sodass dort keine E/Z-Paarbildung möglich ist.",
          "en": "In but-2-ene CH3 has higher priority than H at each alkene C: A is Z, B E; connectivity is identical. Prop-1-ene has two identical H at one alkene C, preventing an E/Z pair."
        },
        "specificBoundaryOrCounterexample": {
          "de": "HE Q1.1 weist die erweiterte E/Z-Betrachtung dem LK zu; der Fall erzeugt keine nationale GK-Pflicht.",
          "en": "HE Q1.1 assigns extended E/Z to LK; this case creates no national GK obligation."
        },
        "sourceRequirementReference": {
          "jurisdiction": "DE-HE",
          "stage": "SekII",
          "physicalPages": [
            38,
            42
          ],
          "printedPages": [
            38,
            42
          ],
          "topicCode": "Q1.1; Q2.1",
          "courseScope": "E_Z_Q1_LK_enantiomer_Q2_GK_LK",
          "limit": "E/Z geometry and enantiomerism in bounded contexts. These locations do not certify all stereochemical subtypes or national grade coverage.",
          "sourceDecision": "AUTHOR_SCOPE_INPUT_NOT_INDEPENDENT_SOURCE_APPROVAL",
          "activeSourceMappingsUnchanged": true
        }
      }
    },

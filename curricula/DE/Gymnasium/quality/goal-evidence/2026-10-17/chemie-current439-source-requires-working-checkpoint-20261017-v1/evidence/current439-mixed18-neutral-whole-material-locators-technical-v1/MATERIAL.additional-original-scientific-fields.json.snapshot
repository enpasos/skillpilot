      "scientificMaterial": {
        "caseId": "q3-17-b",
        "goalId": "94a62b39-d4a2-5882-99d1-6886ead07726",
        "title": {
          "de": "Edle Beschichtung kann am Defekt schaden",
          "en": "Noble coating can harm at a defect"
        },
        "material": {
          "de": "Fiktiver Stahl:OptionA Cu-Beschichtung Kosten2,OptionB Zn-Beschichtung Kosten3,OptionC dichte haftende Oxid-/Polymerbarriere Kosten2,5. Metallkontakt und leitende Feuchtigkeit am Defekt. E°Zn−0,76,Fe−0,44,Cu+0,34V; Film-/Oberflächeneffekte hier vernachlässigt.",
          "en": "Fictional steel:optionA Cu coating cost2,optionB Zn coating cost3,optionC dense adhering oxide/polymer barrier cost2.5. Metallic contact and conducting moisture at defect. E°Zn−0.76,Fe−0.44,Cu+0.34V;film/surface effects neglected here."
        },
        "task": {
          "de": "Erkläre intakte passive Wirkung,aktive Schutzwirkung und galvanischen Defektfall für alle Optionen. Beurteile Kosten,Materialverbrauch und Umweltdatenbedarf.",
          "en": "Explain intact passive effect,active protection and galvanic defect case for all options. Evaluate cost,material consumption and environmental data needs."
        },
        "modelResponse": {
          "de": "Intakt dienen alle Beschichtungen als Barriere. Am Cu-Defekt ist Fe Anode,Cu Kathode; Elektronen Fe→Cu können Fe-Angriff verstärken. Am Zn-Defekt oxidiertZn und schütztFe kathodisch,solange metallischer/ionischer Kontakt und Vorrat bestehen. C wirkt über Filmbarriere,keine automatisch zugesicherte Opferwirkung. Zn-Verbrauch und Erneuerung kosten Material;Cu kostet weniger im Modell,Defektschaden kann Lebenszykluskosten erhöhen. Ökologisches Urteil braucht Herstellung,Freisetzung und Entsorgung.",
          "en": "When intact all coatings act as barriers. At aCu defectFe is anode,Cu cathode;electronsFe→Cu may intensifyFe attack. At aZn defectZn oxidizes and protectsFe cathodically while metallic/ionic contact and supply persist. C acts through film barrier,without guaranteed sacrificial action. Zn consumption and renewal use material;Cu is cheaper in the model but defect damage may raise life-cycle cost. Ecological judgment needs manufacture,release and disposal."
        },
        "scoring": {
          "maximumPoints": 10,
          "criteria": [
            {
              "id": "c1",
              "points": 2,
              "criterion": {
                "de": "Barriere/Filmwirkung aller Optionen erklären.",
                "en": "Explain barrier/film action of all options."
              }
            },
            {
              "id": "c2",
              "points": 2,
              "criterion": {
                "de": "Cu-Defekt als schädliche galvanische Kopplung deuten.",
                "en": "InterpretCu defect as harmful galvanic coupling."
              }
            },
            {
              "id": "c3",
              "points": 2,
              "criterion": {
                "de": "Zn-Opferwirkung mit richtiger Elektronenrichtung erklären.",
                "en": "ExplainZn sacrificial action with correct electron direction."
              }
            },
            {
              "id": "c4",
              "points": 2,
              "criterion": {
                "de": "Kosten und Umwelturteil mit Grenzen begründen.",
                "en": "Explain cost and environmental judgment with limits."
              }
            },
            {
              "id": "fresh-transfer",
              "points": 2,
              "criterion": {
                "de": "Nein; ElektronenwegZn→Fe fehlt. Eine intakte isolierte Schicht kann noch passiv abschirmen,was eine andere Schutzwirkung ist.",
                "en": "No;the electron pathZn→Fe is absent. An intact isolated layer may still provide passive shielding,which is a different protection effect."
              }
            }
          ],
          "rule": {
            "de": "Punkte ausschließlich für ausdrücklich gezeigte Fachleistung. Volle Punkte pro Kriterium nur bei Begründung und korrekter Darstellung; ein richtiger Fachbegriff allein genügt nicht. Modellantworten sind Autorenbeispiele, keine Lernendenleistung.",
            "en": "Award points only for explicitly demonstrated scientific performance. Full credit per criterion requires reasoning and correct representation; a correct term alone is insufficient. Model responses are author examples, not learner performance."
          }
        },
        "freshTransfer": {
          "task": {
            "de": "Frisch: Zn-Schicht elektrisch von Fe isoliert. Gibt es weiterhin aktive Opferanodenwirkung?",
            "en": "Fresh:Zn coating electrically isolated fromFe. Does active sacrificial protection persist?"
          },
          "modelResponse": {
            "de": "Nein; ElektronenwegZn→Fe fehlt. Eine intakte isolierte Schicht kann noch passiv abschirmen,was eine andere Schutzwirkung ist.",
            "en": "No;the electron pathZn→Fe is absent. An intact isolated layer may still provide passive shielding,which is a different protection effect."
          },
          "independentAdministration": true,
          "releaseModelOnlyAfterSubmission": true
        }
      }
    },

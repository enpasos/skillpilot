      "scientificMaterial": {
        "caseId": "chem-current15-b8d3b453-case-2",
        "goalId": "b8d3b453-d638-5518-aab0-d84ec2e8567c",
        "materialKind": "explicit_authored_school_model_case",
        "material": {
          "de": "Ein Autor schlägt für die Erstbromierung C6H6 + Br2 → C6H6Br2 vor, zeichnet aber anschließend einen aromatischen Brombenzenring C6H5Br und HBr.",
          "en": "An author proposes C6H6 + Br2 → C6H6Br2 for initial bromination but then draws aromatic bromobenzene C6H5Br and HBr."
        },
        "taskDemand": {
          "de": "Behebe den Widerspruch zwischen Stoffbilanz und Modell und begründe, welche Beschreibung das aromatische Endprodukt erhält.",
          "en": "Resolve the contradiction between stoichiometry and model and justify which description preserves the aromatic final product."
        },
        "expectedPerformance": {
          "de": "Für die vorgegebene elektrophile Substitution lautet die Gesamtbilanz C6H6 + Br2 → C6H5Br + HBr. Der H-Verlust und die Wiederherstellung der π-Delokalisierung gehören zusammen. Die Additionsformel C6H6Br2 beschreibt nicht das gezeichnete Substitutionsprodukt.",
          "en": "For the specified electrophilic substitution the overall balance is C6H6 + Br2 → C6H5Br + HBr. H loss and restored π delocalization belong together. The addition formula C6H6Br2 does not describe the drawn substitution product."
        },
        "specificBoundaryOrCounterexample": {
          "de": "Andere Reaktionsbedingungen können andere Vorgänge ermöglichen; der Fall prüft nur die ausdrücklich vorgegebene elektrophile Erstsubstitution.",
          "en": "Other conditions may permit different processes; this case addresses only the explicitly specified initial electrophilic substitution."
        },
        "sourceRequirementReference": {
          "jurisdiction": "DE-HE",
          "stage": "SekII",
          "physicalPages": [
            38
          ],
          "printedPages": [
            38
          ],
          "topicCode": "Q1.1",
          "courseScope": "LK",
          "limit": "Aromatic structure/reactivity and electrophilic substitution; no broad GK obligation.",
          "sourceDecision": "AUTHOR_SCOPE_INPUT_NOT_INDEPENDENT_SOURCE_APPROVAL",
          "activeSourceMappingsUnchanged": true
        }
      }
    },

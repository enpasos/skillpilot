      "scientificMaterial": {
        "caseId": "chem-current15-9decc36b-case-2",
        "goalId": "9decc36b-a69a-5599-a9f0-fcebdf0203d8",
        "materialKind": "explicit_authored_school_model_case",
        "material": {
          "de": "Ein tetraedrisches Alaninmodell trägt am α-C NH2, H, CH3, COOH. Modell B ist das echte Spiegelbild von A; ein drittes Modell C entsteht allein durch räumliche Drehung von A.",
          "en": "A tetrahedral alanine model bears NH2, H, CH3, COOH at α-C. Model B is its actual mirror image; a third model C is obtained solely by rotating A in space."
        },
        "taskDemand": {
          "de": "Ordne A/B und A/C ein und begründe die Unterscheidung von Spiegelung und Rotation.",
          "en": "Classify A/B and A/C and explain the distinction between reflection and rotation."
        },
        "expectedPerformance": {
          "de": "A/B bilden wegen eines tetraedrischen C mit vier verschiedenen Gruppen nicht deckungsgleiche Spiegelbilder, also Enantiomere. A/C sind nach Rotation dasselbe Molekül. Die Konnektivität bleibt in allen Modellen gleich; E/Z beschreibt diese tetraedrischen Fälle nicht.",
          "en": "A/B are nonsuperimposable mirror images because a tetrahedral C has four different groups, hence enantiomers. A/C are the same molecule after rotation. Connectivity is unchanged throughout; E/Z does not describe these tetrahedral cases."
        },
        "specificBoundaryOrCounterexample": {
          "de": "Das Material wird durch eigene räumliche Skizzen/Modellhandlungen vervollständigt; eine bloße Wiederholung des Namens Enantiomer genügt nicht.",
          "en": "The material is completed through independent spatial sketches/model actions; merely repeating the word enantiomer is insufficient."
        },
        "sourceRequirementReference": {
          "jurisdiction": "DE-HE",
          "stage": "SekII",

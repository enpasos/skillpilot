        "expectations": [
          {
            "id": "b003-e5aefd51-core",
            "essentialUnderstandingDe": "Radikalische Substitution umfasst Initiation durch homolytische Spaltung, Kettenfortpflanzung mit Radikalverbrauch und -neubildung sowie mögliche Kettenabbrüche durch Rekombination.",
            "essentialUnderstandingEn": "Radical substitution involves initiation by homolytic cleavage, propagation that consumes and regenerates radicals, and possible termination by recombination.",
            "observablePerformanceDe": "Konstruiert selbst vollständige Chlorierungs- und Bromierungsketten mit ungepaarten Elektronen, Zwischenradikalen, Regeneration und echtem Abbruch. Die Klassifikation einer gegebenen Propagation genügt nicht.",
            "observablePerformanceEn": "Independently constructs complete chlorination and bromination chains with unpaired electrons, intermediate radicals, regeneration and genuine termination. Classifying a supplied propagation step is insufficient."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b003-e5aefd51-core"
          ],

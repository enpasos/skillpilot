      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "content-specific-understanding",
            "essentialUnderstandingDe": "Ionen tragen durch Elektronenabgabe/-aufnahme elektrische Ladung; in Salzlösungen transportieren bewegliche Kationen und Anionen Ladung, im festen Ionengitter bleiben sie gebunden.",
            "essentialUnderstandingEn": "Ions carry charge after electron loss/gain; mobile cations and anions transport charge in salt solutions, whereas ions remain bound in the solid lattice.",
            "observablePerformanceDe": "Na+ Kation, Cl− Anion; Protonenzahl unverändert. Gelöste Na+ wandern zum negativen, Cl− zum positiven Pol; beide tragen zum Ladungstransport bei. Im festen Gitter fehlt diese freie Ionenbeweglichkeit.",
            "observablePerformanceEn": "Na+ is cation, Cl− anion; proton counts remain unchanged. Dissolved Na+ migrates to the negative and Cl− to the positive pole; both contribute to charge transport. Solid-lattice ions lack this mobility."
          },
          {
            "id": "fresh-transfer-and-model-boundary",
            "essentialUnderstandingDe": "Geringe Leitfähigkeit der konkreten Zuckerlösung beweist nicht, dass jede molekulare Verbindung in Wasser un-ionisiert bleibt; Säuren bilden eine andere Fallgrenze.",
            "essentialUnderstandingEn": "Low conductivity in this sugar case does not establish that every molecular compound stays un-ionised in water; acids are a different case.",
            "observablePerformanceDe": "2+(−1)+(−1)=0. Mg2+ wandert zum negativen, Cl− zum positiven Pol; im Vergleich sind mobile Ladungsträger im Salzfall vorhanden. Zuckermoleküle liefern hier keine solchen Ionen. Beim Salzlösen werden vorhandene Gitterionen hydratisiert, keine Protonen umgewandelt.",
            "observablePerformanceEn": "2+(−1)+(−1)=0. Mg2+ moves towards the negative, Cl− the positive pole; the salt case has mobile carriers. Sugar molecules here do not supply such ions. Dissolution hydrates existing lattice ions rather than transforming protons."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "content-specific-understanding",
            "fresh-transfer-and-model-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "specific-material-variation",
            "textDe": "Na+/Cl− gegenüber Mg2+/Cl−; ionische und nichtionische Lösung, fest und gelöst.",
            "textEn": "Na+/Cl− versus Mg2+/Cl−; ionic versus nonionic solution, solid versus dissolved."
          },
          {
            "id": "specific-model-limit",
            "textDe": "Geringe Leitfähigkeit der konkreten Zuckerlösung beweist nicht, dass jede molekulare Verbindung in Wasser un-ionisiert bleibt; Säuren bilden eine andere Fallgrenze.",
            "textEn": "Low conductivity in this sugar case does not establish that every molecular compound stays un-ionised in water; acids are a different case."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-next25-4285d84a-case-1",
            "taskDemandDe": "Modell:Na verliert1 Elektron, Cl nimmt1 auf. Vorgegebene Beobachtung: festes NaCl geringe Leitfähigkeit, NaCl-Lösung deutlich höhere. Elektrolysezelle: links negativer, rechts positiver Pol. Erkläre Ladungsbildung, benenne die Ionen und zeichne ihre Wanderungsrichtungen im elektrischen Feld.",
            "taskDemandEn": "Model:Na loses1 electron, Cl gains1. Supplied observation: solid NaCl poorly conducts; its solution conducts much better. Electrolysis cell: left negative, right positive pole. Explain charge formation, name the ions and draw migration directions in the electric field.",
            "expectedPerformanceDe": "Na+ Kation, Cl− Anion; Protonenzahl unverändert. Gelöste Na+ wandern zum negativen, Cl− zum positiven Pol; beide tragen zum Ladungstransport bei. Im festen Gitter fehlt diese freie Ionenbeweglichkeit.",
            "expectedPerformanceEn": "Na+ is cation, Cl− anion; proton counts remain unchanged. Dissolved Na+ migrates to the negative and Cl− to the positive pole; both contribute to charge transport. Solid-lattice ions lack this mobility.",
            "understandingFocusDe": "Strom in der Lösung bedeutet nicht, dass freie Elektronen wie in einem Metalldraht durch Wasser laufen.",
            "understandingFocusEn": "Current in solution does not mean free electrons flowing through water as through a metal wire."
          },
          {
            "id": "chem-next25-4285d84a-case-2",
            "taskDemandDe": "Frischer Vergleich:MgCl2-Lösung enthält Mg2+ und2Cl− pro Verhältnisformel. Eine Zuckerlösung enthält hier ungeladene gelöste Moleküle, kein vorgegebenes Ionisationsmodell. Bilanzierte Ladungen, Richtung beider Ionen und einen begründeten Leitfähigkeitsvergleich angeben. Trenne Lösen eines Salzes von Bildung neuer Atom-Ionen aus Elementen.",
            "taskDemandEn": "Fresh comparison:MgCl2 solution contains Mg2+ and2Cl− per formula unit. The sugar solution here has uncharged dissolved molecules and no supplied ionisation model. Give balanced charges, directions of both ions and a justified conductivity comparison. Distinguish dissolving a salt from forming new atomic ions from elements.",
            "expectedPerformanceDe": "2+(−1)+(−1)=0. Mg2+ wandert zum negativen, Cl− zum positiven Pol; im Vergleich sind mobile Ladungsträger im Salzfall vorhanden. Zuckermoleküle liefern hier keine solchen Ionen. Beim Salzlösen werden vorhandene Gitterionen hydratisiert, keine Protonen umgewandelt.",
            "expectedPerformanceEn": "2+(−1)+(−1)=0. Mg2+ moves towards the negative, Cl− the positive pole; the salt case has mobile carriers. Sugar molecules here do not supply such ions. Dissolution hydrates existing lattice ions rather than transforming protons.",
            "understandingFocusDe": "Geringe Leitfähigkeit der konkreten Zuckerlösung beweist nicht, dass jede molekulare Verbindung in Wasser un-ionisiert bleibt; Säuren bilden eine andere Fallgrenze.",
            "understandingFocusEn": "Low conductivity in this sugar case does not establish that every molecular compound stays un-ionised in water; acids are a different case."
          }
        ]
      },

      "wholeProfile": {
        "archetype": "procedure",
        "expectations": [
          {
            "id": "g1",
            "essentialUnderstandingDe": "Oxidationszahlen sind formale atombezogene Elektronenbilanzen und keine Ionenladungen.",
            "essentialUnderstandingEn": "Oxidation numbers are formal atomwise electron accounts, not ionic charges.",
            "observablePerformanceDe": "Leite Oxidationszahlen an anorganischen und organischen C-Zentren her und unterscheide unveränderte Neutralisation von Redox.",
            "observablePerformanceEn": "Derive numbers for inorganic and organic carbon sites, distinguishing unchanged neutralisation from redox."
          },
          {
            "id": "g2",
            "essentialUnderstandingDe": "Elektronenabgabe und -aufnahme müssen sich in der Gesamtbilanz ausgleichen.",
            "essentialUnderstandingEn": "Electron loss and gain must balance overall.",
            "observablePerformanceDe": "Entwickle und prüfe stöchiometrisch korrekte Redoxbilanzen einschließlich Atomen und Ladung.",
            "observablePerformanceEn": "Construct/check stoichiometric redox balances with atoms and charge."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "g1",
            "g2"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "inorganic-organic",
            "textDe": "Anorganische Ionen gegenüber lokalen C-Atomen in Molekülen.",
            "textEn": "Inorganic ions versus local carbon atoms in molecules."
          },
          {
            "id": "redox-not-redox",
            "textDe": "Elektronenbilanz gegenüber reiner Protonenübertragung.",
            "textEn": "Electron balance versus pure proton transfer."
          },
          {
            "id": "medium",
            "textDe": "Saure Ionenbilanz gegenüber gegebener neutraler organischer Umsetzung.",
            "textEn": "Acidic ionic balance versus a stated neutral organic transformation."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "redox-1",
            "taskDemandDe": "Leite für MnO4−/Mn2+ und Fe2+/Fe3+ in saurer Lösung die Oxidationszahlen her, entwickle die Gesamtgleichung und prüfe Atome/Ladung. Vergleiche HCl/NaOH als Gegenbeispiel.",
            "taskDemandEn": "Derive oxidation numbers for acidic MnO4−/Mn2+ and Fe2+/Fe3+, construct the overall equation, check atoms/charge and compare HCl/NaOH as a counterexample.",
            "expectedPerformanceDe": "Mn +VII→+II nimmt formal 5e− auf; Fe +II→+III gibt 1e− ab. MnO4−+8H++5Fe2+→Mn2++4H2O+5Fe3+ ist atom- und ladungserhaltend. Neutralisation ändert die Oxidationszahlen nicht.",
            "expectedPerformanceEn": "Mn +VII→+II formally gains 5e− and Fe +II→+III loses 1e−. MnO4−+8H++5Fe2+→Mn2++4H2O+5Fe3+ conserves atoms and charge. Neutralisation does not change oxidation numbers.",
            "understandingFocusDe": "Atombezogene formale Bilanz statt Gleichsetzung mit der Gesamtladung.",
            "understandingFocusEn": "Atomwise formal accounting rather than equating oxidation number with whole-ion charge."
          },
          {
            "id": "redox-2",
            "taskDemandDe": "Leite lokale C-Werte aus Ethanol/Ethanal-Strukturen und CuO her; bilanziere die gegebene Umsetzung und beurteile die Behauptung einer Sauerstoffaufnahme.",
            "taskDemandEn": "Derive local carbon values from ethanol/ethanal and CuO, balance the supplied transformation and assess the oxygen-gain claim.",
            "expectedPerformanceDe": "CH3-C bleibt −III; reagierendes C steigt −I→+I und Cu sinkt +II→0. CH3CH2OH+CuO→CH3CHO+Cu+H2O. Die organische O-Zahl bleibt gleich; die formale Bilanz beweist keinen Mechanismus.",
            "expectedPerformanceEn": "CH3 carbon remains −III; the reacting carbon changes −I→+I and copper +II→0. CH3CH2OH+CuO→CH3CHO+Cu+H2O. Organic oxygen count is unchanged; formal accounting proves no mechanism.",
            "understandingFocusDe": "Transfer von Ionen zum lokalen organischen Reaktionszentrum.",
            "understandingFocusEn": "Transfer from ions to a local organic reaction site."
          }
        ]
      },
      "profileSourceLine": 352,
      "nonProfileKind": null
    },

      "externalReverseRequires": [],
      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Azofarbstoff-Synthese mechanistisch darstellen",
        "url": "/assets/goal-visualizations/chemie/981242bb-a729-5701-b02d-c2f7f489e5af/981242bb-a729-5701-b02d-c2f7f489e5af.png",
        "altText": "Drei große Restformeln Ar–NH₂, [Ar–N≡N]⁺ und Ar–N=N–Ar′ zeigen Diazotierung mit HNO₂/H⁺ und anschließende Azokupplung mit Ar′–H unter Protonenabgabe. Ar und Ar′ stehen für aromatische Reste. Die Darstellung ist eine vereinfachte Route ohne alle Zwischenstufen und volle Stoffbilanz.",
        "originalDigest": "sha256:a004f7bd97c3589e14c4585847b6451a9913eab1a6b71b3a9187c31f7b75c8bd",
        "qaStatus": "review_candidate",
        "approvedForPublication": false
      }
    },

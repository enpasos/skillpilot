    },
    {
      "goalId": "b406eff8-3cd9-551b-a913-c6dda7223645",
      "title": "Ammoniak: Erkenntnisse prüfen und Folgen abwägen",
      "decision": "KEEP",
      "scope": "Unchanged actual whole endpoint retained; new ordinary acquisition context scientifically supported",
      "reasonDe": "a008 und 9f89 vermitteln materialbezogene Fünferkriterien und historische/aktuelle Drei-Perspektiven-Bewertung. A misst nur früh, B liefert stationäre gleiche Endwerte mit/ohne Katalysator im Unsicherheitsbereich, C hat unzuverlässige Bedingungen. Zustimmung ersetzt keine chemische Evidenz. IEA bleibt Bericht2021, BASF Unternehmensperspektive; eigene Szenarioindizes sind keine reale LCA. 50 BE/46 und operativen Nullregeln erhalten jede Pflichtdimension; fehlender kleinster Abschnitt ergibt höchstens45. Die alte separate C11-Kurs-/Quellenfrage wird dadurch nicht geschlossen.",
      "requires": [
        "a0080b5f-13ff-56bc-b8ff-2ff6273e2ec1",
        "9f892457-c4e5-56da-830c-bf6cac0c98d7"
      ],
      "assessmentFromRequires": true,
      "newEndpointScopeOverride": false,
      "claimsExecutionOrLearnerSuccess": false,
      "newPerformanceReviewVoteForAllOldProfiles": false
    },
    {
      "goalId": "e6196381-eab5-5a3e-bb6e-56c6e6e3617f",
      "title": "Reversiblen Austausch praktisch durchführen und auswerten",
      "decision": "KEEP",
      "scope": "Unchanged actual whole endpoint retained; new ordinary acquisition context scientifically supported",
      "reasonDe": "a0f6 und 8137 tragen tatsächliche Modellhandlung und dynamische Erklärung. Entnahmen aus demselben Rundenanfang, fortgesetzte positive Transfers und eigenes Mengenprotokoll sind beobachtbar gefordert. Zahlenreihe und Transfer sind rechnerisch richtig, Modellgrenzen explizit. 10/10 ohne eigene Durchführung nicht erreichbar.",
      "requires": [
        "a0f6ba09-f072-5887-a797-fa369453c62a"
      ],
      "assessmentFromRequires": true,
      "newEndpointScopeOverride": false,
      "claimsExecutionOrLearnerSuccess": false,
      "newPerformanceReviewVoteForAllOldProfiles": false
    },
    {
      "goalId": "563f69ed-562f-5544-ab0c-bf0e481928d8",
      "title": "Galvanische Leerlaufspannung praktisch messen und vergleichen",
      "decision": "KEEP",
      "scope": "Unchanged actual whole endpoint retained; new ordinary acquisition context scientifically supported",
      "reasonDe": "7b39 und seine Redox-/Spannungsreihen-Lehrer tragen Aufbau, Messung und begrenzte Auswertung. Signed mean1,08433V, Spannweite0,004V und Anschlusswechsel sind korrekt; Zustand ist näherungsweise Leerlauf und keine universelle Standardspannung. Praktische Handlungen und eigene Rohdaten bleiben eigenständige Pflicht, 10/10 bleibt.",
      "requires": [
        "7b39fa19-fec3-575e-9324-a3226b703358"
      ],
      "assessmentFromRequires": true,

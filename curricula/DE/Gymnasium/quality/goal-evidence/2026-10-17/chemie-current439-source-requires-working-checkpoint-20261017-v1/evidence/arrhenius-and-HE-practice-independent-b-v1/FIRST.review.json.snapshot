  "ordinaryGoalDecisions": [
    {
      "goalId": "28bb9d15-f865-5843-a035-6066580fea64",
      "title": "Arrhenius-Definitionen wiederholen",
      "decision": "KEEP",
      "decisionScope": "Proposed explicit acquisition/source-scope metadata and specified placements only; unchanged whole P/content reviewed as operative context",
      "reasonDe": "Namen/Formeln der fünf Säuren und vier Hydroxide, gebräuchliche Lösungsnamen und das Arrhenius-Teilchenmodell sind eine fachlich zusammenhängende Wiederholungsgrundlage. HCl-Stoff gegenüber Salzsäure, hydratisierte Oxoniumionen, klare Kalkwasserlösung und begrenzte Dissoziations-/Löslichkeitsannahmen werden im ganzen P tatsächlich gefordert. Die feste Neunerfolge ist in HH/MV/ST/TH nicht vollständig als SekII-Kursvorgabe belegt; als ausdrücklich eigener Erwerbsumfang für bestehende Targets ist sie tragfähig. Kein Versuch und keine Stoffhandhabung werden aus den Namenskarten abgeleitet.",
      "actualTeacherChainPrefixes": [
        "a9c22adc",
        "d2ccd1d5"
      ],
      "courseAndStageBoundaryDe": "HH/MV/ST/TH: bestehende GK/LK-CrossStage-Targets; keine neue stage/course-Behauptung.",
      "requiresUnchanged": true,
      "PBodyUnchanged": true,
      "officialWholeSourceCredit": false,
      "newFormalMVote": false
    },
    {
      "goalId": "503dedcb-0efc-5e6b-bbc9-20761a0951f5",
      "title": "Chemische Fragestellungen und Hypothesen theoriegestützt formulieren",
      "decision": "KEEP",
      "decisionScope": "Proposed explicit acquisition/source-scope metadata and specified placements only; unchanged whole P/content reviewed as operative context",
      "reasonDe": "Die ganze eigene Fragestellungsleistung wird durch selbst formulierte theoriegestützte Hypothese, begrenzte schwache-Säure-Näherung, zehnfache Verdünnung, starken-Säure-Kontrast und Q/K-Störung einschließlich Gegenbefund erfasst. Vorgegebene Theorie ersetzt die eigene Frage/Hypothese nicht. Als HE-Grundlage des integrierten Säure-Endpunkts sinnvoll; die quantitative schwache-Säure-Variation im GK bleibt eine explizite eigene Vertiefung, keine amtliche GK-Pflicht.",
      "actualTeacherChainPrefixes": [
        "75e2eff1"
      ],
      "courseAndStageBoundaryDe": "HE: GK/LK, vier angegebene Sichten; konkrete eigene Erweiterung.",
      "requiresUnchanged": true,
      "PBodyUnchanged": true,
      "officialWholeSourceCredit": false,
      "newFormalMVote": false
    },
    {
      "goalId": "75e2eff1-f871-5461-9e3f-26d0b333ce2f",
      "title": "Chemische Alltagsfragen und prüfbare Hypothesen formulieren",
      "decision": "KEEP",
      "decisionScope": "Proposed explicit acquisition/source-scope metadata and specified placements only; unchanged whole P/content reviewed as operative context",
      "reasonDe": "Eigene überprüfbare Alltagsfrage, begründete Vorhersage, Vergleichsbedingungen und Gegenbefund werden an Zucker-Auflösungsgeschwindigkeit und Apfelbräunung erworben. Geschwindigkeit wird nicht mit Löslichkeit verwechselt. Diese gewöhnliche Vorstufe bereitet die anspruchsvollere Hypothesenleistung vor, ohne SekI-Mastery oder Durchführung zu unterstellen. Die HE-SekII-Platzierung ist eine ausdrücklich eigene Wiederholungsgrundlage.",
      "actualTeacherChainPrefixes": [
        "a9c22adc"
      ],
      "courseAndStageBoundaryDe": "HE: GK/LK; SekI-Kompetenz als eigener neuer Erwerbsplatz im oberen Modul.",
      "requiresUnchanged": true,
      "PBodyUnchanged": true,
      "officialWholeSourceCredit": false,
      "newFormalMVote": false
    },
    {
      "goalId": "7b39fa19-fec3-575e-9324-a3226b703358",
      "title": "Leerlaufspannungen galvanischer Zellen experimentell ermitteln",
      "decision": "KEEP",
      "decisionScope": "Proposed explicit acquisition/source-scope metadata and specified placements only; unchanged whole P/content reviewed as operative context",
      "reasonDe": "Tatsächlicher Aufbau zugehöriger Halbzellen, kompatible KNO3-Brücke, hochohmige Gleichspannungsmessung, Vorzeichen, eigenes Rohprotokoll und bedingungsgebundener Vergleich bereiten den Zellspannungs-Endpunkt real vor. Die 10-MΩ-Messung ist nur näherungsweise Leerlauf. Vertauschte Messleitungen ändern den Bezug, nicht die Zellreaktion; Chlorid in der Ag-Halbzelle verändert durch AgCl die Bedingungen. BW-Leistungsfach ist die ursprüngliche praktische Quellenpflicht; HE-LK erhält einen eigenen konkreten Erwerbsweg.",
      "actualTeacherChainPrefixes": [
        "8be14f15",
        "16da6a4d",
        "04fa0ba1"
      ],
      "courseAndStageBoundaryDe": "HE: ausschließlich die beiden LK-Sichten; kein neuer GK-Anspruch.",
      "requiresUnchanged": true,
      "PBodyUnchanged": true,
      "officialWholeSourceCredit": false,
      "newFormalMVote": false
    },
    {
      "goalId": "99d41b0f-e958-54cf-a077-9bed1704a303",
      "title": "Eigene chemische Untersuchungen reflektieren",
      "decision": "KEEP",
      "decisionScope": "Proposed explicit acquisition/source-scope metadata and specified placements only; unchanged whole P/content reviewed as operative context",
      "reasonDe": "Reflexion verlangt die tatsächlich eigene Untersuchung mit ursprünglichen Rohaufzeichnungen, Bezug zur eigenen Frage, ehrliche Kennzeichnung angeleiteter Schritte, konkrete Unsicherheiten und begründete Folgeuntersuchung. Ein fremdes Archiv oder synthetischer Musterlog ersetzt diese Leistung nicht. Damit wird ein eigenständiger Pflichtteil der integrierten Säureprüfung vorbereitet.",
      "actualTeacherChainPrefixes": [
        "e81a4aed",
        "7d9fcc7f"
      ],
      "courseAndStageBoundaryDe": "HE: GK/LK; geforderte eigene Leistung bleibt unabdingbar.",
      "requiresUnchanged": true,
      "PBodyUnchanged": true,
      "officialWholeSourceCredit": false,
      "newFormalMVote": false
    },
    {
      "goalId": "9e3fae29-84d5-5600-bfb3-82d49ea3f1b5",
      "title": "Chemische Daten quantitativ und hypothesenbezogen auswerten",
      "decision": "KEEP",
      "decisionScope": "Proposed explicit acquisition/source-scope metadata and specified placements only; unchanged whole P/content reviewed as operative context",
      "reasonDe": "Die ganze quantitative Datenkompetenz verlangt tatsächlich erstellte digitale Datei mit Rohdaten, Formeln, Regression einschließlich Offset, Diagramm, Gültigkeitsgrenze und Hypothesenurteil. 3,50 mg/L nach Verdünnung ergeben im gegebenen Modell 7,00 mg/L ursprünglich. A=0,650 darf oberhalb A=0,490 nicht gültig extrapoliert werden. Der geänderte Kinetikwert erfordert erhaltene Rohdaten, neue Version, neuen Fit und Residuen statt stiller Glättung. Diese eigene mathematische Erweiterung bereitet die integrierte Auswertung vor; HE-KC E6/E8/E11 ist kein Vollkredit jeder konkreten Kinetikrechnung.",
      "actualTeacherChainPrefixes": [
        "7d9fcc7f",
        "503dedcb",
        "9fc800d1"
      ],
      "courseAndStageBoundaryDe": "HE: GK/LK, ausdrücklich eigene digitale/quantitative Vertiefung.",
      "requiresUnchanged": true,
      "PBodyUnchanged": true,
      "officialWholeSourceCredit": false,
      "newFormalMVote": false
    },
    {
      "goalId": "9f892457-c4e5-56da-830c-bf6cac0c98d7",
      "title": "Chemische Wirkungen in historischen und aktuellen Zusammenhängen bewerten",
      "decision": "KEEP",
      "decisionScope": "Proposed explicit acquisition/source-scope metadata and specified placements only; unchanged whole P/content reviewed as operative context",
      "reasonDe": "Historische und heutige Wirkungen von Produkt, Methode, Verfahren und Erkenntnis werden bei Ammoniak und Kühlung aus ökologischer, ökonomischer und sozialer Perspektive verbunden. Quellenperspektive, gleiche Bezugsleistung und Modellgrenze bleiben prüfbar; die frischen Wissenszugangs- und Leckagefälle ändern gezielt die Bewertung, nicht willkürlich die Chemiedaten. Eigenes hypothetisches Handeln genügt ohne private Offenlegung oder unzulässige Geräte-/Düngereingriffe. Das passt als konkrete eigene Grundlage zum Ammoniak-Endpunkt.",
      "actualTeacherChainPrefixes": [
        "1df17884",
        "36666b4a",
        "431a0f03",
        "5b1bb5d9"
      ],
      "courseAndStageBoundaryDe": "HE: GK/LK; keine vollständige amtliche Bindung an genau diese eigenen Fälle.",
      "requiresUnchanged": true,
      "PBodyUnchanged": true,
      "officialWholeSourceCredit": false,
      "newFormalMVote": false
    },
    {
      "goalId": "a0080b5f-13ff-56bc-b8ff-2ff6273e2ec1",
      "title": "Wissenschaftliche Gültigkeitskriterien anwenden",
      "decision": "KEEP",
      "decisionScope": "Proposed explicit acquisition/source-scope metadata and specified placements only; unchanged whole P/content reviewed as operative context",
      "reasonDe": "Alle fünf Gültigkeitsaspekte werden tatsächlich materialbezogen angewandt. Zuverlässiger Gegenbefund wird von fehlender Kalibrierung, Nichtgleichgewicht und anderem Temperaturbereich getrennt. Wiederholung desselben Gerätefehlers schafft keine Validität; andere Temperatur falsifiziert nicht automatisch die 25-°C-Aussage. Der gewöhnliche Lernplatz vermittelt die am terminalen Ammoniakfall später integrierte Leistung.",
      "actualTeacherChainPrefixes": [
        "a8800c36",
        "4aa3a130",
        "7d9fcc7f",
        "9fc800d1"
      ],
      "courseAndStageBoundaryDe": "HE: GK/LK, gemeinsame Prozesskompetenz mit eigenem Fallumfang.",

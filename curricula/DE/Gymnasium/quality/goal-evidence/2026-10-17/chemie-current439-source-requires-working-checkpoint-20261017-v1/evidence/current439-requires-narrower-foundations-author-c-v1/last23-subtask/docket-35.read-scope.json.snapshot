    "formerPrerequisiteAncestorComponentsToInspect": [
      {
        "goalId": "018bec90-445f-4a88-b8bc-228f8335dee6",
        "title": "Leitfähigkeit von Stoffen vergleichen",
        "description": "Die lernende Person kann feste, flüssige und gelöste Stoffe im Hinblick auf elektrische Leitfähigkeit vergleichen und Leiter sowie Nichtleiter fachlich unterscheiden."
      },
      {
        "goalId": "1351706f-4ea6-56e9-951b-87b24cbcdee8",
        "title": "Lösungen nach Arbeitsanweisung herstellen",
        "description": "Die lernende Person kann mit zugelassenen Stoffen und einer bereitgestellten Arbeitsanweisung eine homogene Lösung herstellen und die ausgeführten Arbeitsschritte sowie das Ergebnis dokumentieren."
      },
      {
        "goalId": "13d4f336-ab16-54a7-9479-c920b458f385",
        "title": "Allgemeine Sicherheitsregeln im Chemielabor anwenden",
        "description": "Die lernende Person kann grundlegende Sicherheitsregeln im Chemielabor situationsbezogen anwenden."
      },
      {
        "goalId": "1bdaf7f2-ff3b-455a-a7fb-95a44642762a",
        "title": "Massenerhaltung bei Reaktionen erklären",
        "description": "Die lernende Person kann einfache Massenbilanz-Versuche auswerten und das Gesetz von der Erhaltung der Masse fachlich erklären."
      },
      {
        "goalId": "266a2b2a-9ee2-52f6-ae09-59343da9a60b",
        "title": "Arbeitsweisen der Chemie anwenden",
        "description": "Cluster für grundlegende chemische Laborarbeitsweisen und allgemeine Sicherheitsregeln in der Sekundarstufe I."
      },
      {
        "goalId": "28bb9d15-f865-5843-a035-6066580fea64",
        "title": "Arrhenius-Definitionen wiederholen",
        "description": "Die lernende Person kann typische anorganische Säuren und Basen mit Namen und Formeln angeben und ihre Wirkung in Wasser nach dem Arrhenius-Konzept erklären."
      },
      {
        "goalId": "326d45bf-9f77-57d5-a054-93e76b034dd5",
        "title": "Aggregatzustände und Übergänge deuten",
        "description": "Die lernende Person kann feste, flüssige und gasförmige Zustände anhand beobachtbarer Eigenschaften unterscheiden und Übergänge zwischen ihnen als Zustandsänderungen desselben Stoffes erklären."
      },
      {
        "goalId": "360fccb9-896d-5e67-bf5d-5732621604c9",
        "title": "Nahrungsmittelinhaltsstoffe strukturbezogen einordnen",
        "description": "Die lernende Person kann ausgewählte Inhaltsstoffe von Nahrungsmitteln anhand ihres submikroskopischen Baus vergleichen, Makro- und Mikronährstoffen zuordnen und ihre Bedeutung für den menschlichen Körper beschreiben."
      },
      {
        "goalId": "416dfd33-8b43-5c49-903c-9847b95e4208",
        "title": "Grundlegende Laborarbeitsweisen anwenden",
        "description": "Die lernende Person kann grundlegende chemische Laborarbeitsweisen sachgerecht ausführen und Beobachtungen geordnet dokumentieren."
      },
      {
        "goalId": "4285d84a-2c9a-4d51-8250-8bed4daf2d2e",
        "title": "Ionen als Ladungsträger erklären",
        "description": "Die lernende Person kann Ionenbildung beschreiben, Kationen und Anionen unterscheiden und ihre Rolle als Ladungsträger in Lösungen fachlich erläutern."
      },
      {
        "goalId": "448815cc-4127-54b7-96bf-e54b3d2a38c5",
        "title": "Bindungstypen sicher erläutern",
        "description": "Die lernende Person kann Metall-, Ionen- und Elektronenpaarbindungen fachlich sicher erläutern."
      },
      {
        "goalId": "5a30273a-98d5-5163-bb16-c250b7ed4e7f",
        "title": "Struktur-Eigenschafts-Zusammenhänge ableiten",
        "description": "Die lernende Person kann Schmelz- und Siedetemperaturen, Löslichkeiten sowie die Auswahl geeigneter Lösemittel für molekulare Stoffe mithilfe zwischenmolekularer Wechselwirkungen begründen und vorhersagen."
      },
      {
        "goalId": "5b1bb5d9-07b1-5ba9-b320-cc97be917c60",
        "title": "Chemische Informationen aus Quellen erschließen",
        "description": "Die lernende Person kann zur Beantwortung einer chemischen Frage relevante Informationen aus vorgegebenen oder selbst recherchierten Texten, Bildern und anderen Darstellungen auswählen, fachlich strukturieren, adressaten- und situationsgerecht auswerten und die verwendeten Quellen angeben."
      },
      {
        "goalId": "67cd332f-9db7-50e1-87f6-172ef3714300",
        "title": "Molekülgeometrien mit dem EPA-Modell erklären",
        "description": "Die lernende Person kann den räumlichen Bau einfacher Moleküle mithilfe des Elektronenpaarabstoßungsmodells erklären und mit Lewis- beziehungsweise Valenzstrichdarstellungen verknüpfen."
      },
      {
        "goalId": "72236f2c-771e-4ab6-933a-e549ee49d15b",
        "title": "Kern-Hülle-Modell und Elementarteilchen beschreiben",
        "description": "Die lernende Person kann das Rutherford-Streuexperiment als Befund für das Kern-Hülle-Modell einordnen, den Aufbau von Atomen mit dem Kern-Hülle-Modell beschreiben und Protonen, Neutronen sowie Elektronen fachlich einordnen."
      },
      {
        "goalId": "8d4ef102-e6a6-4d2e-bb6b-e707d3f2e566",
        "title": "Chemische Reaktionen von physikalischen Vorgängen unterscheiden",
        "description": "Die lernende Person kann chemische Reaktionen anhand neu entstehender Stoffe von physikalischen Vorgängen unterscheiden und Beobachtungen wie Temperatur- oder Farbänderungen als mögliche, allein nicht beweiskräftige Hinweise einordnen."
      },
      {
        "goalId": "92c99237-1c74-54fc-bf08-9191656afaa6",
        "title": "Moleküldarstellungen situationsgerecht umwandeln",
        "description": "Die lernende Person kann auf Grundlage ausreichender Strukturinformationen verschiedene Formeldarstellungen von Molekülen ineinander überführen und situationsgerecht eine geeignete Darstellung auswählen."
      },
      {
        "goalId": "950c73c6-4ed1-488a-9267-1142e95e0055",
        "title": "Einfache Ionengitter modellieren und Stoffeigenschaften erklären",
        "description": "Die lernende Person kann einfache Ionengitter wie Natriumchlorid modellieren, ihre räumliche Anordnung einschließlich der Koordinationszahl beschreiben und typische Stoffeigenschaften durch elektrostatische Kräfte und Ionenbeweglichkeit erklären."
      },
      {
        "goalId": "95dc0ee5-a0af-5682-af32-d66e36fbeb50",
        "title": "Chemische Fach- und Symbolsprache ebenengerecht verwenden",
        "description": "Die lernende Person kann zwischen Alltags- und Fachsprache übersetzen, Stoff- und Teilchenebene unterscheiden sowie Nomenklatur, Symbole und Formelsprache zur Beschreibung von Atomen, Molekülen, Ionen, Teilchenänderungen und Wechselwirkungen sachgerecht nutzen."
      },
      {
        "goalId": "9b56d01e-c2d7-51d8-b78e-237592c1ed20",
        "title": "Einfache Bindungswinkel mit dem EPA-Modell erklären",
        "description": "Die lernende Person kann zu bereits dargestellten Molekülgestalten und EPA-Elektronendomänen passende idealisierte einfache Bindungswinkel zuordnen, qualitative Winkelabweichungen durch freie Elektronenpaare begründen und die Grenzen solcher Modellwinkel gegenüber exakten Messwerten erläutern."
      },
      {
        "goalId": "9b5d6326-d27c-4ece-8c72-debda705464a",
        "title": "Dalton-Modell und Modellcharakter erläutern",
        "description": "Die lernende Person kann Daltons Atomhypothese erläutern und den Modellcharakter gegenüber Gesetz und Hypothese fachlich abgrenzen."
      },
      {
        "goalId": "9fa7d857-451a-5c1b-b6f4-d4ff97d7f39f",
        "title": "Lebensmittelzusammensetzung recherchieren und kategorisieren",
        "description": "Die lernende Person kann die Zusammensetzung von Lebensmitteln aus geeigneten Quellen recherchieren und Lebensmittel nach selbstgewählten chemisch begründeten Kriterien kategorisieren."
      },
      {
        "goalId": "a1632ea9-ca04-4f6a-bed2-06b3aa8d38ca",
        "title": "Ionenbildung mit der Edelgasregel deuten",
        "description": "Die lernende Person kann Kationen- und Anionenbildung mithilfe der Edelgasregel fachlich deuten."
      },
      {
        "goalId": "a9c22adc-b543-5b0c-a2d8-3189facdff08",
        "title": "Warum Chemie? - Relevanz und Orientierung",
        "description": "Der Big-Picture-Einstieg zeigt, welche Möglichkeiten Chemie im Alltag, bei gesellschaftlicher Teilhabe sowie in Studium und Beruf eröffnet und welche positiven Perspektiven der folgende Stoff bietet. Die lernende Person wählt nur, was sie neugierig macht oder ob sie weiterlernen möchte; fachliches Detailwissen wird hier weder vorausgesetzt noch geprüft."
      },
      {
        "goalId": "d2ccd1d5-56f7-583f-9724-e97441367f91",
        "title": "Saure, alkalische und neutrale Lösungen unterscheiden",
        "description": "Die lernende Person kann saure, neutrale und alkalische Lösungen in geeigneten Schulversuchen anhand der Farbskala des jeweils verwendeten Indikators unterscheiden und die Ergebnisse groben pH-Bereichen zuordnen."
      },
      {
        "goalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
        "title": "Konstante Massenverhältnisse beschreiben",
        "description": "Die lernende Person kann konstante Massenverhältnisse an einfachen Oxid- und Sulfidbildungen erkennen und fachlich beschreiben."
      },
      {
        "goalId": "e7c363d4-e02d-4895-8750-ba62c2eb63fe",
        "title": "Chemische Symbole und Formeln sicher nutzen",
        "description": "Die lernende Person kann chemische Symbole deuten und Molekülformeln einfacher Verbindungen fachlich korrekt bilden."
      },
      {
        "goalId": "e9d74940-1e0e-4511-9718-4851f49ad7a5",
        "title": "Periodensystem zur Strukturdeutung nutzen",
        "description": "Die lernende Person kann Ordnungsprinzipien des Periodensystems anwenden, Ordnungszahl, Protonenzahl, Hauptgruppen und Valenzelektronenzahl entnehmen und daraus einfache Aussagen über Atome ableiten."
      },
      {
        "goalId": "eb7537dd-d11b-50e9-a6d7-51a78e96fc4e",
        "title": "Intermolekulare Kräfte vergleichen",
        "description": "Die lernende Person kann Dipolkräfte, Wasserstoffbrücken, Ionen-Dipol-Wechselwirkungen und Van-der-Waals-Kräfte an Beispielen erläutern."
      },
      {
        "goalId": "f1ed86f0-534d-57d7-8952-a004a331cc54",
        "title": "Lösungen berechnen und pH bestimmen",
        "description": "Die lernende Person kann Stoffmengen, Konzentrationen und pH-Werte starker Säuren und Basen berechnen, saure oder basische Lösungen definierter Stoffmengenkonzentration herstellen und Messergebnisse plausibilisieren."
      },
      {
        "goalId": "f5efab9d-2c61-44ea-b36a-87f873b51fd8",
        "title": "Energiestufenmodell und Elektronenverteilung anwenden",
        "description": "Die lernende Person kann das Bohrsche Energiestufenmodell nutzen, Elektronenverteilungen einfacher Atome fachlich korrekt angeben und Ionisierungsenergien als experimentellen Hinweis auf Energiestufen deuten."
      },
      {
        "goalId": "fb3bdf39-4baf-4510-a192-c8a12fbf5dba",
        "title": "Chemische Symbolsprache und Anwendung (Sek I)",
        "description": "Cluster für konstante Massenverhältnisse, Dalton-Modell, chemische Formelsprache, einfache Reaktionsgleichungen und erste Redoxschemata aus der gymnasialen Sekundarstufe I."
      },
      {
        "goalId": "fcc73fb5-7413-557f-aea3-b9692a66ee75",
        "title": "Stoffe und Eigenschaften beschreiben",
        "description": "Die lernende Person kann Stoffe anhand von Eigenschaftsmerkmalen beschreiben und ordnen."
      }
    ],

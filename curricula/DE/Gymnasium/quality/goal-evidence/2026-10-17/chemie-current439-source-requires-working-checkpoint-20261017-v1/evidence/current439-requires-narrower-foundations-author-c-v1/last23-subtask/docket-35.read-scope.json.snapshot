    ],
    "profile": {
      "archetype": "modeling",
      "expectations": [
        {
          "id": "e1",
          "essentialUnderstandingDe": "Magensäure entsteht durch ATP-gekoppelten Protonentransport und getrennten Chloridtransport.",

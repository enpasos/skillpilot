        "topicCode": "SL-CH-SEKI-9-2025-P013",
        "bulletIndex": 2,
        "aspectIndex": 1,
        "title": "erklären den Begriff Indikator",
        "description": "Die lernende Person kann erklären den Begriff Indikator.",
        "sourceText": "erklären den Begriff Indikator,",
        "sourceSpan": "Klasse 9, S. 13, Source-Ziel 2",
        "parentBulletText": "erklären den Begriff Indikator,",
        "sourceRef": "SL-CH-SEKI-9-2025 S. 13",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",

    {
      "case": "de-hh-gym-chemistry-gk::1dc15fa2-fca4-56b0-b5c1-4d215613dde0",
      "viewId": "de-hh-gym-chemistry-gk",
      "scope": {
        "schoolForm": "Gymnasium",
        "jurisdiction": "DE-HH",
        "stage": "CrossStage",
        "courseProfile": "GK"
      },
      "goalId": "1dc15fa2-fca4-56b0-b5c1-4d215613dde0",
      "proposedProjectionRole": "target",
      "caseKind": "ordinary_acquisition",
      "decision": "KEEP",
      "decisionScope": "bounded existing placement only",
      "ownScientificReasoningDe": "KEEP als ganzer vorhandener Erwerbsplatz: Mol bezieht sich auf benannte Einheiten; Moleküle/Atome/Formeleinheiten/Ionen werden begründet unterschieden. 0,20 mol O2 enthalten 0,40 mol O-Atome; 0,30 mol NaCl-Formeleinheiten enthalten je 0,30 mol Na+- und Cl−-Ionen. Gleiche Stoffmenge bedeutet keine gleiche Masse. Das ist die notwendige Bedeutungsebene vor n/V und stöchiometrischer Titrationsrückrechnung. Der direkte Symbol-/Formelvorgänger ist bereits target; die untersuchte requires-Kette dieser Molgrundlage hat keine fehlende Targetrolle. Das beweist keinen vollständigen anderen Lernpfad.",
      "sourceJurisdiction": "DE-HH",
      "sourceReadPhysicalPages": [
        30
      ],
      "sourceCredit": "authored-acquisition-or-recall; no official whole-profile credit",
      "limitsDe": [
        "Eigene Erwerbsergänzung, keine amtliche Vollzuordnung des ganzen P-Profils.",
        "Praktische Kriterien des nachfolgenden Titrationsziels bleiben vollständig erforderlich.",
        "Keine weitere allgemeine pH-Herstellungsroutine f1ed wird aus dem Molplatz oder EDTA-Puffer abgeleitet."
      ],
      "beforeViewDigest": "sha256:dd6eb0c515a55f6e1d8260807e14353678d61bff6933b84c3a2760792e76b1f3",
      "afterViewDigest": "sha256:feb53d2c9151351f6355fd5a52e1f0652cd80c0ad02a8f771b92fafc43e8d2a5",
      "oldRolesPreserved": true,
      "actualLearnerChoiceEstablished": false,
      "actualLearnerPerformanceEstablished": false
    },
    {
      "case": "de-hh-gym-chemistry-gk::d7e08305-25c2-5c2c-b87d-443358526a1b",
      "viewId": "de-hh-gym-chemistry-gk",
      "scope": {
        "schoolForm": "Gymnasium",
        "jurisdiction": "DE-HH",
        "stage": "CrossStage",
        "courseProfile": "GK"
      },
      "goalId": "d7e08305-25c2-5c2c-b87d-443358526a1b",
      "proposedProjectionRole": "target",
      "caseKind": "bounded_recall",
      "decision": "KEEP",
      "decisionScope": "bounded existing placement only",
      "ownScientificReasoningDe": "KEEP als Ergänzung nach dem ganzen Mol-Erwerb: Die reale Auswahl ist ausschließlich chem_basics_008 im bestehenden Basicsdeck. Benannte Teilchen, Einheit mol, exakter Molzählbezug, N=n·N_A und Einheit Eins für N sind fachlich korrekt. Der Filter zieht weder chem_basics_009 noch chem_basics_010 hinzu. Der zusätzliche Konstantenbezug auf der bestehenden Karte macht daraus keinen Erwerbsplatz für alle Teilchentransfers oder molare Masse. Die vorhandene requires-Kante auf 1dc bleibt erhalten.",
      "sourceJurisdiction": "DE-HH",
      "sourceReadPhysicalPages": [
        30
      ],
      "sourceCredit": "authored-acquisition-or-recall; no official whole-profile credit",
      "limitsDe": [
        "Abrufleistung der einen Karte ersetzt weder ganzen Mol-Erwerb noch Konzentrations-/Stöchiometrieverständnis.",
        "Keine neue Karte, kein umbenannter breiter Deckscope und keine geänderte alte Memoryrolle.",

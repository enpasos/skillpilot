          "actualSource": {
            "binding": {
              "campaignId": "chemie-current439-stable-jurisdiction-next20-20261017-v1-b",
              "campaignDigest": "sha256:bfab1059a35242cca960dc0d52382275ebb6d8e5d424e96064add67cec86bdbd",
              "roundId": "chemie-current439-stable-jurisdiction-next20-20261017-v1-first-pass-b",

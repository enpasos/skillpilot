              "reviewInputFingerprint": "sha256:0797525fd818044ce14480d3eff9201747dcabc6c8aef6dbb00906a2ba889933",
              "goalReviewContextFingerprint": "sha256:7f022bc1331e12370613a3d941034655155695650ad6cffd22a1dee30ee2478d",
              "batchId": "chemie-current439-stable-jurisdiction-next20-20261017-v1-first-pass-b.batch-001",
              "runId": "chemie-next20-current641-fresh-independent-b-20261017-actual-run-v1",
              "runManifestDigest": "sha256:16131ee6eba9ac41a201e229d06f9952315f03b8f76e85f98624839d7ac5a0ff",
              "resultsDigest": "sha256:0bf1e57dfdcc22c7bb502219b2ab9d6bba77ebeddb099db953cc6bb762471f3b",
              "recordId": "chemie-next20-independent-b-20261017-20",
              "recordDigest": "sha256:bddb0736788da4efb9ff209ca26e4c0083f3d47f9804b3074acc46de1884cec9"
            },
            "decision": "keep",
            "record": {
              "$schema": "https://skillpilot.com/schemas/goal-description-review/v1/goal-description-review-record.schema.json",
              "schemaVersion": 1,
              "recordId": "chemie-next20-independent-b-20261017-20",
              "runId": "chemie-next20-current641-fresh-independent-b-20261017-actual-run-v1",
              "campaignId": "chemie-current439-stable-jurisdiction-next20-20261017-v1-b",
              "roundId": "chemie-current439-stable-jurisdiction-next20-20261017-v1-first-pass-b",
              "bundleFingerprint": "sha256:8a65ca3fada0adb9af2196b4479efc48486bf61fd5ed416c3e9f8084d8fff129",
              "bookDigest": "sha256:86a5bf02ebc5fea3170461aff76aee760e42eef027903047fb3600579bfd4f86",
              "goalId": "059acb11-29b3-5645-ac4c-b4214dc41a2d",
              "goalFingerprint": "sha256:58836619dbd564293bfe8a2e8a9ed2dae150faa0a8742c59542f5b650d685941",
              "pageFingerprint": "sha256:362437f3bde4e944255b76668bc18c8bab8ab04ec32e50ac71cdce1296f1c9ec",
              "currentTitleDe": "Halbtitration zur pK-Bestimmung nutzen",
              "currentTitleEn": "Use half-titration to determine pK values",
              "currentDescriptionDe": "Die lernende Person kann das Prinzip der Halbtitration für geeignete schwache Säuren oder Basen anhand des konjugierten Säure-Base-Paares erläutern und deren pKS- beziehungsweise pKB-Werte aus pH- beziehungsweise pOH-Daten am Halbäquivalenzpunkt bestimmen.",
              "currentDescriptionEn": "The learner can explain half-titration for suitable weak acids or bases using the conjugate acid–base pair and determine their pKa or pKb values from pH or pOH data, respectively, at the half-equivalence point.",
              "decision": "keep",
              "understandingEvidence": {
                "essentialUnderstandingDe": "Halbäquivalenz ist stöchiometrisch definiert; geeignete schwache konjugierte Paare erlauben näherungsweise pH=pKa oder pOH=pKb.",
                "essentialUnderstandingEn": "Half-equivalence is defined stoichiometrically; suitable weak conjugate pairs approximately permit pH=pKa or pOH=pKb.",
                "observablePerformanceDe": "Die Person leitet Halbvolumen und Verhältnis her, bestimmt pKa beziehungsweise pKb aus der richtigen Messgröße und begrenzt die Näherung.",
                "observablePerformanceEn": "The learner derives half-volume and ratio, determines pKa or pKb from the correct measured quantity and bounds the approximation.",
                "transferExpectationDe": "Schwache Base, Vierteläquivalenz und starke HCl prüfen pH/pOH-Umrechnung, anderes Verhältnis und das fehlende schwache Pufferpaar.",
                "transferExpectationEn": "A weak base, quarter-equivalence and strong HCl test pH/pOH conversion, a different ratio and absence of the required weak buffer pair."
              },
              "rationale": "Das Ziel benennt geeignete schwache Paare und getrennte pH/pOH-Auswertung. Halbvolumen wird aus Stoffmenge statt arithmetischem pH-Mittelwert abgeleitet; das Profil begrenzt das 1:1-Näherungsargument. Das Bild zeigt den korrekten schwache-Säure-Fall und bleibt keine vollständige Darstellung aller Basenfälle. Die aktuelle Länderfolge stimmt mit dem begrenzten kompilierten Sichtbarkeitsnachweis überein. Mapping-/contains-/requires-Sichtbarkeit wird nicht als landesweite vollständige Pflicht- oder Quellenabdeckung ausgegeben. Auf der tatsächlichen Einzelzielseite ist keine davon abweichende Alle-Länder-Pflichtbehauptung gedruckt.",
              "evidenceProfileContract": "positive-understanding-evidence-v2",
              "evidenceProfileRecommendation": "none",
              "recordStatus": "candidate",
              "reviewAuthority": "ai_candidate"
            }
          },

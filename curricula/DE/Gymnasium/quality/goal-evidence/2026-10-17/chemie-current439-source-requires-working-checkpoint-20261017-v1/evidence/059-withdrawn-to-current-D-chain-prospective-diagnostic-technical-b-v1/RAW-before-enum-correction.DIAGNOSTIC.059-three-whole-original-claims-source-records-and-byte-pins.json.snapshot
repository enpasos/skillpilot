      "originalRoundInputsEqual": true,
      "currentInputComparison": {
        "DEENFinalTextDifferences": [
          {
            "field": "descriptionDe",
            "before": "Die lernende Person kann das Prinzip der Halbtitration erläutern und pKS- bzw. pKB-Werte unbekannter Säuren oder Basen aus Halbtitrationsdaten bestimmen.",
            "current": "Die lernende Person kann das Prinzip der Halbtitration für geeignete schwache Säuren oder Basen anhand des konjugierten Säure-Base-Paares erläutern und deren pKS- beziehungsweise pKB-Werte aus pH- beziehungsweise pOH-Daten am Halbäquivalenzpunkt bestimmen."
          },
          {
            "field": "descriptionEn",
            "before": "The learner can explain the principle of half-titration and determine pKa or pKb values of unknown acids or bases from half-titration data.",
            "current": "The learner can explain half-titration for suitable weak acids or bases using the conjugate acid–base pair and determine their pKa or pKb values from pH or pOH data, respectively, at the half-equivalence point."
          }
        ],
        "canonicalContextDifferences": [],
        "oldPEmbedded": false,
        "PWholeProfileDifferences": [
          {
            "field": "",
            "before": null,
            "current": {
              "archetype": "data",
              "expectations": [
                {
                  "id": "stoichiometric-half-point",
                  "essentialUnderstandingDe": "Der Halbpunkt liegt bei der Hälfte des stöchiometrischen Äquivalenzvolumens; dort sind die formalen Mengen des schwachen Partners und seines Konjugierten gleich.",
                  "essentialUnderstandingEn": "The half point is half the stoichiometric equivalence volume; there, formal amounts of the weak species and its conjugate are equal.",
                  "observablePerformanceDe": "Die lernende Person bilanziert 2.000 mmol HA bzw. 1.000 mmol B und begründet die Halbvolumina 10.00 bzw. 5.00 mL anhand der umgesetzten Stoffmengen.",
                  "observablePerformanceEn": "The learner balances 2.000 mmol HA or 1.000 mmol B and justifies half volumes of 10.00 or 5.00 mL using amounts reacted."
                },
                {
                  "id": "equal-ratio-equilibrium",
                  "essentialUnderstandingDe": "Das gemeinsame Volumen macht aus gleichen Puffermengen ein Konzentrationsverhältnis eins; daraus folgt die passende pH/pKS- oder pOH/pKB-Beziehung.",
                  "essentialUnderstandingEn": "Shared volume turns equal buffer amounts into a concentration ratio of one, yielding the appropriate pH/pKa or pOH/pKb relation.",
                  "observablePerformanceDe": "Sie leitet für HA/A− pH≈pKS aus dem MWG ab und erklärt mit 0.500/1.500 mmol, weshalb das Viertelvolumen pH≈4.323 statt pKS liefert.",
                  "observablePerformanceEn": "The learner derives pH≈pKa for HA/A− from mass action and uses 0.500/1.500 mmol to explain why the quarter volume gives pH≈4.323 rather than pKa."
                },
                {
                  "id": "base-half-point-conversion",
                  "essentialUnderstandingDe": "Bei einer schwachen Base liefert der Halbpunkt pOH≈pKB; pH und pKB sind nicht dieselbe Größe.",
                  "essentialUnderstandingEn": "For a weak base, the half point gives pOH≈pKb; pH and pKb are different quantities.",
                  "observablePerformanceDe": "Sie nutzt pH 9.20 und pKw 14.00 zu pKB(B)=4.80 und pKS(BH+)=9.20 und begründet beide Werte über Kb und die konjugierte Säure.",
                  "observablePerformanceEn": "The learner uses pH 9.20 and pKw 14.00 to obtain pKb(B)=4.80 and pKa(BH+)=9.20, justifying both through Kb and the conjugate acid."
                },
                {
                  "id": "half-point-domain",
                  "essentialUnderstandingDe": "Das Pufferargument gilt für ein geeignetes schwaches konjugiertes Paar; weder Äquivalenz noch der Mittelwert von pH-Daten noch halbe Neutralisation starker HCl ersetzt diese Bedingung.",
                  "essentialUnderstandingEn": "The buffer argument requires a suitable weak conjugate pair; equivalence, an average of pH data or half-neutralizing strong HCl does not replace that condition.",
                  "observablePerformanceDe": "Sie unterscheidet Halb- und Äquivalenzpunkt und erklärt beim HCl-Gegenbeispiel den starken Säureüberschuss und das fehlende vergleichbar konzentrierte schwache Pufferpaar.",
                  "observablePerformanceEn": "The learner distinguishes half-equivalence from equivalence and explains the strong-acid excess and absence of a comparably concentrated weak buffer pair in the HCl counterexample."
                }
              ],
              "variationAxes": [
                {
                  "id": "weak-acid-to-weak-base",
                  "textDe": "Von der schwachen Säure zur schwachen Base wechseln und die auszuwertende Größe pH oder pOH begründen.",
                  "textEn": "Switch from a weak acid to a weak base and justify whether pH or pOH is evaluated."
                },
                {
                  "id": "half-quarter-equivalence",
                  "textDe": "Halbes und viertel Äquivalenzvolumen sowie Äquivalenz anhand chemischer Mengenverhältnisse vergleichen.",
                  "textEn": "Compare half and quarter equivalence volumes and equivalence using chemical amount ratios."
                },
                {
                  "id": "valid-buffer-to-strong-acid",
                  "textDe": "Die Halbpunktargumentation an starker HCl auf ihre fehlende Pufferbedingung prüfen.",
                  "textEn": "Test half-point reasoning against strong HCl and identify its missing buffer condition."
                }
              ],
              "applicationCaseBriefs": [
                {
                  "id": "g6-c1",
                  "taskDemandDe": "Nutze 20.00 mL 0.1000 M HA, 0.1000 M NaOH und die vollständigen 5/10/20-mL-Daten; begründe pKS. Vollständiges Material, Auftrag, Lösung und vier Kriterien: inputs/fourteen-full-cases.bound.exact.json, Fall G6-C1.",
                  "taskDemandEn": "Use 20.00 mL 0.1000 M HA, 0.1000 M NaOH and the full 5/10/20 mL data to justify pKa. Complete material, task, solution and four criteria: inputs/fourteen-full-cases.bound.exact.json, case G6-C1.",
                  "expectedPerformanceDe": "Bei 10.00 mL liegen näherungsweise je 1.000 mmol HA/A− vor: pKS≈4.80. Bei 5.00 mL ist das Verhältnis 1/3 und pH≈4.323. Äquivalenz und arithmetischer pH-Mittelwert definieren den Halbpunkt nicht.",
                  "expectedPerformanceEn": "At 10.00 mL, HA/A− are approximately 1.000 mmol each: pKa≈4.80. At 5.00 mL, the ratio is 1/3 and pH≈4.323. Equivalence and an arithmetic pH midpoint do not define the half point.",
                  "understandingFocusDe": "Stöchiometrisches Volumen, Gleichgewichtsverhältnis und Messgröße zu einer begründeten Auswertung verbinden.",
                  "understandingFocusEn": "Connect stoichiometric volume, equilibrium ratio and measured quantity in a justified interpretation."
                },
                {
                  "id": "g6-c2",
                  "taskDemandDe": "Nutze 20.00 mL 0.05000 M B, 0.1000 M HCl und pH 9.20 bei 5.00 mL; prüfe pKB=9.20 und die Übertragung auf starke HCl. Vollständiges Material, Auftrag, Lösung und vier Kriterien: inputs/fourteen-full-cases.bound.exact.json, Fall G6-C2.",
                  "taskDemandEn": "Use 20.00 mL 0.05000 M B, 0.1000 M HCl and pH 9.20 at 5.00 mL; assess pKb=9.20 and transfer to strong HCl. Complete material, task, solution and four criteria: inputs/fourteen-full-cases.bound.exact.json, case G6-C2.",
                  "expectedPerformanceDe": "Je etwa 0.500 mmol B/BH+ begründen pOH≈pKB=4.80; konjugierter pKS=9.20. Halbneutralisierte starke HCl besitzt starken Überschuss statt des vorausgesetzten schwachen Pufferpaares.",
                  "expectedPerformanceEn": "Approximately 0.500 mmol each of B/BH+ justify pOH≈pKb=4.80; conjugate pKa=9.20. Half-neutralized strong HCl has a strong-acid excess rather than the required weak buffer pair.",
                  "understandingFocusDe": "Der Wechsel zur Base und das starke Gegenbeispiel prüfen die chemische Bedingung statt eine pH-Ableseregel.",
                  "understandingFocusEn": "Switching to a base and the strong-acid counterexample test the chemical condition rather than a pH-reading rule."
                }
              ],
              "coverageExpectations": {
                "requiredExpectationIds": [
                  "stoichiometric-half-point",
                  "equal-ratio-equilibrium",
                  "base-half-point-conversion",
                  "half-point-domain"
                ],
                "alternativeExpectationGroups": [],
                "minimumIndependentDemonstrations": 2,
                "freshVariationRequired": true,
                "independentTransferRequired": true
              }
            }
          }
        ],
        "currentGoalFingerprintMatches": false,

    {
      "id": "hist-source",
      "points": 2,
      "criterionDe": "Firmeninteresse und tatsächlich unterschiedliche Quellenreichweite prüfen.",
      "criterionEn": "Assess company interests and the different actual scopes of the sources."
    },
    {
      "id": "hist-judgement",

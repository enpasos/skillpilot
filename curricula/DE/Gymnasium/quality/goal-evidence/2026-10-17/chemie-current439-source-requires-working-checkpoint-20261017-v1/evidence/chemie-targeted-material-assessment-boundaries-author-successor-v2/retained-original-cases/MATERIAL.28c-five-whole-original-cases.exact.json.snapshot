      "sourceFile": {
        "path": "/home/enpasos/projects/skillpilot/curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-acid-source-course-eight-findings-whole-author-successor-20261016-v1/materials/EIGHT.complete-retained-cases-and-rubrics.exact.json",

      "wholeCurrentProfileBody": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "specified-entities-and-mole",
            "essentialUnderstandingDe": "Stoffmenge ist eine zählbezogene Größe mit Einheit mol für ausdrücklich benannte Elementarteilchen. Dieselbe Stoffmenge verschiedener Moleküle oder Atome bedeutet dieselbe Zahl dieser Einheiten, nicht gleiche Masse. Moleküle, Atome, Ionen und Formeleinheiten dürfen nicht stillschweigend ineinander umbenannt werden.",
            "essentialUnderstandingEn": "Amount of substance is a counting-related quantity measured in mol for explicitly specified elementary entities. Equal amounts of different molecules or atoms mean equal numbers of those entities, not equal masses. Molecules, atoms, ions and formula units must not be silently substituted for each other.",
            "observablePerformanceDe": "Die lernende Person benennt die gezählte Einheit, übersetzt zwischen Molekülen/Formeleinheiten und enthaltenen Atomen/Ionen und erklärt, weshalb eine gleiche Zahl von Teilchenpaketen keine Aussage über gleiche Masse liefert.",
            "observablePerformanceEn": "The learner specifies the counted entity, translates between molecules/formula units and constituent atoms/ions and explains why equal numbers of particle packages do not imply equal mass."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "specified-entities-and-mole"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "entity-kind",
            "textDe": "Moleküle und einzelne Atome werden mit Ionen und Formeleinheiten kontrastiert.",
            "textEn": "Molecules and single atoms are contrasted with ions and formula units."
          },
          {
            "id": "reference-count",
            "textDe": "Gleiche Stoffmenge der Verbindungen wird mit unterschiedlicher Stoffmenge enthaltener Teilchen verglichen.",
            "textEn": "Equal compound amounts are compared with unequal amounts of constituent particles."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "oxygen-and-helium-packages",
            "taskDemandDe": "Zwei Proben sind beschriftet: A enthält 0,20 mol O2-Moleküle, B enthält 0,20 mol He-Atome. Begründe, welche Teilchenzahlen gleich sind, wie viel mol O-Atome A enthält und ob die Beschriftung gleiche Massen beweist. Die genaue Zahl für ein mol brauchst du hier nicht auszurechnen.",
            "taskDemandEn": "Two samples are labelled: A contains 0.20 mol O2 molecules and B contains 0.20 mol He atoms. Explain which particle counts are equal, how many mol of O atoms A contains and whether the labels prove equal masses. You need not calculate the numerical count in one mol.",
            "expectedPerformanceDe": "A und B besitzen gleich viele jeweils benannte Elementarteilchen: O2-Moleküle bzw. He-Atome. A enthält 0,40 mol O-Atome. Die doppelte Atomzahl in A macht die Molekülstoffmenge nicht zu 0,40 mol O2; gleiche Stoffmenge beweist keine gleiche Masse.",
            "expectedPerformanceEn": "A and B contain equal numbers of their specified entities: O2 molecules and He atoms. A contains 0.40 mol of O atoms. Its doubled atom count does not make the molecular amount 0.40 mol O2; equal amount does not establish equal mass.",
            "understandingFocusDe": "Gezählte Einheit, enthaltene Atome und Probenmasse werden begründet auseinandergehalten.",
            "understandingFocusEn": "The counted entity, constituent atoms and sample mass are distinguished with reasons."
          },
          {
            "id": "salt-formula-units-fresh",
            "taskDemandDe": "Frischer Fall ohne Rechenweg: Ein NaCl-Kristall besteht aus Na+- und Cl−-Ionen im Verhältnis 1:1. Er enthält 0,30 mol NaCl-Formeleinheiten. Ein Mitschüler schreibt: „Das sind 0,60 mol NaCl-Moleküle.“ Beurteile die Aussage und formuliere korrekte Stoffmengenangaben für die Formeleinheiten, Na+-Ionen, Cl−-Ionen und alle Ionen zusammen.",
            "taskDemandEn": "Fresh case without a worked method: a NaCl crystal consists of Na+ and Cl− ions in a 1:1 ratio and contains 0.30 mol NaCl formula units. A classmate writes: “That is 0.60 mol NaCl molecules.” Evaluate the statement and give correct amounts for formula units, Na+ ions, Cl− ions and all ions together.",
            "expectedPerformanceDe": "0,30 mol Formeleinheiten, 0,30 mol Na+-Ionen und 0,30 mol Cl−-Ionen; insgesamt 0,60 mol Ionen, mit ausdrücklich gemeinsamer gezählter Einheit „Ionen“. NaCl im Kristall besteht nicht aus isolierten NaCl-Molekülen; Anzahl der Bestandteile und Anzahl der Verhältnisformeleinheiten sind unterschiedliche Bezüge.",
            "expectedPerformanceEn": "There are 0.30 mol formula units, 0.30 mol Na+ ions and 0.30 mol Cl− ions, totalling 0.60 mol ions with the common counted entity explicitly stated. Crystalline NaCl is not composed of isolated NaCl molecules; constituent-ion count and formula-unit count use different reference entities.",
            "understandingFocusDe": "Selbstständiger Wechsel zur Ionengitter-Darstellung, ohne eine molekulare Zählregel unbesehen zu übertragen.",
            "understandingFocusEn": "Independent transfer to an ionic-lattice representation without blindly applying a molecular counting rule."
          }
        ]
      },

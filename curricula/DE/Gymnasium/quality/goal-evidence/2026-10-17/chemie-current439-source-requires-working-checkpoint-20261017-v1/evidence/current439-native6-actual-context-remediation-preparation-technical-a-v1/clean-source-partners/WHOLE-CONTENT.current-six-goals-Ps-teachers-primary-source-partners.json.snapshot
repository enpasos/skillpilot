      "wholeCurrentProfileBody": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "ions-and-electrode-reactions",
            "essentialUnderstandingDe": "Eine externe Spannungsquelle erzwingt den Stoffumsatz. Kationen wandern im geeigneten Modell zur negativen Kathode und können dort reduziert werden; Anionen zur positiven Anode, wo im gegebenen Beispiel Oxidation stattfindet. Ladungsausgleich erfolgt durch Ionentransport, Elektronen fließen im äußeren Leiter.",
            "essentialUnderstandingEn": "An external voltage source forces chemical change. Cations move toward the negative cathode in the suitable model and can be reduced there; anions move toward the positive anode, where oxidation occurs in the supplied example. Ion transport balances charge while electrons travel through the external conductor.",
            "observablePerformanceDe": "Die lernende Person erläutert Teilchenwanderung und die beiden angegebenen Elektrodenreaktionen eines geeigneten neuen Beispiels und unterscheidet Schmelze von wässriger Lösung.",
            "observablePerformanceEn": "The learner explains particle migration and the two supplied electrode reactions in a suitable fresh example, distinguishing melt from aqueous solution."
          },
          {
            "id": "stoichiometry-and-operating-direction",
            "essentialUnderstandingDe": "Produktverhältnisse folgen aus ausgeglichenen Elektrodenreaktionen und demselben Elektronenumsatz, nicht allgemein aus gleicher Produktmenge. Elektrolyse benötigt Energiezufuhr; ein galvanischer Vorgang liefert bei freiwilligem Ablauf elektrische Energie.",
            "essentialUnderstandingEn": "Product ratios follow balanced electrode reactions with the same electron turnover, not a universal equal-product rule. Electrolysis needs energy input; a spontaneous galvanic process supplies electrical energy.",
            "observablePerformanceDe": "Die lernende Person begründet das neue Produktverhältnis mit Atomen und Ladung und vergleicht die Betriebsrichtung mit einer geeigneten galvanischen Zelle.",
            "observablePerformanceEn": "The learner justifies a fresh product ratio using atoms and charge and compares operating direction with a suitable galvanic cell."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "ions-and-electrode-reactions",
            "stoichiometry-and-operating-direction"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "melt-versus-aqueous",
            "textDe": "NaCl-Schmelze mit Natriumprodukt und geeignete wässrige CuCl₂-Lösung mit vorgegebenen Kupfer-/Chlorbefunden; Wasserreaktionen nicht pauschal ausschließen.",
            "textEn": "NaCl melt yielding sodium and suitable aqueous CuCl₂ with supplied copper/chlorine results; do not universally exclude water reactions."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "sodium-chloride-melt-data",
            "taskDemandDe": "Ein gegebenes Schema zeigt Elektrolyse einer NaCl-Schmelze ohne Wasser. Ordne Na⁺/Cl⁻, Elektroden und Energiezufuhr zu. Die Produkte sind Na und Cl₂. Formuliere bzw. erläutere passende Teilgleichungen und begründe das molare Produktverhältnis. Dies ist ein Datenfall, keine Durchführung.",
            "taskDemandEn": "A supplied diagram shows electrolysis of molten NaCl without water. Assign Na⁺/Cl⁻, electrodes and energy input. Products are Na and Cl₂. Formulate or explain suitable half-equations and justify the molar product ratio. This is a data case, not a practical activity.",
            "expectedPerformanceDe": "Na⁺ zur negativen Kathode, Na⁺ + e⁻ → Na; Cl⁻ zur positiven Anode, 2Cl⁻ → Cl₂ + 2e⁻. Zwei Natriumteilchen je Chlormolekül, daher n(Na):n(Cl₂)=2:1. Die externe Quelle erzwingt den Vorgang; die Salzschmelze leitet Ionen, keine Elektronen. Das Bildbeispiel ist ausdrücklich keine wässrige CuCl₂-Lösung.",
            "expectedPerformanceEn": "Na⁺ moves toward the negative cathode: Na⁺ + e⁻ → Na. Cl⁻ moves toward the positive anode: 2Cl⁻ → Cl₂ + 2e⁻. Two sodium particles form per chlorine molecule, hence n(Na):n(Cl₂)=2:1. An external source forces the process; the melt conducts ions, not electrons. This image example is explicitly not aqueous CuCl₂.",
            "understandingFocusDe": "Begründeter Unterschied zwischen Teilchen-/Elektronenstrom und Produktstöchiometrie.",
            "understandingFocusEn": "Reasoned distinction between ion/electron conduction and product stoichiometry."
          },
          {
            "id": "aqueous-copper-chloride-observed-products",
            "taskDemandDe": "Unabhängig vom Bild sind Daten einer geeigneten wässrigen CuCl₂-Elektrolyse mit inerten Elektroden und festgelegten Bedingungen gegeben: Kupfer wird an der Kathode abgeschieden, Chlor an der Anode nachgewiesen. Erkläre Ionenwanderung und Elektrodenreaktionen, leite das molare Produktverhältnis ab und vergleiche Energiefluss mit einer freiwilligen galvanischen Zelle. Es wird keine Eigenaktivität mit Chlor verlangt.",
            "taskDemandEn": "Independently of the image, data from suitable aqueous CuCl₂ electrolysis with inert electrodes under specified conditions are supplied: copper is deposited at the cathode and chlorine identified at the anode. Explain ion movement and electrode reactions, derive the molar product ratio and compare energy flow with a spontaneous galvanic cell. No personal chlorine activity is required.",
            "expectedPerformanceDe": "Cu²⁺ + 2e⁻ → Cu und 2Cl⁻ → Cl₂ + 2e⁻ ergeben n(Cu):n(Cl₂)=1:1, anders als NaCl-Schmelze. Kathode ist negativ, Anode positiv; Energie wird elektrisch zugeführt. Im freiwilligen galvanischen Fall wird elektrische Energie abgegeben. Die angegebenen Produkte beruhen auf diesen nachgewiesenen Bedingungen; in wässrigen Systemen können andere Elektroden-/Wasserreaktionen konkurrieren, daher nicht auf jede CuCl₂-Lösung verallgemeinern.",
            "expectedPerformanceEn": "Cu²⁺ + 2e⁻ → Cu and 2Cl⁻ → Cl₂ + 2e⁻ give n(Cu):n(Cl₂)=1:1, unlike molten NaCl. The cathode is negative and the anode positive; electrical energy is supplied. A spontaneous galvanic process releases electrical energy. The products are limited to the supplied demonstrated conditions; other electrode/water reactions may compete in aqueous systems, so do not generalize to every CuCl₂ solution.",
            "understandingFocusDe": "Echter wässriger Transfer mit anderer Ladung/Stöchiometrie und begrenzter Produktbehauptung.",
            "understandingFocusEn": "Genuine aqueous transfer with different charge/stoichiometry and limited product claims."
          }
        ]
      },

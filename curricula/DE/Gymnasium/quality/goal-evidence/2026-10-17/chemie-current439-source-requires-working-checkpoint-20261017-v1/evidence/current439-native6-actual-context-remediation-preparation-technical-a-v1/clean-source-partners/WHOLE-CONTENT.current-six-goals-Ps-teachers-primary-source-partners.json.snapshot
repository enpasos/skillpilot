      "wholeCurrentProfileBody": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "content-specific-understanding",
            "essentialUnderstandingDe": "Elektrolyse erzwingt mit elektrischer Energie Elektronenaufnahme an der Kathode und Elektronenabgabe an der Anode; die mobilen Ionen wandern zu entgegengesetzten Polen.",
            "essentialUnderstandingEn": "Electrolysis uses electrical energy to force electron gain at the cathode and loss at the anode; mobile ions migrate towards opposite poles.",
            "observablePerformanceDe": "Na+ zur Kathode:Na++e−→Na. Cl− zur Anode:2Cl−→Cl2+2e−. Summe2NaCl→2Na+Cl2; elektrische Energie erzwingt den Umsatz. Ladungen und Elektronen sind bilanziert; Natrium und Chlor bleiben räumlich getrennt.",
            "observablePerformanceEn": "Na+ to cathode:Na++e−→Na. Cl− to anode:2Cl−→Cl2+2e−. Sum2NaCl→2Na+Cl2; electrical energy forces the process. Charges/electrons balance; sodium and chlorine are kept spatially separated."
          },
          {
            "id": "fresh-transfer-and-model-boundary",
            "essentialUnderstandingDe": "Die Materialdeutung belegt keine selbst ausgeführte Elektrolyse und ist keine private Durchführungsempfehlung.",
            "essentialUnderstandingEn": "Interpreting the material establishes no personally executed electrolysis and is no recommendation for private execution.",
            "observablePerformanceDe": "Cu2++2e−→Cu;2Cl−→Cl2+2e−; CuCl2→Cu+Cl2 im gegebenen Fall. Kationen/Anionen wandern zu negativer/positiver Elektrode. In wässrigen anderen Fällen können Wasser, Konzentration und Elektroden die Produkte beeinflussen; Na-Metall wird daraus nicht gefolgert.",
            "observablePerformanceEn": "Cu2++2e−→Cu;2Cl−→Cl2+2e−; CuCl2→Cu+Cl2 in the supplied case. Cations/anions migrate to negative/positive electrodes. Water, concentration and electrode material can affect other aqueous products; sodium metal is not inferred."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "content-specific-understanding",
            "fresh-transfer-and-model-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "specific-material-variation",
            "textDe": "NaCl-Schmelze gegenüber ausdrücklich festgelegter Kupfer(II)-chlorid-Lösung; Teilgleichungen und Wasser-Grenze.",
            "textEn": "NaCl melt versus explicitly specified copper(II) chloride solution; half-equations and water limitation."
          },
          {
            "id": "specific-model-limit",
            "textDe": "Die Materialdeutung belegt keine selbst ausgeführte Elektrolyse und ist keine private Durchführungsempfehlung.",
            "textEn": "Interpreting the material establishes no personally executed electrolysis and is no recommendation for private execution."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-next25-70b12d1c-case-1",
            "taskDemandDe": "Reiner Papiermodellfall: wasserfreie NaCl-Schmelze; getrennte Kathoden-/Anodenräume. Keine Versuchsanweisung. Vorgegeben sind Na+ und Cl−, negative Kathode, positive Anode und Chlorbildung. Erkläre Ionenwanderung und metallisches/nichtmetallisches Produkt; formuliere ausgeglichene Teil- und Gesamtgleichung.",
            "taskDemandEn": "Paper model only: anhydrous NaCl melt with separated cathode/anode regions. No experimental procedure. Na+, Cl−, negative cathode, positive anode and chlorine formation are specified. Explain ion migration and metal/nonmetal products; write balanced half- and overall equations.",
            "expectedPerformanceDe": "Na+ zur Kathode:Na++e−→Na. Cl− zur Anode:2Cl−→Cl2+2e−. Summe2NaCl→2Na+Cl2; elektrische Energie erzwingt den Umsatz. Ladungen und Elektronen sind bilanziert; Natrium und Chlor bleiben räumlich getrennt.",
            "expectedPerformanceEn": "Na+ to cathode:Na++e−→Na. Cl− to anode:2Cl−→Cl2+2e−. Sum2NaCl→2Na+Cl2; electrical energy forces the process. Charges/electrons balance; sodium and chlorine are kept spatially separated.",
            "understandingFocusDe": "Das Beispiel ist eine Schmelze; Natriumabscheidung darf nicht ungeprüft auf wässrige NaCl-Lösung übertragen werden.",
            "understandingFocusEn": "This example is a melt; sodium deposition must not be transferred uncritically to aqueous NaCl."
          },
          {
            "id": "chem-next25-70b12d1c-case-2",
            "taskDemandDe": "Frischer Interpretationsfall: ein beaufsichtigtes Referenzprotokoll für CuCl2-Lösung nennt an der Kathode Kupfer, an der Anode Chlor. Chloridoxidation ist für diese vorgegebenen Bedingungen ausdrücklich festgelegt; alternative Wasserreaktionen werden nicht ausgeschlossen. Erkläre die Beobachtungen mit Cu2+/Cl− und bilanziere. Begründe, warum das Protokoll keine universelle Produktregel für jede Salzlösung ist.",
            "taskDemandEn": "Fresh interpretation: a supervised reference protocol for CuCl2 solution reports copper at the cathode and chlorine at the anode. Chloride oxidation is specified for these conditions; alternative water reactions are not ruled out generally. Explain the observations using Cu2+/Cl− and balance them. Explain why the protocol is not a universal product rule for every salt solution.",
            "expectedPerformanceDe": "Cu2++2e−→Cu;2Cl−→Cl2+2e−; CuCl2→Cu+Cl2 im gegebenen Fall. Kationen/Anionen wandern zu negativer/positiver Elektrode. In wässrigen anderen Fällen können Wasser, Konzentration und Elektroden die Produkte beeinflussen; Na-Metall wird daraus nicht gefolgert.",
            "expectedPerformanceEn": "Cu2++2e−→Cu;2Cl−→Cl2+2e−; CuCl2→Cu+Cl2 in the supplied case. Cations/anions migrate to negative/positive electrodes. Water, concentration and electrode material can affect other aqueous products; sodium metal is not inferred.",
            "understandingFocusDe": "Die Materialdeutung belegt keine selbst ausgeführte Elektrolyse und ist keine private Durchführungsempfehlung.",
            "understandingFocusEn": "Interpreting the material establishes no personally executed electrolysis and is no recommendation for private execution."
          }
        ]
      },

      "wholeCurrentProfileBody": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "structure-model-reasoning",
            "essentialUnderstandingDe": "Metallbindung, Ionenbindung und Elektronenpaarbindung unterscheiden sich in Teilchen, Ladungen und Elektronenorganisation; Bindungsmodelle erklären ausgewählte Eigenschaften.",
            "essentialUnderstandingEn": "Metallic, ionic and covalent bonding differ in particles, charges and electron organization; bonding models explain selected properties.",
            "observablePerformanceDe": "Die Person erklärt die Modellbilder für Cu, NaCl und Cl2 und begründet Beweglichkeit von Ladungsträgern statt nur Stoffnamen zuzuordnen.",
            "observablePerformanceEn": "The learner explains model diagrams for Cu, NaCl and Cl2 and reasons about mobile charge carriers instead of merely assigning substance names."
          },
          {
            "id": "fresh-application-and-boundary",
            "essentialUnderstandingDe": "Ein Stoff mit Metallatom ist nicht automatisch ein Metall; Ionen im Feststoff sind nicht automatisch frei beweglich.",
            "essentialUnderstandingEn": "A substance containing a metal atom is not automatically a metal; solid-state ions are not automatically freely mobile.",
            "observablePerformanceDe": "In der Schmelze sind Na+ und Cl− beweglich. CuCl2 hat Ionen und nicht das Modell des elementaren Metalls mit delokalisiertem Elektronengas. O-H in H2O ist eine kovalente Bindung; Wasserstoffbrücken beziehen sich hier auf Wechselwirkungen zwischen Molekülen. Ionenbindung und kovalente Bindung sind Modelle mit Übergängen; aus dem Namen allein wird keine exakte Bindungsenergie abgeleitet.",
            "observablePerformanceEn": "Na+ and Cl− are mobile in the melt. CuCl2 contains ions rather than the elemental metallic electron-gas model. O-H in H2O is a covalent bond; hydrogen bonding here refers to interactions between molecules. Ionic and covalent bonding are models with transitions; names alone establish no exact bond energy."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "structure-model-reasoning",
            "fresh-application-and-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "material-variation",
            "textDe": "Metall versus Metallverbindung; ionischer Feststoff versus Schmelze; intramolekulare versus intermolekulare Wechselwirkung.",
            "textEn": "Metal versus metal compound; ionic solid versus melt; intra- versus intermolecular interaction."
          },
          {
            "id": "counterexample",
            "textDe": "Ein Stoff mit Metallatom ist nicht automatisch ein Metall; Ionen im Feststoff sind nicht automatisch frei beweglich.",
            "textEn": "A substance containing a metal atom is not automatically a metal; solid-state ions are not automatically freely mobile."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-current15-448815cc-case-1",
            "taskDemandDe": "Modelle: Kupfer mit positiven Atomrümpfen/delokalisierten Elektronen; festes NaCl mit Na+/Cl−-Gitter; Cl2 mit gemeinsamem Bindungselektronenpaar. Erkläre die drei Bindungsarten und leite den Unterschied in der Ladungsträgerbeweglichkeit von Cu und festem NaCl her.",
            "taskDemandEn": "Models: copper with positive cores/delocalized electrons; solid NaCl with a Na+/Cl− lattice; Cl2 with a shared bonding electron pair. Explain the three bond types and derive the difference in mobile charge carriers between Cu and solid NaCl.",
            "expectedPerformanceDe": "Cu besitzt bewegliche delokalisierte Elektronen. NaCl wird durch elektrostatische Gitterwechselwirkungen gebunden, seine Ionen sind im festen Gitter ortsgebunden. Cl2 hat eine kovalente Bindung zwischen zwei Atomen; Anziehung zwischen Cl2-Molekülen ist davon verschieden.",
            "expectedPerformanceEn": "Cu has mobile delocalized electrons. NaCl is bound by electrostatic lattice interactions and its solid-state ions are position-bound. Cl2 has a covalent bond between two atoms; attraction between Cl2 molecules is different.",
            "understandingFocusDe": "NaCl wird nicht als Ansammlung einzelner NaCl-Moleküle beschrieben.",
            "understandingFocusEn": "NaCl is not described as an assembly of discrete NaCl molecules."
          },
          {
            "id": "chem-current15-448815cc-case-2",
            "taskDemandDe": "Frischer Fall: NaCl schmilzt; CuCl2 enthält Kupfer, liegt aber als ionischer Feststoff vor. Wasser enthält neutrale H2O-Moleküle. Übertrage die Modelle: Welche Ladungsträger bewegen sich in der NaCl-Schmelze? Warum ist CuCl2 kein Kupfermetall und die O-H-Bindung keine Wasserstoffbrücke?",
            "taskDemandEn": "Fresh case: NaCl melts; CuCl2 contains copper but is an ionic solid. Water contains neutral H2O molecules. Transfer the models: which carriers move in molten NaCl? Why is CuCl2 not copper metal, and why is the O-H bond not a hydrogen bond?",
            "expectedPerformanceDe": "In der Schmelze sind Na+ und Cl− beweglich. CuCl2 hat Ionen und nicht das Modell des elementaren Metalls mit delokalisiertem Elektronengas. O-H in H2O ist eine kovalente Bindung; Wasserstoffbrücken beziehen sich hier auf Wechselwirkungen zwischen Molekülen.",
            "expectedPerformanceEn": "Na+ and Cl− are mobile in the melt. CuCl2 contains ions rather than the elemental metallic electron-gas model. O-H in H2O is a covalent bond; hydrogen bonding here refers to interactions between molecules.",
            "understandingFocusDe": "Ionenbindung und kovalente Bindung sind Modelle mit Übergängen; aus dem Namen allein wird keine exakte Bindungsenergie abgeleitet.",
            "understandingFocusEn": "Ionic and covalent bonding are models with transitions; names alone establish no exact bond energy."
          }
        ]
      },

      },
      "wholeCurrentProfileBody": {
        "archetype": "experiment",
        "expectations": [
          {
            "id": "evidence-grounded-abbreviated-series",
            "essentialUnderstandingDe": "Unter den gegebenen vergleichbaren Bedingungen zeigt eine Metallabscheidung, dass das eingesetzte Metall Elektronen an die Ionen des abgeschiedenen Metalls abgibt. Mehrere passende Beobachtungen tragen eine verkürzte Ordnung und die zugehörigen Metall/Metallion-Paare.",
            "essentialUnderstandingEn": "Under the supplied comparable conditions, metal deposition shows that the inserted metal donates electrons to ions of the deposited metal. Several suitable observations support an abbreviated order and the corresponding metal/metal-ion pairs.",
            "observablePerformanceDe": "Die lernende Person leitet eine konsistente verkürzte Redoxreihe aus neuen kontrollierten Beobachtungen ab und benennt Donator-/Akzeptor-Paare mit den korrekten Ladungen.",
            "observablePerformanceEn": "The learner derives a consistent abbreviated redox series from fresh controlled observations and identifies donor/acceptor pairs with correct charges."
          },
          {
            "id": "cell-measurement-and-limits",
            "essentialUnderstandingDe": "Die freiwillige gekoppelte Reaktion einer gegebenen galvanischen Zelle liefert elektrische Energie; Elektronen fließen im äußeren Leiter vom oxidierten Metall zur reduzierten Metallion-Halbzelle. Eine gemessene Spannung gilt für die gegebenen Bedingungen, nicht unverändert für jede Zelle.",
            "essentialUnderstandingEn": "The spontaneous coupled reaction of a supplied galvanic cell provides electrical energy; electrons travel through the external conductor from the oxidized metal to the half-cell where metal ions are reduced. A measured voltage applies to the stated conditions, not unchanged to every cell.",
            "observablePerformanceDe": "Die lernende Person verbindet eine neue Zellmessung mit der beobachtungsbasierten Ordnung, begründet Elektronenrichtung und Messgrenze und setzt Elektronenleitung nicht mit Ionentransport gleich.",
            "observablePerformanceEn": "The learner connects a fresh cell measurement to the observation-based order, explains electron direction and measurement limits, and distinguishes electron conduction from ion transport."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "evidence-grounded-abbreviated-series",
            "cell-measurement-and-limits"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "new-species-and-controls",
            "textDe": "Neue Metallpaare und Positiv-/Negativbeobachtungen bei kontrollierten Konzentrationen, Temperatur und Oberflächenbedingungen.",
            "textEn": "Fresh metal pairs and positive/negative observations under controlled concentrations, temperature and surface conditions."
          },
          {
            "id": "cell-and-measurement",
            "textDe": "Andere Zellkombination mit vorgegebener Messung; keine universelle Standardspannung aus einem Beispiel behaupten.",
            "textEn": "A different cell combination with a supplied measurement; do not infer universal standard voltage from one example."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "zinc-copper-silver-observations",
            "taskDemandDe": "Gegeben sind kontrollierte Versuche: Zn in Cu²⁺-Lösung zeigt Kupferabscheidung, Cu in Zn²⁺-Lösung keine Reaktion; Cu in Ag⁺-Lösung zeigt Silberabscheidung, Ag in Cu²⁺-Lösung keine Reaktion. Eine geeignete Zn/Cu-Zelle zeigt unter angegebenen Standardbedingungen etwa 1,10 V. Begründe eine verkürzte Metallordnung, Paare und äußere Elektronenrichtung. Keine Versuche selbst durchführen.",
            "taskDemandEn": "Controlled supplied trials show copper deposition for Zn in Cu²⁺ solution but no reaction for Cu in Zn²⁺ solution; silver deposition for Cu in Ag⁺ solution but no reaction for Ag in Cu²⁺ solution. A suitable Zn/Cu cell reads about 1.10 V under the stated standard conditions. Justify an abbreviated metal order, pairs and external electron direction. Do not perform these trials yourself.",
            "expectedPerformanceDe": "Die Beobachtungen tragen Zn > Cu > Ag nach Elektronenabgabebereitschaft unter den gegebenen Bedingungen; Paare Zn/Zn²⁺, Cu/Cu²⁺ und Ag/Ag⁺. In der Zelle fließen äußere Elektronen von Zn nach Cu, wo Cu²⁺ reduziert wird. Ag⁺, nicht Ag-Metall, nimmt beim Abscheidungsversuch Elektronen auf. Spannung und negative Beobachtungen sind an die ausdrücklich kontrollierten Bedingungen gebunden.",
            "expectedPerformanceEn": "The observations support Zn > Cu > Ag in electron-donating tendency under the supplied conditions, with Zn/Zn²⁺, Cu/Cu²⁺ and Ag/Ag⁺ pairs. External cell electrons travel from Zn to Cu, where Cu²⁺ is reduced. Ag⁺, not Ag metal, accepts electrons in the deposition trial. Voltage and negative observations are limited to the explicitly controlled conditions.",
            "understandingFocusDe": "Zusammenhängende Beobachtung, Teilchenbegründung und Zellmessung ohne unbeaufsichtigte Praxis.",
            "understandingFocusEn": "Connected observations, particle reasoning and cell measurement without unsupervised practice."
          },
          {
            "id": "iron-nickel-copper-new-order",
            "taskDemandDe": "Frische bereitgestellte kontrollierte Befunde: Fe scheidet Ni aus Ni²⁺ ab, Ni scheidet kein Fe aus Fe²⁺ ab; Ni scheidet Cu aus Cu²⁺ ab, Cu scheidet kein Ni aus Ni²⁺ ab. In einer Fe/Ni-Zelle wird Elektronenfluss Fe → Ni beobachtet. Leite ohne Bildmuster eine Ordnung und die Paare ab. Erkläre, weshalb die frühere Zahl 1,10 V keine begründete Fe/Ni-Spannung ist.",
            "taskDemandEn": "Fresh supplied controlled results show Fe depositing Ni from Ni²⁺, with no Fe deposition by Ni from Fe²⁺; Ni deposits Cu from Cu²⁺, with no Ni deposition by Cu from Ni²⁺. A Fe/Ni cell shows electron flow Fe → Ni. Derive an order and pairs without the image pattern. Explain why the earlier 1.10 V is not a justified Fe/Ni voltage.",
            "expectedPerformanceDe": "Fe > Ni > Cu aus den neuen Beobachtungen; Fe/Fe²⁺, Ni/Ni²⁺, Cu/Cu²⁺. Fe gibt Elektronen ab und Ni²⁺ nimmt sie auf. Die andere Stoffkombination und ihre Bedingungen benötigen eine eigene Spannungsmessung bzw. geeignete Referenzdaten. Aus fehlender sichtbarer Reaktion ohne Kontrollen wäre keine allgemeine Ordnung beweisbar.",
            "expectedPerformanceEn": "The fresh observations support Fe > Ni > Cu and Fe/Fe²⁺, Ni/Ni²⁺, Cu/Cu²⁺ pairs. Fe donates electrons and Ni²⁺ accepts them. Different species and conditions require their own voltage measurement or suitable reference data. Absence of visible reaction without controls would not prove a universal order.",
            "understandingFocusDe": "Chemisch neuer Transfer, vollständige Paare und Grenzen statt bloßer neuer Zahlen.",
            "understandingFocusEn": "Chemically fresh transfer, complete pairs and limits rather than mere number substitution."
          }
        ]
      },

        "applicationCaseBriefs": [
          {
            "id": "ammonia-particle-cards",
            "taskDemandDe": "Neue Karten zeigen einzelne N- und H-Atome sowie ein Teilchen mit einem N- und drei H-Atomen. Schreibe die einfache Molekülformel und erkläre den Unterschied zwischen N, H und NH3.",
            "taskDemandEn": "Fresh cards show separate N and H atoms and a particle with one N and three H atoms. Write its simple molecular formula and explain N, H and NH3.",
            "expectedPerformanceDe": "Die lernende Person schreibt NH3, zählt ein N und drei H pro Molekül und liest N/H als Elementsymbole; sie schreibt nicht N3H wegen drei H-Atomen.",
            "expectedPerformanceEn": "The learner writes NH3, counts one N and three H per molecule and reads N/H as element symbols; they do not write N3H because of the three H atoms.",
            "understandingFocusDe": "Neues Molekül prüft Formeln aus Teilchenbildern.",
            "understandingFocusEn": "A fresh molecule tests deriving formulas from particles."
          },
          {
            "id": "fresh-carbon-monoxide-vs-two",
            "taskDemandDe": "Eine neue Zeichnung zeigt zwei getrennte CO-Moleküle, eine andere ein einzelnes CO2-Molekül. Schreibe zu beiden die passende Notation und begründe die unterschiedlichen Atomzahlen.",
            "taskDemandEn": "A fresh drawing shows two separate CO molecules and another shows one CO2 molecule. Write the correct notation for each and explain the different atom counts.",
            "expectedPerformanceDe": "Die lernende Person schreibt 2 CO gegenüber CO2, zählt im ersten Fall zwei C und zwei O insgesamt, im zweiten ein C und zwei O in einem Molekül und ändert keine Elementsymbol-Großschreibung.",
            "expectedPerformanceEn": "The learner writes 2 CO versus CO2, counts two C and two O in total for the first, one C and two O in one molecule for the second, and preserves element-symbol capitalization.",
            "understandingFocusDe": "Index und Koeffizient liefern verschiedene Teilchenstrukturen.",
            "understandingFocusEn": "Subscript and coefficient specify different particle structures."
          }
        ]
      },

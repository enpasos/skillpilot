      {
        "sourceLabel": "HB-upper",
        "documentMetadata": {
          "key": "HB-GYO-CHEMIE-2022",
          "title": "Bildungsplan Chemie Gymnasiale Oberstufe Bremen 2022",
          "path": "curricula/DE/Gymnasium/input/HB/GyO_Chemie_2022.pdf",

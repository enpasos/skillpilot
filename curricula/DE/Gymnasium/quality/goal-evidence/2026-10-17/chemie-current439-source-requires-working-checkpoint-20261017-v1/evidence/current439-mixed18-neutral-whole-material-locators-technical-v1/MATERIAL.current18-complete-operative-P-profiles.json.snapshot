    {
      "goalId": "a78aacf9-92ea-5627-8776-a595111f754c",
      "titleDe": "Zusammensetzung moderner Waschmittel",
      "sourceJsonPointer": "/goals/10/reviewContext/evidenceProfile/profile",
      "selectedValuePin": {
        "sha256": "773f411f50ddf2e0dc4d1d0270c1e1e871ebceda65e21d7d71b9f215fcd4c0b8",
        "bytes": 7996,

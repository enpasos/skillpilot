          {
            "id": "acid-versus-base",
            "textDe": "Säurezugabe durch Basenzugabe an getrennten geschlossenen Phosphatportionen ersetzen.",
            "textEn": "Replace acid addition with base addition in separate closed phosphate portions."
          },
          {
            "id": "reserve-boundary",
            "textDe": "Begrenzte Last mit Erschöpfung und dem Missverständnis eines unveränderlichen pH vergleichen.",
            "textEn": "Compare limited loading with depletion and the misconception of invariant pH."
          }

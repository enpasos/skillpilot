        "applicationCaseBriefs": [
          {
            "id": "phosphate-acid",
            "taskDemandDe": "Erkläre für H2PO4−/HPO4²− im geschlossenen Modell die begrenzte Säurezugabe mit Gleichgewicht, Abfangreaktion und Teilchenschema.",
            "taskDemandEn": "Explain a limited acid addition to a closed H2PO4−/HPO4²− buffer using equilibrium, reaction and particle scheme.",
            "expectedPerformanceDe": "HPO4²−+H3O+→H2PO4−+H2O; das Gleichgewicht verschiebt zum protonierten Partner. Die Phosphatbilanz bleibt erhalten, der pH fällt begrenzt und bleibt nicht exakt gleich.",
            "expectedPerformanceEn": "HPO4²−+H3O+→H2PO4−+H2O; equilibrium shifts towards the protonated partner. Phosphate balance is conserved and pH falls modestly rather than remaining exactly fixed.",
            "understandingFocusDe": "Le Chatelier an konkreten Partneränderungen statt bloßem Schlagwort.",
            "understandingFocusEn": "Apply Le Chatelier through concrete partner changes rather than a slogan."
          },
          {
            "id": "phosphate-base-and-limits",
            "taskDemandDe": "Übertrage auf begrenzte OH−-Zugabe; widerlege unendliche Pufferreserve und grenze die Enzym-/Biologieanalogie ein.",
            "taskDemandEn": "Transfer to limited OH− addition, reject infinite reserve and bound the enzyme/biology analogy.",
            "expectedPerformanceDe": "H2PO4−+OH−→HPO4²−+H2O. Der pH steigt weniger als im ungepufferten Modell; endliche Partnerbestände begrenzen die Wirkung. Geschlossenheit bedeutet fehlenden weiteren Austausch, nicht unbegrenzte Stabilität oder ein Modell des gesamten Bluts.",
            "expectedPerformanceEn": "H2PO4−+OH−→HPO4²−+H2O. pH rises less than in the unbuffered model; finite partner amounts limit action. Closed means no further exchange, not unlimited stability or a model of the whole blood system.",
            "understandingFocusDe": "Geänderte Belastungsrichtung und ehrliche Systemgrenzen ohne HH-Rechenpflicht.",
            "understandingFocusEn": "Changed loading direction and explicit system limits without compulsory HH calculation."
          }
        ]
      },

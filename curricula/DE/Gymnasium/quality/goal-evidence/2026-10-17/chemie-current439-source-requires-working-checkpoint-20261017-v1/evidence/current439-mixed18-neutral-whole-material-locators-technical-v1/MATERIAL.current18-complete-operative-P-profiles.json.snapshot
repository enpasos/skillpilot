      "scientificProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Builder,Enzyme,Bleichsysteme und Hilfsstoffe haben verschiedene Funktionen.",
            "essentialUnderstandingEn": "Builders,enzymes,bleach and auxiliaries have distinct functions.",
            "observablePerformanceDe": "energy20-11-a: Vier Stoffgruppen anhand konkreter Wirkprinzipien zuordnen. energy20-11-b: Faser-/Fleckchemie mit passender oder fehlender Komponente verbinden.",
            "observablePerformanceEn": "energy20-11-a: Assign four ingredient groups using concrete mechanisms. energy20-11-b: Connect fibre/stain chemistry with present/absent ingredients."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Substrat- und Materialchemie bestimmen Eignung einzelner Komponenten.",
            "essentialUnderstandingEn": "Substrate/material chemistry determine ingredient suitability.",
            "observablePerformanceDe": "energy20-11-a: Hydrolyse, Oxidation, Ionenaustausch und Fluoreszenz unterscheiden. energy20-11-b: Builder, Enzym und Bleichsystem nicht als austauschbar behandeln.",
            "observablePerformanceEn": "energy20-11-a: Distinguish hydrolysis,oxidation,ion exchange and fluorescence. energy20-11-b: Do not treat builder,enzyme and bleach as interchangeable."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "Kontrollen und Sicherheitsregeln begrenzen Rezeptur- und Leistungsbehauptungen.",
            "essentialUnderstandingEn": "Controls/safety rules constrain formulation/performance claims.",
            "observablePerformanceDe": "energy20-11-a: Kontrolllogik und Substratspezifität statt Universalwirkung nutzen. energy20-11-b: Sicherheitsgrenze und fehlende reale Produktprüfung ausdrücklich benennen.",
            "observablePerformanceEn": "energy20-11-a: Use control logic and substrate specificity,not universal-effect claims. energy20-11-b: Explicitly state safety limits and absence of actual product approval."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",

    {
      "goalId": "64a5bb87-358d-5a22-958a-f66ba5521cd5",
      "titleDe": "Proteinquellen nachhaltig und quellenkritisch bewerten",
      "sourceJsonPointer": "/goals/17/reviewContext/evidenceProfile/profile",
      "selectedValuePin": {
        "sha256": "20965bd79acdb7450ccc5cfb6ae622dd552d66b38992b88fc1538c5f0d1e870f",

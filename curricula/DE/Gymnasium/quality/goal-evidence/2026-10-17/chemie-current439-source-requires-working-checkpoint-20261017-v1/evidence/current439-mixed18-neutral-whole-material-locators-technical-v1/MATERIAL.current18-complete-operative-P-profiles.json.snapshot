    {
      "goalId": "d465d82b-4bf2-5527-bb7c-dad5a92605fe",
      "titleDe": "Tensidstrukturen analysieren",
      "sourceJsonPointer": "/goals/9/reviewContext/evidenceProfile/profile",
      "selectedValuePin": {
        "sha256": "6aff622bf188c0b1d561516aacdd93326cf90753a5eb7f1cf69160bc3181720d",
        "bytes": 8358,
        "encoding": "UTF-8 JSON, sorted keys, compact separators, unescaped Unicode"
      },
      "scientificProfile": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Die Ladung am amphiphilen Kopf bestimmt die Tensidklasse,nicht das Gegenion.",
            "essentialUnderstandingEn": "Charge on the amphiphilic head determines class,not the counterion.",
            "observablePerformanceDe": "In6a und6b leitet sie anionische, kationische und nichtionische Klassen aus Kopfgruppen ab; bei einem zusätzlichen protonierbaren Amin nutzt sie die vorgegebenen pH-Daten statt eine permanente Ladung anzunehmen.",
            "observablePerformanceEn": "In6a and6b the learner derives anionic, cationic and nonionic classes from head groups; for an additional protonatable amine, supplied pH data prevent assuming permanent charge."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Ein ungeladener polarer Tensidkopf kann durch OH- oder Ethergruppen mit Wasser wechselwirken; formale Kopfladung und Gesamtneutralität des Salzes sind unterschiedliche Aussagen.",
            "essentialUnderstandingEn": "An uncharged polar surfactant head can interact with water through OH or ether groups; formal head charge differs from overall salt neutrality.",
            "observablePerformanceDe": "In6a und6b markiert die lernende Person Kopf, Kette und Gegenion, erklärt die Hydratation eines Ethoxylat- oder Glucosidkopfs und begründet die drei kanonischen Tensidklassen.",
            "observablePerformanceEn": "In6a and6b the learner identifies head, tail and counterion, explains hydration of an ethoxylate or glucoside head, and justifies the three canonical surfactant classes."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "pH und Mischbedingungen begrenzen ausStruktur abgeleitete Aussagen.",
            "essentialUnderstandingEn": "pH/mixing conditions limit structural inferences.",
            "observablePerformanceDe": "In6a und6b unterscheidet sie einen Gegenionenaustausch von einer pH-bedingten Kopfladungsänderung und benennt fehlende Daten für quantitative Löslichkeits- oder Leistungsbehauptungen.",
            "observablePerformanceEn": "In6a and6b the learner distinguishes counterion substitution from a pH-dependent change in head charge and identifies missing data for quantitative solubility or performance claims."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",
            "e2",
            "e3"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "energy20-06-a-transfer",
            "textDe": "Entferne eine Ethoxyeinheit ausC und ersetze Na+ inA durchK+. Welche Klasse bleibt, welche quantitative Eigenschaft ist ohne Daten offen?",
            "textEn": "Remove one ethoxy unit fromC and replaceNa+ byK+ inA. Decide which class remains and which quantitative properties cannot follow from structure alone."
          },
          {
            "id": "energy20-06-b-transfer",
            "textDe": "Ersetze den Glucosidkopf von L durch eine angegebene ungeladene Ethoxykette und ersetze Na+ in K durch K+. Begründe, welche Zuordnungen bleiben und welche quantitative Löslichkeits- oder Leistungsangabe neue Stoffdaten benötigt.",
            "textEn": "Replace the glucoside head of L with a specified uncharged ethoxy chain and change Na+ to K+ in K. Justify which classifications remain and which quantitative solubility or performance claims require new substance data."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "energy20-06-a",
            "taskDemandDe": "Ganzes eigenes Material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json #energy20-06-a. OrdneA/B/C begründet als anionisch, kationisch oder nichtionisch zu. Markiere Kopf, Schwanz und Gegenion. Erkläre die Wechselwirkung vonC mit Wasser und warumD kein Tensid ist. Sage eine mögliche Folge einerA/B-Mischung voraus, ohne alle Mischungen als unlöslich zu behandeln.",
            "taskDemandEn": "Whole own material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json #energy20-06-a. ClassifyA/B/C as anionic/cationic/nonionic,mark heads/tails/counterions. Explain water interaction of unchargedC and whyD is not a surfactant. Predict a plausible consequence of combiningA/B heads without claiming all mixtures precipitate.",
            "expectedPerformanceDe": "A trägt den negativen Sulfatester-Kopf, Na+ist Gegenion; B den positiven quartären Ammoniumkopf mit Br−. C hat eine polare sauerstoffreiche Ethoxyregion ohne formale Ladung. Neutralität des gesamten Salzes ändert die Kopfklasse nicht. NaCl fehlt der lipophile Schwanz. Entgegengesetzte Köpfe können abhängig von Konzentration/Zusammensetzung Ionenpaare oder schwerlösliche Komplexe bilden. Die Klasse beweist keine bestimmte Waschleistung.",
            "expectedPerformanceEn": "A has a negative sulfate-ester head,Na+ is its counterion;B a positive quaternary ammonium head withBr−;C’s oxygen-rich ethoxy region is polar and interacts with water. Neutrality of the entire salt does not change head classification. NaCl lacks a lipophilic tail. Opposite heads can form ion pairs/poorly soluble complexes depending on composition/concentration. Classification does not prove identical cleaning performance.",
            "understandingFocusDe": "Entferne eine Ethoxyeinheit ausC und ersetze Na+ inA durchK+. Welche Klasse bleibt, welche quantitative Eigenschaft ist ohne Daten offen?",
            "understandingFocusEn": "Remove one ethoxy unit fromC and replaceNa+ byK+ inA. Decide which class remains and which quantitative properties cannot follow from structure alone."
          },
          {
            "id": "energy20-06-b",
            "taskDemandDe": "Ganzes eigenes Material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json #energy20-06-b. Charakterisiere K, G und L aus dem Aufbau als anionisch, kationisch oder nichtionisch. Markiere jeweils Kopf, Kette und gegebenenfalls Gegenion und begründe, wie die Kopfregion mit Wasser wechselwirkt. Erkläre am zusätzlichen Amin, warum die pH-Angabe eine Klassifizierung beeinflussen kann, ein quartärer Ammoniumkopf aber nicht auf dieselbe Weise protoniert wird.",
            "taskDemandEn": "Whole own material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json #energy20-06-b. Characterise K, G and L as anionic, cationic or nonionic from their structures. Mark head, tail and any counterion, and justify how each head interacts with water. Use the additional amine to explain why pH can affect classification, while a quaternary ammonium head is not protonated in the same way.",
            "expectedPerformanceDe": "K trägt eine negativ geladene Sulfonatgruppe mit Na+ als Gegenion; G trägt den positiven quartären Ammoniumkopf mit Cl−. L besitzt einen ungeladenen OH-reichen polaren Kopf, der Wasserstoffbrücken mit Wasser bilden kann. Die unpolare Kette vermittelt Wechselwirkung mit unpolaren Stoffen. Gesamtneutralität der Salze ändert die Kopfladung nicht. E kann durch Protonierung kationisch werden; ohne pH-/Stoffdaten ist es nicht als permanent kationisch einzuordnen. Die drei Zuordnungen enthalten keinen Beweis gleicher Waschleistung oder Umweltverträglichkeit.",
            "expectedPerformanceEn": "K has a negatively charged sulfonate head with Na+ as counterion; G has a positive quaternary ammonium head with Cl−. L has an uncharged OH-rich polar head that can hydrogen-bond with water. The nonpolar tail interacts with nonpolar substances. Overall salt neutrality does not remove head charge. E can become cationic through protonation; without pH/substance data it cannot be treated as permanently cationic. Classification does not establish equal cleaning performance or environmental safety.",
            "understandingFocusDe": "Ersetze den Glucosidkopf von L durch eine angegebene ungeladene Ethoxykette und ersetze Na+ in K durch K+. Begründe, welche Zuordnungen bleiben und welche quantitative Löslichkeits- oder Leistungsangabe neue Stoffdaten benötigt.",
            "understandingFocusEn": "Replace the glucoside head of L with a specified uncharged ethoxy chain and change Na+ to K+ in K. Justify which classifications remain and which quantitative solubility or performance claims require new substance data."
          }
        ]
      },
      "caseLocators": [

    {
      "goalId": "a76ab487-4663-5005-8454-cb3196f3773b",
      "titleDe": "Bioethanolproduktion erklären",
      "sourceJsonPointer": "/goals/7/reviewContext/evidenceProfile/profile",
      "selectedValuePin": {
        "sha256": "8d737d8d3c6e42998bb2d3edb620cbf1de340f86b8172318e50ea96d6cea15b3",
        "bytes": 8114,
        "encoding": "UTF-8 JSON, sorted keys, compact separators, unescaped Unicode"
      },
      "scientificProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "production-chain",
            "essentialUnderstandingDe": "Stärke wird unter Wasseraufnahme zu Glucose gespalten; Gärung wandelt Glucose in Ethanol und CO2 um.",
            "essentialUnderstandingEn": "Hydrolysis of starch releases glucose with water uptake; fermentation converts glucose to ethanol and CO2.",
            "observablePerformanceDe": "Beide verschiedenen Prozessschritte eigenständig am neuen Rohstoffweg erklären.",
            "observablePerformanceEn": "Independently explain both distinct steps for a new feedstock route."
          },
          {
            "id": "glucose-structure",
            "essentialUnderstandingDe": "Die bereitgestellte eindeutige Glucosestruktur zeigt mehr als die Summenformel; offene Form und Ringformen sind Darstellungen desselben Stoffes.",
            "essentialUnderstandingEn": "The supplied unambiguous glucose structure conveys more than a molecular formula; open and ring forms represent the same substance.",
            "observablePerformanceDe": "An G Sechs-C-Gerüst, fünf OH, endständige Aldehydgruppe und Grenze der offenen Darstellung erläutern; keine neue allgemeine Zucker-/Stereoklassifikation.",
            "observablePerformanceEn": "Use G to explain six carbons, five OH groups, terminal aldehyde and limits of the open form; no new general carbohydrate/stereochemical classification."
          },
          {
            "id": "benefit-risk-evaluation",
            "essentialUnderstandingDe": "Nachwachsender Kohlenstoff oder Reststoffnutzung begründet nur bedingte Nutzen; Prozessgrenzen, Energie und Flächennutzung bestimmen Risiken.",
            "essentialUnderstandingEn": "Renewable carbon or residue use supports conditional benefits; process boundaries, energy and land use govern risks.",
            "observablePerformanceDe": "Mindestens einen Nutzen und konkrete Grenzen materialbezogen begründen und unbelegte Klimaneutralität oder aus Verlusten abgeleiteten Umsetzungsfehlschluss zurückweisen.",
            "observablePerformanceEn": "Give material-based reasons for a benefit and specific limits, rejecting unsupported climate neutrality or a conversion inference based on separation loss."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "production-chain",
            "glucose-structure",
            "benefit-risk-evaluation"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "feedstock-step",
            "textDe": "Stärkehaltige Pflanze gegenüber bereits vorliegender Glucose; ungeeignetes Enzym als neuer Gegenfall.",
            "textEn": "Starch crop versus glucose already present; unsuitable enzyme as a fresh countercase."
          },
          {
            "id": "process-boundary",
            "textDe": "Herstellung gegenüber Isolierung und Rohstoff-/Energiegrenzen.",
            "textEn": "Production versus isolation and feedstock/energy boundaries."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "bioethanol-qualitative-starch-crop-transfer",
            "taskDemandDe": "Beschreibe die Herstellungskette von der stärkehaltigen Pflanze über Glucose zu Ethanol. Erkläre an Karte G den Glucoseaufbau und die Darstellungsgrenze. Erkläre, weshalb Stärkeabbau und Gärung verschiedene Umwandlungen sind. Bewerte die Plakatbehauptung mit einem begründeten möglichen Nutzen und zwei konkreten Grenzen. Bearbeite anschließend die frische Variation. Keine Mol-, Ausbeute- oder Massenrechnung ist erforderlich.",
            "taskDemandEn": "Describe the chain from a starch crop through glucose to ethanol. Explain glucose structure and representation limits using card G. Explain why starch breakdown and fermentation are different transformations. Assess the poster with one reasoned potential benefit and two specific limits. Then address the fresh variation. No mole, yield or mass calculation is required.",
            "expectedPerformanceDe": "Wasseraufnahme bei der Spaltung verknüpfter Glucosebausteine liefert Glucose, nicht unmittelbar Ethanol. G zeigt die eindeutig vorgegebene offene D-Glucose mit sechs C, fünf OH und endständiger CHO-Gruppe; Ringformen in Wasser begrenzen die Darstellung. Bei der Gärung wird Glucose chemisch zu Ethanol und CO2 umgewandelt. Die Pflanze kann zuvor CO2 gebunden haben; das macht Anbau, Prozessenergie, CO2-Freisetzung und mögliche Nahrungskonkurrenz nicht null. Ohne Systemgrenze und Daten ist keine Rangfolge der gesamten Klimabilanz bewiesen.",
            "expectedPerformanceEn": "Hydrolysis of linked glucose units takes up water and releases glucose, not ethanol directly. G specifies open-chain D-glucose with six carbons, five OH and a terminal CHO group; predominant aqueous ring forms limit that representation. Fermentation chemically converts glucose to ethanol and CO2. Crop growth may have bound CO2, but growing, process energy, CO2 release and possible food competition remain. Without system boundaries and data no ranking of complete climate footprints is established.",
            "understandingFocusDe": "Frische Variation: Der Lieferant ersetzt Stärke durch Cellulose, für die das vorhandene Enzym laut neuer Materialkarte nicht geeignet ist. Erkläre, weshalb dieselbe Pflanzennutzung und derselbe spätere Gärungsschritt keinen gesicherten Glucosezulauf ergeben.",
            "understandingFocusEn": "Fresh variation: the supplier substitutes cellulose; a new card states that the existing enzyme cannot cleave it. Explain why using plant material and retaining the later fermentation step does not ensure a glucose feed."
          },
          {
            "id": "bioethanol-qualitative-juice-residual-starch-transfer",
            "taskDemandDe": "Erkläre, an welcher Stelle sich A und B unterscheiden und weshalb die Gärung in beiden an Glucose anknüpft. Erläutere die Glucosestruktur an G und beschreibe die Umwandlung zu Ethanol einschließlich CO2 als weiterem Produkt. Prüfe den Schluss aus dem Abtrennverlust. Bewerte bedingt, unter welchen Gesichtspunkten B einen Nutzen oder ein Risiko gegenüber A hat; markiere fehlende Informationen. Bearbeite die frische Variation qualitativ.",
            "taskDemandEn": "Explain where A and B differ and why fermentation starts from glucose in both. Explain glucose structure using G and describe conversion to ethanol with CO2 as another product. Assess the conclusion based on separation loss. Give a conditional assessment of benefits and risks of B compared with A and identify missing information. Address the fresh variation qualitatively.",
            "expectedPerformanceDe": "A braucht für die bereits vorliegende Glucose keinen Stärkeabbau; B benötigt zuerst die Spaltung der Stärke unter Wasseraufnahme. Dieselbe in G spezifizierte Glucose kann danach vergoren werden; die offene Darstellung mit CHO und fünf OH unterscheidet sich von der Summenformel und ist nicht die vorherrschende wässrige Ringdarstellung. Gärung erzeugt Ethanol und CO2; geringere isolierte Ethanolmenge kann durch Abtrennverlust entstehen und beweist nicht das Ausbleiben der Umsetzung. Reststoffnutzung kann Nahrungskonkurrenz vermindern, Sammlung und Abtrennung können aber Energie benötigen. Eine Gesamtvorteilsbehauptung erfordert weitere Daten und gleiche Nutzenergiegrenze.",
            "expectedPerformanceEn": "A needs no starch hydrolysis for glucose already present; B first requires starch cleavage with water uptake. The same glucose specified in G can then ferment; its open-chain CHO and five OH groups provide information beyond a molecular formula and do not represent the predominant aqueous ring form. Fermentation produces ethanol and CO2; lower isolated ethanol can result from separation loss and does not prove absence of conversion. Residue use may reduce food competition but collection and separation can require energy. A claim of overall superiority needs more data and an equal-useful-energy boundary.",
            "understandingFocusDe": "Frische Variation: In einer neuen Lieferkette wird der Saft durch stärkehaltige Körner ersetzt, aber nur die spätere Gärung beibehalten. Bestimme den fehlenden vorgelagerten Schritt und erkläre, weshalb Gasblasen allein weder das Ausgangsmolekül Glucose noch isoliertes Ethanol nachweisen.",
            "understandingFocusEn": "Fresh variation: a new supply chain replaces juice with starchy grains but retains only the later fermentation step. Identify the missing preceding step and explain why bubbles alone establish neither glucose as the starting molecule nor isolated ethanol."
          }
        ]
      },
      "caseLocators": [

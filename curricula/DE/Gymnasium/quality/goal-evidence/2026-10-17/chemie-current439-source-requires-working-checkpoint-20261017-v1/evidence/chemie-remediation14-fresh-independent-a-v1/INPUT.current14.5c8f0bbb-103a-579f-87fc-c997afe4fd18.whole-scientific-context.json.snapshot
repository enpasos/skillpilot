      "profile": {
        "archetype": "experiment",
        "expectations": [
          {
            "id": "structure-and-evidence",
            "essentialUnderstandingDe": "Nachweise reagieren auf chemische Merkmale und erfordern Kontrollen sowie reale Durchführungsevidenz.",
            "essentialUnderstandingEn": "Assays respond to chemical features and require controls plus evidence of actual execution.",
            "observablePerformanceDe": "Ninhydrin zeigt bei vielen freien Aminogruppen eine Färbung; Biuret verlangt mehrere geeignete Peptidbindungen, Glycin bleibt negativ. Reagenzien/Probeninterferenzen werden kontrolliert.",
            "observablePerformanceEn": "Ninhydrin responds to many free amino groups; biuret requires multiple suitable peptide bonds and glycine is negative. Reagent/sample interferences are controlled."
          },
          {
            "id": "fresh-transfer",
            "essentialUnderstandingDe": "Die gleiche fachliche Beziehung wird auf einen veränderten Fall übertragen; Bedingungen und Schlussgrenzen werden benannt.",
            "essentialUnderstandingEn": "The same subject relationship is transferred to a changed case with explicit conditions and inference limits.",
            "observablePerformanceDe": "Befunde stützen die jeweilige Stoffklasse, nicht die eindeutige Verbindung. Ein analysiertes fremdes Protokoll belegt keine eigene Versuchsdurchführung; hierfür sind beobachtetes Arbeiten und eigenes Protokoll nötig.",
            "observablePerformanceEn": "Results support classes, not unique compounds. Analysing a supplied record does not demonstrate personally executing the experiment; observed practice and personal records are required."
          },
          {
            "id": "execution",
            "essentialUnderstandingDe": "Durchführen undchemische Selektivitätvergleichen.",
            "essentialUnderstandingEn": "Execute and compare chemical selectivity.",
            "observablePerformanceDe": "Glycinmit Ninhydrinviolett, mit Biuretkein Proteinnachweis; Eiklar Biuretviolett. Richtige Proben/Kontrollen und Dokumentationder Reihenfolge zählen. Ninhydrin reagiertmitgeeigneten Aminogruppen, nichtproteinexklusiv; Prolin kannabweichen.",
            "observablePerformanceEn": "Glycine ninhydrin violet, but not positive protein biuret; eggwhite biuret positive. Correct samples/controls and execution order count. Ninhydrin reacts with suitable amino groups, not exclusively proteins; proline can differ."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "structure-and-evidence",
            "fresh-transfer",
            "execution"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "material-operator-context",
            "textDe": "Die ausgearbeiteten Fälle wechseln Stoff, Kontrollprobe, pH, Bezugsgröße, Quellenweg oder Nutzungskontext. Werte sind ausdrücklich Aufgabenwerte; tatsächliche Durchführung/Recherche wird im individuellen Lernpfad nur anhand vorgelegter Arbeit beurteilt.",
            "textEn": "Worked cases vary substance, control, pH, unit, search path or use. Values are task data; actual individual execution/research is assessed only from submitted work."
          },
          {
            "id": "changed-secondary-amine-substrate",
            "textDe": "Prolin und primäres Nicht-Aminosäure-Modell aus vollständigen Strukturen vergleichen, ohne erhaltene Praxis zu ersetzen.",
            "textEn": "Compare proline and a primary non-amino-acid model from complete structures without replacing retained practical execution."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "case-a",
            "taskDemandDe": "Plane in einem schulisch freigegebenen Verfahren Ninhydrin- und Biuret-Vergleich an Glycin und einem Protein samt Blindproben; begründe erwartete Befunde.",
            "taskDemandEn": "Plan school-authorised ninhydrin and biuret comparison of glycine and a protein with blanks; justify expected results.",
            "expectedPerformanceDe": "Ninhydrin zeigt bei vielen freien Aminogruppen eine Färbung; Biuret verlangt mehrere geeignete Peptidbindungen, Glycin bleibt negativ. Reagenzien/Probeninterferenzen werden kontrolliert.",
            "expectedPerformanceEn": "Ninhydrin responds to many free amino groups; biuret requires multiple suitable peptide bonds and glycine is negative. Reagent/sample interferences are controlled.",
            "understandingFocusDe": "Nachweise reagieren auf chemische Merkmale und erfordern Kontrollen sowie reale Durchführungsevidenz.",
            "understandingFocusEn": "Assays respond to chemical features and require controls plus evidence of actual execution."
          },
          {
            "id": "case-b-transfer",
            "taskDemandDe": "Werte ein bereitgestelltes Protokoll zweier getrennter Tests aus. Ninhydrin: Wasser-Reagenzienblindprobe auf demselben Filterpapier ohne zusätzliche violette Färbung gegenüber dem Reagenzien-/Papierhintergrund; Glycin violett. Biuret: Wasser-Reagenzienblindprobe blau ohne violetten positiven Komplex; Glycin negativ, Protein violett. Welche Aussagen und welche Durchführungsevidenz fehlen?",
            "taskDemandEn": "Evaluate a supplied record of two separate tests. Ninhydrin: the water/reagent blank on the same filter paper shows no additional violet colour against the reagent/paper background; glycine is violet. Biuret: the water/reagent blank is blue without a violet positive complex; glycine is negative and protein is violet. What conclusions and execution evidence remain absent?",
            "expectedPerformanceDe": "Befunde stützen die jeweilige Stoffklasse, nicht die eindeutige Verbindung. Ein analysiertes fremdes Protokoll belegt keine eigene Versuchsdurchführung; hierfür sind beobachtetes Arbeiten und eigenes Protokoll nötig.",
            "expectedPerformanceEn": "Results support classes, not unique compounds. Analysing a supplied record does not demonstrate personally executing the experiment; observed practice and personal records are required.",
            "understandingFocusDe": "Nachweise reagieren auf chemische Merkmale und erfordern Kontrollen sowie reale Durchführungsevidenz.",
            "understandingFocusEn": "Assays respond to chemical features and require controls plus evidence of actual execution."
          },
          {
            "id": "execution-1",
            "taskDemandDe": "Führe betreut zwei Nachweise aus. Ninhydrin: jeein Tropfen1%Glycin und Wasser aufgetrennte Filterpapierfelder; mitbereitgestellterethanolischer Ninhydrinlösung im Abzug nach Freigabe benetzen, trocknen undimwarmluftfreien80°C-Trockenschrank2min erwärmen. Biuret: je2mLverdünntes Eiklar, Glycin, Wasser +1mLNaOH1M +10Tropfen CuSO4 0, 1M, mischen. Protokolliere Ausführung, Kontrollen undtatsächliche Befunde.",
            "taskDemandEn": "Execute supervised two assays. Ninhydrin: one drop each1%glycine/water on separate paper fields; wet using provided ethanolic ninhydrin in hood, leave dry then warm2min80°C drying cabinet. Biuret: 2ml diluted eggwhite, glycine, water+1mL1M NaOH+10drops0.1M CuSO4, mix. Log execution, controls and actual findings.",
            "expectedPerformanceDe": "Glycinmit Ninhydrinviolett, mit Biuretkein Proteinnachweis; Eiklar Biuretviolett. Richtige Proben/Kontrollen und Dokumentationder Reihenfolge zählen. Ninhydrin reagiertmitgeeigneten Aminogruppen, nichtproteinexklusiv; Prolin kannabweichen.",
            "expectedPerformanceEn": "Glycine ninhydrin violet, but not positive protein biuret; eggwhite biuret positive. Correct samples/controls and execution order count. Ninhydrin reacts with suitable amino groups, not exclusively proteins; proline can differ.",
            "understandingFocusDe": "Durchführen undchemische Selektivitätvergleichen.",
            "understandingFocusEn": "Execute and compare chemical selectivity."
          },
          {
            "id": "proline-reference-transfer",
            "taskDemandDe": "Schriftlicher Referenzfall; vollständige Karte beigefügt. G=H2N-CH2-C(=O)OH. P=Prolin, Ring NH-CH(COOH)-CH2-CH2-CH2-zurück zu NH, C5H9NO2; N bindet zwei C und ein H. Neutrale Formeln zeigen Konnektivität, keine Festlegung wässriger Spezies. KSU BCH302, PDF17–18:1mL Probe+1mL Ninhydrinlösung,2min Wasserbad, abkühlen; Abbildungen Glycin blauviolett/Prolin gelb. Quellkonzentration/Rezeptur nicht vollständig angegeben: keine neue Labor-SOP oder quantitative Farbskala. Gelb ist hier anderes Reaktionsprodukt, nicht Reaktionslosigkeit. Vorhandene eigene Praxis und getrennte Kontrollen bleiben erforderlich.\n\nVergleiche die Strukturen von G und P: Zähle die C-Bindungspartner am N und suche Peptidbindungen. Erkläre, weshalb „nicht violett“ bei P unter den gegebenen Referenzbedingungen nicht „keine Aminocarbonsäure“ bedeutet. Prüfe außerdem die Behauptung „Weil beide Aminosäuren sind, müssen beide eine typische positive Biuret-Peptidreaktion zeigen“. Trenne diese schriftliche Erklärung von tatsächlicher Ausführungsevidenz.\nFrischer Transfer (erst nach eigener Antwort): Neue ausdrücklich als Lehrmodell gegebene Karte E: Ethanolamin H2N-CH2-CH2-OH (C2H7NO) trägt eine primäre Aminogruppe, aber keine Carboxygruppe und keine Peptidbindung. Im vorgegebenen qualitativen Ninhydrinmodell entsteht eine blauviolette Färbung. Prüfe „Jede violette Ninhydrinprobe identifiziert eine Aminosäure“. Welche Strukturprüfung oder unabhängige Analytik fehlt?",
            "taskDemandEn": "Written reference case; full card attached. G=H2N-CH2-C(=O)OH. P=proline, cyclic NH-CH(COOH)-CH2-CH2-CH2-back to NH,C5H9NO2; N bonds to two C and one H. Neutral formulas show connectivity, not fixed aqueous speciation. KSU BCH302 PDF17–18:1mL sample+1mL ninhydrin,2min water bath, cool; source images show glycine blue-purple/proline yellow. Concentration/recipe are incompletely reported: no new laboratory SOP or quantitative colour scale. Yellow is a different product here, not absence of reaction. Existing own practical work and separate controls remain required.\n\nCompare G and P: count carbon neighbours at N and identify any peptide bonds. Explain why “not purple” for P under the stated reference conditions does not mean “not an amino carboxylic acid”. Also assess “Because both are amino acids, both must give the typical positive biuret peptide response.” Separate written explanation from actual execution evidence.\nFresh transfer (release only after an independent answer): New explicitly supplied teaching-model card E: ethanolamine H2N-CH2-CH2-OH (C2H7NO) has a primary amino group but no carboxyl group and no peptide bond. The supplied qualitative ninhydrin model gives blue-purple colour. Assess “Every purple ninhydrin result identifies an amino acid.” Which structural check or independent analysis is missing?",
            "expectedPerformanceDe": "G besitzt eine primäre, P eine sekundäre Aminogruppe im Fünfring; P besitzt weiterhin eine Carboxygruppe und ist eine Aminocarbonsäure. Die gegebene gelbe Ninhydrinreaktion ist kein negativer Universalnachweis. Weder G noch P besitzt eine Peptidbindung; daraus folgt im hier gemeinten Peptidnachweismodell keine typische positive Biuretreaktion. Andere Kupferkoordination oder Hintergrundfarben dürfen nicht als positiver Peptidkomplex ausgegeben werden. Die Papierantwort belegt keine selbst ausgeführte Probe und ersetzt nicht die vorhandene Praxis. Transfer: Die Aussage ist falsch: eine geeignete primäre Aminogruppe kann ein Signal geben, obwohl die Carboxygruppe fehlt. Die Kombination der erforderlichen Strukturmerkmale beziehungsweise eine geeignete ergänzende Analytik muss gesondert gezeigt werden; Farbe allein liefert keine eindeutige Stoffidentität oder eigene Durchführung.",
            "expectedPerformanceEn": "G has a primary amino group and P a secondary amino group in a five-membered ring; P retains its carboxyl group and is an amino carboxylic acid. The supplied yellow ninhydrin response is not a universal negative. Neither G nor P has a peptide bond, so the peptide-assay model gives no typical positive biuret response. Other copper coordination or background colours must not be labelled a positive peptide complex. A paper answer establishes no personally executed assay and does not replace existing practical work. Transfer: The claim is false: a suitable primary amino group can give a signal without a carboxyl group. Required structural features or suitable complementary analysis need separate evidence; colour alone gives neither unique identity nor personal execution.",
            "understandingFocusDe": "Wirklich andere gegebene Substratstruktur und Farbreaktion; funktionelle Gruppen und analytische Grenzen statt Wiederholung desselben Glycin/Proteinprotokolls. Keine zusätzliche starre Aufgabenquote; ausreichende zusammenhängende Leistung kann genügen.",
            "understandingFocusEn": "A genuinely different supplied substrate structure and response; functional groups and assay limits rather than repetition of the same glycine/protein record. No additional fixed task quota; sufficient connected performance can suffice."
          }
        ]
      }
    }
  },

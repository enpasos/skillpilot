  "wholeElevenScientificFindings": [
    {
      "goalId": "54bc6ca0-b770-5f10-ac54-bcc1d04298f5",
      "title": "Emission und Absorption zur Farbigkeit unterscheiden",
      "decision": "KEEP",
      "wholeCurrentPBodySha256": "5b22f676dc831cc693fb479bc6f426ce43cd5dfa3bff20e10d6164264db6170f",
      "wholePAndOriginalMaterialFindingDe": "Die beiden ganzen Fälle trennen Materie→Photon bei der LED von Licht→Materie in Lösung/Filter.470nm ist Emission; Entfernen des Blauanteils aus Weißlicht ist kein blaues Emissionssignal. Der nicht fluoreszierende Filter erzeugt aus630nm keine540nm;540nm passiert,630nm wird absorbiert. Dunkelheit und fehlende eigene Anregung schließen das im Auftrag unterstellte Selbstleuchten aus.",
      "teacherAndAcquisitionFindingDe": "Der BW-Erwerbsplatz trägt die notwendige vorhandene Grundlage der87d8-/61da-Aufträge. Kein unabhängiger54bc-Override ist nötig; seine vorgeschlagene BW-Ableitung ist erst durch einen späteren tatsächlichen Compilerlauf zu bestätigen.",
      "unchangedTargetViewCount": 2,
      "contexts": [

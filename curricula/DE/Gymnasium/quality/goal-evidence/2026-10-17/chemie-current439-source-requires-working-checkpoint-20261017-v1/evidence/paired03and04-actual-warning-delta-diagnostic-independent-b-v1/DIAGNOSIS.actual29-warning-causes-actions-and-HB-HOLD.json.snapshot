      "relevantOrdinaryScopeAnnotations": [
        {
          "extensionId": "package03-retained-lk-target-DE-HH-2d16528c",
          "jurisdiction": "DE-HH",
          "stageIntent": "SekII",
          "courseProfiles": [
            "LK"
          ],
          "viewIds": [
            "de-hh-gym-chemistry-lk"
          ],
          "role": "authored-acquisition-extension",
          "officialWholeSourceCredit": false,
          "sourceContext": "S1–4/1.2, physisch/gedruckt25: Fette/Ester/Hydrolyse im gemeinsamen Inhaltsteil, zusätzliche Mechanismus-/Kennzahlanforderungen im erhöhten Niveau. Nachhaltige Waschmittel können im BNE-Kontext thematisiert werden. Daraus folgt weder eine spezielle Zeolithpflicht noch die vollständige biologische Tensidabbaukompetenz. Beide vorhandenen LK-Ziele werden als eigene fachliche Vertiefung dieses bereits verfassten Waschmittelpfades angeboten.",
          "acquisitionScope": "Whole existing ordinary zeolite goal and whole P: fixed aluminosilicate framework charge, mobile counterions,1Ca2+:2Na+ exchange, finite capacity, competition, saturation/regeneration and stated resource/effluent limits.",
          "scopeInputBoundary": "Only supported applicabilityOverrides.jurisdiction input is used. This adds no courseProfile, stage or duration override. Current whole views remain CrossStage and retain their LK filter and all existing projection roles.",
          "topicChoiceBoundary": "Own broader retained target before a later topic selector; no universal official duty or persisted/individual learner theme selection is asserted.",
          "executionBoundary": "All supplied cases are prospective synthetic teaching models; no actual ion exchange, regeneration, biodegradation test, chemical assay or learner performance is established."
        },
        {
          "extensionId": "package03-retained-lk-target-DE-MV-2d16528c",
          "jurisdiction": "DE-MV",
          "stageIntent": "SekII",
          "courseProfiles": [
            "LK"
          ],
          "viewIds": [
            "de-mv-gym-chemistry-lk"
          ],
          "role": "authored-acquisition-extension",
          "officialWholeSourceCredit": false,
          "sourceContext": "Physisch35/gedruckt31: allgemeine Mengenrechnung steht vor der LK-Abgrenzung. Unter zusätzlich LK stehen Komplexverbindungen; Wasserhärte/Wasserenthärtung erscheinen in der rechten Hinweisspalte als zusätzlich mögliche Experimente. Das ist weder eine Zeolithstrukturvorschrift noch ein biologischer Abbauwegauftrag. Die beiden bestehenden Ziele sind eigene begrenzte Vertiefungen; kein zusätzlich mögliches Experiment wird als durchgeführt oder universell Pflicht erklärt.",
          "acquisitionScope": "Whole existing ordinary zeolite goal and whole P: fixed aluminosilicate framework charge, mobile counterions,1Ca2+:2Na+ exchange, finite capacity, competition, saturation/regeneration and stated resource/effluent limits.",
          "scopeInputBoundary": "Only supported applicabilityOverrides.jurisdiction input is used. This adds no courseProfile, stage or duration override. Current whole views remain CrossStage and retain their LK filter and all existing projection roles.",
          "topicChoiceBoundary": "Own broader retained target before a later topic selector; no universal official duty or persisted/individual learner theme selection is asserted.",
          "executionBoundary": "All supplied cases are prospective synthetic teaching models; no actual ion exchange, regeneration, biodegradation test, chemical assay or learner performance is established."
        },
        {
          "extensionId": "package03-retained-lk-target-DE-RP-2d16528c",
          "jurisdiction": "DE-RP",
          "stageIntent": "SekII",
          "courseProfiles": [
            "LK"
          ],
          "viewIds": [
            "de-rp-gym-chemistry-lk"
          ],
          "role": "authored-acquisition-extension",
          "officialWholeSourceCredit": false,
          "sourceContext": "Physisch/gedruckt27,29,71:16.1 und16.2 sind für Grund- und Leistungsfach als W markiert; im LK-Wahlpool stehen beide mit4h. Stoffgruppen, Härteempfindlichkeit von Seifen, moderne Waschmittel und ökologische Aspekte liefern Kontext. Weder individuelle Auswahl noch die vollständigen Zeolith-/Abbau-Fälle folgen daraus. SkillPilot behält die bereits verfassten LK-Targets gemäß dem Themen-vor-Auswahl-Fluss als eigene Erwerbserweiterung; der amtliche Wahlstatus bleibt erhalten.",
          "acquisitionScope": "Whole existing ordinary zeolite goal and whole P: fixed aluminosilicate framework charge, mobile counterions,1Ca2+:2Na+ exchange, finite capacity, competition, saturation/regeneration and stated resource/effluent limits.",
          "scopeInputBoundary": "Only supported applicabilityOverrides.jurisdiction input is used. This adds no courseProfile, stage or duration override. Current whole views remain CrossStage and retain their LK filter and all existing projection roles.",
          "topicChoiceBoundary": "Own broader retained target before a later topic selector; no universal official duty or persisted/individual learner theme selection is asserted.",
          "executionBoundary": "All supplied cases are prospective synthetic teaching models; no actual ion exchange, regeneration, biodegradation test, chemical assay or learner performance is established."
        },
        {
          "extensionId": "package03-retained-lk-target-DE-SH-2d16528c",
          "jurisdiction": "DE-SH",
          "stageIntent": "SekII",
          "courseProfiles": [
            "LK"
          ],
          "viewIds": [
            "de-sh-gym-chemistry-lk"
          ],
          "role": "authored-acquisition-extension",
          "officialWholeSourceCredit": false,
          "sourceContext": "Physisch/gedruckt68–70: Das Sachgebiet funktionale Stoffe lässt Themenwahl zu.69 nennt die verbindlichen Grenzen; grenzflächenaktive Stoffe werden nicht zur universellen LK-Einzelpflicht erklärt.70 beschreibt Struktur/Eigenschaften von Tensiden, Waschmittelbestandteile und kritische Inhaltsstoffbetrachtung. Spezifische Zeolithkapazität und die ganzen mikrobiellen Abbau-/Mineralisierungsfälle sind eigene Erweiterungen des vorhandenen Targets, kein Vollquellenkredit und keine angenommene Lernerwahl.",
          "acquisitionScope": "Whole existing ordinary zeolite goal and whole P: fixed aluminosilicate framework charge, mobile counterions,1Ca2+:2Na+ exchange, finite capacity, competition, saturation/regeneration and stated resource/effluent limits.",
          "scopeInputBoundary": "Only supported applicabilityOverrides.jurisdiction input is used. This adds no courseProfile, stage or duration override. Current whole views remain CrossStage and retain their LK filter and all existing projection roles.",
          "topicChoiceBoundary": "Own broader retained target before a later topic selector; no universal official duty or persisted/individual learner theme selection is asserted.",
          "executionBoundary": "All supplied cases are prospective synthetic teaching models; no actual ion exchange, regeneration, biodegradation test, chemical assay or learner performance is established."
        },
        {
          "extensionId": "package03-retained-lk-target-DE-SL-2d16528c",
          "jurisdiction": "DE-SL",
          "stageIntent": "SekII",
          "courseProfiles": [
            "LK"
          ],
          "viewIds": [
            "de-sl-gym-chemistry-lk"
          ],
          "role": "authored-acquisition-extension",
          "officialWholeSourceCredit": false,
          "sourceContext": "Die tatsächlich betrachtete Fassung ist Hauptphase Chemie LK2023, ab Abitur2027, redaktionell2025. Physisch/gedruckt72 trennt Kompetenzerwartungen links und Vorschläge/Hinweise rechts. Fette als Ausgangsstoffe für Seifen/Tenside stehen rechts bei Verwendung. Daraus folgen die beiden ganzen Detailkompetenzen nicht. Der eigene LK-Erwerbsumfang wird ausdrücklich zusätzlich beibehalten; Einführungsphasen- und Grundkursdateien werden nicht ersatzweise als LK-Beleg verwendet.",
          "acquisitionScope": "Whole existing ordinary zeolite goal and whole P: fixed aluminosilicate framework charge, mobile counterions,1Ca2+:2Na+ exchange, finite capacity, competition, saturation/regeneration and stated resource/effluent limits.",
          "scopeInputBoundary": "Only supported applicabilityOverrides.jurisdiction input is used. This adds no courseProfile, stage or duration override. Current whole views remain CrossStage and retain their LK filter and all existing projection roles.",
          "topicChoiceBoundary": "Own broader retained target before a later topic selector; no universal official duty or persisted/individual learner theme selection is asserted.",
          "executionBoundary": "All supplied cases are prospective synthetic teaching models; no actual ion exchange, regeneration, biodegradation test, chemical assay or learner performance is established."
        },
        {
          "extensionId": "package03-retained-lk-target-DE-SN-2d16528c",
          "jurisdiction": "DE-SN",
          "stageIntent": "SekII",
          "courseProfiles": [
            "LK"
          ],
          "viewIds": [
            "de-sn-gym-chemistry-lk"
          ],
          "role": "authored-acquisition-extension",
          "officialWholeSourceCredit": false,
          "sourceContext": "Der gepinnte Gymnasiallehrplan trägt die Fassung bis2025; physisch47/gedruckt35 nennt allgemeine LK-Ziele für11/12, physisch54–55/gedruckt42–43 liegen in LK-Wahlbereichen. Silicattetraeder/Chromatographie und Soda/Seifenherstellung sind begrenzte Kontexte, keine amtliche Vollforderung der beiden Ziele. Eigener Erwerbsumfang für bestehende LK-Targets; keine Wahlbereichswahl oder gesamte Zeolith-/Tensidabbaupflicht wird erfunden.",
          "acquisitionScope": "Whole existing ordinary zeolite goal and whole P: fixed aluminosilicate framework charge, mobile counterions,1Ca2+:2Na+ exchange, finite capacity, competition, saturation/regeneration and stated resource/effluent limits.",
          "scopeInputBoundary": "Only supported applicabilityOverrides.jurisdiction input is used. This adds no courseProfile, stage or duration override. Current whole views remain CrossStage and retain their LK filter and all existing projection roles.",
          "topicChoiceBoundary": "Own broader retained target before a later topic selector; no universal official duty or persisted/individual learner theme selection is asserted.",
          "executionBoundary": "All supplied cases are prospective synthetic teaching models; no actual ion exchange, regeneration, biodegradation test, chemical assay or learner performance is established."
        },
        {
          "extensionId": "package03-retained-lk-target-DE-ST-2d16528c",
          "jurisdiction": "DE-ST",
          "stageIntent": "SekII",
          "courseProfiles": [
            "LK"
          ],
          "viewIds": [
            "de-st-gym-chemistry-lk"
          ],
          "role": "authored-acquisition-extension",
          "officialWholeSourceCredit": false,
          "sourceContext": "Physisch/gedruckt53–54 sind ausdrücklich11/12 eAN. Praktikum, organische Reaktions-/Strukturmodelle, Alkanoloxidation und Estermechanismus tragen allgemeine Kontexte. Die ganzen Zeolith-/biologischen Tensidabbaufälle werden daraus nicht exakt als amtliche Pflicht abgeleitet. Eigene LK-Ergänzung; sämtliche dortigen echten Schülerexperimente bleiben separate praktische Anforderungen.",
          "acquisitionScope": "Whole existing ordinary zeolite goal and whole P: fixed aluminosilicate framework charge, mobile counterions,1Ca2+:2Na+ exchange, finite capacity, competition, saturation/regeneration and stated resource/effluent limits.",
          "scopeInputBoundary": "Only supported applicabilityOverrides.jurisdiction input is used. This adds no courseProfile, stage or duration override. Current whole views remain CrossStage and retain their LK filter and all existing projection roles.",
          "topicChoiceBoundary": "Own broader retained target before a later topic selector; no universal official duty or persisted/individual learner theme selection is asserted.",
          "executionBoundary": "All supplied cases are prospective synthetic teaching models; no actual ion exchange, regeneration, biodegradation test, chemical assay or learner performance is established."
        },
        {
          "extensionId": "package03-retained-lk-target-DE-TH-2d16528c",
          "jurisdiction": "DE-TH",
          "stageIntent": "SekII",
          "courseProfiles": [
            "LK"
          ],
          "viewIds": [
            "de-th-gym-chemistry-lk"
          ],
          "role": "authored-acquisition-extension",
          "officialWholeSourceCredit": false,
          "sourceContext": "Physisch43/gedruckt38 erklärt links grundlegendes+erhöhtes Niveau und rechts zusätzliche erhöhte Anforderungen. Physisch55–56/gedruckt50–51 nennt organische Stoffklassen, Esterbildung/-spaltung und rechts enzymatische/basenkatalysierte Fettspaltung. Die besonderen Zeolith-/Tensidabbauroutinen sind eigene LK-Erweiterungen; die höhere Anforderungsspalte wird nicht auf GK übertragen und eine Estersynthese nicht aus dem Papierfall als durchgeführt abgeleitet.",
          "acquisitionScope": "Whole existing ordinary zeolite goal and whole P: fixed aluminosilicate framework charge, mobile counterions,1Ca2+:2Na+ exchange, finite capacity, competition, saturation/regeneration and stated resource/effluent limits.",
          "scopeInputBoundary": "Only supported applicabilityOverrides.jurisdiction input is used. This adds no courseProfile, stage or duration override. Current whole views remain CrossStage and retain their LK filter and all existing projection roles.",
          "topicChoiceBoundary": "Own broader retained target before a later topic selector; no universal official duty or persisted/individual learner theme selection is asserted.",
          "executionBoundary": "All supplied cases are prospective synthetic teaching models; no actual ion exchange, regeneration, biodegradation test, chemical assay or learner performance is established."

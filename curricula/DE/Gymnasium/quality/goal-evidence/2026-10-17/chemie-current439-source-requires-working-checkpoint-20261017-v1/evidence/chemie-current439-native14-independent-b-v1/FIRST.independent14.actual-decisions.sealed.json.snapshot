    {
      "goalId": "7f140b34-ed26-59e7-8ad2-ccb6b56bc9d6",
      "goalFingerprint": "sha256:5dfa0a7e6ce7ba85e71cba28ce8379619eded217571b43633d30188cd49e634a",
      "pageFingerprint": "sha256:53258daee27c9acc57819669e8cb64b0b95f5157c9375c2b519454845493af9a",
      "decision": "keep",
      "rationale": "Das Ziel verbindet konkrete chemische Funktion und begründete gesellschaftliche Diskussion in einer überschaubaren Anwendungskompetenz. Das P verlangt chemisch gestützte Aussagen zu Nutzen und Grenzen statt Berufsnamen oder pauschalem Gut/Schlecht. Es trennt Flockung von Trinkwassernachweis, Materialfunktion von allgemeiner Umweltbewertung und Kunststofffragmentierung von vollständigem biologischem Abbau. Der neue Nutzungsfall desselben Polymers verlangt eine eigene funktionsbezogene Abwägung. Das Bild eröffnet Anwendungen und Berufe, ohne einen überlegenen Werkstoff oder eine reale Untersuchung zu behaupten.",
      "understandingEvidence": {
        "essentialUnderstandingDe": "Der gesellschaftliche Nutzen einer chemischen Anwendung folgt aus einer konkreten Stofffunktion unter bestimmten Nutzungsbedingungen; Grenzen und Folgen für Menschen und Umwelt brauchen eigene begründete Betrachtung.",
        "essentialUnderstandingEn": "The societal benefit of a chemical application follows from a concrete material function under specific conditions of use; limits and effects on people and the environment require separate justified consideration.",
        "observablePerformanceDe": "An konkreten Anwendungen die chemische Funktion erklären und deren Nutzen, Grenzen und mögliche Folgen für Menschen und Umwelt fachlich begründet diskutieren.",
        "observablePerformanceEn": "Explain the chemical function of concrete applications and discuss their benefits, limits and possible effects on people and the environment with scientific justification.",
        "transferExpectationDe": "Bei veränderten Einsatzbedingungen derselben Stoffklasse die Funktionsanforderung neu bestimmen und eine Aussage über Abbau, Durchlässigkeit oder Schutzwirkung entsprechend einschränken.",
        "transferExpectationEn": "When conditions of use change for the same substance class, reconsider the functional requirement and appropriately qualify a claim about degradation, permeability or protection."
      },
      "evidenceProfileRecommendation": "none",
      "sourceAndContextRead": "Whole source-information prerequisite and parent read. BY profile provides general application/society context; direct HB own scope is not blanket national equivalence. PDF physical12 and image viewed.",
      "findings": [],

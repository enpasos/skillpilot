  "decisions": [
    {
      "goalId": "53db04a0-ea76-5810-9526-c8639100e497",
      "goalFingerprint": "sha256:22652fd19fca2ba96da08b964a2880b43ce14a034fbedbdaa0af66a7fb1306ae",
      "pageFingerprint": "sha256:6486190545a94eb5ce22952b7f367f6ff5ca4da5753f78bf2a7481826f597891",
      "decision": "keep",
      "rationale": "Die DE/EN-Beschreibung prüft eine einzige vollständige Syntheseroute statt isolierter Reaktionsnamen. Die Aldehyd-Kondensation benötigt zwei aktivierte Arenpartner; Carbinol, benzyliches Zwischenkation und neutrale Leukoverbindung werden im P auseinandergehalten. Die Oxidation zum dreiarylsubstituierten C+-System ist mit H+- und Elektronenbilanz vereinbar. Die bereits vorhandenen EAS-, Säure-Base- und Redoxvoraussetzungen tragen die Erklärung. Das vereinfachte Bild zeigt vier Bindungen am Leuko-C und drei am Farbstoff-C korrekt und behauptet keinen vollständigen Mechanismus. BY C13 eA nennt mechanistische Triphenylmethanfarbstoff-Synthese; die konkrete Route ist eine eigene prüfbare Operationalisierung, keine universelle Labordurchführung.",
      "understandingEvidence": {
        "essentialUnderstandingDe": "Die Farbstoffbildung verbindet säurekatalysierte Kondensation zweier aktivierter Aromaten mit dem Aldehyd und anschließende Oxidation einer neutralen Leukoverbindung zum delokalisierten Farbstoffkation.",
        "essentialUnderstandingEn": "Dye formation connects acid-catalysed condensation of two activated aromatic partners with an aldehyde and subsequent oxidation of a neutral leuco compound to the delocalised dye cation.",
        "observablePerformanceDe": "Den vollständigen Teilchenweg mit Carbonylaktivierung, zwei aromatischen Angriffen, Wasserabspaltung und Regeneration des Säurekatalysators darstellen und Stoff-, H- und Ladungsbilanz erläutern.",
        "observablePerformanceEn": "Represent the complete particle route with carbonyl activation, two aromatic attacks, water elimination and acid-catalyst regeneration, explaining material, hydrogen and charge balance.",
        "transferExpectationDe": "Bei einem neuen Arylrest oder einem abgebrochenen Carbinol-Zwischenprodukt begründen, welche C–C-Verknüpfung vor der Oxidation noch fehlt; Oxidation ersetzt keine fehlende Arylgruppe.",
        "transferExpectationEn": "For a new aryl substituent or interrupted carbinol intermediate, explain which C–C linkage is still missing before oxidation; oxidation cannot replace a missing aryl group."
      },
      "evidenceProfileRecommendation": "none",
      "sourceAndContextRead": "Whole current EAS/Brønsted/oxidation prerequisites and direct parent read. Actual BY C13 eA official HTML, colour section, read. Native image route and PDF physical3 viewed.",
      "findings": [],

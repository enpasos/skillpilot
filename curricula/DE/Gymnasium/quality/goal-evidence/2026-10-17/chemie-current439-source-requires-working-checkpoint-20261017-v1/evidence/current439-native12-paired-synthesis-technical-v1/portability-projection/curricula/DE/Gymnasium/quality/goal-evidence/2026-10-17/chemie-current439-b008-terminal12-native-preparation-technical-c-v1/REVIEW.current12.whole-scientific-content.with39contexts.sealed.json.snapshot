          },
          "goalFingerprint": "sha256:546357ed3d2196f07d1715bd98562fae53e9cb8224fd688b9af82b6aa9549e12",
          "pageFingerprint": "sha256:45a06f0d8b1db1a9bbf71bd219ddfb7c01bfbb04be5870315d7ba12e7304b28a"
        },
        "evidenceProfile": {
          "goalId": "99d41b0f-e958-54cf-a077-9bed1704a303",
          "goalFingerprint": "sha256:546357ed3d2196f07d1715bd98562fae53e9cb8224fd688b9af82b6aa9549e12",
          "profileRuleVersion": "positive-understanding-evidence-v2",
          "profileFingerprint": "sha256:6502cfb0f2968c47c127625efd70d6a7bb740f7dae028411c69217a009e3d116",
          "profile": {
            "archetype": "experiment",
            "expectations": [
              {
                "id": "own-results-own-process",
                "essentialUnderstandingDe": "Reflexion der eigenen Erkenntnisgewinnung braucht tatsächlich eigene Ergebnisse und Entscheidungen; fremde Musterwerte können diese nicht ersetzen.",
                "essentialUnderstandingEn": "Reflection on own inquiry needs actually own results and decisions; somebody else’s reference readings cannot replace them.",
                "observablePerformanceDe": "Bindet eigene Frage/Hypothese und tatsächlich ausgeführte Untersuchung an das eigene Rohdaten-/Handlungsprotokoll und kennzeichnet, welche Planung vorgegeben oder selbst erstellt war.",
                "observablePerformanceEn": "Links own question/hypothesis and actually executed investigation to own raw-data/action record and identifies which planning was prescribed or self-authored."
              },
              {
                "id": "method-and-limit",
                "essentialUnderstandingDe": "Die Aussagekraft eigener Ergebnisse hängt an Endpunkt, Temperatur, Blank, Wiederholung und Abweichungen des tatsächlich gewählten Verfahrens.",
                "essentialUnderstandingEn": "The explanatory power of own results depends on endpoint, temperature, blank, repeats and deviations of the procedure actually used.",
                "observablePerformanceDe": "Begründet die eigene Vorgehensweise, prüft mindestens konkrete protokollierte Grenzen an eigenen Ergebnissen und bewertet deren Bedeutung für die eigene Hypothese.",
                "observablePerformanceEn": "Justifies own procedure, examines specific recorded limits against own results and evaluates their significance for the own hypothesis."
              },
              {
                "id": "own-followup",
                "essentialUnderstandingDe": "Eine begründete Verbesserung greift eine tatsächlich verbliebene Unsicherheit auf und sagt, welcher neue Befund sie unterscheiden könnte.",
                "essentialUnderstandingEn": "A justified improvement targets an actual remaining uncertainty and states which new finding could distinguish it.",
                "observablePerformanceDe": "Wählt auf Basis einer eigenen protokollierten Abweichung eine sichere Folgeuntersuchung mit verbesserten Kontrollen und beschreibt erwartete Unterstützung/Gegenbefund, ohne neue Durchführung zu behaupten.",
                "observablePerformanceEn": "Chooses a safe follow-up investigation from an own recorded deviation with improved controls and describes expected support/counterfinding without claiming new execution."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "own-results-own-process",
                "method-and-limit",
                "own-followup"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "prior-investigation",
                "textDe": "Eigene angeleitete Zuckeruntersuchung und eigene selbst geplante Ionenuntersuchung bleiben unterschiedliche zulässige Reflexionsgegenstände.",
                "textEn": "Own guided sugar investigation and own independently planned ion investigation remain distinct valid objects of reflection."
              },
              {
                "id": "recorded-deviation",
                "textDe": "Endpunkt-/Temperaturabweichung oder Sondenverschleppung bestimmt den nächsten begründeten Vergleich.",
                "textEn": "Endpoint/temperature deviation or probe carry-over determines the next justified comparison."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "own-inquiry-process-reflection-own-guided-sugar",
                "taskDemandDe": "Beziehe deine echten Ergebnisse auf deine Ausgangsfrage/Hypothese. Begründe die angewandten Methoden, identifiziere Unsicherheiten und leite zwei konkrete weitere Verbesserungen ab. Kennzeichne vorgegebene Schritte als vorgegeben; ohne eigenen Ausführungslog bleibt die Leistung offen.\nFrische Variation: Wähle anhand deiner tatsächlichen Abweichung eine neue Untersuchung, die eine verbleibende Unsicherheit gezielt reduziert.",
                "taskDemandEn": "Relate your actual results to your initial question/hypothesis. Justify methods used, identify uncertainties and derive two specific further improvements. Identify supplied steps as supplied; without own execution log the performance remains open.\nFresh variation: Choose a new investigation based on your actual deviation that specifically reduces a remaining uncertainty.",
                "expectedPerformanceDe": "Zuckerfall: Gleiches Rühren und Temperaturvergleich prüfen Auflösezeit; eigener Zeitpunkt-Endpunkt und Temperaturdrift begrenzen. Verbesserungen: Endpunkt vorab operationalisieren/filmen und Temperatur eng halten. Ionenfall: Blind-/Salz-/Zuckervergleich plus Reihe prüfen Ionenwirkung und Konzentration; Temperaturdrift/Verschleppung begrenzen; Verbesserungen: frische gespülte Sonde, randomisierte Reihenfolge und gleiche Temperatur. In beiden Fällen müssen Aussagen wirklich zu den eigenen Rohwerten passen; unerwartete Daten werden nicht ersetzt. Die angeleitete eigene Durchführung zählt als eigene Untersuchung, ohne eigene Planung vorzutäuschen.\nFrischer Transfer: Keine eigenen Ausgangsresultate sind im Autorenpaket vorhanden. Die Antwort muss eine tatsächlich im eigenen Zuckerprotokoll sichtbare Unsicherheit auswählen. Wenn dort z. B. Temperaturdrift steht, eine neue freigegebene Vergleichsreihe mit kontrolliertem Temperaturverlauf, gleicher Körnung/Rührweise und Wiederholungen begründen. Wenn stattdessen unklare Endpunktentscheidung dokumentiert ist, vorab denselben sichtbaren Endpunkt festlegen und eine sichere Beobachtungsdokumentation/zweite unabhängige Auswertung planen. Den konkreten alten Eintrag, die eigene Hypothese, die erwartete unterscheidende neue Beobachtung und die verbleibende Grenze angeben. Die angeleitete Ausgangsplanung ehrlich benennen. Eine allgemeine Musterkritik oder erfundene eigene Messreihe erfüllt Reflexion eigener Ergebnisse nicht.",
                "expectedPerformanceEn": "Sugar case: equal stirring and temperature comparison test dissolution time; own endpoint timing and temperature drift limit results. Improvements: define/film the endpoint beforehand and tightly control temperature. Ion case: blank/salt/sugar comparison plus series test ion effect and concentration; temperature drift/carryover limit results; improvements: clean rinsed probe, randomised order and equal temperature. In either case statements must genuinely match own raw values; unexpected data are not replaced. Own guided execution counts as own investigation without pretending own planning.\nFresh transfer: No own starting results exist in the author packet. The response must select an uncertainty actually visible in the own sugar record. If it records temperature drift, justify a newly released comparison with controlled temperature, equal grain size/stirring and repeats. If it instead documents ambiguous endpoint decisions, define the same visible endpoint beforehand and plan safe observation documentation/a second independent interpretation. Identify the specific old entry, own hypothesis, expected discriminating new observation and remaining limit. Honestly identify the prescribed original planning. Generic reference criticism or an invented own measurement series does not satisfy reflection on own results.",
                "understandingFocusDe": "Der nächste eigene Untersuchungsplan folgt einem belegten eigenen Resultat und einer tatsächlich beobachteten Grenze.",
                "understandingFocusEn": "The next own investigation plan follows an evidenced own result and actually observed limit."
              },
              {
                "id": "own-inquiry-process-reflection-own-planned-ions",
                "taskDemandDe": "Beziehe deine echten Ergebnisse auf deine Ausgangsfrage/Hypothese. Begründe die angewandten Methoden, identifiziere Unsicherheiten und leite zwei konkrete weitere Verbesserungen ab. Kennzeichne vorgegebene Schritte als vorgegeben; ohne eigenen Ausführungslog bleibt die Leistung offen.\nFrische Variation: Wähle anhand deiner tatsächlichen Abweichung eine neue Untersuchung, die eine verbleibende Unsicherheit gezielt reduziert.",
                "taskDemandEn": "Relate your actual results to your initial question/hypothesis. Justify methods used, identify uncertainties and derive two specific further improvements. Identify supplied steps as supplied; without own execution log the performance remains open.\nFresh variation: Choose a new investigation based on your actual deviation that specifically reduces a remaining uncertainty.",
                "expectedPerformanceDe": "Zuckerfall: Gleiches Rühren und Temperaturvergleich prüfen Auflösezeit; eigener Zeitpunkt-Endpunkt und Temperaturdrift begrenzen. Verbesserungen: Endpunkt vorab operationalisieren/filmen und Temperatur eng halten. Ionenfall: Blind-/Salz-/Zuckervergleich plus Reihe prüfen Ionenwirkung und Konzentration; Temperaturdrift/Verschleppung begrenzen; Verbesserungen: frische gespülte Sonde, randomisierte Reihenfolge und gleiche Temperatur. In beiden Fällen müssen Aussagen wirklich zu den eigenen Rohwerten passen; unerwartete Daten werden nicht ersetzt. Die angeleitete eigene Durchführung zählt als eigene Untersuchung, ohne eigene Planung vorzutäuschen.\nFrischer Transfer: Zuerst die eigene tatsächlich geplante und ausgeführte Ionenreihe samt Rohdaten/Entscheidungen vorlegen. Falls dort Blankanstieg nach Salzproben steht, Verschleppung als mögliche Ursache begründen und eine neue freigegebene Reihe mit dokumentierter Spülung, frischen Blanks vor/nach den Proben, kontrollierter Reihenfolge und gleicher Temperatur planen. Falls stattdessen Temperaturabweichung belegt ist, diese gezielt angleichen und qualitative sowie quantitative Befunde erneut aufnehmen. Eigene Ausgangshypothese, konkreten betroffenen Eintrag und die erwartete Unterscheidung nennen; alternative Ursachen und Geräteunsicherheit bleiben. Eine Referenzreihe wird nicht zur eigenen Vorleistung erklärt. Ohne eigenes Ausgangsprotokoll bleibt der erforderliche Reflexionsbeleg offen.",
                "expectedPerformanceEn": "Sugar case: equal stirring and temperature comparison test dissolution time; own endpoint timing and temperature drift limit results. Improvements: define/film the endpoint beforehand and tightly control temperature. Ion case: blank/salt/sugar comparison plus series test ion effect and concentration; temperature drift/carryover limit results; improvements: clean rinsed probe, randomised order and equal temperature. In either case statements must genuinely match own raw values; unexpected data are not replaced. Own guided execution counts as own investigation without pretending own planning.\nFresh transfer: First provide the own actually planned and executed ion series with raw data/decisions. If it shows blank increases after salt samples, justify carry-over as a possible cause and plan a newly released series with recorded rinsing, fresh blanks before/after samples, controlled order and equal temperature. If temperature deviations are evidenced instead, specifically match them and collect qualitative and quantitative findings again. Name own original hypothesis, the specific affected entry and expected distinction; alternative causes and instrument uncertainty remain. A reference series is not declared own prior work. Without an own starting record the required reflection evidence remains open.",
                "understandingFocusDe": "Reflexion eigener qual/quant-Ergebnisse wählt die Verbesserung anhand eigener Entscheidungen und Protokollabweichungen.",
                "understandingFocusEn": "Reflection on own qual/quant results selects improvement using own decisions and recorded deviations."
              }
            ]
          }
        }
      },
      "currentCanonicalScientificFields": {
        "id": "99d41b0f-e958-54cf-a077-9bed1704a303",
        "shortKey": "canonical_chemistry_b008_own_inquiry_process_reflection",

          "visualization": {
            "resourceType": "image",
            "title": "Visualisierung: Eigene chemische Untersuchungen reflektieren",
            "url": "/assets/goal-visualizations/chemie/99d41b0f-e958-54cf-a077-9bed1704a303/99d41b0f-e958-54cf-a077-9bed1704a303.png",
            "altText": "Ein offener Befund wird von Comicfiguren auf Wiederholbarkeit, Methode, Prüfbarkeit, Widerspruchsfreiheit und neue Daten betrachtet.",
            "originalDigest": "sha256:11ffee241019c3f7f8e83d7e0b45d75a8c43016a07fb328b6b2540487bf765e3",

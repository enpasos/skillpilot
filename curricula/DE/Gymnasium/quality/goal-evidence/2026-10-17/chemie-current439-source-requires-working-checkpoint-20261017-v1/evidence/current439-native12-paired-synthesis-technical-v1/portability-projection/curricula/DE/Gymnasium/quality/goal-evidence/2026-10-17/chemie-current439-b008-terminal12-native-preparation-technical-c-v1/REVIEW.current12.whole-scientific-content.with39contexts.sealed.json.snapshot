        },
        "evidenceProfile": {
          "goalId": "86d34f1f-692d-5522-a9a4-a71c65b24de7",
          "goalFingerprint": "sha256:544e2f07a9287f23526faaf6b56a3eb045df8c39cec6773ce5371646a8abf034",
          "profileRuleVersion": "positive-understanding-evidence-v2",
          "profileFingerprint": "sha256:97296483deb76a3f4da83374eff0482599e313b27c146d40cb362f6c8ec39e9e",
          "profile": {
            "archetype": "modeling",
            "expectations": [
              {
                "id": "atom-periodicity-equilibrium",
                "essentialUnderstandingDe": "Modelle machen unterschiedliche chemische Beziehungen zugänglich; Schalengeometrie erklärt qualitative Periodizität, Q/K-Massenbilanz eine Gleichgewichtslage.",
                "essentialUnderstandingEn": "Models make different chemical relations accessible; shell geometry explains qualitative periodicity, Q/K mass balance an equilibrium position.",
                "observablePerformanceDe": "Wählt und nutzt tatsächlich analoge Atommodelle und eigene digitale Gleichgewichtstabelle, prüft Na/Mg-Daten und x=0,20 und verändert für K=2 die gültige Lösung.",
                "observablePerformanceEn": "Actually chooses and uses analogue atom models and an own digital equilibrium table, examines Na/Mg data and x=0.20 and changes the valid solution for K=2."
              },
              {
                "id": "bonding-complex-geometry",
                "essentialUnderstandingDe": "Bindungspolarität und räumliche Geometrie wirken zusammen; Konnektivität allein beschreibt Kontakte komplexer organischer Moleküle nicht ausreichend.",
                "essentialUnderstandingEn": "Bond polarity and spatial geometry work together; connectivity alone does not adequately describe contacts of complex organic molecules.",
                "observablePerformanceDe": "Prüft CO2/H2O-Dipole und ordnet im komplexen Ammonium-/Amid-/Phenylgerüst tatsächlich räumliche, flexible/planare Abschnitte und geeignete Rezeptorkontakte zu. Nutzt das konkrete28-Atom-L/L2-Koordinaten-/Verbindungskit mit eigener räumlicher Registrierung und Abstands-/Winkelprotokoll.",
                "observablePerformanceEn": "Examines CO2/H2O dipoles and actually maps spatial flexible/planar regions and appropriate receptor contacts in the complex ammonium/amide/phenyl scaffold. Uses the actual28-atom L/L2 coordinate/connectivity kit with own spatial registration and distance/angle log."
              },
              {
                "id": "receptor-and-enzyme",
                "essentialUnderstandingDe": "Rezeptorbelegung ist keine nachgewiesene Aktivierung; Substrat-Enzym-Modell braucht Bindung, Anpassung und chemische Umsetzung ohne Enzymverbrauch.",
                "essentialUnderstandingEn": "Receptor occupancy is not demonstrated activation; a substrate–enzyme model needs binding, adjustment and chemical conversion without consuming the enzyme.",
                "observablePerformanceDe": "Erstellt eigene θ-Tabelle 0/0,5/0,75, vergleicht L/L2 und S/I, zeigt Esterhydrolyse mit H2O und erhaltenem E und begrenzt Aussagen zu Wirkung und Kinetik.",
                "observablePerformanceEn": "Creates own θ table 0/0.5/0.75, compares L/L2 and S/I, shows ester hydrolysis with H2O and retained E and bounds claims about effects and kinetics."
              },
              {
                "id": "test-limits-development",
                "essentialUnderstandingDe": "Eine Modellprüfung benötigt Vergleich, Beobachtung und Annahmen; Weiterentwicklung adressiert konkret fehlende Aktivitäten, Dynamik, Lösungsmittel oder Reaktionsschritte.",
                "essentialUnderstandingEn": "A model test needs comparison, observation and assumptions; development targets specifically missing activities, dynamics, solvent or reaction steps.",
                "observablePerformanceDe": "Begründet Möglichkeiten, Grenzen und Weiterentwicklung aller Pflichtkontexte; unterscheidet Modellarbeit von Realexperiment und bewertet zusätzliche Bindungsgruppe ohne korrigierte Geometrie.",
                "observablePerformanceEn": "Justifies power, limits and development of all mandatory contexts; distinguishes model work from real experimentation and evaluates an added binding group without corrected geometry."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "atom-periodicity-equilibrium",
                "bonding-complex-geometry",
                "receptor-and-enzyme",
                "test-limits-development"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "equilibrium-temperature",
                "textDe": "K wird von 1 auf 2 geändert; Geschwindigkeit folgt daraus nicht.",
                "textEn": "K changes from 1 to 2; rate does not follow from this."
              },
              {
                "id": "ligand-pose",
                "textDe": "Eine weitere Gruppe ändert die Kontaktbilanz, ohne falschen räumlichen Abstand automatisch zu beheben. Konkrete OX/HX-Transferkarte ersetzt HC5_1; ursprüngliche Kontaktabstände bleiben geprüft.",
                "textEn": "An additional group changes the contact balance without automatically fixing incorrect spatial spacing. Actual OX/HX transfer cards replace HC5_1; original contact distances remain checked."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "upper-model-use-criticism-atomic-periodic-equilibrium",
                "taskDemandDe": "Wähle und nutze passende analoge/digitale Modelle tatsächlich: Vergleiche Atommodelle mit Daten, berechne Q und teste per Tabelle x=0/0,10/0,20 bis zur Gleichgewichtslösung. Begründe Aussagen, Grenzen und mögliche Weiterentwicklung beider Stationen. Dieser Fall allein schließt nicht die komplexen Molekülkontexte des zweiten Falls.\nFrische Variation: Bei höherer Temperatur wird K=2 vorgegeben: Passe das Modell an und trenne neue Gleichgewichtslage von Reaktionsgeschwindigkeit.",
                "taskDemandEn": "Actually choose and use suitable analogue/digital models: compare atomic models with data, compute Q and test x=0/0.10/0.20 in a table to the equilibrium solution. Justify statements, limits and possible development at both stations. This case alone does not complete the second case’s complex-molecule contexts.\nFresh variation: At higher temperature K=2 is supplied: adapt the model and distinguish new equilibrium position from reaction rate.",
                "expectedPerformanceDe": "Schalenmodell ordnet Außen-/Kernbezug und qualitative Periodizität besser als Kugeln, berechnet aber 496/738 nicht exakt; höhere Kernladung bei ähnlicher Hauptschale unterstützt stärkere Bindung bei Mg. Q direkt nach Zugabe = 0,5<K; bei x=0,10 Q=1,21/1,71≈0,7076; x=0,20 Q=1,44/1,44=1, also neues Gleichgewicht A1,8/B0,8/C1,2/D1,2. Tabelle wird tatsächlich erzeugt, nicht bloß gelesen. Ideale Konzentrationsregel vernachlässigt Aktivitäten und Kinetik; Weiterentwicklung benötigt passende Aktivitäts-/Energiedaten.\nFrischer Transfer: Mit derselben frischen Stoffbilanz A=2−x, B=1−x, C=D=1+x und nun K=2 löst man (1+x)^2=2(2−x)(1−x), also x²−8x+3=0. Physikalisch zulässig ist x=4−√13≈0,39445; die andere Wurzel verletzt B≥0. Neue Modellkonzentrationen A≈1,60555, B≈0,60555, C=D≈1,39445 mol/L ergeben Q≈2. Die eigene digitale Tabelle auf K=2 erweitern und Stoffbilanz/zulässigen Bereich prüfen. Das vorgegebene K betrifft die Gleichgewichtslage, enthält aber keine Geschwindigkeitskonstante: Zeitverlauf ist nicht berechnet. Atom-/Periodizitätsmodelle behalten ihre vorher diskutierten Grenzen; dieser Transfer erledigt nicht die komplexen organischen Kontexte. Keine reale Reaktion wurde durchgeführt.",
                "expectedPerformanceEn": "Shell model organises outer/core relations and qualitative periodicity better than balls but does not exactly calculate 496/738; higher nuclear charge with similar main shell supports stronger binding in Mg. Q immediately after addition = 0.5<K; x=0.10 gives Q=1.21/1.71≈0.7076; x=0.20 gives 1.44/1.44=1, so new equilibrium A1.8/B0.8/C1.2/D1.2. The table is actually created, not merely read. Ideal concentration rule neglects activities and kinetics; development needs suitable activity/energy data.\nFresh transfer: Using the same fresh material balance A=2−x, B=1−x, C=D=1+x and now K=2, solve (1+x)^2=2(2−x)(1−x), hence x²−8x+3=0. The physically valid root is x=4−√13≈0.39445; the other root violates B≥0. New model concentrations A≈1.60555, B≈0.60555, C=D≈1.39445 mol/L give Q≈2. Extend the own digital table to K=2 and check material balance/allowed range. Supplied K concerns equilibrium position but contains no rate constant: time course is not computed. Atomic/periodicity models retain previously discussed limits; this transfer does not complete complex organic contexts. No actual reaction was performed.",
                "understandingFocusDe": "Eigene analoge/digitale Modellprüfung verbindet Periodizität, Stoffbilanz und gültige Gleichgewichtslösung mit getrennten Grenzen.",
                "understandingFocusEn": "Own analogue/digital model testing connects periodicity, material balance and valid equilibrium solution with separate limits."
              },
              {
                "id": "upper-model-use-criticism-geometry-receptor-enzyme",
                "taskDemandDe": "Nutze analoge Geometrie-/Kontaktkarten und eine selbst erzeugte digitale θ-Tabelle tatsächlich. Prüfe Hypothesen: Bindungspolarität allein bestimmt Moleküldipol; gleiche Gruppen garantieren Ligandwirkung; Enzym ist ein starrer unveränderlicher Schlüssel. Vergleiche Modelle, Beobachtungs-/Modelldaten, Grenzen und Weiterentwicklung. Alle vier komplexen Kontexte müssen fachlich bearbeitet werden.\nFrische Variation: Ergänze eine Bindungsgruppe bei L2, ohne Abstand zu korrigieren: Warum erlaubt das keine sichere stärkere Wirkungsaussage?\nVerwende das tatsächliche finite L/L2-Kit FINITE-LIGAND-POSE-KIT.de-en.md mit Koordinaten- und Verbindungskarten. Baue oder ordne beide vollständigen28-Atom-Posen desselben NH3+/Amid/Phenyl-Gerüsts im registrierten Rezeptorrahmen auf. Zeige tatsächliche eigene Anordnung und berechne/miss Nplus–Rnegative, Carbonyl-O…Hdonor, D–Hdonor–O und Phenylzentrum–hydrophobe Kontaktstelle. Erkläre Ladung, H-Brücken-Akzeptor, Amid-/Phenylplanarität, tetraedrische gesättigte Zentren und eingeschränkte gegenüber flexibler Rotation. Vergleiche die Posen mit den offen vorgegebenen Kontaktregeln, nicht nur einem Fit-Label. Alle ursprünglichen CO2/H2O-, θ-, ES-/Hydrolyse-, Vergleichs- und Grenzaufgaben bleiben verbindlich.\nFrische konkrete Zusatzgruppe: Nutze finite-L2-extra-OH-transfer-layout.author-candidate.json und die druckbaren OX/HX-Karten. Ersetze HC5_1 bei L2 durch OH, behalte Ammonium/Amid/Phenyl und Registrierung. Vergleiche deine tatsächliche zusätzliche Anordnung mit L2 und prüfe neuen OX…Hdonor-Abstand sowie den ursprünglichen Ammoniumkontakt. Warum beweist die Zusatzgruppe keine stärkere Wirkung?",
                "taskDemandEn": "Actually use analogue geometry/contact cards and a learner-created digital θ table. Test hypotheses: bond polarity alone determines molecular dipole; equal groups guarantee ligand effects; enzyme is a rigid unchanging lock. Compare models, observation/model data, limits and development. All four complex contexts must be scientifically addressed.\nFresh variation: Add a binding group to L2 without correcting spacing: why does this not justify a definite stronger-effect claim?\nUse the actual finite L/L2 kit FINITE-LIGAND-POSE-KIT.de-en.md with coordinate/connectivity cards. Build or arrange both full28-atom poses of the same NH3+/amide/phenyl scaffold in the registered receptor frame. Provide an own arrangement and calculate/measure Nplus–Rnegative, carbonyl-O…Hdonor, D–Hdonor–O and phenyl-centre–hydrophobic contact. Explain charge, H-bond acceptor, amide/phenyl planarity, tetrahedral saturated centres and restricted versus flexible rotation. Compare poses using the explicitly supplied contact rules rather than repeating a fit label. Original CO2/H2O, θ, ES/hydrolysis, comparison and limitation tasks remain mandatory.\nFresh concrete additional group: use finite-L2-extra-OH-transfer-layout.author-candidate.json and printable OX/HX cards. Replace HC5_1 in L2 by OH, retaining ammonium/amide/phenyl and registration. Compare your actual added arrangement with L2, test OX…Hdonor distance and the original ammonium contact. Why does the addition not prove a stronger effect?",
                "expectedPerformanceDe": "Eigenes vollständiges Raum-/Kontaktprodukt und digitale θ-Tabelle sind erforderlich. CO2-Dipolvektoren heben sich symmetrisch auf, H2O-Vektoren nicht: Bindungspolarität UND Geometrie zählen. Beide tatsächlichen L/L2-Posen besitzen28Atome und dasselbe protonierte NH3+/Amid/Phenyl-Gerüst: +1 am terminalen Ammonium; Carbonyl-O akzeptiert H-Brücken, neutrales Amid-N nicht. CH2-Zentren sind tetraedrisch, Amid-/Phenylbereiche planar; Amidrotation eingeschränkt, gesättigte Bindungen flexibel. Registriert ergibt L Kontaktabstände3,40/2,00/3,50 und D–H–O180°; L2 Ammonium6,19 bei unveränderten anderen Kontakten. Eigene Anordnung und Rechnung prüfen die offen definierten Regeln; kein Fit-Label ersetzt das Produkt. Die Posegrenze belegt keine unmögliche Bindung in jeder Konformation. Eigene θ=0/0,5/0,75 bei vorgegebenem Kd2; Belegung beweist weder Aktivierung noch klinische Wirkung. E-Anpassung, S-Bindung/ES und Esterhydrolyse mit H2O zu Säure/Alkohol sowie erhaltenem E werden gezeigt; I bindet ohne Umsetzung. Vereinfachte Modelle lassen Lösungsmittel, Dynamik, thermodynamische Beiträge und reale Reaktionsschritte offen. Frischer OH-Transfer ersetzt HC5_1 durch OX/HX: neuer hypothetischer Stoff, OX…H≈3,735 und Ammonium≈6,191. Die Zusatzgruppe repariert den ursprünglichen Kontakt nicht und liefert kein neues Kd oder stärkere Wirkung. Alle ursprünglichen Kontexte und begründeter Entwicklungsbedarf bleiben; keine reale Laborleistung.",
                "expectedPerformanceEn": "Require an own complete spatial/contact product and digital θ table. CO2 dipole vectors cancel symmetrically; H2O vectors do not: bond polarity AND geometry matter. Both actual L/L2 poses contain28atoms and the same protonated NH3+/amide/phenyl scaffold: terminal ammonium+1, carbonyl O accepts hydrogen bonds, neutral amide N does not. CH2 centres are tetrahedral, amide/phenyl regions planar; amide rotation is restricted and saturated bonds flexible. Registered L gives distances3.40/2.00/3.50 and D–H–O180deg; L2 has ammonium6.19 with unchanged other contacts. Own arrangement/calculation tests the defined rules; a fit label does not replace work. A pose-specific limit does not prove impossible binding in every conformation. Create own θ=0/0.5/0.75 at supplied Kd2; occupancy proves neither activation nor clinical effects. Show E adjustment, S binding/ES, ester hydrolysis with H2O to acid/alcohol and retained E; I binds without conversion. Simplified models omit solvent, dynamics, thermodynamic contributions and actual reaction steps. Fresh OH transfer replaces HC5_1 by OX/HX: a hypothetical derivative, OX…H≈3.735 and ammonium≈6.191. The addition repairs no original contact and supplies no new Kd or stronger effect. Retain all original contexts and justified development needs; no actual laboratory performance.",
                "understandingFocusDe": "Komplexe organische Geometrie, Rezeptorbelegung und Enzymchemie werden mit tatsächlicher analoger/digitaler Modellnutzung begrenzt.",
                "understandingFocusEn": "Complex organic geometry, receptor occupancy and enzyme chemistry are bounded through actual analogue/digital model use."
              }
            ]
          }
        }
      },
      "currentCanonicalScientificFields": {
        "id": "86d34f1f-692d-5522-a9a4-a71c65b24de7",

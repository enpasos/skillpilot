          "visualization": {
            "resourceType": "image",
            "title": "Visualisierung: Anspruchsvolle chemische Experimente selbstständig durchführen",
            "url": "/assets/goal-visualizations/chemie/f79f15c0-e848-5e17-9eb5-26753d35c93b/f79f15c0-e848-5e17-9eb5-26753d35c93b.png",
            "altText": "Plan, geklemmte Bürette mit kontrollierter Analyse und leeres Rohdatenblatt für Proben A und B.",
            "originalDigest": "sha256:4edf9b16dc53248dd291669892efd06c648cda2e7bcd325080f78a2e1406d586",
            "qaStatus": "review_candidate",

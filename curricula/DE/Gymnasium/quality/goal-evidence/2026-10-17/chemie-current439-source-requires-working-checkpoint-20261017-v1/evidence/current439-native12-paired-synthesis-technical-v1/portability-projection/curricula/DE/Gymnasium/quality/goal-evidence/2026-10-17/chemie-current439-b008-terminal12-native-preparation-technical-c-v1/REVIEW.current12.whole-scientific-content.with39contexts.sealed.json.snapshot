        },
        "evidenceProfile": {
          "goalId": "431a0f03-f28a-5e56-a61f-000336d0b410",
          "goalFingerprint": "sha256:6ddcfd8416fa7d7295255874133e3eab40d19427f1a99abdffb703da778e9ea5",
          "profileRuleVersion": "positive-understanding-evidence-v2",
          "profileFingerprint": "sha256:6ad59c1dab7ec5ebcd766a759512bf4a7fe738944e5cf0f6a3f1ba12a42e2daa",
          "profile": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "independent-arguments",
                "essentialUnderstandingDe": "Relevante Kriterien und fachlich gestützte eigene Pro-/Kontra-Argumente entstehen aus vergleichbaren Daten, nicht allein aus vorgegebenen Listen.",
                "essentialUnderstandingEn": "Relevant criteria and scientifically supported own arguments arise from comparable data, not just supplied lists.",
                "observablePerformanceDe": "Selbst je ein konkretes Pro-/Kontra-Argument zu F/G und E/M entwickeln und mit dem vorgegebenen Pauschalargument vergleichen.",
                "observablePerformanceEn": "Independently develop specific arguments for and against F/G and E/M and compare them with the supplied blanket argument."
              },
              {
                "id": "weighted-judgment",
                "essentialUnderstandingDe": "Kriteriengewichtung, Mindestanforderungen, Systemgrenzen und nicht vergleichbare Einheiten bestimmen die Reichweite eines Urteils.",
                "essentialUnderstandingEn": "Criterion weights, minimum requirements, system boundaries and incomparable units determine a judgment’s scope.",
                "observablePerformanceDe": "90-%-Entfernungsziel oder eigenes begründetes Gewicht offenlegen; Wiederverwendungsszenarien unterscheiden und Transport-/Wascheinheiten nicht addieren.",
                "observablePerformanceEn": "State the 90% removal threshold or own justified weights; distinguish reuse scenarios and do not add transport/washing units."
              },
              {
                "id": "revised-argument",
                "essentialUnderstandingDe": "Eine veränderte chemisch relevante Bedingung verändert bestimmte Argumente und verlangt konkrete Neugewichtung.",
                "essentialUnderstandingEn": "A changed chemically relevant condition alters specific arguments and requires explicit revised weighting.",
                "observablePerformanceDe": "Bei 18 kWh das Energieargument selbst neu entwickeln, Kosten/Rückstandslimits erhalten und das eigene Urteil aktualisieren; fehlende gemeinsame Folgenindikatoren begründen.",
                "observablePerformanceEn": "Independently revise the energy argument at 18 kWh, retain cost/residue limits and update the own judgment; justify missing common impact indicators."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "independent-arguments",
                "weighted-judgment",
                "revised-argument"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "changed-condition",
                "textDe": "Neue fallgebundene Bedingung/Hypothesenprüfung und eigene begründete Revision statt bloßem Zahlentausch.",
                "textEn": "Fresh case-specific condition/hypothesis check and own reasoned revision rather than mere number substitution."
              },
              {
                "id": "source-and-limit",
                "textDe": "BY C9-NTG.1 verlangt das selbstständige Finden und Vergleichen: hier verbindlich. Der angeleitete BY-C8-Einstieg mit vorgegebenen Argumenten bleibt ein erhaltener Teilbeitrag, kein vollständiger Abschluss dieses erweiterten selbstständigen Produkts. Ein bloßer Vergleich fertig vorgegebener Pro-/Kontra-Listen schließt die Eigenfindungsleistung nicht; exact/partial und Stufen-targets sind vor Integration separat zu prüfen.",
                "textEn": "Preserve actual source-specific assistance, stage, track and claim limits; the original whole source-scope contract and case-specific conditions are mandatory. Neither supplied data nor author answers evidence real learner performance."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "criteria-arguments-water-treatment-options",
                "taskDemandDe": "Leite selbst relevante Kriterien ab und finde eigene belegte Pro-/Kontra-Argumente für beide Verfahren. Vergleiche sie mit dem gelieferten Argument und wäge mit begründeten Gewichtungen ab. Neue Variation: G senkt seinen Energieverbrauch auf 18 kWh: Entwickle selbst das nun veränderte Argument und überprüfe dein Urteil.",
                "taskDemandEn": "Derive relevant criteria and independently find evidence-backed pro/con arguments for both methods. Compare them with the supplied argument and weigh them using justified weights. Fresh variation: G reduces energy consumption to 18 kWh: independently develop the changed argument and review your judgment.",
                "expectedPerformanceDe": "Eigene Argumente: F spart 15 € und 20 kWh, entfernt aber weniger X; G erhöht Entfernung um 25 Prozentpunkte, kostet/energetisch belastet mehr; Restmasse allein bedeutet nicht weniger Risiko, weil Entsorgungsart verschieden. Kriterien Kosten, Entfernung, Energie und sichere Restbehandlung aus Daten ableiten. „Immer billigste“ ignoriert Zweck/Sicherheit. Begründete Wahl hängt von Mindestentfernung und Gewichtung ab; bei geforderten ≥90 % fällt F trotz Preisvorteil aus. Transfer: Eigenes neues Argument: G entfernt weiterhin 95 % statt 70 % von X, benötigt nun 18 statt 20 kWh und spart gegenüber F 2 kWh. Der frühere Energiekontra-Punkt gegen G entfällt und wird zum begrenzten Pro-Punkt; Mehrkosten 15 €/Jahr bleiben. Bei Mindestentfernung 90 % fällt F weiter aus. Ohne diese Mindestanforderung hängen Urteil und Gewichtung weiterhin von Kriterien ab. 1 statt 2 kg unterschiedlich zu entsorgender Rückstand beweist keine geringere Gefährlichkeit. Meine frühere Gewichtung muss konkret aktualisiert werden, ohne G nun pauschal als Trinkwassergarantie darzustellen.",
                "expectedPerformanceEn": "Own arguments: F saves €15 and 20 kWh but removes less X; G improves removal by 25 percentage points but costs/consumes more; residue mass alone is not less risk because disposal differs. Derive cost, removal, energy and safe residue handling criteria from data. “Always cheapest” ignores purpose/safety. A justified choice depends on minimum removal and weights; if ≥90% is required F fails despite its price advantage. Transfer: Own revised argument: G still removes 95% rather than 70% of X, now needs 18 rather than 20 kWh and saves 2 kWh against F. The former energy argument against G is removed and becomes a limited argument in favour; the additional €15/year remains. Under a 90% minimum removal requirement F still fails. Without that requirement, the judgment still depends on criteria and weights. One rather than two kilograms of differently disposed residue does not prove lower hazard. Update the previous weighting explicitly without presenting G as a universal drinking-water guarantee.",
                "understandingFocusDe": "Die lernende Person kann zu einem chemischen Sachverhalt relevante Bewertungskriterien recherchieren oder erkennen, fachlich belegte Pro- und Kontra-Argumente selbst finden, sie mit bereitgestellten Argumenten vergleichen und deren Gewicht kriteriengeleitet begründet abwägen. Eigene unabhängige Begründung und tatsächliches gefordertes Leistungsprodukt, keine Wiedergabe der Musterlösung.",
                "understandingFocusEn": "The learner can research or identify relevant assessment criteria for a chemical issue, independently find scientifically supported arguments for and against, compare them with supplied arguments and weigh them with justified reference to the criteria. Own independent reasoning and the actually required performance artifact, not recitation of the worked answer."
              },
              {
                "id": "criteria-arguments-packaging-evidence",
                "taskDemandDe": "Finde selbst datengestützte Argumente und Kriterien, vergleiche sie mit der gelieferten Aussage und begründe eine Abwägung für 10 gegenüber 2 Umläufen. Neue Variation: Welche neue Information würde einen Vergleich von Transport- und Waschfolgen ermöglichen?",
                "taskDemandEn": "Independently find data-backed arguments and criteria, compare them with the supplied claim and justify weighing for 10 versus 2 cycles. Fresh variation: What new information would allow comparison of transport and washing consequences?",
                "expectedPerformanceDe": "Bei 10 Umläufen spart M 20 kg Material, braucht mehr Transport/Waschen und kostet mehr; bei 2 Umläufen braucht M sogar 60 kg mehr Material als E. Eigene Argumente verbinden chemische Werkstoff-/Reinigungsprozesse mit Nutzungsbedingungen. Allgemeine „immer“-Behauptung ist nicht getragen. Umwelteinheiten brauchen zusätzliche Wirkungsfaktoren; man kann begründete Prioritäten nennen, aber keine willkürliche Gesamtsumme bilden. Transfer: Für dieselben 1000 Getränke brauche ich vergleichbare Folgenindikatoren: etwa Energie- oder Emissionsfaktoren für Transport und Waschen, Transportentfernungen/-arten, Waschenergie/-mittel/-wasser, Strommix, Rücklauf-/Nutzungszahl und eine gemeinsame Systemgrenze. Dann lassen sich Beiträge zu demselben definierten Umweltindikator berechnen. Transporteinheiten plus Wascheinheiten sind derzeit nicht addierbar; ein gemeinsamer CO₂-Indikator würde außerdem nicht alle Umweltfolgen automatisch abdecken. Quellen, Annahmen und Gewichtung bleiben sichtbar.",
                "expectedPerformanceEn": "At 10 cycles M saves 20 kg material, needs more transport/washing and costs more; at 2 cycles M even needs 60 kg more material than E. Own arguments connect chemical material/cleaning processes with usage conditions. The universal “always” claim is unsupported. Environmental units need additional impact factors; justified priorities can be stated, but no arbitrary overall sum formed. Transfer: For the same 1,000 drinks I need comparable impact indicators: for example energy or emissions factors for transport and washing, distances/modes of transport, wash energy/detergent/water, electricity mix, return/use count and a common system boundary. Contributions to the same defined environmental indicator can then be calculated. Transport units and washing units cannot currently be added; a common CO₂ indicator would not automatically cover every environmental impact. Keep sources, assumptions and weights visible.",
                "understandingFocusDe": "Die lernende Person kann zu einem chemischen Sachverhalt relevante Bewertungskriterien recherchieren oder erkennen, fachlich belegte Pro- und Kontra-Argumente selbst finden, sie mit bereitgestellten Argumenten vergleichen und deren Gewicht kriteriengeleitet begründet abwägen. Eigene unabhängige Begründung und tatsächliches gefordertes Leistungsprodukt, keine Wiedergabe der Musterlösung.",
                "understandingFocusEn": "The learner can research or identify relevant assessment criteria for a chemical issue, independently find scientifically supported arguments for and against, compare them with supplied arguments and weigh them with justified reference to the criteria. Own independent reasoning and the actually required performance artifact, not recitation of the worked answer."
              }
            ]
          }
        }
      },

              "canonicalUrl": "https://skillpilot.com/lernzielbuch?landscape=c436b994-8f44-5134-b9f8-0c9f5d6a5ba0&edition=curricular-atomic-v1#goal-ab315f52-a9e3-5c1c-a404-7fb1a96a3eaf"

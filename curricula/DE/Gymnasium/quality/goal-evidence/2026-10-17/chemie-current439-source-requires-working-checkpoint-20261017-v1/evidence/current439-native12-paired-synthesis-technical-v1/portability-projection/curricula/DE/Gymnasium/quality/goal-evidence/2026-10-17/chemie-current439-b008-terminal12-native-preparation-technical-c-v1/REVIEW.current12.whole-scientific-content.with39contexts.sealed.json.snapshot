        },
        "evidenceProfile": {
          "goalId": "5b1bb5d9-07b1-5ba9-b320-cc97be917c60",
          "goalFingerprint": "sha256:93fd43fc3d160be0229abf4469a3b9ba2e28f9e061c49ece39c5e5bb5883ec19",
          "profileRuleVersion": "positive-understanding-evidence-v2",
          "profileFingerprint": "sha256:460bca7e578e85e8f3186b2f6e4fc02ef72e50ede606dd8226419c3684f58321",
          "profile": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "select-relevant-sources",
                "essentialUnderstandingDe": "Relevanz hängt an chemischer Frage, Adressat und Situation; Werbung, Eigenschaftsangaben und Vergleichsdaten erfüllen verschiedene Funktionen.",
                "essentialUnderstandingEn": "Relevance depends on the chemical question, audience and situation; advertising, property descriptions and comparison data serve different functions.",
                "observablePerformanceDe": "Wählt für Reinigungsinformation bzw. Verpackungsvergleich passende Text-/Tabelleninformationen, identifiziert Urheber/Quelle und erklärt das Weglassen ungestützter Werbung. Nur im tatsächlich recherchepflichtigen Quellenkontext zusätzlich selbst suchen, Quelle öffnen/lesen, konkrete Fundstelle und Suchweg nachweisen; vorgegebene UND eigene Quelle verwenden.",
                "observablePerformanceEn": "Selects suitable text/table information for cleaning advice or packaging comparison, identifies authors/sources and explains exclusion of unsupported advertising. In an actually research-requiring source context additionally locate/open/read a source and evidence the actual location/search path; use given AND own sources."
              },
              {
                "id": "structure-and-interpret",
                "essentialUnderstandingDe": "Gleiche Bezugsgrößen erlauben begrenzte Stoff-/Eigenschaftsvergleiche; aus Masse oder Rückstand allein folgt keine allgemeine Umwelt- oder Sicherheitsbilanz.",
                "essentialUnderstandingEn": "Equal reference quantities permit bounded substance/property comparisons; mass or residue alone does not yield a general environmental or safety balance.",
                "observablePerformanceDe": "Strukturiert chemische Erklärung, Modellvergleich und Sicherheits-/Datengrenzen zielgruppengerecht und nennt Einheiten, gleiche 250 mL bzw. gleiche Fünf-Minuten-Bedingungen.",
                "observablePerformanceEn": "Structures chemical explanation, model comparison and safety/data limits for the audience and states units, equal 250 mL or equal five-minute conditions."
              },
              {
                "id": "fresh-audience-and-context",
                "essentialUnderstandingDe": "Eine neue Zielgruppe oder Mehrwegfrage benötigt zusätzliche relevante Information, nicht erfundene Wirkung aus vorhandenen Daten.",
                "essentialUnderstandingEn": "A new audience or reuse question needs additional relevant information, not invented effects from existing data.",
                "observablePerformanceDe": "Passt die Auswahl für das Hausmeisterteam an und benennt für Mehrwegkreisläufe Reinigung, Transport und Nutzungszahl als fehlende Angaben.",
                "observablePerformanceEn": "Adapts selection for the caretaker team and names cleaning, transport and number of uses as missing information for reuse cycles."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "select-relevant-sources",
                "structure-and-interpret",
                "fresh-audience-and-context"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "audience",
                "textDe": "Jüngere Lernende werden durch ein technisch verantwortliches Team ersetzt.",
                "textEn": "Younger learners are replaced by a technically responsible team."
              },
              {
                "id": "reference-system",
                "textDe": "Stückmasse wird von Masse je tatsächlicher Nutzung und vollständiger Kreislaufbilanz unterschieden.",
                "textEn": "Mass per item is distinguished from mass per actual use and a complete cycle balance."
              },
              {
                "id": "source-context-own-research",
                "textDe": "Das kanonische ODER bleibt unverändert. Auf BY C9 NTG LB1 ist zusätzlich zu vorgegebenen Quellen eigene Suche, tatsächliches Lesen, Auswahl, fachliche Deutung, Adressatenanpassung und genaue Quellenangabe verbindlich (vorgegebene UND selbst recherchierte Quellen). C8/C9 Nicht-NTG behalten ihre vorgegebenen Einstiegsquellen. Andere Quellenwege folgen ihren tatsächlich geprüften Pflichten; keine universelle pharmazeutische Recherche, keine Stufen-/Kursableitung aus GK/LK-Tags. Ganze Quellen- und Partnerpflichten bleiben offen.",
                "textEn": "The canonical OR is unchanged. On BY C9 NTG LB1, given sources must be supplemented by own locating, actual reading, selection, scientific interpretation, audience adaptation and precise attribution (given AND independently researched sources). C8/C9 non-NTG retain their given-source entry routes. Other source routes follow their actually reviewed duties; no universal pharmaceutical research or stage/course inference from GK/LK tags. Whole source and partner duties remain open."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "sek1-source-information-cleaning-advice",
                "taskDemandDe": "Wähle für eine kurze Information an eine jüngere Klasse relevante Aussagen aus den Quellen, strukturiere Erklärung/Versuchsbefund/Sicherheit und gib Quellen an. Unterscheide Werbespruch und belegten Vergleich; führe keine Reinigung aus.\nFrische Variation: Passe die Information für ein Hausmeisterteam an: Welche Bedingung und Quellenangabe muss ausführlicher sein?\nNur auf der Route mit eigener Recherchepflicht: Bestimme eine noch offene Frage für die jeweilige Zielgruppe; finde selbst eine passende zugängliche Quelle über eigene Suche/Navigation, öffne und lies sie. Reiche Suchpfad, Urheber/Titel, genaue URL, Datum/Abruf, konkrete Überschrift/Absatz oder PDF-Seite und eigene fachliche Paraphrase ein. Begründe Auswahl und Grenzen, trenne selbst gefundene Aussagen von S/T-Lehrmodellzahlen, und passe die Information an die neue Zielgruppe bzw. Mehrwegfrage an. Verwende vorgegebene UND selbst gefundene Quellen. Die leere own-source-search-read-cite.learner-blank.csv und OWN-SOURCE-RESEARCH.route.de-en.md sind das Arbeitsmaterial; die Autorenbeispiele zählen nicht als eigene Recherche.",
                "taskDemandEn": "Select relevant statements for a short information note to a younger class, structure explanation/experiment finding/safety and cite sources. Distinguish advertising slogan from supported comparison; do not perform cleaning.\nFresh variation: Adapt the information for a caretaker team: which condition and source citation needs more detail?\nOnly on a route requiring own research: identify an unresolved audience-specific question; independently locate an accessible suitable source through own search/navigation, open and read it. Submit search path, author/title, exact URL, date/access time, precise heading/paragraph or PDF page and an own scientific paraphrase. Justify relevance and limits, separate found statements from S/T model numbers, and adapt information to the fresh audience/reuse question. Use given AND independently found sources. Use own-source-search-read-cite.learner-blank.csv and OWN-SOURCE-RESEARCH.route.de-en.md; author examples are not own research.",
                "expectedPerformanceDe": "S1 erklärt die chemische Reaktion; S4 zeigt unter den gegebenen Bedingungen weniger sichtbaren Kalk bei B, beweist nicht „reinigt alles“. S3 liefert notwendige Einschränkungen und Nichtmischen. Für die jüngere Klasse etwa: „Bestimmte Säuren reagieren mit Kalk. In unserem Vergleich blieb bei B weniger Kalk sichtbar. Nicht jede Oberfläche verträgt Säure, und Reiniger werden nie gemischt.“ S1/S3/S4 ausdrücklich belegen; S2 als Werbung kennzeichnen.\nFrischer Transfer: Für das Hausmeisterteam die Aufgabe zuerst auf Materialverträglichkeit, sicheren Ablauf und vergleichbare Wirkung eingrenzen. S1 erklärt fachlich die Säure-Carbonat-Reaktion; S3 liefert die im Lehrfall genannten Grenzen und das Mischverbot; S4 zeigt nur Rückstand nach fünf Minuten unter gleicher Proben-/Mengenbedingung. S2 bietet keine belastbare Alles-reinigen-Evidenz. Ein kurzes strukturiertes Blatt trennt diese Quellen und Modellzahlen. Für einen realen Einsatz fehlen konkrete Oberflächenidentität, Herstelleranweisung und Verträglichkeitsprüfung; aus 20 statt 60 Rest folgt kein allgemeiner Dosierungs-/Zeitplan. Quellen angeben und für das Team die offenen Angaben sichtbar machen, statt eine eigenständige Reinigungsanweisung zu erfinden.\nAuf der eigenen Rechercheroute liegen ein tatsächlich selbst gefundener und gelesener relevanter Beleg, ein eigenes ausgefülltes Such-/Lese-/Zitierprotokoll und begründete adressatengerechte Fassungen vor. Die getroffene Auswahl wird an der chemischen Frage erklärt; Original-S/T-Daten bleiben als Lehrmodellzahlen gekennzeichnet, externe Quellen liefern keine erfundenen Messwerte dazu. Fehlende Datum-/Oberflächen-/Kreislaufangaben bleiben offen. Vorgegebene Quelle oder Musterparaphrase allein schließt diesen Quellenweg nicht.",
                "expectedPerformanceEn": "S1 explains the chemical reaction; S4 shows less visible scale with B under the given conditions, not proof of “cleans everything”. S3 supplies necessary restrictions and no-mixing advice. For the younger class: “Some acids react with limescale. In our comparison B left less visible scale. Not every surface tolerates acid, and cleaners are never mixed.” Explicitly cite S1/S3/S4; identify S2 as advertising.\nFresh transfer: For the caretaker team first narrow the task to material compatibility, safe procedure and comparable effect. S1 scientifically explains acid–carbonate reaction; S3 supplies the teaching case’s limits and no-mixing rule; S4 shows only residue after five minutes under equal sample/amount conditions. S2 provides no reliable cleans-everything evidence. A short structured sheet separates these sources and model numbers. Real use still lacks specific surface identity, manufacturer instructions and compatibility checks; 20 rather than 60 residue does not yield a general dose/time plan. Cite sources and make missing information visible to the team rather than inventing independent cleaning instructions.\nOn the own-research route, evidence includes an independently located and actually read relevant source, own completed search/read/citation log and justified audience versions. Explain relevance to the chemical question; retain S/T values as teaching-model data and invent no external measurements for them. Missing date/surface/cycle information stays open. A supplied source or reference paraphrase alone does not complete this route.",
                "understandingFocusDe": "Zielgruppenbezogene Auswahl wahrt chemische, sicherheitsbezogene und datenabhängige Grenzen.",
                "understandingFocusEn": "Audience-specific selection preserves chemical, safety and data-dependent limits."
              },
              {
                "id": "sek1-source-information-packaging-table",
                "taskDemandDe": "Wähle aus Text, Tabelle und Prozessdarstellung passende Informationen für die Frage „Was muss man beim Vergleich dieser Behälter beachten?“ Formuliere eine strukturierte Antwort für die Schülerzeitung und belege die genutzten Quellen.\nFrische Variation: Für einen mehrfach verwendeten Behälter: Welche zusätzliche Information ist wichtiger als Masse je Stück?\nNur auf der Route mit eigener Recherchepflicht: Bestimme eine noch offene Frage für die jeweilige Zielgruppe; finde selbst eine passende zugängliche Quelle über eigene Suche/Navigation, öffne und lies sie. Reiche Suchpfad, Urheber/Titel, genaue URL, Datum/Abruf, konkrete Überschrift/Absatz oder PDF-Seite und eigene fachliche Paraphrase ein. Begründe Auswahl und Grenzen, trenne selbst gefundene Aussagen von S/T-Lehrmodellzahlen, und passe die Information an die neue Zielgruppe bzw. Mehrwegfrage an. Verwende vorgegebene UND selbst gefundene Quellen. Die leere own-source-search-read-cite.learner-blank.csv und OWN-SOURCE-RESEARCH.route.de-en.md sind das Arbeitsmaterial; die Autorenbeispiele zählen nicht als eigene Recherche.",
                "taskDemandEn": "Select suitable information from text, table and process representation for “What must be considered when comparing these containers?” Write a structured answer for the school newspaper and cite the sources used.\nFresh variation: For a reusable container: what additional information matters more than mass per item?\nOnly on a route requiring own research: identify an unresolved audience-specific question; independently locate an accessible suitable source through own search/navigation, open and read it. Submit search path, author/title, exact URL, date/access time, precise heading/paragraph or PDF page and an own scientific paraphrase. Justify relevance and limits, separate found statements from S/T model numbers, and adapt information to the fresh audience/reuse question. Use given AND independently found sources. Use own-source-search-read-cite.learner-blank.csv and OWN-SOURCE-RESEARCH.route.de-en.md; author examples are not own research.",
                "expectedPerformanceDe": "Gleiches Nutzvolumen ermöglicht einen Massenvergleich: Glas ist im Modell fünfmal so schwer wie Metall und zehnmal so schwer wie Polymer. Materialeigenschaften begrenzen Anwendungen, die Prozesskette zeigt weitere benötigte Lebenszyklusdaten. Aus Masse allein folgt keine Umweltbilanz. Quellen T1/T2 für Eigenschaften, T3 für Mengen und T4 für Prozessbezug nennen; fachliche Begriffe verständlich erklären.\nFrischer Transfer: Ein Mehrwegvergleich benötigt tatsächlich erreichte Nutzungen, Ausschuss/Ersatz, Rücktransport sowie Reinigungsenergie, Wasser und Mittel. Unter der rein rechnerischen Modellannahme eines unbeschädigten 200-g-Glasgefäßes mit N tatsächlichen Nutzungen verteilt sich dessen ursprüngliche Materialmasse auf 200/N g je Nutzung; bei zehn Nutzungen 20 g. Das stellt noch keine gleiche Gesamtumweltwirkung zu einem 20-g-Kunststoffgefäß fest, weil Produktion, Reinigung, Transport und Entsorgung fehlen. Nur gleiche 250-mL-Nutzungsleistung vergleichen und Stückmasse, Nutzungszahl und Kreislaufinformationen getrennt strukturieren. Materialeigenschaften aus T1/T2 bleiben relevante Funktionsinformationen, ersetzen aber keine Lebenszyklusdaten.\nAuf der eigenen Rechercheroute liegen ein tatsächlich selbst gefundener und gelesener relevanter Beleg, ein eigenes ausgefülltes Such-/Lese-/Zitierprotokoll und begründete adressatengerechte Fassungen vor. Die getroffene Auswahl wird an der chemischen Frage erklärt; Original-S/T-Daten bleiben als Lehrmodellzahlen gekennzeichnet, externe Quellen liefern keine erfundenen Messwerte dazu. Fehlende Datum-/Oberflächen-/Kreislaufangaben bleiben offen. Vorgegebene Quelle oder Musterparaphrase allein schließt diesen Quellenweg nicht.",
                "expectedPerformanceEn": "Equal useful volume permits mass comparison: in the model glass is five times as heavy as metal and ten times as heavy as polymer. Material properties limit uses; the process chain shows additional lifecycle data needed. Mass alone does not yield an environmental balance. Cite T1/T2 for properties, T3 for quantities and T4 for process context; explain technical terms accessibly.\nFresh transfer: A reuse comparison needs actual completed uses, rejects/replacement, return transport and washing energy, water and agents. Under the purely computational model assumption of an undamaged 200-g glass vessel with N actual uses, its initial material mass distributes to 200/N g per use; ten uses give 20 g. This does not establish equal overall environmental effect to a 20-g polymer vessel because production, washing, transport and disposal are missing. Compare only equal 250-mL service and separately structure item mass, use count and cycle information. T1/T2 material properties remain relevant functional information but do not replace life-cycle data.\nOn the own-research route, evidence includes an independently located and actually read relevant source, own completed search/read/citation log and justified audience versions. Explain relevance to the chemical question; retain S/T values as teaching-model data and invent no external measurements for them. Missing date/surface/cycle information stays open. A supplied source or reference paraphrase alone does not complete this route.",
                "understandingFocusDe": "Strukturierte Quelleninformation trennt Stofffunktion, Bezugsleistung und noch fehlende Kreislaufdaten.",
                "understandingFocusEn": "Structured source information separates material function, reference service and still missing cycle data."
              }
            ]
          }
        }
      },

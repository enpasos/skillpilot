        "evidenceProfile": {
          "goalId": "6c9adc36-b6d0-57fa-8e02-5e156aebfecc",
          "goalFingerprint": "sha256:0891c34d743bf02ee8ffbcb380066674d144b5fe001c531ec00b35db320d3f97",
          "profileRuleVersion": "positive-understanding-evidence-v2",
          "profileFingerprint": "sha256:6ba70f538bc3835c552928b11af818f8836a1537dc7c1f6fbf148d0a24e2efd3",
          "profile": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "diverse-occupations",
                "essentialUnderstandingDe": "Chemische Berufe unterscheiden sich durch Aufgaben, Anwendungen und Anforderungen; fiktive Karten sind keine amtlichen Qualifikationsregeln.",
                "essentialUnderstandingEn": "Chemical occupations differ in tasks, applications and requirements; fictional cards are not official qualification rules.",
                "observablePerformanceDe": "Mindestens drei der L/P/U/F-Felder anhand konkreter Proben-/Daten-/Anlagen-/Forschungsaufgaben und Sicherheits-/Kommunikationsanforderungen vergleichen.",
                "observablePerformanceEn": "Compare at least three L/P/U/F fields using specific sample/data/plant/research tasks and safety/communication requirements."
              },
              {
                "id": "reasoned-choice",
                "essentialUnderstandingDe": "Chemische Anwendungen und gesellschaftliche Entwicklungen können zusammen mit persönlichen oder hypothetischen Präferenzen eine Orientierungswahl begründen.",
                "essentialUnderstandingEn": "Chemical applications and social developments can combine with personal or hypothetical preferences to justify an orientation choice.",
                "observablePerformanceDe": "Informationen ausdrücklich in eine begründete Wahl für Daten/Umwelt bzw. Technik/Ressourcen einbeziehen und mindestens eine Herausforderung sowie aktuellen Informationsbedarf nennen.",
                "observablePerformanceEn": "Explicitly use the information in a justified choice for data/environment or technology/resources and identify at least one challenge and need for current information."
              },
              {
                "id": "changed-preference",
                "essentialUnderstandingDe": "Neue Präferenzen oder Technik verlangen erneut einen auf Aufgaben gestützten Vergleich und konkrete Informationsfragen.",
                "essentialUnderstandingEn": "Changed preferences or technology require a renewed task-based comparison and specific information questions.",
                "observablePerformanceDe": "Bei direkter Anlagensteuerung die eigene U/P-Wahl begründet prüfen; für neue Sensoren zwei Aufgaben-/Anforderungsfragen formulieren, ohne echte Beratung oder garantierten Ausbildungsweg zu behaupten.",
                "observablePerformanceEn": "Review the own U/P choice for direct plant control with reasons; formulate two task/requirement questions for new sensors without claiming real counselling or a guaranteed training route."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "diverse-occupations",
                "reasoned-choice",
                "changed-preference"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "changed-condition",
                "textDe": "Neue fallgebundene Bedingung/Hypothesenprüfung und eigene begründete Revision statt bloßem Zahlentausch.",
                "textEn": "Fresh case-specific condition/hypothesis check and own reasoned revision rather than mere number substitution."
              },
              {
                "id": "source-and-limit",
                "textDe": "BY C9 ausdrücklich in die Berufswahl einbeziehen. Eine hypothetische Berufsorientierung kann die Entscheidungsbegründung prüfen, darf aber keinen echten menschlichen Beratungserfolg oder Orientierungs-Mastery vortäuschen. Dieses curriculare Ziel ist keine ungeprüfte Motivation/orientation.",
                "textEn": "Preserve actual source-specific assistance, stage, track and claim limits; the original whole source-scope contract and case-specific conditions are mandatory. Neither supplied data nor author answers evidence real learner performance."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chemistry-career-choice-data-interest",
                "taskDemandDe": "Vergleiche mindestens drei Berufsfelder anhand der Karten. Für eine ausdrücklich hypothetische Person, die Datenarbeit und Umweltthemen mag, begründe eine Orientierungsentscheidung, Anforderungen, gesellschaftlichen Bezug und einen konkreten nächsten Informationsschritt. Eigene Präferenzen dürfen alternativ genannt werden. Neue Variation: Die Person möchte statt Datenauswertung direkt Anlagenabläufe steuern: Überprüfe die Wahl anhand der Aufgaben, nicht der Berufsbezeichnung.",
                "taskDemandEn": "Compare at least three fields using the cards. For an explicitly hypothetical person who likes data work and environmental topics, justify an orientation choice, requirements, societal link and a specific next information step. Own preferences may alternatively be stated. Fresh variation: The person prefers directly controlling plant operations instead of data evaluation: review the choice using tasks, not job title.",
                "expectedPerformanceDe": "U passt zur Daten-/Umweltpräferenz durch Probenplanung und Spurenanalytik; L bietet ebenfalls Gerät-/Datenarbeit, P verbindet Stoffströme mit Betrieb, F stärker offene Forschung. Anforderungen Sicherheit, Genauigkeit und Kommunikation fachlich konkret vergleichen, nicht Rangliste nach Prestige. Umweltmonitoring gesellschaftlich mit Gewässerschutz/Datenvertrauen verbinden. Nächster Schritt: tatsächlich aktuelle offizielle Berufs-/Qualifikationsinformation oder betreutes Informationsgespräch; hier wird kein realer Beratungserfolg behauptet. Transfer: Bei geänderter Präferenz für direkte Anlagensteuerung passt P nach den fiktiven Aufgaben nun besser als U. P verlangt Überwachung von Stoff-/Energieströmen, Störungsbearbeitung, Sicherheit und Teamabstimmung. L liefert Qualitäts-/Gerätedaten, U überwacht Umweltproben, F entwickelt Methoden; diese Vergleiche erklären die Änderung statt nur den Titel auszutauschen. Gesellschaftlicher Bezug: sichere, ressourcenschonende Produktion. Für eine reale Entscheidung aktuelle amtliche Aufgaben-/Ausbildungsinformation zum passenden konkreten Beruf nachlesen; hier entsteht nur die begründete hypothetische Wahl.",
                "expectedPerformanceEn": "U fits data/environment preference through sampling and trace analysis; L also provides instrument/data work, P connects material flows with operations, F more open research. Specifically compare safety, precision and communication requirements, not a prestige ranking. Link environmental monitoring to water protection/data trust. Next step: actually current official career/qualification information or a supervised information conversation; no real counselling success is claimed here. Transfer: With the changed preference for directly controlling plant operations, P now fits the fictional tasks better than U. P involves monitoring material/energy flows, handling faults, safety and teamwork. L supplies quality/instrument data, U monitors environmental samples and F develops methods; these comparisons explain the revision rather than merely switching a title. Societal link: safe, resource-efficient production. For a real decision, check current official task/training information for the specific relevant occupation; this is only a justified hypothetical choice.",
                "understandingFocusDe": "Die lernende Person kann vielfältige chemische Berufsfelder anhand ihrer Aufgaben, Anwendungsbereiche und Anforderungen vergleichen, ihren Zusammenhang mit chemischen Anwendungen und gesellschaftlichen Entwicklungen erläutern und diese Informationen in eine begründete Berufsorientierung oder Berufswahl einbeziehen. Eigene unabhängige Begründung und tatsächliches gefordertes Leistungsprodukt, keine Wiedergabe der Musterlösung.",
                "understandingFocusEn": "The learner can compare diverse chemical occupations in terms of their tasks, fields of application, and requirements, explain their connection with chemical applications and social developments, and use this information for justified career orientation or a career choice. Own independent reasoning and the actually required performance artifact, not recitation of the worked answer."
              },
              {
                "id": "chemistry-career-choice-technology-interest",
                "taskDemandDe": "Vergleiche L/P/U/F für eine hypothetische Person mit Interesse an Technik, Teamabstimmung und sicherer Ressourcennutzung. Wäge passende und herausfordernde Anforderungen ab und erkläre, wie gesellschaftliche Entwicklungen die Orientierungsfrage verändern könnten. Neue Variation: Neue Sensortechnik verändert die Arbeit: Formuliere zwei zusätzliche Informationsfragen für deine Berufswahl.",
                "taskDemandEn": "Compare L/P/U/F for a hypothetical person interested in technology, teamwork and safe resource use. Weigh matching and challenging requirements and explain how societal developments could change the orientation question. Fresh variation: New sensor technology changes work: formulate two additional information questions for the career choice.",
                "expectedPerformanceDe": "P ist wegen Anlagen-/Stoffstromsteuerung passend, L ergänzt Qualitätsdaten, U prüft Umweltauswirkungen, F entwickelt neue Verfahren. Betriebsverantwortung, Sicherheit und Abstimmung können Anforderungen/Herausforderungen sein. Ressourcenschonung und neue Verfahren verändern Aufgaben, machen aber kein Feld automatisch überlegen. Wahl mit Präferenzen und Aufgaben begründen und echte Qualifikationsinformation als offenen nächsten Schritt markieren. Transfer: Frage 1: Welche neuen Aufgaben zur Kalibrierung, Datenprüfung und Softwarebedienung bringt die Sensortechnik im konkreten Beruf mit sich, und welche Ausbildung/Fortbildung wird tatsächlich verlangt? Frage 2: Welche praktische Sicherheitsverantwortung und Teamentscheidung bleiben bei Störungen trotz automatischer Messung erhalten, und passen diese zu meinen Interessen? Die Fragen betreffen Aufgaben/Anforderungen und die veränderte Ressourcennutzung; Antworten müssen aktuell verlässlich recherchiert werden. Neue Sensoren machen kein Berufsfeld automatisch passend.",
                "expectedPerformanceEn": "P fits plant/material-flow control, L contributes quality data, U checks environmental impacts, F develops new methods. Operational responsibility, safety and coordination can be requirements/challenges. Resource efficiency and new methods change tasks but make no field automatically superior. Justify the choice using preferences/tasks and mark actual qualification information as the next open step. Transfer: Question 1: What new calibration, data-checking and software tasks does the sensor technology introduce in the specific occupation, and what training or continuing education is actually required? Question 2: What practical safety responsibility and team decisions remain during faults despite automatic measurement, and do these match my interests? These questions concern tasks/requirements and changed resource use; their answers need current reliable research. New sensors do not automatically make an occupation suitable.",
                "understandingFocusDe": "Die lernende Person kann vielfältige chemische Berufsfelder anhand ihrer Aufgaben, Anwendungsbereiche und Anforderungen vergleichen, ihren Zusammenhang mit chemischen Anwendungen und gesellschaftlichen Entwicklungen erläutern und diese Informationen in eine begründete Berufsorientierung oder Berufswahl einbeziehen. Eigene unabhängige Begründung und tatsächliches gefordertes Leistungsprodukt, keine Wiedergabe der Musterlösung.",
                "understandingFocusEn": "The learner can compare diverse chemical occupations in terms of their tasks, fields of application, and requirements, explain their connection with chemical applications and social developments, and use this information for justified career orientation or a career choice. Own independent reasoning and the actually required performance artifact, not recitation of the worked answer."
              }
            ]
          }
        }
      },

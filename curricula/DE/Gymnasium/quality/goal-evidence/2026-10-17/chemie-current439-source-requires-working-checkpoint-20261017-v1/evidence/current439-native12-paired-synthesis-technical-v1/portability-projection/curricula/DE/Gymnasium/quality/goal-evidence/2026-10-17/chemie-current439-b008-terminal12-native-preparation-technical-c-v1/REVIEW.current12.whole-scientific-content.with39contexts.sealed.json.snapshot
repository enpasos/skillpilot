          "visualization": {
            "resourceType": "image",
            "title": "Visualisierung: Chemische Pro- und Kontra-Argumente abwägen",
            "url": "/assets/goal-visualizations/chemie/431a0f03-f28a-5e56-a61f-000336d0b410/431a0f03-f28a-5e56-a61f-000336d0b410.png",
            "altText": "Große Pro- und Kontra-Karten mit je einem Belegbuch und einem neutralen Kolben flankieren eine leere ausgeglichene Waage. Darunter stehen die Kriterien Umwelt, Sicherheit und Kosten.",
            "originalDigest": "sha256:697d3f4ba134ccb6094266610a0663e07ad621d3a44b31499dd9a732021e0ac3",

          },
          "goalFingerprint": "sha256:7fbda887bd502458a1f81ff9c2a7668f1a9793347dc537a8b20793002f80cbc4",
          "pageFingerprint": "sha256:a64bbd31db09eb0921058c948e25b9e45de4891eeb3f987f4b7f4b634558739e"
        },
        "evidenceProfile": {
          "goalId": "f79f15c0-e848-5e17-9eb5-26753d35c93b",
          "goalFingerprint": "sha256:7fbda887bd502458a1f81ff9c2a7668f1a9793347dc537a8b20793002f80cbc4",
          "profileRuleVersion": "positive-understanding-evidence-v2",
          "profileFingerprint": "sha256:256122a87970158ba39e7002b5f59e47ba953594b0db0c06bee223502d4f9414",
          "profile": {
            "archetype": "experiment",
            "expectations": [
              {
                "id": "own-method-plan",
                "essentialUnderstandingDe": "Eine überwiegend selbst geplante qualitative UND quantitative Hypothesenprüfung benötigt eine fachlich geeignete Analysenmethode und passende Kontrollen.",
                "essentialUnderstandingEn": "A mostly independently planned qualitative AND quantitative hypothesis test needs a scientifically suitable analytical method and appropriate controls.",
                "observablePerformanceDe": "Plant Säureanalyse oder Farbstoffanalyse mit begründeter Methodenwahl, qualitativer Zuordnung, quantitativem Ansatz, Standards/Blank, Wiederholung und konkreter Sicherheitsfreigabe.",
                "observablePerformanceEn": "Plans acid or dye analysis with justified method choice, qualitative assessment, quantitative approach, standards/blank, repeats and specific safety release."
              },
              {
                "id": "actual-analysis-record",
                "essentialUnderstandingDe": "Referenz-Titrationen oder Kalibriergeraden sind keine eigene sichere experimentelle Durchführung.",
                "essentialUnderstandingEn": "Reference titrations or calibration lines are not own safe experimental execution.",
                "observablePerformanceDe": "Führt die freigegebene Analyse tatsächlich aus; bewahrt eigene Vorbereitung, Geräte-/Standardprüfung, Rohwerte, pH-/Indikatorbeobachtung bzw. Absorbanz und Abweichungen als Protokoll.",
                "observablePerformanceEn": "Actually executes the released analysis; retains own preparation, instrument/standard checks, raw readings, pH/indicator observation or absorbance and deviations as a record."
              },
              {
                "id": "quantitative-validity",
                "essentialUnderstandingDe": "Stöchiometrie und Kalibrierbereich bestimmen zulässige Auswertung; ein falscher Standard kann absolute Werte verzerren, ein gemeinsamer Faktor kann sich im Verhältnis kürzen.",
                "essentialUnderstandingEn": "Stoichiometry and calibration range govern valid evaluation; a wrong standard can bias absolute values while a common factor may cancel in a ratio.",
                "observablePerformanceDe": "Berechnet aus eigenen zulässigen Daten Konzentrationen, prüft Hypothese und Unsicherheit; behandelt falsche Basenkonzentration sowie A=0,810 außerhalb der Farbstoffkalibrierung ohne unzulässige Extrapolation.",
                "observablePerformanceEn": "Calculates concentrations from own valid data, checks hypothesis and uncertainty; handles wrong base concentration and A=0.810 outside the dye calibration without invalid extrapolation."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "own-method-plan",
                "actual-analysis-record",
                "quantitative-validity"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "standard-validity",
                "textDe": "Gleiche und zeitlich veränderte Maßlösung werden hinsichtlich absoluter Konzentration und Verhältnis getrennt.",
                "textEn": "Common and temporally changed titrant are distinguished for absolute concentration and ratio."
              },
              {
                "id": "calibration-domain",
                "textDe": "Nur neu gemessene Werte innerhalb einer eigenen gültigen Kalibrierung dürfen nach bekannter Verdünnung zurückgerechnet werden.",
                "textEn": "Only new readings within an own valid calibration may be converted back using known dilution."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "upper-hypothesis-investigation-acid-analysis",
                "taskDemandDe": "Wähle begründet Indikator-/pH-Analyse und ein quantitatives Titrierverfahren. Plane größtenteils selbst Proben, Blind-/Kontrollprüfung und Wiederholungen, lasse den Plan freigeben und führe ihn tatsächlich aus. Protokolliere qualitative Umschlagbeobachtung, pH-/Volumendaten und berechne aus eigenen Werten das A/B-Verhältnis.\nFrische Variation: Plane eine Prüfung für falsch konzentrierte Lauge; erläutere deren Wirkung auf absolute Konzentration und A/B-Verhältnis.",
                "taskDemandEn": "Justify choice of indicator/pH analysis and quantitative titration. Largely independently plan samples, blank/control checks and repeats, obtain authorisation and actually perform the experiment. Record qualitative colour change, pH/volume data and calculate the A/B ratio from own values.\nFresh variation: Plan a check for incorrect base concentration; explain its effect on absolute concentrations and the A/B ratio.",
                "expectedPerformanceDe": "Ein akzeptabler Plan verwendet je gleiche 10,00-mL-Aliquote, standardisierte Lauge, saubere vorbereitete Geräte, geeigneten schwache-Säure-Endpunkt und wiederholte Volumina. Referenz: 8,00 mL A und 16,00 mL B ergeben cA = 0,00800 mol/L, cB = 0,0160 mol/L und Verhältnis 2,00. Die echte Durchführung und eigenen Rohwerte müssen davon unabhängig dokumentiert sein. pH allein beweist wegen des Dissoziationsgleichgewichts kein Konzentrationsverhältnis 2; geeignete Stoffmengenanalyse schon innerhalb ihrer Unsicherheit. Die Indikatorwahl nutzt den angegebenen Umschlagsbereich und die eigene Kurve: Methylorange schlägt in dieser schwachen-Säure-Titration vor dem alkalischen Äquivalenzbereich um; Phenolphthalein verlangt einen kontrollierten ersten schwachen Umschlag und Prüfung der Endpunktabweichung. Kalibration mit aktuellen Puffern wird tatsächlich protokolliert; ihre Nominalwerte sind keine Probenmessung.\nFrischer Transfer: Mit cSäure=cBase·Veq/VSäure skaliert eine falsch angenommene Basenkonzentration beide absoluten Säurewerte. Modellillustration, keine Messung: Bei tatsächlich 0,00900 statt angenommen 0,0100 mol/L Base und denselben Referenzvolumina 8/16 mL auf 10 mL Probe wären die Konzentrationen 0,00720/0,01440 statt berichteter 0,00800/0,01600 mol/L; die berichteten Werte wären 11,1 % zu hoch. Das Verhältnis B/A bleibt 2, wenn dieselbe unveränderte Maßlösung, gleiche Stöchiometrie und vergleichbare Endpunkterfassung gelten. Bei Drift oder unterschiedlichen Maßlösungen kürzt sich der Fehler nicht zuverlässig. Eigene Standardprüfung gegen geeignete bestätigte Referenz/Lehrkraftstandardisierung und eigene Rohdaten sind nötig; keine zusätzliche gefährliche Durchführung wird hier freigegeben.",
                "expectedPerformanceEn": "An acceptable plan uses equal 10.00-mL aliquots, standardised base, clean prepared instruments, an endpoint suitable for a weak acid and repeated volumes. Reference: 8.00 mL for A and 16.00 mL for B yield cA = 0.00800 mol/L, cB = 0.0160 mol/L and ratio 2.00. Actual execution and own raw values must be independently recorded. pH alone does not prove a concentration ratio of 2 because of dissociation equilibrium; an appropriate amount analysis can within its uncertainty. Indicator choice uses the stated transition range and own curve: methyl orange changes before the alkaline equivalence region in this weak-acid titration; phenolphthalein requires a controlled first faint colour change and assessment of endpoint bias. Actually log calibration with current buffers; their nominal values are not sample readings.\nFresh transfer: Using cAcid=cBase·Veq/VAcid, an incorrectly assumed base concentration scales both absolute acid results. Model illustration, not a measurement: with actual 0.00900 rather than assumed 0.0100 mol/L base and the same reference volumes 8/16 mL for a 10 mL sample, concentrations would be 0.00720/0.01440 rather than reported 0.00800/0.01600 mol/L; reported readings would be 11.1% high. B/A remains 2 if the same unchanged titrant, stoichiometry and comparable endpoint detection apply. Drift or different titrants prevent reliable cancellation. Own standard checks against a suitable confirmed reference/teacher standardisation and own raw data are required; no additional hazardous execution is released here.",
                "understandingFocusDe": "Quantitative Stöchiometrie trennt gemeinsame absolute Standardverzerrung und unter Bedingungen robustes Verhältnis.",
                "understandingFocusEn": "Quantitative stoichiometry separates common absolute standard bias from a conditionally robust ratio."
              },
              {
                "id": "upper-hypothesis-investigation-colour-analysis",
                "taskDemandDe": "Plane selbst qualitative Farbprüfung und quantitative photometrische Analyse mit Blindprobe, Kalibration und Wiederholung. Lass den konkret stoffbezogenen Plan freigeben, führe ihn tatsächlich aus und dokumentiere deine Werte. Begründe, wie die Methode die Hypothese prüft und wann verdünnt werden müsste.\nFrische Variation: Begründe für den bereitgestellten Modellwert A = 0,810, weshalb die gültige Kalibration 0–6 mg/L mit ihrem oberen Modellwert A = 0,490 keine Auswertung der unverdünnten Probe erlaubt. Wähle eine zweifache Verdünnung als ersten Prüfversuch: 10,00 mL Aliquot im 20,00-mL-Messkolben bis Marke auffüllen und mischen; erläutere die Gerätefehlergrenzen. Dieser Vorschlag garantiert noch keinen Wert im gültigen Bereich. Erst eine neue tatsächliche In-Bereich-Messung mit eigener gültiger Kalibration erlaubt die Bestimmung von cverdünnt und die Rückrechnung cunverdünnt = 2·cverdünnt. Liegt der neue Wert weiterhin außerhalb, ist eine weitere bekannte Verdünnung und eine neue gültige Messung erforderlich; den Gesamtfaktor dokumentieren. Aus A = 0,810 wird weder die ursprüngliche Konzentration noch der neue Messwert extrapoliert. Modellplanung ersetzt keine Durchführung. Echte Ausführung verlangt Freigabe, eigenen Volumenlog und eigene Messwerte.",
                "taskDemandEn": "Independently plan qualitative colour checks and quantitative photometric analysis with blank, calibration and repeats. Obtain authorisation of the substance-specific plan, actually perform it and document your values. Justify how the method tests the hypothesis and when dilution would be necessary.\nFresh variation: For the supplied model value A = 0.810, explain why the valid 0–6 mg/L calibration with its upper model value A = 0.490 does not permit evaluation of the undiluted sample. Choose a twofold dilution as an initial trial: dilute a 10.00-mL aliquot to the mark in a 20.00-mL flask and mix; explain instrument error limits. This proposal does not yet guarantee a value within the valid range. Only a new actual in-range reading using own valid calibration permits determination of cdiluted and back-calculation cundiluted = 2·cdiluted. If the new reading remains outside the range, another known dilution and a new valid reading are required; record the overall factor. Neither original concentration nor the new reading is extrapolated from A = 0.810. Model planning does not replace execution. Actual execution requires authorisation, own volume log and own readings.",
                "expectedPerformanceDe": "Ein möglicher Plan vergleicht Farbe und Blindprobe unter gleichen Bedingungen, prüft Standards, misst U wiederholt in sauberen Küvetten und nutzt die gültige Kalibration. Referenz U = 0,290 ergibt (0,290−0,010)/0,080 = 3,50 mg/L. Echte U-Werte erst bei Durchführung eintragen. Ähnliche Farbe allein identifiziert X nicht eindeutig. Außerhalb des linearen Bereichs ist eine bekannte Verdünnung und Rückrechnung nötig; Durchführung darf nicht durch Modellrechnung ersetzt werden.\nFrischer Transfer: A=0,810 liegt über dem höchsten Standard A=0,490: Die gültige Kalibrierung 0–6 mg/L erlaubt keine berichtbare Ausgangskonzentration daraus. Zunächst eine bekannte neue Verdünnung planen, etwa 10,00 mL auf 20,00 mL als nominalen Faktor 2, und nach Freigabe tatsächlich messen. Faktor 2 garantiert ohne gültigen Ausgangswert keinen in-range-Wert. Nur wenn der neue eigene Wert in der eigenen gültigen Kalibrierung liegt, gilt cOriginal=2·cVerdünnung; andernfalls einen weiteren bekannten Faktor und neue Messung nutzen. Mit den bereitgestellten absoluten Volumengrenzen liegt allein das Faktorintervall zwischen 19,98/10,02≈1,9940 und 20,02/9,98≈2,0060; das ist keine Gesamtunsicherheit. Keine neue Absorbanz wird aus 0,810 extrapoliert oder als gemessen erfunden.",
                "expectedPerformanceEn": "A possible plan compares colour and blank under equal conditions, checks standards, repeatedly measures U in clean cuvettes and uses valid calibration. Reference U = 0.290 gives (0.290−0.010)/0.080 = 3.50 mg/L. Enter actual U values only during execution. Similar colour alone does not identify X uniquely. Outside the linear range, a known dilution and back-calculation are required; actual execution cannot be replaced by model arithmetic.\nFresh transfer: A=0.810 exceeds the highest standard A=0.490: valid calibration over 0–6 mg/L cannot yield a reportable original concentration from it. First plan a known new dilution, such as 10.00 mL to 20.00 mL with nominal factor 2, and actually measure after release. Factor 2 does not guarantee an in-range reading without a valid starting value. Only if the new own reading lies within the own valid calibration use cOriginal=2·cDiluted; otherwise use another known factor and a new measurement. With the supplied absolute volume limits the factor interval alone is 19.98/10.02≈1.9940 to 20.02/9.98≈2.0060; this is not total uncertainty. No new absorbance is extrapolated from 0.810 or invented as measured.",
                "understandingFocusDe": "Eigene Analyse respektiert Kalibrierbereich und tatsächlich neue Verdünnungs-/Messprodukte.",
                "understandingFocusEn": "Own analysis respects calibration range and actually new dilution/measurement products."
              }
            ]
          }
        }
      },

    "wholeCase": {
      "id": "energy20-01-a",
      "goalId": "ecce0306-13dc-5563-a097-afe69805a8d6",
      "title": "PEM-Bus und Bilanzgrenzen",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Ein eigener Modellbus nutzt H2/O2 mit saurer protonenleitender Membran. Beschriftete Anschlüsse A=H2, B=O2; Außenleiter A→Motor→B, keine Elektronenleitung durch die Membran. Daten pro100km:9kgH2, Herstellung55kWh/kg, Strommix0,40kgCO2/kWh. Im Fahrzeug entsteht aus reinemH2 nur Wasser; Wärme wird abgeführt. Kein Bauversuch, keine Gaszündung.",
      "materialsEn": "An own model bus uses H2/O2 with an acidic proton-conducting membrane. Port A=H2, B=O2; external wire A→motor→B, no electron conduction through the membrane. Per100km:9kgH2, production55kWh/kg, electricity0.40kgCO2/kWh. Pure-H2 vehicle operation forms water; heat is removed. No construction or ignition experiment.",
      "taskDe": "Leite beide Elektrodenreaktionen und die Gesamtreaktion selbst her. Erkläre Stoff-, Protonen- und Elektronenwege sowie einen blockierten Protonenweg. Beurteile emissionsfreien Betrieb als Aussage über Fahrzeug und Bereitstellung; nenne eine begründete Nutzungschance und eine Infrastrukturgrenze.",
      "taskEn": "Derive both electrode and overall reactions. Explain material, proton and electron paths and a blocked proton path. Evaluate emission-free operation at vehicle and production boundaries; justify one application and one infrastructure limitation.",
      "workedReasoningDe": "Anode: H2→2H+ +2e−; Kathode:½O2+2H+ +2e−→H2O; gesamt: H2+½O2→H2O. Ladung und Atome stimmen; Elektronen treiben außen den Motor, H+ schließt innen den Kreis. Blockierte Membran verhindert Dauerstrom. Bereitstellung benötigt495kWh und verursacht hier198kgCO2/100km; Auspuff-Wasser beweist keine klimaneutrale Kette. Schnelles Nachfüllen kann bei langen Linien nützen; Herkunft, Kompression, Netze und Verteilung begrenzen flächendeckenden Einsatz.",
      "workedReasoningEn": "Anode:H2→2H+ +2e−; cathode:½O2+2H+ +2e−→H2O; overall:H2+½O2→H2O. Atoms/charge balance. Electrons power the motor externally; H+ closes the internal circuit. Blocking the membrane prevents sustained current. Production needs495kWh and causes198kgCO2/100km here; tailpipe water does not establish a climate-neutral chain. Rapid refuelling may help long routes; production, compression and distribution constrain deployment.",
      "freshIndependentTransferDe": "Erhalte statt reinemH2 ein CO-verunreinigtes Gas und einen sauberen erneuerbaren Strompfad. Erkläre ohne Gleichungsvorlage, welche frühere Schlussfolgerung zur lokalen Chemie gilt und welche zur Katalysatorfunktion/CO2-Bilanz neu geprüft werden muss.",
      "freshIndependentTransferEn": "Receive CO-contaminated hydrogen and a clean renewable electricity route. Without an equation template, identify which local-chemistry conclusion remains and which catalyst/carbon conclusion needs new evidence.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Bilanzierte Teilgleichungen und getrennte H+/e−-Wege selbst erzeugen.",
          "observableEn": "Independently construct balanced half-reactions and separate H+/electron paths.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "495kWh und198kgCO2 auf denselben100km-Bezug bringen, nicht Energie und Masse gleichsetzen.",
          "observableEn": "Use the same100km basis for495kWh and198kgCO2; do not equate energy and mass.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Lokale Wasserbildung von Vorkette und Einsatzentscheidung trennen.",
          "observableEn": "Separate local water formation, upstream chain and application judgement.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    }
  },
  {
    "sourcePath": "/mnt/e/skillpilot-chemie-L7-20261017/current439-AV-and-native-registry-integration-root-v1/capsule/curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-four-context-satisfied-current422-positive-and-atomic-informed-20261015-v1/materials/four-whole-cases8.targeted-informed-successor.json",
    "wholeCase": {
      "id": "energy20-01-b",
      "goalId": "ecce0306-13dc-5563-a097-afe69805a8d6",
      "title": "Alkalische Zelle mit Luft und Kohlendioxid",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Modell-AFC mit wässrigerKOH, H2 an negativer Elektrode, O2 an positiver. OH− wandert im Elektrolyten von der Sauerstoff- zur Wasserstoffseite. Fiktives Versuchsdossier (eigene vorgegebene Modelldaten, keine tatsächlich erhobene Messreihe): CO2-freie Luft0,78V unter Last; nach langer Zufuhr CO2-haltiger Luft0,54V bei gleicher Last/Temperatur; CO2+2OH−→CO3²−+H2O. Kein kausaler Einzelfaktorbeweis aus zwei Werten.",
      "materialsEn": "Model AFC with aqueousKOH, H2 at the negative electrode and O2 at the positive electrode. OH− moves internally from oxygen to hydrogen side. Fictional supplied dossier (own model data, not an actually recorded measurement series): CO2-free air0.78V under load; prolonged CO2-containing air0.54V at the same load/temperature; CO2+2OH−→CO3²−+H2O. Two values alone do not prove a unique cause.",
      "taskDe": "Erzeuge passende alkalische Teilgleichungen, vergleiche die Wasserbildung mit der sauren Zelle und begründe, weshalb die saure Protonenzeichnung hier falsch wäre. Erkläre den plausiblen CO2-Effekt und einen kontrollierten nächsten Vergleich. Bewerte die Luftversorgung ohne allgemeine AFC-Überlegenheit zu behaupten.",
      "taskEn": "Construct alkaline half-reactions, compare water formation with the acidic cell and explain why its proton diagram would be wrong here. Explain a plausible CO2 effect and one controlled follow-up. Evaluate air supply without asserting universal AFC superiority.",
      "workedReasoningDe": "Anode: H2+2OH−→2H2O+2e−; Kathode:½O2+H2O+2e−→2OH−. Addition ergibt dieselbe Gesamtreaktion; OH− wird intern regeneriert, Wasser entsteht an der Anode und wird teilweise an der Kathode verbraucht. Carbonatbildung ändert Zusammensetzung/Leitung, ist plausibel aber Alterung/Feuchte bleiben Alternativen. Vergleich mit zeitgleicher CO2-freier Kontrollzelle bei gleichem Strom, Gasfluss und Temperatur; keine sichere Reversibilität oder Effizienz aus Spannung allein.",
      "workedReasoningEn": "Anode:H2+2OH−→2H2O+2e−; cathode:½O2+H2O+2e−→2OH−. Summation gives the same overall reaction; OH− is internally regenerated, with water formed at the anode and partly consumed at the cathode. Carbonate formation plausibly alters electrolyte composition/conduction, but ageing/humidity are alternatives. Compare a time-matched CO2-free control at identical current, flow and temperature; voltage alone gives neither reversibility nor efficiency.",
      "freshIndependentTransferDe": "Eine Anionenaustauschmembran ersetzt die KOH-Lösung. Entscheide, welche Ladungsbilanz bleibt und welche Aussage über flüssiges Elektrolytmanagement nicht einfach übertragbar ist.",
      "freshIndependentTransferEn": "Replace aqueousKOH with an anion-exchange membrane. Decide which charge balance survives and which liquid-electrolyte-management conclusion cannot simply transfer.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "OH−-Teilgleichungen einschließlich unterschiedlichem Ort der Wasserbildung begründen.",
          "observableEn": "Justify OH− half-reactions and the different water-formation location.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "Vorgegebenen Modell-Spannungsunterschied von begründeter Carbonat-Hypothese unterscheiden.",
          "observableEn": "Distinguish the supplied model voltage difference from the justified carbonate hypothesis.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Kontrollvariablen und eine anwendungsbezogene Einschränkung nennen.",
          "observableEn": "Specify controls and an application-specific limitation.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    }
  },
  {
    "sourcePath": "/mnt/e/skillpilot-chemie-L7-20261017/current439-AV-and-native-registry-integration-root-v1/capsule/curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-four-context-satisfied-current422-positive-and-atomic-informed-20261015-v1/materials/four-whole-cases8.targeted-informed-successor.json",
    "wholeCase": {
      "id": "energy20-13-a",
      "goalId": "3ec31fe1-e01b-5edd-bd9a-936191d67639",
      "title": "Strom- und Nutzwärmewirkungsgrad",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Eigene Messkarten: WandlerA erhält10MJ Brennstoff und liefert3MJStrom+5MJ grundsätzlich nutzbare Wärme; WandlerB erhält20MJ desselbenLHV-Brennstoffbezugs und liefert12MJStrom+5MJWärme. Tatsächlicher Wärmebedarf pro Durchgang2MJ. Verluste an Umgebung werden nicht zurückgewonnen. Messunsicherheit jeweils±0,1MJ an Strom/Wärme; keine Apparaturausführung. Im Modell gelten Energieeingänge und Wärmebedarf als exakt. Die jeweils±0,1MJ sind absolute Fehlergrenzen der beiden Ausgabegrößen, keine statistischen Konfidenzintervalle.",
      "materialsEn": "Own cards:A receives10MJ fuel and gives3MJ electricity+5MJ heat of potentially usable grade;B receives20MJ on the sameLHV basis and gives12MJ electricity+5MJ heat. Actual heat demand2MJ/cycle. Ambient losses are not recovered. Electricity/heat uncertainty±0.1MJ;no apparatus execution. In this model, energy inputs and heat demand are exact. The ±0.1MJ values are absolute error bounds on each output quantity, not statistical confidence intervals.",
      "taskDe": "Berechne elektrische, nominelle Gesamt- und bedarfsbezogene Gesamtwirkungsgrade. Vergleiche auf gemeinsamer Eingangs- oder Servicebasis und erkläre, warum WandlerB nicht85%nutzbare Energie liefert, wenn Wärmebedarf fehlt. Bestimme aus den vorgegebenen Fehlergrenzen passende Wirkungsgradintervalle; zähle den festen Wärmebedarf nicht als weitere Messunsicherheit.",
      "taskEn": "Calculate electrical,nominal-total and demand-adjusted efficiencies. Compare on a common input/service basis and explain whyB does not deliver85%useful energy when heat demand is absent. Derive efficiency intervals from the given error bounds; do not treat the fixed heat demand as an extra measurement uncertainty.",
      "workedReasoningDe": "A:ηel30%, nominell80%, mit2MJBedarf50%. B:ηel60%, nominell85%, mit2MJBedarf70%. Bei gleichem20MJ-Eingang entsprichtA zwei Durchgängen und anderem Serviceumfang; dieser Vergleich muss ausdrücklich bezeichnet werden. Wirkungsgrade sind dimensionslose Anteile, nichtMJ-Werte; ungenutzte Wärme bleibt Energie, aber keine für diese Nachfrage genutzte Arbeit/Wärme. Unsicherheiten verhindern hier nicht den großen Stromunterschied, aber eine feinere Rangfolge braucht Fehlerrechnung und einheitliche Grenze. Bei den ausdrücklich exakten Eingängen ergeben sich für A elektrisch29–31%, nominell78–82% und bedarfsbezogen49–51%; für B59,5–60,5%,84–86% und69,5–70,5%. Für die nominale Summe werden die beiden absoluten Fehlergrenzen konservativ addiert. Bei2MJBedarf liegt selbst die kleinste verfügbare Wärme über dem Bedarf: nur die Stromfehlergrenze wirkt auf den bedarfsbezogenen Zähler. Ohne Wärmenutzung liefert B60% elektrischen Nutzen, nicht85%. Im Transfer mit5MJWärmebedarf wären bei vollständig genutztem Strom die nominalen Werte relevant; sinkende Stromnachfrage ohne Zahlen erlaubt keinen neuen eindeutigen Gesamtnutzen.",
      "workedReasoningEn": "A:electrical30%,nominal80%,with2MJ demand50%. B:electrical60%,nominal85%,with2MJ demand70%. Equal20MJ input means twoA cycles and a different service total,which must be declared. Efficiencies are dimensionless fractions,notMJ. Unused heat remains energy but is not useful service for this demand. Uncertainty does not erase the large electrical difference;fine rankings need error analysis/common boundaries. With the explicitly exact inputs, A has electrical29–31%, nominal78–82% and demand-adjusted49–51%; B has59.5–60.5%,84–86% and69.5–70.5%. For nominal sums, conservatively add both absolute output error bounds. At2MJ heat demand even the smallest heat output exceeds demand, so only the electricity error bound affects the demand-adjusted numerator. With no heat use, B supplies60% electrical service, not85%. In the5MJ-heat transfer, nominal values apply if all electricity is used; an unspecified reduction in electricity demand prevents a unique new useful-output result.",
      "freshIndependentTransferDe": "Der Wärmebedarf wächst auf5MJ und die Stromnachfrage sinkt. Bestimme neu, welche Kennzahl für diesen Dienst relevant ist, statt einen festen Sieger ausηel abzuleiten.",
      "freshIndependentTransferEn": "Heat demand rises to5MJ while electricity demand falls. Reconsider the relevant metric instead of choosing a permanent winner fromηel.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Drei verschiedene Nutzengrenzen ausdrücklich definieren.",
          "observableEn": "Explicitly define three useful-output boundaries.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "30/80/50% und60/85/70% korrekt berechnen.",
          "observableEn": "Correctly calculate30/80/50% and60/85/70%.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Energieerhaltung, tatsächliche Nutzung und Vergleichsbasis auseinanderhalten; die deklarierten absoluten Fehlergrenzen korrekt fortführen.",
          "observableEn": "Separate energy conservation, actual service and comparison basis; propagate the declared absolute error bounds correctly.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    }
  },
  {
    "sourcePath": "/mnt/e/skillpilot-chemie-L7-20261017/current439-AV-and-native-registry-integration-root-v1/capsule/curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-four-context-satisfied-current422-positive-and-atomic-informed-20261015-v1/materials/four-whole-cases8.targeted-informed-successor.json",
    "wholeCase": {
      "id": "energy20-13-b",
      "goalId": "3ec31fe1-e01b-5edd-bd9a-936191d67639",
      "title": "Vom Primärbrennstoff bis zum Rad",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Fiktive Daten pro100km: Elektrofahrzeug bezieht20kWh an der Steckdose und liefert16,4kWh Radarbeit. Die gesamte vorgelagerte Strecke vom Brennstoff-LHV bis zur Steckdose hat im Modellη=40%; zusätzliche Netzverluste werden nicht nochmals angesetzt. Der Verbrennungspfad verbraucht60kWh Brennstoff-LHV am Fahrzeugeingang und liefert15kWh Radarbeit. Dies ist Brennstoff-Rad, kein isolierter Motorwellenwirkungsgrad. Für die Normierung gelten die Wirkungsgrade im Modell als konstant. Unterschiedliche Radarbeiten sind ausdrücklich sichtbar. Brennstoffgewinnung und Anlagen-/Fahrzeugherstellung sind nicht erfasst, keine Wärmegutschrift. Als zusätzlicher Textkontext nennt die vorhandene Übersicht80% für mechanischen Motornutzen und5% für Lichtnutzen einer Lampe bei jeweils100J Eingang.",
      "materialsEn": "Fictional per100km: EV receives20kWh at the socket and supplies16.4kWh wheel work. The entire upstream fuel-LHV-to-socket path has model efficiency40%; do not add network losses again. The combustion path consumes60kWh fuel LHV at the vehicle input and supplies15kWh wheel work. This is fuel-to-wheel, not isolated engine-shaft efficiency. Efficiencies are assumed constant for the model normalisation. Different wheel outputs are explicit. Fuel extraction and plant/vehicle manufacture are outside the model; no heat credit. Additional text context reports the existing overview’s80% mechanical motor service and5% lamp light service, each for100J input.",
      "taskDe": "Berechne Steckdose-Rad, Primärenergie-Rad und Brennstoff-Rad-Wirkungsgrad. Normiere für einen Vergleich beide auf15kWh Radarbeit. Prüfe die Behauptung „82%ist direkt mit25%vergleichbar, also ist die ganze Kette82%“. Erkläre zusätzlich, weshalb die80%/5% aus dem Übersichtskontext verschiedene Nutzfunktionen betreffen und keinen allgemeinen Anwendungssieger festlegen.",
      "taskEn": "Calculate socket-to-wheel,primary-to-wheel and fuel-to-wheel efficiencies. Normalise both to15kWh wheel work. Evaluate“82%can directly be compared with25%,so the entire chain is82%”. Also explain why the overview’s80%/5% use different service functions and cannot select a universal application winner.",
      "workedReasoningDe": "ηsocket=16,4/20=82%; Primärinput20/0,4=50kWh,ηgesamt32,8%. Brennstoff-Rad-Pfad15/60=25%. Für15kWhRad benötigtEV15/0,82≈18,293kWhSteckdosenstrom und45,732kWhPrimärenergie; Verbrennungspfad60kWh.82%beschreibt eine engere Grenze als25%Brennstoff-Rad. Ein anderer Strombereitstellungsweg verändert Primärenergiedefinition und Bilanz; die Daten zeigen keine vollständige Ökobilanz. Die40%-Strecke endet bereits an der Steckdose; ihre Verluste werden einmal berücksichtigt. Brennstoffgewinnung beider Wege und Herstellungsbilanzen sind nicht nachgewiesen. Die80% eines Motors und5% einer Lampe sind korrekt als numerische Anteile verschiedener definierter Nutzformen lesbar; mechanische Arbeit und Licht sind keine austauschbare Dienstleistung. Daraus folgt kein allgemeines Umwelt- oder Einsatzranking.",
      "workedReasoningEn": "Socket efficiency16.4/20=82%;primary input20/0.4=50kWh,total32.8%. Fuel-to-wheel path15/60=25%. For15kWh wheels,EV needs15/0.82≈18.293kWh socket and45.732kWh primary;combustion60kWh.82%uses a narrower boundary than fuel-to-wheel25%. Another electricity route changes primary-energy conventions/accounting;this is not a completeLCA. The40% path already ends at the socket, so count its losses once. Fuel extraction for both routes and manufacturing inventories are not established. A motor’s80% and a lamp’s5% are numerical fractions of different defined service forms; mechanical work and light are not interchangeable services. They establish no universal environmental or application ranking.",
      "freshIndependentTransferDe": "Strom kommt nun direkt aus einerPV-Anlage. Sage, welche bekannte Teilwirkungsgradmessung bleibt und welche Primärenergie-Konvention neu deklariert werden muss.",
      "freshIndependentTransferEn": "Electricity now comes directly fromPV. Identify the unchanged measured partial efficiency and the primary-energy convention requiring a new declaration.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Strom-/Brennstoff- und Radarbeitsgrenzen korrekt auswählen.",
          "observableEn": "Select electricity/fuel/wheel-work boundaries correctly.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "82%,32,8%,25% und gemeinsame15kWh-Servicebasis herleiten.",
          "observableEn": "Derive82%,32.8%,25% and common15kWh service.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Kein Umwelt- oder Anwendungsurteil allein aus einem Teilwirkungsgrad oder aus verschiedenen Nutzfunktionen ableiten; Verluste nicht doppelt zählen.",
          "observableEn": "Do not infer an environmental/application verdict from one partial efficiency or different service functions; do not double-count losses.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    }
  },
  {
    "sourcePath": "/mnt/e/skillpilot-chemie-L7-20261017/current439-AV-and-native-registry-integration-root-v1/capsule/curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-four-context-satisfied-current422-positive-and-atomic-informed-20261015-v1/materials/four-whole-cases8.targeted-informed-successor.json",
    "wholeCase": {
      "id": "energy20-14-a",
      "goalId": "e20d205f-03a4-5f96-b456-9b20460605a2",
      "title": "Ethanolbilanz mit explizitem biogenemKohlenstoff",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Eigenes vereinfachtes lebenswegbezogenes Klimabilanzmodell pro1MJ Brennstoffenergie: Bioethanol Anbau20gCO2e, Verarbeitung15, Transport5; biogene Aufnahme−71gCO2, Verbrennung+71gCO2. Vollständige Nachbildung im gleichen Zeitraum angenommen, keine Landnutzungsänderung. Fossiler Vergleich95gCO2e/MJ einschließlich Nutzung. Andere Umweltkategorien sind nicht erfasst.",
      "materialsEn": "Own simplified life-cycle climate table per1MJ fuel energy:bioethanol cultivation20gCO2e,processing15,transport5;biogenic uptake−71gCO2 and combustion+71gCO2,assuming full regrowth in the same time horizon. Fossil comparator95gCO2e/MJ including use. Base scenario no land-use change. Equal energy/boundary;other impact categories excluded.",
      "taskDe": "Erstelle und interpretiere die vereinfachte Bilanz. Ändere anschließend nur den Landnutzungsbeitrag auf+80gCO2e/MJ. Begründe, warum weder „Biokraftstoff immer null“noch ein allgemeiner Gegenbeweis folgt.",
      "taskEn": "Build and interpret the simplified balance and assumption. Then change only land-use contribution to+80gCO2e/MJ. Explain why neither“biofuel is always zero”nor a universal rejection follows.",
      "workedReasoningDe": "Basis20+15+5−71+71=40gCO2e/MJ, Ersparnis55g bzw57,9%gegen95g. Mit Landnutzungsbeitrag120g/MJ,25g mehr als fossil. Aufnahme und Verbrennung bleiben getrennte Flüsse; keine doppelte Gutschrift. Nachbildung, Zeithorizont und Landannahmen tragen das Ergebnis. Wasser, Biodiversität, Nahrungskonkurrenz und Motorwirkungsgrad fehlen. Gleiche Brennstoffenergie ist noch nicht gleiche Transportleistung. Im ausdrücklich normierten Transfer ergibt der Bioethanolpfad48gCO2e pro gleicher Radarbeit statt95g beim fossilen Pfad; mit Landnutzungszuschlag144g. Die Basisersparnis beträgt47/95≈49,47%, nicht57,9%. Alle Werte bleiben Aussagen der erfassten Klimabilanz, keine Mehrkategorien-Ökobilanz.",
      "workedReasoningEn": "Base20+15+5−71+71=40gCO2e/MJ;saving55g≈57.9%against95g. With land change120g/MJ,25g above fossil. Biogenic uptake/combustion remain separate flows,not deleted while adding extra credits. Regrowth/time horizon/land assumptions drive results;water,biodiversity,food competition and engine efficiency are absent. This is a life-cycle climate account on a fuel-energy basis,not automatically equal transport service. In the explicitly normalised transfer, bioethanol produces48gCO2e for the same wheel work versus95g fossil; including the land-use scenario it produces144g. Base saving47/95≈49.47%, not57.9%. These results remain limited to the included climate account, not a multi-impact LCA.",
      "freshIndependentTransferDe": "Für dieselbe Radarbeit braucht der fossile Referenzmotor1,00MJ Brennstoffenergie und der neue Bioethanolmotor1,20MJ. Normiere beide auf diese Dienstleistung und überprüfe den früheren Vergleich.",
      "freshIndependentTransferEn": "For the same wheel work, the fossil reference engine needs1.00MJ fuel energy and the new bioethanol engine1.20MJ. Normalise both to that service and reconsider the earlier comparison.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Einheit und positive/negative Kohlenstoffflüsse erklären.",
          "observableEn": "Declare functional unit and positive/negative carbon flows.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "40/120gegen95g und57,9% nachvollziehbar berechnen.",
          "observableEn": "Transparently balance40/120against95g and57.9%.",

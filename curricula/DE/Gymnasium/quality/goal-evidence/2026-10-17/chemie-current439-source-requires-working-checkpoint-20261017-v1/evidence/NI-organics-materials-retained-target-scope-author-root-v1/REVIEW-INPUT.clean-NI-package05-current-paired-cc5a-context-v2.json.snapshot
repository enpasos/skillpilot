        },
        "variationAxes": [
          {
            "id": "acid-strength",
            "textDe": "Bei gleicher Stoffmenge von starker zu schwacher Säure wechseln und die veränderten Gleichgewichte begründen.",
            "textEn": "Change from strong to weak acid at equal amount and explain the altered equilibria."
          },
          {
            "id": "curve-region",
            "textDe": "Dasselbe Reagenzsystem vor, bei und nach Äquivalenz mit unterschiedlichen Bilanzmodellen behandeln.",
            "textEn": "Use different balance models for the same reagent system before, at and after equivalence."
          },
          {
            "id": "temperature-and-indicator",
            "textDe": "Neutralität bei verändertem pKᵥ und die begrenzte Aussage eines Indikatorbereichs prüfen.",
            "textEn": "Check neutrality at changed pKᵥ and the limited information supplied by an indicator range."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "t05-supplied-acid-curves",
            "taskDemandDe": "Deute T05-C1/C2 an den vollständig gelieferten Tabellen. Ordne Stärke und Spezies zu, unterscheide Halbpunkt, Äquivalenz und Neutralität und begründe geeignete Indikatorkandidaten.",
            "taskDemandEn": "Interpret the complete T05-C1/C2 tables. Classify strength/species, distinguish halfpoint, equivalence and neutrality, and justify indicator candidates.",
            "expectedPerformanceDe": "Starke und schwache Säure haben gleichen formalen Äquivalenzverbrauch, aber unterschiedliche Anfangs-, Puffer- und Salzprotolysebereiche. BTB beziehungsweise Phenolphthalein sind begründete Kandidaten. Ohne Farbkriterium und Auflösung folgt kein exakter Volumenfehler oder Molekülnachweis.",
            "expectedPerformanceEn": "Strong and weak acids have equal formal equivalence consumption but different initial, buffer and salt-protolysis regions. BTB and phenolphthalein are justified candidates. No exact volume error or molecular identity follows without a colour criterion and sufficient resolution.",
            "understandingFocusDe": "Dateninterpretation ohne obligatorische Rechnung charakteristischer pH-Werte.",
            "understandingFocusEn": "Data interpretation without mandatory characteristic-point calculations."
          },
          {
            "id": "base-and-polyprotic-supplied-variation",
            "taskDemandDe": "Deute die fallende T08-C2-Basenkurve mit B/BH+ und vergleiche im bereitgestellten POLY-QUALITATIVE-C1 die ein- und zweistufigen Modellkurven. Begründe vorhandene Pufferregionen und begrenzte Identifikation.",
            "taskDemandEn": "Interpret the falling T08-C2 base curve using B/BH+ and compare the supplied single-stage and two-stage model curves in POLY-QUALITATIVE-C1. Explain existing buffer regions and limited identification.",
            "expectedPerformanceDe": "Schwache Base hinterlässt saures BH+; der Titrant allein macht Äquivalenz nicht neutral. Glycin besitzt hier Stufen um 25 und 50 mL mit wechselnden Paaren; pH um 6 ist zwischen den ausgeprägten Pufferbereichen. Die Daten beweisen keine allgemeine Stoffidentität.",
            "expectedPerformanceEn": "A weak base leaves acidic BH+; titrant strength alone does not establish neutral equivalence. Here glycine has stages near 25 and 50 mL with changing pairs; pH around 6 lies between its main buffer regions. The data establish no unique substance identity.",
            "understandingFocusDe": "Geänderte Richtung und Protonenzahl anhand gegebener Daten; keine polyprotische Zahlenrechnung als Zusatzpflicht.",
            "understandingFocusEn": "Changed curve direction and proton count from supplied data; no added compulsory polyprotic calculation."
          }
        ]
      }
    },
    {
      "goalId": "2f3cdec5-f845-5b0f-841e-8b1d47de0281",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "fat-structure-and-melting",
            "essentialUnderstandingDe": "Physikalische Eigenschaft aus Molekülstruktur erklären, mit kontrollierter Vergleichsbasis.",
            "essentialUnderstandingEn": "Explain a physical property from molecular structure with a controlled comparison basis.",
            "observablePerformanceDe": "Glyceringerüst trägt an drei O-Atomen jeweils –C(=O)–R; drei Estergruppen verbinden genau drei Reste. Ein einzelnes Triacylglycerid ist kein Polyester mit wiederholten Ketteneinheiten. Gerade gesättigte Reste packen regelmäßiger, cis-Doppelbindungen erzeugen Knicke und stören geordnete Packung; entsprechend schmilzt B im Modell niedriger. Vergleich gilt bei ähnlicher Kettenlänge und vergleichbarer Zusammensetzung; natürliche Fette sind Gemische, deren Schmelzbereiche auch Verteilung der Reste und Kristallform beeinflussen.",
            "observablePerformanceEn": "The glycerol backbone has –C(=O)–R attached through each of three O atoms; three ester groups connect exactly three residues. One triacylglycerol is not a polyester chain with repeated units. Straight saturated residues pack more regularly, while cis double bonds create bends and disrupt ordered packing; B therefore melts lower in this model. The comparison holds for similar chain length and comparable composition; natural fats are mixtures whose melting ranges also depend on residue distribution and crystal form."
          },
          {
            "id": "cis-trans-and-solvent-property-transfer",
            "essentialUnderstandingDe": "Geänderte räumliche Konfiguration bei gleicher Ungesättigtheit und geändertes Lösungsmittel liefern echte physikalische Transfers.",
            "essentialUnderstandingEn": "Changed spatial configuration at equal unsaturation and changed solvent provide genuine physical transfers.",
            "observablePerformanceDe": "Bei 20 °C ist C flüssig, D fest. trans-Reste sind räumlich gestreckter und können regelmäßiger packen als die geknickten cis-Reste; gleich viele Doppelbindungen reichen zur Konsistenzprognose nicht. Die langen unpolaren Kohlenwasserstoffreste dominieren den Löslichkeitsvergleich: wenige Estergruppen liefern keine ausreichende Hydratation für gute Wasserlöslichkeit; mit einem unpolaren Medium sind günstige Dispersionskontakte möglich. Fette sind hydrophob und lipophil. Das ist ein kontrolliertes Modell, keine allgemeine Rangfolge für jedes Gemisch oder jede Temperatur und keine Ernährungsbewertung.",
            "observablePerformanceEn": "At 20 °C, C is liquid and D solid. trans residues are more extended and can pack more regularly than bent cis residues; counting double bonds is insufficient to predict consistency. Long nonpolar hydrocarbon residues dominate solubility: a few ester groups do not provide enough hydration for good water solubility, whereas a nonpolar medium allows favourable dispersion contacts. Fats are hydrophobic and lipophilic. This is a controlled model, not a universal ranking for all mixtures or temperatures and not a nutritional assessment."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "fat-structure-and-melting",
            "cis-trans-and-solvent-property-transfer"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "actual-operator-transfer",
            "textDe": "Die vollständig ausgearbeiteten Fälle wechseln die konkret genannten Struktur-, Phasen-, Proben-, Mess- oder Modellbedingungen. Methodenspezifische Quellenpflichten sind keine beliebigen Alternativen. Durchführungsaufgaben erfordern reale Eigenarbeit; synthetische Muster erfüllen sie nicht.",
            "textEn": "Complete worked cases vary the specified structure, phase, sample, measurement or model conditions. Source-specific method duties are not interchangeable alternatives. Execution requires actual own work; synthetic fixtures do not satisfy it."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "fat-structure-and-melting",
            "taskDemandDe": "Konstruiere ein Triacylglycerid aus Glycerin und drei Fettsäureresten, markiere die drei Estergruppen und erkläre, weshalb es kein Polymer ist. Vergleiche Modellfett A mit drei gesättigten C18-Resten und B mit drei cis-einfach ungesättigten C18-Resten. Erkläre die synthetischen Schmelzbereiche A 68–72 °C und B 3–7 °C aus räumlichem Bau und Packung; nenne die Reichweite des Vergleichs.",
            "taskDemandEn": "Construct a triacylglycerol from glycerol and three fatty acid residues, mark its three ester groups and explain why it is not a polymer. Compare model fat A with three saturated C18 residues and B with three cis-monounsaturated C18 residues. Explain synthetic melting ranges A 68–72 °C and B 3–7 °C using spatial structure and packing; state the scope of the comparison.",
            "expectedPerformanceDe": "Glyceringerüst trägt an drei O-Atomen jeweils –C(=O)–R; drei Estergruppen verbinden genau drei Reste. Ein einzelnes Triacylglycerid ist kein Polyester mit wiederholten Ketteneinheiten. Gerade gesättigte Reste packen regelmäßiger, cis-Doppelbindungen erzeugen Knicke und stören geordnete Packung; entsprechend schmilzt B im Modell niedriger. Vergleich gilt bei ähnlicher Kettenlänge und vergleichbarer Zusammensetzung; natürliche Fette sind Gemische, deren Schmelzbereiche auch Verteilung der Reste und Kristallform beeinflussen.",
            "expectedPerformanceEn": "The glycerol backbone has –C(=O)–R attached through each of three O atoms; three ester groups connect exactly three residues. One triacylglycerol is not a polyester chain with repeated units. Straight saturated residues pack more regularly, while cis double bonds create bends and disrupt ordered packing; B therefore melts lower in this model. The comparison holds for similar chain length and comparable composition; natural fats are mixtures whose melting ranges also depend on residue distribution and crystal form.",
            "understandingFocusDe": "Physikalische Eigenschaft aus Molekülstruktur erklären, mit kontrollierter Vergleichsbasis.",
            "understandingFocusEn": "Explain a physical property from molecular structure with a controlled comparison basis."
          },
          {
            "id": "cis-trans-and-solvent-property-transfer",
            "taskDemandDe": "Neue Modellfette C und D haben je drei C18-Reste mit genau einer C=C pro Rest; C besitzt nur cis-, D nur trans-Doppelbindungen. Die synthetischen Schmelzbereiche sind C 3–7 °C, D 38–42 °C. Je 0,10 g in 2,0 mL Lösungsmittel bei 20 °C: mit Wasser bleiben beide als separate Phase, in einem freigegebenen unpolaren Lösemittel lösen sie sich. Erkläre beide Eigenschaftsänderungen strukturbezogen. Beurteile die Behauptung: Gleiche Zahl von Doppelbindungen bedeutet gleiche Konsistenz; Estergruppen machen jedes Fett wasserlöslich.",
            "taskDemandEn": "New model fats C and D each have three C18 residues with one C=C per residue; C contains only cis and D only trans double bonds. Synthetic melting ranges are C 3–7 °C and D 38–42 °C. At 20 °C, 0.10 g in 2.0 mL solvent remains a separate phase in water but dissolves in an approved nonpolar solvent. Explain both property changes structurally. Assess: Equal double-bond counts imply equal consistency; ester groups make every fat water-soluble.",
            "expectedPerformanceDe": "Bei 20 °C ist C flüssig, D fest. trans-Reste sind räumlich gestreckter und können regelmäßiger packen als die geknickten cis-Reste; gleich viele Doppelbindungen reichen zur Konsistenzprognose nicht. Die langen unpolaren Kohlenwasserstoffreste dominieren den Löslichkeitsvergleich: wenige Estergruppen liefern keine ausreichende Hydratation für gute Wasserlöslichkeit; mit einem unpolaren Medium sind günstige Dispersionskontakte möglich. Fette sind hydrophob und lipophil. Das ist ein kontrolliertes Modell, keine allgemeine Rangfolge für jedes Gemisch oder jede Temperatur und keine Ernährungsbewertung.",
            "expectedPerformanceEn": "At 20 °C, C is liquid and D solid. trans residues are more extended and can pack more regularly than bent cis residues; counting double bonds is insufficient to predict consistency. Long nonpolar hydrocarbon residues dominate solubility: a few ester groups do not provide enough hydration for good water solubility, whereas a nonpolar medium allows favourable dispersion contacts. Fats are hydrophobic and lipophilic. This is a controlled model, not a universal ranking for all mixtures or temperatures and not a nutritional assessment.",
            "understandingFocusDe": "Geänderte räumliche Konfiguration bei gleicher Ungesättigtheit und geändertes Lösungsmittel liefern echte physikalische Transfers.",
            "understandingFocusEn": "Changed spatial configuration at equal unsaturation and changed solvent provide genuine physical transfers."
          }
        ]
      }
    },
    {
      "goalId": "326d45bf-9f77-57d5-a054-93e76b034dd5",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "b004t-326d-observed-states-and-identity",
            "essentialUnderstandingDe": "Feste Stoffproben behalten unter Alltagsbedingungen ihre Form, Flüssigkeiten fließen und passen sich der Gefäßform an, Gase verteilen sich im verfügbaren Raum. Beim Schmelzen und Erstarren, bei Übergängen zwischen Flüssigkeit und Gas und bei direkten fest-gasförmigen Übergängen ändert ein benannter Stoff seinen Zustand; die Zustandsänderung allein macht daraus keinen anderen Stoff. Sieden mit Blasenbildung im Flüssigkeitsinneren unterscheidet sich vom Verdunsten an der Oberfläche.",
            "essentialUnderstandingEn": "Solid samples retain their shape under ordinary conditions, liquids flow and take the shape of a container, and gases spread through the available space. Melting and freezing, changes between liquid and gas, and direct solid-gas changes alter the state of an identified substance; a change of state alone does not make it a different substance. Boiling with bubbles throughout the liquid differs from evaporation at its surface.",
            "observablePerformanceDe": "Die lernende Person ordnet vorgegebene Beobachtungen einem festen, flüssigen oder gasförmigen Zustand zu, benennt Ausgangs- und Endzustand samt passendem Übergang und begründet anhand der Stoffangaben, warum beim Übergang derselbe Stoff vorliegt. Bei flüssig zu gasförmig unterscheidet sie Sieden von Verdunsten anhand des Beobachtungsorts.",
            "observablePerformanceEn": "The learner assigns supplied observations to solid, liquid or gaseous states, names initial and final states and the matching transition, and uses material information to justify that the substance remains the same. For liquid-to-gas changes, the learner distinguishes boiling from evaporation by where the change is observed."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b004t-326d-observed-states-and-identity"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "observable-state-properties",
            "textDe": "Beobachtungen zu Form, Fließen und Raumerfüllung ersetzen vorgegebene Zustandsnamen; keine Teilchenerklärung ist nötig.",
            "textEn": "Observations of shape, flow and filling space replace supplied state labels; no particle-level explanation is needed."
          },
          {
            "id": "transition-direction-and-place",
            "textDe": "Richtungen fest-flüssig, flüssig-gasförmig und direkt fest-gasförmig sowie Sieden im Volumen gegenüber Verdunsten an der Oberfläche variieren.",
            "textEn": "Solid-liquid, liquid-gas and direct solid-gas directions vary, as does boiling throughout the liquid versus evaporation at its surface."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "water-observation-sequence",
            "taskDemandDe": "Ohne Bild liegen Beobachtungsnotizen zu reinem Wasser vor. A behält als Eisstück seine eigene Form; nach Erwärmen fließt es und nimmt die Form eines Bechers an; beim Abkühlen wird daraus wieder ein formfestes Stück. Ein dünner Wasserfilm auf einer nicht saugenden Unterlage wird ohne Blasen langsam weniger; die Messnotizen weisen Wasserdampf über ihm nach. Eine andere, offene Wasserprobe bildet beim Erwärmen Blasen im Inneren; über ihr entstehen an einer kühlen Oberfläche Wassertropfen. Ordne die beobachteten Zustände und Übergänge zu, begründe Sieden gegenüber Verdunsten mit dem Ort der Beobachtung und erkläre, welche Angabe die Stoffidentität über die Änderungen hinweg stützt. Es ist eine Datenauswertung, kein Versuch.",
            "taskDemandEn": "Without a diagram, notes describe pure water. A keeps its own shape as a piece of ice; after warming it flows and takes a beaker’s shape; cooling makes it a shape-retaining piece again. A thin water film on a non-absorbent surface slowly diminishes without bubbles, and the supplied readings detect water vapour above it. Another open water sample forms bubbles inside when heated; water droplets form on a cool surface above it. Identify the observed states and transitions, distinguish boiling from evaporation using where each is seen, and explain what information supports the same substance throughout. This is data interpretation, not an experiment.",
            "expectedPerformanceDe": "Das formfeste Eis ist fest, das fließende Wasser flüssig und der nachgewiesene Wasserdampf gasförmig. Eis wird beim Erwärmen zu flüssigem Wasser (Schmelzen), beim Abkühlen wieder fest (Erstarren). Der Film verdunstet an der Oberfläche; die Blasen im Flüssigkeitsinneren zeigen Sieden. Wasserdampf kondensiert an der kühlen Oberfläche zu flüssigen Tropfen. Die Notizen benennen die Probe als reines Wasser und verfolgen sie durch die Zustandswechsel; daraus folgt in diesem Fall dieselbe Stoffidentität, nicht ein neuer Stoff allein aus geänderter Form.",
            "expectedPerformanceEn": "The shape-retaining ice is solid, flowing water is liquid, and the detected water vapour is gaseous. Warming ice produces liquid water by melting; cooling freezes it again. The film evaporates at its surface, while bubbles inside the liquid indicate boiling. Water vapour condenses to liquid droplets on the cool surface. The notes identify and follow one pure water sample through the state changes, supporting the same substance here rather than a new substance from changed form alone.",
            "understandingFocusDe": "Drei Zustände aus beobachtbaren Eigenschaften erkennen, mehrere Richtungen deuten und Sieden/Verdunsten ohne Bild unterscheiden.",
            "understandingFocusEn": "Recognise three states from observable properties, interpret several transition directions and distinguish boiling from evaporation without an image."
          },
          {
            "id": "carbon-dioxide-direct-transition-data",
            "taskDemandDe": "Eine Lehrkraft stellt nur Messnotizen zu einer gekennzeichneten reinen Kohlenstoffdioxidprobe aus fachgerecht belüfteten Beobachtungen bei Normaldruck bereit: Ein formfestes Stück wird kleiner, während sich ein farbloses, als Kohlenstoffdioxid nachgewiesenes Gas darüber ausbreitet; die durchgehende Beobachtung zeigt keine Flüssigkeit. Bei einer späteren Abkühlung desselben Gases an einer ausreichend kalten Oberfläche entsteht direkt ein fester Belag; auch hier zeigt die durchgehende Beobachtung weder Tropfen noch einen Flüssigkeitsfilm. Die bereitgestellte Stoffanalyse weist den Belag ebenfalls als Kohlenstoffdioxid aus. Ordne die Zustände und beide direkten Übergänge zu und begründe mit den Proben- und Analysedaten, weshalb dieselbe Stoffart vor und nach den Übergängen vorliegt. Lernende führen keinen Versuch durch.",
            "taskDemandEn": "A teacher supplies measurement notes only for a labelled pure carbon dioxide sample from appropriately ventilated observations at ordinary pressure: a shape-retaining piece shrinks while a colourless gas identified as carbon dioxide spreads above it; continuous observation shows no liquid. When the same gas is later cooled at a sufficiently cold surface, a solid deposit forms directly; continuous observation again shows neither droplets nor a liquid film. The supplied material analysis also identifies the deposit as carbon dioxide. Identify the states and both direct transitions, and use the sample and analysis information to justify the same substance before and after the changes. Learners do not perform the procedure.",
            "expectedPerformanceDe": "Das formfeste Stück und der Belag sind fest; das sich ausbreitende Gas ist gasförmig. Der direkte Weg fest zu gasförmig heißt Sublimieren, der Rückweg gasförmig zu fest Resublimieren. Die gekennzeichnete reine Ausgangsprobe sowie die Analysen von Gas und Belag weisen Kohlenstoffdioxid aus. Die durchgehenden Beobachtungen schließen in beiden Fällen eine flüssige Zwischenphase aus; die Daten stützen somit Zustandsänderungen derselben Stoffart. Eine allgemeine Reaktionsdiagnose ist nicht gefordert.",
            "expectedPerformanceEn": "The shape-retaining piece and deposit are solid; the spreading gas is gaseous. The direct solid-to-gas change is sublimation, and the reverse gas-to-solid change is deposition. The labelled pure starting sample and the analyses of gas and deposit all identify carbon dioxide. Continuous observations exclude a liquid intermediate in both cases, supporting state changes of the same substance. A general reaction diagnosis is not required.",
            "understandingFocusDe": "Neuer Stoffkontext mit beobachtbarer Zustandszuordnung und direktem Übergang; Stoffidentität wird aus gelieferten Daten begründet.",
            "understandingFocusEn": "A new substance context with state assignment from observations and a direct transition; substance identity is justified from supplied data."
          }
        ]
      }
    },
    {
      "goalId": "3aef6d91-04ff-5ec7-b92e-ccf330d9816a",
      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Tg betrifft kooperative Segmentbeweglichkeit amorpher Anteile; Tm das Schmelzen kristalliner Bereiche.",
            "essentialUnderstandingEn": "Tg concerns cooperative segment mobility in amorphous fractions; Tm concerns melting crystalline regions.",
            "observablePerformanceDe": "Ordnet Übergänge aus Daten und erklärt den Unterschied ohne Gleichsetzung von Tg und Tm.",
            "observablePerformanceEn": "Identifies transitions from data and explains the difference without equating Tg and Tm."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Packung, intermolekulare Kräfte und kovalente Vernetzung beeinflussen thermische und mechanische Reaktionen.",
            "essentialUnderstandingEn": "Packing, intermolecular forces and covalent crosslinks affect thermal and mechanical responses.",
            "observablePerformanceDe": "Erklärt Unterschiede eines amorphen, teilkristallinen und vernetzten Materials.",
            "observablePerformanceEn": "Explains differences between amorphous, semicrystalline and crosslinked materials."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "Nutzungstemperaturen müssen zu Materialzustand, Belastung und Zersetzungsgrenzen passen.",
            "essentialUnderstandingEn": "Service temperatures must match material state, loading and decomposition limits.",
            "observablePerformanceDe": "Überträgt die Zustandsanalyse auf einen neuen Temperaturzyklus mit begründeter Einsatzgrenze.",
            "observablePerformanceEn": "Transfers state analysis to a new temperature cycle with a justified service limit."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",
            "e2",
            "e3"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,

  "evidenceLevelBoundary": "All current record levels/statuses/IDs are retained exactly; scope authorship does not upgrade a technical E0/G0 record or create a new scientific/native vote.",
  "originalNIPrimaryPDF": {
    "path": "/home/enpasos/projects/skillpilot/curricula/DE/Gymnasium/input/NI/upper-secondary/KC-CH_SII_Druck.pdf",
    "sha256": "bd082d15919b9a6cd60d1f92188b1c219043a1941cad915100cc0ad427022e0c",

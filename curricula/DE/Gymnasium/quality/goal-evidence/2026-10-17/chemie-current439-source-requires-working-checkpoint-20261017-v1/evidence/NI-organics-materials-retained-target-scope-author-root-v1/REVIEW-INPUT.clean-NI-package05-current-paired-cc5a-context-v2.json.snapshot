        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Radikale starten eine Kettenreaktion; Wachstum erhält ein aktives Kettenende, Abbruch entfernt es.",
            "essentialUnderstandingEn": "Radicals initiate a chain reaction; growth retains an active chain end while termination removes it.",
            "observablePerformanceDe": "Formuliert Initiatorzerfall, Start, Wachstum und Kombination mit korrekt gesetzten Radikalpunkten.",
            "observablePerformanceEn": "Writes initiator cleavage, initiation, propagation and combination with correctly located radical dots."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Die Vinylgruppe wird zum gesättigten Kettenrückgrat; Substituenten und Atomzahl bleiben erhalten.",
            "essentialUnderstandingEn": "The vinyl group becomes a saturated backbone; substituents and atom counts are retained.",
            "observablePerformanceDe": "Leitet verschiedene Repetiereinheiten aus vollständigen Monomerformeln ab.",
            "observablePerformanceEn": "Derives different repeat units from complete monomer formulae."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "Reaktionssteuerung wirkt auf aktive Zentren und Nebenreaktionen; der Mechanismus ist keine Durchführungsvorschrift.",
            "essentialUnderstandingEn": "Reaction control affects active centres and side reactions; a mechanism is not an experimental procedure.",
            "observablePerformanceDe": "Überträgt den Mechanismus auf ein anderes Vinylmonomer und begründet ein gegebenes Inhibitorverhalten.",
            "observablePerformanceEn": "Transfers the mechanism to another vinyl monomer and explains supplied inhibitor behaviour."
          }

      "actualOriginalPDF": {
        "path": "/home/enpasos/projects/skillpilot/curricula/DE/Gymnasium/input/SL/Chemie_GOS_Leistungskurs_2023_ab_2027_red_2025.pdf",
        "sha256": "b9d890032c2a6b2d6bf631f5e501d46ef82c8e0274864f28cec8d3ec78327dcb",

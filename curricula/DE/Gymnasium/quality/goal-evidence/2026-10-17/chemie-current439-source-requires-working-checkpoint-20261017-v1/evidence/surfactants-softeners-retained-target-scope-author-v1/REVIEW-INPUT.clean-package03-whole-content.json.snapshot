          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "specific-material-variation",
            "textDe": "Na/Cl gegenüber Mg/O; Elektronenzahl, Kernladung und vollständige Außenschale.",
            "textEn": "Na/Cl versus Mg/O; electron number, nuclear charge and a complete outer shell."
          },
          {
            "id": "specific-model-limit",
            "textDe": "Die Edelgasregel liefert hier einen plausiblen Ionenfall, keine universelle Vorhersage aller Übergangsmetall-Ionen oder Reaktionsenergien.",
            "textEn": "Here the noble-gas rule supplies a plausible ion case, not a universal prediction of transition-metal ions or reaction energies."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-next25-a1632ea9-case-1",
            "taskDemandDe": "Na:11 Protonen, Elektronen2|8|1; Cl:17 Protonen,2|8|7. Gegeben sind Na→Na++e− und Cl+e−→Cl− als Teilgleichungen. Leite für beide Ionen Elektronenzahl, Schalenbelegung und Ladung her und erkläre Kation/Anion mit der Edelgasregel.",
            "taskDemandEn": "Na:11 protons, electrons2|8|1; Cl:17 protons,2|8|7. Na→Na++e− and Cl+e−→Cl− are supplied half-equations. Derive each ion’s electron number, shell occupancy and charge; explain cation/anion using the noble-gas rule.",
            "expectedPerformanceDe": "Na+ besitzt11 Protonen/10 Elektronen,2|8 wie Ne; Cl−17/18,2|8|8 wie Ar. Kern und Element bleiben erhalten. Die unterschiedlichen Ladungsvorzeichen folgen dem Protonen-Elektronen-Unterschied.",
            "expectedPerformanceEn": "Na+ has11 protons/10 electrons,2|8 like Ne; Cl−17/18,2|8|8 like Ar. Nucleus and element remain unchanged. Charge signs follow the proton–electron difference.",
            "understandingFocusDe": "Elektronenverlust macht Natrium nicht zum Element Neon; gleiche Elektronenkonfiguration ist nicht gleiche Kernladung.",
            "understandingFocusEn": "Electron loss does not turn sodium into neon; identical electron configuration does not mean identical nuclear charge."
          },
          {
            "id": "chem-next25-a1632ea9-case-2",
            "taskDemandDe": "Frischer Hauptgruppenfall: Mg12 Protonen,2|8|2; O8 Protonen,2|6. Nur einfache Atom-Ionen im schulischen Edelgasmodell werden betrachtet. Formuliere Elektronenabgabe/-aufnahme und erkläre, warum Mg2+ und O2− jeweils10 Elektronen haben, obwohl ihre Ladung verschieden ist.",
            "taskDemandEn": "Fresh main-group case: Mg12 protons,2|8|2; O8 protons,2|6. Only simple atomic ions in the school noble-gas model are considered. Write electron loss/gain and explain why Mg2+ and O2− each have10 electrons despite different charges.",
            "expectedPerformanceDe": "Mg→Mg2++2e−; O+2e−→O2−. Beide2|8, jedoch12 bzw.8 Protonen. Die Person bilanziert Atome, Elektronen und Ladung und benennt die Hauptgruppen-Grenze.",
            "expectedPerformanceEn": "Mg→Mg2++2e−; O+2e−→O2−. Both2|8, but12 versus8 protons. The learner balances atoms, electrons and charge and states the main-group limit.",
            "understandingFocusDe": "Die Edelgasregel liefert hier einen plausiblen Ionenfall, keine universelle Vorhersage aller Übergangsmetall-Ionen oder Reaktionsenergien.",
            "understandingFocusEn": "Here the noble-gas rule supplies a plausible ion case, not a universal prediction of transition-metal ions or reaction energies."
          }
        ]
      }
    },
    {
      "goalId": "a78aacf9-92ea-5627-8776-a595111f754c",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Builder,Enzyme,Bleichsysteme und Hilfsstoffe haben verschiedene Funktionen.",
            "essentialUnderstandingEn": "Builders,enzymes,bleach and auxiliaries have distinct functions.",
            "observablePerformanceDe": "energy20-11-a: Vier Stoffgruppen anhand konkreter Wirkprinzipien zuordnen. energy20-11-b: Faser-/Fleckchemie mit passender oder fehlender Komponente verbinden.",
            "observablePerformanceEn": "energy20-11-a: Assign four ingredient groups using concrete mechanisms. energy20-11-b: Connect fibre/stain chemistry with present/absent ingredients."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Substrat- und Materialchemie bestimmen Eignung einzelner Komponenten.",
            "essentialUnderstandingEn": "Substrate/material chemistry determine ingredient suitability.",
            "observablePerformanceDe": "energy20-11-a: Hydrolyse, Oxidation, Ionenaustausch und Fluoreszenz unterscheiden. energy20-11-b: Builder, Enzym und Bleichsystem nicht als austauschbar behandeln.",
            "observablePerformanceEn": "energy20-11-a: Distinguish hydrolysis,oxidation,ion exchange and fluorescence. energy20-11-b: Do not treat builder,enzyme and bleach as interchangeable."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "Kontrollen und Sicherheitsregeln begrenzen Rezeptur- und Leistungsbehauptungen.",
            "essentialUnderstandingEn": "Controls/safety rules constrain formulation/performance claims.",
            "observablePerformanceDe": "energy20-11-a: Kontrolllogik und Substratspezifität statt Universalwirkung nutzen. energy20-11-b: Sicherheitsgrenze und fehlende reale Produktprüfung ausdrücklich benennen.",
            "observablePerformanceEn": "energy20-11-a: Use control logic and substrate specificity,not universal-effect claims. energy20-11-b: Explicitly state safety limits and absence of actual product approval."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",
            "e2",
            "e3"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "energy20-11-a-transfer",
            "textDe": "Ein Fettfleck ersetzt den Eiweißfleck. Wähle aus Protease/Lipase die chemisch passende Ergänzung und erkläre, warum der Aufheller kein Ersatz dafür ist.",
            "textEn": "Replace protein with a fat stain. Choose protease or lipase on chemical grounds and explain why brightener cannot replace it."
          },
          {
            "id": "energy20-11-b-transfer",
            "textDe": "Eine neue Baumwollprobe trägt einen empfindlichen Farbstoff. Revidiere die Auswahl anhand Bleich- und Enzymfunktion, ohne den Fasernamen allein entscheiden zu lassen.",
            "textEn": "A new cotton sample carries a sensitive dye. Reconsider using bleach/enzyme functions rather than fibre name alone."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "energy20-11-a",
            "taskDemandDe": "Ganzes eigenes Material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy20-four-defects-targeted-material-author-successor-20261015-v1/materials/forty-two-whole-DE-EN-cases.four-defects-successor.author.json #energy20-11-a,sha256:5762a8f53db8ff2a6f44f98f1495959132bc04541e0af85c0088ace5e9da21fe. Erkläre die unterschiedlichen Funktionen aller vier Stoffgruppen und ordne jede Kontrollbeobachtung zu. Unterscheide chemische Fleckveränderung, enzymatische Hydrolyse, Enthärtung und optische Weißwirkung. Erkläre, weshalb eine größere Enzymmasse nicht automatisch jede Fleckart besser entfernt.",
            "taskDemandEn": "Whole own material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy20-four-defects-targeted-material-author-successor-20261015-v1/materials/forty-two-whole-DE-EN-cases.four-defects-successor.author.json #energy20-11-a,sha256:5762a8f53db8ff2a6f44f98f1495959132bc04541e0af85c0088ace5e9da21fe. Explain the four ingredient-group functions and assign each controlled observation. Distinguish chemical stain change,enzymatic hydrolysis,softening and optical whiteness. Explain why more enzyme does not automatically remove every stain better.",
            "expectedPerformanceDe": "Builder senkt freie Härteionenkonzentration; Tenside unterstützen Benetzung/Dispergierung. Protease katalysiert Peptidbindungsspaltung, nicht beliebige Farbstoffoxidation. Percarbonat liefert unter den Modellbedingungen ein oxidierendes Peroxidsystem; TAED unterstützt wirksame Bleichspezies bei niedrigerer Temperatur. Optischer Aufheller absorbiertUV und emittiert sichtbares Licht, entfernt dadurch keine Schmutzmasse. Kontrollen ändern jeweils nur eine Gruppe; Wechselwirkungen und genaue Rezepturleistung sind durch diese Daten nicht vollständig bestimmt.",
            "expectedPerformanceEn": "Builder reduces free hardness ions;surfactants support wetting/dispersion. Protease catalyses peptide-bond hydrolysis,not arbitrary dye oxidation. Percarbonate supplies an oxidising peroxide system here;TAED assists active bleach species at lower temperature. Optical brightener absorbsUV and emits visible light without removing dirt mass. Controls change one group each;these data do not fully establish interactions or recipe performance.",
            "understandingFocusDe": "Ein Fettfleck ersetzt den Eiweißfleck. Wähle aus Protease/Lipase die chemisch passende Ergänzung und erkläre, warum der Aufheller kein Ersatz dafür ist.",
            "understandingFocusEn": "Replace protein with a fat stain. Choose protease or lipase on chemical grounds and explain why brightener cannot replace it."
          },
          {
            "id": "energy20-11-b",
            "taskDemandDe": "Ganzes eigenes Material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy20-four-defects-targeted-material-author-successor-20261015-v1/materials/forty-two-whole-DE-EN-cases.four-defects-successor.author.json #energy20-11-b,sha256:5762a8f53db8ff2a6f44f98f1495959132bc04541e0af85c0088ace5e9da21fe. Begründe die Auswahl für Wolle und weiße Baumwolle aus Funktion und Material, nicht aus „stärker/schwächer“. Erkläre die Funktionen fehlender/enthaltener Komponenten und warum Bleichsysteme nicht austauschbar sind. Weise die gefährliche Säuremischung ausdrücklich zurück und benenne die Grenze der Modellkarten.",
            "taskDemandEn": "Whole own material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy20-four-defects-targeted-material-author-successor-20261015-v1/materials/forty-two-whole-DE-EN-cases.four-defects-successor.author.json #energy20-11-b,sha256:5762a8f53db8ff2a6f44f98f1495959132bc04541e0af85c0088ace5e9da21fe. Justify choices for wool and white cotton using functions/materials,not“stronger/weaker”. Explain present/absent ingredients and why bleaches are not interchangeable. Reject acid mixing explicitly and state the cards’ limitations.",
            "expectedPerformanceDe": "Protease kann auch Proteinfasern angreifen; ihr Ausschluss beiW ist materialbezogen. V kann passende Flecken auf dafür geeigneter Baumwolle enzymatisch/oxidativ bearbeiten; Farb- und Pflegehinweise bleiben maßgeblich. Hypochlorit ist ein anderes Oxidationssystem; Ansäuern kann giftiges Chlorgas freisetzen und ist keine sinnvolle Aktivierung. Builder behebt Härteeffekte, ersetzt weder Enzym noch Bleichmittel. Fiktive Inhaltsangaben erlauben eine Funktionsentscheidung, keine reale Produktfreigabe oder sichere Mischanleitung.",
            "expectedPerformanceEn": "Protease can attack protein fibres;its omission inW is material-specific. V can address suitable stains on compatible cotton enzymatically/oxidatively;colour/care instructions remain binding. Hypochlorite is a different oxidant;acidification can release toxic chlorine and is not useful activation. Builder addresses hardness,not enzyme/bleach functions. Fictional ingredient cards support functional reasoning,not actual product approval or mixing instructions.",
            "understandingFocusDe": "Eine neue Baumwollprobe trägt einen empfindlichen Farbstoff. Revidiere die Auswahl anhand Bleich- und Enzymfunktion, ohne den Fasernamen allein entscheiden zu lassen.",
            "understandingFocusEn": "A new cotton sample carries a sensitive dye. Reconsider using bleach/enzyme functions rather than fibre name alone."
          }
        ]
      }
    },
    {
      "goalId": "cc5a626a-dc85-57e2-b422-259f92901545",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "degradation-understanding-1",
            "essentialUnderstandingDe": "Funktionelle Gruppen bestimmen mögliche Hydrolyse-, Oxidations- und Kettenverkürzungswege.",
            "essentialUnderstandingEn": "Functional groups determine possible hydrolysis, oxidation and chain-shortening pathways.",
            "observablePerformanceDe": "Beschreibe Hydrolyse, endständige Oxidation undβ-Oxidation mit C-Erhalt und Produktklassen. Beurteilt80%Verschwinden die Mineralisierung? Nenne weitere Messungen;  Erwartet:Hydrolyse spaltet unter Wasserverbrauch die Esterbindung. Alkohol→Aldehyd→Säure erhält zunächst12C. Nach Aktivierung entstehen ideal aus einer gesättigtenC12-Kette sechs Acetyl-Einheiten über fünf Verkürzungszyklen. Das ist noch kein vollständigerCO2-Nachweis. Ausgangsstoffentfernung kann Zwischenprodukte, Sorption oder Biomasse einschließen. Benötigt werden C-Bilanz, Produkte und aquatische Wirkungen; Stoff und Bedingungen bestimmen den Weg.",
            "observablePerformanceEn": "Describe hydrolysis, terminal-group oxidation and beta oxidation for the model, tracking carbon/product class. Assess whether80%disappearance proves mineralisation. Specify a genuine further measurement; Expected:Ester hydrolysis consumes water and cleaves the ester link; C12 alcohol oxidises throughC12 aldehyde toC12 acid without immediate carbon cleavage. After activation, beta-oxidation cycles removeC2 units; an ideal saturatedC12 chain yields six acetyl units after five shortening cycles. This is not itself completeCO2 measurement.80%primary disappearance can include intermediates, sorption/biomass;30%CO2 does not show full mineralisation. Carbon balance, degradates and aquatic effects are needed; pathways depend on substance/conditions."
          },
          {
            "id": "degradation-understanding-2",
            "essentialUnderstandingDe": "Primärabbau, Phasenverteilung, Zwischenprodukte und Mineralisierung sind verschiedene Stoffbilanzaussagen.",
            "essentialUnderstandingEn": "Primary degradation, partitioning, intermediates and mineralisation are different material-balance claims.",
            "observablePerformanceDe": "Beschreibe den Pfad gegenüber18b und beurteile „90%abbaubar = umweltverträglich“. Welche Messungen/Bedingungen fehlen für eine belastbarere Aussage? Erwartet: Ethoxyverkürzung ist Primärabbau,10%CO2-C keine weitgehende Mineralisierung. Problematische Produkte widerlegen die Ableitung aus Ausgangsstoffentfernung allein. Der aromatische Alkylphenolkern unterscheidet den Stoff vom linearen C12-Alkohol; eine bestimmte Alkylverzweigung ist nicht gegeben; identischeβ-Oxidation ist nicht belegt. C-Verbleib, zeitliche Produktkonzentration, O2, Temperatur, Inokulum undaquatische Wirkung sind erforderlich. Die fiktive Karte ist keine reale Produktfreigabe.",
            "observablePerformanceEn": "Describe the supplied pathway and compare with the linear-alcohol route18b. Critique“90%degradable means environmentally safe”. What measurements/conditions support a stronger inference? Expected: Ethoxy-chain shortening is primary degradation;10%CO2-carbon does not show extensive mineralisation. Detected problematic products defeat an inference from parent disappearance alone. The aromatic alkylphenol core differs from a linear C12 alcohol; no particular alkyl branching is supplied; identical beta oxidation cannot be claimed without structural evidence. Need carbon fate, time-resolved product concentrations, oxygen/temperature/inoculum and aquatic-effects context; The fictional card grants no real product approval."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "degradation-understanding-1",
            "degradation-understanding-2"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "changed-composition-or-condition",
            "textDe": "Geänderte Stoff-/Struktur- oder Einsatzbedingungen selbst deuten.",
            "textEn": "Independently interpret changed composition, structure or operating conditions."
          },
          {
            "id": "genuine-new-transfer",
            "textDe": "Begründung an frischer Variation und tatsächlicher Aussagegrenze prüfen.",
            "textEn": "Test reasoning on fresh variation and actual inference limits."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "energy20-18-b-split-current",
            "taskDemandDe": "Eigenes Stoffmodell: Ein Tensidester hydrolysiert zu langkettiger Hydroxykomponente und Carbonsäurekomponente. Ein freigesetzter linearerC12-Alkohol CH3−(CH2)10−CH2OH oxidiert zuC12-Aldehyd undC12-Säure.β-Oxidation aktivierter Fettsäuren entfernt jeweils2C. Fremddaten:80%Ausgangstensid verschwunden nach7Tagen, aber nur30%des organischenC alsCO2; Rest unbekannt. Beschreibe Hydrolyse, endständige Oxidation undβ-Oxidation mit C-Erhalt und Produktklassen. Beurteilt80%Verschwinden die Mineralisierung? Nenne weitere Messungen;  Frischer Transfer:Ein verzweigter Alkylrest ersetzt die lineare Kette. Warum dürfen Weg und Geschwindigkeit nicht ohne neue Daten übertragen werden?",
            "taskDemandEn": "Own model:an ester-containing surfactant first hydrolyses to a long-chain hydroxy component and a carboxylic-acid component. A released linearC12 alcohol CH3−(CH2)10−CH2OH can oxidise to aldehyde thenC12 acid; beta oxidation shortens activated fatty-acid chains by2C per cycle. Supplied data:80%parent disappearance by7days, but only30%organic carbon detected asCO2; remaining distribution unknown. Describe hydrolysis, terminal-group oxidation and beta oxidation for the model, tracking carbon/product class. Assess whether80%disappearance proves mineralisation. Specify a genuine further measurement; Freshtransfer:A branched tail replaces the linear chain. Explain why identical pathway/rate cannot be transferred without evidence.",
            "expectedPerformanceDe": "Hydrolyse spaltet unter Wasserverbrauch die Esterbindung. Alkohol→Aldehyd→Säure erhält zunächst12C. Nach Aktivierung entstehen ideal aus einer gesättigtenC12-Kette sechs Acetyl-Einheiten über fünf Verkürzungszyklen. Das ist noch kein vollständigerCO2-Nachweis. Ausgangsstoffentfernung kann Zwischenprodukte, Sorption oder Biomasse einschließen. Benötigt werden C-Bilanz, Produkte und aquatische Wirkungen; Stoff und Bedingungen bestimmen den Weg. Transfer:Die Verzweigung verändert die Zugänglichkeit und mögliche enzymatische Umsetzung. Aus dem linearen C12-Modell folgen weder identischer β-Oxidationsweg noch gleiche Geschwindigkeit oder vollständige Mineralisierung; passende Zwischenprodukt-/Kohlenstoffdaten sind erforderlich.",
            "expectedPerformanceEn": "Ester hydrolysis consumes water and cleaves the ester link; C12 alcohol oxidises throughC12 aldehyde toC12 acid without immediate carbon cleavage. After activation, beta-oxidation cycles removeC2 units; an ideal saturatedC12 chain yields six acetyl units after five shortening cycles. This is not itself completeCO2 measurement.80%primary disappearance can include intermediates, sorption/biomass;30%CO2 does not show full mineralisation. Carbon balance, degradates and aquatic effects are needed; pathways depend on substance/conditions. Transfer:Branching changes accessibility and possible enzymatic processing. The linear C12 model establishes neither an identical beta-oxidation route nor equal rate or full mineralisation; suitable intermediate/carbon data are required.",
            "understandingFocusDe": "Ein ganzes vorgeschlagenes Kindziel, wahre prospektive Evidenz und unabhängiger Transfer; keine menschliche oder praktische Freigabe.",
            "understandingFocusEn": "One whole proposed child, true prospective evidence and independent transfer; no human or practical approval."
          },
          {
            "id": "energy20-18-d-split-current",
            "taskDemandDe": "Fiktiver Alkylphenolethoxylat-Pfad: langer Ethoxykopf→kürzere Homologe→Alkylphenol. Gefahrenkarte: problematische langsam abbaubare Zwischenprodukte. Tag10:90%Ausgangsstoffentfernung,10%CO2-C, Zwischenprodukte nachgewiesen. Die Gefahrenkarte ist ausdrücklich ein fiktiver Aufgabenbestandteil und kein tatsächlich gesichteter Behördenartikel. Beschreibe den Pfad gegenüber18b und beurteile „90%abbaubar = umweltverträglich“. Welche Messungen/Bedingungen fehlen für eine belastbarere Aussage? Frischer Transfer: Nach weiteren 20 Tagen sorbiert das Alkylphenol an Schlamm, CO2-C bleibt niedrig. Warum müssen Phasenverteilung und chemischer Abbau getrennt gemessen werden?",
            "taskDemandEn": "Fictional alkylphenol-ethoxylate pathway:longethoxy parent→shorterethoxy homologues→alkylphenol; the supplied hazard card identifies problematic, more slowly degrading aquatic intermediates. Day10:90%parent removal,10%CO2-carbon and detected intermediates. The hazard card is explicitly fictional teaching material, not an actually inspected agency article. Describe the supplied pathway and compare with the linear-alcohol route18b. Critique“90%degradable means environmentally safe”. What measurements/conditions support a stronger inference? Fresh transfer: After 20 more days alkylphenol disappears from water by sorption to sludge while CO2-carbon stays low. Explain why partitioning and chemical degradation need separate measurements.",
            "expectedPerformanceDe": "Ethoxyverkürzung ist Primärabbau,10%CO2-C keine weitgehende Mineralisierung. Problematische Produkte widerlegen die Ableitung aus Ausgangsstoffentfernung allein. Der aromatische Alkylphenolkern unterscheidet den Stoff vom linearen C12-Alkohol; eine bestimmte Alkylverzweigung ist nicht gegeben; identischeβ-Oxidation ist nicht belegt. C-Verbleib, zeitliche Produktkonzentration, O2, Temperatur, Inokulum undaquatische Wirkung sind erforderlich. Die fiktive Karte ist keine reale Produktfreigabe. Transfer: Sorption verlagert den Stoff in die Schlammphase und zerstört seine Moleküle nicht. Nötig sind phasenübergreifende Stoff-/C-Bilanz und Abbauprodukt-/CO2-Daten; allein der Rückgang in Wasser beweist keinen chemischen Abbau oder geringe Wirkung.",
            "expectedPerformanceEn": "Ethoxy-chain shortening is primary degradation;10%CO2-carbon does not show extensive mineralisation. Detected problematic products defeat an inference from parent disappearance alone. The aromatic alkylphenol core differs from a linear C12 alcohol; no particular alkyl branching is supplied; identical beta oxidation cannot be claimed without structural evidence. Need carbon fate, time-resolved product concentrations, oxygen/temperature/inoculum and aquatic-effects context; The fictional card grants no real product approval. Transfer: Sorption transfers the substance into sludge without destroying its molecules. A cross-phase substance/carbon balance plus degradate/CO2 data is needed; disappearance from water alone proves neither chemical degradation nor low effects.",
            "understandingFocusDe": "Ein ganzes vorgeschlagenes Kindziel, wahre prospektive Evidenz und unabhängiger Transfer; keine menschliche oder praktische Freigabe.",
            "understandingFocusEn": "One whole proposed child, true prospective evidence and independent transfer; no human or practical approval."
          }
        ]
      }
    },
    {
      "goalId": "d465d82b-4bf2-5527-bb7c-dad5a92605fe",
      "wholeProfile": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Die Ladung am amphiphilen Kopf bestimmt die Tensidklasse,nicht das Gegenion.",
            "essentialUnderstandingEn": "Charge on the amphiphilic head determines class,not the counterion.",
            "observablePerformanceDe": "In6a und6b leitet sie anionische, kationische und nichtionische Klassen aus Kopfgruppen ab; bei einem zusätzlichen protonierbaren Amin nutzt sie die vorgegebenen pH-Daten statt eine permanente Ladung anzunehmen.",
            "observablePerformanceEn": "In6a and6b the learner derives anionic, cationic and nonionic classes from head groups; for an additional protonatable amine, supplied pH data prevent assuming permanent charge."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Ein ungeladener polarer Tensidkopf kann durch OH- oder Ethergruppen mit Wasser wechselwirken; formale Kopfladung und Gesamtneutralität des Salzes sind unterschiedliche Aussagen.",
            "essentialUnderstandingEn": "An uncharged polar surfactant head can interact with water through OH or ether groups; formal head charge differs from overall salt neutrality.",
            "observablePerformanceDe": "In6a und6b markiert die lernende Person Kopf, Kette und Gegenion, erklärt die Hydratation eines Ethoxylat- oder Glucosidkopfs und begründet die drei kanonischen Tensidklassen.",
            "observablePerformanceEn": "In6a and6b the learner identifies head, tail and counterion, explains hydration of an ethoxylate or glucoside head, and justifies the three canonical surfactant classes."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "pH und Mischbedingungen begrenzen ausStruktur abgeleitete Aussagen.",
            "essentialUnderstandingEn": "pH/mixing conditions limit structural inferences.",
            "observablePerformanceDe": "In6a und6b unterscheidet sie einen Gegenionenaustausch von einer pH-bedingten Kopfladungsänderung und benennt fehlende Daten für quantitative Löslichkeits- oder Leistungsbehauptungen.",
            "observablePerformanceEn": "In6a and6b the learner distinguishes counterion substitution from a pH-dependent change in head charge and identifies missing data for quantitative solubility or performance claims."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",
            "e2",
            "e3"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "energy20-06-a-transfer",
            "textDe": "Entferne eine Ethoxyeinheit ausC und ersetze Na+ inA durchK+. Welche Klasse bleibt, welche quantitative Eigenschaft ist ohne Daten offen?",
            "textEn": "Remove one ethoxy unit fromC and replaceNa+ byK+ inA. Decide which class remains and which quantitative properties cannot follow from structure alone."
          },
          {
            "id": "energy20-06-b-transfer",
            "textDe": "Ersetze den Glucosidkopf von L durch eine angegebene ungeladene Ethoxykette und ersetze Na+ in K durch K+. Begründe, welche Zuordnungen bleiben und welche quantitative Löslichkeits- oder Leistungsangabe neue Stoffdaten benötigt.",
            "textEn": "Replace the glucoside head of L with a specified uncharged ethoxy chain and change Na+ to K+ in K. Justify which classifications remain and which quantitative solubility or performance claims require new substance data."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "energy20-06-a",
            "taskDemandDe": "Ganzes eigenes Material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json #energy20-06-a. OrdneA/B/C begründet als anionisch, kationisch oder nichtionisch zu. Markiere Kopf, Schwanz und Gegenion. Erkläre die Wechselwirkung vonC mit Wasser und warumD kein Tensid ist. Sage eine mögliche Folge einerA/B-Mischung voraus, ohne alle Mischungen als unlöslich zu behandeln.",
            "taskDemandEn": "Whole own material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json #energy20-06-a. ClassifyA/B/C as anionic/cationic/nonionic,mark heads/tails/counterions. Explain water interaction of unchargedC and whyD is not a surfactant. Predict a plausible consequence of combiningA/B heads without claiming all mixtures precipitate.",
            "expectedPerformanceDe": "A trägt den negativen Sulfatester-Kopf, Na+ist Gegenion; B den positiven quartären Ammoniumkopf mit Br−. C hat eine polare sauerstoffreiche Ethoxyregion ohne formale Ladung. Neutralität des gesamten Salzes ändert die Kopfklasse nicht. NaCl fehlt der lipophile Schwanz. Entgegengesetzte Köpfe können abhängig von Konzentration/Zusammensetzung Ionenpaare oder schwerlösliche Komplexe bilden. Die Klasse beweist keine bestimmte Waschleistung.",
            "expectedPerformanceEn": "A has a negative sulfate-ester head,Na+ is its counterion;B a positive quaternary ammonium head withBr−;C’s oxygen-rich ethoxy region is polar and interacts with water. Neutrality of the entire salt does not change head classification. NaCl lacks a lipophilic tail. Opposite heads can form ion pairs/poorly soluble complexes depending on composition/concentration. Classification does not prove identical cleaning performance.",
            "understandingFocusDe": "Entferne eine Ethoxyeinheit ausC und ersetze Na+ inA durchK+. Welche Klasse bleibt, welche quantitative Eigenschaft ist ohne Daten offen?",
            "understandingFocusEn": "Remove one ethoxy unit fromC and replaceNa+ byK+ inA. Decide which class remains and which quantitative properties cannot follow from structure alone."
          },
          {
            "id": "energy20-06-b",
            "taskDemandDe": "Ganzes eigenes Material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json #energy20-06-b. Charakterisiere K, G und L aus dem Aufbau als anionisch, kationisch oder nichtionisch. Markiere jeweils Kopf, Kette und gegebenenfalls Gegenion und begründe, wie die Kopfregion mit Wasser wechselwirkt. Erkläre am zusätzlichen Amin, warum die pH-Angabe eine Klassifizierung beeinflussen kann, ein quartärer Ammoniumkopf aber nicht auf dieselbe Weise protoniert wird.",
            "taskDemandEn": "Whole own material curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy-eleven-kept-current422-positive-and-atomic-informed-20261015-v1/materials/eleven-whole-cases22.targeted-informed-successor.json #energy20-06-b. Characterise K, G and L as anionic, cationic or nonionic from their structures. Mark head, tail and any counterion, and justify how each head interacts with water. Use the additional amine to explain why pH can affect classification, while a quaternary ammonium head is not protonated in the same way.",
            "expectedPerformanceDe": "K trägt eine negativ geladene Sulfonatgruppe mit Na+ als Gegenion; G trägt den positiven quartären Ammoniumkopf mit Cl−. L besitzt einen ungeladenen OH-reichen polaren Kopf, der Wasserstoffbrücken mit Wasser bilden kann. Die unpolare Kette vermittelt Wechselwirkung mit unpolaren Stoffen. Gesamtneutralität der Salze ändert die Kopfladung nicht. E kann durch Protonierung kationisch werden; ohne pH-/Stoffdaten ist es nicht als permanent kationisch einzuordnen. Die drei Zuordnungen enthalten keinen Beweis gleicher Waschleistung oder Umweltverträglichkeit.",
            "expectedPerformanceEn": "K has a negatively charged sulfonate head with Na+ as counterion; G has a positive quaternary ammonium head with Cl−. L has an uncharged OH-rich polar head that can hydrogen-bond with water. The nonpolar tail interacts with nonpolar substances. Overall salt neutrality does not remove head charge. E can become cationic through protonation; without pH/substance data it cannot be treated as permanently cationic. Classification does not establish equal cleaning performance or environmental safety.",
            "understandingFocusDe": "Ersetze den Glucosidkopf von L durch eine angegebene ungeladene Ethoxykette und ersetze Na+ in K durch K+. Begründe, welche Zuordnungen bleiben und welche quantitative Löslichkeits- oder Leistungsangabe neue Stoffdaten benötigt.",
            "understandingFocusEn": "Replace the glucoside head of L with a specified uncharged ethoxy chain and change Na+ to K+ in K. Justify which classifications remain and which quantitative solubility or performance claims require new substance data."
          }
        ]
      }
    },
    {
      "goalId": "dd58c029-176f-5d99-923e-1c1fda6cf58e",
      "wholeProfile": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "structure-model-reasoning",
            "essentialUnderstandingDe": "Eine eindeutige Benennung und die Strukturformel legen die Kohlenstoffverknüpfung fest; die Summenformel gibt nur Atomarten und Atomzahlen an, nicht die Konnektivität. Homologe einer Reihe unterscheiden sich um CH2; Konstitutionsisomere haben dieselbe Summenformel bei verschiedener Verknüpfung.",
            "essentialUnderstandingEn": "An unambiguous name and the structural formula specify carbon connectivity; the molecular formula gives only atom types and atom counts, not connectivity. Homologues within a series differ by CH2; constitutional isomers have the same molecular formula with different connectivity.",
            "observablePerformanceDe": "Benennung und eigene Struktur-/Skelettdarstellung stimmen in Valenzen und Mehrfachbindungen überein; die Person begründet Reihe und Isomerie aus der Struktur.",
            "observablePerformanceEn": "Naming and independently drawn structural/skeletal representations agree in valence and multiple bonds; the learner justifies the series and isomerism using connectivity."
          },
          {
            "id": "fresh-application-and-boundary",
            "essentialUnderstandingDe": "Gleiche Summenformel genügt nicht für identische Konnektivität; Einfach-, Doppel- und Dreifachbindung dürfen nicht aus einer bloßen Zickzackform geraten werden.",
            "essentialUnderstandingEn": "The same molecular formula does not establish identical connectivity; single, double and triple bonds cannot be guessed from a zigzag alone.",
            "observablePerformanceDe": "Pentan und 2-Methylbutan sind C5H12-Konstitutionsisomere. Pentan ist das nächste Homologe von Butan; Pent-1-en das nächste Homologe von But-1-en. Eigene Zeichnungen müssen die zusätzliche CH2-Einheit und erhaltene Bindungsordnung zeigen. Eine bloße andere Zeichenrichtung derselben Kette erzeugt kein weiteres Konstitutionsisomer.",
            "observablePerformanceEn": "Pentane and 2-methylbutane are C5H12 constitutional isomers. Pentane is the next homologue of butane; pent-1-ene the next homologue of but-1-ene. Independent drawings show the extra CH2 unit and retained bond order. Merely drawing the same chain in another direction does not create another constitutional isomer."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "structure-model-reasoning",
            "fresh-application-and-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "material-variation",
            "textDe": "Unverzweigte und verzweigte C4/C5-Strukturen, Lage und Ordnung der Mehrfachbindung.",
            "textEn": "Linear and branched C4/C5 structures, position and order of multiple bonds."
          },
          {
            "id": "counterexample",
            "textDe": "Gleiche Summenformel genügt nicht für identische Konnektivität; Einfach-, Doppel- und Dreifachbindung dürfen nicht aus einer bloßen Zickzackform geraten werden.",
            "textEn": "The same molecular formula does not establish identical connectivity; single, double and triple bonds cannot be guessed from a zigzag alone."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-current15-dd58c029-case-1",
            "taskDemandDe": "Vier vollständige Strukturangaben: CH3-CH2-CH2-CH3; CH3-CH(CH3)-CH3; CH2=CH-CH2-CH3; HC≡C-CH2-CH3. Benenne, leite die Summenformeln her und stelle jedes Molekül als Skelettformel dar. Begründe, welche zwei Konstitutionsisomere sind.",
            "taskDemandEn": "Four complete structures: CH3-CH2-CH2-CH3; CH3-CH(CH3)-CH3; CH2=CH-CH2-CH3; HC≡C-CH2-CH3. Name the molecules, derive their formulas and draw each as a skeletal formula. Explain which two are constitutional isomers.",
            "expectedPerformanceDe": "Butan und 2-Methylpropan haben C4H10 bei verschiedener Verknüpfung; But-1-en hat C4H8 und But-1-in C4H6. Skelettenden/-ecken stehen für C, Mehrfachbindungen bleiben sichtbar.",
            "expectedPerformanceEn": "Butane and 2-methylpropane have C4H10 with different connectivity; but-1-ene has C4H8 and but-1-yne C4H6. Skeletal ends/vertices denote C and multiple bonds remain visible.",
            "understandingFocusDe": "Die Formeln werden durch Valenzzählung begründet, nicht nur anhand auswendig gelernter Stoffklassenformeln geraten.",
            "understandingFocusEn": "Formulas are justified by valence counting, not guessed solely from memorised class formulas."
          },
          {
            "id": "chem-current15-dd58c029-case-2",
            "taskDemandDe": "Frischer Fall: CH3-CH2-CH2-CH2-CH3 und CH3-CH(CH3)-CH2-CH3; außerdem CH2=CH-CH2-CH2-CH3. Ordne die homologen Beziehungen zu Fall 1 zu und erkläre, warum die ersten beiden Moleküle Isomere, nicht aufeinanderfolgende Homologe sind.",
            "taskDemandEn": "Fresh case: CH3-CH2-CH2-CH2-CH3 and CH3-CH(CH3)-CH2-CH3; also CH2=CH-CH2-CH2-CH3. Assign the homologous relationships to case 1 and explain why the first two molecules are isomers rather than consecutive homologues.",
            "expectedPerformanceDe": "Pentan und 2-Methylbutan sind C5H12-Konstitutionsisomere. Pentan ist das nächste Homologe von Butan; Pent-1-en das nächste Homologe von But-1-en. Eigene Zeichnungen müssen die zusätzliche CH2-Einheit und erhaltene Bindungsordnung zeigen.",
            "expectedPerformanceEn": "Pentane and 2-methylbutane are C5H12 constitutional isomers. Pentane is the next homologue of butane; pent-1-ene the next homologue of but-1-ene. Independent drawings show the extra CH2 unit and retained bond order.",
            "understandingFocusDe": "Eine bloße andere Zeichenrichtung derselben Kette erzeugt kein weiteres Konstitutionsisomer.",
            "understandingFocusEn": "Merely drawing the same chain in another direction does not create another constitutional isomer."
          }
        ]
      }
    },
    {
      "goalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
      "wholeProfile": {

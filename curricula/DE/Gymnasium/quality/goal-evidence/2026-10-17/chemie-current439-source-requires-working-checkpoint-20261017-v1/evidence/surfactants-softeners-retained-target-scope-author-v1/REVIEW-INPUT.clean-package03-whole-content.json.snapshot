        ],
        "applicationCaseBriefs": [
          {
            "id": "phosphorus-periodic-table",
            "taskDemandDe": "Ein PSE-Ausschnitt zeigt neutrales Phosphor-Atom P, Z=15, Hauptgruppe 15, Periode 3. Gib Protonen- und Elektronenzahl, Außenelektronen und einfache Schalenzahl an und begründe aus der Tabellenstellung.",
            "taskDemandEn": "A periodic-table excerpt shows neutral phosphorus P, Z=15, main group 15, period 3. State proton and electron counts, outer electrons and simple shell count, explaining each from its table position.",
            "expectedPerformanceDe": "P hat 15 Protonen und im neutralen Atom 15 Elektronen, fünf Außenelektronen und drei besetzte Schalen im einfachen Modell; die Ordnungszahl ist keine Neutronenzahl.",
            "expectedPerformanceEn": "Neutral P has 15 protons and 15 electrons, five outer electrons and three occupied shells in the simple model; atomic number is not neutron count.",
            "understandingFocusDe": "PSE-Merkmale werden am neutralen Hauptgruppenatom verknüpft.",
            "understandingFocusEn": "Periodic-table features are linked for a neutral main-group atom."
          },
          {
            "id": "calcium-atom-transfer",
            "taskDemandDe": "Ein neuer PSE-Ausschnitt zeigt neutrales Calcium Ca, Z=20, Hauptgruppe 2, Periode 4. Nenne Protonen- und Elektronenzahl sowie Außenelektronen und Schalen. Warum unterscheidet sich Ca von P?",
            "taskDemandEn": "A fresh excerpt shows neutral calcium Ca, Z=20, main group 2, period 4. State proton and electron counts plus outer electrons and shells. Why does Ca differ from P?",
            "expectedPerformanceDe": "Ca hat 20 Protonen und im neutralen Atom 20 Elektronen, zwei Außenelektronen und vier besetzte Schalen. Hauptgruppe und Periode erklären den Unterschied zu P; keine Ionenladung wird verlangt.",
            "expectedPerformanceEn": "Neutral Ca has 20 protons and 20 electrons, two outer electrons and four occupied shells. Group and period explain the difference from P; no ion charge is required.",
            "understandingFocusDe": "Neue Hauptgruppe und Periode prüfen eigenständigen Tabellen-Transfer.",
            "understandingFocusEn": "A new group and period test independent table transfer."
          }
        ]
      }
    },
    {
      "goalId": "eb7537dd-d11b-50e9-a6d7-51a78e96fc4e",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Dispersionskräfte wirken zwischen allen Teilchen; permanente Dipole und H-Brücken fügen spezifische Beiträge hinzu.",
            "essentialUnderstandingEn": "Dispersion acts between all particles; permanent dipoles and hydrogen bonds add specific contributions.",
            "observablePerformanceDe": "Ordnet Wechselwirkungen an gegebenen Paaren mit chemischer Begründung zu.",
            "observablePerformanceEn": "Assigns interactions to supplied pairs with chemical reasoning."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Ionen-Dipol-Kräfte wirken zwischen einem Ion und dem polaren Lösungsmittel.",
            "essentialUnderstandingEn": "Ion–dipole forces act between an ion and a polar solvent.",
            "observablePerformanceDe": "Orientiert Wasser um Kationen/Anionen und trennt Solvatation von Molekülbindung.",
            "observablePerformanceEn": "Orients water around cations/anions and distinguishes solvation from intramolecular bonding."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "Eigenschaften folgen dem Zusammenspiel von Polarität, Polarisierbarkeit und Struktur.",
            "essentialUnderstandingEn": "Properties reflect polarity, polarizability and structure together.",
            "observablePerformanceDe": "Vergleicht Stoffeigenschaften und widerlegt eine unpassende pauschale Rangregel.",
            "observablePerformanceEn": "Compares properties and rejects an unsuitable blanket ranking."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",
            "e2",
            "e3"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "v1",
            "textDe": "Neutrale Moleküle oder solvatisierte Ionen",
            "textEn": "Neutral molecules or solvated ions"
          },
          {
            "id": "v2",
            "textDe": "Größe und H-Brückenfähigkeit",
            "textEn": "Size and hydrogen-bond capability"
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "eb7537dd-case-1",
            "taskDemandDe": "Daten und Bedingungen:\nGegeben: Ethanol CH₃CH₂OH, Dimethylether CH₃OCH₃, Pentan C₅H₁₂ sowie Na⁺/Cl⁻ in Wasser. Ethanol und Dimethylether haben dieselbe Molmasse; Siedepunkte als Unterrichtsdaten: 78°C bzw. −25°C. Wasser hat Oδ−/Hδ+. Im eigenen reinen Ether fehlt ein O–H-Donator; Ether-O kann H-Brücken von Wasser akzeptieren.\nAufgaben:\n1. Ordne für jedes reine Molekül die genannten Wechselwirkungen zu und begründe die H-Brückenunterscheidung.\n2. Beschreibe die Wasserorientierung an Na⁺ und Cl⁻ sowie Ether/Wasser-Wechselwirkung.\n3. Erkläre den Siedepunktunterschied der Isomere und grenze ihn von einer allgemeinen Stoffrangfolge ab.",
            "taskDemandEn": "Data and conditions:\nGiven: ethanol CH₃CH₂OH, dimethyl ether CH₃OCH₃, pentane C₅H₁₂, and Na⁺/Cl⁻ in water. Ethanol/dimethyl ether have equal molar mass; teaching boiling points are 78°C/−25°C. Water has Oδ−/Hδ+. Pure ether lacks an O–H donor; its oxygen can accept hydrogen bonds from water.\nTasks:\n1. Assign the listed interactions to each pure molecular substance and explain the hydrogen-bond distinction.\n2. Describe water orientation around Na⁺/Cl⁻ and ether–water interaction.\n3. Explain the isomers’ boiling-point difference and distinguish it from a universal substance ranking.",
            "expectedPerformanceDe": "1. Alle zeigen Dispersion. Ethanol und Ether sind permanent polar und zeigen Dipol-Dipol-Kräfte; Ethanol besitzt O–H-Donator und O-Akzeptor, daher H-Brücken zwischen seinen Molekülen. Reiner Ether bildet keine entsprechende O–H···O-Kette; Pentan ist unpolar.\n2. Um Na⁺ richtet sich vorzugsweise Oδ− aus, um Cl⁻ Hδ+. Das sind Ionen-Dipol-Wechselwirkungen. Wasser kann über O–H eine H-Brücke zum Ether-O bilden; fehlende Selbst-H-Brücken bedeuten deshalb keine fehlende Wasserwechselwirkung.\n3. Bei vergleichbarer Masse/Größe verlangt das zusätzliche H-Brückennetz des Ethanols mehr Energie zur Trennung der Moleküle. Daraus folgt keine universelle Regel, dass jeder H-Brückenstoff höher siedet als jeder unpolare Stoff; Größe/Polarisierbarkeit und Form bleiben relevant.",
            "expectedPerformanceEn": "1. All show dispersion. Ethanol and ether are polar and have dipole–dipole forces; ethanol has O–H donor and oxygen acceptor, allowing intermolecular hydrogen bonds. Pure ether cannot form corresponding O–H···O chains; pentane is nonpolar.\n2. Oδ− points preferentially toward Na⁺ and Hδ+ toward Cl⁻: ion–dipole interactions. Water can donate O–H hydrogen bonds to ether oxygen; lack of self hydrogen bonding does not imply lack of interaction with water.\n3. At comparable mass/size ethanol’s additional hydrogen-bond network requires more energy for molecular separation. This does not mean every hydrogen-bonding substance boils above every nonpolar substance; size, polarizability and shape still matter.",
            "understandingFocusDe": "Wechselwirkungen folgen Ladung, Molekülpolarität, Donator/Akzeptor und Polarisierbarkeit. Transfer: Ethanol/Ether und Hexan/Aceton widerlegen eine universelle Siedepunktrangfolge. Zwei unabhängige Nachweisschritte können in einer integrierten Leistung auftreten; die zwei Fallvarianten sind keine Pflichtaufgabenquote. Sobald alle Aspekte und selbstständiger Transfer hinreichend gezeigt sind, endet die Prüfung.",
            "understandingFocusEn": "Interactions follow charge, molecular polarity, donor/acceptor roles and polarizability. Transfer: Ethanol/ether and hexane/acetone challenge a universal boiling-point ranking. Two independent demonstration steps can occur in one integrated performance; the two case variants are not a mandatory task quota. Stop assessment once all aspects and independent transfer are sufficiently shown."
          },
          {
            "id": "eb7537dd-case-2",
            "taskDemandDe": "Daten und Bedingungen:\nGegeben Aceton CH₃COCH₃ (58 g/mol, Siedepunkt 56°C) und Hexan C₆H₁₄ (86 g/mol, Siedepunkt 69°C), Methanol CH₃OH sowie Mg²⁺ in Wasser. Carbonyl-Cδ+/Oδ−. Hexan hat größere Elektronenwolke; die Siedepunkte sind gerundete Lehrdaten.\nAufgaben:\n1. Erkläre Wechselwirkungen in Aceton, Hexan und Methanol sowie zwischen Methanol und Aceton.\n2. Beschreibe Mg²⁺-Hydratation und unterscheide sie von H-Brücken zwischen Wassermolekülen.\n3. Bewerte anhand der Daten die Behauptung, permanente Dipole erzwingen immer höhere Siedepunkte.",
            "taskDemandEn": "Data and conditions:\nGiven acetone CH₃COCH₃ (58 g/mol, boiling point 56°C), hexane C₆H₁₄ (86 g/mol, 69°C), methanol CH₃OH and Mg²⁺ in water. Carbonyl Cδ+/Oδ−. Hexane has a larger electron cloud; boiling points are rounded teaching data.\nTasks:\n1. Explain interactions within acetone, hexane and methanol and between methanol/acetone.\n2. Describe Mg²⁺ hydration and distinguish it from water–water hydrogen bonds.\n3. Use the data to evaluate the claim that permanent dipoles always force higher boiling points.",
            "expectedPerformanceDe": "1. Aceton: Dispersion plus Dipol-Dipol, kein eigener O–H-Donator. Hexan: Dispersion. Methanol: Dispersion, permanente Dipole und H-Brücken. Methanol-O–H kann an Aceton-O eine H-Brücke bilden. C=O selbst ist eine intramolekulare Bindung.\n2. Wasser-Oδ− weist zum positiven Mg²⁺; die Anziehung ist Ionen-Dipol. Benachbarte Wassermoleküle können zusätzlich O–H···O-Brücken bilden. Der Ion-Wasser-Kontakt ist keine C=O- oder O–H-Molekülbindung.\n3. Hexan siedet trotz fehlendem permanentem Dipol höher als Aceton. Seine größere polarisierbare Elektronenwolke kann stärkere gesamte Dispersion beitragen. Der Vergleich zeigt das Zusammenspiel, nicht das Fehlen von Dipolkräften im Aceton oder einen allgemeinen Größenbeweis aus nur zwei Stoffen.",
            "expectedPerformanceEn": "1. Acetone: dispersion and dipole–dipole, no O–H donor. Hexane: dispersion. Methanol: dispersion, permanent dipoles and hydrogen bonds. Methanol O–H can donate to acetone oxygen. C=O itself is an intramolecular bond.\n2. Water Oδ− faces positive Mg²⁺, giving ion–dipole attraction. Neighboring water molecules may additionally form O–H···O bonds. Ion–water contact is not a molecular C=O/O–H bond.\n3. Hexane boils above acetone despite lacking a permanent dipole. Its larger polarizable electron cloud can contribute greater total dispersion. The comparison shows combined contributions, not absence of acetone dipole forces or a universal size law inferred from two substances.",
            "understandingFocusDe": "Wechselwirkungen folgen Ladung, Molekülpolarität, Donator/Akzeptor und Polarisierbarkeit. Transfer: Ethanol/Ether und Hexan/Aceton widerlegen eine universelle Siedepunktrangfolge. Zwei unabhängige Nachweisschritte können in einer integrierten Leistung auftreten; die zwei Fallvarianten sind keine Pflichtaufgabenquote. Sobald alle Aspekte und selbstständiger Transfer hinreichend gezeigt sind, endet die Prüfung.",
            "understandingFocusEn": "Interactions follow charge, molecular polarity, donor/acceptor roles and polarizability. Transfer: Ethanol/ether and hexane/acetone challenge a universal boiling-point ranking. Two independent demonstration steps can occur in one integrated performance; the two case variants are not a mandatory task quota. Stop assessment once all aspects and independent transfer are sufficiently shown."
          }
        ]
      }
    },
    {
      "goalId": "f5efab9d-2c61-44ea-b36a-87f873b51fd8",
      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "b006-f5efab9d-core",
            "essentialUnderstandingDe": "Das Bohrsche Energiestufenmodell ordnet Elektronen einfacher Atome Schalen zu. Ein großer Sprung zwischen aufeinanderfolgenden Ionisierungsenergien deutet auf stärker gebundene innere Elektronen hin; die Messung zeichnet keine kreisförmigen Bahnen ab.",
            "essentialUnderstandingEn": "Bohr’s energy-level model allocates electrons of simple atoms to shells. A large jump between successive ionization energies suggests more strongly bound inner electrons; the measurement does not trace circular orbits.",
            "observablePerformanceDe": "Die lernende Person verbindet Ordnungszahl und begrenzte Schalenbelegung mit gegebenen Ionisierungsenergien und benennt die Reichweite des Modells.",
            "observablePerformanceEn": "The learner links atomic number and bounded shell occupation to supplied ionization energies and states the model’s limits."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b006-f5efab9d-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "outer-electrons",
            "textDe": "Ein beziehungsweise zwei Außenelektronen erzeugen einen Sprung nach unterschiedlicher Ionisation.",
            "textEn": "One versus two outer electrons cause a jump after a different ionization step."
          },
          {
            "id": "model-limit",
            "textDe": "Messdaten stützen Energieunterschiede, aber keine wörtlichen Elektronen-Kreisbahnen.",
            "textEn": "Measurements support energy differences, not literal electron circles."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "lithium-ionization-data",
            "taskDemandDe": "Für neutrales Li (Z=3) sind die ersten beiden Ionisierungsenergien rund 520 und 7298 kJ/mol. Gib eine einfache Schalenbelegung an und deute den Sprung.",
            "taskDemandEn": "For neutral Li (Z=3), the first two ionization energies are about 520 and 7298 kJ/mol. Give a simple shell occupancy and interpret the jump.",
            "expectedPerformanceDe": "2,1 Elektronen: Nach Entfernen des Außenelektrons betrifft die zweite Ionisation die innere Schale; Zahlen sind Hinweise auf Bindungsstärke, kein Bahnfotobeweis.",
            "expectedPerformanceEn": "2,1 electrons: after the outer electron is removed, the second ionization reaches the inner shell; the numbers indicate binding strength, not a photo of paths.",
            "understandingFocusDe": "Ein neuer Messdatensatz verbindet Modell und Messung.",
            "understandingFocusEn": "A new measured data set links model and measurement."
          },
          {
            "id": "magnesium-ionization-transfer",
            "taskDemandDe": "Für Mg (Z=12) sind die ersten drei Ionisierungsenergien rund 738, 1451 und 7733 kJ/mol. Schlage eine einfache Schalenbelegung vor und erkläre, was der große Sprung nach der zweiten Entfernung zeigt und nicht zeigt.",
            "taskDemandEn": "For Mg (Z=12), the first three ionization energies are about 738, 1451 and 7733 kJ/mol. Propose a simple shell occupancy and explain what the large jump after the second removal does and does not show.",
            "expectedPerformanceDe": "2,8,2 im einfachen Schalenmodell; zwei äußere Elektronen, danach stärker gebundenes inneres Elektron. Die Messwerte allein liefern keine exakten Orbitalformen oder klassischen Bahnen.",
            "expectedPerformanceEn": "2,8,2 in the simple shell model; two outer electrons, then a more strongly bound inner electron. Values alone give neither exact orbital shapes nor classical paths.",
            "understandingFocusDe": "Sprung an anderer Stelle prüft Transfer und Modellgrenze.",
            "understandingFocusEn": "A jump at another position tests transfer and the model limit."
          }
        ]
      }
    },
    {
      "goalId": "fcc73fb5-7413-557f-aea3-b9692a66ee75",
      "wholeProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "b007r-fcc-properties-core",
            "essentialUnderstandingDe": "Stoffe werden durch beobachtete oder unter vergleichbaren Bedingungen bestimmte Eigenschaften beschrieben und nach begründeten Kriterien geordnet. Farbe oder ein anderer Einzelbefund allein sichert eine Stoffidentität oft nicht; Stoffname und Eigenschaft sind verschieden. Aussagen zu Löslichkeit nennen das Lösungsmittel und die Bedingungen.",
            "essentialUnderstandingEn": "Substances are described by observed properties or properties determined under comparable conditions and classified using justified criteria. Colour or another single observation often does not establish identity; a substance name and a property differ. Solubility claims specify the solvent and conditions.",
            "observablePerformanceDe": "Die lernende Person erstellt aus sicheren vorgegebenen Beobachtungen eine kleine Eigenschaftsübersicht, ordnet Proben nach einem genannten Merkmal und erklärt die Grenze einer Zuordnung aus nur einem Merkmal.",
            "observablePerformanceEn": "The learner builds a small property summary from safe supplied observations, groups samples by a named property and explains the limit of classification from one property alone."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b007r-fcc-properties-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "sample-property",
            "textDe": "Magnetismus und Oberflächenglanz bei Feststoffen wechseln zu Dichte und Fließverhalten bei Flüssigkeiten.",
            "textEn": "Magnetism and surface lustre for solids change to density and flow behaviour for liquids."
          },
          {
            "id": "evidence-strength",
            "textDe": "Ein einzelnes gemeinsames Merkmal wird gegen eine Kombination unterscheidender Merkmale geprüft.",
            "textEn": "A single shared property is checked against a combination of distinguishing properties."
          },
          {
            "id": "controlled-solvent-conditions",
            "textDe": "Gleiches Wasser, gleiche Stoffmenge und Temperatur sind für die konkrete Löslichkeitsaussage gebunden.",
            "textEn": "The same water, material amount and temperature are tied to the specific solubility claim."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "new-solid-sample-table",
            "taskDemandDe": "Drei sichere, vorbereitete Feststoffproben A, B, C sind gegeben: A ist dunkelgrau, glänzend und wird von einem Magneten angezogen; B ist silbrig glänzend und nicht magnetisch; C ist hell, körnig, matt und nicht magnetisch. Erstelle eine Eigenschaftstabelle, ordne die Proben nach Magnetismus und begründe, weshalb ‚nicht magnetisch‘ B und C nicht gleichsetzt. Keine unbekannte Probe anfassen oder schmecken.",
            "taskDemandEn": "Three safe prepared solid samples A, B and C have supplied observations: A is dark grey, shiny and attracted by a magnet; B is silvery and shiny but non-magnetic; C is light-coloured, granular, dull and non-magnetic. Make a property table, group them by magnetism and explain why 'non-magnetic' does not make B and C the same substance. Do not handle or taste unknown samples.",
            "expectedPerformanceDe": "A wird als magnetisch, B und C werden als nicht magnetisch geordnet. Die Person hält Farbe/Glanz/Körnigkeit getrennt fest und erklärt, dass B und C trotz gemeinsamer Nichtmagnetisierung in anderen Merkmalen verschieden sind; aus diesen wenigen Befunden wird keine sichere Stoffidentität behauptet.",
            "expectedPerformanceEn": "A is grouped as magnetic, B and C as non-magnetic. The learner records colour, lustre and graininess separately and explains that B and C differ in other properties despite their shared non-magnetism; they do not claim certain identity from these limited observations.",
            "understandingFocusDe": "Eigenschaften beschreiben, nach einem expliziten Kriterium ordnen und die Grenze eines Einzelmerkmals erklären.",
            "understandingFocusEn": "Describe properties, classify by an explicit criterion and explain the limit of a single property."
          },
          {
            "id": "fresh-colourless-liquid-data",
            "taskDemandDe": "Zwei neue, verschlossene und beschriftete Flüssigkeitsproben X und Y sind beide farblos und klar. Vorgegebene Messdaten bei 20 °C: X hat 1,00 g/mL und fließt leicht, Y hat 1,26 g/mL und fließt deutlich zäher. Beschreibe und ordne die Proben anhand von zwei geeigneten Eigenschaften; begründe, weshalb die gleiche Farbe keine Gleichheit belegt. Keine eigene Geschmacks- oder Geruchsprobe.",
            "taskDemandEn": "Two new sealed, labelled liquid samples X and Y are both colourless and clear. Supplied data at 20 °C say X has density 1.00 g/mL and flows readily; Y has density 1.26 g/mL and flows much more slowly. Describe and compare the samples using two suitable properties and explain why the same colour does not prove identity. No tasting or smelling samples.",
            "expectedPerformanceDe": "Beide sind farblos/klar, aber Y ist bei gleicher Temperatur dichter und zähflüssiger als X. Die Person trennt gemeinsame von unterscheidenden Eigenschaften, nennt die 20-°C-Bedingung und vergibt ohne weitere Daten keine Stoffnamen.",
            "expectedPerformanceEn": "Both are colourless and clear, but Y is denser and more viscous than X at the same temperature. The learner separates shared from distinguishing properties, states the 20 °C condition and does not assign substance names without more evidence.",
            "understandingFocusDe": "Unabhängiger Transfer von Feststoffbeobachtungen auf Flüssigkeitsdaten und Vergleich unter gleichen Bedingungen.",
            "understandingFocusEn": "Independent transfer from solid observations to liquid data and comparison under common conditions."
          },
          {
            "id": "controlled-solubility-three-solids",
            "taskDemandDe": "Drei ungefährliche, beschriftete Feststoffe werden jeweils mit 5 g in getrennte Becher mit 100 mL Wasser bei 20 °C gegeben und gleich lang gerührt. Vorgegebene Beobachtungen: Zucker verschwindet ohne Bodensatz, Sand bleibt sichtbar am Boden, Speisesalz verschwindet ohne Bodensatz. Ordne nach Wasserlöslichkeit unter diesen Bedingungen und erkläre, welche Stoffe du durch dieses eine Merkmal noch nicht voneinander unterscheiden kannst. Keine Geschmacksprobe.",
            "taskDemandEn": "Three harmless labelled solids are added separately, 5 g each, to 100 mL of water at 20 °C and stirred for the same time. Supplied observations: sugar disappears with no sediment, sand remains visible at the bottom, table salt disappears with no sediment. Group them by solubility in water under these conditions and explain which materials this one property still fails to distinguish. No tasting.",
            "expectedPerformanceDe": "Zucker und Speisesalz werden als in dieser Menge und bei 20 °C wasserlöslich, Sand als nicht merklich wasserlöslich geordnet. Die Person nennt Wasser, gleiche Menge und Temperatur als Vergleichsbedingungen und behauptet nicht, Zucker und Salz durch Löslichkeit allein unterscheiden zu können.",
            "expectedPerformanceEn": "Sugar and table salt are grouped as soluble in water at the stated amount and 20 °C, while sand is not noticeably soluble. The learner states water, equal amounts and temperature as comparison conditions and does not claim that solubility alone distinguishes sugar from salt.",
            "understandingFocusDe": "Kontrollierter Löslichkeitsvergleich, zweiter löslicher Stoff und Grenze der Stoffidentifikation aus einem Merkmal.",
            "understandingFocusEn": "Controlled solubility comparison, a second soluble material and the limit of identification from one property."
          }
        ]
      }
    }
  ],
  "wholeProposedChangedPositiveProfileContentOnly": {
    "goalId": "cc5a626a-dc85-57e2-b422-259f92901545",
    "wholeProfile": {
      "archetype": "concept",
      "expectations": [
        {
          "id": "degradation-understanding-1",
          "essentialUnderstandingDe": "Funktionelle Gruppen bestimmen mögliche Hydrolyse-, Oxidations- und Kettenverkürzungswege.",
          "essentialUnderstandingEn": "Functional groups determine possible hydrolysis, oxidation and chain-shortening pathways.",
          "observablePerformanceDe": "Beschreibe Hydrolyse, endständige Oxidation undβ-Oxidation mit C-Erhalt und Produktklassen. Beurteilt80%Verschwinden die Mineralisierung? Nenne weitere Messungen;  Erwartet:Hydrolyse spaltet unter Wasserverbrauch die Esterbindung. Alkohol→Aldehyd→Säure erhält zunächst12C. Nach Aktivierung entstehen ideal aus einer gesättigtenC12-Kette sechs Acetyl-Einheiten über fünf Verkürzungszyklen. Das ist noch kein vollständigerCO2-Nachweis. Ausgangsstoffentfernung kann Zwischenprodukte, Sorption oder Biomasse einschließen. Benötigt werden C-Bilanz, Produkte und aquatische Wirkungen; Stoff und Bedingungen bestimmen den Weg.",
          "observablePerformanceEn": "Describe hydrolysis, terminal-group oxidation and beta oxidation for the model, tracking carbon/product class. Assess whether80%disappearance proves mineralisation. Specify a genuine further measurement; Expected:Ester hydrolysis consumes water and cleaves the ester link; C12 alcohol oxidises throughC12 aldehyde toC12 acid without immediate carbon cleavage. After activation, beta-oxidation cycles removeC2 units; an ideal saturatedC12 chain yields six acetyl units after five shortening cycles. This is not itself completeCO2 measurement.80%parent-substance disappearance can include intermediates, sorption/biomass;30%CO2 does not show full mineralisation. Carbon balance, degradates and aquatic effects are needed; pathways depend on substance/conditions."
        },
        {
          "id": "degradation-understanding-2",
          "essentialUnderstandingDe": "Primärabbau, Phasenverteilung, Zwischenprodukte und Mineralisierung sind verschiedene Stoffbilanzaussagen.",
          "essentialUnderstandingEn": "Primary degradation, partitioning, intermediates and mineralisation are different material-balance claims.",
          "observablePerformanceDe": "Beschreibe den Pfad gegenüber18b und beurteile „90%abbaubar = umweltverträglich“. Welche Messungen/Bedingungen fehlen für eine belastbarere Aussage? Erwartet: Die Ethoxyverkürzung beschreibt im gegebenen biologischen Pfad eine Strukturumwandlung; Primärabbau im hier verwendeten Tensidsinn setzt zusätzlich den Verlust der Oberflächenaktivität voraus. Dieser Funktionsverlust ist im Material nicht gemessen und folgt nicht allein aus der90%igen Ausgangsstoffentfernung.10%CO2-C belegen keine weitgehende Mineralisierung. Problematische Produkte widerlegen die Ableitung aus Ausgangsstoffentfernung allein. Der aromatische Alkylphenolkern unterscheidet den Stoff vom linearen C12-Alkohol; eine bestimmte Alkylverzweigung ist nicht gegeben; identischeβ-Oxidation ist nicht belegt. C-Verbleib, zeitliche Produktkonzentration, O2, Temperatur, Inokulum undaquatische Wirkung sind erforderlich. Die fiktive Karte ist keine reale Produktfreigabe.",
          "observablePerformanceEn": "Describe the supplied pathway and compare with the linear-alcohol route18b. Critique“90%degradable means environmentally safe”. What measurements/conditions support a stronger inference? Expected: Ethoxy-chain shortening describes structural transformation in the supplied biological pathway; primary degradation in the surfactant sense used here additionally requires loss of surface activity. That functional loss is not measured in the material and does not follow solely from90%parent removal.10%CO2-carbon does not show extensive mineralisation. Detected problematic products defeat an inference from parent disappearance alone. The aromatic alkylphenol core differs from a linear C12 alcohol; no particular alkyl branching is supplied; identical beta oxidation cannot be claimed without structural evidence. Need carbon fate, time-resolved product concentrations, oxygen/temperature/inoculum and aquatic-effects context; The fictional card grants no real product approval."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "degradation-understanding-1",
          "degradation-understanding-2"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "changed-composition-or-condition",
          "textDe": "Geänderte Stoff-/Struktur- oder Einsatzbedingungen selbst deuten.",
          "textEn": "Independently interpret changed composition, structure or operating conditions."
        },
        {
          "id": "genuine-new-transfer",
          "textDe": "Begründung an frischer Variation und tatsächlicher Aussagegrenze prüfen.",
          "textEn": "Test reasoning on fresh variation and actual inference limits."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "energy20-18-b-split-current",
          "taskDemandDe": "Eigenes Stoffmodell: Ein Tensidester hydrolysiert zu langkettiger Hydroxykomponente und Carbonsäurekomponente. Ein freigesetzter linearerC12-Alkohol CH3−(CH2)10−CH2OH oxidiert zuC12-Aldehyd undC12-Säure.β-Oxidation aktivierter Fettsäuren entfernt jeweils2C. Fremddaten:80%Ausgangstensid verschwunden nach7Tagen, aber nur30%des organischenC alsCO2; Rest unbekannt. Beschreibe Hydrolyse, endständige Oxidation undβ-Oxidation mit C-Erhalt und Produktklassen. Beurteilt80%Verschwinden die Mineralisierung? Nenne weitere Messungen;  Frischer Transfer:Ein verzweigter Alkylrest ersetzt die lineare Kette. Warum dürfen Weg und Geschwindigkeit nicht ohne neue Daten übertragen werden?",
          "taskDemandEn": "Own model:an ester-containing surfactant first hydrolyses to a long-chain hydroxy component and a carboxylic-acid component. A released linearC12 alcohol CH3−(CH2)10−CH2OH can oxidise to aldehyde thenC12 acid; beta oxidation shortens activated fatty-acid chains by2C per cycle. Supplied data:80%parent disappearance by7days, but only30%organic carbon detected asCO2; remaining distribution unknown. Describe hydrolysis, terminal-group oxidation and beta oxidation for the model, tracking carbon/product class. Assess whether80%disappearance proves mineralisation. Specify a genuine further measurement; Freshtransfer:A branched tail replaces the linear chain. Explain why identical pathway/rate cannot be transferred without evidence.",
          "expectedPerformanceDe": "Hydrolyse spaltet unter Wasserverbrauch die Esterbindung. Alkohol→Aldehyd→Säure erhält zunächst12C. Nach Aktivierung entstehen ideal aus einer gesättigtenC12-Kette sechs Acetyl-Einheiten über fünf Verkürzungszyklen. Das ist noch kein vollständigerCO2-Nachweis. Ausgangsstoffentfernung kann Zwischenprodukte, Sorption oder Biomasse einschließen. Benötigt werden C-Bilanz, Produkte und aquatische Wirkungen; Stoff und Bedingungen bestimmen den Weg. Transfer:Die Verzweigung verändert die Zugänglichkeit und mögliche enzymatische Umsetzung. Aus dem linearen C12-Modell folgen weder identischer β-Oxidationsweg noch gleiche Geschwindigkeit oder vollständige Mineralisierung; passende Zwischenprodukt-/Kohlenstoffdaten sind erforderlich.",
          "expectedPerformanceEn": "Ester hydrolysis consumes water and cleaves the ester link; C12 alcohol oxidises throughC12 aldehyde toC12 acid without immediate carbon cleavage. After activation, beta-oxidation cycles removeC2 units; an ideal saturatedC12 chain yields six acetyl units after five shortening cycles. This is not itself completeCO2 measurement.80%parent-substance disappearance can include intermediates, sorption/biomass;30%CO2 does not show full mineralisation. Carbon balance, degradates and aquatic effects are needed; pathways depend on substance/conditions. Transfer:Branching changes accessibility and possible enzymatic processing. The linear C12 model establishes neither an identical beta-oxidation route nor equal rate or full mineralisation; suitable intermediate/carbon data are required.",
          "understandingFocusDe": "Ein ganzes vorgeschlagenes Kindziel, wahre prospektive Evidenz und unabhängiger Transfer; keine menschliche oder praktische Freigabe.",
          "understandingFocusEn": "One whole proposed child, true prospective evidence and independent transfer; no human or practical approval."
        },
        {
          "id": "energy20-18-d-split-current",
          "taskDemandDe": "Fiktiver Alkylphenolethoxylat-Pfad: langer Ethoxykopf→kürzere Homologe→Alkylphenol. Gefahrenkarte: problematische langsam abbaubare Zwischenprodukte. Tag10:90%Ausgangsstoffentfernung,10%CO2-C, Zwischenprodukte nachgewiesen. Die Gefahrenkarte ist ausdrücklich ein fiktiver Aufgabenbestandteil und kein tatsächlich gesichteter Behördenartikel. Beschreibe den Pfad gegenüber18b und beurteile „90%abbaubar = umweltverträglich“. Welche Messungen/Bedingungen fehlen für eine belastbarere Aussage? Frischer Transfer: Nach weiteren 20 Tagen sorbiert das Alkylphenol an Schlamm, CO2-C bleibt niedrig. Warum müssen Phasenverteilung und chemischer Abbau getrennt gemessen werden? Prüfe außerdem, ob die vorgegebenen Daten den Verlust der Oberflächenaktivität bereits belegen oder welche Funktionsmessung dafür fehlt. Eine nur gemessene Ausgangsstoffentfernung ist nicht mit diesem Funktionsverlust gleichzusetzen.",
          "taskDemandEn": "Fictional alkylphenol-ethoxylate pathway:longethoxy parent→shorterethoxy homologues→alkylphenol; the supplied hazard card identifies problematic, more slowly degrading aquatic intermediates. Day10:90%parent removal,10%CO2-carbon and detected intermediates. The hazard card is explicitly fictional teaching material, not an actually inspected agency article. Describe the supplied pathway and compare with the linear-alcohol route18b. Critique“90%degradable means environmentally safe”. What measurements/conditions support a stronger inference? Fresh transfer: After 20 more days alkylphenol disappears from water by sorption to sludge while CO2-carbon stays low. Explain why partitioning and chemical degradation need separate measurements. Also assess whether the supplied data establish loss of surface activity or which functional measurement is missing. Measured parent-substance removal alone must not be equated with that functional loss.",
          "expectedPerformanceDe": "Die Ethoxyverkürzung beschreibt im gegebenen biologischen Pfad eine Strukturumwandlung; Primärabbau im hier verwendeten Tensidsinn setzt zusätzlich den Verlust der Oberflächenaktivität voraus. Dieser Funktionsverlust ist im Material nicht gemessen und folgt nicht allein aus der90%igen Ausgangsstoffentfernung.10%CO2-C belegen keine weitgehende Mineralisierung. Problematische Produkte widerlegen die Ableitung aus Ausgangsstoffentfernung allein. Der aromatische Alkylphenolkern unterscheidet den Stoff vom linearen C12-Alkohol; eine bestimmte Alkylverzweigung ist nicht gegeben; identischeβ-Oxidation ist nicht belegt. C-Verbleib, zeitliche Produktkonzentration, O2, Temperatur, Inokulum undaquatische Wirkung sind erforderlich. Die fiktive Karte ist keine reale Produktfreigabe. Transfer: Sorption verlagert den Stoff in die Schlammphase und zerstört seine Moleküle nicht. Nötig sind phasenübergreifende Stoff-/C-Bilanz und Abbauprodukt-/CO2-Daten; allein der Rückgang in Wasser beweist keinen chemischen Abbau oder geringe Wirkung.",
          "expectedPerformanceEn": "Ethoxy-chain shortening describes structural transformation in the supplied biological pathway; primary degradation in the surfactant sense used here additionally requires loss of surface activity. That functional loss is not measured in the material and does not follow solely from90%parent removal.10%CO2-carbon does not show extensive mineralisation. Detected problematic products defeat an inference from parent disappearance alone. The aromatic alkylphenol core differs from a linear C12 alcohol; no particular alkyl branching is supplied; identical beta oxidation cannot be claimed without structural evidence. Need carbon fate, time-resolved product concentrations, oxygen/temperature/inoculum and aquatic-effects context; The fictional card grants no real product approval. Transfer: Sorption transfers the substance into sludge without destroying its molecules. A cross-phase substance/carbon balance plus degradate/CO2 data is needed; disappearance from water alone proves neither chemical degradation nor low effects.",
          "understandingFocusDe": "Ein ganzes vorgeschlagenes Kindziel, wahre prospektive Evidenz und unabhängiger Transfer; keine menschliche oder praktische Freigabe.",
          "understandingFocusEn": "One whole proposed child, true prospective evidence and independent transfer; no human or practical approval."
        }
      ]
    }
  },
  "originalMaterialSource": {
    "path": "/home/enpasos/projects/skillpilot/curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-energy20-four-defects-targeted-material-author-successor-20261015-v1/materials/forty-two-whole-DE-EN-cases.four-defects-successor.author.json",
    "sha256": "5762a8f53db8ff2a6f44f98f1495959132bc04541e0af85c0088ace5e9da21fe",
    "bytes": 170824
  },
  "wholeOriginalSixDEENCases": [
    {
      "id": "energy20-11-a",
      "goalId": "a78aacf9-92ea-5627-8776-a595111f754c",
      "title": "Protein, Tee und weißes Baumwollgewebe",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Fiktive Formulierung F pro100g:15g anionisches Tensid,20g ionentauschender Builder,15g Natriumpercarbonat,3g TAED-Aktivator,1g Proteasepräparation,0,1g optischer Aufheller, Rest Hilfsstoffe/Wasser. Fremddaten bei gleicher30°C-Wäsche: ohne Protease bleibt Eiweißfleck deutlich; ohne Bleichsystem bleibt Teefarbe; ohne Builder verschlechtert sich Wirkung in hartem Wasser. UV-Licht lässt den Aufheller fluoreszieren. Keine Mischung von Reinstoffen erforderlich.",
      "materialsEn": "Fictional F per100g:15g anionic surfactant,20g ion-exchange builder,15g sodium percarbonate,3g TAED activator,1g protease preparation,0.1g optical brightener,balance auxiliaries/water. Supplied30°C comparisons:without protease more protein stain remains;without bleach more tea colour remains;without builder hard-water performance declines. Brightener fluoresces underUV. No pure-ingredient mixing required.",
      "taskDe": "Erkläre die unterschiedlichen Funktionen aller vier Stoffgruppen und ordne jede Kontrollbeobachtung zu. Unterscheide chemische Fleckveränderung, enzymatische Hydrolyse, Enthärtung und optische Weißwirkung. Erkläre, weshalb eine größere Enzymmasse nicht automatisch jede Fleckart besser entfernt.",
      "taskEn": "Explain the four ingredient-group functions and assign each controlled observation. Distinguish chemical stain change,enzymatic hydrolysis,softening and optical whiteness. Explain why more enzyme does not automatically remove every stain better.",
      "workedReasoningDe": "Builder senkt freie Härteionenkonzentration; Tenside unterstützen Benetzung/Dispergierung. Protease katalysiert Peptidbindungsspaltung, nicht beliebige Farbstoffoxidation. Percarbonat liefert unter den Modellbedingungen ein oxidierendes Peroxidsystem; TAED unterstützt wirksame Bleichspezies bei niedrigerer Temperatur. Optischer Aufheller absorbiertUV und emittiert sichtbares Licht, entfernt dadurch keine Schmutzmasse. Kontrollen ändern jeweils nur eine Gruppe; Wechselwirkungen und genaue Rezepturleistung sind durch diese Daten nicht vollständig bestimmt.",
      "workedReasoningEn": "Builder reduces free hardness ions;surfactants support wetting/dispersion. Protease catalyses peptide-bond hydrolysis,not arbitrary dye oxidation. Percarbonate supplies an oxidising peroxide system here;TAED assists active bleach species at lower temperature. Optical brightener absorbsUV and emits visible light without removing dirt mass. Controls change one group each;these data do not fully establish interactions or recipe performance.",
      "freshIndependentTransferDe": "Ein Fettfleck ersetzt den Eiweißfleck. Wähle aus Protease/Lipase die chemisch passende Ergänzung und erkläre, warum der Aufheller kein Ersatz dafür ist.",
      "freshIndependentTransferEn": "Replace protein with a fat stain. Choose protease or lipase on chemical grounds and explain why brightener cannot replace it.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Vier Stoffgruppen anhand konkreter Wirkprinzipien zuordnen.",
          "observableEn": "Assign four ingredient groups using concrete mechanisms.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "Hydrolyse, Oxidation, Ionenaustausch und Fluoreszenz unterscheiden.",
          "observableEn": "Distinguish hydrolysis,oxidation,ion exchange and fluorescence.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Kontrolllogik und Substratspezifität statt Universalwirkung nutzen.",
          "observableEn": "Use control logic and substrate specificity,not universal-effect claims.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    },
    {
      "id": "energy20-11-b",
      "goalId": "a78aacf9-92ea-5627-8776-a595111f754c",
      "title": "Wolle, Buntwäsche und Sicherheitsgrenzen",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Fiktive Auswahlkarten: W Wollwaschmittel enthält nichtionisches Tensid und keine Protease/Chlorbleiche; V Vollwaschmittel enthält Protease, Builder, Peroxidbleichsystem; C Chlorreiniger enthält Hypochlorit und ist kein Wäscheprodukt. Pflegekarte: Wolle proteinbasiert, farbempfindlich; keine Chlorbehandlung. Sicherheitskarte: C niemals mit Säure oder anderen Reinigern mischen. Es werden keine Reinigerexperimente ausgeführt.",
      "materialsEn": "Fictional cards:W wool detergent has nonionic surfactant,no protease/chlorine bleach;V heavy-duty detergent has protease,builder,peroxide bleach;C chlorine cleaner has hypochlorite and is not a laundry product. Care card:wool is protein-based,colour-sensitive;no chlorine treatment. Safety:never mixC with acid or other cleaners. No cleaner experiments.",
      "taskDe": "Begründe die Auswahl für Wolle und weiße Baumwolle aus Funktion und Material, nicht aus „stärker/schwächer“. Erkläre die Funktionen fehlender/enthaltener Komponenten und warum Bleichsysteme nicht austauschbar sind. Weise die gefährliche Säuremischung ausdrücklich zurück und benenne die Grenze der Modellkarten.",
      "taskEn": "Justify choices for wool and white cotton using functions/materials,not“stronger/weaker”. Explain present/absent ingredients and why bleaches are not interchangeable. Reject acid mixing explicitly and state the cards’ limitations.",
      "workedReasoningDe": "Protease kann auch Proteinfasern angreifen; ihr Ausschluss beiW ist materialbezogen. V kann passende Flecken auf dafür geeigneter Baumwolle enzymatisch/oxidativ bearbeiten; Farb- und Pflegehinweise bleiben maßgeblich. Hypochlorit ist ein anderes Oxidationssystem; Ansäuern kann giftiges Chlorgas freisetzen und ist keine sinnvolle Aktivierung. Builder behebt Härteeffekte, ersetzt weder Enzym noch Bleichmittel. Fiktive Inhaltsangaben erlauben eine Funktionsentscheidung, keine reale Produktfreigabe oder sichere Mischanleitung.",
      "workedReasoningEn": "Protease can attack protein fibres;its omission inW is material-specific. V can address suitable stains on compatible cotton enzymatically/oxidatively;colour/care instructions remain binding. Hypochlorite is a different oxidant;acidification can release toxic chlorine and is not useful activation. Builder addresses hardness,not enzyme/bleach functions. Fictional ingredient cards support functional reasoning,not actual product approval or mixing instructions.",
      "freshIndependentTransferDe": "Eine neue Baumwollprobe trägt einen empfindlichen Farbstoff. Revidiere die Auswahl anhand Bleich- und Enzymfunktion, ohne den Fasernamen allein entscheiden zu lassen.",
      "freshIndependentTransferEn": "A new cotton sample carries a sensitive dye. Reconsider using bleach/enzyme functions rather than fibre name alone.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Faser-/Fleckchemie mit passender oder fehlender Komponente verbinden.",
          "observableEn": "Connect fibre/stain chemistry with present/absent ingredients.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "Builder, Enzym und Bleichsystem nicht als austauschbar behandeln.",
          "observableEn": "Do not treat builder,enzyme and bleach as interchangeable.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Sicherheitsgrenze und fehlende reale Produktprüfung ausdrücklich benennen.",
          "observableEn": "Explicitly state safety limits and absence of actual product approval.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    },
    {
      "id": "energy20-18-a",
      "goalId": "c21d430b-424d-5b13-adf6-999f2490d2dc",
      "title": "Zeolith als Ionentauscher",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Eigenes Strukturmodell: Zeo2− besitzt zwei feste negative Gerüstladungen aus zwei AlO4-Einheiten im Alumosilikat; zwei bewegliche Na+ gleichen sie aus. Calcium kann beide Na+ ersetzen. Kapazität1,0mmol Ca²+ pro gZeolith;2,0g werden mit einer Lösung mit3,0mmol Ca²+ in Kontakt gebracht. Idealer vollständiger Austausch bis zur Kapazität, keine Mg²+-Konkurrenz. Keine Zeolithsynthese.",
      "materialsEn": "Own structural model:Zeo2− has two fixed negative framework charges from twoAlO4 units in an aluminosilicate;two mobileNa+ balance them. Calcium replaces bothNa+. Capacity1.0mmolCa²+/g;2.0g contacts a solution with3.0mmolCa²+. Ideal full exchange to capacity,noMg²+ competition. No zeolite synthesis.",
      "taskDe": "Erkläre Struktur und Enthärtungsfunktion, formuliere die Austauschbilanz und berechne verbleibendes Ca²+ sowie freigesetztes Na+. Begründe, warum die negative Gerüstladung bleibt und Wasser nicht durch bloßes Ansäuern enthärtet wird. Dieser Fall prüft nur den ersten der beiden ursprünglichenc21-Inhalte.",
      "taskEn": "Explain structure/softening,write the exchange balance and calculate remainingCa²+/releasedNa+. Explain why framework charge remains and why merely acidifying is not this softening mechanism. This case assesses only the first originalc21 domain.",
      "workedReasoningDe": "ZeoNa2+Ca²+⇌ZeoCa+2Na+. Zwei Na+ kompensieren dieselbe Gerüstladung wie ein Ca²+; das Gerüst wird nicht neutral chemisch zerstört.2g binden höchstens2mmol Ca²+,1mmol bleibt,4mmol Na+ werden frei. Der Prozess tauscht Härteionen, ist keine Säure-Base-Neutralisation und entfernt nicht alle gelösten Ionen. Gleichgewicht, Kinetik, Mg²+ und reale Kapazität sind Modellgrenzen. Diese Leistung belegt keinen mikrobiellen Abbauweg.",
      "workedReasoningEn": "ZeoNa2+Ca²+⇌ZeoCa+2Na+. TwoNa+ compensate the same framework charge as oneCa²+;the framework is not chemically destroyed.2g binds at most2mmolCa²+,leaving1mmol and releasing4mmolNa+. Exchange removes hardness ions,not all dissolved ions,and is not acid-base neutralisation. Equilibrium,kinetics,Mg²+ and real capacity limit the model. This performance does not demonstrate microbial degradation.",
      "freshIndependentTransferDe": "Nun konkurriert1mmol Mg²+ um dieselben Plätze. Begründe, welche Kapazitätsaussage bleibt und welche Ca-Verteilung ohne Selektivitätsdaten nicht eindeutig berechnet werden kann.",
      "freshIndependentTransferEn": "Now1mmolMg²+ competes for the same sites. Identify the surviving capacity statement and the calcium allocation that requires selectivity data.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Feste Gerüstladung und mobile Gegenionen strukturell erklären.",
          "observableEn": "Explain fixed framework charge and mobile counterions.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "Austausch1Ca²+:2Na+ sowie1mmol Rest/4mmol Na+ herleiten.",
          "observableEn": "Derive1Ca²+:2Na+ exchange and1mmol residual/4mmolNa+.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Ionenaustausch von Neutralisation und vom zweitenc21-Abbauziel trennen.",
          "observableEn": "Separate ion exchange from neutralisation and the otherc21 degradation goal.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    },
    {
      "id": "energy20-18-b",
      "goalId": "c21d430b-424d-5b13-adf6-999f2490d2dc",
      "title": "Biologischer Abbau ist mehr als Verschwinden",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Eigenes Stoffmodell: Ein Tensidester hydrolysiert zu langkettiger Hydroxykomponente und Carbonsäurekomponente. Ein freigesetzter linearerC12-Alkohol CH3−(CH2)10−CH2OH oxidiert zuC12-Aldehyd undC12-Säure.β-Oxidation aktivierter Fettsäuren entfernt jeweils2C. Fremddaten:80%Ausgangstensid verschwunden nach7Tagen, aber nur30%des organischenC alsCO2; Rest unbekannt.",
      "materialsEn": "Own model:an ester-containing surfactant first hydrolyses to a long-chain hydroxy component and a carboxylic-acid component. A released linearC12 alcohol CH3−(CH2)10−CH2OH can oxidise to aldehyde thenC12 acid;beta oxidation shortens activated fatty-acid chains by2C per cycle. Supplied data:80%parent disappearance by7days,but only30%organic carbon detected asCO2;remaining distribution unknown.",
      "taskDe": "Beschreibe Hydrolyse, endständige Oxidation undβ-Oxidation mit C-Erhalt und Produktklassen. Beurteilt80%Verschwinden die Mineralisierung? Nenne weitere Messungen; dies prüft den zweitenc21-Inhalt, keine Zeolithstruktur.",
      "taskEn": "Describe hydrolysis,terminal-group oxidation and beta oxidation for the model,tracking carbon/product class. Assess whether80%disappearance proves mineralisation. Specify a genuine further measurement;this assesses the secondc21 domain,not zeolite structure.",
      "workedReasoningDe": "Hydrolyse spaltet unter Wasserverbrauch die Esterbindung. Alkohol→Aldehyd→Säure erhält zunächst12C. Nach Aktivierung entstehen ideal aus einer gesättigtenC12-Kette sechs Acetyl-Einheiten über fünf Verkürzungszyklen. Das ist noch kein vollständigerCO2-Nachweis. Ausgangsstoffentfernung kann Zwischenprodukte, Sorption oder Biomasse einschließen. Benötigt werden C-Bilanz, Produkte und aquatische Wirkungen; Stoff und Bedingungen bestimmen den Weg.",
      "workedReasoningEn": "Ester hydrolysis consumes water and cleaves the ester link;C12 alcohol oxidises throughC12 aldehyde toC12 acid without immediate carbon cleavage. After activation,beta-oxidation cycles removeC2 units;an ideal saturatedC12 chain yields six acetyl units after five shortening cycles. This is not itself completeCO2 measurement.80%primary disappearance can include intermediates,sorption/biomass;30%CO2 does not show full mineralisation. Carbon balance,degradates and aquatic effects are needed;pathways depend on substance/conditions.",
      "freshIndependentTransferDe": "Ein verzweigter Alkylrest ersetzt die lineare Kette. Warum dürfen Weg und Geschwindigkeit nicht ohne neue Daten übertragen werden?",
      "freshIndependentTransferEn": "A branched tail replaces the linear chain. Explain why identical pathway/rate cannot be transferred without evidence.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Hydrolyse/Oxidation mit richtiger Gruppen- undC-Bilanz darstellen.",
          "observableEn": "Describe hydrolysis/oxidation with correct functional-group/carbon accounting.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "C2-Verkürzung von vollständiger Mineralisierung trennen.",
          "observableEn": "DistinguishC2 shortening from complete mineralisation.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "80%Entfernung/30%CO2 und fehlende Zwischenproduktdaten kritisch deuten.",
          "observableEn": "Critically interpret80%disappearance/30%CO2 and missing degradate data.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    },
    {
      "id": "energy20-18-c",
      "goalId": "c21d430b-424d-5b13-adf6-999f2490d2dc",
      "title": "Gesättigter Ionentauscher und Regeneration",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Eigenes Zeolithmodell: Vier feste negative Gerüstladungen werden durch vier Na+ ausgeglichen; nach Austausch sind zwei Ca²+ gebunden. Konzentrierte NaCl-Lösung verschiebt imModell zur Na-Belegung. Freies Ca²+ bleibt inSalzlösung erhalten. Keine Regeneration/Entsorgung als Lernendenversuch.",
      "materialsEn": "Own zeolite model from18a with four fixed negative charges/fourNa+ per drawn unit. Exchange fills it with twoCa²+. ConcentratedNaCl shifts occupancy back in the equilibrium model;releasedCa²+ stays in brine,not destroyed. No learner regeneration/disposal experiment.",
      "taskDe": "Erkläre Sättigung und Regeneration mit Ladung/Gleichgewicht. Bilanzierepro Gerüst und prüfe „entfernt alle Salze für immer“. Welcher Abfall-/Ressourcenrand ist nötig?",
      "taskEn": "Explain saturation/possible regeneration using charge/equilibrium. Balance one framework unit and critique“softener removes all salts forever”. State the required waste/resource boundary.",
      "workedReasoningDe": "ZeoNa4+2Ca²+⇌ZeoCa2+4Na+. Endliche Plätze erklären Sättigung; hohe Na+-Aktivität begünstigt unter Modellannahmen Rückaustausch. Reale Selektivität/Kinetik bleiben wichtig. Ca²+ wird verlagert, nicht vernichtet. NaCl, Spülwasser und Abwasserbehandlung gehören zur Prozessbewertung. Dies belegt keinen Tensidabbau.",
      "workedReasoningEn": "ZeoNa4+2Ca²+⇌ZeoCa2+4Na+. Finite sites explain saturation;highNa+activity can favour reverse exchange,subject to real selectivity/kinetics. Ca²+ is moved into another phase/solution,not eliminated. Salt,rinse water and treatment belong in process assessment;this does not demonstrate microbial surfactant degradation.",
      "freshIndependentTransferDe": "Bei gleicher Porengröße enthält das Gerüst weniger Al. Warum garantiert dies keine gleiche Austauschkapazität?",
      "freshIndependentTransferEn": "A framework has equal pore size but lessAl. Explain from charge balance why equal pores do not guarantee equal exchange capacity.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Gerüstladung, Gegenionenzahl und Sättigung verbinden.",
          "observableEn": "Connect framework charge,counterion count and saturation.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "2Ca²+:4Na+ und reversible Belegung darstellen.",
          "observableEn": "Correctly represent2Ca²+:4Na+ and reversible occupancy.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Salz-/Abwassergrenze ohne vorgetäuschten Stoffabbau benennen.",
          "observableEn": "State salt/wastewater boundaries without pretending matter degrades.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    },
    {
      "id": "energy20-18-d",
      "goalId": "c21d430b-424d-5b13-adf6-999f2490d2dc",
      "title": "Problematische Abbauprodukte eines Ethoxylats",
      "provenance": "Own fictional chemistry teaching model, CC-BY-4.0. Supplied data are not learner observations, official measurements or present product specifications.",
      "imageRequired": false,
      "materialsDe": "Fiktiver Alkylphenolethoxylat-Pfad: langer Ethoxykopf→kürzere Homologe→Alkylphenol. Gefahrenkarte: problematische langsam abbaubare Zwischenprodukte. Tag10:90%Ausgangsstoffentfernung,10%CO2-C, Zwischenprodukte nachgewiesen. EPA dient als Primärbeleg für die Bewertungsdimensionen, nicht als Produktzertifizierung.",
      "materialsEn": "Fictional alkylphenol-ethoxylate pathway:longethoxy parent→shorterethoxy homologues→alkylphenol;the supplied hazard card identifies problematic,more slowly degrading aquatic intermediates. Day10:90%parent removal,10%CO2-carbon and detected intermediates. EPA primary guidance supports the dimensions rate/products/toxicity,not a claimed certification.",
      "taskDe": "Beschreibe den Pfad gegenüber18b und beurteile „90%abbaubar = umweltverträglich“. Welche Messungen/Bedingungen fehlen für eine belastbarere Aussage?",
      "taskEn": "Describe the supplied pathway and compare with the linear-alcohol route18b. Critique“90%degradable means environmentally safe”. What measurements/conditions support a stronger inference?",
      "workedReasoningDe": "Ethoxyverkürzung ist Primärabbau,10%CO2-C keine weitgehende Mineralisierung. Problematische Produkte widerlegen die Ableitung aus Ausgangsstoffentfernung allein. Aromatischer Kern/Verzweigung unterscheiden den Stoff vomlinearenC12-Alkohol; identischeβ-Oxidation ist nicht belegt. C-Verbleib, zeitliche Produktkonzentration, O2, Temperatur, Inokulum undaquatische Wirkung sind erforderlich. EPA-Kriterien sind keine eigene Freigabe.",
      "workedReasoningEn": "Ethoxy-chain shortening is primary degradation;10%CO2-carbon does not show extensive mineralisation. Detected problematic products defeat an inference from parent disappearance alone. The aromatic core/alkyl branching differs from a linearC12 alcohol;identical beta oxidation cannot be claimed without structural evidence. Need carbon fate,time-resolved product concentrations,oxygen/temperature/inoculum and aquatic-effects context;EPA criteria are not copied into product approval.",
      "freshIndependentTransferDe": "Später sorbiert das Alkylphenol anSchlamm, CO2-C bleibt niedrig. Warum müssen Phasenverteilung undchemischer Abbau getrennt gemessen werden?",
      "freshIndependentTransferEn": "After20more days alkylphenol disappears by sorption to sludge whileCO2-carbon stays low. Explain why partitioning and chemical degradation need separate measurements.",
      "criterionToObservableRubric": [
        {
          "criterionId": "e1",
          "observableDe": "Stoffspezifischen Primärabbau anhandgegebener Strukturen beschreiben.",
          "observableEn": "Describe substance-specific primary degradation from given structures.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e2",
          "observableDe": "90%Entfernung/10%CO2 mitproblematischen Produkten deuten.",
          "observableEn": "Correctly interpret90%removal/10%CO2 with concerning intermediates.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        },
        {
          "criterionId": "e3",
          "observableDe": "Mineralisierung, Toxizität und Adsorption getrennt belegen.",
          "observableEn": "Treat mineralisation,toxicity and sorption as separate evidence.",
          "evidenceBoundary": "Actual independent learner reasoning remains unobserved; answer key alone is not evidence."
        }
      ]
    }

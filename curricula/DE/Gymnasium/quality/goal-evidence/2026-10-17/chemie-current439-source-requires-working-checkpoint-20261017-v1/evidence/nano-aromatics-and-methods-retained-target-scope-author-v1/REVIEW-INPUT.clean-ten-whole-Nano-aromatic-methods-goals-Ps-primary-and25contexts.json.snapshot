      },
      "wholeDeck": {
        "deckId": "de_gymnasium_chemistry_equilibria_q3",
        "title": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
        "cards": [
          {
            "id": "chem_eq_q3_001",
            "front": "Massenwirkungsgesetz: Grundform?",
            "back": "Für $aA+bB \\rightleftharpoons cC+dD$ gilt näherungsweise:\n\n$K_c=\\frac{c(C)^c\\,c(D)^d}{c(A)^a\\,c(B)^b}$",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:20f92ba0-f7f4-5407-bb96-07e30da9002f",
              "select:chemistry-bw-lk-equilibria_q3"
            ]
          },
          {
            "id": "chem_eq_q3_002",
            "front": "Le-Chatelier-Prinzip?",
            "back": "Ein Gleichgewicht reagiert auf äußeren Zwang so, dass die Störung teilweise abgeschwächt wird.",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:5a24dae0-6d33-5227-8d8b-e8f74c2ccc4c",
              "select:chemistry-bw-lk-equilibria_q3"
            ]
          },
          {
            "id": "chem_eq_q3_003",
            "front": "Ionenprodukt des Wassers?",
            "back": "$K_w=[H_3O^+]\\,[OH^-]$\n\nBei $25^\\circ C$ gilt näherungsweise $K_w=10^{-14}\\,\\mathrm{mol^2/L^2}$.",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:07879ea2-b6a1-5eb3-b548-15d45bbcb227",
              "select:chemistry-bw-lk-equilibria_q3"
            ]
          },
          {
            "id": "chem_eq_q3_004",
            "front": "pH und pOH?",
            "back": "$pH=-\\log[H_3O^+]$\n\n$pOH=-\\log[OH^-]$\n\nBei $25^\\circ C$: $pH+pOH=14$",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:f1ed86f0-534d-57d7-8952-a004a331cc54",
              "goal:acdfc7d7-6d6b-5a1f-837c-79449c29a305",
              "goal:edcfc5f0-900d-5819-830f-3b14af2bc369",
              "select:chemistry-bw-lk-equilibria_q3",
              "select:chemistry-ph-poh-relations-only"
            ]
          },
          {
            "id": "chem_eq_q3_005",
            "front": "pKS und pKB: Merksatz?",
            "back": "$pK_S=-\\log K_S$, $pK_B=-\\log K_B$\n\nJe kleiner der pKS-Wert, desto stärker die Säure.",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:48115ff7-7aca-5d0b-a9e7-7fc6c78434ef",
              "select:chemistry-bw-lk-equilibria_q3"
            ]
          },
          {
            "id": "chem_eq_q3_006",
            "front": "Henderson-Hasselbalch-Gleichung?",
            "back": "$pH=pK_S+\\log\\frac{c(A^-)}{c(HA)}$\n\nfür einen Puffer aus schwacher Säure und korrespondierender Base.",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:a449e874-6fec-502b-9667-6f078adc4d64",
              "select:chemistry-bw-lk-equilibria_q3",
              "select:chemistry-henderson-hasselbalch-only"
            ]
          },
          {
            "id": "chem_eq_q3_007",
            "front": "Nernst-Gleichung für eine als Reduktion geschriebene Halbgleichung: Formel und Reaktionsquotient?",
            "back": "$E=E^\\circ-\\frac{RT}{zF}\\ln Q$; bei $25^\\circ\\mathrm{C}$ näherungsweise $E=E^\\circ-\\frac{0{,}05916\\,\\mathrm{V}}{z}\\log_{10}Q$.\n\n$Q$ enthält die Aktivitäten der Produkte geteilt durch die der Edukte, jeweils mit den stöchiometrischen Koeffizienten als Potenzen; Elektronen werden nicht eingesetzt. Reine feste Stoffe und reine Flüssigkeiten haben in ihrem Standardzustand die Aktivität 1.\n\nFür $\\mathrm{Ox}+ze^-\\rightleftharpoons\\mathrm{Red}$ ist $Q=a(\\mathrm{Red})/a(\\mathrm{Ox})$. Für $\\mathrm{Cu}^{2+}+2e^-\\rightleftharpoons\\mathrm{Cu}(s)$ gilt daher $Q=1/a(\\mathrm{Cu}^{2+})$.\n\nDie dimensionslose Aktivität lässt sich nur im passenden verdünnten idealen Lösungsmodell durch $c/c^\\circ$ annähern; Konzentrations- und Aktivitätsform nicht unbesehen vermischen.",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:b7521ac7-4ad1-5e63-96ca-4c6c9b2b1e0b",
              "select:chemistry-bw-lk-equilibria_q3"
            ]
          },
          {
            "id": "chem_eq_q3_008",
            "front": "Faraday-Beziehung für Elektrolyse?",
            "back": "$Q=I\\cdot t=z\\cdot F\\cdot n$\n\n$F\\approx 96485\\,\\mathrm{C/mol}$",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:b8c8f70f-64cb-50b1-970c-e0c4295da3fb"
            ]
          },
          {
            "id": "chem_eq_q3_009",
            "front": "Elektrochemische Spannungsreihe: Vorzeichen-Deutung?",
            "back": "Je positiver das Standardpotenzial, desto stärker wirkt die oxidierte Form als Oxidationsmittel.",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:8be14f15-2258-58e6-ae4e-38953f5d0570",
              "select:chemistry-bw-lk-equilibria_q3"
            ]
          },
          {
            "id": "chem_eq_q3_010",
            "front": "Arrhenius-Beziehung?",
            "back": "$k=A\\,e^{-E_A/(RT)}$\n\nIm $\\ln k$ gegen $1/T$-Diagramm ist die Steigung $-E_A/R$.",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:e62c6c58-b688-59c3-8ac5-2cfc26ac22d7"
            ]
          },
          {
            "id": "chem_eq_q3_011",
            "front": "Löslichkeitsprodukt: Grundidee?",
            "back": "Für ein Salzgleichgewicht ist $K_L$ das Produkt der Ionenkonzentrationen in der gesättigten Lösung, jeweils mit stöchiometrischem Exponenten.",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "GK",
              "LK",
              "goal:ac1bcf34-169c-5339-92ba-efe8c3022560",
              "select:chemistry-bw-lk-equilibria_q3"
            ]
          },
          {
            "id": "chem_eq_q3_012",
            "front": "Erstes Faraday-Gesetz: Wie hängen bei derselben Elektrodenreaktion Ladung und Stoff-/Massenumsatz zusammen?",
            "back": "Bei unveränderter Elektrodenreaktion und gleicher Stromausbeute ist der umgesetzte Stoff proportional zur dafür durchgesetzten Ladung. Für denselben Stoff gilt das auch für seine Masse. Mehr Gesamtladung allein genügt bei wechselnden Nebenreaktionen nicht.",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "goal:0e3f849b-133d-57da-882c-0d67c3eb05b8"
            ]
          },
          {
            "id": "chem_eq_q3_013",
            "front": "Zweites Faraday-Gesetz: Was bestimmt bei gleicher für die Reaktion genutzter Ladung Stoffmenge und Masse verschiedener Produkte?",
            "back": "Gleiche Ladung liefert die gleiche Elektronenmenge. Je mehr Elektronen pro Produktteilchen benötigt werden, desto weniger Teilchen und Stoffmenge entstehen. Die Produktmasse hängt zusätzlich von der molaren Masse ab: gleiche Stoffmenge verschiedener Stoffe bedeutet nicht gleiche Masse. Die Reaktion und Stromausbeute müssen festliegen.",
            "category": "Chemie Q3 - Gleichgewichte, Säure-Base und Elektrochemie",
            "tags": [
              "goal:0e3f849b-133d-57da-882c-0d67c3eb05b8"
            ]
          }
        ]
      }
    },
    {
      "pin": {

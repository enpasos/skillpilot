    {
      "goalId": "cc803809-fa7f-517c-b356-9f2f7caf21a5",
      "caseId": "eqrk16-02-b",
      "wholeCurrentCaseBrief": {
        "id": "eqrk16-02-b",
        "taskDemandDe": "Vollständiges eigenes Material: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-equilibrium-redox-kinetics16-current422-whole-material-author-20261015-v1/materials/thirty-two-whole-DE-EN-cases.final-science-and-prose.author.json #eqrk16-02-b; sha256:86dc6b7640368abf7dbd12b51f4cdf48aba1731f7f543169a30c14261c3ccd2e. Leite Teilgleichungen und Elektronenbilanz selbst ab. Vergleiche beide scheinbaren molaren Wärmen und prüfe die Herstellerbehauptung. Entwirf eine unabhängige Kontrolle, die Wärmeverlust von unvollständigem Umsatz trennt. Begründe, warum Fe3+ hier Akzeptor ist, obwohl metallisches Eisen in anderen Zellen Donator sein kann.",
        "taskDemandEn": "Complete own material: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-equilibrium-redox-kinetics16-current422-whole-material-author-20261015-v1/materials/thirty-two-whole-DE-EN-cases.final-science-and-prose.author.json #eqrk16-02-b; sha256:86dc6b7640368abf7dbd12b51f4cdf48aba1731f7f543169a30c14261c3ccd2e. Derive half-reactions and electron balance. Compare the two apparent molar heats and assess the supplier claim. Design an independent control distinguishing heat loss from incomplete conversion. Explain why Fe3+ accepts electrons here although iron metal can donate electrons elsewhere.",
        "expectedPerformanceDe": "Zn→Zn2++2e− und 2 Fe3++2e−→2Fe2+. q=916J bzw. 709,9 J; scheinbare molare Werte −183,2 bzw. −142,0 kJ/mol Zn. Unterschiedliche Isolation verändert Wärmeabgabe an ungemessene Umgebung; sie beweist keinen anderen Reaktionszustandsunterschied. Temperatur-Zeit-Kurven, Kalibrierung und unabhängige Bestimmung des verbliebenen Zn oder gebildeten Fe2+ würden Wärmeverlust/Umsatz auseinanderhalten. Rollen gehören zu konkreten Redoxpaaren und Zuständen: Fe3+ wird reduziert; Fe0 kann zu Fe2+ oxidieren. Keine Gleichsetzung der Werte mit Aktivierungsenergien oder einer isolierten Elektronenenergie.",
        "expectedPerformanceEn": "Zn→Zn2++2e− and 2 Fe3++2e−→2Fe2+. Heat is 916 J versus 709.9 J, giving apparent −183.2 versus −142.0 kJ/mol Zn. Insulation changes heat loss into unmeasured surroundings; it does not establish a different reaction state-function change. Temperature/time curves, calibration, and independent measurement of remaining Zn or produced Fe2+ distinguish heat loss from conversion. Roles refer to particular couples/states:Fe3+ is reduced; Fe0 can be oxidised to Fe2+. Neither value is an activation energy or isolated “electron energy”.",
        "understandingFocusDe": "Bei konstantem Volumen ohne elektrische Arbeit wird Qv gemessen. Erläutere, welche zusätzliche Annahme eine Bezeichnung als ΔH erfordern würde, statt Qv automatisch gleichzusetzen.",
        "understandingFocusEn": "At fixed volume without electrical work Qv is measured. Explain which additional assumption is needed before labelling it ΔH rather than automatically equating them."
      },
      "originalWholeMaterialSources": [
        {
          "pin": {
            "path": "/home/enpasos/projects/skillpilot/curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-equilibrium-redox-kinetics16-current422-whole-material-author-20261015-v1/materials/thirty-two-whole-DE-EN-cases.final-science-and-prose.author.json",
            "sha256": "86dc6b7640368abf7dbd12b51f4cdf48aba1731f7f543169a30c14261c3ccd2e",
            "bytes": 165052
          },
          "wholeOriginalCase": {
            "id": "eqrk16-02-b",
            "goalId": "cc803809-fa7f-517c-b356-9f2f7caf21a5",
            "title": "Wärmeverlust und andere Akzeptorstufe",
            "provenance": "Own fictional teaching data/model, CC-BY-4.0. Not actual learner work, laboratory observations, official measurements, or current product specifications. Numerical constants are supplied teaching values under the stated conditions.",
            "imageRequired": false,
            "materialsDe": "Datenmodell einer vorbereiteten sauren Lösung: Zn + 2 Fe3+ → Zn2+ + 2 Fe2+, mit Fe3+-Überschuss und 0,00500 mol umgesetztem Zn. Die effektive Wärmekapazität beträgt 229 J/K. Ein isoliertes Modellgerät zeigt ΔT = 4,00 K, ein weniger isoliertes ΔT = 3,10 K. Anfangstemperatur und Stoffmengen sind gleich. Ein Hersteller behauptet, die niedrigere Temperatur beweise kleinere chemische Reaktionsenergie. Keine Schülerzubereitung saurer Metallsalzlösungen.",
            "materialsEn": "Data model of a prepared acidic solution: Zn + 2 Fe3+ → Zn2+ + 2 Fe2+, with excess Fe3+ and 0.00500 mol Zn converted. Effective heat capacity is 229 J/K. An insulated model apparatus gives ΔT = 4.00 K; a less insulated one gives 3.10 K. Initial temperature and quantities are identical. A supplier claims the lower temperature proves smaller chemical reaction energy. Students do not prepare acidic metal-salt solutions.",
            "taskDe": "Leite Teilgleichungen und Elektronenbilanz selbst ab. Vergleiche beide scheinbaren molaren Wärmen und prüfe die Herstellerbehauptung. Entwirf eine unabhängige Kontrolle, die Wärmeverlust von unvollständigem Umsatz trennt. Begründe, warum Fe3+ hier Akzeptor ist, obwohl metallisches Eisen in anderen Zellen Donator sein kann.",
            "taskEn": "Derive half-reactions and electron balance. Compare the two apparent molar heats and assess the supplier claim. Design an independent control distinguishing heat loss from incomplete conversion. Explain why Fe3+ accepts electrons here although iron metal can donate electrons elsewhere.",
            "workedReasoningDe": "Zn→Zn2++2e− und 2 Fe3++2e−→2Fe2+. q=916J bzw. 709,9 J; scheinbare molare Werte −183,2 bzw. −142,0 kJ/mol Zn. Unterschiedliche Isolation verändert Wärmeabgabe an ungemessene Umgebung; sie beweist keinen anderen Reaktionszustandsunterschied. Temperatur-Zeit-Kurven, Kalibrierung und unabhängige Bestimmung des verbliebenen Zn oder gebildeten Fe2+ würden Wärmeverlust/Umsatz auseinanderhalten. Rollen gehören zu konkreten Redoxpaaren und Zuständen: Fe3+ wird reduziert; Fe0 kann zu Fe2+ oxidieren. Keine Gleichsetzung der Werte mit Aktivierungsenergien oder einer isolierten Elektronenenergie.",
            "workedReasoningEn": "Zn→Zn2++2e− and 2 Fe3++2e−→2Fe2+. Heat is 916 J versus 709.9 J, giving apparent −183.2 versus −142.0 kJ/mol Zn. Insulation changes heat loss into unmeasured surroundings; it does not establish a different reaction state-function change. Temperature/time curves, calibration, and independent measurement of remaining Zn or produced Fe2+ distinguish heat loss from conversion. Roles refer to particular couples/states:Fe3+ is reduced; Fe0 can be oxidised to Fe2+. Neither value is an activation energy or isolated “electron energy”.",
            "freshIndependentTransferDe": "Bei konstantem Volumen ohne elektrische Arbeit wird Qv gemessen. Erläutere, welche zusätzliche Annahme eine Bezeichnung als ΔH erfordern würde, statt Qv automatisch gleichzusetzen.",
            "freshIndependentTransferEn": "At fixed volume without electrical work Qv is measured. Explain which additional assumption is needed before labelling it ΔH rather than automatically equating them.",
            "criterionToObservableRubric": [
              {
                "criterionId": "e1",
                "observableDe": "Fe3+/Fe2+ und Zn/Zn2+ statt pauschaler Elementrollen verwenden.",
                "observableEn": "Use actual redox couples rather than fixed elemental roles.",
                "points": 4,
                "evidenceBoundary": "Future independent reasoning is not yet observed; solution text and a score alone never demonstrate mastery."
              },
              {
                "criterionId": "e2",
                "observableDe": "Beide scheinbaren molaren Wärmen auf gleichen Umsatz beziehen.",
                "observableEn": "Compare apparent molar heats on the same conversion basis.",
                "points": 4,
                "evidenceBoundary": "Future independent reasoning is not yet observed; solution text and a score alone never demonstrate mastery."
              },
              {
                "criterionId": "e3",
                "observableDe": "Kontrolle zur Trennung von Wärmeverlust und Stoffumsatz entwerfen.",
                "observableEn": "Design a control separating heat loss from conversion.",
                "points": 4,
                "evidenceBoundary": "Future independent reasoning is not yet observed; solution text and a score alone never demonstrate mastery."
              }
            ],
            "scoring": {
              "maximumPoints": 12,

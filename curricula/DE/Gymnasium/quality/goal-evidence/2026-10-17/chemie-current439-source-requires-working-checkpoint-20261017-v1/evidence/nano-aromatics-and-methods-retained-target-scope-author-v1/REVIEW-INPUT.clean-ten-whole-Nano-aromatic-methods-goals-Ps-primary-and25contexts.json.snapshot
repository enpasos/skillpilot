      },
      "wholeProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Bei gleicher Form steigt das Verhältnis Oberfläche/Volumen mit abnehmender Teilchengröße.",
            "essentialUnderstandingEn": "For a fixed shape, surface-to-volume ratio increases as particle size decreases.",
            "observablePerformanceDe": "Berechnet Größenverhältnisse mit konsistenten Einheiten und erklärt einen Oberflächeneffekt.",
            "observablePerformanceEn": "Calculates size ratios with consistent units and explains a surface effect."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Benetzung hängt von Oberflächenchemie und Struktur ab; Rauheit allein garantiert keinen Lotos-Effekt.",
            "essentialUnderstandingEn": "Wetting depends on surface chemistry and structure; roughness alone does not guarantee a lotus effect.",
            "observablePerformanceDe": "Trennt Größen-, Chemie- und Struktureffekte durch geeignete Vergleichsproben.",
            "observablePerformanceEn": "Separates size, chemistry and structure effects using appropriate controls."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "Nanoskalige Eigenschaften ermöglichen Anwendungen, während Risiko auch Freisetzung und Exposition benötigt.",
            "essentialUnderstandingEn": "Nanoscale properties enable applications while risk also depends on release and exposure.",
            "observablePerformanceDe": "Bewertet eine neue Anwendung anhand von Nutzen, Exposition und fehlenden Daten.",
            "observablePerformanceEn": "Assesses a new application using benefit, exposure and missing evidence."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",
            "e2",
            "e3"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "v1",
            "textDe": "Teilchengröße bei gleicher Form",
            "textEn": "Particle size at constant shape"
          },
          {
            "id": "v2",
            "textDe": "Chemie bei geänderter Rauheit",
            "textEn": "Chemistry with altered roughness"
          },
          {
            "id": "v3",
            "textDe": "Gebundenes oder freigesetztes Material",
            "textEn": "Bound or released material"
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "dfbccd62-case-1",
            "taskDemandDe": "Berechne A/V und Verhältnis. Erkläre die Benetzungsdaten mit kontrollierten Vergleichen. Beurteile selbstreinigende Regenbekleidung: Welche Aussage ist belegt und welcher Test fehlt?",
            "taskDemandEn": "Calculate A/V and the ratio. Explain wetting data using controlled comparisons. Assess self-cleaning rainwear: what is supported and which test is missing?",
            "expectedPerformanceDe": "20 nm: 3·10^8 m⁻¹; 2 µm: 3·10^6 m⁻¹; Verhältnis 100. Mehr Oberfläche je Volumen kann Oberflächenreaktionen verstärken, beweist aber keine konkrete Toxizität. Gleiche methylhaltige Chemie zeigt Strukturwirkung; hydrophile Kontrolle widerlegt Rauheit als alleinige Ursache.155° stützt starke Wasserabweisung; Lotos-Selbstreinigung verlangt Abrollen, Schmutzabtrag und Abriebfestigkeit.",
            "expectedPerformanceEn": "20 nm: 3·10^8 m⁻¹; 2 µm: 3·10^6 m⁻¹; ratio 100. More surface per volume may enhance surface reactions but proves no specific toxicity. Constant methyl-bearing chemistry demonstrates structure effects; the hydrophilic control disproves roughness as a sufficient cause.155° supports strong water repellency; lotus self-cleaning additionally needs roll-off, dirt-removal and abrasion tests.",
            "understandingFocusDe": "Fallbezogene Aspekte: A/V: 3·10⁸ und 3·10⁶ m⁻¹, Verhältnis 100; Einheiten werden korrekt umgerechnet. / 105°→155° vergleicht gleiche Chemie; rau hydrophil 30° zeigt, dass Rauheit allein nicht genügt. / 155° stützt Wasserabweisung; Abrollen, Schmutzabtrag und Abrieb werden als fehlende Prüfungen genannt. Die Verknüpfung zu Erwartungs-IDs behauptet keine vollständige Erfüllung jeder Gesamtprofilerwartung in diesem Einzelfall.",
            "understandingFocusEn": "Case-specific aspects: A/V: 3·10⁸ and 3·10⁶ m⁻¹, ratio 100; units correctly converted. / 105°→155° compares constant chemistry; rough hydrophilic 30° shows roughness alone is insufficient. / 155° supports water repellency; roll-off, dirt removal and abrasion are identified as missing tests. Links to expectation IDs do not assert complete fulfilment of every whole-profile expectation in this one case."
          },
          {
            "id": "dfbccd62-case-2",
            "taskDemandDe": "Vergleiche Oberfläche und Umsatz. Wähle eine Variante für einen geschlossenen Filter und begründe Nutzen-Risiko-Abwägung. Entwirf eine Kontrolle, die Größenwirkung von Fixierungswirkung trennt.",
            "taskDemandEn": "Compare surface and conversion. Select for a closed filter and justify benefit-risk trade-offs. Design a control separating particle-size effects from immobilisation effects.",
            "expectedPerformanceDe": "Nanokugeln haben bei gleicher Materialmenge zehnfaches A/V. Die Daten sind mit höherer Oberflächenwirkung vereinbar, belegen den Mechanismus nicht allein. Fixierte Nanopartikel bieten 70% Umsatz bei stark geringerer Freisetzung als lose; vorläufig bevorzugt, kein Sicherheitsbeweis. Ergänze lose 300 nm-Probe bei gleicher Beladung, Messunsicherheit und Wiederholungen; untersuche Freisetzung nach Alterung und reale Exposition.",
            "expectedPerformanceEn": "Nanoparticles have tenfold A/V at equal material quantity. Data are consistent with stronger surface effects but do not alone prove the mechanism. Immobilised nanoparticles provide 70% conversion with far less release than loose ones; provisionally preferred, without establishing safety. Add a loose 300 nm control at equal loading, measurement uncertainty and replicates; assess ageing-related release and actual exposure.",
            "understandingFocusDe": "Fallbezogene Aspekte: 30-nm-Kugeln haben zehnfaches A/V; Umsatz allein beweist den Oberflächenmechanismus nicht. / Lose 300-nm-Kontrolle bei gleicher Beladung trennt Größe von Fixierung; Unsicherheit/Wiederholungen ergänzen. / Fixierte Nano-Probe vorläufig: 70%/0.2 mg gegen 80%/12 mg; Freisetzung ist kein Sicherheitsbeweis, Exposition/Alterung prüfen. Die Verknüpfung zu Erwartungs-IDs behauptet keine vollständige Erfüllung jeder Gesamtprofilerwartung in diesem Einzelfall.",
            "understandingFocusEn": "Case-specific aspects: 30-nm spheres have tenfold A/V; conversion alone does not prove the surface mechanism. / Loose 300-nm control at equal loading separates size from immobilisation; add uncertainty/replicates. / Immobilised nano provisionally: 70%/0.2 mg versus 80%/12 mg; release is not proof of safety, test exposure/ageing. Links to expectation IDs do not assert complete fulfilment of every whole-profile expectation in this one case."
          }
        ]
      },

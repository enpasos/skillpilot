        "resourceLinks": [
          {
            "type": "goal-visualization",
            "resourceType": "image",
            "role": "primary",
            "skillpilotId": "4928d5d1-e790-5883-9349-3b03a1c63b99",
            "title": "Visualisierung: Innere Energie und Enthalpie in Reaktionssystemen abgrenzen",
            "url": "/assets/goal-visualizations/chemie/4928d5d1-e790-5883-9349-3b03a1c63b99/4928d5d1-e790-5883-9349-3b03a1c63b99.jpg",
            "provider": "Google Gemini / Nano Banana Pro (gemini-3-pro-image)",
            "description": "Visualisierung zum Lernziel: Innere Energie und Enthalpie in Reaktionssystemen abgrenzen.",
            "altText": "Zwei geschlossene Modelle mit Wärmeaustausch und ausschließlich Volumenarbeit: Links bleibt das Volumen im starren Gefäß konstant, es gibt keine Volumenarbeit und die aufgenommene Wärme ist Qv=ΔU. Rechts zeigt ein beweglicher Kolben konstanten, mechanisch ausgeglichenen Druck; bei Expansion gibt das System Volumenarbeit ab, W=−pΔV. Für dieses Modell gilt Qp=ΔH und ΔH=ΔU+pΔV. Die Änderungssymbole beziehen sich auf Energieänderungen; das Bild behandelt keine zusätzlichen Arbeitsformen.",
            "lang": "de",

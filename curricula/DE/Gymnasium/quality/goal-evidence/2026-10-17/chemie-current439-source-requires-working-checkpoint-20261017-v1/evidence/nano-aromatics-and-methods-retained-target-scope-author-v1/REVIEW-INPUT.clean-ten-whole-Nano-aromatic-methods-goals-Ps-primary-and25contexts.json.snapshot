      "pin": {
        "path": "/mnt/e/skillpilot-chemie-L7-20261017/current650-post20-P439-SEM-paired-context-final-technical-b-v1/capsule/curricula/DE/Gymnasium/memory-decks/de_gymnasium_chemistry_flashcards_energy_q4.de.json",
        "sha256": "8cfc9af529b3678a76720c9f6e27817e7fe5b9b827bdc5e0aca4f129c46cc8ce",

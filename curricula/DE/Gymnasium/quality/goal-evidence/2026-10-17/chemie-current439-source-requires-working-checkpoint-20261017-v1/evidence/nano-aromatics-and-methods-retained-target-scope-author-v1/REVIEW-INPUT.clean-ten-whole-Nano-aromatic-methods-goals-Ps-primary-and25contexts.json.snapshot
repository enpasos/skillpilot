    {
      "pin": {
        "path": "/mnt/e/skillpilot-chemie-L7-20261017/current650-post20-P439-SEM-paired-context-final-technical-b-v1/capsule/curricula/DE/Gymnasium/memory-decks/de_gymnasium_chemistry_flashcards_basics_seki.de.json",
        "sha256": "6a570184020b09f68957c0a30177f187496deef7cfa66db1fc419fa8ecfd5a1f",

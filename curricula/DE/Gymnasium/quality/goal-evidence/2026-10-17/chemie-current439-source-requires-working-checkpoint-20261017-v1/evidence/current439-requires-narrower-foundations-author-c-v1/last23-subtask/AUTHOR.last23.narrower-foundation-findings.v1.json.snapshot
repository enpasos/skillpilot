  "findings": [
    {
      "docketIndex": 24,
      "goalId": "9b56d01e-c2d7-51d8-b78e-237592c1ed20",
      "title": "Einfache Bindungswinkel mit dem EPA-Modell erklären",
      "authorDisposition": "keep_removal_no_addition",
      "addExistingPrerequisiteIds": [],
      "hold": false,
      "holds": [],
      "wholePerformanceRationaleDe": "Alle Gestalten, Elektronendomänen, freie Paare und Referenzwinkel sind im aktuellen P vorgegeben. Eigenleistung ist Winkelzuordnung, qualitative Kompression und Idealisierungsgrenze; Gestaltableitung ist ausdrücklich ausgeschlossen. Die alte komplette EPA-Gestaltkompetenz und ihre entfernten Massen-/Labor-/Darstellungsahnen sind dafür kein vorgängiger Erwerb.",
      "meaningfulCounterexampleBoundaryDe": "Eine Person ordnet die gegebenen vier Domänen zu109,5° und begründet kleinere NH3/H2O-Winkel, ohne selbst Lewisbilder oder eine Molekülgestalt abzuleiten.",
      "acquisitionBoundaryDe": "Das Lesen der ausdrücklich benannten Domänen und freien Paare wird am gegebenen Modell innerhalb dieses Winkelziels eingeführt; keine vorgängige vollständige Formelproduktion oder Mesomerie nötig.",
      "removedDirectPrerequisiteIdsNotRestored": [
        "67cd332f-9db7-50e1-87f6-172ef3714300"
      ],
      "retainedEffectivePrerequisiteIds": [],
      "retainedCoveragePaths": [],

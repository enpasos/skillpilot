    {
      "docketIndex": 40,
      "goalId": "8be14f15-2258-58e6-ae4e-38953f5d0570",
      "title": "Spannungsreihen nutzen",
      "authorDisposition": "add_existing_narrower_foundation",
      "addExistingPrerequisiteIds": [
        "04fa0ba1-eb6e-53c8-93d4-dfa28bb4b162"
      ],
      "hold": false,
      "holds": [],
      "wholePerformanceRationaleDe": "Das ganze P verlangt aus Standard-Reduktionspotenzialen eine freiwillige Reaktion, eigene Halb-/Gesamtgleichungen, Anode/Kathode und gekoppelten äußeren Elektronen-/inneren Ionenfluss sowie Referenzverschiebung. Nach Entfernung der experimentellen16da6a4d bleibt nur Orientierung.04fa0ba1 ist der engere vorhandene begriffliche Erwerb von Elektronenabgabe/-aufnahme, beiden gekoppelten Mitteln und Rollen; diese Grundlage wird zur neuen quantitativen Referenz-/Potenzialdarstellung gebraucht, ohne Messungen oder eigene Reihenaufstellung zu verlangen.",
      "meaningfulCounterexampleBoundaryDe": "Eine Person subtrahiert+0,34−(−0,76)=1,10V korrekt, nennt aber Zn das Oxidationsmittel oder lässt beide Halbzellen Elektronen abgeben. Zahlenrechnung allein erfüllt das ganze Ziel nicht. Wer04 beherrscht, muss umgekehrt noch keine experimentelle Redoxreihe selbst erstellt haben.",
      "acquisitionBoundaryDe": "SHE, Standardzustand, Differenzbildung, Referenzwechsel und Elektroden-/Ionenwege sind neue Inhalte im eigenen Ziel. Grundlegende gekoppelte Redoxrollen sollen dagegen vor dem Arbeiten mit Reduktionspotenzialen gesichert sein: nur04fa0ba1 ergänzen.",
      "removedDirectPrerequisiteIdsNotRestored": [
        "16da6a4d-8e9c-5f5d-b69d-338d67a2d362"
      ],

    {
      "docketIndex": 28,
      "goalId": "5851b53a-162b-5c17-9269-510ee54ad846",
      "title": "Oxidationsprodukte von Alkanolen erklären",
      "authorDisposition": "keep_removal_no_addition",
      "addExistingPrerequisiteIds": [],
      "hold": false,
      "holds": [],
      "wholePerformanceRationaleDe": "Die Ethanol-Produktfolge und der frische Propan-2-ol-Fall geben geeignete Ausgangsstrukturen und Oxidationsbedingungen. Eigenleistung ist der Wechsel OH→Carbonyl und gegebenenfalls COOH, mit Grenzen am sekundären Gerüst. Das entfernt geprüfte gesamte Dreiklassen-Oxidierbarkeitsranking, besonders tertiäre Alkanole, ist hierfür keine vorherige Pflicht.",
      "meaningfulCounterexampleBoundaryDe": "Die Person zeichnet Ethanal/Ethansäure und Propanon begründet, muss aber kein vollständiges primär/sekundär/tertiär-Vergleichsfeld vorab abgeschlossen haben.",
      "acquisitionBoundaryDe": "Die hier benötigte Unterscheidung primärer und sekundärer lokaler OH-C-Struktur wird beim Produktlernen eingeführt; vier organische Stoffklassen vollständig klassifizieren oder alle Alkanole benennen wäre ein weiterer Erwerb.",
      "removedDirectPrerequisiteIdsNotRestored": [
        "858d56e0-ab8f-51a4-b07e-7d9d94cab8e2"
      ],

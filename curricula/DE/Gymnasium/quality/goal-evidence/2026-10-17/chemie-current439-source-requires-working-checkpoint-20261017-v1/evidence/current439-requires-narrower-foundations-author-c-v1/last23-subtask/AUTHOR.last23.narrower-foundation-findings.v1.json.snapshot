    {
      "docketIndex": 35,
      "goalId": "2fac2f0e-bccc-5511-b9fb-cc1bc3aeed00",
      "title": "Magensäurebildung und Protonenpumpen-Hemmer erklären",
      "authorDisposition": "keep_removal_no_addition",
      "addExistingPrerequisiteIds": [],
      "hold": false,
      "holds": [],
      "wholePerformanceRationaleDe": "Das P liefert Protonenquellgleichgewicht, Pumpenaustausch, separaten Chloridfluss, Idealmengen/Volumina, vollständige HCl-Dissoziation und pH-Formel. Die angegebene NCI-Definition wird tatsächlich geöffnet: sie nennt ATPase-Hemmung und H+-Transport, keine Neutralisation. Eigenleistung ist chemische Modellbilanz/Quellenaussage, nicht das komplette Verdauungssäfte-/Nährstoff- oder praktische pH-Paket.",
      "meaningfulCounterexampleBoundaryDe": "Die Person belegt den Pumpenmechanismus an der angegebenen Definition und berechnet1,921/1,991 bzw2,222/2,097, kann aber die Rolle der Galle bei Fettverdauung nicht erklären.",
      "acquisitionBoundaryDe": "Den begrenzten Unterschied H+-Transport versus H+-Verbrauch und HCl-Ionenmodell führt dieses Ziel selbst ein; Gleichung, pH-Routine und Quellenort sind gegeben. Eigene ungerichtete komplexe Recherche, vollständige Brønsted-Strukturchemie oder Lösungsvorbereitung sind keine vorgängige Pflicht.",
      "removedDirectPrerequisiteIdsNotRestored": [
        "3681e688-7880-5bb4-9ab9-ef78289345c8"
      ],
      "retainedEffectivePrerequisiteIds": [],
      "retainedCoveragePaths": [],

        },
        {
          "id": "e2",
          "essentialUnderstandingDe": "PPI hemmen die H⁺/K⁺-ATPase; vorhandene Säure wird dadurch nicht stöchiometrisch neutralisiert.",
          "observablePerformanceDe": "Leitet aus einem Mechanismusbeleg die Wirkung auf neue Säuresekretion ab."
        },
        {
          "id": "e3",
          "essentialUnderstandingDe": "Modellbilanz und Quellenbefund erlauben eine begrenzte chemische Schlussfolgerung.",
          "observablePerformanceDe": "Berechnet Modellkonzentrationen und trennt diese von klinischer Wirkung/Anwendung."
        }
      ],
      "coverageExpectations": {

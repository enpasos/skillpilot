  "synthesis": {
    "synthesisId": "chemie-current12-native-paired-38e30bb9-6145-5da0-80b8-36e3c45e15d0-20261017-v1",
    "authority": "ai_synthesis",
    "synthesizedBy": "Codex technical assembler of actual fresh independent native A/B D12; no new scientific review or human attestation",
    "synthesizedAt": "2026-10-17T10:22:02.737Z",
    "rationaleDe": "Technische Zusammenführung der beiden tatsächlich abgeschlossenen, unabhängigen nativen D-Reviews: Beide behalten den exakten aktuellen deutschen und englischen Zieltext bei. Die Evidence-Fassung der zweiten Runde wird unverändert übernommen; beide Originalrecords bleiben vollständig gebunden. Es entsteht kein neues fachliches Review und keine Freigabe anderer Gates.",
    "rationaleEn": "Technical assembly of the two actually completed independent native D reviews: both retain the exact current German and English goal wording. The second round evidence is retained verbatim and both complete original records remain bound. This adds no scientific review and approves no other gate.",
    "understandingEvidence": {
      "essentialUnderstandingDe": "Chemisches Präsentieren verbindet fachlichen Gegenstand und eigene Arbeit mit einer begründeten Auswahl von Aufbau, Darstellung und analogen sowie digitalen Medien für eine konkrete Zielgruppe.",
      "essentialUnderstandingEn": "Presenting chemistry connects subject matter and own work with justified structure, representations and analogue and digital media for a specific audience.",
      "observablePerformanceDe": "Präsentiert tatsächlich eine eigene Prozessdatenauswertung oder Modellprüfung mit eigenem analogem Produkt und digitalen Folien beziehungsweise Tabelle, erläutert Datenherkunft und eigenen Beitrag und beantwortet eine echte Publikumsfrage.",
      "observablePerformanceEn": "Actually presents an own process-data evaluation or model test using an own analogue product and digital slides or table, explains data origin and own contribution and answers an actual audience question.",
      "transferExpectationDe": "Passt die tatsächlich gehaltene Darstellung für ein Oberstufenlabor oder jüngeres Publikum an und begründet Medienwahl und Fachsprache, während Stoff-/Energiebezüge oder Belegung-versus-Wirkung erhalten bleiben.",
      "transferExpectationEn": "Adapts the actual presentation for an upper-secondary laboratory or younger audience and justifies media and terminology while preserving material/energy reference quantities or the occupancy-versus-effect distinction."
    },
    "dissent": [
      {
        "dissentId": "synthesis-dissent-e676cc92e5b24b92bb469545be162c44b13466b4074f5c827f38d32992c36cbc",
        "source": "both",
        "textDe": "Die beiden aktuellen keep-Reviews unterscheiden sich in understandingEvidence, rationale; das Manifest wählt ausdrücklich die Evidence-Fassung der zweiten Runde.",
        "textEn": "The two current keep reviews differ in understandingEvidence, rationale; the manifest explicitly selects the evidence formulation from the second round.",

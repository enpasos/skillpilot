          "description": "Die lernende Person kann zu einem chemischen Sachverhalt relevante Bewertungskriterien recherchieren oder erkennen, fachlich belegte Pro- und Kontra-Argumente selbst finden, sie mit bereitgestellten Argumenten vergleichen und deren Gewicht kriteriengeleitet begründet abwägen.",
          "goalCanonicalJSONSHA256": "4b9fbf56619dd52c3e4d2f3ccda92ecd1178bdb202a0a4dddcba1639f77e364d",
          "profileCanonicalJSONSHA256": "1792517769c45afcbcbc381c68bcda5892b71a2c6348bddc15b5e090cce4d2bf",
          "requiredExpectationIds": [
            "independent-arguments",
            "weighted-judgment",
            "revised-argument"
          ],
          "caseIds": [
            "criteria-arguments-water-treatment-options",
            "criteria-arguments-packaging-evidence"
          ],
          "profileFieldProvenance": {
            "filePin": {
              "path": "/mnt/e/skillpilot-chemie-L7-20261017/current439-f79-explicit-concentration-ratio-author-root-v1/capsule/curricula/DE/Gymnasium/quality/goal-evidence/2026-10-17/chemie-current439-f79-explicit-concentration-ratio-author-root-v1/P439.only-f79-explicit-concentration-ratio.author-candidate.aggregate.jsonl",

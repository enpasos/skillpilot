        {
          "docketInstanceId": "goal-7d9fcc7f-1c20-5d5b-9cf6-05f6b624dab6-required-by-4aa3a130-b517-5ac5-87b2-147fe432cadd::3::7d9fcc7f-1c20-5d5b-9cf6-05f6b624dab6::DE-NI",

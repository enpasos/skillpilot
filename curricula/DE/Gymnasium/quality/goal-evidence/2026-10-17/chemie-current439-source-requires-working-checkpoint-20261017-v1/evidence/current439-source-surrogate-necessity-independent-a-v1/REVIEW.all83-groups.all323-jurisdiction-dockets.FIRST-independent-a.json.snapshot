      "jurisdictionReviews": [
        {
          "docketInstanceId": "goal-1bdaf7f2-ff3b-455a-a7fb-95a44642762a-required-by-e0d05c36-eaac-4c75-8ead-3fd5bdafefca::1::1bdaf7f2-ff3b-455a-a7fb-95a44642762a::DE-HH",
          "candidateGoalId": "1bdaf7f2-ff3b-455a-a7fb-95a44642762a",
          "jurisdiction": "DE-HH",
          "decision": "reject",
          "thisPhysicalEdgeDecision": "reject",
          "thisPhysicalEdgeNecessityRationale": "The CuO/FeS cases supply all masses including excess residue and ask for a constant elemental product ratio. They do not require analysing open gas-loss versus closed-system weighing; that full conservation competence is a possible explanatory route rather than a necessary prior performance.",
          "routeNecessityReview": [
            {
              "prerequisiteGoalId": "1bdaf7f2-ff3b-455a-a7fb-95a44642762a",
              "dependentGoalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
              "groupIndex": 11,
              "reviewGroupId": "goal-1bdaf7f2-ff3b-455a-a7fb-95a44642762a-required-by-e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
              "physicalDecision": "reject",
              "rationale": "The CuO/FeS cases supply all masses including excess residue and ask for a constant elemental product ratio. They do not require analysing open gas-loss versus closed-system weighing; that full conservation competence is a possible explanatory route rather than a necessary prior performance."
            },
            {
              "prerequisiteGoalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
              "dependentGoalId": "9b5d6326-d27c-4ece-8c72-debda705464a",
              "groupIndex": 63,
              "reviewGroupId": "goal-e0d05c36-eaac-4c75-8ead-3fd5bdafefca-required-by-9b5d6326-d27c-4ece-8c72-debda705464a",
              "physicalDecision": "reject",
              "rationale": "Dalton tasks provide water composition and an atom-redistribution model, then distinguish observation/law/hypothesis and isotope limits. Recognising constant CuO/FeS elemental ratios and excess reactants is a possible historical motivation, not a necessary prior competence for these tasks."
            },
            {
              "prerequisiteGoalId": "9b5d6326-d27c-4ece-8c72-debda705464a",
              "dependentGoalId": "72236f2c-771e-4ab6-933a-e549ee49d15b",
              "groupIndex": 52,
              "reviewGroupId": "goal-9b5d6326-d27c-4ece-8c72-debda705464a-required-by-72236f2c-771e-4ab6-933a-e549ee49d15b",
              "physicalDecision": "reject",
              "rationale": "Rutherford/isotope tasks can infer a concentrated charged nucleus and count p,n,e from given evidence and Z/A/charge. Explaining Dalton's historical assumptions and the law/hypothesis/model distinction is not necessary to perform those inferences."
            }
          ],

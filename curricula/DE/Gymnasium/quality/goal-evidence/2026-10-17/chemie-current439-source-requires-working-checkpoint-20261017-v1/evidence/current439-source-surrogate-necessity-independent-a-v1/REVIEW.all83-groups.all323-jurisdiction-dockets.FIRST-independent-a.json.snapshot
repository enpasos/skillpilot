          "jurisdiction": "DE-BE",
          "decision": "hold",
          "thisPhysicalEdgeDecision": "approve",
          "thisPhysicalEdgeNecessityRationale": "Empirical formula and relative-mass inferences from elemental masses require treating a specified pure binary compound as having a fixed elemental mass ratio while separating compound composition from unused material. That is the constant-composition competence; gas-density information adds molecular-size discrimination.",
          "routeNecessityReview": [
            {
              "prerequisiteGoalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
              "dependentGoalId": "e675fa94-6e23-59c0-b376-4340bf44c00e",
              "groupIndex": 64,
              "reviewGroupId": "goal-e0d05c36-eaac-4c75-8ead-3fd5bdafefca-required-by-e675fa94-6e23-59c0-b376-4340bf44c00e",
              "physicalDecision": "approve",
              "rationale": "Empirical formula and relative-mass inferences from elemental masses require treating a specified pure binary compound as having a fixed elemental mass ratio while separating compound composition from unused material. That is the constant-composition competence; gas-density information adds molecular-size discrimination."
            }
          ],
          "sourceDecision": "hold_source_or_scope",
          "concreteJurisdictionReason": "The selected BB/BE operation lists relative atomic/molecular/molar masses from the PSE. Reading reference masses does not require deriving them from experimental composition data. The actual empirical-formula route would need a separate matching source operation, preserving the p.17 optional introductory-theme/stage restrictions.",

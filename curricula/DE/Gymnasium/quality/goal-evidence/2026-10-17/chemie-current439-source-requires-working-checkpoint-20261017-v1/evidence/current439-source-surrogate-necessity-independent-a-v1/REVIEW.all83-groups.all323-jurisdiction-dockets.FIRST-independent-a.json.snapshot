          "docketInstanceId": "goal-7d9fcc7f-1c20-5d5b-9cf6-05f6b624dab6-required-by-4aa3a130-b517-5ac5-87b2-147fe432cadd::1::7d9fcc7f-1c20-5d5b-9cf6-05f6b624dab6::DE-BB",
          "candidateGoalId": "7d9fcc7f-1c20-5d5b-9cf6-05f6b624dab6",
          "jurisdiction": "DE-BB",
          "decision": "reject",
          "thisPhysicalEdgeDecision": "reject",
          "thisPhysicalEdgeNecessityRationale": "The data-validity tasks can judge supplied controls, cross-reactivity and temperature confounding without producing their own trend diagram or relating measured trends to an initial investigation hypothesis. Those representation/hypothesis operations make the whole prerequisite broader than necessary.",
          "routeNecessityReview": [
            {
              "prerequisiteGoalId": "7d9fcc7f-1c20-5d5b-9cf6-05f6b624dab6",
              "dependentGoalId": "4aa3a130-b517-5ac5-87b2-147fe432cadd",
              "groupIndex": 44,
              "reviewGroupId": "goal-7d9fcc7f-1c20-5d5b-9cf6-05f6b624dab6-required-by-4aa3a130-b517-5ac5-87b2-147fe432cadd",
              "physicalDecision": "reject",
              "rationale": "The data-validity tasks can judge supplied controls, cross-reactivity and temperature confounding without producing their own trend diagram or relating measured trends to an initial investigation hypothesis. Those representation/hypothesis operations make the whole prerequisite broader than necessary."
            },
            {
              "prerequisiteGoalId": "4aa3a130-b517-5ac5-87b2-147fe432cadd",
              "dependentGoalId": "ba621c67-b750-5e45-ab37-a51ea45e3ccf",
              "groupIndex": 27,
              "reviewGroupId": "goal-4aa3a130-b517-5ac5-87b2-147fe432cadd-required-by-ba621c67-b750-5e45-ab37-a51ea45e3ccf",
              "physicalDecision": "approve",
              "rationale": "Photometry requires judging blank, calibration range, nonlinearity, reference-control bias and the distinction between repeatability and accuracy. Claim-specific adequacy, confounds and bounded data conclusions are necessary to deciding whether a computed concentration may be released."
            }
          ],

          "docketInstanceId": "goal-801790f9-be3a-51fe-9b0f-3452c1bba887-required-by-4a08f31f-204c-5339-9d9f-5d2af28d5d5c::1::801790f9-be3a-51fe-9b0f-3452c1bba887::DE-NI",
          "candidateGoalId": "801790f9-be3a-51fe-9b0f-3452c1bba887",
          "jurisdiction": "DE-NI",
          "decision": "hold",
          "thisPhysicalEdgeDecision": "approve",
          "thisPhysicalEdgeNecessityRationale": "The dependent's Hess justification and real calorimetry require an energy-conserving boundary, distinguishing heat exchange from stored energy and identifying gas-energy/work exchange. Its current explicit rigid/isobaric pV cases additionally require the qualitative piston-work and changed-boundary distinctions assessed by the full first-law prerequisite.",
          "routeNecessityReview": [
            {
              "prerequisiteGoalId": "801790f9-be3a-51fe-9b0f-3452c1bba887",
              "dependentGoalId": "4a08f31f-204c-5339-9d9f-5d2af28d5d5c",
              "groupIndex": 45,
              "reviewGroupId": "goal-801790f9-be3a-51fe-9b0f-3452c1bba887-required-by-4a08f31f-204c-5339-9d9f-5d2af28d5d5c",
              "physicalDecision": "approve",
              "rationale": "The dependent's Hess justification and real calorimetry require an energy-conserving boundary, distinguishing heat exchange from stored energy and identifying gas-energy/work exchange. Its current explicit rigid/isobaric pV cases additionally require the qualitative piston-work and changed-boundary distinctions assessed by the full first-law prerequisite."
            }
          ],
          "sourceDecision": "hold_source_or_scope",
          "concreteJurisdictionReason": "The selected NI operation is interpreting enthalpy diagrams; the same-endpoint Hess alternatives establish energy conservation but do not require the full open/closed/isolated and piston-work boundary competence. Other-country pV tasks in the current P cannot silently become an original NI source duty. The full physical edge is valid for the actual whole profile, but this source-specific route remains insufficient.",

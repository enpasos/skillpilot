        ],
        "actualOriginalCourseStageProgram": "Sekundarstufe I, Erkenntnisgewinnung",
        "narrowOriginalFindingDe": "Der ausgewählte Originaloperator entwirft ein Untersuchungsdesign; die Sicherheitsalternative verlangt den sachgerechten Umgang mit Geräten. Beides belegt nicht vollständig den aktuellen Auftrag, Gefahrenpotenzial und Exposition zu beurteilen und Risiken begründet zu reduzieren. Eine konkrete passende Bewertungs-/Reduktionsklausel fehlt.",
        "rawMetadataNotRewritten": true,
        "locatorErratumApplied": false
      },
      "scopeQualificationDe": null,
      "originalMechanicallySelectedAnchorRetainedForAudit": true
    },

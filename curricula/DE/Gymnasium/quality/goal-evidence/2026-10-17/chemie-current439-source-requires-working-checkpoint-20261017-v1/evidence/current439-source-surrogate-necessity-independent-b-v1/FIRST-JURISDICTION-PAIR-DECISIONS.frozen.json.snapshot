      "selectedLiteralRequiresPath": [
        "431a0f03-f28a-5e56-a61f-000336d0b410",
        "1df17884-96ae-57d7-9da9-dbebd082596f"
      ],
      "selectedEndpointAnchor": {
        "anchorId": "anchor-02941e07c684ffb2f81a",

    {
      "pairKey": "bbe038e9-86ed-5ec6-ab33-316758ddb16d::DE-HH",
      "goalId": "bbe038e9-86ed-5ec6-ab33-316758ddb16d",
      "jurisdiction": "DE-HH",
      "decision": "reject",
      "decisionBasis": "concrete-unnecessary-edge-in-selected-chain",
      "scientificReasonDe": "EN-Differenzen, vorgegebene Molekülgeometrien und Oberflächenlegenden tragen die Polaritätsaufträge. Eine Überlappung einfach besetzter Orbitale und deren Energieabstandsminimum ist dafür keine notwendige Vorleistung. Der konkrete Endanker (Hamburg Bildungsplan Studienstufe Chemie 2022, 1.3, S. 26., Rohkurs LK) kann diese fachlich unnötige volle Zwischenkompetenz nicht in eine notwendige Vorleistung verwandeln.",
      "decisionAppliesTo": "Concrete selected source-surrogate candidate and explicitly checked same-endpoint witness alternatives; not a claim that no future alternative can exist.",
      "selectedLiteralRequiresPath": [
        "bbe038e9-86ed-5ec6-ab33-316758ddb16d",
        "747c5777-07d7-51a9-9be3-7d0d6f51d4e2"
      ],
      "selectedEndpointAnchor": {
        "anchorId": "anchor-09c07cc2d0f53f7b851a",

          "wholeCurrentProfileSHA256": "d5da722b85094cd87739494e2654fc2bb0a29986b48cfdba905f01b43bc61cff",
          "hasCurrentProfile": true
        },
        {
          "goalId": "4285d84a-2c9a-4d51-8250-8bed4daf2d2e",
          "title": "Ionen als Ladungsträger erklären",
          "wholeCurrentGoalSHA256": "ebae0c179ebc55cad1eee4d16744d0668fc5c62d610e9c580abaf1db3c382874",
          "wholeCurrentProfileSHA256": "e906857733530cdde5e6f81eac95ea4579e21fff32df782e462e00269434ef0f",
          "hasCurrentProfile": true
        }
      ],
      "everyIntermediateEdgeJudgment": [
        {
          "reviewGroupId": "goal-1351706f-4ea6-56e9-951b-87b24cbcdee8-required-by-018bec90-445f-4a88-b8bc-228f8335dee6",
          "prerequisiteGoalId": "1351706f-4ea6-56e9-951b-87b24cbcdee8",
          "dependentGoalId": "018bec90-445f-4a88-b8bc-228f8335dee6",
          "physicalNecessityDecision": "reject",
          "concreteScientificReasonDe": "Beide Leitfähigkeitsaufträge liefern sämtliche Messwerte und verlangen ausdrücklich keine Herstellung oder Erhitzung. Tatsächliches Tarieren, Übertragen, Lösen und ein eigener Herstellungslog sind deshalb keine notwendige Voraussetzung des abhängigen Datenvergleichs."
        },
        {
          "reviewGroupId": "goal-018bec90-445f-4a88-b8bc-228f8335dee6-required-by-4285d84a-2c9a-4d51-8250-8bed4daf2d2e",
          "prerequisiteGoalId": "018bec90-445f-4a88-b8bc-228f8335dee6",
          "dependentGoalId": "4285d84a-2c9a-4d51-8250-8bed4daf2d2e",
          "physicalNecessityDecision": "reject",
          "concreteScientificReasonDe": "Das abhängige Profil erklärt NaCl/MgCl2-Ionenbildung und Ionenwanderung aus vorgegebenen Befunden. Der vollständige vorgelagerte Vergleich umfasst zusätzlich Metallleitung und Salzschmelzen; diese Vergleichskompetenz ist dafür keine notwendige Vorleistung."
        }
      ],

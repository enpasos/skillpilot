          "wholeCurrentGoalSHA256": "c31d05e22bdd6ef6184e10f1ff2f906d2f2220dd73b8b2df0897b819d6132893",
          "wholeCurrentProfileSHA256": "1627d8f3ecad7969830947dbe1c3bc4c5949c89195cc405e072f54dd2048a3f4",
          "hasCurrentProfile": true
        },
        {
          "goalId": "3681e688-7880-5bb4-9ab9-ef78289345c8",
          "title": "Verdauungssäfte chemisch erklären",
          "wholeCurrentGoalSHA256": "e5c72e8088bc8eea2d25df5a24e0b8f31d0420d3f5e69de660cdddf93e9665e4",
          "wholeCurrentProfileSHA256": "f4f71c93b6ce27539a4079fcd77710e56bcadec9d526b06935e7ed1ee0e1c3d5",
          "hasCurrentProfile": true
        },
        {
          "goalId": "2fac2f0e-bccc-5511-b9fb-cc1bc3aeed00",
          "title": "Magensäurebildung und Protonenpumpen-Hemmer erklären",
          "wholeCurrentGoalSHA256": "34d1554123e0c7433e1151dd84959ad24d134466b689c3eec41f65ab0a3ff553",
          "wholeCurrentProfileSHA256": "09710762d2aa30553a4afd3dfdc1c4a5ce3d00591d882e8c23e5dd862e90336e",
          "hasCurrentProfile": true
        }
      ],
      "everyIntermediateEdgeJudgment": [
        {
          "reviewGroupId": "goal-28bb9d15-f865-5843-a035-6066580fea64-required-by-f1ed86f0-534d-57d7-8952-a004a331cc54",
          "prerequisiteGoalId": "28bb9d15-f865-5843-a035-6066580fea64",
          "dependentGoalId": "f1ed86f0-534d-57d7-8952-a004a331cc54",
          "physicalNecessityDecision": "reject",
          "concreteScientificReasonDe": "Die starke-Säure/-Base-Aufgabe kann aus gegebenem HCl- und Ca(OH)2-Modell mit Stöchiometrie gelöst werden. Das vollständige Benennen/Formelwissen von fünf Säuren und vier Hydroxiden einschließlich schwacher Säuren ist dafür nicht notwendig."
        },
        {
          "reviewGroupId": "goal-f1ed86f0-534d-57d7-8952-a004a331cc54-required-by-3681e688-7880-5bb4-9ab9-ef78289345c8",
          "prerequisiteGoalId": "f1ed86f0-534d-57d7-8952-a004a331cc54",
          "dependentGoalId": "3681e688-7880-5bb4-9ab9-ef78289345c8",
          "physicalNecessityDecision": "reject",
          "concreteScientificReasonDe": "Verdauungssäfte werden qualitativ über pH-Bedingungen, Emulgierung und Stoffumwandlung erklärt. Eigenes Herstellen starker Säure-/Baselösungen, pH-Rechnung und echte kalibrierte Messung sind für diese Leistung nicht notwendig."
        },
        {
          "reviewGroupId": "intermediate-3681e688-7880-5bb4-9ab9-ef78289345c8-required-by-2fac2f0e-bccc-5511-b9fb-cc1bc3aeed00",
          "prerequisiteGoalId": "3681e688-7880-5bb4-9ab9-ef78289345c8",
          "dependentGoalId": "2fac2f0e-bccc-5511-b9fb-cc1bc3aeed00",
          "physicalNecessityDecision": "reject",
          "concreteScientificReasonDe": "Der PPI-Auftrag liefert Protonenquelle, H+/K+-Pumpe und Chloridtransport. Die gesamte Erklärung verschiedener Verdauungssäfte einschließlich Gallenemulgierung und Enzymumgebung ist zur Magensäure-/Pumpenhemmungsleistung nicht notwendig."
        }
      ],

          "reviewGroupId": "goal-1bdaf7f2-ff3b-455a-a7fb-95a44642762a-required-by-e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
          "prerequisiteGoalId": "1bdaf7f2-ff3b-455a-a7fb-95a44642762a",
          "dependentGoalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
          "physicalNecessityDecision": "reject",
          "concreteScientificReasonDe": "Die CuO-/FeS-Daten liefern Edukt- und Produktmassen einschließlich Rest; deren konstante Zusammensetzung lässt sich unmittelbar normieren. Die gesamte vorherige Kompetenz zu offenen/geschlossenen Gas-Massenbilanzversuchen ist dafür nicht notwendig."
        },
        {
          "reviewGroupId": "goal-e0d05c36-eaac-4c75-8ead-3fd5bdafefca-required-by-9b5d6326-d27c-4ece-8c72-debda705464a",
          "prerequisiteGoalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
          "dependentGoalId": "9b5d6326-d27c-4ece-8c72-debda705464a",
          "physicalNecessityDecision": "reject",
          "concreteScientificReasonDe": "Das Dalton-Profil kann Gesetz, Hypothese und Umgruppierung am gegebenen Wasser-Massenbeispiel erläutern. Zuvor konstante Massenverhältnisse an Oxid UND Sulfid selbst erkennen zu müssen ist dafür kein notwendiger Inhalt."
        },
        {
          "reviewGroupId": "goal-9b5d6326-d27c-4ece-8c72-debda705464a-required-by-72236f2c-771e-4ab6-933a-e549ee49d15b",
          "prerequisiteGoalId": "9b5d6326-d27c-4ece-8c72-debda705464a",
          "dependentGoalId": "72236f2c-771e-4ab6-933a-e549ee49d15b",
          "physicalNecessityDecision": "reject",
          "concreteScientificReasonDe": "Rutherford-Befunde und Atom-/Ionenzahlen können aus dem gegebenen Streu- und Teilchenmodell erschlossen werden. Daltons Atomhypothese einschließlich formaler Gesetz/Hypothese-Abgrenzung und chemischer Massenbilanz ist kein notwendiger Erwerbsschritt."
        }
      ],

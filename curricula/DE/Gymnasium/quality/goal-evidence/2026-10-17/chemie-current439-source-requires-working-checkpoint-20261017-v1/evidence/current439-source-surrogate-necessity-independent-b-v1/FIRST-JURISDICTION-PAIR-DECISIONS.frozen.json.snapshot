        {
          "reviewGroupId": "goal-4aa3a130-b517-5ac5-87b2-147fe432cadd-required-by-ba621c67-b750-5e45-ab37-a51ea45e3ccf",
          "prerequisiteGoalId": "4aa3a130-b517-5ac5-87b2-147fe432cadd",
          "dependentGoalId": "ba621c67-b750-5e45-ab37-a51ea45e3ccf",
          "physicalNecessityDecision": "approve",
          "concreteScientificReasonDe": "Fotometrie verlangt gültigen Kalibrierbereich, Blank/Referenz, Fehlergrenzen und das Zurückhalten eines bei fehlgeschlagener Kontrolle vorläufigen Gehalts. Genau diese Prüfung von Angemessenheit, Gültigkeit und Tragweite chemischer Daten ist unverzichtbar."
        }
      ],

      "everyIntermediateEdgeJudgment": [
        {
          "reviewGroupId": "goal-5c4788a7-6760-53dc-894e-e04bca6f8cd9-required-by-1e5a4b89-69f1-5379-811e-c8ec76faad2a",
          "prerequisiteGoalId": "5c4788a7-6760-53dc-894e-e04bca6f8cd9",
          "dependentGoalId": "1e5a4b89-69f1-5379-811e-c8ec76faad2a",
          "physicalNecessityDecision": "reject",
          "concreteScientificReasonDe": "Avogadros Vergleich kann anhand des ausdrücklich gegebenen idealen Gasgesetz-Zusammenhangs und gleicher T/p begründet werden. Eine kinetische Wandstoßdeutung von isothermer Kompression und Erwärmung ist ein möglicher zusätzlicher Modellweg, keine notwendige Vorleistung."
        },
        {
          "reviewGroupId": "goal-1e5a4b89-69f1-5379-811e-c8ec76faad2a-required-by-2924f784-5261-54e8-93ee-49ac3b3cd300",
          "prerequisiteGoalId": "1e5a4b89-69f1-5379-811e-c8ec76faad2a",
          "dependentGoalId": "2924f784-5261-54e8-93ee-49ac3b3cd300",
          "physicalNecessityDecision": "approve",
          "concreteScientificReasonDe": "Der molare-Volumenauftrag gilt für unterschiedliche ideale Gase und verlangt passenden T/p-Bezug und erhaltene Stoffmenge. Die gemeinsame Volumen-pro-mol-Beziehung bei gleichem T/p setzt genau Avogadros Teilchenzahlvergleich voraus; ohne diese Bedingung wäre die Übertragung des Vm unbegründet."
        }
      ],

            },
            "variationAxes": [
              {
                "id": "acid-strength",
                "textDe": "Bei gleicher Stoffmenge von starker zu schwacher Säure wechseln und die veränderten Gleichgewichte begründen.",
                "textEn": "Change from strong to weak acid at equal amount and explain the altered equilibria."
              },
              {
                "id": "curve-region",
                "textDe": "Dasselbe Reagenzsystem vor, bei und nach Äquivalenz mit unterschiedlichen Bilanzmodellen behandeln.",
                "textEn": "Use different balance models for the same reagent system before, at and after equivalence."
              },
              {
                "id": "temperature-and-indicator",
                "textDe": "Neutralität bei verändertem pKᵥ und die begrenzte Aussage eines Indikatorbereichs prüfen.",

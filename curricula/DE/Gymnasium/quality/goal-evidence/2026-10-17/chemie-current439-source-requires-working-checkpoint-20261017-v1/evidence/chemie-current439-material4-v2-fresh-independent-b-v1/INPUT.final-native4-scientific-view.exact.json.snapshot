          "visualization": {
            "resourceType": "image",
            "title": "Visualisierung: Reaktivität aromatischer Systeme begründen",
            "url": "/assets/goal-visualizations/chemie/b8d3b453-d638-5518-aab0-d84ec2e8567c/b8d3b453-d638-5518-aab0-d84ec2e8567c.png",
            "altText": "Schematische elektrophile Substitution: Benzol und E⁺, eine einfach positiv geladene nichtaromatische Zwischenstufe mit E und H am selben Kohlenstoff, danach aromatisches Substitutionsprodukt und H⁺.",
            "originalDigest": "sha256:0cc19c21e012eca536f383a83e016dbff040d28a46379f94436b3341108dbe45",
            "qaStatus": "review_candidate",
            "approvedForPublication": false
          },
          "goalFingerprint": "sha256:7cfe6610ec81b9510eebe1a403f40740cdb6cf50176512a16397f87b103a6358",
          "pageFingerprint": "sha256:31ee65cebd597481035268a3b64c6c6e999db27fd6c0229db99b8cbff954d1e4"
        },
        "evidenceProfile": {
          "goalId": "b8d3b453-d638-5518-aab0-d84ec2e8567c",
          "goalFingerprint": "sha256:7cfe6610ec81b9510eebe1a403f40740cdb6cf50176512a16397f87b103a6358",
          "reviewInputFingerprint": "sha256:022137fc981ebde09a065ce691ae7e082a53c84ce0b7c9d4a81b9500d49bf4ce",
          "profileRuleVersion": "positive-understanding-evidence-v2",
          "profileFingerprint": "sha256:21b3eef7ebda4471ee0d61e16eff0bd4be0938bc13456b2b9d45c4fe024df74f",
          "status": "needs_human_review",
          "reviewAuthority": "ai_candidate",
          "evidenceLevel": "E1",
          "maximumClaimScope": "G1",
          "profile": {
            "archetype": "modeling",
            "expectations": [
              {
                "id": "structure-model-reasoning",
                "essentialUnderstandingDe": "Aromatische Delokalisierung stabilisiert das System; elektrophile Substitution kann nach zwischenzeitlichem Verlust die Aromatizität wiederherstellen.",
                "essentialUnderstandingEn": "Aromatic delocalization stabilizes the system; electrophilic substitution can restore aromaticity after temporary loss.",
                "observablePerformanceDe": "Die Person vergleicht Benzen und Alken, begründet den Unterschied bei Addition/Substitution und zeichnet den Wiederherstellungsschritt.",
                "observablePerformanceEn": "The learner compares benzene with an alkene, explains the addition/substitution difference and draws restoration of aromaticity."
              },
              {
                "id": "fresh-application-and-boundary",
                "essentialUnderstandingDe": "Ein Kekulé-Bild bedeutet keine drei voneinander unabhängigen gewöhnlichen Doppelbindungen; ohne Reaktionsbedingungen lässt sich keine beliebige Reaktionsgeschwindigkeit vorhersagen.",
                "essentialUnderstandingEn": "A Kekulé drawing does not imply three independent ordinary double bonds; arbitrary reaction rates cannot be predicted without conditions.",
                "observablePerformanceDe": "Für die vorgegebene elektrophile Substitution lautet die Gesamtbilanz C6H6 + Br2 → C6H5Br + HBr. Der H-Verlust und die Wiederherstellung der π-Delokalisierung gehören zusammen. Die Additionsformel C6H6Br2 beschreibt nicht das gezeichnete Substitutionsprodukt. Andere Reaktionsbedingungen können andere Vorgänge ermöglichen; der Fall prüft nur die ausdrücklich vorgegebene elektrophile Erstsubstitution.",
                "observablePerformanceEn": "For the specified electrophilic substitution the overall balance is C6H6 + Br2 → C6H5Br + HBr. H loss and restored π delocalization belong together. The addition formula C6H6Br2 does not describe the drawn substitution product. Other conditions may permit different processes; this case addresses only the explicitly specified initial electrophilic substitution."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "structure-model-reasoning",
                "fresh-application-and-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "material-variation",
                "textDe": "Addition versus elektrophile Erstsubstitution; Benzen versus isolierte C=C; delokalisiertes System gegenüber lokalisiertem Zwischenmodell.",
                "textEn": "Addition versus initial electrophilic substitution; benzene versus isolated C=C; delocalized system versus localized intermediate model."
              },
              {
                "id": "counterexample",
                "textDe": "Ein Kekulé-Bild bedeutet keine drei voneinander unabhängigen gewöhnlichen Doppelbindungen; ohne Reaktionsbedingungen lässt sich keine beliebige Reaktionsgeschwindigkeit vorhersagen.",
                "textEn": "A Kekulé drawing does not imply three independent ordinary double bonds; arbitrary reaction rates cannot be predicted without conditions."
              },
              {
                "id": "new-electrophile-and-restored-aromaticity",
                "textDe": "Vorgegebener NO2+-Pfad und andere H2-/Katalysatorbedingungen selbst deuten.",
                "textEn": "Independently interpret a supplied NO2+ pathway and changed H2/catalyst conditions."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-current15-b8d3b453-case-1",
                "taskDemandDe": "Papiervergleich: Ethen wird im einfachen Modell mit Br2 addiert. Für Benzen ist eine elektrophile Bromierung mit geeignetem Lewis-Säure-Katalysator als Reaktionsbedingung vorgegeben. Erkläre, warum bei Benzen die Substitution fachlich sinnvoll ist, und markiere den vorübergehenden Verlust und die Wiederherstellung des aromatischen Systems.",
                "taskDemandEn": "Paper comparison: ethene undergoes simple addition with Br2. For benzene, electrophilic bromination with an appropriate Lewis-acid catalyst is specified. Explain why substitution is appropriate for benzene and mark temporary loss and restoration of the aromatic system.",
                "expectedPerformanceDe": "Der elektrophile Angriff erzeugt ein nicht vollständig aromatisches σ-Komplex-Modell. Abgabe des H+ am substituierten C stellt die delokalisierte π-Struktur wieder her; insgesamt ersetzt Br ein H. Eine vollständige Addition würde das aromatische System dauerhaft verändern.",
                "expectedPerformanceEn": "Electrophilic attack gives a nonfully aromatic σ-complex model. Loss of H+ from the substituted C restores delocalized π structure; overall Br replaces H. Full addition would persistently alter the aromatic system.",
                "understandingFocusDe": "Reaktionsbedingungen sind gegeben; aus dem Benzen-Strukturbild wird keine Reaktion ohne geeignete Aktivierung behauptet.",
                "understandingFocusEn": "Conditions are specified; the benzene structure alone is not claimed to react without appropriate activation."
              },
              {
                "id": "chem-current15-b8d3b453-case-2",
                "taskDemandDe": "Ein Autor schlägt für die Erstbromierung C6H6 + Br2 → C6H6Br2 vor, zeichnet aber anschließend einen aromatischen Brombenzenring C6H5Br und HBr. Behebe den Widerspruch zwischen Stoffbilanz und Modell und begründe, welche Beschreibung das aromatische Endprodukt erhält.",
                "taskDemandEn": "An author proposes C6H6 + Br2 → C6H6Br2 for initial bromination but then draws aromatic bromobenzene C6H5Br and HBr. Resolve the contradiction between stoichiometry and model and justify which description preserves the aromatic final product.",
                "expectedPerformanceDe": "Für die vorgegebene elektrophile Substitution lautet die Gesamtbilanz C6H6 + Br2 → C6H5Br + HBr. Der H-Verlust und die Wiederherstellung der π-Delokalisierung gehören zusammen. Die Additionsformel C6H6Br2 beschreibt nicht das gezeichnete Substitutionsprodukt.",
                "expectedPerformanceEn": "For the specified electrophilic substitution the overall balance is C6H6 + Br2 → C6H5Br + HBr. H loss and restored π delocalization belong together. The addition formula C6H6Br2 does not describe the drawn substitution product.",
                "understandingFocusDe": "Andere Reaktionsbedingungen können andere Vorgänge ermöglichen; der Fall prüft nur die ausdrücklich vorgegebene elektrophile Erstsubstitution.",
                "understandingFocusEn": "Other conditions may permit different processes; this case addresses only the explicitly specified initial electrophilic substitution."
              },
              {
                "id": "aromatic-nitronium-new-path",
                "taskDemandDe": "Neuer Papierfall, kein Versuch: Ein Benzolring besitzt ein zusammenhängendes zyklisches System aus sechs pi-Elektronen. Das vorgegebene Elektrophil ist NO2+ (Nitroniumion). Nach Bindung von NO2 am Ring-C1 liegt das nichtaromatische sigma-Zwischenion C6H6NO2+ vor: C1 trägt H und NO2 sowie Einfachbindungen zu seinen beiden Ringnachbarn; im restlichen Ring liegen zwei C=C-Bindungen und eine delokalisierbare positive Ladung. Zwei ausdrücklich hypothetische Abschlusskarten: A entfernt H+ von C1 und erzeugt C6H5NO2 mit drei alternierenden Ring-Doppelbindungen; B addiert Cl− an eine positiv beschriebene Ringposition und erzeugt C6H6ClNO2 mit weiterhin zwei Ring-Doppelbindungen. B ist eine gegebene Modellalternative, keine Behauptung einer tatsächlichen Konkurrenzreaktion im Nitriergemisch. Hinweise auf genaue Raten oder Barrieren fehlen.\n\nPrüfe für A und B Stoff- und Ladungsbilanz sowie durchgehende zyklische pi-Delokalisierung. Begründe, welcher Abschluss die aromatische Stabilisierung zurückgewinnt und warum die bloße Neutralität des Produkts dafür nicht genügt. Formuliere die Gesamtbilanz der vorgegebenen Substitution und begrenze ein daraus abgeleitetes Reaktivitätsurteil.\nFrischer Transfer (erst nach eigener Antwort): Frische Gegenkarte: Unter ausdrücklich geeigneter H2-/Katalysatorführung wird C6H6+3H2→C6H12 vorgegeben. Das Produkt besitzt nur C–C-Einfachbindungen. Prüfe „Benzol kann wegen Aromatizität niemals addiert werden“. Ist das Modell der Substitution deshalb falsch?",
                "taskDemandEn": "New paper case, no experiment: benzene has a continuous cyclic six-pi-electron system. The supplied electrophile is NO2+ (nitronium). Bonding NO2 to ring C1 gives nonaromatic sigma intermediate C6H6NO2+: C1 carries H and NO2 plus single bonds to its two ring neighbours; the remaining ring has two C=C bonds and a delocalisable positive charge. Two explicitly hypothetical completion cards: A removes H+ from C1, producing C6H5NO2 with three alternating ring double bonds; B adds Cl− at a positively represented ring position, producing C6H6ClNO2 with only two ring double bonds. B is a given model alternative, not a claimed competing reaction in a nitrating mixture. Exact rates and barriers are not supplied.\n\nFor A and B check atom/charge balance and continuous cyclic pi delocalisation. Explain which completion restores aromatic stabilisation and why product neutrality alone is insufficient. Write the overall balance of the supplied substitution and bound a reactivity claim.\nFresh transfer (release only after an independent answer): Fresh countercard: under explicitly suitable H2/catalyst conditions the reaction C6H6+3H2→C6H12 is supplied. The product has only C–C single bonds. Assess “Benzene can never undergo addition because it is aromatic.” Does this invalidate the substitution model?",
                "expectedPerformanceDe": "A liefert C6H5NO2 + H+; Atome und Gesamtladung +1 bleiben erhalten. C1 wird wieder Teil des durchgehenden pi-Systems; Aromatizität ist wiederhergestellt. B neutralisiert zwar das Ion durch Cl−-Aufnahme, stellt das zyklische sechs-pi-System aber nicht wieder her. C6H6 + NO2+ → C6H5NO2 + H+ beschreibt den Substitutionsschritt. Die Rückgewinnung aromatischer Stabilisierung erklärt eine Triebkraft, beweist allein aber weder genaue Geschwindigkeit noch jeden denkbaren Reaktionsweg. Transfer: Die allgemeine Behauptung ist falsch. In der gegebenen Hydrierung geht Aromatizität verloren; andere Bindungsänderungen und Reaktionsbedingungen ermöglichen dennoch den vorgegebenen Prozess. Das bedingt formulierte Substitutionsmodell bleibt sinnvoll. Aus Aromatizität allein folgt kein absolutes Reaktionsverbot oder eine vollständige kinetische Prognose.",
                "expectedPerformanceEn": "A yields C6H5NO2 + H+; atoms and total charge +1 are conserved. C1 rejoins the continuous pi system, restoring aromaticity. B neutralises charge through Cl− capture but does not restore the cyclic six-pi system. C6H6 + NO2+ → C6H5NO2 + H+ describes the substitution step. Regaining aromatic stabilisation explains a driving contribution but alone proves neither exact rate nor every possible pathway. Transfer: The universal claim is false. Aromaticity is lost in the given hydrogenation, yet other bond changes and conditions allow the supplied process. The conditional substitution model remains useful. Aromaticity alone gives no absolute reaction prohibition or complete kinetic prediction.",
                "understandingFocusDe": "Neues Elektrophil und eigenständiger Aromatizitätsschluss; Neutralisation und Wiederaromatisierung trennen. Keine zusätzliche starre Aufgabenquote; ausreichende zusammenhängende Leistung kann genügen.",
                "understandingFocusEn": "A new electrophile and independent aromaticity judgement; distinguish charge neutralisation from rearomatisation. No additional fixed task quota; sufficient connected performance can suffice."
              }
            ]
          }
        }
      },

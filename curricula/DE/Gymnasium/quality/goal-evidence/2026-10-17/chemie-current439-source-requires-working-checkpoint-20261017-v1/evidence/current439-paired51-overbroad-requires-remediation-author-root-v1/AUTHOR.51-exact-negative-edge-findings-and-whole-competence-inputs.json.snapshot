      "wholePrerequisiteProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Monomerfunktionalität und Verknüpfungen legen Rückgrat, Seitengruppen und mögliche Netzpunkte fest.",
            "essentialUnderstandingEn": "Monomer functionality and linkages determine backbone, side groups and possible network points.",
            "observablePerformanceDe": "Leitet Repetiermotive und Vernetzungsmöglichkeiten aus vorgegebenen Monomeren ab. Erläutert außerdem die Herstellung von PE durch Polymerisation aus Ethen mit Doppelbindungsöffnung, C–C-Kettenbildung und ohne Abspaltung kleiner Moleküle.",
            "observablePerformanceEn": "Derives repeat motifs and crosslinking possibilities from supplied monomers. Also explains manufacture of PE by polymerisation from ethene, with double-bond opening, C–C chain formation and no elimination of small molecules."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Polarität, Wasserstoffbrücken, Packung und Vernetzung erklären unterschiedliche Eigenschaftsprofile unter festgelegten Bedingungen.",
            "essentialUnderstandingEn": "Polarity, hydrogen bonding, packing and crosslinking explain property profiles under specified conditions.",
            "observablePerformanceDe": "Verknüpft Strukturmerkmale mit zwei beobachteten Materialeigenschaften ohne universelle Rangfolge.",
            "observablePerformanceEn": "Connects structural features to two observed properties without asserting a universal ranking."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "Eine technische Wahl braucht mehrere Eigenschaften und Angaben zu Einsatzbedingungen.",
            "essentialUnderstandingEn": "A technical choice requires multiple properties and service conditions.",
            "observablePerformanceDe": "Begründet eine Materialwahl und überträgt sie bei geänderter Feuchte oder Geometrie.",
            "observablePerformanceEn": "Justifies a material selection and transfers it under changed moisture or geometry."
          }
        ],
        "coverageExpectations": {

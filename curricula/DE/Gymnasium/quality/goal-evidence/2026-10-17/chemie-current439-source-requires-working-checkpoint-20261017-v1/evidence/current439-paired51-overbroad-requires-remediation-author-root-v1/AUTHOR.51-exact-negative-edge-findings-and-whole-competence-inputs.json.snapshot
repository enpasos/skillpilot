      "wholePrerequisiteProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "amphiphilic-interface",
            "essentialUnderstandingDe": "Seifen besitzen hydrophile Carboxylatköpfe und hydrophobe Kohlenwasserstoffreste. Ihre Anordnung hängt davon ab, welche Seite der Grenzfläche Wasser berührt.",
            "essentialUnderstandingEn": "Soaps have hydrophilic carboxylate heads and hydrophobic hydrocarbon tails. Their arrangement depends on which side of the interface touches water.",
            "observablePerformanceDe": "Kopf und Rest in einer Struktur markieren und Moleküle an Luft/Wasser- und Öl/Wasser-Grenzflächen begründet ausrichten.",
            "observablePerformanceEn": "Mark head and tail in a structure and justify molecular orientations at air/water and oil/water interfaces."
          },
          {
            "id": "micelles-emulsion-surface",
            "essentialUnderstandingDe": "In einer normalen wässrigen Micelle weisen hydrophobe Reste überwiegend nach innen und Köpfe nach außen. Tenside können Öl dispergieren und die Oberflächenspannung verringern; Dispersion ist keine chemische Auflösung oder Fettspaltung.",
            "essentialUnderstandingEn": "In a normal aqueous micelle hydrophobic tails mainly point inward and heads outward. Surfactants can disperse oil and lower surface tension; dispersion is not chemical dissolution or fat cleavage.",
            "observablePerformanceDe": "Micellen, emulgierte Öltröpfchen und Luft/Wasser-Grenzflächen unterscheiden und bereitgestellte Dispersions-/Oberflächenspannungsdaten mit der Struktur erklären.",
            "observablePerformanceEn": "Distinguish micelles, emulsified oil droplets and air/water interfaces and explain supplied dispersion/surface-tension data using structure."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "amphiphilic-interface",
            "micelles-emulsion-surface"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "changed-chemical-case",
            "textDe": "Andere Grenzflächen und umgekehrte Phasenlage; Molekülorientierung aus den berührenden Phasen statt aus einer auswendig gelernten Kreiszeichnung.",
            "textEn": "Change interfaces and reverse phase geometry; infer molecular orientation from contacting phases instead of memorizing a circular drawing."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "oil-in-water-and-surface",
            "taskDemandDe": "Zeichne die Anordnung einer vorgegebenen Seife an Luft/Wasser und um ein Öltröpfchen in Wasser. Erkläre zusätzlich eine normale wässrige Micelle sowie bereitgestellte Daten mit/ohne Tensid: Öl bleibt länger verteilt und die Oberflächenspannung sinkt.",
            "taskDemandEn": "Draw a supplied soap at air/water and around an oil droplet in water. Explain a normal aqueous micelle and supplied with/without-surfactant data: oil remains dispersed longer and surface tension falls.",
            "expectedPerformanceDe": "Köpfe berühren Wasser, Reste Luft bzw. Öl; in der normalen Micelle liegen Reste innen. Das stabilisierte dispergierte Öl bleibt eine getrennte Phase. An der Oberfläche verändern adsorbierte Tenside die Grenzflächenenergie; weder Seifenbildung noch Fettspaltung ist erforderlich.",
            "expectedPerformanceEn": "Heads contact water, tails air or oil; normal micelle tails point inward. Stabilized dispersed oil remains a separate phase. Adsorbed surfactants change interfacial energy; neither soap production nor fat cleavage is required.",
            "understandingFocusDe": "Grenzfläche, Micelle und Wirkung verbunden erklären.",
            "understandingFocusEn": "Connect interface, micelle and action."
          },
          {
            "id": "water-drop-in-oil-interface",
            "taskDemandDe": "Frisch gegeben ist ein hypothetisches Wassertröpfchen in einer zusammenhängenden Ölphase. Sage allein aus der amphiphilen Struktur die bevorzugte Orientierung einer Seife an dieser Grenzfläche voraus und begründe, warum damit noch keine stabile inverse Micelle oder Emulsion bewiesen ist.",
            "taskDemandEn": "A fresh hypothetical water droplet sits in continuous oil. Predict only the preferred interfacial soap orientation from amphiphilic structure and explain why this does not prove a stable inverse micelle or emulsion.",
            "expectedPerformanceDe": "Köpfe richten sich zum Wassertröpfchen, Reste zur äußeren Ölphase. Die Orientierung folgt aus Phasenkontakt; Stabilität erfordert zusätzliche Bedingungen/Daten und ist nicht bei jeder Seife garantiert. Die normale wässrige Micelle ist anders orientiert.",
            "expectedPerformanceEn": "Heads face the water droplet, tails the surrounding oil. Phase contact explains orientation; stability needs additional conditions/data and is not guaranteed for every soap. A normal aqueous micelle has the opposite geometry.",
            "understandingFocusDe": "Frischer Phasen-/Modellgrenzentransfer.",
            "understandingFocusEn": "Fresh phase and model-limit transfer."
          }
        ]
      },
      "wholeDependentProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "concentration-dispersion",
            "essentialUnderstandingDe": "Tensidkonzentration beeinflusst Grenzflächenbelegung, Micellenbildung und Dispergierung. Mehr Tensid oder mehr Schaum bedeutet nicht unbegrenzt bessere Reinigung.",
            "essentialUnderstandingEn": "Surfactant concentration affects interfacial adsorption, micelle formation and dispersion. More surfactant or foam does not mean indefinitely better cleaning.",
            "observablePerformanceDe": "Bereitgestellte Konzentrations-/Dispersionsdaten unter vorgegebenen Bedingungen erklären und sinnvolle Dosierungen begründen.",
            "observablePerformanceEn": "Explain supplied concentration/dispersion data under specified conditions and justify sensible doses."
          },
          {
            "id": "hardness-temperature-factors",
            "essentialUnderstandingDe": "Calcium- und Magnesiumionen können mit Seifen schwer lösliche Kalkseifen bilden und verfügbare Seifenanionen vermindern. Temperatur beeinflusst Lösung, Beweglichkeit und die jeweils gegebenen Stoffeigenschaften; ihre Wirkung ist nicht universell monoton.",
            "essentialUnderstandingEn": "Calcium and magnesium can precipitate poorly soluble soaps and reduce available soap anions. Temperature affects dissolution, motion and specified material properties; its effect is not universally monotonic.",
            "observablePerformanceDe": "Härte und Temperatur von Konzentration als unabhängige Faktoren unterscheiden, Calciumseifenbildung bilanzieren und einen kontrollierten Vergleich deuten.",
            "observablePerformanceEn": "Separate hardness and temperature from concentration, balance calcium-soap formation and interpret a controlled comparison."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "concentration-dispersion",
            "hardness-temperature-factors"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "changed-chemical-case",
            "textDe": "Neue kontrollierte Kombinationen von Härte, Temperatur und Konzentration; Daten erklären und jeweils nur einen Faktor variieren.",
            "textEn": "Use fresh controlled combinations of hardness, temperature and concentration; explain data and vary one factor at a time."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "soap-hardness-concentration-series",
            "taskDemandDe": "Gegeben sind gleiche Ölverschmutzung und Temperatur. In weichem Wasser verbessert eine Seifenkonzentrationsreihe die Dispersion bis zu einem Plateau; bei Ca²⁺ treten Niederschlag und schwächere Dispersion auf. Erkläre Micellen/Dispergierung und formuliere die Calciumseifenreaktion.",
            "taskDemandEn": "At equal oil contamination and temperature, a soft-water soap concentration series improves dispersion up to a plateau; Ca²⁺ produces precipitate and poorer dispersion. Explain micelles/dispersion and write calcium-soap formation.",
            "expectedPerformanceDe": "2 RCOO⁻ + Ca²⁺ → Ca(RCOO)₂(s) ist ladungs- und stoffbilanziert. Präzipitation vermindert verfügbare Seife. Die Konzentrationsdaten passen zu Grenzflächenbelegung/Micellen; ein Plateau und Schaum allein sind kein Beleg unbegrenzter Reinigung.",
            "expectedPerformanceEn": "2 RCOO⁻ + Ca²⁺ → Ca(RCOO)₂(s) balances charge and atoms. Precipitation reduces available soap. Concentration data fit adsorption/micelles; a plateau and foam alone do not prove unlimited cleaning.",
            "understandingFocusDe": "Härte und Konzentration mechanistisch verbinden.",
            "understandingFocusEn": "Connect hardness and concentration mechanistically."
          },
          {
            "id": "controlled-temperature-replan",
            "taskDemandDe": "Eine neue Tabelle variiert bei gleichem Tensid, Wasser und Schmutz getrennt Temperatur und Dosis. Moderate Erwärmung verbessert im Modell die Dispersion, oberhalb einer vorgegebenen Stoffgrenze nimmt sie ab; zusätzliche Dosis hilft nur in einem Bereich. Erkläre die Daten und plane einen Vergleich, der Härte als Ursache prüft.",
            "taskDemandEn": "A fresh table varies temperature and dose separately at equal surfactant, water and soil. Moderate warming improves model dispersion, above a supplied material limit it declines; extra dose helps only within a range. Explain data and plan a comparison testing hardness.",
            "expectedPerformanceDe": "Löslichkeit/Beweglichkeit und die vorgegebene Stoffgrenze erklären die Temperaturdaten; Konzentration wirkt über verfügbare Grenzflächen-/Micellenbildung. Für den Härtevergleich bleiben Temperatur, Dosis und Schmutz gleich, nur Ca/Mg-Gehalt ändert sich. Keine universelle Regel heißer=immer besser oder Schaum=Waschwirkung.",
            "expectedPerformanceEn": "Solubility/mobility and the supplied material limit explain temperature data; dose acts through available interfacial/micelle formation. A hardness comparison fixes temperature, dose and soil while changing Ca/Mg. No universal hotter-is-better or foam-equals-cleaning rule.",
            "understandingFocusDe": "Frischer Mehrfaktor-/Kontrolltransfer.",
            "understandingFocusEn": "Fresh multiple-factor and control transfer."
          }
        ]
      }
    },

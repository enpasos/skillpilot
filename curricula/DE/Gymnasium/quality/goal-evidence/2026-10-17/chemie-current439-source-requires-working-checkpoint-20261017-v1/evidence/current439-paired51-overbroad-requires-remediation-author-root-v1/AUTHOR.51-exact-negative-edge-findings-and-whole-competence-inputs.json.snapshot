        "applicationCaseBriefs": [
          {
            "id": "solution-1",
            "taskDemandDe": "Berechne und begründe 250,0 mL 0,0100 M HCl aus 0,100 M Stock. Stelle und miss die Lösung unter Aufsicht tatsächlich her. Prüfe die Vergleichswerte und die getrennte ideale 10−8-M-Probe mit der gegebenen Bilanzlösung.",
            "taskDemandEn": "Calculate and justify 250.0 mL 0.0100 M HCl from 0.100 M stock. Actually prepare and measure it under supervision. Assess comparison readings and the separate ideal 10−8-M sample using the supplied balance solution.",
            "expectedPerformanceDe": "2,50 mmol und 25,00 mL Stock; auf Endvolumen auffüllen, kalibriert messen und eigene Handlungen/Rohwerte dokumentieren. pH≈2; 3,02 ist ein Prüfhinweis, keine bewiesene Fehlerursache. Die ideale Extremverdünnung ergibt pH≈6,978 statt 8.",
            "expectedPerformanceEn": "2.50 mmol and 25.00 mL stock; make up to final volume, measure with calibration and document own actions/raw readings. pH≈2; 3.02 prompts checks but proves no specific cause. Ideal extreme dilution gives pH≈6.978, not 8.",
            "understandingFocusDe": "Stoffmengenerhaltung, kontrollierte tatsächliche Herstellung und begründete Modellgrenze.",
            "understandingFocusEn": "Amount conservation, controlled actual preparation and a justified model limit."
          },
          {
            "id": "solution-2",
            "taskDemandDe": "Verdünne unter Aufsicht 25,00 mL 0,00250 M Ca(OH)2 auf 250,0 mL; berechne Masse/Konzentration/pH und vergleiche NaOH bei gleicher formaler Konzentration sowie die gelieferten Messwerte.",
            "taskDemandEn": "Under supervision dilute 25.00 mL 0.00250 M Ca(OH)2 to 250.0 mL; calculate mass/concentration/pH and compare NaOH at equal formal concentration and the supplied readings.",
            "expectedPerformanceDe": "c=2,500·10−4 M, gelöst 4,631 mg, [OH−]=2c und pH≈10,699. NaOH hat pH≈10,398. Eigene beobachtete Herstellung/Messung bleibt erforderlich; CO2, Aktivität und Messung begrenzen den Vergleich.",
            "expectedPerformanceEn": "c=2.500·10−4 M, dissolved mass 4.631 mg, [OH−]=2c and pH≈10.699. NaOH gives pH≈10.398. Own observed preparation/measurement is required; CO2, activity and measurement limit comparison.",
            "understandingFocusDe": "Geänderte Hydroxidstöchiometrie, keine automatische Übertragung auf NH3.",
            "understandingFocusEn": "Changed hydroxide stoichiometry, with no automatic extension to NH3."
          }
        ]
      },
      "wholeDependentProfile": {

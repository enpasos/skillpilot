      "wholePrerequisiteProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "b006-f5efab9d-core",
            "essentialUnderstandingDe": "Das Bohrsche Energiestufenmodell ordnet Elektronen einfacher Atome Schalen zu. Ein großer Sprung zwischen aufeinanderfolgenden Ionisierungsenergien deutet auf stärker gebundene innere Elektronen hin; die Messung zeichnet keine kreisförmigen Bahnen ab.",
            "essentialUnderstandingEn": "Bohr’s energy-level model allocates electrons of simple atoms to shells. A large jump between successive ionization energies suggests more strongly bound inner electrons; the measurement does not trace circular orbits.",
            "observablePerformanceDe": "Die lernende Person verbindet Ordnungszahl und begrenzte Schalenbelegung mit gegebenen Ionisierungsenergien und benennt die Reichweite des Modells.",
            "observablePerformanceEn": "The learner links atomic number and bounded shell occupation to supplied ionization energies and states the model’s limits."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b006-f5efab9d-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "outer-electrons",
            "textDe": "Ein beziehungsweise zwei Außenelektronen erzeugen einen Sprung nach unterschiedlicher Ionisation.",
            "textEn": "One versus two outer electrons cause a jump after a different ionization step."
          },
          {
            "id": "model-limit",
            "textDe": "Messdaten stützen Energieunterschiede, aber keine wörtlichen Elektronen-Kreisbahnen.",
            "textEn": "Measurements support energy differences, not literal electron circles."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "lithium-ionization-data",
            "taskDemandDe": "Für neutrales Li (Z=3) sind die ersten beiden Ionisierungsenergien rund 520 und 7298 kJ/mol. Gib eine einfache Schalenbelegung an und deute den Sprung.",
            "taskDemandEn": "For neutral Li (Z=3), the first two ionization energies are about 520 and 7298 kJ/mol. Give a simple shell occupancy and interpret the jump.",
            "expectedPerformanceDe": "2,1 Elektronen: Nach Entfernen des Außenelektrons betrifft die zweite Ionisation die innere Schale; Zahlen sind Hinweise auf Bindungsstärke, kein Bahnfotobeweis.",
            "expectedPerformanceEn": "2,1 electrons: after the outer electron is removed, the second ionization reaches the inner shell; the numbers indicate binding strength, not a photo of paths.",
            "understandingFocusDe": "Ein neuer Messdatensatz verbindet Modell und Messung.",
            "understandingFocusEn": "A new measured data set links model and measurement."
          },
          {
            "id": "magnesium-ionization-transfer",
            "taskDemandDe": "Für Mg (Z=12) sind die ersten drei Ionisierungsenergien rund 738, 1451 und 7733 kJ/mol. Schlage eine einfache Schalenbelegung vor und erkläre, was der große Sprung nach der zweiten Entfernung zeigt und nicht zeigt.",
            "taskDemandEn": "For Mg (Z=12), the first three ionization energies are about 738, 1451 and 7733 kJ/mol. Propose a simple shell occupancy and explain what the large jump after the second removal does and does not show.",
            "expectedPerformanceDe": "2,8,2 im einfachen Schalenmodell; zwei äußere Elektronen, danach stärker gebundenes inneres Elektron. Die Messwerte allein liefern keine exakten Orbitalformen oder klassischen Bahnen.",
            "expectedPerformanceEn": "2,8,2 in the simple shell model; two outer electrons, then a more strongly bound inner electron. Values alone give neither exact orbital shapes nor classical paths.",
            "understandingFocusDe": "Sprung an anderer Stelle prüft Transfer und Modellgrenze.",
            "understandingFocusEn": "A jump at another position tests transfer and the model limit."
          }
        ]
      },
      "wholeDependentProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "content-specific-understanding",
            "essentialUnderstandingDe": "Diskrete Spektrallinien und nichtmonotone Änderungen ersterIonisierungsenergien liefern Hinweise auf aufgespalteneUnterstufen; n unterscheidet Hauptschalen,l innerhalb einerHauptschale s/p-Typen.",
            "essentialUnderstandingEn": "Discrete spectral lines and nonmonotonic first-ionisation trends indicate split subshells;n distinguishes principal shells andl s/p types within a shell.",
            "observablePerformanceDe": "Linien stehen für bestimmteEnergiedifferenzen. Be/B zeigt trotz höhererKernladung leichtereEntfernung desB-2p-Elektrons alsBe-2s:Hinweis auf2s/2p-Energiedifferenz. Beide n2,s l0,p l1. GelbeFarbe allein legt weder vollständigeKonfiguration noch alleQuantenzahlen fest.",
            "observablePerformanceEn": "Lines correspond to specific energy differences.Despite greater nuclear charge,removingB’s2p electron costs less thanBe’s2s:an indication of2s/2p energy differences.Bothn2;s l0,p l1.Yellow colour alone identifies neither the full configuration nor all quantum numbers."
          },
          {
            "id": "fresh-transfer-and-model-boundary",
            "essentialUnderstandingDe": "Paarung ist ein Beitrag zurGesamtenergie,keine Behauptung,dass derN/O-Abfall dieExistenz einer neuenHauptschale beweist.",
            "essentialUnderstandingEn": "Pairing contributes to total energy;theN/O drop does not establish a new principal shell.",
            "observablePerformanceDe": "O-Entfernung aus einemgepaarten2p-Orbital ist gegenüberN-dreiEinzelbesetzungen begünstigt;O bleibt numerisch überC1086/Be900. Al-3p wird leichter entfernt alsMg-3s;beide n3,s l0,p l1. Die Person begründet zwei verschiedeneAbweichungen undhält numerischeRangfolgen ein.",
            "observablePerformanceEn": "RemovingO’s paired2p electron is favoured relative toN’s three single occupancies;O remains numerically aboveC1086/Be900.Al3p is easier to remove thanMg3s;bothn3,s l0,p l1.The learner explains two distinct departures and preserves numerical order."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "content-specific-understanding",
            "fresh-transfer-and-model-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "specific-material-variation",
            "textDe": "Linien-/Flammenbefund undBe/B gegenüberN/O;modellbezogeneInterpretation statt glatterTrendbehauptung.",
            "textEn": "Line/flame observations andBe/B versusN/O;model-based interpretation rather than an assumed smooth trend."
          },
          {
            "id": "specific-model-limit",
            "textDe": "Paarung ist ein Beitrag zurGesamtenergie,keine Behauptung,dass derN/O-Abfall dieExistenz einer neuenHauptschale beweist.",
            "textEn": "Pairing contributes to total energy;theN/O drop does not establish a new principal shell."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-next25-49235cbe-case-1",
            "taskDemandDe": "Gerundete ersteIonisierungsenergien(kJ/mol):Li520,Be900,B801,C1086,N1402,O1314,F1681,Ne2081. GegebeneKonfigurationen:Be2s²,B2s²2p¹,N2p³,O2p⁴;innere1s² bei allen. EinEmissionsspektrum zeigt getrennteLinien,eineNa-Flamme gelbesLicht. Deute diskreteLinien undBe/B-Abfall mitUnterstufen. Ordne2s/2p n,l zu und erkläre,welcheAussage eine bloßeFlammenfarbe noch nicht liefert.",
            "taskDemandEn": "Rounded first-ionisation energies(kJ/mol):Li520,Be900,B801,C1086,N1402,O1314,F1681,Ne2081.Given configurations:Be2s²,B2s²2p¹,N2p³,O2p⁴;all include core1s².An emission spectrum shows distinct lines,aNa flame yellow light. Interpret discrete lines and theBe/B drop using subshells.Assignn,l to2s/2p and explain what flame colour alone does not establish.",
            "expectedPerformanceDe": "Linien stehen für bestimmteEnergiedifferenzen. Be/B zeigt trotz höhererKernladung leichtereEntfernung desB-2p-Elektrons alsBe-2s:Hinweis auf2s/2p-Energiedifferenz. Beide n2,s l0,p l1. GelbeFarbe allein legt weder vollständigeKonfiguration noch alleQuantenzahlen fest.",
            "expectedPerformanceEn": "Lines correspond to specific energy differences.Despite greater nuclear charge,removingB’s2p electron costs less thanBe’s2s:an indication of2s/2p energy differences.Bothn2;s l0,p l1.Yellow colour alone identifies neither the full configuration nor all quantum numbers.",
            "understandingFocusDe": "EinSprung zwischen Linien ist keine kontinuierlicheElektronenbahn;firstIonisation bezeichnet genau ein entferntesElektron aus demgasförmigen neutralenAtom.",
            "understandingFocusEn": "A separation between lines is not a continuous electron orbit;first ionisation removes precisely one electron from a neutral gaseous atom."
          },
          {
            "id": "chem-next25-49235cbe-case-2",
            "taskDemandDe": "Frischer Vergleich:N1402,O1314 kJ/mol,N2p↑/↑/↑,O2p↑↓/↑/↑. Zusätzliche Daten:Na496,Mg738,Al578;Na3s¹,Mg3s²,Al3s²3p¹. ErkläreN/O mitPaarung undMg/Al mitUnterstufen;zeichne qualitativ richtigePunkthöhen undordne3s/3p n,l zu.",
            "taskDemandEn": "Fresh comparison:N1402,O1314kJ/mol,N2p↑/↑/↑,O2p↑↓/↑/↑.Extra data:Na496,Mg738,Al578;Na3s¹,Mg3s²,Al3s²3p¹. ExplainN/O using pairing andMg/Al using subshells;draw correctly ordered qualitative point heights and assignn,l to3s/3p.",
            "expectedPerformanceDe": "O-Entfernung aus einemgepaarten2p-Orbital ist gegenüberN-dreiEinzelbesetzungen begünstigt;O bleibt numerisch überC1086/Be900. Al-3p wird leichter entfernt alsMg-3s;beide n3,s l0,p l1. Die Person begründet zwei verschiedeneAbweichungen undhält numerischeRangfolgen ein.",
            "expectedPerformanceEn": "RemovingO’s paired2p electron is favoured relative toN’s three single occupancies;O remains numerically aboveC1086/Be900.Al3p is easier to remove thanMg3s;bothn3,s l0,p l1.The learner explains two distinct departures and preserves numerical order.",
            "understandingFocusDe": "Paarung ist ein Beitrag zurGesamtenergie,keine Behauptung,dass derN/O-Abfall dieExistenz einer neuenHauptschale beweist.",
            "understandingFocusEn": "Pairing contributes to total energy;theN/O drop does not establish a new principal shell."
          }
        ]
      }

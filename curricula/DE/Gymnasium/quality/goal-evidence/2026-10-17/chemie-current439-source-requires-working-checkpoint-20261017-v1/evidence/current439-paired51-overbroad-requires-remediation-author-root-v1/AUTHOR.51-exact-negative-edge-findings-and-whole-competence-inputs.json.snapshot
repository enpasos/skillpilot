        },
        "variationAxes": [
          {
            "id": "v1",
            "textDe": "Vernetzung und Verzweigung",
            "textEn": "Crosslinking and branching"
          },
          {
            "id": "v2",
            "textDe": "Temperatur und Belastung",
            "textEn": "Temperature and loading"
          },
          {
            "id": "v3",

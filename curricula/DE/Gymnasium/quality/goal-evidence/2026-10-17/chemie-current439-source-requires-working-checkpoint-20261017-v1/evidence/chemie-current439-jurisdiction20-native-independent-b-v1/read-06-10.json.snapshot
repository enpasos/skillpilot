      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Viskose und Cellulosederivate als Textilfasern erklären",
        "url": "/assets/goal-visualizations/chemie/f57d53b0-5bdf-5998-81f4-8bfb2fc5bde7/f57d53b0-5bdf-5998-81f4-8bfb2fc5bde7.png",
        "altText": "Zwei Wege einer schematischen Cellulosekette: Regeneration erhält Cellulose als Viskose; chemische Modifikation ersetzt einige OH-Gruppen durch Acetatgruppen. Fäden und Gewebe zeigen die Textilverwendung.",
        "originalDigest": "sha256:5a7543d35e2396ece94104d1bc55b0c7fa677a00bb5b01e6c05ae249360fdceb",

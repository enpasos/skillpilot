      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Leitfähige Kunststoffe anwenden und mit Metallen vergleichen",
        "url": "/assets/goal-visualizations/chemie/14f1fe97-0585-5738-845e-9c49173d8afa/14f1fe97-0585-5738-845e-9c49173d8afa.jpg",
        "altText": "Didaktische Visualisierung zum Lernziel \"Leitfähige Kunststoffe anwenden und mit Metallen vergleichen\". Die lernende Person kann Einsatzmöglichkeiten elektrisch leitfähiger Kunststoffe beschreiben und Vorteile sowie Nachteile gegenüber metallischen Leitern beurteilen.",
        "originalDigest": "sha256:8ddb0082e924d39885d93b2a0053ed605802d69e91efd5915014d6f80971c576",
        "qaStatus": "review_candidate",
        "approvedForPublication": false

      "externalReverseRequires": [],
      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Leitfähige Kunststoffe über konjugierte Systeme erklären",
        "url": "/assets/goal-visualizations/chemie/73cbd4d8-5da1-5e54-85ce-c88e7b1613fe/73cbd4d8-5da1-5e54-85ce-c88e7b1613fe.png",
        "altText": "Gemeinsames elektrisches Feld nach rechts; positive Löcher nach rechts und negative Elektronen nach links, Konjugation und Dotierung getrennt. Neutrales konjugiertes System mit wenigen mobilen Trägern statt absolutem Trägerausschluss.",
        "originalDigest": "sha256:621e404994a407b1df1da568e7b073a6000d8207474a88cf39cd0a88488ad957",
        "qaStatus": "review_candidate",
        "approvedForPublication": false
      }
    },
    "profile": {
      "archetype": "modeling",
      "expectations": [
        {
          "id": "e1",
          "essentialUnderstandingDe": "Ausgedehnte Konjugation ermöglicht delokalisierte π-Systeme; ein isoliertes Doppelbindungsmotiv genügt nicht.",
          "essentialUnderstandingEn": "Extended conjugation permits delocalised π systems; an isolated double bond is insufficient.",
          "observablePerformanceDe": "Unterscheidet gesättigte, isoliert ungesättigte und konjugierte Ketten.",
          "observablePerformanceEn": "Distinguishes saturated, isolated-unsaturated and conjugated chains."
        },
        {
          "id": "e2",
          "essentialUnderstandingDe": "Hohe Leitfähigkeit erfordert geeignete Ladungsträger und Transportwege; Dotierung kann Ladungsträger erzeugen.",
          "essentialUnderstandingEn": "High conductivity requires suitable charge carriers and transport paths; doping can generate carriers.",
          "observablePerformanceDe": "Erklärt gegebene Dotierungsdaten ohne allein aus Konjugation Metallleitfähigkeit abzuleiten.",
          "observablePerformanceEn": "Explains supplied doping data without inferring metallic conductivity from conjugation alone."
        },
        {
          "id": "e3",
          "essentialUnderstandingDe": "Kettenordnung, Defekte und Kontakte beeinflussen makroskopischen Transport.",
          "essentialUnderstandingEn": "Chain order, defects and contacts affect macroscopic transport.",
          "observablePerformanceDe": "Überträgt das Modell auf einen veränderten Kettenabschnitt und nennt eine Messgrenze.",
          "observablePerformanceEn": "Transfers the model to a modified chain segment and identifies a measurement limit."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "e1",
          "e2",
          "e3"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "v1",
          "textDe": "Konjugationslänge",
          "textEn": "Conjugation length"
        },
        {
          "id": "v2",
          "textDe": "Dotierungszustand",
          "textEn": "Doping state"
        },
        {
          "id": "v3",
          "textDe": "Kettenordnung und Defekte",
          "textEn": "Chain order and defects"
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "73cbd4d8-case-1",
          "taskDemandDe": "Zeige Konjugation und erkläre Unterschiede. Berechne Dotierungsfaktor und beschreibe Ladungsausgleich durch Gegenionen. Prüfe „jede Doppelbindung macht Kunststoff zum Metall“.",
          "taskDemandEn": "Identify conjugation and explain differences. Calculate the doping factor and describe charge compensation by counterions. Assess “any double bond makes a plastic metallic”.",
          "expectedPerformanceDe": "Polyacetylen besitzt alternierende Doppel-/Einfachbindungen und gekoppeltes π-System; PE nicht. Oxidation entzieht Elektronen, erzeugt positive elektronische Ladungsträger mit Gegenionenausgleich. Faktor 10⁷ relativ zur neutralen Probe. Konjugation allein reicht nicht für hohe Leitfähigkeit; Trägerdichte, Beweglichkeit und Transport zwischen Ketten zählen. Einzelne Doppelbindungen sind kein ausgedehntes Transportnetz.",
          "expectedPerformanceEn": "Polyacetylene has alternating double/single bonds and a coupled π system; PE does not. Oxidation removes electrons, producing positive electronic carriers with counterion compensation. Factor 10⁷ over the neutral sample. Conjugation alone does not yield high conductivity; carrier density, mobility and interchain transport matter. Isolated double bonds do not form an extended transport network.",
          "understandingFocusDe": "Fallbezogene Aspekte: Alternierendes Polyacetylen konjugiert, PE gesättigt; einzelne Doppelbindung garantiert kein Transportnetz. / Oxidative Dotierung erzeugt positive Träger mit Gegenionen; 10⁴/10⁻³=10⁷. / Trägerdichte/Beweglichkeit/Interkettentransport nötig; aus Konjugation allein keine allgemeine Metallleitfähigkeit. Die Verknüpfung zu Erwartungs-IDs behauptet keine vollständige Erfüllung jeder Gesamtprofilerwartung in diesem Einzelfall.",
          "understandingFocusEn": "Case-specific aspects: Alternating polyacetylene conjugated, PE saturated; single double bond guarantees no transport network. / Oxidative doping creates positive carriers with counterions; 10⁴/10⁻³=10⁷. / Carrier density/mobility/interchain transport needed; conjugation alone implies no general metallic conductivity. Links to expectation IDs do not assert complete fulfilment of every whole-profile expectation in this one case."
        },
        {
          "id": "73cbd4d8-case-2",
          "taskDemandDe": "Erkläre B und C getrennt. Entwirf eine Messkontrolle, die intrinsische Kettenwirkung von Kontaktwirkung trennt. Warum garantiert gleiche Dotierungsmenge nicht dieselbe Leitfähigkeit?",
          "taskDemandEn": "Explain B and C separately. Propose a control separating intrinsic chain effects from contact effects. Why does equal dopant loading not guarantee equal conductivity?",
          "expectedPerformanceDe": "sp³-Zentren unterbrechen die π-Kopplung, kürzere Delokalisationsbereiche erschweren Transport; Faktor 100 Unterschied passt dazu, beweist ihn nicht allein. C zeigt Kontaktbeitrag zur Messung. Gleiche Geometrie und Vierpunktmessung mit kontrollierter Morphologie/Temperatur helfen Kontaktartefakte zu trennen. Dotiermenge ist nicht automatisch mobile Trägerdichte; Defekte, Ordnung und Aktivierung unterscheiden sich.",
          "expectedPerformanceEn": "sp³ centres interrupt π coupling; shorter delocalisation regions impede transport. A factor 100 difference is consistent with this but not conclusive alone. C demonstrates contact contributions. Matched geometry and four-point measurements with controlled morphology/temperature help separate contact artefacts. Dopant amount is not automatically mobile-carrier density; defects, order and activation differ.",
          "understandingFocusDe": "Fallbezogene Aspekte: sp³-Unterbrechung verkürzt π-Kopplung; durchgehende Kette von Kontaktfehler unterscheiden. / A/B-Faktor 100 mit gleichem Dotieranteil; Dotiermenge nicht zwingend mobile Trägerdichte. / Vierpunktmessung mit gleicher Geometrie/Morphologie/Temperatur trennt Kontaktbeitrag; Daten allein beweisen Mechanismus nicht. Die Verknüpfung zu Erwartungs-IDs behauptet keine vollständige Erfüllung jeder Gesamtprofilerwartung in diesem Einzelfall.",
          "understandingFocusEn": "Case-specific aspects: sp³ interruption shortens π coupling; distinguish continuous chain from contact fault. / A/B factor 100 at equal doping amount; dopant amount not necessarily mobile carrier density. / Four-point measurement at same geometry/morphology/temperature separates contact contribution; data alone do not prove mechanism. Links to expectation IDs do not assert complete fulfilment of every whole-profile expectation in this one case."
        }
      ]
    }
  },

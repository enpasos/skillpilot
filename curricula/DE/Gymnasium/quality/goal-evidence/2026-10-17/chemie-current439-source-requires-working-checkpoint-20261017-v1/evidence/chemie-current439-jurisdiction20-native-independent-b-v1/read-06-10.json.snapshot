      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Synthetischen Kautschuk und Vulkanisation erklären",
        "url": "/assets/goal-visualizations/chemie/4955f745-b946-5d3d-82d6-5e52dc8549a3/4955f745-b946-5d3d-82d6-5e52dc8549a3.png",
        "altText": "Monomerbausteine verbinden sich zu beweglichen Polymerketten. In der Vernetzungsskizze verbinden gelbe Schwefelbrücken drei durchgehend rote Ketten; ein Gummiband verdeutlicht elastische Verformbarkeit.",
        "originalDigest": "sha256:fe4c85cb55eef7dc483e16136bf2d571249eed570bf34c46f5994c3ed2355cc6",
        "qaStatus": "review_candidate",
        "approvedForPublication": false

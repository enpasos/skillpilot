      "wholeProfile": {
        "archetype": "data",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Recherche muss Quelle, Stoffidentität, Nutzung und Gesundheitsbehauptung nachvollziehbar verbinden.",
            "essentialUnderstandingEn": "Research must traceably connect source, chemical identity, use and health claim.",
            "observablePerformanceDe": "Entnimmt Primärinformationen und belegt Fundstelle statt Werbeaussagen zu übernehmen.",
            "observablePerformanceEn": "Extracts primary information with a locator rather than adopting advertising."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Gesundheitsbewertung unterscheidet Gefährdung von Exposition und vergleicht gleichartige Anwendungen.",
            "essentialUnderstandingEn": "Health judgment distinguishes hazard from exposure and compares like applications.",
            "observablePerformanceDe": "Gewichtet Nutzen, Exposition und Evidenzgrenzen.",
            "observablePerformanceEn": "Weighs benefit, exposure and evidence limits."

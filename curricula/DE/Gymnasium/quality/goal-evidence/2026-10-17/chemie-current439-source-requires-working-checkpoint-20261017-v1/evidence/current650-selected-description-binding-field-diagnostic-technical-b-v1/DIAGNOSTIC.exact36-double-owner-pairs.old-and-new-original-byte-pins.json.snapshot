        "PProfileDifferences": [
          {
            "field": "",
            "before": null,
            "current": {
              "archetype": "representation",
              "expectations": [
                {
                  "id": "structure-model-reasoning",
                  "essentialUnderstandingDe": "Ein tetraedrisches C mit vier verschiedenen Substituenten ist in den einfachen vorgegebenen Molekülen ein Stereozentrum; ganze Substituenten, nicht nur das erste Atom, werden verglichen.",
                  "essentialUnderstandingEn": "A tetrahedral C with four different substituents is a stereocentre in the simple supplied molecules; complete substituents, not just their first atoms, are compared.",
                  "observablePerformanceDe": "Die Person markiert das relevante C und zählt/zeichnet die vier vollständigen Substituenten; sie begründet auch ein negatives Beispiel.",
                  "observablePerformanceEn": "The learner marks the relevant C and counts/draws all four complete substituents, also justifying a negative example."
                },
                {
                  "id": "fresh-application-and-boundary",
                  "essentialUnderstandingDe": "Vier Bindungen allein oder ein beliebiges C-Atom genügen nicht; ein sp2-Carbonyl-C ist in diesen Fällen kein tetraedrisches C-Stereozentrum.",
                  "essentialUnderstandingEn": "Four bonds alone or any C atom are insufficient; an sp2 carbonyl C is not a tetrahedral carbon stereocentre in these cases.",
                  "observablePerformanceDe": "Butan-2-ol trägt OH, H, Methyl und Ethyl, also vier verschiedene Gruppen; Propan-2-ol trägt zwei gleiche Methylgruppen. Beim Vergleich der beiden C-Nachbarn muss die weitere Verknüpfung betrachtet werden. Eine R/S-Zuordnung oder optische Drehung wird aus dieser unveränderten Zielbeschreibung nicht als zusätzliche Pflicht erfunden.",
                  "observablePerformanceEn": "Butan-2-ol bears OH, H, methyl and ethyl, hence four different groups; propan-2-ol has two identical methyl groups. Comparing C neighbours requires tracing the further connectivity. R/S assignment or optical rotation is not invented as an extra requirement of this unchanged goal."
                }
              ],
              "coverageExpectations": {
                "requiredExpectationIds": [
                  "structure-model-reasoning",
                  "fresh-application-and-boundary"
                ],
                "alternativeExpectationGroups": [],
                "minimumIndependentDemonstrations": 2,
                "freshVariationRequired": true,
                "independentTransferRequired": true
              },
              "variationAxes": [
                {
                  "id": "material-variation",
                  "textDe": "Aminosäure versus achirale Kontrolle; OH/Alkyl-Transfer mit zunächst gleichem Bindungsatom.",
                  "textEn": "Amino acid versus achiral control; OH/alkyl transfer with initially identical attached atoms."
                },
                {
                  "id": "counterexample",
                  "textDe": "Vier Bindungen allein oder ein beliebiges C-Atom genügen nicht; ein sp2-Carbonyl-C ist in diesen Fällen kein tetraedrisches C-Stereozentrum.",
                  "textEn": "Four bonds alone or any C atom are insufficient; an sp2 carbonyl C is not a tetrahedral carbon stereocentre in these cases."
                }
              ],
              "applicationCaseBriefs": [
                {
                  "id": "chem-current15-b92bfa45-case-1",
                  "taskDemandDe": "Vollständige Strukturen: Alanin NH2-CH(CH3)-COOH und Glycin NH2-CH2-COOH; keine weiteren Stereozentren werden vorausgesetzt. Markiere mögliche asymmetrische C-Atome und begründe beide Entscheidungen über die gebundenen Gruppen.",
                  "taskDemandEn": "Complete structures: alanine NH2-CH(CH3)-COOH and glycine NH2-CH2-COOH; no additional stereocentres are assumed. Mark possible asymmetric C atoms and justify both decisions using attached groups.",
                  "expectedPerformanceDe": "Alanin besitzt am α-C NH2, H, CH3 und COOH: vier verschiedene Gruppen. Glycin besitzt dort zweimal H und deshalb in diesem Modell kein solches Stereozentrum. Das Carbonyl-C der Carboxygruppe ist trigonal, nicht tetraedrisch.",
                  "expectedPerformanceEn": "Alanine α-C bears NH2, H, CH3 and COOH: four different groups. Glycine bears H twice there and has no such stereocentre. The carboxyl carbonyl C is trigonal rather than tetrahedral.",
                  "understandingFocusDe": "Diese Primäranforderung steht aktuell HE Q2.1, nicht als pauschale HE-Q1-GK-Anforderung.",
                  "understandingFocusEn": "This primary requirement is currently in HE Q2.1, not a blanket HE-Q1-GK requirement."
                },
                {
                  "id": "chem-current15-b92bfa45-case-2",
                  "taskDemandDe": "Frische Strukturen: Butan-2-ol CH3-CH(OH)-CH2-CH3 und Propan-2-ol CH3-CH(OH)-CH3. Prüfe das OH-tragende C jeweils und erkläre, weshalb zwei Kohlenstoff-Nachbarn nicht automatisch gleiche Substituenten bedeuten.",
                  "taskDemandEn": "Fresh structures: butan-2-ol CH3-CH(OH)-CH2-CH3 and propan-2-ol CH3-CH(OH)-CH3. Examine each OH-bearing C and explain why two carbon neighbours do not automatically mean identical substituents.",
                  "expectedPerformanceDe": "Butan-2-ol trägt OH, H, Methyl und Ethyl, also vier verschiedene Gruppen; Propan-2-ol trägt zwei gleiche Methylgruppen. Beim Vergleich der beiden C-Nachbarn muss die weitere Verknüpfung betrachtet werden.",
                  "expectedPerformanceEn": "Butan-2-ol bears OH, H, methyl and ethyl, hence four different groups; propan-2-ol has two identical methyl groups. Comparing C neighbours requires tracing the further connectivity.",
                  "understandingFocusDe": "Eine R/S-Zuordnung oder optische Drehung wird aus dieser unveränderten Zielbeschreibung nicht als zusätzliche Pflicht erfunden.",
                  "understandingFocusEn": "R/S assignment or optical rotation is not invented as an extra requirement of this unchanged goal."
                }
              ]
            }
          }
        ],

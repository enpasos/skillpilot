          },
          {
            "field": "expectations",
            "before": [
              {
                "id": "e1",
                "essentialUnderstandingDe": "Unter festgelegten pH- und Matrixbedingungen bindet EDTA die erfassten Metallionen im Verhältnis 1:1; Puffer und Metallindikator ermöglichen einen auswertbaren Endpunkt.",
                "essentialUnderstandingEn": "Under specified pH and matrix conditions, EDTA binds the measured metal ions in a 1:1 ratio; buffer and metal indicator enable an interpretable endpoint.",
                "observablePerformanceDe": "Die lernende Person erklärt Komplexbildung, bedingte Stabilität und Indikatorverdrängung und begrenzt den Befund auf die Ca/Mg-Summe.",
                "observablePerformanceEn": "The learner explains complex formation, conditional stability and indicator displacement, limiting the result to the Ca/Mg sum."
              },
              {
                "id": "e2",
                "essentialUnderstandingDe": "Eine durchgeführte Titration erfordert beobachtetes sachgerechtes Handeln; eine gelesene Verbrauchstabelle belegt diese Handlung nicht.",
                "essentialUnderstandingEn": "Performing a titration requires observed competent handling; reading a titer table does not demonstrate that action.",
                "observablePerformanceDe": "Sie stellt nach tatsächlicher örtlicher Freigabe Verdünnungen und Aliquote her, bedient die Bürette und dokumentiert pH, Ablesungen und kontrollierten Farbumschlag. Ohne reale Beobachtung bleibt dieser Nachweis offen.",
                "observablePerformanceEn": "After actual local authorization, the learner prepares dilutions and aliquots, operates the burette and records pH, readings and a controlled colour endpoint. Without real observation this evidence remains absent."
              },
              {
                "id": "e3",
                "essentialUnderstandingDe": "Blindwert, Aliquot und Verdünnung beziehen den stöchiometrisch ermittelten Metallgehalt auf die ursprüngliche Probe.",
                "essentialUnderstandingEn": "Blank, aliquot and dilution relate the stoichiometric metal amount to the original sample.",
                "observablePerformanceDe": "Sie korrigiert den mittleren Verbrauch, berechnet Stoffmenge und Summenkonzentration mit Einheiten und begründet den Rückrechnungsfaktor bei der verdünnten Probe.",
                "observablePerformanceEn": "The learner corrects the mean titer, calculates amount and total concentration with units and explains the dilution factor back to the original sample."
              },
              {
                "id": "e4",
                "essentialUnderstandingDe": "Wiederholbarkeit, Wiederfindung und Selektivität beantworten verschiedene Fragen; eine gute Wiederfindung trennt Ca und Mg nicht.",
                "essentialUnderstandingEn": "Repeatability, recovery and selectivity answer different questions; good recovery does not separate Ca from Mg.",
                "observablePerformanceDe": "Sie berechnet die Referenz- beziehungsweise Aufstockwiederfindung, prüft die vorgegebene Toleranz und widerlegt eine unzulässige Einzelmetall- oder universelle Matrixaussage.",
                "observablePerformanceEn": "The learner calculates reference or spike recovery, checks the supplied tolerance and refutes an unsupported individual-metal or universal matrix claim."
              }
            ],
            "current": [
              {
                "id": "e1",

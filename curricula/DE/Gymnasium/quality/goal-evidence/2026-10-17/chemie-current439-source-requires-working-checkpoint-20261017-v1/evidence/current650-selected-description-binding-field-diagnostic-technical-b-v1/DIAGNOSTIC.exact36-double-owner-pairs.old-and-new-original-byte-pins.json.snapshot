        "PProfileDifferences": [
          {
            "field": "",
            "before": null,
            "current": {
              "archetype": "modeling",
              "expectations": [
                {
                  "id": "b006-fcaf8c9b-core",
                  "essentialUnderstandingDe": "Ein starres Modell isolierter neutraler Dalton-Kugeln erklärt gleichzeitig metallische Leitfähigkeit und Verformbarkeit nicht. Ein einfaches Metallmodell mit positiven Atomrümpfen und beweglichen Elektronen kann beide Eigenschaften qualitativ deuten; es ist keine exakte Bandstruktur.",
                  "essentialUnderstandingEn": "Rigid isolated neutral Dalton spheres do not explain metallic conductivity and malleability together. A simple metal model with positive cores and mobile electrons can qualitatively account for both; it is not an exact band structure.",
                  "observablePerformanceDe": "Die lernende Person wählt zwischen Modellen anhand gegebener Stoffeigenschaften, nennt die nötigen Modellannahmen und eine Grenze.",
                  "observablePerformanceEn": "The learner selects between models from supplied material properties, names the necessary assumptions and a limit."
                }
              ],
              "coverageExpectations": {
                "requiredExpectationIds": [
                  "b006-fcaf8c9b-core"
                ],
                "alternativeExpectationGroups": [],
                "minimumIndependentDemonstrations": 2,
                "freshVariationRequired": true,
                "independentTransferRequired": true
              },
              "variationAxes": [
                {
                  "id": "metal",
                  "textDe": "Kupfer und Aluminium liefern unabhängige Metallbeispiele.",
                  "textEn": "Copper and aluminium provide independent metal cases."
                },
                {
                  "id": "counterexample",
                  "textDe": "Leitfähigkeit allein beweist Metallcharakter nicht, wie Graphit zeigt.",
                  "textEn": "Conductivity alone does not prove metallic character, as graphite shows."
                }
              ],
              "applicationCaseBriefs": [
                {
                  "id": "copper-model-choice",
                  "taskDemandDe": "Zwei gezeichnete Modelle für einen Kupferstreifen sind vorgegeben: getrennte starre neutrale Kugeln oder positive Atomrümpfe mit beweglichen Elektronen. Der Streifen leitet auch nach Biegen gut. Wähle und begründe.",
                  "taskDemandEn": "Two sketches for a copper strip are supplied: isolated rigid neutral spheres or positive cores with mobile electrons. The strip conducts well even after bending. Choose and justify.",
                  "expectedPerformanceDe": "Das zweite einfache Modell erklärt bewegliche Elektronen und zusammenhaltende, gegeneinander verschiebbare Rümpfe; starre isolierte Kugeln leisten beides nicht. Keine Bandstruktur wird behauptet.",
                  "expectedPerformanceEn": "The second simple model accounts for mobile electrons and cohesive yet shiftable cores; isolated rigid spheres do neither. No band structure is claimed.",
                  "understandingFocusDe": "Beobachtung begründet einen Modellwechsel.",
                  "understandingFocusEn": "Observation motivates model revision."
                },
                {
                  "id": "aluminium-graphite-transfer",
                  "taskDemandDe": "Ein neues Datenblatt nennt Aluminium leitfähig und verformbar, Graphit leitfähig, aber spröde. Entwickle für Aluminium ein einfaches Metallmodell und beurteile die Aussage „jeder Leiter ist ein Metall“.",
                  "taskDemandEn": "A fresh data sheet says aluminium is conductive and malleable while graphite is conductive but brittle. Build a simple metal model for aluminium and assess “every conductor is a metal.”",
                  "expectedPerformanceDe": "Positive Aluminium-Atomrümpfe und mobile Elektronen erklären die kombinierten Metalleigenschaften qualitativ; Graphit widerlegt den Umkehrschluss aus Leitfähigkeit allein. Das Modell sagt keine vollständige Graphitstruktur voraus.",
                  "expectedPerformanceEn": "Positive aluminium cores and mobile electrons qualitatively explain the combined metal properties; graphite defeats the reverse inference from conduction alone. The model does not purport to explain graphite fully.",
                  "understandingFocusDe": "Gegenbeispiel prüft Modellgüte statt Schlagwortwiedergabe.",
                  "understandingFocusEn": "A counterexample tests model quality beyond naming it."
                }
              ]
            }
          }
        ],

            "current": {
              "archetype": "procedure",
              "expectations": [
                {
                  "id": "content-specific-understanding",
                  "essentialUnderstandingDe": "Verhältnisformeln von Salzen geben das kleinste elektrisch neutrale Ionenverhältnis an; mehratomige Ionen bleiben bei der Bilanz zusammen. Gitterbindung und Beweglichkeit erklären Stoffeigenschaften.",
                  "essentialUnderstandingEn": "Salt formula units give the smallest electrically neutral ion ratio; polyatomic ions remain intact in charge accounting. Lattice bonding and mobility explain properties.",
                  "observablePerformanceDe": "MgCl2:1×2+2×(−1)=0; Al2O3:2×3+3×(−2)=0. Magnesiumchlorid/Aluminiumoxid. Im festen Gitter sind Ionen ortsgebunden; in Lösung/Schmelze beweglich. Verschiebung erzeugt abstoßende Nachbarschaften und Bruch.",
                  "observablePerformanceEn": "MgCl2:1×2+2×(−1)=0; Al2O3:2×3+3×(−2)=0. Magnesium chloride/aluminium oxide. Solid-lattice ions are fixed; solution/melt ions mobile. Shifting creates repulsive neighbours and fracture."
                },
                {
                  "id": "fresh-transfer-and-model-boundary",
                  "essentialUnderstandingDe": "Ladungsausgleich verändert weder die innere Nitrat-/Sulfatformel noch beweist er, dass jedes Salz gut wasserlöslich ist.",
                  "essentialUnderstandingEn": "Charge balancing changes neither nitrate/sulfate composition nor establishes that every salt is water-soluble.",
                  "observablePerformanceDe": "Ca(NO3)2 und (NH4)2SO4: jeweils Ladung0, N/O/H innerhalb der Molekül-Ionen unverändert. Calciumnitrat/Ammoniumsulfat. Ca2+ benötigt2 Cl−, daher CaCl2. Klammern vervielfachen das ganze mehratomige Ion.",
                  "observablePerformanceEn": "Ca(NO3)2 and (NH4)2SO4: each charge0, internal N/O/H composition unchanged. Calcium nitrate/ammonium sulfate. Ca2+ needs2 Cl−, hence CaCl2. Brackets multiply the whole polyatomic ion."
                }
              ],
              "coverageExpectations": {
                "requiredExpectationIds": [
                  "content-specific-understanding",
                  "fresh-transfer-and-model-boundary"
                ],
                "alternativeExpectationGroups": [],
                "minimumIndependentDemonstrations": 2,
                "freshVariationRequired": true,
                "independentTransferRequired": true
              },
              "variationAxes": [
                {
                  "id": "specific-material-variation",
                  "textDe": "Einatomige gegenüber mehratomigen Ionen; festes Salz, Lösung und Schmelze.",
                  "textEn": "Monatomic versus polyatomic ions; solid salt, solution and melt."
                },
                {
                  "id": "specific-model-limit",
                  "textDe": "Ladungsausgleich verändert weder die innere Nitrat-/Sulfatformel noch beweist er, dass jedes Salz gut wasserlöslich ist.",
                  "textEn": "Charge balancing changes neither nitrate/sulfate composition nor establishes that every salt is water-soluble."
                }
              ],
              "applicationCaseBriefs": [
                {
                  "id": "chem-next25-965ca297-case-1",
                  "taskDemandDe": "Ionen und Namen: Mg2+/Cl− (Magnesium/Chlorid), Al3+/O2− (Aluminium/Oxid). Festes NaCl leitet kaum; NaCl-Lösung und Schmelze leiten. Ein verschobenes Gitter bringt gleichnamige Ladungen nebeneinander. Leite Formeln und Namen ab, prüfe Ladungen und erkläre Leitfähigkeit und Sprödigkeit aus dem Ionenmodell.",
                  "taskDemandEn": "Ions and names: Mg2+/Cl− (magnesium/chloride), Al3+/O2− (aluminium/oxide). Solid NaCl conducts poorly; solution and melt conduct. A shifted lattice brings like charges together. Derive formulas and names, check charges and explain conductivity and brittleness using the ionic model.",
                  "expectedPerformanceDe": "MgCl2:1×2+2×(−1)=0; Al2O3:2×3+3×(−2)=0. Magnesiumchlorid/Aluminiumoxid. Im festen Gitter sind Ionen ortsgebunden; in Lösung/Schmelze beweglich. Verschiebung erzeugt abstoßende Nachbarschaften und Bruch.",
                  "expectedPerformanceEn": "MgCl2:1×2+2×(−1)=0; Al2O3:2×3+3×(−2)=0. Magnesium chloride/aluminium oxide. Solid-lattice ions are fixed; solution/melt ions mobile. Shifting creates repulsive neighbours and fracture.",
                  "understandingFocusDe": "Al2O3 bedeutet2 Al-Ionen und3 O-Ionen im Verhältnis, keine diskreten Al2O3-Moleküle.",
                  "understandingFocusEn": "Al2O3 means a2:3 Al-ion/O-ion ratio, not discrete Al2O3 molecules."
                },
                {
                  "id": "chem-next25-965ca297-case-2",
                  "taskDemandDe": "Frischer Fall: Ca2+, NO3− (Nitrat), NH4+ (Ammonium), SO4²− (Sulfat). Ein Entwurf nennt CaNO3 und (NH4)SO4. Korrigiere Formeln, benenne die Salze und erkläre Klammern. Begründe, warum der Name Calciumchlorid das Verhältnis CaCl2 festlegt.",
                  "taskDemandEn": "Fresh case: Ca2+, NO3− (nitrate), NH4+ (ammonium), SO4²− (sulfate). A draft gives CaNO3 and (NH4)SO4. Correct formulas, name the salts and explain brackets. Explain why calcium chloride specifies CaCl2.",
                  "expectedPerformanceDe": "Ca(NO3)2 und (NH4)2SO4: jeweils Ladung0, N/O/H innerhalb der Molekül-Ionen unverändert. Calciumnitrat/Ammoniumsulfat. Ca2+ benötigt2 Cl−, daher CaCl2. Klammern vervielfachen das ganze mehratomige Ion.",
                  "expectedPerformanceEn": "Ca(NO3)2 and (NH4)2SO4: each charge0, internal N/O/H composition unchanged. Calcium nitrate/ammonium sulfate. Ca2+ needs2 Cl−, hence CaCl2. Brackets multiply the whole polyatomic ion.",
                  "understandingFocusDe": "Ladungsausgleich verändert weder die innere Nitrat-/Sulfatformel noch beweist er, dass jedes Salz gut wasserlöslich ist.",
                  "understandingFocusEn": "Charge balancing changes neither nitrate/sulfate composition nor establishes that every salt is water-soluble."
                }
              ]
            }
          }
        ],

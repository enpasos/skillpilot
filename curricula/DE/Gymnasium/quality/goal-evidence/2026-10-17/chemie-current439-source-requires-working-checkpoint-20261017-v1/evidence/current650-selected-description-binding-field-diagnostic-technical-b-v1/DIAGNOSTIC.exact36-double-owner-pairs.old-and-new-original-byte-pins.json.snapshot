        "PProfileDifferences": [
          {
            "field": "",
            "before": null,
            "current": {
              "archetype": "modeling",
              "expectations": [
                {
                  "id": "stoichiometric-ion-concentration",
                  "essentialUnderstandingDe": "Bei vollständig dissoziierten starken Lösungen bestimmt die Formelstöchiometrie den Solutbeitrag zu H3O+ bzw. OH−.",
                  "essentialUnderstandingEn": "For fully dissociated strong solutions, formula stoichiometry determines the solute contribution to H3O+ or OH−.",
                  "observablePerformanceDe": "Die lernende Person leitet die Ionenkonzentrationen für HCl, HNO3, NaOH und Ca(OH)2 ab und erklärt den Faktor zwei der klaren Ca(OH)2-Modelllösung.",
                  "observablePerformanceEn": "The learner derives ion concentrations for HCl, HNO3, NaOH and Ca(OH)2 and explains the factor of two in the clear Ca(OH)2 model solution."
                },
                {
                  "id": "ph-poh-logarithms",
                  "essentialUnderstandingDe": "pH und pOH beziehen sich auf verschiedene Ionen; bei 25 °C verknüpft pH+pOH=14 die beiden logarithmischen Größen.",
                  "essentialUnderstandingEn": "pH and pOH refer to different ions; at 25 °C, pH+pOH=14 connects these logarithmic quantities.",
                  "observablePerformanceDe": "Sie berechnet etwa pH 2.00 für 0.0100 M HCl und pH 11.301 über pOH 2.699 für 0.00200 M OH−.",
                  "observablePerformanceEn": "The learner calculates pH 2.00 for 0.0100 M HCl and pH 11.301 through pOH 2.699 for 0.00200 M OH−."
                },
                {
                  "id": "interpret-records-cautiously",
                  "essentialUnderstandingDe": "Eine Abweichung von Modell und Protokoll lässt sich feststellen; ihre konkrete Ursache benötigt zusätzliche Angaben.",
                  "essentialUnderstandingEn": "Disagreement between model and record can be established, while its specific cause requires further information.",
                  "observablePerformanceDe": "Sie beurteilt die vorgegebenen Werte 3.00 und 2.70 als unpassend zum bezeichneten Modell und trennt eine mögliche pOH-Verwechslung von einer bewiesenen Ursache.",
                  "observablePerformanceEn": "The learner judges the supplied 3.00 and 2.70 values against the labelled model and distinguishes possible pOH confusion from a proven cause."
                },
                {
                  "id": "dilution-and-water-limit",
                  "essentialUnderstandingDe": "Verdünnung nähert starke Säuren und Basen dem neutralen Bereich; nahe der Eigenionisation darf die Solutkonzentration nicht allein als Ionenkonzentration gelten.",
                  "essentialUnderstandingEn": "Dilution moves strong acids and bases toward neutrality; near water’s self-ionization, solute concentration alone cannot represent ion concentration.",
                  "observablePerformanceDe": "Sie begründet die entgegengesetzten pH-Änderungen bei zehnfacher Verdünnung und verwendet für 10−9 M HCl die gegebene Hilfsgleichung, um pH≈6.9978 statt 9 zu erhalten.",
                  "observablePerformanceEn": "The learner justifies opposite pH changes on tenfold dilution and uses the supplied helper for 10−9 M HCl to obtain pH≈6.9978 rather than 9."
                }
              ],
              "variationAxes": [
                {
                  "id": "acid-base-stoichiometry",
                  "textDe": "Säure und Base sowie eine und zwei OH−-Einheiten je Formeleinheit unterscheiden.",
                  "textEn": "Distinguish acids and bases, and one versus two OH− units per formula unit."
                },
                {
                  "id": "calculation-to-record",
                  "textDe": "Aus einem berechneten Modellwert einen Protokollwert prüfen, ohne eine unbekannte Fehlerursache zu behaupten.",
                  "textEn": "Use a calculated model value to assess a recorded value without asserting an unknown error cause."
                },
                {
                  "id": "concentration-domain",
                  "textDe": "Von üblicher Konzentration zur zehnfachen Verdünnung und zum wasserbestimmten Grenzfall wechseln.",
                  "textEn": "Move from ordinary concentration to tenfold dilution and the limit dominated by water."
                }
              ],
              "applicationCaseBriefs": [
                {
                  "id": "g4-c1",
                  "taskDemandDe": "Berechne A=0.0100 M HCl und B=0.00200 M NaOH, prüfe Protokoll-pH 3.00/2.70 und begründe zehnfache Verdünnung. Vollständiges Material, Auftrag, Lösung und vier Kriterien: inputs/fourteen-full-cases.bound.exact.json, Fall G4-C1.",
                  "taskDemandEn": "Calculate A=0.0100 M HCl and B=0.00200 M NaOH, assess recorded pH 3.00/2.70 and justify tenfold dilution. Complete material, task, solution and four criteria: inputs/fourteen-full-cases.bound.exact.json, case G4-C1.",
                  "expectedPerformanceDe": "A hat pH≈2.00, B pOH≈2.699 und pH≈11.301; verdünnt pH≈3.00/10.301. Beide Aufzeichnungen weichen ab; eine konkrete Ursache ist nicht belegt.",
                  "expectedPerformanceEn": "A has pH≈2.00, B pOH≈2.699 and pH≈11.301; diluted pH values are ≈3.00/10.301. Both records disagree; no specific cause is established.",
                  "understandingFocusDe": "Ion, Logarithmus und Modellbefund verbinden und Ursachenhypothesen als solche behandeln.",
                  "understandingFocusEn": "Connect ion, logarithm and model finding, treating causal hypotheses as hypotheses."
                },
                {
                  "id": "g4-c2",
                  "taskDemandDe": "Berechne 0.00250 M HNO3 und 0.00100 M vollständig gelöstes Ca(OH)2; prüfe 10−9 M HCl mit der gegebenen Wasser-Hilfsgleichung. Vollständiges Material, Auftrag, Lösung und vier Kriterien: inputs/fourteen-full-cases.bound.exact.json, Fall G4-C2.",
                  "taskDemandEn": "Calculate 0.00250 M HNO3 and 0.00100 M fully dissolved Ca(OH)2; assess 10−9 M HCl using the supplied water helper. Complete material, task, solution and four criteria: inputs/fourteen-full-cases.bound.exact.json, case G4-C2.",
                  "expectedPerformanceDe": "HNO3: pH≈2.602. Ca(OH)2: [OH−]≈0.00200 M, pH≈11.301. Ultraverdünnte HCl: x≈1.0050·10−7 M, pH≈6.9978, geringfügig sauer.",
                  "expectedPerformanceEn": "HNO3: pH≈2.602. Ca(OH)2: [OH−]≈0.00200 M, pH≈11.301. Ultradilute HCl: x≈1.0050·10−7 M, pH≈6.9978, slightly acidic.",
                  "understandingFocusDe": "Formelstöchiometrie und Gültigkeitsgrenze entscheiden vor der Rechnung; die Hilfsgleichung ist Material, kein zusätzliches Herleitungsziel.",
                  "understandingFocusEn": "Formula stoichiometry and validity limit are decided before calculation; the helper is supplied material, not an additional derivation goal."
                }
              ],

            "before": null,
            "current": {
              "archetype": "modeling",
              "expectations": [
                {
                  "id": "content-specific-understanding",
                  "essentialUnderstandingDe": "In einfachen binären Schulbeispielen entstehen aus Nichtmetall/Nichtmetall diskrete Moleküle mit Elektronenpaarbindungen, aus Metall/Nichtmetall ein Ionengitter; Reaktionspartner und Teilchenmodell werden gemeinsam geprüft.",
                  "essentialUnderstandingEn": "In simple binary school examples, nonmetal/nonmetal gives discrete covalently bonded molecules and metal/nonmetal an ionic lattice; reactants and particle model are checked together.",
                  "observablePerformanceDe": "H2O ist im vorgegebenen Fall molekular, H/O teilen Bindungselektronen; NaCl ionogen, Na+/Cl− werden im Gitter ungerichtet angezogen. H2O zählt Atome pro Molekül, NaCl das Ionenverhältnis1:1.",
                  "observablePerformanceEn": "H2O is molecular in this case, H/O sharing bonding electrons; NaCl ionic, Na+/Cl− attracting throughout the lattice. H2O counts atoms per molecule; NaCl the1:1 ion ratio."
                },
                {
                  "id": "fresh-transfer-and-model-boundary",
                  "essentialUnderstandingDe": "Die elementbezogene Faustregel wird auf diese einfachen binären Beispiele begrenzt; sie ersetzt keine Prüfung von Netzwerkstoffen oder gemischten Bindungsformen.",
                  "essentialUnderstandingEn": "The element-based rule is bounded to these simple binary examples; it does not replace checking network solids or mixed bonding.",
                  "observablePerformanceDe": "C/O: Nichtmetall/Nichtmetall und gegebene diskrete Moleküle, daher molekular. Mg/O: Metall/Nichtmetall und gegebenes Ionengitter, daher ionogen. MgO beschreibt ausgeglichenes Ionenverhältnis. Der Text unterscheidet beide Teilchenanordnungen.",
                  "observablePerformanceEn": "C/O: nonmetal/nonmetal with supplied discrete molecules, thus molecular. Mg/O: metal/nonmetal with supplied ionic lattice, thus ionic. MgO expresses a balanced ion ratio. The text distinguishes the particle arrangements."
                }
              ],
              "coverageExpectations": {
                "requiredExpectationIds": [
                  "content-specific-understanding",
                  "fresh-transfer-and-model-boundary"
                ],
                "alternativeExpectationGroups": [],
                "minimumIndependentDemonstrations": 2,
                "freshVariationRequired": true,
                "independentTransferRequired": true
              },
              "variationAxes": [
                {
                  "id": "specific-material-variation",
                  "textDe": "Wasser und Natriumchlorid gegenüber Kohlenstoffdioxid und Magnesiumoxid; Formeltyp und Modell.",
                  "textEn": "Water and sodium chloride versus carbon dioxide and magnesium oxide; formula type and model."
                },
                {
                  "id": "specific-model-limit",
                  "textDe": "Die elementbezogene Faustregel wird auf diese einfachen binären Beispiele begrenzt; sie ersetzt keine Prüfung von Netzwerkstoffen oder gemischten Bindungsformen.",
                  "textEn": "The element-based rule is bounded to these simple binary examples; it does not replace checking network solids or mixed bonding."
                }
              ],
              "applicationCaseBriefs": [
                {
                  "id": "chem-next25-79db6d68-case-1",
                  "taskDemandDe": "Gegebene Reaktionen:2H2+O2→2H2O;2Na+Cl2→2NaCl. H/O/Cl sind Nichtmetalle, Na Metall. Modelle A zeigen getrennte H2O-Einheiten, B ein ausgedehntes Na+/Cl−-Gitter. Ordne Reaktion, Stoffklasse und Modell zu und erläutere den Unterschied zwischen Molekül- und Verhältnisformel.",
                  "taskDemandEn": "Given reactions:2H2+O2→2H2O;2Na+Cl2→2NaCl. H/O/Cl are nonmetals, Na a metal. Model A shows separate H2O units; B an extended Na+/Cl− lattice. Match reaction, compound class and model; explain molecular formula versus formula unit.",
                  "expectedPerformanceDe": "H2O ist im vorgegebenen Fall molekular, H/O teilen Bindungselektronen; NaCl ionogen, Na+/Cl− werden im Gitter ungerichtet angezogen. H2O zählt Atome pro Molekül, NaCl das Ionenverhältnis1:1.",
                  "expectedPerformanceEn": "H2O is molecular in this case, H/O sharing bonding electrons; NaCl ionic, Na+/Cl− attracting throughout the lattice. H2O counts atoms per molecule; NaCl the1:1 ion ratio.",
                  "understandingFocusDe": "Eine nebeneinander gezeichnete Na+/Cl−-Paarung ist keine Behauptung eines diskreten NaCl-Moleküls im Feststoff.",
                  "understandingFocusEn": "A drawn neighbouring Na+/Cl− pair does not imply a discrete NaCl molecule in the solid."
                },
                {
                  "id": "chem-next25-79db6d68-case-2",
                  "taskDemandDe": "Frische Fälle:C+O2→CO2;2Mg+O2→2MgO. CO2 liegt als einzelne O=C=O-Moleküle vor, MgO als Mg2+/O2−-Gitter. Ein Schülertext nennt jede Verbindung „Molekül“. Korrigiere die Zuordnung anhand der Elemente und Modelle; erkläre, weshalb die1:1-Formel MgO nicht die Existenz von Zweiermolekülen beweist.",
                  "taskDemandEn": "Fresh cases:C+O2→CO2;2Mg+O2→2MgO. CO2 has separate O=C=O molecules; MgO an Mg2+/O2− lattice. A draft calls every compound a molecule. Correct the classification using elements and models; explain why MgO’s1:1 formula does not establish two-atom molecules.",
                  "expectedPerformanceDe": "C/O: Nichtmetall/Nichtmetall und gegebene diskrete Moleküle, daher molekular. Mg/O: Metall/Nichtmetall und gegebenes Ionengitter, daher ionogen. MgO beschreibt ausgeglichenes Ionenverhältnis. Der Text unterscheidet beide Teilchenanordnungen.",
                  "expectedPerformanceEn": "C/O: nonmetal/nonmetal with supplied discrete molecules, thus molecular. Mg/O: metal/nonmetal with supplied ionic lattice, thus ionic. MgO expresses a balanced ion ratio. The text distinguishes the particle arrangements.",
                  "understandingFocusDe": "Die elementbezogene Faustregel wird auf diese einfachen binären Beispiele begrenzt; sie ersetzt keine Prüfung von Netzwerkstoffen oder gemischten Bindungsformen.",
                  "understandingFocusEn": "The element-based rule is bounded to these simple binary examples; it does not replace checking network solids or mixed bonding."
                }
              ]
            }
          }
        ],

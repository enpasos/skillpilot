        "PProfileDifferences": [
          {
            "field": "",
            "before": null,
            "current": {
              "archetype": "modeling",
              "expectations": [
                {
                  "id": "content-specific-understanding",
                  "essentialUnderstandingDe": "Salzbildung umfasst Atom-Ionenbildung und anschließende elektrostatische Gitterbildung; erst die Gesamtenergiebilanz begründet den exothermen Umsatz aus den Elementen.",
                  "essentialUnderstandingEn": "Salt formation involves atomic-ion formation followed by electrostatic lattice formation; only the total energy balance explains an exothermic process from the elements.",
                  "observablePerformanceDe": "Na→Na++e− ergibt2|8, Cl+e−→Cl−2|8|8. Summe108+122+496−349−787=−410 kJ/mol im Modell, daher exotherm. Die kostspielige Ionisierung allein erklärt keine Wärmefreisetzung; Gitterbildung setzt genügend Energie frei.",
                  "observablePerformanceEn": "Na→Na++e− gives2|8; Cl+e−→Cl− gives2|8|8. Sum108+122+496−349−787=−410 kJ/mol in the model, hence exothermic. Costly ionisation alone explains no heat release; lattice formation releases sufficient energy."
                },
                {
                  "id": "fresh-transfer-and-model-boundary",
                  "essentialUnderstandingDe": "Edelgaskonfiguration und große Gitterenergie garantieren für beliebige Elemente weder spontane Bildung noch eine bekannte Aktivierungsenergie.",
                  "essentialUnderstandingEn": "Noble-gas configuration and large lattice energy guarantee neither spontaneous formation from arbitrary elements nor a known activation energy.",
                  "observablePerformanceDe": "Mg gibt2 Elektronen ab, O nimmt2 auf; beide Ionen2|8, Verhältnis1:1 zu MgO. Bilanz3000−3600=−600. Elektronenentfernung kostet Energie; auch Elektronenaufnahme muss je Schritt geprüft werden. Exothermie folgt hier aus der gesamten Bilanz.",
                  "observablePerformanceEn": "Mg loses2 electrons and O gains2; both ions2|8,1:1 giving MgO. Balance3000−3600=−600. Electron removal costs energy; each electron-gain step must also be checked. Exothermicity follows here from the full balance."
                }
              ],
              "coverageExpectations": {
                "requiredExpectationIds": [
                  "content-specific-understanding",
                  "fresh-transfer-and-model-boundary"
                ],
                "alternativeExpectationGroups": [],
                "minimumIndependentDemonstrations": 2,
                "freshVariationRequired": true,
                "independentTransferRequired": true
              },
              "variationAxes": [
                {
                  "id": "specific-material-variation",
                  "textDe": "NaCl gegenüber MgO; Elektronen-/Ionenverhältnis und endotherme Vorstufen versus exotherme Gitterbildung.",
                  "textEn": "NaCl versus MgO; electron/ion ratios and endothermic preparation versus exothermic lattice formation."
                },
                {
                  "id": "specific-model-limit",
                  "textDe": "Edelgaskonfiguration und große Gitterenergie garantieren für beliebige Elemente weder spontane Bildung noch eine bekannte Aktivierungsenergie.",
                  "textEn": "Noble-gas configuration and large lattice energy guarantee neither spontaneous formation from arbitrary elements nor a known activation energy."
                }
              ],
              "applicationCaseBriefs": [
                {
                  "id": "chem-next25-c441d9e8-case-1",
                  "taskDemandDe": "Na:2|8|1; Cl:2|8|7. Gerundetes didaktisches Energiemodell pro mol NaCl:Atomisierung Na+108, halbe Cl2-Spaltung+122, Na-Ionisierung+496, Cl-Elektronenaufnahme−349, Gitterbildung−787 kJ/mol. Diese gelieferten Modellwerte sind kein neues Messergebnis. Erkläre Ionenbildung mit Elektronenübergang/Energiestufen und bilanziere Gesamtenergie. Begründe die Rolle des Gitters.",
                  "taskDemandEn": "Na:2|8|1; Cl:2|8|7. Rounded teaching energy model per mol NaCl:Na atomisation+108, half Cl2 dissociation+122, Na ionisation+496, Cl electron gain−349, lattice formation−787 kJ/mol. These supplied model values are not a new measurement. Explain ion formation using electron transfer/energy levels, balance total energy and explain the lattice’s role.",
                  "expectedPerformanceDe": "Na→Na++e− ergibt2|8, Cl+e−→Cl−2|8|8. Summe108+122+496−349−787=−410 kJ/mol im Modell, daher exotherm. Die kostspielige Ionisierung allein erklärt keine Wärmefreisetzung; Gitterbildung setzt genügend Energie frei.",
                  "expectedPerformanceEn": "Na→Na++e− gives2|8; Cl+e−→Cl− gives2|8|8. Sum108+122+496−349−787=−410 kJ/mol in the model, hence exothermic. Costly ionisation alone explains no heat release; lattice formation releases sufficient energy.",
                  "understandingFocusDe": "Der Energieschritt zu gasförmigen Ionen ist ein Modellweg, keine tatsächliche Reihenfolge isolierter Labor-Zwischenprodukte.",
                  "understandingFocusEn": "The energy path through gaseous ions is a model cycle, not an actual sequence of isolated laboratory intermediates."
                },
                {
                  "id": "chem-next25-c441d9e8-case-2",
                  "taskDemandDe": "Frischer Hauptgruppenfall:Mg2|8|2 und O2|6. Gegebenes Modell:alle Schritte bis zu getrennten Mg2+(g)/O2−(g) benötigen insgesamt+3000 kJ/mol; Gitterbildung setzt−3600 kJ/mol frei. Es handelt sich ausdrücklich um illustrative Bilanzwerte, nicht tabellierte MgO-Messdaten. Leite Ionen-/Elektronenverhältnis ab und erkläre, ob das vorgegebene Modell insgesamt exotherm ist. Korrigiere „jede Ionenbildung gibt Energie ab“.",
                  "taskDemandEn": "Fresh main-group case:Mg2|8|2 and O2|6. Supplied model:all steps to separated Mg2+(g)/O2−(g) require+3000 kJ/mol; lattice formation releases−3600. These are explicitly illustrative balance values, not tabulated MgO measurements. Derive ion/electron ratios and explain whether the supplied model is exothermic overall. Correct “every ion formation releases energy”.",
                  "expectedPerformanceDe": "Mg gibt2 Elektronen ab, O nimmt2 auf; beide Ionen2|8, Verhältnis1:1 zu MgO. Bilanz3000−3600=−600. Elektronenentfernung kostet Energie; auch Elektronenaufnahme muss je Schritt geprüft werden. Exothermie folgt hier aus der gesamten Bilanz.",
                  "expectedPerformanceEn": "Mg loses2 electrons and O gains2; both ions2|8,1:1 giving MgO. Balance3000−3600=−600. Electron removal costs energy; each electron-gain step must also be checked. Exothermicity follows here from the full balance.",
                  "understandingFocusDe": "Edelgaskonfiguration und große Gitterenergie garantieren für beliebige Elemente weder spontane Bildung noch eine bekannte Aktivierungsenergie.",
                  "understandingFocusEn": "Noble-gas configuration and large lattice energy guarantee neither spontaneous formation from arbitrary elements nor a known activation energy."
                }
              ]
            }
          }
        ],

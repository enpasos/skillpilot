              "archetype": "representation",
              "expectations": [
                {
                  "id": "b006-7964cb36-core",
                  "essentialUnderstandingDe": "Eine Molekülformel zählt Atome eines abgegrenzten Moleküls mit gerichteten kovalenten Bindungen. Eine Salz-Verhältnisformel nennt das kleinste Ionenverhältnis eines ausgedehnten Gitters mit elektrostatischer Anziehung in viele Richtungen; sie behauptet keine einzelnen Salz-Moleküle.",
                  "essentialUnderstandingEn": "A molecular formula counts atoms of a discrete molecule with directional covalent bonds. An ionic ratio formula gives the smallest ion ratio in an extended lattice with electrostatic attraction in many directions; it does not posit individual salt molecules.",
                  "observablePerformanceDe": "Die lernende Person verbindet Teilchendarstellungen mit Molekül- bzw. Verhältnisformeln und erklärt, weshalb Ladungsausgleich keinen isolierten Ionenverband beweist.",
                  "observablePerformanceEn": "The learner links particle depictions to molecular versus ionic-ratio formulas and explains why charge balance does not prove a discrete ionic molecule."
                }
              ],
              "coverageExpectations": {
                "requiredExpectationIds": [
                  "b006-7964cb36-core"
                ],
                "alternativeExpectationGroups": [],
                "minimumIndependentDemonstrations": 2,
                "freshVariationRequired": true,
                "independentTransferRequired": true
              },
              "variationAxes": [
                {
                  "id": "particle-structure",
                  "textDe": "Abgegrenztes Molekül und fortgesetztes Ionengitter werden verglichen.",
                  "textEn": "Discrete molecule and extended ionic lattice are compared."
                },
                {
                  "id": "ratio",
                  "textDe": "1:1 und 1:2-Gitterverhältnisse wechseln, ohne daraus Moleküle zu machen.",
                  "textEn": "1:1 and 1:2 lattice ratios vary without becoming molecules."
                }
              ],
              "applicationCaseBriefs": [
                {
                  "id": "water-sodium-chloride",
                  "taskDemandDe": "Ein Teilchenbild zeigt einzelne H–O–H-Einheiten; ein anderes abwechselnde Na+ und Cl− in einem fortgesetzten Gitter. Ordne H2O und NaCl als Formelarten ein und begründe.",
                  "taskDemandEn": "One particle sketch shows separate H–O–H units; another shows alternating Na+ and Cl− in a repeating lattice. Classify H2O and NaCl formula types and explain.",
                  "expectedPerformanceDe": "H2O zählt Atome je abgegrenztem Molekül; NaCl ist das kleinste 1:1-Verhältnis im Gitter, kein NaCl-Molekül. Gerichtete kovalente Bindung versus elektrostatisches Netz wird benannt.",
                  "expectedPerformanceEn": "H2O counts atoms in a discrete molecule; NaCl is the smallest 1:1 lattice ratio, not a NaCl molecule. Directional covalent bonds versus extended electrostatic network are named.",
                  "understandingFocusDe": "Zwei Teilchenbilder tragen die Darstellungsentscheidung.",
                  "understandingFocusEn": "Two particle sketches support the representation choice."
                },
                {
                  "id": "carbon-dioxide-calcium-fluoride",
                  "taskDemandDe": "Neue Teilchenangaben: CO2 liegt als einzelne O=C=O-Einheiten vor; CaF2 bildet ein Gitter aus Ca2+ und F−. Erkläre trotz beider „1:2“-Schreibweisen den Unterschied der Formeln.",
                  "taskDemandEn": "Fresh particle information: CO2 occurs as separate O=C=O units; CaF2 forms a lattice of Ca2+ and F−. Despite both having “1:2” notation, explain the formula difference.",
                  "expectedPerformanceDe": "CO2 ist die Atomzahl je Molekül; CaF2 ist das kleinste ladungsneutrale Ionenverhältnis im Gitter. Gleiches Zahlenschema belegt nicht gleiche Teilchenstruktur.",
                  "expectedPerformanceEn": "CO2 counts atoms per molecule; CaF2 is the lowest charge-neutral ion ratio in the lattice. The same numeric pattern does not prove the same particle structure.",
                  "understandingFocusDe": "Gleiche Ziffern bei anderer Struktur verhindern Formelerkennungs-Trick.",
                  "understandingFocusEn": "Same digits with a different structure prevent formula-pattern guessing."
                }
              ]
            }
          }
        ],

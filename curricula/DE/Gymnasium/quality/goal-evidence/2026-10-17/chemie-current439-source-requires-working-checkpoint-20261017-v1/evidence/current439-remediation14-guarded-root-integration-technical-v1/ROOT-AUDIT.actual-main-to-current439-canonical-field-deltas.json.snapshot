      "resourceLinks": [
        {
          "type": "goal-visualization",
          "resourceType": "image",
          "role": "primary",
          "skillpilotId": "8b2d351e-e44f-5385-9b89-13ef54b5918f",
          "title": "Visualisierung: Temperaturabhängige Löslichkeit und Kristallbildung untersuchen",
          "url": "/assets/goal-visualizations/chemie/8b2d351e-e44f-5385-9b89-13ef54b5918f/8b2d351e-e44f-5385-9b89-13ef54b5918f.png",
          "provider": "OpenAI / Codex built-in image_gen (model not exposed)",
          "description": "Schematischer Beispielstoff: Beim Abkühlen derselben Lösung entstehen Kristalle, weil bei dieser niedrigeren Temperatur weniger Feststoff löslich ist. Die Beispielkurve zeigt diese Stoffabhängigkeit ohne Messdaten zu behaupten.",
          "altText": "Comicartige Gegenüberstellung derselben abgedeckten Lösung: warm klar, nach Abkühlen mit Kristallen am Boden und weiterhin klarer Lösung darüber. Es geht kein Wasser verloren. Ein schematisches Löslichkeitsdiagramm zeigt für diesen Beispielstoff eine mit der Temperatur steigende Löslichkeit und den Abkühlungsweg von rechts oben nach links unten. Keine allgemeine Regel für alle Feststoffe und keine tatsächlichen Messdaten.",
          "lang": "de",
          "license": "CC-BY-4.0",
          "reviewStatus": "pilot"
        }
      ],

        ]
      },
      "type": "atomic",
      "nodeKind": "exam",
      "phase": "Q2",
      "weight": 1,
      "core": false,
      "contains": [],
      "requires": [
        "978a6f25-0601-5457-9211-aab206c95603"
      ],
      "examples": [],
      "resourceLinks": [],
      "tags": [
        "canonical",
        "SekI",
        "SekII",
        "GK",
        "LK",
        "Practice",
        "Assessment",
        "ExamTask",
        "phase:Q2"
      ],
      "dimensionTags": {
        "framework": "canonical-gymnasium-chemistry",
        "demandLevel": "AB3",
        "phase": "Q2",
        "area": "Experimentelle Chemie",
        "processCompetencies": [
          "PK1_EXPERIMENTIEREN",
          "PK2_MODELLIEREN",
          "PK3_MATHEMATISIEREN"
        ],
        "guidingIdeas": [
          "BC_AUFBAU"
        ],
        "topicCode": "CANONICAL.CHEMISTRY.PRACTICAL.PLANAR_CHROMATOGRAPHY"
      },
      "sourceRef": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-current435-course-terminal-route-and-practical-author-remediation-20261016-v1/author-course-and-chromatography/GOAL.4cbcfc86-ae8c-5152-87cf-9dabd1a5f954.after.author-draft.json",
      "extendedData": {
        "applicabilityFromRequires": true,
        "applicabilityMappingInheritance": "boundary",
        "authorCandidateProvenance": {
          "role": "New author candidate, not a reviewed or performed laboratory activity",
          "evidenceLevel": "E0",
          "gate": "G0",
          "independentReviewsRequired": 2,
          "HumanApproval": false,
          "HumanTrial": false
        }
      },
      "examData": {
        "reviewStatus": "released",
        "reviewNote": "Maschineller Inhaltsreview: zwei voneinander unabhängige aktuelle fachliche KEEP-Urteile für die vollständigen Aufgaben, Lösungen, Rubriken und ausdrücklich ausgewiesene Coverage. Vorbereitende Kurszulassung ist keine erneute Vollprüfung aller Kursziele. Eigene Praxisverfahren sind unerprobte E0/G0-Entwürfe und erfordern vor örtlichem Einsatz die tatsächliche schulische Sicherheits- und Funktionsprüfung. Keine Human Approval oder Human Trial. Bei den zwei generischen HE-Klausuren sind ausschließlich deutsche Aufgaben/Lösungen und bilinguale Metadaten geprüft.",
        "coveredGoalIds": [
          "978a6f25-0601-5457-9211-aab206c95603"
        ],
        "coveredStrands": [
          "BC_AUFBAU"
        ],
        "demandLevels": [
          "AB1",
          "AB2",
          "AB3"
        ],
        "taskContent": "**Praktischer Abschluss: Referenzfarben und ein unbekanntes Farbgemisch**\n\nDiese Aufgabe verlangt eine tatsächlich beaufsichtigte eigene Durchführung im ausgestatteten Unterrichtslabor. Eine beschriebene Durchführung, fremde Aufnahme oder vorgerechnete Zahlen ersetzen keine eigenen überprüfbaren Handlungen. Bei fehlendem sicheren Laborzugang bleibt der praktische Abschluss offen. Es liegen hier keine beobachteten Lernendenleistungen oder Messdaten vor. Alle 10 BE sind zum Bestehen erforderlich; keine der beiden Praxiszeilen darf durch Theorie ersetzt werden.\n\n**Vollständiges Material und Vorbereitung:** Die Lehrkraft stellt wässrige, einzeln deklarierte Lebensmittelfarbstoff-Referenzen Y (Tartrazin/E102) und B (Brillantblau FCF/E133), jeweils 0,10 g/L, sowie eine als U codierte wässrige Mischung beider Referenzlösungen bereit. Das Mischungsverhältnis von U wird erst nach der Auswertung offengelegt; es wird keine unbekannte Haushalts- oder Umweltprobe verwendet. Dazu: geschnittenes Chromatografiepapier aus derselben Cellulosecharge, ein Stück glatte Aluminiumfolie nur als begründete ungeeignete Alternative, zwei abgedeckte Laufgefäße, Tropf-/Mikropipetten für kleine Startflecken, Bleistift, Millimeterlineal, Halterung und Schutzbrille. Laufmittel W ist Wasser; S ist von der Lehrkraft hergestellte wässrige NaCl-Lösung, 5,0 g/L. Es werden keine organischen Lösungsmittel, Sprühreagenzien oder Heizgeräte eingesetzt. Mengen je Gefäß höchstens 20 mL. Die Schule prüft Sicherheitsdatenblätter, Glasbruch und örtliche Entsorgung; nicht kosten, trinken oder zur Hautanwendung nutzen. Nach Kontakt mit den verdünnten Lösungen mit Wasser abspülen und die Aufsicht informieren; für Augen die schulische Augenspül-/Erste-Hilfe-Regel anwenden. Lösungen und Papier werden nach der örtlichen Anweisung gesammelt.\n\nVor Einsatz prüft die Lehrkraft mit genau dieser Papier-/Farbstoffcharge, ob mindestens eines der beiden bereitgestellten Laufmittel zwei getrennte Referenzzonen liefert. Das ist eine künftige lokale Erprobungspflicht, keine Behauptung einer schon erfolgten Erprobung. Falls beide Systeme unbrauchbar sind, wird nicht mit erfundenen Zonen weitergearbeitet: Der Abschluss bleibt offen, bis die Ausstattung fachgerecht angepasst und erneut lokal erprobt wurde.\n\n**Durchführung und Aufgaben:**\n\n1. Begründen Sie die Wahl des porösen Cellulosepapiers gegenüber glatter Folie, benennen Sie stationäre und mobile Phase und erklären Sie unterschiedliche Stoffwechselwirkungen. Planen Sie zwei kleine Vorläufe, einen mit W und einen mit S, mit jeweils Y und B nebeneinander unter sonst gleichen Bedingungen. Notieren Sie vor Beginn Gefäß, Papiercharge, Laufmittel, Proben und Sicherheits-/Entsorgungsregel. Lassen Sie den Plan vor der Durchführung prüfen.\n2. Führen Sie beide Vorläufe selbst durch: Bleistift-Startlinie 15 mm über dem unteren Rand, trockene kleine Flecken von höchstens etwa 3 mm Durchmesser, Anfangsfüllhöhe etwa 5 mm unterhalb der Startlinie; das Papier hängt frei ohne Wandkontakt. Verschließen Sie die Kammer, lassen Sie die Front mindestens 50 mm von der Startlinie laufen und markieren Sie sie unmittelbar nach dem Entnehmen mit Bleistift. Dokumentieren Sie wirkliche Beobachtungen, auch Fehlversuche. Wählen Sie das Laufmittel, das kompakte, getrennte Referenzzonen zwischen Start und Front ergibt; eine allgemeingültige Rangfolge W/S wird nicht vorausgesetzt. Begründen Sie die Wahl mit Ihren Vorläufen.\n3. Führen Sie mit dem gewählten System zwei eigene Hauptläufe mit Y, B und U nebeneinander auf jeweils demselben Papier durch. Halten Sie Papiercharge, Laufmittelansatz, Startauftragung, Kammer und ungefähre Temperatur konstant. Protokollieren Sie Datum, eigenen Aufbau, Laufzeit, Laufmittel, Fronten sowie Farb-/Zonenbild und unmittelbar gemessene Abstände; Aufsicht und Lernende halten fest, welche Handlungen tatsächlich beobachtet wurden. Fotos des beschrifteten Originalchromatogramms mit Maßstab dürfen die eigenen Rohaufzeichnungen ergänzen. Vorgegebene Sollabstände gibt es nicht.\n4. Messen Sie je Hauptlauf von der eigenen Startlinie bis zur lokalen Front und zu jeder Zonenmitte in derselben Bahn. Geben Sie Messunsicherheit und Fleckbreite an. Berechnen Sie Rf = Weg der Zonenmitte / Weg der Front ohne Einheit. Vergleichen Sie U nur mit gleichzeitig unter denselben Bedingungen gelaufenen Referenzen, zusätzlich zwischen Ihren zwei Wiederholungen. Bei verschmierter Zone oder schräger Front benennen Sie die Grenze; misslungene Trennung wird nicht als erfolgreiche Identifizierung bewertet.\n5. Ordnen Sie passende U-Zonen vorläufig Y/B zu und begründen Sie, warum gleiche Farbe und gleicher Rf keine eindeutige Identität beweisen und eine einzelne Zone keine Reinheit beweist. Frischer Fehlerfall: Eine fremde Gruppe nennt Rf=0,62 auf anderem Papier mit anderem Laufmittel. Erklären Sie, warum dieser Wert Ihre methodengleichen Referenzen nicht ersetzen kann. Geben Sie eine passende zusätzliche unabhängige Trenn- oder Nachweismöglichkeit an. Trennen Sie tatsächliche eigene Befunde von Erwartungen; behaupten Sie weder quantitative Gehalte noch Lebensmittelzulässigkeit.",
        "taskContentEn": "**Practical capstone: reference dyes and a coded dye mixture**\n\nActually perform this activity yourself in a supervised equipped teaching laboratory. A description, another person's photograph or supplied numbers cannot replace verifiable own actions and original records. Without safe laboratory access the practical capstone remains open. This author file contains no observed learner performance or experimental results. Passing requires all 10 points, including both execution criteria.\n\n**Complete materials and preparation:** The teacher supplies aqueous single-dye references Y (tartrazine/E102) and B (Brilliant Blue FCF/E133), each 0.10 g/L, plus coded U prepared by mixing these two reference solutions. Its ratio is disclosed only after evaluation. No unknown household/environmental samples are used. Provide same-batch cellulose chromatography paper; smooth aluminium foil only as an unsuitable comparison; two covered chambers; dropping/micropipettes; pencil; millimetre ruler; support and goggles. Solvents: W=water; S=teacher-prepared aqueous NaCl,5.0 g/L. No organic solvent, spray reagent or heating. Use at most20 mL per chamber. The school checks actual safety data sheets, broken-glass precautions and disposal. Do not taste, drink or apply the materials to skin. Rinse accidental solution contact with water and tell the supervisor; use school eyewash/first-aid procedures for eye contact. Collect solutions/paper as locally directed.\n\nBefore student use the teacher must trial this exact paper/dye batch and establish that at least one supplied system separates the references. This is a future local requirement, not a claimed completed trial. If neither works, keep the capstone open until equipment is appropriately adjusted and retrialled; never invent separated zones.\n\n1. Justify porous cellulose rather than smooth foil; name stationary/mobile phases and explain differing interactions. Plan matched Y/B pilot runs in W and S, recording chamber, paper batch, solvent, samples and safety/disposal before supervisor approval.\n2. Actually perform both pilots. Draw a pencil origin15 mm above the lower edge; apply dry small spots no larger than about3 mm; keep initial liquid about5 mm below the origin. Suspend paper without wall contact, cover the chamber, develop at least50 mm from the origin and mark the front immediately on removal. Record actual results and failed attempts. Select the system giving compact separated reference zones between origin and front from your own results; no universal W/S ordering is assumed.\n3. Actually perform two main runs with Y,B,U side by side on each sheet using the selected system. Keep paper batch, solvent preparation, spotting, chamber and approximate temperature constant. Record date, own setup, run time, solvent, original fronts/zone colours and immediate distances. Learner and supervisor record which actions were actually observed; labelled original chromatogram photos with a ruler may supplement raw records. No target distances are supplied.\n4. For each main run measure from your origin to the local front and each zone centre in the same lane, noting uncertainty and spot width. Calculate dimensionless Rf=zone-centre distance/front distance. Compare U only to simultaneously developed same-condition references, and compare both repetitions. State limitations from smearing or a sloping front; failed separation is not successful identification.\n5. Provisionally assign matching U zones to Y/B. Explain why matching colour/Rf does not uniquely identify a substance and one zone does not prove purity. Fresh error: another group reports Rf0.62 with different paper/solvent. Explain why it cannot replace your matched references, and propose an additional independent separation or analysis. Distinguish real findings from expectations; claim neither concentrations nor food safety.",
        "solutionContent": "**Erwartungshorizont und Durchführungssperre**\n\nEs gibt keine erwarteten universellen Rf-Zahlen. Nur echte eigene, beaufsichtigt überprüfbare Handlungen und unmittelbar geführte Rohaufzeichnungen belegen die Ausführung. Fehlen sie, ist die Aufgabe auch bei perfekter schriftlicher Erklärung nicht bestanden. Kein Lernen/Experiment wird durch dieses Autorenpaket als beobachtet ausgegeben.\n\nCellulosepapier stellt eine poröse stationäre Umgebung bereit, durch die die mobile wässrige Phase kapillar steigt; glatte Folie liefert unter diesem Aufbau keine passende poröse Laufstrecke. Verteilung und Wechselwirkungen mit stationärer Umgebung und mobilem Laufmittel führen zu unterschiedlichen Wanderungen. W und S sind tatsächlich zu vergleichen: Salz kann das Trennverhalten verändern; welches System für die Charge günstiger ist, entscheidet der eigene dokumentierte Vorlauf und nicht eine auswendig gelernte Polaritätsregel.\n\nDie Aufsicht muss sichere, richtige eigene Aufbau-/Auftragungs-/Entwicklungs- und Protokollschritte einschließlich Entsorgung verifizieren können. Der Flüssigkeitsspiegel bleibt unter den trockenen Startflecken. Bleistift statt löslichem Farbstift, kleine Flecken, freie Papieraufhängung und rechtzeitige Frontmarkierung verhindern wichtige Fehler. Eine U-Zone wird mit Y/B desselben Laufs anhand Farbe, Lage/Rf und Unsicherheit verglichen; der zweite methodengleiche Lauf zeigt die Wiederholbarkeit und mögliche Streuung. Für jeden Fleck wird der Weg seiner Mitte von der Startlinie durch die lokale Frontstrecke dividiert. Nicht getrennte oder verschmierte Zonen liefern keine sicher auflösbaren Komponenten. Fachlich ehrliche Fehlersuche und Wiederholung sind zulässig; ein unbrauchbares Chromatogramm wird nicht als erfolgreiches Ergebnis erfunden.\n\nÜbereinstimmende Zonen sind eine vorläufige, auf dieses System beschränkte Zuordnung. Verschiedene Stoffe können gemeinsam laufen, eine einzelne Zone kann mehrere Stoffe enthalten. Andere stationäre/mobile Phasen verändern Rf; der fremde Wert ersetzt keine passenden Referenzen. Ein zweites unabhängiges chromatografisches System mit denselben Referenzen oder geeignete zusätzliche instrumentelle Analyse kann die Aussage verbessern. Keine Konzentration, definitive Identität oder lebensmittelrechtliche Bewertung wird aus dieser einfachen Trennung abgeleitet.\n\n**Fünf Pflichtkriterien, je 2 BE, bestanden ausschließlich mit 10/10 BE:**\n\ns1: Eigener fachlich begründeter Phasen-/Laufmittelplan mit kontrolliertem tatsächlichem W/S-Vergleich und geeigneter Auswahl (2).\ns2: Tatsächlich verifizierte sichere eigene Vorbereitung, Auftragung, Entwicklung und Entsorgung; keine Beschreibungsersatzleistung (2).\ns3: Zwei tatsächlich verifizierte eigene methodengleiche Y/B/U-Hauptläufe mit ursprünglichen Start-, Front-, Zonen- und Bedingungsaufzeichnungen (2).\ns4: Korrekte eigene Wegmessungen, dimensionslose Rf-Werte, methodengleicher Referenz-/Wiederholungsvergleich einschließlich Unsicherheit (2).\ns5: Vorläufige Zuordnung, Koelutions-/Reinheitsgrenze und fachlich begründete Antwort auf den frischen Fremdsystemfehler (2).",
        "solutionContentEn": "**Expected reasoning and execution gate:** No universal Rf values are expected. Passing requires actual supervised verifiable own actions and immediate original records; theoretical answers cannot replace execution. This author package claims no performed experiment.\n\nPorous cellulose supports capillary mobile-phase movement; smooth foil is unsuitable for this arrangement. Distribution/interactions with stationary surroundings and mobile solvent produce differential migration. W/S selection follows the actual controlled pilots; salt can alter separation, and no universal ranking is assumed. Verify safe own setup, small dry pencil-line spots above liquid, free suspension, immediate front marking and disposal. Record two own matched Y/B/U runs. Divide each zone-centre distance from the origin by its corresponding local front distance. Compare colour/Rf with same-run references within uncertainty and check repeatability. Smearing or unresolved spots prevent reliable component assignment; investigate and repeat without inventing results.\n\nMatching zones support provisional assignment only. Co-migration can conceal different compounds, and a single zone does not prove purity. Rf depends on stationary/mobile phases, so the foreign0.62 is not a substitute. A second independent chromatographic system with the same references or suitable additional instrumental analysis can improve the conclusion. No concentration, definitive identity or food-law judgment follows.\n\n**Five mandatory criteria,2 points each;10/10 required:** s1 own justified phase/solvent plan and actual controlled W/S pilots/selection; s2 verifiable safe own preparation, spotting, development and disposal; s3 two verifiable own matched Y/B/U runs with original origin/front/zone/condition records; s4 correct own distances, dimensionless Rf, matched-reference/repetition and uncertainty evaluation; s5 bounded assignment, co-migration/purity limitations and correct fresh foreign-system analysis. Description alone earns no execution credit in s2/s3.",
        "scoring": {
          "maxPoints": 10,
          "passingPoints": 10,
          "steps": [
            {
              "id": "planar_phases",
              "points": 2,
              "description": "Eigener begründeter Phasenplan und tatsächliche kontrollierte W/S-Vorläufe samt belegter Laufmittelwahl."
            },
            {
              "id": "planar_execution",
              "points": 2,
              "description": "Tatsächlich überprüfbare sichere eigene Vorbereitung, Auftragung, Entwicklung und Entsorgung; Beschreiben genügt nicht."
            },
            {
              "id": "planar_raw",
              "points": 2,
              "description": "Zwei tatsächlich überprüfbare eigene methodengleiche Y/B/U-Läufe mit ursprünglichen Start-/Front-/Zonen-/Bedingungsdaten."
            },
            {
              "id": "planar_rf",
              "points": 2,
              "description": "Korrekte eigene Wegmessungen und dimensionslose Rf-Werte; methodengleicher Referenz-/Wiederholungsvergleich mit Unsicherheit."
            },
            {
              "id": "planar_limits",
              "points": 2,
              "description": "Vorläufige Zuordnung und Koelutions-/Reinheitsgrenze; frischen Fremdsystemfehler begründet lösen."
            }
          ]
        },
        "sourceArtifactPath": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-current435-course-terminal-route-and-practical-author-remediation-20261016-v1/author-course-and-chromatography/GOAL.4cbcfc86-ae8c-5152-87cf-9dabd1a5f954.after.author-draft.json"
      }
    },

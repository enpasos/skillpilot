    {
      "id": "ee494d08-9514-54f2-ac5e-eebc20ca8725",
      "shortKey": "canonical_chemistry_source_duty_metal_recycling_significance_personal_consumption_disposal_local_assessment",
      "type": "atomic",
      "weight": 1,
      "contains": [],
      "requires": [
        "b7ae47da-6afa-5651-977a-3139af7d6eab"
      ],
      "title": "Übung: Metallrecycling für Konsum- und Entsorgungsentscheidungen nutzen",
      "titleEn": "Practice: Use metal recycling knowledge for consumption and disposal decisions",
      "description": "Die lernende Person kann einen materialgestützten Papierfall zu „Metallrecycling für Konsum- und Entsorgungsentscheidungen nutzen“ selbstständig bearbeiten und ihre fachliche Einschätzung anhand der angegebenen Bedingungen begründen.",
      "descriptionEn": "The learner can independently solve a material-based paper case on “Use metal recycling knowledge for consumption and disposal decisions” and justify a scientific judgment using the supplied conditions.",
      "tags": [
        "SekI",
        "Practice",
        "Assessment"
      ],
      "dimensionTags": {
        "framework": "canonical-gymnasium-chemistry",
        "demandLevel": "AB3",
        "processCompetencies": [
          "PK5_BEWERTEN",
          "PK4_KOMMUNIZIEREN"
        ],
        "guidingIdeas": [
          "BC_AUFBAU",
          "BC_ENERGIE"
        ],
        "phase": "GLOBAL",
        "area": "Metalle und Metallgewinnung",
        "topicCode": "CANONICAL.CHEMISTRY.SOURCE_DUTY.METAL_RECYCLING_SIGNIFICANCE_PERSONAL_CONSUMPTION_DISPOSAL"
      },
      "applicability": {
        "jurisdiction": [
          "DE-NW"
        ]
      },
      "examples": [],
      "resourceLinks": [],
      "extendedData": {
        "applicabilityMappingInheritance": "boundary",
        "applicabilityFromRequires": true,
        "assessmentCaseBinding": {
          "sourceArtifactPath": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-13/chemie-three-recycling-current403-graph-source-integration-author-20261013-v4/inputs/six-accepted-whole-cases.current-v2.DEEN.json",
          "defaultCaseId": "b7ae47da-case-1",
          "boundAlternativeCaseIds": [
            "b7ae47da-case-2"
          ],
          "allEssentialExpectationIds": [
            "e1",
            "e2",
            "e3"
          ],
          "wholeCaseDataAndRubricsUnchanged": true
        },
        "assessmentGate": "needs_review; no runtime mastery, experiment, P approval or image claim"
      },
      "examData": {
        "reviewStatus": "needs_review",
        "reviewNote": "Inactive graph/source author candidate. Three essential rubric parts need full credit; the 6/6 threshold expresses their conjunction. Independent assessment and integration review remain pending.",
        "coveredGoalIds": [
          "b7ae47da-6afa-5651-977a-3139af7d6eab"
        ],
        "coveredStrands": [
          "BC_AUFBAU",
          "BC_ENERGIE"
        ],
        "demandLevels": [
          "AB3"
        ],
        "sourceArtifactPath": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-13/chemie-three-recycling-current403-graph-source-integration-author-20261013-v4/inputs/six-accepted-whole-cases.current-v2.DEEN.json",
        "taskContent": "Sek-I-Papiermodell für 1 kg gleich nutzbares Metall X. Derselbe Vergleichsrahmen enthält Bereitstellung bis zum nutzbaren Metall, einschließlich Sammlung und Transport. Primärweg: 1 kg neu gewonnener Metallrohstoff, Energieindex 100. Recyclingweg: 0,8 kg zurückgewonnenes X plus 0,2 kg neu gewonnener Metallrohstoff, gesamter Energieindex 35. Die restliche frühere Metallmenge ist in diesem Modell nicht nutzbar zurückgewonnen. Ein noch brauchbarer Metallgegenstand könnte weitergenutzt werden. Wähle für eine frei erfundene Alltagssituation: C behält ihn bis zum Nutzungsende und gibt das Altmetall dann in eine bereitgestellte kontrollierte Erfassung; D ersetzt ihn ohne Bedarf und gibt das Altmetall in einen gemischten Reststrom, aus dem X laut Material nicht zurückgewonnen wird. Eine Schülerin behauptet: „Recycling spart Rohstoffe und Energie, also kostet jede zusätzliche Metallanschaffung keine Rohstoffe und keine Energie.“ Alle Zahlen sind Modellangaben, keine realen Produktwerte.\n\n1. Beschreibe die Bedeutung des Recyclingwegs für Ressourcenschonung und Energieeinsparung gegenüber dem Primärweg. Vergleiche qualitativ; eine Rechnung oder Anlagenbeschreibung ist nicht nötig. 2. Wähle eine eigene, aber frei erfundene Konsum-/Entsorgungsentscheidung C oder D und begründe beide Teile mit den Daten. 3. Übertrage deine Begründung auf die zusätzliche Anschaffung: Widerlege oder begrenze die Behauptung. Keine Angaben zu deinem wirklichen Haushalt sind verlangt.",
        "taskContentEn": "Lower-secondary paper model for 1 kg equally usable metal X. The same boundary covers supply up to usable metal, including collection and transport. Primary route: 1 kg newly extracted metal raw material, energy index 100. Recycling route: 0.8 kg recovered X plus 0.2 kg newly extracted metal raw material, total energy index 35. The remaining earlier metal amount is not usefully recovered in this model. A still-usable metal object could continue in use. For a freely invented everyday situation, choose: C retains it until end of use and then returns old metal to the supplied controlled collection route; D replaces it unnecessarily and sends old metal to a mixed residue stream from which, according to the material, X is not recovered. A student says: “Recycling saves resources and energy, so every extra metal purchase uses no resources or energy.” All numbers are model data, not actual product values.\n\n1. Describe the recycling route's significance for resource conservation and energy saving compared with the primary route. A qualitative comparison suffices; no calculation or plant description is needed. 2. Choose C or D for a personal but freely invented consumption/disposal situation and justify both parts from the data. 3. Transfer your reasoning to an additional purchase: refute or limit the claim. No information about your actual household is requested.",
        "solutionContent": "Rückgewonnenes X ersetzt im Modell einen Teil neuen Rohstoffs: statt 1 kg werden 0,2 kg neu benötigt. Auf derselben nutzbaren Mengenbasis ist 35 kleiner als 100; erneute Metallbereitstellung spart hier Energie, benötigt aber weiterhin Energie. Nicht vollständig nutzbare Rückgewinnung und Ergänzung bleiben. C vermeidet eine unnötige neue Metallnachfrage während der Nutzungszeit und hält am Ende den Stoff für Rückgewinnung verfügbar. D schafft zusätzliche Nachfrage und verliert laut Material die spätere Rückgewinnungsmöglichkeit. Für die frei gewählte Situation ist C mit beiden Bezügen begründet. Ein zusätzliches Produkt benötigt trotz Recycling mindestens die angegebenen Ergänzungsrohstoffe und Energie für Bereitstellung; Recycling macht überflüssige Käufe nicht ressourcen- oder energieneutral. Diese Schlussfolgerung erklärt die Bedeutung des gegebenen Metallrecyclings, nicht jede reale Anlage oder jedes Produkt.",
        "solutionContentEn": "Recovered X replaces part of the new raw material in this model: only 0.2 kg rather than 1 kg is newly required. On the same usable-quantity basis, 35 is lower than 100; supplying metal again saves energy here but still uses energy. Incomplete useful recovery and new-material additions remain. C avoids unnecessary new metal demand during use and keeps the material available for recovery at end of use. D creates extra demand and loses the later recovery opportunity according to the material. C is justified through both links for the freely chosen situation. An extra product still requires the stated new-material additions and supply energy; recycling does not make unnecessary purchases resource- or energy-neutral. This explains the significance of the supplied metal-recycling case, not every actual plant or product.",
        "scoring": {
          "maxPoints": 6,
          "passingPoints": 6,
          "steps": [
            {
              "id": "e1",
              "points": 2,
              "description": "2 Punkte: Erklärt Ersatz neuen Metallrohstoffs durch 0,8 kg Rückgewinnung sowie verbleibende 0,2 kg Ergänzung. 1 Punkt: Nennt Ressourcenschonung, lässt Ergänzung oder Begründung ungenannt. 0 Punkte: Behauptet vollständige Rohstoffneutralität oder dass zurückgewonnenes Metall neuen Erzrohstoff vermehrt."
            },
            {
              "id": "e2",
              "points": 2,
              "description": "2 Punkte: Verbindet 35 gegenüber 100 mit gleicher nutzbarer Menge und positiv verbleibendem Energieverbrauch. 1 Punkt: Erkennt niedrigeren Energiebedarf, nennt jedoch keine Vergleichsbasis oder Restenergie. 0 Punkte: Setzt Energieeinsparung mit Nullverbrauch gleich oder vergleicht ungleiche Mengen."
            },
            {
              "id": "e3",
              "points": 2,
              "description": "2 Punkte: Begründet C für Konsum UND Entsorgung mit Ressourcen/Energie und widerlegt die Neutralitätsbehauptung zur Zusatzanschaffung. 1 Punkt: Begründet nur Konsum oder nur Entsorgung; Transfer bleibt pauschal. 0 Punkte: Wählt ohne fachliche Gründe oder erklärt Zusatzkäufe wegen Recycling als folgenlos."
            }
          ]
        }
      }
    },

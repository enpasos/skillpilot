      "sourceRef": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-current435-course-terminal-route-and-practical-author-remediation-20261016-v1/author-practical-design/wholegoals/7fece532-d052-5633-b24e-ca5595fd76d0.author-draft.json",
      "extendedData": {
        "applicabilityFromRequires": true,
        "applicabilityMappingInheritance": "boundary",
        "authorDraft": {
          "role": "AUTHOR; no self-review",
          "planSHA256": "bcd0f514ed7f66b950b8a5f2aaac9fef9aa2b262fa89aed5de921de2fe9511d6",
          "sourceCanonicalSHA256": "6bed948af8d0ba47d722fb6205bacba6f8792e233f58c1772366395dd8450d8e",
          "ordinaryGoalId": "02634fdd-c8ba-591a-b240-77129b1bebb8",
          "sourceScope": "Exactly the current ordinary prerequisite applicability; actual learner-view placement is a separate parent task.",
          "independentCurrentTaskReviews": 0,
          "requiredIndependentCurrentTaskReviews": 2,
          "actualLearnerPerformanceClaimed": false,

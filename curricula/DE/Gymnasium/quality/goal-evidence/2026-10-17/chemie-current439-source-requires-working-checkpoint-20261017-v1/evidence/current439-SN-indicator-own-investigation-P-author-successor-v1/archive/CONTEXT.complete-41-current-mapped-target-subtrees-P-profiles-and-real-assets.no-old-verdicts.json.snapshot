      "wholeCurrentEvidenceProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "core-understanding",
            "essentialUnderstandingDe": "Neutralisation in Wasser ist Protonenübertragung zwischen Säure und Base, bei starken verdünnten Partnern H3O+ + OH− → 2 H2O. Antazida binden Säureäquivalente; Ladung und Mengen müssen stimmen. Neutraler pH allein beweist keine umweltgerechte Entsorgung.",
            "essentialUnderstandingEn": "Aqueous neutralization is proton transfer between acid and base; for dilute strong partners H3O+ + OH− → 2 H2O. Antacids consume acid equivalents with balanced charge and amounts. Neutral pH alone does not establish environmentally appropriate disposal.",
            "observablePerformanceDe": "OH− nimmt ein Proton von H3O+ auf: H3O+ + OH− → 2 H2O. Je 10,0 mmol reagieren, ohne Überschuss eines der beiden starken Partner; im idealen Modell wird neutraler Zustand erwartet. Mg(OH)2 + 2 H3O+ → Mg2+ + 4 H2O: ein Mg(OH)2-Äquivalent bindet zwei Säureäquivalente. Magnesium- und Begleit-Ionen sind danach weiterhin vorhanden. Neutralisation wandelt Teilchen um; sie beseitigt nicht jeden gelösten Stoff und belegt keine Unbedenklichkeit des verbleibenden Gemisches.",
            "observablePerformanceEn": "OH− accepts a proton from H3O+: H3O+ + OH− → 2 H2O. Matching 10.0 mmol amounts react without excess of either strong partner; the ideal model predicts neutrality. Mg(OH)2 + 2 H3O+ → Mg2+ + 4 H2O: one Mg(OH)2 equivalent consumes two acid equivalents. Magnesium and spectator ions remain. Neutralization converts particles; it does not remove every dissolved substance or establish that the remaining mixture is harmless."
          },
          {
            "id": "fresh-transfer-and-limit",
            "essentialUnderstandingDe": "Gleich große Säure-/Basenäquivalente und Hydroxid-Antazidum gegenüber Carbonat-Antazidum und einem neutralisierten metallhaltigen Abfall. Kein erfundenes Entsorgungsrecht und keine medizinische Wirksamkeitsfreigabe; die chemische Aussage bleibt mengen- und stoffbezogen.",
            "essentialUnderstandingEn": "Equal acid/base equivalents and a hydroxide antacid versus a carbonate antacid and neutralized metal-containing waste. No invented disposal regulation or medical efficacy approval; the chemical claim remains tied to specified amounts and species.",
            "observablePerformanceDe": "CaCO3 + 2 H3O+ → Ca2+ + CO2 + 3 H2O. Carbonat nimmt Protonen auf, die entstehende Kohlensäure liefert CO2 und Wasser; ein Carbonat-Äquivalent bindet zwei Säureäquivalente. CO2-Blasen sind kein Zeichen von Redox. Im Modellabfall sagt pH 7 nur etwas über den Säure-/Basezustand aus, nicht über Kupfer- oder Organikbelastung. Umweltgerechte Behandlung braucht Zusammensetzung und die für das tatsächliche Abfallgemisch geltende Sammel-/Entsorgungsregel; Neutralisation allein reicht nicht.",
            "observablePerformanceEn": "CaCO3 + 2 H3O+ → Ca2+ + CO2 + 3 H2O. Carbonate accepts protons and resulting carbonic acid yields CO2 and water; one carbonate equivalent consumes two acid equivalents. CO2 bubbles are not evidence of redox. In the waste model pH 7 specifies acid/base state, not copper or organic contamination. Appropriate treatment requires composition and the collection/disposal rule for the actual waste mixture; neutralization alone is insufficient."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "core-understanding",
            "fresh-transfer-and-limit"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "specific-system-variation",
            "textDe": "Gleich große Säure-/Basenäquivalente und Hydroxid-Antazidum gegenüber Carbonat-Antazidum und einem neutralisierten metallhaltigen Abfall.",
            "textEn": "Equal acid/base equivalents and a hydroxide antacid versus a carbonate antacid and neutralized metal-containing waste."
          },
          {
            "id": "model-boundary",
            "textDe": "Kein erfundenes Entsorgungsrecht und keine medizinische Wirksamkeitsfreigabe; die chemische Aussage bleibt mengen- und stoffbezogen.",
            "textEn": "No invented disposal regulation or medical efficacy approval; the chemical claim remains tied to specified amounts and species."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-next20-88ee181f-case-1",
            "taskDemandDe": "Schriftliches verdünntes 25-°C-Modell: 10,0 mmol H3O+ und 10,0 mmol OH− werden vollständig umgesetzt, Begleit-Ionen bleiben in Lösung. Zweiter gegebener Wirkstoff ist Mg(OH)2; ein Formeleinheit-Äquivalent liefert zwei neutralisierbare Hydroxid-Äquivalente. Es geht nicht um eine persönliche Medikamentendosis. Beschreibe den Protonenübergang, bilanziere die erste Reaktion und formuliere die Säurebindung durch Mg(OH)2. Erkläre den Unterschied zwischen neutralisieren und Stoffe verschwinden lassen.",
            "taskDemandEn": "Written dilute 25 °C model: 10.0 mmol H3O+ and 10.0 mmol OH− react completely while spectator ions remain in solution. A second supplied active compound is Mg(OH)2; one formula-unit equivalent provides two neutralizable hydroxide equivalents. No personal medication dose is considered. Describe proton transfer, balance the first reaction and formulate acid consumption by Mg(OH)2. Explain the difference between neutralizing and making substances disappear.",
            "expectedPerformanceDe": "OH− nimmt ein Proton von H3O+ auf: H3O+ + OH− → 2 H2O. Je 10,0 mmol reagieren, ohne Überschuss eines der beiden starken Partner; im idealen Modell wird neutraler Zustand erwartet. Mg(OH)2 + 2 H3O+ → Mg2+ + 4 H2O: ein Mg(OH)2-Äquivalent bindet zwei Säureäquivalente. Magnesium- und Begleit-Ionen sind danach weiterhin vorhanden. Neutralisation wandelt Teilchen um; sie beseitigt nicht jeden gelösten Stoff und belegt keine Unbedenklichkeit des verbleibenden Gemisches.",
            "expectedPerformanceEn": "OH− accepts a proton from H3O+: H3O+ + OH− → 2 H2O. Matching 10.0 mmol amounts react without excess of either strong partner; the ideal model predicts neutrality. Mg(OH)2 + 2 H3O+ → Mg2+ + 4 H2O: one Mg(OH)2 equivalent consumes two acid equivalents. Magnesium and spectator ions remain. Neutralization converts particles; it does not remove every dissolved substance or establish that the remaining mixture is harmless.",
            "understandingFocusDe": "Neutralpunkt und Entsorgungsfreigabe sind unterschiedliche Aussagen; das Modell ist keine Dosierungsempfehlung.",
            "understandingFocusEn": "Neutrality and disposal clearance are different claims; the model is not dosing advice."
          },
          {
            "id": "chem-next20-88ee181f-case-2",
            "taskDemandDe": "Frischer schriftlicher Fall: CaCO3 ist als säurebindender Wirkstoff gegeben; bei Umsetzung mit H3O+ entstehen Ca2+, CO2 und Wasser. In einem getrennten Modellabfall bleiben nach einer pH-Einstellung auf 7 ausdrücklich Cu2+-Ionen und unbekannte organische Stoffe enthalten. Formuliere die Carbonat-Neutralisation auf Teilchenebene und begründe, warum die zweite Lösung trotz pH 7 nicht automatisch in den Ausguss gehört.",
            "taskDemandEn": "Fresh written case: CaCO3 is supplied as an acid-binding compound; reaction with H3O+ forms Ca2+, CO2 and water. Separate model waste still explicitly contains Cu2+ ions and unknown organics after adjustment to pH 7. Write carbonate neutralization at particle level and justify why the second solution is not automatically suitable for drain disposal despite pH 7.",
            "expectedPerformanceDe": "CaCO3 + 2 H3O+ → Ca2+ + CO2 + 3 H2O. Carbonat nimmt Protonen auf, die entstehende Kohlensäure liefert CO2 und Wasser; ein Carbonat-Äquivalent bindet zwei Säureäquivalente. CO2-Blasen sind kein Zeichen von Redox. Im Modellabfall sagt pH 7 nur etwas über den Säure-/Basezustand aus, nicht über Kupfer- oder Organikbelastung. Umweltgerechte Behandlung braucht Zusammensetzung und die für das tatsächliche Abfallgemisch geltende Sammel-/Entsorgungsregel; Neutralisation allein reicht nicht.",
            "expectedPerformanceEn": "CaCO3 + 2 H3O+ → Ca2+ + CO2 + 3 H2O. Carbonate accepts protons and resulting carbonic acid yields CO2 and water; one carbonate equivalent consumes two acid equivalents. CO2 bubbles are not evidence of redox. In the waste model pH 7 specifies acid/base state, not copper or organic contamination. Appropriate treatment requires composition and the collection/disposal rule for the actual waste mixture; neutralization alone is insufficient.",
            "understandingFocusDe": "Kein erfundenes Entsorgungsrecht und keine medizinische Wirksamkeitsfreigabe; die chemische Aussage bleibt mengen- und stoffbezogen.",
            "understandingFocusEn": "No invented disposal regulation or medical efficacy approval; the chemical claim remains tied to specified amounts and species."
          }
        ]
      },
      "profileJsonPointer": "line:145#/profile"
    },

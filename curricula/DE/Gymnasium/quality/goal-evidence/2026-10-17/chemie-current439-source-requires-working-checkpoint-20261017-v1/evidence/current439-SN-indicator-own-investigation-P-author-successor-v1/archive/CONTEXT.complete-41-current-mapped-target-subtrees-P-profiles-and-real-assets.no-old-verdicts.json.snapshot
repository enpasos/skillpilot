      "wholeCurrentEvidenceProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "connected-three-perspectives",
            "essentialUnderstandingDe": "Der geforderte Forschungsbogen verbindet wissenschaftshistorische Entwicklung, heutige Anwendung/Prüfung und eine begründete Zukunftsfrage derselben gewählten Stoffgruppe Farbstoffe.",
            "essentialUnderstandingEn": "The required research account connects scientific-historical development, current application/testing and a justified future question within the same selected family of dyes.",
            "observablePerformanceDe": "Die lernende Person erläutert in BW-B1 und BW-B2 alle drei Perspektiven als Zusammenhang; sie setzt Indigo und Azofarbstoffe dabei nicht gleich und ersetzt den Zusammenhang nicht durch Jahreszahlen.",
            "observablePerformanceEn": "The learner connects all three perspectives in BW-B1 and BW-B2, without equating indigo with azo dyes or replacing the account with dates."
          },
          {
            "id": "chemical-design-and-application-evidence",
            "essentialUnderstandingDe": "Molekül-/Verfahrensgestaltung, Stoffanalyse und Anwendungsprüfung leisten verschiedene Beiträge zur Lösung eines konkreten Farbstoffproblems.",
            "essentialUnderstandingEn": "Molecular/process design, substance analysis and application testing make different contributions to solving a specific dye problem.",
            "observablePerformanceDe": "Sie erklärt aus den gelieferten Angaben die Löslichkeits-/Redoxrolle bei Indigo sowie den Unterschied zwischen Azo-Grundkörper, Ankergruppe, Absorptionsprüfung und Waschbeständigkeit im A/B-Fall.",
            "observablePerformanceEn": "The learner uses the supplied information to explain indigo’s solubility/redox role and distinguish azo core, anchor group, absorption testing and wash fastness in the A/B case."
          },
          {
            "id": "conditional-comparison-and-limit",
            "essentialUnderstandingDe": "Ein einzelner Stoffbefund oder Leistungswert entscheidet keine gesamte Prozessbilanz und belegt kein allgemeines Zukunftsversprechen.",
            "essentialUnderstandingEn": "One identity finding or performance value does not decide a complete process assessment or establish a general future promise.",
            "observablePerformanceDe": "Sie verknüpft bei U/V mindestens zwei gelieferte Kriterien mit dem Zielkonflikt und erklärt bei C, warum ähnliche vorhergesagte Absorption oder geplante Abbaubarkeit keine gleiche Eignung oder Unbedenklichkeit belegt.",
            "observablePerformanceEn": "The learner connects at least two supplied U/V criteria to the trade-off and explains why C’s similar predicted absorption or planned degradability establishes neither equal suitability nor harmlessness."
          },
          {
            "id": "future-question-from-current-gap",
            "essentialUnderstandingDe": "Eine zukunftsorientierte F&E-Erklärung leitet die nächste prüfbare Frage aus den gegenwärtigen Befunden und Lücken ab; eine geplante Prüfung ist noch kein Ergebnis.",
            "essentialUnderstandingEn": "A future-oriented R&D explanation derives the next testable question from current findings and gaps; a planned test is not a result.",
            "observablePerformanceDe": "Sie begründet für V bzw. C die nötigen Leistungs-, Gesamtaufwands-, Skalierungs- oder Abbauproduktprüfungen und trennt reale historische Angaben, gegebene Modellbeobachtungen und Zukunftshypothesen.",
            "observablePerformanceEn": "The learner justifies necessary performance, total-input, scale-up or degradation-product tests for V or C and distinguishes historical information, supplied model observations and future hypotheses."
          }
        ],
        "variationAxes": [
          {
            "id": "dye-and-development-problem",
            "textDe": "Indigo-Verfahrenswechsel und Azo-Ankergruppenprojekt innerhalb der gewählten Farbstofffamilie vergleichen.",
            "textEn": "Compare indigo process change and an azo-anchor-group project within the selected dye family."
          },
          {
            "id": "criterion-conflict",
            "textDe": "Wasser/Reduktionsmittel gegen Energie/Waschbeständigkeit bzw. Absorption gegen Bindung/Abbauprodukte abwägen.",
            "textEn": "Compare water/reductant with energy/wash performance or absorption with binding/degradation products."
          },
          {
            "id": "time-and-evidence-status",
            "textDe": "Belegtes historisches Ereignis, erfundene heutige Modelldaten und ungeprüfte Zukunftshypothese klar auseinanderhalten.",
            "textEn": "Keep a sourced historical event, fictional current model data and an untested future hypothesis distinct."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "bw-b1",
            "taskDemandDe": "Verbinde historische Indigosynthese, heutige Redox-/Löslichkeitsanwendung und die Zukunftsfrage U/V anhand der gelieferten Kriterien. Vollständiges Material, Auftrag, Lösung und vier Kriterien: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-three-source-duty-carriers-prospective422-bounded-author-remediation-20261015-v1/materials/eleven-complete-cases.remediated.author.json, Fall BW-B1.",
            "taskDemandEn": "Connect historical indigo synthesis, current redox/solubility use and the U/V future question using supplied criteria. Complete material, task, solution and four criteria: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-three-source-duty-carriers-prospective422-bounded-author-remediation-20261015-v1/materials/eleven-complete-cases.remediated.author.json, case BW-B1.",
            "expectedPerformanceDe": "V spart gegebenes Wasser/Reduktionsmittel, benötigt mehr Energie und hat geringere bisherige Waschbeständigkeit; Gesamtaufwand/Skalierung fehlen. Gleiches Indigo bedeutet keine gleiche Prozessbilanz.",
            "expectedPerformanceEn": "V saves supplied water/reductant but needs more energy and currently has lower wash fastness; total inputs/scale-up are missing. Identical indigo does not imply equal process impacts.",
            "understandingFocusDe": "Ein zusammenhängender zeitlicher F&E-Bogen mit chemischem Anwendungsproblem und offenem nächsten Test.",
            "understandingFocusEn": "One connected temporal R&D account with a chemical application problem and an open next test."
          },
          {
            "id": "bw-b2",
            "taskDemandDe": "Verknüpfe historischen Verfahrenswandel mit dem heutigen A/B-Projekt und einer prüfbaren C-Zukunftsfrage. Vollständiges Material, Auftrag, Lösung und vier Kriterien: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-three-source-duty-carriers-prospective422-bounded-author-remediation-20261015-v1/materials/eleven-complete-cases.remediated.author.json, Fall BW-B2.",
            "taskDemandEn": "Connect historical process change with the current A/B project and a testable future C question. Complete material, task, solution and four criteria: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-three-source-duty-carriers-prospective422-bounded-author-remediation-20261015-v1/materials/eleven-complete-cases.remediated.author.json, case BW-B2.",
            "expectedPerformanceDe": "Indigo ist kein Azofarbstoff. Azo-Kern, Ankergruppe, Spektren und Waschprüfung leisten verschiedene Beiträge; C braucht reale Leistungs- und Abbauproduktdaten.",
            "expectedPerformanceEn": "Indigo is not an azo dye. Azo core, anchor group, spectra and wash tests make distinct contributions; C needs actual performance and degradation-product data.",
            "understandingFocusDe": "Übertragung auf einen anderen Farbstoff-/Gestaltungsfall ohne Zukunftsversprechen als Messung auszugeben.",
            "understandingFocusEn": "Transfer to another dye/design problem without presenting a future promise as a measurement."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "connected-three-perspectives",
            "chemical-design-and-application-evidence",
            "conditional-comparison-and-limit",
            "future-question-from-current-gap"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        }
      },

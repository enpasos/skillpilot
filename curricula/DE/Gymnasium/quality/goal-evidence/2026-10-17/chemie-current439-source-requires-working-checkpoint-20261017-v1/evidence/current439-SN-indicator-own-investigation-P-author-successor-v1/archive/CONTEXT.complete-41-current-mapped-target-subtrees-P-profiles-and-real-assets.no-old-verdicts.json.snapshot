      "wholeCurrentEvidenceProfile": {
        "archetype": "procedure",
        "expectations": [
          {
            "id": "structure-model-reasoning",
            "essentialUnderstandingDe": "Eine Gleichung für vorgegebene Halogenalkan-Hydroxid-Substitution erhält Atome und Ladungen und ersetzt die Halogengruppe durch OH unter passenden Bedingungen.",
            "essentialUnderstandingEn": "An equation for specified halogenoalkane-hydroxide substitution conserves atoms and charge and replaces halogen with OH under appropriate conditions.",
            "observablePerformanceDe": "Die Person formuliert vollständige Nettogleichungen und prüft separat C/H/O/Halogen sowie Gesamtladung.",
            "observablePerformanceEn": "The learner writes complete net equations and separately checks C/H/O/halogen and total charge."
          },
          {
            "id": "fresh-application-and-boundary",
            "essentialUnderstandingDe": "Halogenid ist das Abgangsion; die Gleichung erlaubt ohne Bedingungen keine Aussage, dass Substitution statt Eliminierung stets dominiert.",
            "essentialUnderstandingEn": "Halide is the leaving ion; the equation alone does not show substitution always dominating elimination without conditions.",
            "observablePerformanceDe": "Für den ausdrücklich gewünschten Substitutionsfall gilt CH3CH2Cl + OH− → CH3CH2OH + Cl−. Atom-/Ladungsbilanz wird geprüft. Der fehlerhafte Entwurf trifft den verlangten neutralen Alkohol nicht; ob in einem realen Versuch Substitution dominiert, braucht unter anderem Lösemittel-/Temperaturinformation. Ein formal bilanzierter Entwurf ist nicht automatisch der passende Stoffumsatz; der Fall behauptet keine allgemeine Experimentierfreigabe.",
            "observablePerformanceEn": "For the requested substitution CH3CH2Cl + OH− → CH3CH2OH + Cl−. Atom and charge balance are checked. The faulty draft does not represent the required neutral alcohol; actual substitution dominance needs information such as solvent and temperature. A formally balanced draft is not automatically the appropriate reaction; the case claims no general experimental permission."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "structure-model-reasoning",
            "fresh-application-and-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "material-variation",
            "textDe": "Ethyl-/Propylrest, Cl/Br, neutraler Alkohol gegenüber Halogenidion und fehlende Reaktionsbedingungen.",
            "textEn": "Ethyl/propyl group, Cl/Br, neutral alcohol versus halide ion and absent reaction conditions."
          },
          {
            "id": "counterexample",
            "textDe": "Halogenid ist das Abgangsion; die Gleichung erlaubt ohne Bedingungen keine Aussage, dass Substitution statt Eliminierung stets dominiert.",
            "textEn": "Halide is the leaving ion; the equation alone does not show substitution always dominating elimination without conditions."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-current15-d4928773-case-1",
            "taskDemandDe": "Papierfall: 1-Brompropan C3H7Br reagiert mit OH− in einem ausdrücklich substitutionsbegünstigenden Modell zu Propan-1-ol. Formuliere die Nettogleichung mit Ladungen und überprüfe alle Atome und die Ladung.",
            "taskDemandEn": "Paper case: 1-bromopropane C3H7Br reacts with OH− in an explicitly substitution-favouring model to propan-1-ol. Write the net equation with charges and check all atoms and charge.",
            "expectedPerformanceDe": "CH3CH2CH2Br + OH− → CH3CH2CH2OH + Br−. C3, H8, O1 und Br1 sowie Gesamtladung −1 stehen auf beiden Seiten; OH wird als gebundene neutrale Hydroxygruppe übernommen, Brom als Bromid abgegeben.",
            "expectedPerformanceEn": "CH3CH2CH2Br + OH− → CH3CH2CH2OH + Br−. C3, H8, O1, Br1 and total charge −1 occur on both sides; OH becomes a bound neutral hydroxyl group and bromine leaves as bromide.",
            "understandingFocusDe": "HBr statt Br− würde ohne zusätzliche Säure-Base-Bilanz diese vorgegebene Nettogleichung falsch laden.",
            "understandingFocusEn": "HBr instead of Br− would give the wrong charge unless additional acid-base accounting were supplied."
          },
          {
            "id": "chem-current15-d4928773-case-2",
            "taskDemandDe": "Frischer Fall: Chlorethan CH3CH2Cl mit OH−. Ein Entwurf schreibt CH3CH2Cl + OH− → CH3CH2O− + HCl. Bedingungen fehlen zunächst; für die Gleichung wird anschließend ausdrücklich Substitution zum neutralen Ethanol vorgegeben. Korrigiere die vorgegebene Produktdarstellung und erläutere, welche zusätzliche Aussage ohne Reaktionsbedingungen offen bleibt.",
            "taskDemandEn": "Fresh case: chloroethane CH3CH2Cl with OH−. A draft writes CH3CH2Cl + OH− → CH3CH2O− + HCl. Conditions initially are absent; for the equation substitution to neutral ethanol is then explicitly specified. Correct the specified product representation and explain what remains unresolved without reaction conditions.",
            "expectedPerformanceDe": "Für den ausdrücklich gewünschten Substitutionsfall gilt CH3CH2Cl + OH− → CH3CH2OH + Cl−. Atom-/Ladungsbilanz wird geprüft. Der fehlerhafte Entwurf trifft den verlangten neutralen Alkohol nicht; ob in einem realen Versuch Substitution dominiert, braucht unter anderem Lösemittel-/Temperaturinformation.",
            "expectedPerformanceEn": "For the requested substitution CH3CH2Cl + OH− → CH3CH2OH + Cl−. Atom and charge balance are checked. The faulty draft does not represent the required neutral alcohol; actual substitution dominance needs information such as solvent and temperature.",
            "understandingFocusDe": "Ein formal bilanzierter Entwurf ist nicht automatisch der passende Stoffumsatz; der Fall behauptet keine allgemeine Experimentierfreigabe.",
            "understandingFocusEn": "A formally balanced draft is not automatically the appropriate reaction; the case claims no general experimental permission."
          }
        ]
      },
      "profileJsonPointer": "line:165#/profile"
    },

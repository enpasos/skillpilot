      "wholeCurrentEvidenceProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "three-method-contributions",
            "essentialUnderstandingDe": "Analyse identifiziert und charakterisiert Proben, Synthese stellt gezielt andere oder reine Kandidaten bereit, Molecular Modelling liefert begrenzte Struktur-/Bindungshypothesen.",
            "essentialUnderstandingEn": "Analysis identifies and characterizes specimens, synthesis deliberately supplies modified or pure candidates, and molecular modelling provides bounded structure/binding hypotheses.",
            "observablePerformanceDe": "Die lernende Person ordnet in HB-W1 und HB-W2 alle drei Verfahren konkreten Angaben derselben Wirkstoff-Forschungsfrage zu; reine Methodenetiketten genügen nicht.",
            "observablePerformanceEn": "The learner assigns all three methods to concrete inputs for the same active-ingredient research question in HB-W1 and HB-W2; method labels alone do not suffice."
          },
          {
            "id": "research-feedback-and-revision",
            "essentialUnderstandingDe": "Experimentelle Befunde und Modellannahmen beeinflussen die nächste Analyse-, Synthese- oder Modellentscheidung; Forschung ist keine feste Einbahnstraße.",
            "essentialUnderstandingEn": "Experimental findings and model assumptions inform the next analytical, synthetic or modelling decision; research is not a fixed one-way sequence.",
            "observablePerformanceDe": "Sie erläutert eine begründete Rückkopplung im N/D-Fall und rekonstruiert im P/Q-Fall, wie der Widerspruch zur P-Vorhersage die Forschungsfrage und Modellannahmen ändert.",
            "observablePerformanceEn": "The learner explains reasoned feedback in the N/D case and reconstructs how disagreement with the P prediction changes the research question and model assumptions in the P/Q case."
          },
          {
            "id": "specimen-identity-versus-causal-effect",
            "essentialUnderstandingDe": "Struktur-/Reinheitsanalyse und ein Proben-Assay beantworten verschiedene Fragen; ein Gemisch oder 98 % Reinheit sichern keine ausschließliche Wirkungszuordnung zum benannten Molekül.",
            "essentialUnderstandingEn": "Structure/purity analysis and a specimen assay answer different questions; a mixture or 98% purity does not establish exclusive attribution to the named molecule.",
            "observablePerformanceDe": "Sie trennt Vorhersage, Identitätsbefund und Testbeobachtung, begrenzt die kausale D-Zuordnung und erklärt, weshalb die alte P/Q-Probe den Effekt nicht P zuordnen konnte.",
            "observablePerformanceEn": "The learner separates prediction, identity findings and assay observation, limits causal attribution to D and explains why the earlier P/Q specimen could not assign the effect to P."
          },
          {
            "id": "justified-next-test-and-reach",
            "essentialUnderstandingDe": "Ein nächster Forschungsschritt muss die konkrete offene Zuordnung oder Modellannahme prüfen; nichtklinische Daten ersetzen keine klinische Wirksamkeit oder Sicherheit.",
            "essentialUnderstandingEn": "A next research step must test the specific open attribution or model assumption; nonclinical data do not replace clinical efficacy or safety evidence.",
            "observablePerformanceDe": "Sie begründet passende, noch nicht ausgeführte Reinheits-/Verunreinigungs-/Kontrolltests und überträgt die Rückkopplung auf eine neu entdeckte Verunreinigung, ohne Mechanismus, Additivität oder Zulassung zu erfinden.",
            "observablePerformanceEn": "The learner justifies appropriate unperformed purity/impurity/control tests and transfers feedback to a newly detected impurity without inventing mechanism, additivity or authorization."
          }
        ],
        "variationAxes": [
          {
            "id": "agreement-versus-contradiction",
            "textDe": "Vom D-Probenbefund zur P/Q-Widerlegung der ursprünglichen Zuordnung wechseln.",
            "textEn": "Change from the D-specimen result to P/Q evidence contradicting the original attribution."
          },
          {
            "id": "specimen-composition",
            "textDe": "98-%-Probe, ungetrenntes Gemisch, bestätigte Reinsubstanz und später erkannte Verunreinigung unterscheiden.",
            "textEn": "Distinguish a 98% specimen, unseparated mixture, confirmed pure compound and later detected impurity."
          },
          {
            "id": "method-direction",
            "textDe": "Analyse verändert Modell-/Syntheseentscheidung und ein neuer Test verändert die nächste Fragestellung.",
            "textEn": "Analysis changes modelling/synthesis decisions and a new assay changes the next research question."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "hb-w1",
            "taskDemandDe": "Erkläre Analyse, Synthese und Molecular Modelling im N/D-Forschungsweg einschließlich Rückkopplung und ungetesteter Verunreinigungen. Vollständiges Material, Auftrag, Lösung und vier Kriterien: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-three-source-duty-carriers-prospective422-bounded-author-remediation-20261015-v1/materials/eleven-complete-cases.remediated.author.json, Fall HB-W1.",
            "taskDemandEn": "Explain analysis, synthesis and molecular modelling in the N/D inquiry, including feedback and unassayed impurities. Complete material, task, solution and four criteria: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-three-source-duty-carriers-prospective422-bounded-author-remediation-20261015-v1/materials/eleven-complete-cases.remediated.author.json, case HB-W1.",
            "expectedPerformanceDe": "Modellvorschlag, Esterbildung, Struktur-/Reinheitsanalyse und Probenwirkung bleiben verschiedene Beiträge. 98 % Reinheit beweisen keine ausschließliche D-Kausalität; geeignete Kontrollen sind erst vorgeschlagen.",
            "expectedPerformanceEn": "Model proposal, ester formation, structure/purity analysis and specimen effect remain distinct contributions. 98% purity does not prove exclusive D causation; suitable controls are only proposed.",
            "understandingFocusDe": "Alle drei domänenspezifischen Methoden und ihre begründete Rückkopplung sind obligatorisch.",
            "understandingFocusEn": "All three domain-specific methods and their reasoned feedback are compulsory."
          },
          {
            "id": "hb-w2",
            "taskDemandDe": "Rekonstruiere den P/Q-Widerspruch zur Modellvorhersage und begründe einen nächsten Schritt bei neuer Verunreinigung. Vollständiges Material, Auftrag, Lösung und vier Kriterien: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-three-source-duty-carriers-prospective422-bounded-author-remediation-20261015-v1/materials/eleven-complete-cases.remediated.author.json, Fall HB-W2.",
            "taskDemandEn": "Reconstruct the P/Q disagreement with the model prediction and justify a next step after a new impurity. Complete material, task, solution and four criteria: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-three-source-duty-carriers-prospective422-bounded-author-remediation-20261015-v1/materials/eleven-complete-cases.remediated.author.json, case HB-W2.",
            "expectedPerformanceDe": "35 % Gemischaktivität identifiziert P nicht; reines P ergibt 95 %, Q 20 %. Analytik/Synthese ermöglichen kontrollierte Zuordnung und veranlassen Modellkritik; Additivität/Mechanismus bleiben offen.",
            "expectedPerformanceEn": "35% mixture activity does not identify P; pure P gives 95%, Q 20%. Analysis/synthesis enable controlled attribution and motivate model criticism; additivity/mechanism remain open.",
            "understandingFocusDe": "Abweichender Befund muss die Forschungsfrage verändern können.",
            "understandingFocusEn": "A divergent observation must be able to change the research question."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "three-method-contributions",
            "research-feedback-and-revision",
            "specimen-identity-versus-causal-effect",
            "justified-next-test-and-reach"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        }
      },

      "wholeCurrentEvidenceProfile": {
        "archetype": "representation",
        "expectations": [
          {
            "id": "b004-42a84bca-core",
            "essentialUnderstandingDe": "Ein Reinstoff ist ein einzelner Stoff mit bestimmter Zusammensetzung, ein Gemisch enthält mehrere Stoffe. In den hier betrachteten Atom- und Molekülbildern zeigt ein Reinstoff eine Art Atome oder Moleküle; das ist keine allgemeine Definition für spätere Ionengitter. Ein Element enthält eine Atomsorte, eine Verbindung mindestens zwei chemisch gebundene Atomsorten.",
            "essentialUnderstandingEn": "A pure substance is one substance with a defined composition, whereas a mixture contains several substances. In the atom and molecule diagrams considered here, a pure substance shows one kind of atom or molecule; this is not a universal definition for ionic lattices studied later. An element contains one atom type, while a compound contains at least two chemically bonded atom types.",
            "observablePerformanceDe": "Die lernende Person ordnet neue Atom- und Molekülkarten als Reinstoff oder Gemisch und als Element oder Verbindung ein und begründet anhand von Atomsorten und chemischer Bindung. Ionengitter-Kenntnisse werden nicht verlangt.",
            "observablePerformanceEn": "The learner classifies fresh atom and molecule cards as pure substances or mixtures and as elements or compounds, justifying with atom types and chemical bonding. Knowledge of ionic lattices is not required."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "b004-42a84bca-core"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "molecular-particle-composition",
            "textDe": "Eine Art Atom oder Molekül und mehrere Arten werden nur innerhalb der gezeigten Atom-/Molekülmodelle verglichen.",
            "textEn": "One kind of atom or molecule and several kinds are contrasted only within the shown atom/molecule models."
          },
          {
            "id": "atom-composition",
            "textDe": "Elementmoleküle und Moleküle aus verschiedenen Atomsorten werden verglichen; Ionengitter bleiben eine Modellgrenze.",
            "textEn": "Elemental molecules and molecules with different atom types are compared; ionic lattices remain a model boundary."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "element-compound-mixture-cards",
            "taskDemandDe": "Drei neue Karten zeigen nur gleiche O2-Moleküle, nur gleiche H2O-Moleküle oder eine Mischung aus O2- und H2O-Molekülen. Ordne jede Karte in die Reinstoff/Gemisch-Hierarchie ein und begründe.",
            "taskDemandEn": "Three fresh cards show only identical O2 molecules, only identical H2O molecules, or a mixture of O2 and H2O molecules. Classify each in the pure-substance/mixture hierarchy and explain.",
            "expectedPerformanceDe": "Die lernende Person ordnet O2 als elementaren Reinstoff, H2O als Verbindungs-Reinstoff und die gemeinsame Karte als Gemisch ein; sie nennt gleiche bzw. verschiedene Teilchensorten und Atomsorten.",
            "expectedPerformanceEn": "The learner classifies O2 as a pure element, H2O as a pure compound and the combined card as a mixture, citing particle and atom types.",
            "understandingFocusDe": "Hierarchie und Bindungen begründen die Einordnung.",
            "understandingFocusEn": "Hierarchy and bonding justify the classification."
          },
          {
            "id": "fresh-two-compound-mixture",
            "taskDemandDe": "Eine neue Karte zeigt Wasser- und Kohlenstoffdioxid-Moleküle zusammen, eine zweite nur Chlor-Moleküle Cl₂. Ordne beide Karten als Reinstoff oder Gemisch ein; entscheide beim Reinstoff Element oder Verbindung. Erkläre, warum zwei Verbindungen zusammen nicht ein einzelner Reinstoff sind.",
            "taskDemandEn": "A fresh card combines water and carbon dioxide molecules; another contains only chlorine molecules Cl₂. Classify both cards as pure substance or mixture; decide whether the pure substance is an element or compound. Explain why two compounds together are not one pure substance.",
            "expectedPerformanceDe": "Die lernende Person erkennt Wasser/CO₂ als Gemisch zweier Verbindungen und Cl₂ als elementaren Reinstoff. Zwei gleiche Chloratome bilden ein Molekül eines Elements, keine Verbindung verschiedener Elemente; Wasser und CO₂ bleiben zwei Stoffe.",
            "expectedPerformanceEn": "The learner identifies water/CO₂ as a mixture of two compounds and Cl₂ as a pure element. Two identical chlorine atoms form a molecule of an element, not a compound of different elements; water and CO₂ remain two substances.",
            "understandingFocusDe": "Molekül bedeutet nicht automatisch Verbindung; mehrere Verbindungen zusammen sind ein Gemisch. Die Einordnung bleibt im altersgerechten Molekülmodell.",
            "understandingFocusEn": "Molecule does not automatically mean compound; several compounds together form a mixture. The classification stays within the age-appropriate molecular model."
          }
        ]
      },
      "profileJsonPointer": "line:36#/profile"
    },

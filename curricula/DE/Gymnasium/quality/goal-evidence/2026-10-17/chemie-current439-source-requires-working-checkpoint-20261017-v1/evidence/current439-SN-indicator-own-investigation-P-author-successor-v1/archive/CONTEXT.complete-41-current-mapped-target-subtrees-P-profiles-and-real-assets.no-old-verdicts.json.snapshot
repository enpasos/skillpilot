      "wholeCurrentEvidenceProfile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Beide Angriffe korrekt vom O-Paar zum jeweils elektrophilen C; keine H→C-Pfeile.",
            "essentialUnderstandingEn": "Both attacks correctly start at an O pair and end at the appropriate electrophilic C; no H→C arrows.",
            "observablePerformanceDe": "Beide Angriffe korrekt vom O-Paar zum jeweils elektrophilen C; keine H→C-Pfeile. Zwei korrekte Angriff-/Abgangs-Pfeilpaare am neuen Strukturfall.",
            "observablePerformanceEn": "Both attacks correctly start at an O pair and end at the appropriate electrophilic C; no H→C arrows. Two correct attack/departure arrow pairs for the new structure."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Beide C–Br-Paare gehen zum Br; Zwischenprodukt, Atome und Ladung−2 beidseitig stimmen.",
            "essentialUnderstandingEn": "Both C–Br pairs move to Br; intermediate, atoms and−2 charge on both sides are correct.",
            "observablePerformanceDe": "Beide C–Br-Paare gehen zum Br; Zwischenprodukt, Atome und Ladung−2 beidseitig stimmen. Struktur-/Gesamtgleichung, Zwischenprodukt und Ladungs-/Atombilanz korrekt.",
            "observablePerformanceEn": "Both C–Br pairs move to Br; intermediate, atoms and−2 charge on both sides are correct. Correct structural/overall equation, intermediate and charge/atom balance."
          },
          {
            "id": "e3",
            "essentialUnderstandingDe": "Zwei C–O-Bindungen, zwei OH-Enden und deren Polyester-Monomerfunktion begründet.",
            "essentialUnderstandingEn": "Two C–O bonds, two OH ends and their polyester-monomer function explained.",
            "observablePerformanceDe": "Zwei C–O-Bindungen, zwei OH-Enden und deren Polyester-Monomerfunktion begründet. X mit einer OH-Gruppe vom fertigen Diol unterschieden; zweiter Schritt und Monomerfunktion erklärt.",
            "observablePerformanceEn": "Two C–O bonds, two OH ends and their polyester-monomer function explained. X with one OH distinguished from the complete diol; second step and monomer function explained."
          },
          {
            "id": "e4",
            "essentialUnderstandingDe": "Bromethan→Ethanol mechanistisch übertragen; monofunktionelle Endbegrenzung statt gleicher Diolbrücke erläutert.",
            "essentialUnderstandingEn": "Bromoethane→ethanol transferred mechanistically; monofunctional end capping rather than the same diol bridge explained.",
            "observablePerformanceDe": "Bromethan→Ethanol mechanistisch übertragen; monofunktionelle Endbegrenzung statt gleicher Diolbrücke erläutert. H-Pfeil, bloße Gesamtgleichung und Mengenverteilungsbehauptung begründet korrigiert; Restwechsel übertragen.",
            "observablePerformanceEn": "Bromoethane→ethanol transferred mechanistically; monofunctional end capping rather than the same diol bridge explained. H arrow, bare overall equation and molecular-distribution claim corrected with reasons; changed chain transferred."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",
            "e2",
            "e3",
            "e4"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "changed-substrate-or-information",
            "textDe": "Gestoppte Struktur und geänderte Kettenlänge verlangen eine neue Funktionalitäts-/Mechanismusbegründung.",
            "textEn": "Stopped structure and changed chain length require a new functionality/mechanism explanation."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "case-1",
            "taskDemandDe": "Zeige beide Substitutionsschritte mit Strukturformeln und je zwei Elektronenpaarpfeilen. Erkläre Nukleophil, angegriffenes C und Abgangsgruppe. Formuliere Zwischenprodukt, Gesamtgleichung und Ladungsbilanz. Begründe die Diol-Monomereignung. Übertrage den Mechanismus auf Bromethan und erkläre, weshalb dessen Alkoholprodukt nicht dieselbe zweifunktionelle Brücke bildet. Eine Gesamtgleichung allein reicht nicht als Mechanismus.",
            "taskDemandEn": "Show both substitutions with structural formulae and two electron-pair arrows for each. Explain the nucleophile, attacked C and leaving group. Write the intermediate, overall equation and charge balance. Justify suitability as a diol monomer. Transfer the mechanism to bromoethane and explain why its alcohol product does not provide the same bifunctional bridge. An overall equation alone is not a mechanism.",
            "expectedPerformanceDe": "Ein freies Paar des OH−-O geht zum endständigen C; gleichzeitig geht das C–Br-Paar zum Br. Zuerst entstehen HO–(CH2)6–Br und Br−, nach demselben Vorgang am anderen Ende HO–(CH2)6–OH und Br−. Gesamt: Br–(CH2)6–Br+2 OH− → HO–(CH2)6–OH+2 Br−. Atome erhalten, Gesamtladung jeweils−2. Die O–H-Bindung bleibt erhalten; das OH−-Modell braucht keinen zusätzlichen Protonentransfer. Zwei neue C–O-Bindungen schaffen zwei OH-Enden für zwei mögliche Esterverknüpfungen. Bromethan liefert mit derselben lokalen Pfeilfolge Ethanol+Br−. Ethanol besitzt nur eine OH-Gruppe und begrenzt in der vorgegebenen Route ein Kettenende statt dieselbe Diolbrücke zu bilden. Daraus folgt keine reale Ausbeute oder vollständig untersuchte Reaktionsführung.",
            "expectedPerformanceEn": "An OH− oxygen lone pair goes to the terminal C while the C–Br pair goes to Br. First HO–(CH2)6–Br and Br− form, then the same process at the other end gives HO–(CH2)6–OH and Br−. Overall: Br–(CH2)6–Br+2 OH− → HO–(CH2)6–OH+2 Br−. Atoms are conserved and total charge is−2 on each side. The O–H bond remains; this OH− model requires no additional proton transfer. Two new C–O bonds create two OH ends for two potential ester links. The same local arrow sequence converts bromoethane into ethanol+Br−. Ethanol has only one OH and caps a chain end in the specified route instead of making the same diol bridge. No real yield or complete reaction-control knowledge follows.",
            "understandingFocusDe": "Gleiche lokale Reaktion bei anderer Ausgangsfunktionalität verändert die Monomereignung.",
            "understandingFocusEn": "The same local reaction with changed starting functionality changes monomer suitability."
          },
          {
            "id": "case-2",
            "taskDemandDe": "Entwickle beide lokalen Elektronenpaar-Pfeilfolgen und die ausgeglichene Gesamtgleichung. Erkläre X und den noch nötigen Schritt zum vollständigen Diol. Beurteile die Monomereignung von X, korrigiere beide Skizzen und übertrage die Erklärung auf die gegenüber Fall1 geänderte Kettenlänge. Prüfe zusätzlich die Behauptung: Ein OH−-Äquivalent je Dihalogenalkan beweist, dass jedes Molekül genau als X vorliegt.",
            "taskDemandEn": "Develop both local electron-pair arrow sequences and the balanced overall equation. Explain X and the remaining step to the complete diol. Judge X’s monomer suitability, correct both sketches and transfer the explanation to the changed chain length from case1. Also evaluate the claim that one OH− equivalent per dihaloalkane proves every molecule is exactly X.",
            "expectedPerformanceDe": "Je O-Paar→primärer C und C–Br-Paar→Br ergibt Br–(CH2)3–Br+2 OH− → HO–(CH2)3–OH+2 Br−, Gesamtladung−2 auf beiden Seiten. X besitzt erst eine OH-Gruppe und noch eine C–Br-Gruppe; die zweite Substitution erzeugt das zweite OH-Ende. X ist daher im angegebenen Verfahren noch nicht derselbe Diolbaustein. Der Pfeil beginnt am O-Paar, nicht am H. Die Gesamtgleichung zeigt die Bilanz, aber nicht beide lokalen Elektronenpaarbewegungen. Der kürzere Rest ändert in diesem Modell nicht die Anzahl der erforderlichen Endsubstitutionen. Ein Äquivalent liefert allein keine Information über die Molekülverteilung: un-, einfach und zweifach umgesetzte Teilchen können vorliegen. Die hier gegebene Identität von X wird nicht aus dieser Mengenbehauptung abgeleitet.",
            "expectedPerformanceEn": "Each O-pair→primary C and C–Br-pair→Br gives Br–(CH2)3–Br+2 OH− → HO–(CH2)3–OH+2 Br−, total charge−2 on both sides. X has only one OH and still one C–Br; the second substitution creates the second OH end. In the specified process X is therefore not yet the same diol component. The arrow starts at an O pair, not H. The overall equation balances matter but does not show both local electron-pair movements. The shorter chain does not change the number of terminal substitutions required in this model. One equivalent alone cannot establish molecular distribution: unreacted, singly and doubly converted species may occur. X’s supplied identity is not inferred from that amount claim.",
            "understandingFocusDe": "Gestoppte Struktur und geänderte Kettenlänge verlangen eine neue Funktionalitäts-/Mechanismusbegründung.",
            "understandingFocusEn": "Stopped structure and changed chain length require a new functionality/mechanism explanation."
          }
        ]
      },
      "profileJsonPointer": "line:288#/profile"
    },

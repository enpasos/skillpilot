      "wholeCurrentEvidenceProfile": {
        "archetype": "modeling",
        "expectations": [
          {
            "id": "structure-model-reasoning",
            "essentialUnderstandingDe": "Ein Nukleophil bietet ein Elektronenpaar zur neuen Bindung an; das elektrophile C ist Akzeptor und die Abgangsgruppe erhält das alte Bindungselektronenpaar.",
            "essentialUnderstandingEn": "A nucleophile offers an electron pair for a new bond; electrophilic C accepts it and the leaving group receives the old bonding electron pair.",
            "observablePerformanceDe": "Die Person markiert Elektronenpaarquelle, Akzeptor-C und Bindungsänderungen an einem vorgegebenen Substitutionsmodell.",
            "observablePerformanceEn": "The learner marks electron-pair origin, acceptor C and bond changes in a supplied substitution model."
          },
          {
            "id": "fresh-application-and-boundary",
            "essentialUnderstandingDe": "Der Elektronenpaarpfeil beginnt am Paar, nicht an einer positiven Ladung; eine Nettogleichung beweist weder SN1/SN2 noch eine universelle Produktverteilung.",
            "essentialUnderstandingEn": "An electron-pair arrow starts at the pair, not at a positive charge; a net equation establishes neither SN1/SN2 nor universal product distribution.",
            "observablePerformanceDe": "Der Pfeil muss am O-Paar beginnen und zum C führen; das C-Cl-Paar geht zum Cl. Der Donator bleibt OH−, der Akzeptor das halogentragende C, die Abgangsgruppe wird Cl− statt Br−. Die Ladung wird vollständig bilanziert. Ohne kinetische oder strukturelle Zusatzinformation wird aus dem Halogentausch keine sichere Geschwindigkeit oder ein bestimmter Mechanismustyp behauptet.",
            "observablePerformanceEn": "The arrow starts at the O pair and goes to C; the C-Cl pair goes to Cl. OH− remains donor, halogen-bearing C acceptor; Cl− replaces Br− as leaving group. Charge is fully balanced. Without additional kinetic or structural information the halogen change establishes no definite rate or mechanism type."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "structure-model-reasoning",
            "fresh-application-and-boundary"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "material-variation",
            "textDe": "Chlor- versus Bromalkan, Hydroxid- versus vorgegebener neutraler Elektronenpaardonator, Modelle mit festgelegten Bedingungen.",
            "textEn": "Chloro- versus bromoalkane, hydroxide versus supplied neutral electron-pair donor, models with specified conditions."
          },
          {
            "id": "counterexample",
            "textDe": "Der Elektronenpaarpfeil beginnt am Paar, nicht an einer positiven Ladung; eine Nettogleichung beweist weder SN1/SN2 noch eine universelle Produktverteilung.",
            "textEn": "An electron-pair arrow starts at the pair, not at a positive charge; a net equation establishes neither SN1/SN2 nor universal product distribution."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "chem-current15-3899edf4-case-1",
            "taskDemandDe": "Für CH3CH2Br und OH− ist ein Substitutionsfall ausdrücklich vorgegeben. Das O trägt freie Elektronenpaare; die C-Br-Bindung ist zum Br hin polarisiert. Erkläre Donator/Akzeptor und zeichne die beiden Elektronenpaarverschiebungen zum Alkohol und Bromid.",
            "taskDemandEn": "For CH3CH2Br and OH− a substitution case is explicitly specified. O has lone pairs; C-Br is polarized towards Br. Explain donor/acceptor and draw the two electron-pair shifts to alcohol and bromide.",
            "expectedPerformanceDe": "Ein O-Elektronenpaar bildet die C-O-Bindung zum elektrophilen C; das C-Br-Bindungspaar geht zum Br, sodass Br− entsteht. Es folgt CH3CH2Br + OH− → CH3CH2OH + Br− bei erhaltener Ladungsbilanz.",
            "expectedPerformanceEn": "An O lone pair forms C-O at electrophilic C; the C-Br pair goes to Br, forming Br−. This gives CH3CH2Br + OH− → CH3CH2OH + Br− with charge conserved.",
            "understandingFocusDe": "Donator meint hier Elektronenpaardonator, nicht einen Protonenspender.",
            "understandingFocusEn": "Donor here means electron-pair donor rather than proton donor."
          },
          {
            "id": "chem-current15-3899edf4-case-2",
            "taskDemandDe": "Frischer vorgegebener Substitutionsfall: CH3CH2Cl mit OH−. Ein falscher Pfeil beginnt am elektrophilen C und zeigt auf das freie O-Elektronenpaar. Korrigiere den Pfeil und erkläre, welche Paarquelle und Abgangsgruppe trotz Halogentausch gleich bzw. verschieden sind.",
            "taskDemandEn": "Fresh specified substitution case: CH3CH2Cl with OH−. A faulty arrow starts at electrophilic C and points to the O lone pair. Correct the arrow and explain which pair origin and leaving group remain the same or differ after changing the halogen.",
            "expectedPerformanceDe": "Der Pfeil muss am O-Paar beginnen und zum C führen; das C-Cl-Paar geht zum Cl. Der Donator bleibt OH−, der Akzeptor das halogentragende C, die Abgangsgruppe wird Cl− statt Br−. Die Ladung wird vollständig bilanziert.",
            "expectedPerformanceEn": "The arrow starts at the O pair and goes to C; the C-Cl pair goes to Cl. OH− remains donor, halogen-bearing C acceptor; Cl− replaces Br− as leaving group. Charge is fully balanced.",
            "understandingFocusDe": "Ohne kinetische oder strukturelle Zusatzinformation wird aus dem Halogentausch keine sichere Geschwindigkeit oder ein bestimmter Mechanismustyp behauptet.",
            "understandingFocusEn": "Without additional kinetic or structural information the halogen change establishes no definite rate or mechanism type."
          }
        ]
      },

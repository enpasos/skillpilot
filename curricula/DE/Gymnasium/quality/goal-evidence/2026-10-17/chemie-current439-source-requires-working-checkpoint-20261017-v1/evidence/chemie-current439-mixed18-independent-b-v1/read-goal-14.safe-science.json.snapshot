        "expectations": [
          {
            "id": "e1",
            "essentialUnderstandingDe": "Farbstoffproduktion kann Forschung, Skalierung und Absatz der chemischen Industrie verbinden.",
            "essentialUnderstandingEn": "Dye production can connect research, scale-up and markets in the chemical industry.",
            "observablePerformanceDe": "Leitet wirtschaftliche Wirkung aus benannten Daten und Mechanismen ab.",
            "observablePerformanceEn": "Infers economic impact from stated data and mechanisms."
          },
          {
            "id": "e2",
            "essentialUnderstandingDe": "Eine historisch-wirtschaftliche Bewertung braucht Grenzen und Gegenargumente; Korrelation genügt nicht zur Alleinursache.",
            "essentialUnderstandingEn": "Historical economic judgment needs limits and counterarguments; correlation does not establish sole causation.",
            "observablePerformanceDe": "Gewichtet Nutzen und Kosten und begrenzt eine Kausalaussage.",
            "observablePerformanceEn": "Weighs benefits and costs and limits a causal claim."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "e1",

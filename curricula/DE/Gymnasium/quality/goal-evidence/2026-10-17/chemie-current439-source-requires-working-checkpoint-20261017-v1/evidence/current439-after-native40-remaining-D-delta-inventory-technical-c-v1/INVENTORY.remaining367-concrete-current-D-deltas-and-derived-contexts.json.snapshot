    {
      "goalId": "20f92ba0-f7f4-5407-bb96-07e30da9002f",
      "titleDe": "Massenwirkungsgesetz anwenden",
      "full439Position": 245,
      "selectedUniqueOwnerIndexPath": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-current429-fifteen-supported-successor-pages-native-technical-20261016-v1/native-fifteen/resolution-index.json",
      "disjointConcreteInputDeltaMask": [

    {
      "goalId": "95dc0ee5-a0af-5682-af32-d66e36fbeb50",
      "titleDe": "Chemische Fach- und Symbolsprache ebenengerecht verwenden",
      "full439Position": 41,
      "selectedUniqueOwnerIndexPath": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/chemie-b008-current517-source7-normal37-D27-P2-reviewed-inactive-integration-j-technical-20261010-v1/inherited-D13/protected12/resolution-index.json",
      "disjointConcreteInputDeltaMask": [

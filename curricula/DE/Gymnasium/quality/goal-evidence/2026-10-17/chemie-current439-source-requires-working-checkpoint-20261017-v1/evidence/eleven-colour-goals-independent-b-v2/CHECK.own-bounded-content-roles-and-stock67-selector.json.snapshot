        {
          "goalId": "67cd332f-9db7-50e1-87f6-172ef3714300",
          "title": "Molekülgeometrien mit dem EPA-Modell erklären",
          "actualRole": "target"
        }
      ],
      "selectedCards": [
        {
          "id": "chem_bond_001",
          "front": "Bohrsches Energiestufenmodell: Kernidee?",
          "back": "Elektronen befinden sich in bestimmten Energiestufen beziehungsweise Schalen.\n\nÜbergänge zwischen Stufen sind mit Energieaufnahme oder Energieabgabe verbunden.",
          "globalOriginTags": [
            "goal:f5efab9d-2c61-44ea-b36a-87f873b51fd8"
          ],
          "originContext": [
            {
              "goalId": "f5efab9d-2c61-44ea-b36a-87f873b51fd8",
              "title": "Energiestufenmodell und Elektronenverteilung anwenden",
              "description": "Die lernende Person kann das Bohrsche Energiestufenmodell nutzen, Elektronenverteilungen einfacher Atome fachlich korrekt angeben und Ionisierungsenergien als experimentellen Hinweis auf Energiestufen deuten.",
              "actualRole": "target"
            }
          ]
        },
        {
          "id": "chem_bond_002",
          "front": "Valenzstrichschreibweise: Was zeigen Punkte und Striche?",
          "back": "Punkte stehen für Valenzelektronen.\n\nEin Strich steht für ein Elektronenpaar, als Bindungspaar oder freies Elektronenpaar.",
          "globalOriginTags": [
            "goal:e74f5301-70d3-5869-bd3d-79a5763a1718"
          ],
          "originContext": [
            {
              "goalId": "e74f5301-70d3-5869-bd3d-79a5763a1718",
              "title": "Orbitalmodell und Valenzstrichschreibweise anwenden",
              "description": "Die lernende Person kann ein einfaches Orbitalmodell und die Valenzstrichschreibweise nutzen, um Valenzelektronenkonfigurationen von Atomen und Atom-Ionen darzustellen.",
              "actualRole": "target"
            }
          ]
        },
        {
          "id": "chem_bond_003",
          "front": "Mesomerie: Merksatz?",
          "back": "Mesomere Grenzstrukturen haben dieselbe Atomverknüpfung, aber unterschiedliche Elektronenverteilung.\n\nDie reale Struktur ist kein schnelles Umschalten, sondern ein delokalisiertes Zwischenbild.",
          "globalOriginTags": [
            "goal:23533087-89ea-5f29-8ec1-9f2e01197bb6"
          ],
          "originContext": [
            {
              "goalId": "23533087-89ea-5f29-8ec1-9f2e01197bb6",
              "title": "Valenzstrichformeln und Mesomerie aufstellen",
              "description": "Die lernende Person kann mithilfe der Edelgasregel die Bindigkeit von Nichtmetall-Atomen vorhersagen und Valenzstrichformeln von Molekülen sowie ausgewählten Molekül-Ionen unter Einbezug mesomerer Grenzstrukturen aufstellen.",
              "actualRole": "target"
            }
          ]
        },
        {
          "id": "chem_bond_004",
          "front": "EPA-Modell: Grundregel?",
          "back": "Elektronengruppen um ein Zentralatom stoßen sich im EPA-Modell ab und ordnen sich mit möglichst großem Abstand an. Bindungsbereiche und freie Elektronenpaare werden berücksichtigt; eine Mehrfachbindung zählt als eine Gruppe.\n\nDie Molekülgestalt beschreibt die Atompositionen. Freie Elektronenpaare beeinflussen diese Gestalt, sind aber keine Atome.",
          "globalOriginTags": [
            "goal:67cd332f-9db7-50e1-87f6-172ef3714300"
          ],
          "originContext": [
            {
              "goalId": "67cd332f-9db7-50e1-87f6-172ef3714300",
              "title": "Molekülgeometrien mit dem EPA-Modell erklären",
              "description": "Die lernende Person kann den räumlichen Bau einfacher Moleküle mithilfe des Elektronenpaarabstoßungsmodells erklären und mit Lewis- beziehungsweise Valenzstrichdarstellungen verknüpfen.",
              "actualRole": "target"
            }
          ]
        },
        {
          "id": "chem_bond_005",
          "front": "Bindungspolarität vs. Molekülpolarität?",
          "back": "Bindungspolarität folgt aus Elektronegativitätsunterschieden.\n\nMolekülpolarität hängt zusätzlich von der räumlichen Geometrie ab.",
          "globalOriginTags": [
            "goal:747c5777-07d7-51a9-9be3-7d0d6f51d4e2"
          ],
          "originContext": [
            {
              "goalId": "747c5777-07d7-51a9-9be3-7d0d6f51d4e2",
              "title": "Bindungs- und Molekülpolarität ableiten",
              "description": "Die lernende Person kann Elektronegativitätsunterschiede zur Erklärung von Bindungspolaritäten nutzen, daraus mit der Molekülgeometrie die Molekülpolarität ableiten und Elektronendichte- sowie ladungscodierte Oberflächendarstellungen interpretieren.",
              "actualRole": "target"
            }
          ]
        },
        {
          "id": "chem_bond_006",
          "front": "Drei grundlegende Bindungstypen?",
          "back": "Ionenbindung: Anziehung von Ionen\n\nElektronenpaarbindung: gemeinsame Elektronenpaare\n\nMetallbindung: Metallkationen im Elektronengas",
          "globalOriginTags": [
            "goal:448815cc-4127-54b7-96bf-e54b3d2a38c5"
          ],
          "originContext": [
            {
              "goalId": "448815cc-4127-54b7-96bf-e54b3d2a38c5",
              "title": "Bindungstypen sicher erläutern",
              "description": "Die lernende Person kann Metall-, Ionen- und Elektronenpaarbindungen fachlich sicher erläutern.",
              "actualRole": "target"
            }
          ]
        },
        {
          "id": "chem_bond_007",
          "front": "Wichtige zwischenmolekulare Kräfte?",
          "back": "Van-der-Waals-Kräfte, Dipol-Dipol-Wechselwirkungen, Wasserstoffbrücken und Ionen-Dipol-Wechselwirkungen.",
          "globalOriginTags": [
            "goal:eb7537dd-d11b-50e9-a6d7-51a78e96fc4e",
            "goal:f57d53b0-5bdf-5998-81f4-8bfb2fc5bde7"
          ],
          "originContext": [
            {
              "goalId": "eb7537dd-d11b-50e9-a6d7-51a78e96fc4e",
              "title": "Intermolekulare Kräfte vergleichen",
              "description": "Die lernende Person kann Dipolkräfte, Wasserstoffbrücken, Ionen-Dipol-Wechselwirkungen und Van-der-Waals-Kräfte an Beispielen erläutern.",

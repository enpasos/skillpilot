      "goalId": "5904c7bc-e4c8-5476-aad5-c78cd9c19c65",
      "title": "Atomteilchen und Periodensystembegriffe abrufen",
      "requires": [
        {
          "goalId": "e9d74940-1e0e-4511-9718-4851f49ad7a5",
          "title": "Periodensystem zur Strukturdeutung nutzen",
          "actualRole": "target"
        },
        {
          "goalId": "72236f2c-771e-4ab6-933a-e549ee49d15b",
          "title": "Kern-Hülle-Modell und Elementarteilchen beschreiben",
          "actualRole": "target"
        }
      ],
      "selectedCards": [
        {
          "id": "chem_basics_004",
          "front": "Bei Hauptgruppenelementen: Was bedeuten Ordnungszahl, Periode und Hauptgruppe (I–VIII)?",
          "back": "Ordnungszahl = Protonenzahl.\n\nIm einfachen Schalenmodell des Grundzustands gibt die Periode die Zahl besetzter Schalen an.\n\nDie klassische Hauptgruppennummer I–VIII gibt die Zahl der Valenzelektronen an. Ausnahme: Helium steht in Hauptgruppe VIII (moderner Gruppe 18), hat aber nur zwei Außenelektronen.",
          "globalOriginTags": [
            "goal:e9d74940-1e0e-4511-9718-4851f49ad7a5"
          ],
          "originContext": [
            {
              "goalId": "e9d74940-1e0e-4511-9718-4851f49ad7a5",
              "title": "Periodensystem zur Strukturdeutung nutzen",
              "description": "Die lernende Person kann Ordnungsprinzipien des Periodensystems anwenden, Ordnungszahl, Protonenzahl, Hauptgruppen und Valenzelektronenzahl entnehmen und daraus einfache Aussagen über Atome ableiten.",
              "actualRole": "target"
            }
          ]
        },
        {
          "id": "chem_basics_005",
          "front": "Atomare Grundteilchen?",
          "back": "Proton: positiv, im Kern\n\nNeutron: neutral, im Kern\n\nElektron: negativ, in der Hülle",
          "globalOriginTags": [
            "goal:72236f2c-771e-4ab6-933a-e549ee49d15b"
          ],
          "originContext": [
            {
              "goalId": "72236f2c-771e-4ab6-933a-e549ee49d15b",
              "title": "Kern-Hülle-Modell und Elementarteilchen beschreiben",
              "description": "Die lernende Person kann das Rutherford-Streuexperiment als Befund für das Kern-Hülle-Modell einordnen, den Aufbau von Atomen mit dem Kern-Hülle-Modell beschreiben und Protonen, Neutronen sowie Elektronen fachlich einordnen.",
              "actualRole": "target"
            }
          ]
        }
      ]
    },
    {
      "viewId": "de-st-gym-chemistry-lk",
      "goalId": "8afc9ff2-9290-5ff0-96fe-bced78cd7084",
      "title": "Energiestufenmodell: Kernidee abrufen",
      "requires": [
        {
          "goalId": "f5efab9d-2c61-44ea-b36a-87f873b51fd8",
          "title": "Energiestufenmodell und Elektronenverteilung anwenden",
          "actualRole": "target"
        }
      ],
      "selectedCards": [
        {
          "id": "chem_bond_001",
          "front": "Bohrsches Energiestufenmodell: Kernidee?",
          "back": "Elektronen befinden sich in bestimmten Energiestufen beziehungsweise Schalen.\n\nÜbergänge zwischen Stufen sind mit Energieaufnahme oder Energieabgabe verbunden.",
          "globalOriginTags": [
            "goal:f5efab9d-2c61-44ea-b36a-87f873b51fd8"
          ],
          "originContext": [
            {
              "goalId": "f5efab9d-2c61-44ea-b36a-87f873b51fd8",
              "title": "Energiestufenmodell und Elektronenverteilung anwenden",
              "description": "Die lernende Person kann das Bohrsche Energiestufenmodell nutzen, Elektronenverteilungen einfacher Atome fachlich korrekt angeben und Ionisierungsenergien als experimentellen Hinweis auf Energiestufen deuten.",
              "actualRole": "target"
            }
          ]
        }
      ]
    },
    {
      "viewId": "de-st-gym-chemistry-lk",
      "goalId": "6824a504-7a3a-5b42-b351-3b84a521a3fc",
      "title": "EPA-Modell und Molekülpolarität: Grundregeln abrufen",
      "requires": [
        {
          "goalId": "67cd332f-9db7-50e1-87f6-172ef3714300",
          "title": "Molekülgeometrien mit dem EPA-Modell erklären",
          "actualRole": "target"
        },
        {
          "goalId": "747c5777-07d7-51a9-9be3-7d0d6f51d4e2",
          "title": "Bindungs- und Molekülpolarität ableiten",
          "actualRole": "target"
        }
      ],
      "selectedCards": [
        {
          "id": "chem_bond_004",
          "front": "EPA-Modell: Grundregel?",
          "back": "Elektronengruppen um ein Zentralatom stoßen sich im EPA-Modell ab und ordnen sich mit möglichst großem Abstand an. Bindungsbereiche und freie Elektronenpaare werden berücksichtigt; eine Mehrfachbindung zählt als eine Gruppe.\n\nDie Molekülgestalt beschreibt die Atompositionen. Freie Elektronenpaare beeinflussen diese Gestalt, sind aber keine Atome.",
          "globalOriginTags": [
            "goal:67cd332f-9db7-50e1-87f6-172ef3714300"
          ],
          "originContext": [
            {
              "goalId": "67cd332f-9db7-50e1-87f6-172ef3714300",
              "title": "Molekülgeometrien mit dem EPA-Modell erklären",
              "description": "Die lernende Person kann den räumlichen Bau einfacher Moleküle mithilfe des Elektronenpaarabstoßungsmodells erklären und mit Lewis- beziehungsweise Valenzstrichdarstellungen verknüpfen.",
              "actualRole": "target"
            }
          ]
        },
        {
          "id": "chem_bond_005",
          "front": "Bindungspolarität vs. Molekülpolarität?",
          "back": "Bindungspolarität folgt aus Elektronegativitätsunterschieden.\n\nMolekülpolarität hängt zusätzlich von der räumlichen Geometrie ab.",
          "globalOriginTags": [
            "goal:747c5777-07d7-51a9-9be3-7d0d6f51d4e2"
          ],
          "originContext": [
            {
              "goalId": "747c5777-07d7-51a9-9be3-7d0d6f51d4e2",
              "title": "Bindungs- und Molekülpolarität ableiten",
              "description": "Die lernende Person kann Elektronegativitätsunterschiede zur Erklärung von Bindungspolaritäten nutzen, daraus mit der Molekülgeometrie die Molekülpolarität ableiten und Elektronendichte- sowie ladungscodierte Oberflächendarstellungen interpretieren.",
              "actualRole": "target"
            }
          ]
        }
      ]
    },
    {

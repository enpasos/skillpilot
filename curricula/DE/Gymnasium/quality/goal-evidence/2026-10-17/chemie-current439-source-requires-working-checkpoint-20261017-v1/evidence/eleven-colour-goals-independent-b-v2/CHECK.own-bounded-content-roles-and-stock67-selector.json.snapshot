    {
      "viewId": "de-st-gym-chemistry-lk",
      "goalId": "9a078cd0-f73b-5176-b9c0-4dfe842739a5",
      "title": "Symbol-, Molekül- und Verhältnisformel unterscheiden: Begriffe abrufen",
      "requires": [

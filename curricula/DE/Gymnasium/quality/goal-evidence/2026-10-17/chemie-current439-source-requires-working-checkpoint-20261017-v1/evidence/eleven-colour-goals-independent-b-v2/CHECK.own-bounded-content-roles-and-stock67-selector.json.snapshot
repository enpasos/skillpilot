  "memoryContexts": [
    {
      "viewId": "de-bw-gym-chemistry-lk",
      "goalId": "cf423d0f-682f-588b-8c24-688c67d28f7a",
      "title": "Lernkarten - Chemische Grundlagen – Kursauswahl",
      "requires": [
        {
          "goalId": "e7c363d4-e02d-4895-8750-ba62c2eb63fe",
          "title": "Chemische Symbole und Formeln sicher nutzen",
          "actualRole": "target"
        },
        {
          "goalId": "1dc15fa2-fca4-56b0-b5c1-4d215613dde0",
          "title": "Stoffmenge und Einheit Mol nutzen",
          "actualRole": "target"
        }
      ],
      "selectedCards": [
        {
          "id": "chem_basics_002",
          "front": "Nachweise für O₂, H₂ und CO₂?",
          "back": "O₂: Glimmspanprobe\n\nH₂: Knallgasprobe\n\nCO₂: Kalkwasserprobe, Kalkwasser wird trüb",
          "globalOriginTags": [
            "goal:580b3616-f121-5d82-ac6b-fc24f145fbdc"
          ]
        },
        {
          "id": "chem_basics_003",
          "front": "Elementsymbol, Molekülformel, Verhältnisformel?",
          "back": "Elementsymbol: ein Element, zum Beispiel Na\n\nMolekülformel: Teilchenzusammensetzung eines Moleküls, zum Beispiel H₂O\n\nVerhältnisformel: kleinstes Zahlenverhältnis in Ionengittern, zum Beispiel NaCl",
          "globalOriginTags": [
            "goal:e7c363d4-e02d-4895-8750-ba62c2eb63fe"
          ]
        },
        {
          "id": "chem_basics_004",
          "front": "Bei Hauptgruppenelementen: Was bedeuten Ordnungszahl, Periode und Hauptgruppe (I–VIII)?",
          "back": "Ordnungszahl = Protonenzahl.\n\nIm einfachen Schalenmodell des Grundzustands gibt die Periode die Zahl besetzter Schalen an.\n\nDie klassische Hauptgruppennummer I–VIII gibt die Zahl der Valenzelektronen an. Ausnahme: Helium steht in Hauptgruppe VIII (moderner Gruppe 18), hat aber nur zwei Außenelektronen.",
          "globalOriginTags": [
            "goal:e9d74940-1e0e-4511-9718-4851f49ad7a5"
          ]
        },
        {
          "id": "chem_basics_005",
          "front": "Atomare Grundteilchen?",
          "back": "Proton: positiv, im Kern\n\nNeutron: neutral, im Kern\n\nElektron: negativ, in der Hülle",
          "globalOriginTags": [
            "goal:72236f2c-771e-4ab6-933a-e549ee49d15b"
          ]
        },
        {
          "id": "chem_basics_006",
          "front": "Wie entstehen aus neutralen Atomen einfache Kationen und Anionen durch Elektronenübertragung?",
          "back": "Kation: Elektronenabgabe, positiv geladen\n\nAnion: Elektronenaufnahme, negativ geladen",
          "globalOriginTags": [
            "goal:a1632ea9-ca04-4f6a-bed2-06b3aa8d38ca",
            "goal:2d16528c-1424-5999-b3d2-af4593a147fc"
          ]
        },
        {
          "id": "chem_basics_007",
          "front": "Warum leiten Salzlösungen Strom?",
          "back": "In Lösung sind Ionen beweglich.\n\nBewegliche Kationen und Anionen transportieren Ladung.",
          "globalOriginTags": [
            "goal:4285d84a-2c9a-4d51-8250-8bed4daf2d2e",
            "goal:2d16528c-1424-5999-b3d2-af4593a147fc"
          ]
        },
        {
          "id": "chem_basics_008",
          "front": "Stoffmenge $n$: Grundidee und Einheit?",
          "back": "Die Stoffmenge $n$ ist ein Maß für die Anzahl festgelegter Teilchen (z. B. Wasser-Moleküle). Ihre Einheit ist Mol ($\\mathrm{mol}$).\n\n$1\\,\\mathrm{mol}$ enthält genau $6{,}02214076\\cdot10^{23}$ der angegebenen Teilchen.\n\nEs gilt $N=n\\cdot N_A$ mit $N_A=6{,}02214076\\cdot10^{23}\\,\\mathrm{mol}^{-1}$. Die Teilchenzahl $N$ hat die Einheit Eins.",
          "globalOriginTags": [
            "goal:1dc15fa2-fca4-56b0-b5c1-4d215613dde0"
          ]
        },
        {
          "id": "chem_basics_009",
          "front": "Avogadro-Konstante?",
          "back": "$N_A \\approx 6{,}022\\cdot10^{23}\\,\\mathrm{mol}^{-1}$\n\nSie verknüpft Stoffmenge und Teilchenzahl.",
          "globalOriginTags": [
            "goal:e45c0022-ac0d-5c83-b433-5f68655e382f"
          ]
        },
        {
          "id": "chem_basics_010",
          "front": "Molare Masse: Formel?",
          "back": "$M=\\frac{m}{n}$\n\n$M$: molare Masse, $m$: Masse, $n$: Stoffmenge",
          "globalOriginTags": [
            "goal:8a2ad724-df5e-5986-8de9-560ba43caac2"
          ]
        },
        {
          "id": "chem_basics_011",
          "front": "Molares Volumen: Formel?",
          "back": "$V_m=\\frac{V}{n}$\n\nDer Zahlenwert gilt immer nur für festgelegte Bedingungen.",
          "globalOriginTags": [
            "goal:2924f784-5261-54e8-93ee-49ac3b3cd300"
          ]
        },
        {
          "id": "chem_basics_012",
          "front": "pH-Skala: sauer, neutral, alkalisch – für verdünnte wässrige Lösungen bei etwa 25 °C?",
          "back": "Bei etwa $25^\\circ\\mathrm{C}$ gilt als schulischer Richtwert:\n\nSauer: $\\mathrm{pH}<7$; neutral: $\\mathrm{pH}\\approx7$; alkalisch/basisch: $\\mathrm{pH}>7$.\n\nNeutralität bedeutet im verdünnten Modell gleich große Oxonium- und Hydroxidionenkonzentrationen. Der neutrale pH-Wert hängt von der Temperatur ab; die Grenze 7 ist kein temperaturunabhängiges Naturgesetz.",
          "globalOriginTags": [
            "goal:d2ccd1d5-56f7-583f-9724-e97441367f91"
          ]
        },
        {
          "id": "chem_basics_013",
          "front": "Saure und basische Lösung auf Teilchenebene?",
          "back": "Saure Lösung: erhöhte Konzentration an Oxonium-Ionen $H_3O^+$\n\nBasische Lösung: erhöhte Konzentration an Hydroxid-Ionen $OH^-$",
          "globalOriginTags": [
            "goal:fd309753-4d48-5570-a4ec-09dfeb20ff9c"
          ]
        }
      ]
    },
    {
      "viewId": "de-bw-gym-chemistry-lk",

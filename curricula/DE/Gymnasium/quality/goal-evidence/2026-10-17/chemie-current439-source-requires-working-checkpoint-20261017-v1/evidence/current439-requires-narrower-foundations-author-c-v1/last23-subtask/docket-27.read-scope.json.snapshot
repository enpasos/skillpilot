      "applicationCaseBriefs": [
        {
          "id": "three-propanol-classes",
          "taskDemandDe": "Vergleiche Propan-1-ol, Propan-2-ol und 2-Methylpropan-2-ol unter üblichen milden Oxidationsbedingungen. Markiere das H am OH-tragenden C.",
          "taskDemandEn": "Compare propan-1-ol, propan-2-ol, and 2-methylpropan-2-ol under ordinary mild oxidation conditions. Mark H on the OH-bearing carbon.",
          "expectedPerformanceDe": "Die lernende Person ordnet primär, sekundär und tertiär zu; die ersten beiden besitzen das relevante C-H, das tertiäre nicht.",
          "expectedPerformanceEn": "The learner classifies primary, secondary, and tertiary; the first two have the relevant C-H, while the tertiary does not.",
          "understandingFocusDe": "Lokale Struktur erklärt den Unterschied in der üblichen Oxidation.",
          "understandingFocusEn": "Local structure explains the difference in ordinary oxidation."
        },
        {
          "id": "fresh-branched-classification",
          "taskDemandDe": "Neue Strukturkarten zeigen 3-Methylbutan-2-ol und 2-Methylbutan-2-ol. Welches lässt sich unter denselben milden Bedingungen zum Carbonyl oxidieren?",
          "taskDemandEn": "New structure cards show 3-methylbutan-2-ol and 2-methylbutan-2-ol. Which can be oxidized to a carbonyl under the same mild conditions?",
          "expectedPerformanceDe": "Die lernende Person erkennt beim ersten das OH-tragende sekundäre C-H und beim zweiten ein tertiäres C ohne H; sie begrenzt die Aussage auf die vorgegebenen Bedingungen.",
          "expectedPerformanceEn": "The learner identifies a secondary OH-bearing C-H in the first and a tertiary carbon without H in the second, qualifying the conclusion to the stated conditions.",
          "understandingFocusDe": "Verzweigung allein ist kein Ersatz für C-H-Prüfung.",
          "understandingFocusEn": "Branching alone is no substitute for checking C-H."
        }
      ]

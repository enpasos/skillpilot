      "expectations": [
        {
          "id": "b002-858d56e0-core",
          "essentialUnderstandingDe": "Primäre und sekundäre Alkanole besitzen am OH-tragenden C ein H für die übliche Oxidation zu Carbonylverbindungen; tertiären fehlt es, weshalb die analoge milde Oxidation nicht greift.",
          "essentialUnderstandingEn": "Primary and secondary alkanols carry a hydrogen at the OH-bearing carbon for ordinary oxidation to carbonyl compounds; tertiary ones lack it, so the analogous mild oxidation does not occur.",
          "observablePerformanceDe": "Die lernende Person markiert das relevante C-H in gegebenen Strukturen und ordnet primäres, sekundäres und tertiäres Alkanol unter vergleichbaren milden Bedingungen.",
          "observablePerformanceEn": "The learner marks the relevant C-H in supplied structures and classifies primary, secondary, and tertiary alkanols under comparable mild conditions."
        }
      ],
      "coverageExpectations": {

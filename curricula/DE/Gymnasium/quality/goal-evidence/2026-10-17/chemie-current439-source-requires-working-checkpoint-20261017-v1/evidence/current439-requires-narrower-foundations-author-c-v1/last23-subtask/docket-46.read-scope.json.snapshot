    "reviewCriteriaFingerprint": "sha256:4ed61d2a8c7eb84dd13315427d46989b4750f58620481e19023b145935025835",
    "landscapeId": "c436b994-8f44-5134-b9f8-0c9f5d6a5ba0",
    "goalId": "4aa3a130-b517-5ac5-87b2-147fe432cadd",
    "goalFingerprint": "sha256:e66d637f6a24d6598da4d720f9f9cd4308c43541fb974bc6a72d856c6c04acdd",
    "reviewInputFingerprint": "sha256:4e9949d9c5f2c7dcbf7e56404fa2afc2ea96e0bca31eb4219e10787e1c65960f",
    "profileFingerprint": "sha256:9382eb5955f80337e4ab6f3e98f5c73fb8d95bc30f4e193d8fe3b2d8448e06b3",
    "status": "needs_human_review",
    "reviewAuthority": "ai_candidate",
    "reviewedAt": "2026-10-10T11:53:56.152224+00:00",
    "reviewer": "Codex post-seal technical synthesis of genuine current independent A/B and explicitly inherited historical whole science; no third scientific review",
    "reason": "Original complete scientific profile retained exactly. Current paired independent native/source/context A/B reviewed after both FIRST seals. A erhält Fehlerprüfung und erlaubte Schlussfolgerung über erhobene/recherchierte Daten. B konkretisiert Auflösung und Probenbehandlung; neuer Widerspruch ist nur bei zuverlässiger Methode belastbarer Gegenbefund.",
    "evidenceLevel": "E1",
    "maximumClaimScope": "G1",
    "reviewRunIds": [],
    "dissent": [
      "E1/G1 needs_human_review ai_candidate; no human approval, trial or observed learner performance.",
      "Whole-source/course/placement HOLDs remain separate and unchanged."
    ],
    "profile": {
      "archetype": "data",
      "expectations": [
        {
          "id": "adequacy-for-question",
          "essentialUnderstandingDe": "Daten sind nur für eine Fragestellung angemessen, wenn Messprinzip, Probenbedingungen und benötigte Unterscheidung zusammenpassen.",
          "essentialUnderstandingEn": "Data are adequate for a question only when measurement principle, sample conditions and required distinction fit together.",
          "observablePerformanceDe": "Prüft am Farbtest Selektivität/Blank und am Leitfähigkeitsvergleich Temperatur, Ionensorte und Kontrollprobe; trennt Messantwort von Stoffidentifikation.",
          "observablePerformanceEn": "Checks selectivity/blank for the colour test and temperature, ion type and control for the conductivity comparison; separates measurement response from substance identification."
        },
        {
          "id": "bounded-conclusion",
          "essentialUnderstandingDe": "Eine positive Antwort eines kreuzreaktiven Tests beweist keinen eindeutigen Stoff; ein unkontrollierter Temperaturunterschied beweist keine Konzentrationsdifferenz.",
          "essentialUnderstandingEn": "A positive cross-reactive test does not prove a unique substance; an uncontrolled temperature difference does not prove a concentration difference.",
          "observablePerformanceDe": "Begründet unterstützte und nicht unterstützte Aussagen mit X/Y/Blank bzw. A20/A35/B35 und begrenzt die ±3-Streuung auf das gegebene Modell.",
          "observablePerformanceEn": "Justifies supported and unsupported claims using X/Y/blank or A20/A35/B35 and confines ±3 scatter to the supplied model."
        },
        {
          "id": "fresh-validity-check",
          "essentialUnderstandingDe": "Ein ausgeschlossener Störstoff beseitigt nicht alle Unsicherheit; eine neue ungeladene Matrixkomponente kann Ionenbeweglichkeit verändern.",
          "essentialUnderstandingEn": "Excluding one interferent does not remove all uncertainty; a new uncharged matrix component may change ion mobility.",
          "observablePerformanceDe": "Nennt nach Y-Ausschluss weitere relevante Testgrenzen und entwickelt bei Saccharosezugabe einen temperatur- und matrixgleichen Kontroll-/Kalibriervergleich.",
          "observablePerformanceEn": "Names further relevant test limits after excluding Y and develops a temperature- and matrix-matched control/calibration comparison for added sucrose."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "adequacy-for-question",
          "bounded-conclusion",
          "fresh-validity-check"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "interferent-exclusion",
          "textDe": "Ein bekannter Kreuzreaktant entfällt; andere Interferenzen und Nachweisgrenze bleiben zu prüfen.",
          "textEn": "One known cross-reactant is removed; other interferences and detection limit still need checking."
        },
        {
          "id": "matrix-change",
          "textDe": "Temperaturkontrolle wird um Saccharose-/Viskositäts- und Matrixkontrolle erweitert.",
          "textEn": "Temperature control is extended by sucrose/viscosity and matrix control."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "data-validity-test-not-proof",
          "taskDemandDe": "Beurteile Gültigkeit, geeignete Quellen, Blind-/Positivkontrollen und Tragweite von „U enthält X“. Benenne einen Verfahrensfehler und eine geeignete Folgemethode.\nFrische Variation: Wenn Y ausgeschlossen wird, erkläre, welche weiteren Informationen vor einem eindeutigen Nachweis noch fehlen können.",
          "taskDemandEn": "Assess validity, suitable sources, blank/positive controls and the scope of “U contains X”. Identify a procedure error and a suitable follow-up method.\nFresh variation: If Y is excluded, explain what further information may still be missing before unique proof.",
          "expectedPerformanceDe": "Die Blank-/Positivkontrolle zeigt grundsätzliches Testansprechen; Y macht den Test nicht spezifisch. U-Farbe ist ein Hinweis auf eine reagierende Komponente, kein eindeutiger X-Nachweis. S ist für Spezifität relevanter als das verkürzte Etikett H; unbekannte Verdünnung/Erhitzung kann Signal verändern. Eine unabhängig spezifischere Analyse mit dokumentierten Bedingungen ist nötig. Blindproben korrigieren keinen grundsätzlich unspezifischen Reaktionsmechanismus. Weil X/Y hier keine Stoffidentitäten oder Trennmerkmale haben, darf kein benanntes Gerät ungeprüft als X-spezifisch gelten. Akzeptabel ist eine konkrete kontrollierte Wiederholung mit dokumentierter Verdünnung/Temperatur und eine begründete Planung zur Validierung einer ergänzenden Methode an bekannten X-, Y- und Blindproben. Für einen eindeutigen X-Nachweis muss deren Spezifität erst belegt werden; Wiederholung des unspezifischen Tests allein identifiziert X weiterhin nicht.\nFrischer Transfer: Der Ausschluss von Y beseitigt nur den bekannten Kreuzreaktanten Y. Weitere unbekannte Stoffe, Matrix-/pH-/Temperaturbedingungen, Nachweisgrenze, Empfindlichkeit und Störreaktionen bleiben mögliche Grenzen. Eine positive Antwort ist nur bei dokumentiert validierter Selektivität und passenden Probenbedingungen eine starke Stütze für X. Weitere bekannte X-/Nicht-X-Proben, Blank, geeignete Matrixkontrollen und eine für X validierte unabhängige Methode würden die Aussage verstärken. Eine beliebig genannte zweite Apparatur garantiert noch keine Selektivität. Erhitzen oder Verdünnen kann die tatsächliche Probe verändern; ursprüngliche Probenbedingungen erhalten und kenntlich machen. Kein absoluter Nachweis aller unbekannten Möglichkeiten folgt aus Y-Ausschluss.",
          "expectedPerformanceEn": "Blank/positive controls show that the test responds in principle; Y makes it non-specific. U colour indicates a reacting component, not unique proof of X. S is more relevant to specificity than the shortened label H; unknown dilution/heating may alter the signal. An independent more specific analysis under documented conditions is needed. Blanks do not correct an inherently non-specific reaction mechanism. Because X/Y have no identities or discriminating properties here, no named instrument may be presumed X-specific. Accept a concrete controlled repeat with documented dilution/temperature and a justified plan to validate an additional method against known X, Y and blank samples. Its specificity must first be established for unique proof of X; repeating the non-specific test alone still does not identify X.\nFresh transfer: Excluding Y removes only the known cross-reactant Y. Other unknown substances, matrix/pH/temperature conditions, detection limit, sensitivity and interfering reactions remain possible limits. A positive response strongly supports X only with documented validated selectivity and appropriate sample conditions. Further known X/non-X samples, blank, suitable matrix controls and an independent method validated for X would strengthen the claim. Simply naming a second instrument does not guarantee selectivity. Heating or dilution may change the actual sample; retain and label original sample conditions. Excluding Y does not exclude every unknown possibility absolutely.",
          "understandingFocusDe": "Neue Selektivitätsinformation begrenzt den Nachweisanspruch konkret statt ihn absolut zu machen.",
          "understandingFocusEn": "New selectivity information bounds the identification claim concretely rather than making it absolute."
        },
        {
          "id": "data-validity-temperature-confound",
          "taskDemandDe": "Prüfe, welche Folgerung durch Daten getragen wird, welche Störgröße vorliegt und wie ein gültiger Stoffmengenvergleich verbessert werden kann.\nFrische Variation: Plane den Vergleich, wenn Probe B zusätzlich Saccharose enthält; erläutere die Grenze reiner Leitfähigkeitsdaten.",
          "taskDemandEn": "Assess which conclusion the data support, the confounder present and how to improve a valid amount comparison.\nFresh variation: Plan the comparison if B additionally contains sucrose; explain the limit of conductivity-only data.",
          "expectedPerformanceDe": "Die 500-µS/cm-Differenz ist mit Temperatur gekoppelt; Kontrolle A35 liegt innerhalb grober Streuung bei B35. Daten belegen kein Mehr an Salz in B. Gleiche Temperatur, Standards, Wiederholungen und bekannte Kompensation/gleiches Ionensystem sind nötig. Streuungsangabe ist nicht die vollständige Messunsicherheit; selbst temperaturgleiche Leitfähigkeit wäre bei unbekannten Ionensorten keine eindeutige NaCl-Konzentration.\nFrischer Transfer: Saccharose liefert im beschriebenen Modell keine zusätzlichen dissoziierten Ionen, kann aber Lösungsmatrix und Viskosität und damit die Beweglichkeit vorhandener Ionen verändern. Aus κ lässt sich deshalb weder Saccharosemenge noch gesamter gelöster Stoff direkt bestimmen. Bei gleicher Temperatur NaCl-Kontrollen mit/ohne gleiche Saccharosematrix, geeignete Blanks und eine für diese Matrix validierte Konzentrationskalibrierung vergleichen. Die bereits vorgegebenen A35/B35-Werte enthalten keine neue Saccharosemessung. Eine Behauptung höherer NaCl-Konzentration wäre nur innerhalb geprüfter Ionensorte, Temperatur und Matrix zulässig; die ±3-Wiederholstreuung ersetzt keine Gesamtunsicherheit.",
          "expectedPerformanceEn": "The 500-µS/cm difference is confounded by temperature; A35 control lies within rough scatter of B35. Data do not establish more salt in B. Equal temperature, standards, repeats and known compensation/the same ion system are needed. The scatter estimate is not full measurement uncertainty; even equal-temperature conductivity would not uniquely determine NaCl concentration for unknown ion species.\nFresh transfer: Sucrose supplies no additional dissociated ions in the described model but may change solution matrix and viscosity and therefore mobility of existing ions. κ therefore does not directly determine sucrose amount or total dissolved material. At equal temperature compare NaCl controls with/without the same sucrose matrix, suitable blanks and concentration calibration validated for this matrix. The existing A35/B35 values contain no new sucrose measurement. A claim of higher NaCl concentration would be valid only within checked ion type, temperature and matrix; ±3 repeat scatter is not total uncertainty.",
          "understandingFocusDe": "Temperaturkontrolle allein löst bei neuer Matrix nicht alle Konzentrations-Gültigkeitsfragen.",
          "understandingFocusEn": "Temperature control alone does not resolve every concentration-validity question in a new matrix."
        }
      ]
    }
  }
}

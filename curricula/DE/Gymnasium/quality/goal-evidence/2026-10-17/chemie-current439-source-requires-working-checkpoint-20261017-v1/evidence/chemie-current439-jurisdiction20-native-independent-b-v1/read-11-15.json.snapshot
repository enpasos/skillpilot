    "profile": {
      "archetype": "experiment",
      "expectations": [
        {
          "id": "practical-buffer-p1-r1",
          "essentialUnderstandingDe": "Ein fairer Vergleich isoliert Pufferwirkung durch kontrollierte Proben, Dosen und Messbedingungen.",
          "essentialUnderstandingEn": "A fair comparison isolates buffering through controlled samples, doses and measurement conditions.",
          "observablePerformanceDe": "Vergleichsfrage, Kontrollbedingungen und Herstellung sind fachlich begründet.",
          "observablePerformanceEn": "Justify the question, controls and preparation."
        },
        {
          "id": "practical-buffer-p1-r2",
          "essentialUnderstandingDe": "Experimentelle Pufferwirkung verlangt persönlich erhobene Rohdaten und beobachtete Handlungen.",
          "essentialUnderstandingEn": "Experimental buffering requires personally acquired raw data and observed actions.",
          "observablePerformanceDe": "Eigene Messreihen und Handlungen liegen als Rohprotokoll mit Aufsichtsbeobachtung vor.",
          "observablePerformanceEn": "Provide personal raw series and supervisor observation of actions."
        },
        {
          "id": "practical-buffer-p1-r3",
          "essentialUnderstandingDe": "Beide konjugierten Partner fangen unterschiedliche Lasten ab; die Deutung muss zu den eigenen Daten passen.",
          "essentialUnderstandingEn": "The two conjugate partners consume different loads; interpretation must fit personal data.",
          "observablePerformanceDe": "Graphischer Vergleich und beide Reaktionen erklären echte Daten ohne Sollwertersatz.",
          "observablePerformanceEn": "Plots and both reactions explain actual data without target substitution."
        },
        {
          "id": "practical-buffer-p1-r4",
          "essentialUnderstandingDe": "Beobachtete Wirkung bleibt an endliche Dosen und Bedingungen gebunden.",
          "essentialUnderstandingEn": "Observed action remains bounded by finite doses and conditions.",
          "observablePerformanceDe": "Schlussfolgerungen bleiben auf endliche Dosen begrenzt und trennen Beobachtung von Kapazitätsdesign.",
          "observablePerformanceEn": "Limit conclusions to finite doses and distinguish observations from capacity design."
        }
      ],

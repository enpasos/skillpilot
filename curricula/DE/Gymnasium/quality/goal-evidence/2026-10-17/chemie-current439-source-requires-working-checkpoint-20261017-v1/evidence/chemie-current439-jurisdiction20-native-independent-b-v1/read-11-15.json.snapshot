      "externalReverseRequires": [],
      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Emission und Absorption zur Farbigkeit unterscheiden",
        "url": "/assets/goal-visualizations/chemie/54bc6ca0-b770-5f10-ac54-bcc1d04298f5/54bc6ca0-b770-5f10-ac54-bcc1d04298f5.jpg",
        "altText": "Didaktische Visualisierung zum Lernziel \"Emission und Absorption zur Farbigkeit unterscheiden\". Die lernende Person kann zwischen Emission und Absorption verschiedener Lichtwellenlängen unterscheiden und damit Ursachen von Farbigkeit beschreiben.",
        "originalDigest": "sha256:2650a8699fa9f948f21c649b9c68ea1d6212f0f9d9dbcb7f8f8990c7b9b2040b",
        "qaStatus": "review_candidate",
        "approvedForPublication": false
      }
    },
    "profile": {
      "archetype": "concept",
      "expectations": [
        {
          "id": "e1",
          "essentialUnderstandingDe": "Emission gibt Photonen ab; Absorption entzieht der einfallenden Strahlung bestimmte Wellenlängen.",
          "essentialUnderstandingEn": "Emission releases photons; absorption removes particular wavelengths from incident light.",
          "observablePerformanceDe": "Unterscheidet Energiefluss und Spektrensignal.",
          "observablePerformanceEn": "Distinguishes energy flow and spectral signals."
        },
        {
          "id": "e2",
          "essentialUnderstandingDe": "Beobachtete Farbe hängt von der austretenden Strahlung und Beleuchtung ab.",
          "essentialUnderstandingEn": "Observed color depends on outgoing radiation and illumination.",
          "observablePerformanceDe": "Leitet Farbe in einer veränderten Beleuchtungssituation ab.",
          "observablePerformanceEn": "Predicts color under changed illumination."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "e1",
          "e2"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "v1",
          "textDe": "Selbstleuchten versus beleuchtetes Material",
          "textEn": "Self-emission versus illuminated material"
        },
        {
          "id": "v2",
          "textDe": "Lichtquelle und Filter",
          "textEn": "Light source and filter"
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "54bc6ca0-case-1",
          "taskDemandDe": "Idealisiert: Eine LED sendet im Dunkeln Licht bei 470 nm aus. Eine nicht fluoreszierende klare Lösung absorbiert aus weißem Licht vor allem 450–490 nm und lässt längere sichtbare Wellenlängen passieren.\n1. Ordne beide Vorgänge Emission oder Absorption zu und beschreibe die Richtung des Energieübergangs zwischen Materie und Licht.\n2. Erkläre die blaue LED-Farbe und die näherungsweise gelbe Durchsichtfarbe der Lösung; sage begründet voraus, ob die Lösung im Dunkeln selbst leuchtet.",
          "taskDemandEn": "Idealized: an LED emits 470 nm light in darkness. A clear nonfluorescent solution absorbs mostly 450–490 nm from white light and transmits longer visible wavelengths.\n1. Classify both processes as emission or absorption and describe energy transfer between matter and light.\n2. Explain the blue LED color and approximate yellow transmitted color of the solution; predict with reasons whether it glows in darkness.",
          "expectedPerformanceDe": "1. Die LED emittiert: angeregte Materie gibt Energie als Photon ab. Die Lösung absorbiert: eingestrahlte Photonen übertragen Energie an Moleküle. Absorbierte blaue Photonen sind kein blaues Emissionssignal.\n2. 470 nm wird als blau wahrgenommen. Die Lösung entzieht dem weißen Licht den Blauanteil; durchgelassene Anteile ergeben näherungsweise gelb. Ohne Beleuchtung fehlt eingestrahltes Licht; bei ausgeschlossener Fluoreszenz und eigener Anregung leuchtet sie nicht.",
          "expectedPerformanceEn": "1. The LED emits: excited matter releases energy as photons. The solution absorbs: incoming photons transfer energy to molecules. Absorbed blue photons are not a blue emission signal.\n2. 470 nm is perceived as blue. The solution removes blue from white light; transmitted components appear approximately yellow. Without illumination there is no incident light; with fluorescence and independent excitation excluded it does not glow.",
          "understandingFocusDe": "Die LED emittiert: angeregte Materie gibt Energie als Photon ab. Die Lösung absorbiert: eingestrahlte Photonen übertragen Energie an Moleküle. Absorbierte blaue Photonen sind kein blaues Emissionssignal. / 470 nm wird als blau wahrgenommen. Die Lösung entzieht dem weißen Licht den Blauanteil; durchgelassene Anteile ergeben näherungsweise gelb. Ohne Beleuchtung fehlt eingestrahltes Licht; bei ausgeschlossener Fluoreszenz und eigener Anregung leuchtet sie nicht.",
          "understandingFocusEn": "The LED emits: excited matter releases energy as photons. The solution absorbs: incoming photons transfer energy to molecules. Absorbed blue photons are not a blue emission signal. / 470 nm is perceived as blue. The solution removes blue from white light; transmitted components appear approximately yellow. Without illumination there is no incident light; with fluorescence and independent excitation excluded it does not glow."
        },
        {
          "id": "54bc6ca0-case-2",
          "taskDemandDe": "Modell: Eine Quelle emittiert nur 630 nm. Ein Filter lässt 520–560 nm passieren, absorbiert aber 630 nm vollständig; er fluoresziert nicht. Danach wird die rote Quelle durch eine 540-nm-Quelle ersetzt.\n1. Unterscheide den Emissionsvorgang der Quelle vom Absorptionsvorgang des Filters und erkläre, ob der Filter aus rotem Licht grünes Licht erzeugt.\n2. Leite die Beobachtung hinter dem Filter für beide Quellen aus den Wellenlängenbereichen ab.",
          "taskDemandEn": "Model: a source emits only 630 nm. A filter transmits 520–560 nm but completely absorbs 630 nm and does not fluoresce. The red source is then replaced by a 540 nm source.\n1. Distinguish emission by the source from absorption by the filter and explain whether the filter produces green light from red light.\n2. Predict the observation behind the filter for both sources using the wavelength ranges.",
          "expectedPerformanceDe": "1. Die Quelle sendet Photonen ihrer vorgegebenen Wellenlänge aus. Der Filter nimmt Energie der 630-nm-Photonen auf; er erzeugt nach den Vorgaben keine 540-nm-Photonen. „Grün“ bedeutet hier Durchlassen, keine Farbkonversion.\n2. Mit 630 nm erscheint die Durchsicht dunkel, da die einzige eingestrahlte Wellenlänge absorbiert wird. Mit 540 nm erscheint sie grün, weil diese Wellenlänge im Durchlassbereich liegt.",
          "expectedPerformanceEn": "1. The source emits photons at its specified wavelength. The filter takes up energy from 630 nm photons; under the conditions given it produces no 540 nm photons. “Green” describes transmission, not conversion.\n2. With 630 nm the transmitted view is dark because the only incident wavelength is absorbed. With 540 nm it appears green because that wavelength lies in the passband.",
          "understandingFocusDe": "Die Quelle sendet Photonen ihrer vorgegebenen Wellenlänge aus. Der Filter nimmt Energie der 630-nm-Photonen auf; er erzeugt nach den Vorgaben keine 540-nm-Photonen. „Grün“ bedeutet hier Durchlassen, keine Farbkonversion. / Mit 630 nm erscheint die Durchsicht dunkel, da die einzige eingestrahlte Wellenlänge absorbiert wird. Mit 540 nm erscheint sie grün, weil diese Wellenlänge im Durchlassbereich liegt.",
          "understandingFocusEn": "The source emits photons at its specified wavelength. The filter takes up energy from 630 nm photons; under the conditions given it produces no 540 nm photons. “Green” describes transmission, not conversion. / With 630 nm the transmitted view is dark because the only incident wavelength is absorbed. With 540 nm it appears green because that wavelength lies in the passband."
        }
      ]
    }

      "variationAxes": [
        {
          "id": "load-direction-control",
          "textDe": "Säure- und Basenzugaben an getrennten Puffer- und Wasserportionen vergleichen.",
          "textEn": "Compare acid/base additions in separate buffer and water portions."
        },
        {
          "id": "dose-and-evidence",
          "textDe": "Endliche Dosen und tatsächliche Beobachtungen statt unbegrenzter Pufferbehauptung prüfen.",

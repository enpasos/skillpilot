      "externalPrerequisites": [
        {
          "goalId": "a9c22adc-b543-5b0c-a2d8-3189facdff08",
          "title": "Warum Chemie? - Relevanz und Orientierung",
          "canonicalUrl": "https://skillpilot.com/lernzielbuch?landscape=c436b994-8f44-5134-b9f8-0c9f5d6a5ba0&edition=curricular-atomic-v1#goal-a9c22adc-b543-5b0c-a2d8-3189facdff08"

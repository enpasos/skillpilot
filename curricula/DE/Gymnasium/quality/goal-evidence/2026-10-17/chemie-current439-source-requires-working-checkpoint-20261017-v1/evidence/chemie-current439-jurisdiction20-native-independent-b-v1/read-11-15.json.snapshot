      "visualization": {
        "resourceType": "image",
        "title": "Visualisierung: Faraday-Gesetze qualitativ erklären",
        "url": "/assets/goal-visualizations/chemie/0e3f849b-133d-57da-882c-0d67c3eb05b8/0e3f849b-133d-57da-882c-0d67c3eb05b8.png",
        "altText": "Qualitatives Vergleichsmodell ohne Nebenreaktionen: Bei demselben Metallionentyp bewirkt mehr für die Metallabscheidung genutzte Ladung mehr abgeschiedenen Stoff. Bei gleicher Ladung unterscheiden sich Silber- und Kupferabscheidung durch die benötigte Elektronenzahl; für einen Massenvergleich zählt zusätzlich die molare Masse. Keine eingesetzten Strom-, Zeit-, Ladungs- oder Massenwerte.",
        "originalDigest": "sha256:3021201619f84a95ade04354a0a82abdb5e1e9cfcb1a97d9c176db37830bdbdf",
        "qaStatus": "review_candidate",
        "approvedForPublication": false
      }
    },
    "profile": {
      "archetype": "concept",
      "expectations": [
        {
          "id": "same-reaction-charge-conversion",
          "essentialUnderstandingDe": "Für denselben vollständig spezifizierten Elektrodenprozess bestimmt die tatsächlich für ihn genutzte Ladung über die Elektronenübertragung den Stoff- und Massenumsatz.",
          "essentialUnderstandingEn": "For the same specified electrode process, reaction-specific charge determines amount and mass converted through electron transfer.",
          "observablePerformanceDe": "Begründet die A/B-Ladungsfolge und den gleichen A/C-Umsatz trotz verschiedener Stromverläufe; benennt Stoffidentität, ausreichenden Ionenvorrat und vollständige Stromausbeute.",
          "observablePerformanceEn": "Justifies the A/B charge ordering and equal A/C conversion despite different current histories, stating substance identity, sufficient ions and complete current efficiency."
        },
        {
          "id": "electron-number-amount-mass",
          "essentialUnderstandingDe": "Bei gleicher relevanter Ladung hängt die Stoffmenge vom Elektronenbedarf je Produktteilchen ab; die Produktmasse hängt zusätzlich von der molaren Masse ab.",
          "essentialUnderstandingEn": "At equal relevant charge, product amount depends on electrons needed per particle; product mass additionally depends on molar mass.",
          "observablePerformanceDe": "Vergleicht Cu/Ni bei gleichem Elektronenbedarf nach gleicher Stoffmenge und verschiedener Masse, erklärt Ag/Cu mit getrennten Elektronen-/Massenargumenten und überträgt auf Zn/Cu.",
          "observablePerformanceEn": "Compares equal Cu/Ni amounts but different masses at equal electron requirement, explains Ag/Cu using separate electron and mass arguments and transfers to Zn/Cu."
        },
        {
          "id": "qualitative-law-model-limits",
          "essentialUnderstandingDe": "Die Gesetze beziehen sich auf den angegebenen Elektrodenumsatz. Spannung oder sichtbarer Strom allein bestimmen keine Produktmasse; Nebenreaktionen teilen den relevanten Ladungsanteil.",
          "essentialUnderstandingEn": "The laws concern the specified electrode conversion. Voltage or visible current alone does not determine product mass; competing reactions partition the relevant charge.",
          "observablePerformanceDe": "Erklärt den frischen Wasserstoff-Nebenreaktionsfall ohne Widerspruch zum Gesetz und widerlegt gleiche Ladung bedeute für beliebige Metalle gleiche Masse. Rechnet keine Strom-, Zeit-, Ladungs- oder Massenwerte.",
          "observablePerformanceEn": "Explains the fresh competing-hydrogen case without contradicting the law and rejects equal charge implying equal mass across metals. Performs no numerical current, time, charge or mass calculation."
        }
      ],
      "coverageExpectations": {
        "requiredExpectationIds": [
          "same-reaction-charge-conversion",
          "electron-number-amount-mass",
          "qualitative-law-model-limits"
        ],
        "alternativeExpectationGroups": [],
        "minimumIndependentDemonstrations": 2,
        "freshVariationRequired": true,
        "independentTransferRequired": true
      },
      "variationAxes": [
        {
          "id": "charge-and-current-history",
          "textDe": "Gleicher Kupferprozess: kürzere/längere Dauer bei gleichem Strom, andere Stromgeschichte bei gleicher Gesamtladung und neue Nebenreaktion.",
          "textEn": "Same copper process: shorter/longer time at fixed current, a different current history at equal total charge and a fresh competing reaction."
        },
        {
          "id": "metal-electron-demand-and-molar-mass",
          "textDe": "Ag+, Cu2+, Ni2+ und frisches Zn2+ trennen Elektronenbedarf, Stoffmenge und molare Masse ohne numerische Substitution.",
          "textEn": "Ag+, Cu2+, Ni2+ and fresh Zn2+ separate electron requirement, amount and molar mass without numerical substitution."
        }
      ],
      "applicationCaseBriefs": [
        {
          "id": "faraday-qualitative-case-1-charge-same-copper-process",
          "taskDemandDe": "Eigenes fiktives Papiermodell, kein Versuch/Messwert. Cu2+ + 2 e− → Cu; geeignete Elektroden, ausreichende Ionen, gesamte betrachtete Ladung wird für Kupfer genutzt, keine Verluste/Nebenreaktionen. A: konstanter Strom kurz; B: gleicher Strom länger; C: andere Stromgeschichte, aber dieselbe Gesamtladung wie A. Ohne Zahlen: Ordne A/B nach Ladung, Teilchenzahl, Stoffmenge und Kupfermasse; begründe die Elektronenkette. Vergleiche C/A und formuliere den ersten Zusammenhang. Prüfe die Behauptung, höhere Spannung allein bedeute immer mehr Metall. Frischer Transfer: gleicher Ladungszählerstand, aber ein Anteil der Elektronen bildet Wasserstoff; erkläre weniger Kupfer ohne Gesetzeswiderspruch. Ganze Materialien/Lösung/10-P-Rubrik stehen exakt in author-qualitative-faraday/two-whole-qualitative-material-cases.author-draft.json.",
          "taskDemandEn": "Own fictional paper model, no experiment or measured data. Cu2+ + 2 e− → Cu; suitable electrodes, sufficient ions, all specified charge deposits copper, no losses or competing reactions. A: fixed current for a shorter time; B: same current longer; C: different current history but the same total charge as A. Without numbers, compare A/B charge, particle count, amount and copper mass, explaining electron transfer. Compare C/A and state the first relationship. Assess higher voltage alone always meaning more metal. Fresh transfer: equal counted charge but some electrons now form hydrogen; explain less copper without contradicting the law. Whole material/solution/10-point rubric: author-qualitative-faraday/two-whole-qualitative-material-cases.author-draft.json.",
          "expectedPerformanceDe": "B nutzt mehr Ladung/Elektronen als A und bildet mehr Cu-Teilchen, Stoffmenge und Masse. C/A ergeben beim selben Prozess und gleicher relevanter Ladung gleiche Cu-Teilchenzahl, Stoffmenge und Masse, unabhängig vom zeitlichen Stromverlauf. Spannung oder ein sichtbarer Betriebsstrom allein liefern die integrierte, tatsächlich für Kupfer genutzte Ladung nicht. Nebenreaktionen vermindern bei gleicher Gesamtladung den Kupferanteil; maßgeblich ist dessen Reaktionsladung. Kein Widerspruch und keine Versuchsbeobachtung. Rubrik /10: Ladung→Elektronen→Cu-Kette2; vier Größen richtig geordnet2; C/A und erster Zusammenhang2; Spannung/Modellgrenzen2; frischer Nebenreaktionstransfer2. Ganze Einzelkriterien bleiben im Material.",
          "expectedPerformanceEn": "B uses more charge/electrons than A and produces more Cu particles, amount and mass. C/A produce equal Cu particle counts, amounts and masses for the same process and relevant charge, regardless of current history. Voltage or visible operating current alone does not give integrated charge actually used for copper. Competing reactions reduce the copper share at equal total charge; reaction-specific charge matters. No contradiction or experimental observation. Rubric /10: charge/electron/Cu chain2; correct ordering of four quantities2; C/A and first relationship2; voltage/model limits2; fresh competing-reaction transfer2. Full individual criteria remain in the material.",
          "understandingFocusDe": "Erster Zusammenhang einschließlich frischer Stromausbeutegrenze. Zwei unabhängige Nachweisschritte können innerhalb einer Leistung liegen; die zwei Fälle sind keine Pflichtaufgabenquote. Prüfung endet, sobald alle Aspekte und eigenständiger Transfer ausreichend gezeigt sind.",
          "understandingFocusEn": "First relationship including a fresh current-efficiency boundary. Two independent evidence steps may occur within one performance; two case variants are not a mandatory quota. Stop when all aspects and independent transfer are sufficiently established."
        },
        {
          "id": "faraday-qualitative-case-2-electrons-amount-and-mass",
          "taskDemandDe": "Eigenes ideales Papiermodell mit gleicher vollständig für die Metallreaktion genutzter Ladung, geeigneten Elektrolyten/Elektroden und ausreichend Ionen: Ag+ + e− → Ag; Cu2+ + 2 e− → Cu; Ni2+ + 2 e− → Ni. Qualitativ vorgegeben M(Ag)>M(Cu)>M(Ni), keine Zahlen. Vergleiche Cu/Ni nach Teilchenzahl, Stoffmenge und Masse. Vergleiche Ag/Cu getrennt nach Elektronenbedarf und molarer Masse. Formuliere den zweiten Zusammenhang und erkläre, warum Ionladungszahl allein keine allgemeine Massenrangfolge ergibt. Frischer Transfer Zn2+/Cu2+ mit gleichem Elektronenbedarf und vorgegeben M(Zn)>M(Cu): Prüfe gleiche Stoffmenge UND gleiche Masse getrennt. Ganze Ausarbeitung/10-P-Rubrik: author-qualitative-faraday/two-whole-qualitative-material-cases.author-draft.json.",
          "taskDemandEn": "Own ideal paper model at equal charge entirely used for the metal reaction, suitable systems and sufficient ions: Ag+ + e− → Ag; Cu2+ + 2 e− → Cu; Ni2+ + 2 e− → Ni. Supplied qualitative order M(Ag)>M(Cu)>M(Ni), no values. Compare Cu/Ni counts, amounts and masses. Compare Ag/Cu separately using electron requirement and molar mass. State the second relationship and explain why ion charge alone gives no general mass ranking. Fresh Zn2+/Cu2+ transfer at equal electron requirement and supplied M(Zn)>M(Cu): assess equal amount AND equal mass separately. Whole solution/10-point rubric: author-qualitative-faraday/two-whole-qualitative-material-cases.author-draft.json.",
          "expectedPerformanceDe": "Cu/Ni brauchen je Teilchen gleich viele Elektronen, deshalb gleiche Teilchenzahl/Stoffmenge; Cu hat wegen größerer molarer Masse die größere Masse. Ag braucht weniger Elektronen je Teilchen als Cu, daher größere Stoffmenge; zusätzlich ist M(Ag) größer, daher hier größere Silbermasse. Allgemein wirken molare Masse und Elektronenbedarf gemeinsam: bei sonst gleichem Faktor erhöht größere molare Masse den Massenumsatz, größerer Elektronenbedarf vermindert ihn. Zn/Cu: gleiche Stoffmenge, aber größere Zinkmasse. Ionenladungszahl allein liefert keine beliebige Massenrangfolge. Keine Zahlenrechnung. Rubrik /10: Cu/Ni-Gleichheit2; Massenunterschied2; Ag/Cu mit getrennten Argumenten2; gemeinsamer zweiter Zusammenhang2; neuer Zn-Transfer2.",
          "expectedPerformanceEn": "Cu/Ni need equal electrons per particle, hence equal counts/amounts; Cu has greater mass because of greater molar mass. Ag needs fewer electrons per particle than Cu, hence greater amount; its supplied greater molar mass additionally gives greater silver mass here. In general molar mass and electron requirement act jointly: at fixed other factor, greater molar mass raises mass converted while greater electron requirement lowers it. Zn/Cu have equal amounts but greater zinc mass. Ion charge alone gives no universal mass ranking. No numerical calculation. Rubric /10: equal Cu/Ni amounts2; mass distinction2; separate Ag/Cu arguments2; joint second relationship2; fresh Zn transfer2.",
          "understandingFocusDe": "Zweiter Zusammenhang, Stoffmenge/Masse und unabhängiger Metallaustauschtransfer. Ein Schlagwort oder Kartenabruf reicht nicht; keine weitere Aufgabenquote bei bereits ausreichendem Verständnis.",
          "understandingFocusEn": "Second relationship, amount/mass distinction and independent metal-change transfer. A slogan or card recall is insufficient; no extra-task quota after sufficient understanding."
        }
      ]
    }
  },

    "formerPrerequisiteAncestorComponentsToInspect": [
      {
        "goalId": "018bec90-445f-4a88-b8bc-228f8335dee6",
        "title": "Leitfähigkeit von Stoffen vergleichen",
        "description": "Die lernende Person kann feste, flüssige und gelöste Stoffe im Hinblick auf elektrische Leitfähigkeit vergleichen und Leiter sowie Nichtleiter fachlich unterscheiden."
      },
      {
        "goalId": "1351706f-4ea6-56e9-951b-87b24cbcdee8",
        "title": "Lösungen nach Arbeitsanweisung herstellen",
        "description": "Die lernende Person kann mit zugelassenen Stoffen und einer bereitgestellten Arbeitsanweisung eine homogene Lösung herstellen und die ausgeführten Arbeitsschritte sowie das Ergebnis dokumentieren."
      },
      {
        "goalId": "1bdaf7f2-ff3b-455a-a7fb-95a44642762a",
        "title": "Massenerhaltung bei Reaktionen erklären",
        "description": "Die lernende Person kann einfache Massenbilanz-Versuche auswerten und das Gesetz von der Erhaltung der Masse fachlich erklären."
      },
      {
        "goalId": "266a2b2a-9ee2-52f6-ae09-59343da9a60b",
        "title": "Arbeitsweisen der Chemie anwenden",
        "description": "Cluster für grundlegende chemische Laborarbeitsweisen und allgemeine Sicherheitsregeln in der Sekundarstufe I."
      },
      {
        "goalId": "326d45bf-9f77-57d5-a054-93e76b034dd5",
        "title": "Aggregatzustände und Übergänge deuten",
        "description": "Die lernende Person kann feste, flüssige und gasförmige Zustände anhand beobachtbarer Eigenschaften unterscheiden und Übergänge zwischen ihnen als Zustandsänderungen desselben Stoffes erklären."
      },
      {
        "goalId": "416dfd33-8b43-5c49-903c-9847b95e4208",
        "title": "Grundlegende Laborarbeitsweisen anwenden",
        "description": "Die lernende Person kann grundlegende chemische Laborarbeitsweisen sachgerecht ausführen und Beobachtungen geordnet dokumentieren."
      },
      {
        "goalId": "4aa3a130-b517-5ac5-87b2-147fe432cadd",
        "title": "Die Aussagekraft chemischer Daten beurteilen",
        "description": "Die lernende Person kann die Angemessenheit, Gültigkeit und Tragweite erhobener oder recherchierter chemischer Daten beurteilen, mögliche Mess- und Verfahrensfehler anhand der Untersuchungsbedingungen begründen und erklären, welche Schlussfolgerungen die Daten tragen und welche nicht."
      },
      {
        "goalId": "5a709938-e0f5-42b7-94f0-cfded08963a2",
        "title": "Stoffgemische mit Trennverfahren trennen",
        "description": "Die lernende Person kann Stoffgemische mit Verfahren wie Filtration, Destillation und Extraktion trennen und die Verfahrenswahl begründen."
      },
      {
        "goalId": "67cd332f-9db7-50e1-87f6-172ef3714300",
        "title": "Molekülgeometrien mit dem EPA-Modell erklären",
        "description": "Die lernende Person kann den räumlichen Bau einfacher Moleküle mithilfe des Elektronenpaarabstoßungsmodells erklären und mit Lewis- beziehungsweise Valenzstrichdarstellungen verknüpfen."
      },
      {
        "goalId": "72236f2c-771e-4ab6-933a-e549ee49d15b",
        "title": "Kern-Hülle-Modell und Elementarteilchen beschreiben",
        "description": "Die lernende Person kann das Rutherford-Streuexperiment als Befund für das Kern-Hülle-Modell einordnen, den Aufbau von Atomen mit dem Kern-Hülle-Modell beschreiben und Protonen, Neutronen sowie Elektronen fachlich einordnen."
      },
      {
        "goalId": "7d9fcc7f-1c20-5d5b-9cf6-05f6b624dab6",
        "title": "Chemische Daten auswerten und auf Hypothesen beziehen",
        "description": "Die lernende Person kann erhobene oder recherchierte chemische Daten in geeigneten Tabellen oder Diagrammen auswerten, erkennbare Trends und Beziehungen erläutern und begründen, inwiefern die Daten die Ausgangshypothese stützen oder ihr widersprechen."
      },
      {
        "goalId": "8d4ef102-e6a6-4d2e-bb6b-e707d3f2e566",
        "title": "Chemische Reaktionen von physikalischen Vorgängen unterscheiden",
        "description": "Die lernende Person kann chemische Reaktionen anhand neu entstehender Stoffe von physikalischen Vorgängen unterscheiden und Beobachtungen wie Temperatur- oder Farbänderungen als mögliche, allein nicht beweiskräftige Hinweise einordnen."
      },
      {
        "goalId": "92c99237-1c74-54fc-bf08-9191656afaa6",
        "title": "Moleküldarstellungen situationsgerecht umwandeln",
        "description": "Die lernende Person kann auf Grundlage ausreichender Strukturinformationen verschiedene Formeldarstellungen von Molekülen ineinander überführen und situationsgerecht eine geeignete Darstellung auswählen."
      },
      {
        "goalId": "95dc0ee5-a0af-5682-af32-d66e36fbeb50",
        "title": "Chemische Fach- und Symbolsprache ebenengerecht verwenden",
        "description": "Die lernende Person kann zwischen Alltags- und Fachsprache übersetzen, Stoff- und Teilchenebene unterscheiden sowie Nomenklatur, Symbole und Formelsprache zur Beschreibung von Atomen, Molekülen, Ionen, Teilchenänderungen und Wechselwirkungen sachgerecht nutzen."
      },
      {
        "goalId": "9fc800d1-92d1-5ef6-81c1-33960ae034dd",
        "title": "Chemische Daten nachvollziehbar dokumentieren",
        "description": "Die lernende Person kann experimentell erhobene oder recherchierte chemische Daten strukturiert und nachvollziehbar dokumentieren, Größen und Einheiten, Herkunft und relevante Untersuchungsbedingungen angeben sowie beobachtende Beschreibung und deutende Erklärung unterscheiden."
      },
      {
        "goalId": "e0d05c36-eaac-4c75-8ead-3fd5bdafefca",
        "title": "Konstante Massenverhältnisse beschreiben",
        "description": "Die lernende Person kann konstante Massenverhältnisse an einfachen Oxid- und Sulfidbildungen erkennen und fachlich beschreiben."
      },
      {
        "goalId": "f5efab9d-2c61-44ea-b36a-87f873b51fd8",
        "title": "Energiestufenmodell und Elektronenverteilung anwenden",
        "description": "Die lernende Person kann das Bohrsche Energiestufenmodell nutzen, Elektronenverteilungen einfacher Atome fachlich korrekt angeben und Ionisierungsenergien als experimentellen Hinweis auf Energiestufen deuten."
      },
      {
        "goalId": "fcc73fb5-7413-557f-aea3-b9692a66ee75",
        "title": "Stoffe und Eigenschaften beschreiben",
        "description": "Die lernende Person kann Stoffe anhand von Eigenschaftsmerkmalen beschreiben und ordnen."
      }
    ],

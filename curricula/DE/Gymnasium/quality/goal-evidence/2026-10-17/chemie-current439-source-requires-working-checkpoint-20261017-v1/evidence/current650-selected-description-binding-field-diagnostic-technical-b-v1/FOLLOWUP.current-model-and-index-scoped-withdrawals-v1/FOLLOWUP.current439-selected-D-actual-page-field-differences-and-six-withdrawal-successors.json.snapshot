      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "efficacy-and-dose-conditional",
                "essentialUnderstandingDe": "Sorbinsäure steht mit Sorbat in einem pH-abhängigen Säure-Base-Gleichgewicht. Bereitgestellte Reaktions- und Wirkungsdaten begründen die mögliche Mikroorganismenhemmung unter passenden Bedingungen; der undissoziierte Anteil und die Lebensmittelmatrix sind zu beachten. Dies ist keine allgemeine Haltbarkeits- oder Sicherheitsgarantie.",
                "essentialUnderstandingEn": "Sorbic acid and sorbate form a pH-dependent acid-base equilibrium. Supplied reaction and efficacy data explain possible microorganism inhibition under suitable conditions; the undissociated fraction and food matrix matter. This is not a general shelf-life or safety guarantee.",
                "observablePerformanceDe": "Die Wirkweise mit dem bereitgestellten Reaktionsmodell und den Wirkungsdaten erläutern, den pH-/Matrixbezug erklären und die konkrete Dosierung sowie Aussagegrenzen begründen.",
                "observablePerformanceEn": "Explain the mode of action using the supplied reaction model and efficacy data, explain the pH/matrix context, and justify the specific dosage and limits."
              },
              {
                "id": "dated-category-and-combined-limit",
                "essentialUnderstandingDe": "Eine datierte Verwendungsbedingung gilt für die angegebene Lebensmittelkategorie, Zusatzstoffgruppe, Mengenbasis und Einschränkungen. Ein körpergewichtsbezogener ADI ist keine zulässige Lebensmittelkonzentration; ein allgemeines Saftbild belegt keine Zulassung.",
                "essentialUnderstandingEn": "A dated condition of use applies to its stated food category, additive group, quantity basis and restrictions. A body-weight-related ADI is not an authorised food concentration; a generic juice picture does not establish authorisation.",
                "observablePerformanceDe": "Die bereitgestellte datierte Originalregel mit Kategorie und Fußnoten anwenden, gegebenenfalls freie-Säure-Äquivalente summieren und eine materiell begrenzte Entscheidung treffen.",
                "observablePerformanceEn": "Apply the supplied dated original rule with its category and footnotes, where needed sum free-acid equivalents, and make a material-bounded decision."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "efficacy-and-dose-conditional",
                "dated-category-and-combined-limit"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "fresh-controlled-chemical-case",
                "textDe": "Frische Kategorie mit anderer Grenze oder Ausnahme; mehrere zugelassene Sorbatkomponenten; pH-/Wirksamkeitsdaten; klare Trennung von dated teaching data und aktueller rechtlicher Freigabe.",
                "textEn": "Fresh category with another limit or exception; several authorised sorbate components; pH/efficacy data; clear separation of dated teaching data and current legal clearance."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "dated-plant-mousse-material",
                "taskDemandDe": "Beurteile anhand eines bereitgestellten Originalauszugs der EU-Verordnung1333/2008, konsolidierte didaktische Materialfassung04.11.2025, ein nicht wärmebehandeltes pflanzliches Mousse (Kategorie16). E200–202:500mg/kg, Fußnoten1+2: allein oder kombiniert, Summe als freie Säure. Probe enthält300mg/kg Sorbinsäure(E200) und300mg/kg Kaliumsorbat(E202). Gegeben: M(Sorbinsäure)=112,13g/mol, M(Kaliumsorbat)=150,22g/mol sowie konkrete pH-/Wirkungsdaten. Erkläre und beurteile die Probe. Zusätzlich gegeben: HSorb ⇌ H⁺ + Sorbat⁻, pKa4,8 und beobachtete stärkere Hemmung bei pH3,8 als bei5,8 unter sonst gleichen Bedingungen. Erläutere mit dem Säure-Base-Modell die Wirkweise im bereitgestellten Fall, ohne einen universellen molekularen Wirkweg zu behaupten.",
                "taskDemandEn": "Using a supplied original extract of EU Regulation1333/2008, consolidated teaching-material edition04.11.2025, assess a non-heat-treated plant mousse (category16). E200–202:500mg/kg; footnotes1+2: individually or combined, sum as free acid. The sample contains300mg/kg sorbic acid(E200) and300mg/kg potassium sorbate(E202). Supplied molar masses are112.13g/mol and150.22g/mol with specific pH/efficacy data. Explain and assess the sample. Also supplied: HSorb ⇌ H⁺ + sorbate⁻, pKa4.8 and stronger observed inhibition at pH3.8 than5.8 with other conditions held constant. Use the acid-base model to explain the action in this supplied case without claiming a universal molecular pathway.",
                "expectedPerformanceDe": "300+300×112,13/150,22≈523,94mg/kg freie Säure liegt über500mg/kg. Die passende Kategorie und Kombination sind entscheidend, nicht eine getrennte Prüfung jeZutat oder ein ADI. Wirkungsdaten werden dennoch separat mit pH und Matrix gedeutet. Die Entscheidung gilt nur für das datierte Material, nicht als gegenwärtige Rechts- oder Sicherheitsfreigabe. Bei niedrigerem pH liegt ein höherer undissoziierter Säureanteil vor; dies wird mit den gegebenen Wirksamkeitsdaten verknüpft. Das Reaktionsmodell ersetzt keine eigene Beobachtung und belegt nicht jeden Hemmungsmechanismus.",
                "expectedPerformanceEn": "300+300×112.13/150.22≈523.94mg/kg free acid exceeds500mg/kg. The matching category and combination matter, rather than separate checks per ingredient or an ADI. Efficacy data are still interpreted separately with pH and matrix. The decision applies only to the dated material, not as present legal or safety clearance. At lower pH, the undissociated acid fraction is higher; connect this to the supplied efficacy data. The reaction model does not replace the learner’s own observation or establish every inhibition mechanism.",
                "understandingFocusDe": "Freie-Säure-Summe, Kategorie und Wirkungsgrenze.",
                "understandingFocusEn": "Free-acid sum, category and efficacy limits."
              },
              {
                "id": "fresh-dairy-and-juice-exception",
                "taskDemandDe": "Frisches Material aus derselben datierten Fassung gibt für eine konkrete nicht wärmebehandelte milchbasierte Nachspeise300mg/kg für die dort genannte Sorbinsäure/Benzoatgruppe an; ein passender Kontrollfall enthält350mg/kg E200. Ein zusätzlicher Kategorie14.1.2-Auszug erlaubt E200–202 nur für Sød…saft/sødet…saft. Beurteile die Nachspeise und erkläre, warum500mg/kg oder eine allgemeine Orangensaftzulassung daraus nicht folgen.",
                "taskDemandEn": "Fresh material from the same dated edition gives300mg/kg for the listed sorbic-acid/benzoate group in a specified non-heat-treated dairy dessert; a matching control contains350mg/kg E200. An additional category14.1.2extract permits E200–202 only for Sød…saft/sødet…saft. Assess the dessert and explain why neither500mg/kg nor generic orange-juice authorisation follows.",
                "expectedPerformanceDe": "350>300 für die konkret passende Dessertregel; die pflanzliche-Mousse-Grenze wird nicht übertragen. Die Saftausnahme benennt eine bestimmte Kategorie/Einschränkung und erlaubt keine pauschale Sorbinsäurezugabe zu Orangensaft. Zusätzlich nötige Wirksamkeits- und aktuelle Quellenprüfung bleiben getrennt.",
                "expectedPerformanceEn": "350>300 for the specifically matching dessert rule; the plant-mousse limit is not transferred. The juice exception specifies a category/restriction and does not permit blanket sorbic-acid addition to orange juice. Further efficacy and current-source checks remain separate.",
                "understandingFocusDe": "Frische Kategorie und begrenzte Zulässigkeitsfolgerung.",
                "understandingFocusEn": "Fresh category and bounded authorisation inference."
              }
            ]
          }
        }
      ],

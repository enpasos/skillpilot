      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "redox-antioxidant-role",
                "essentialUnderstandingDe": "Ascorbinsäure gibt in einer passenden Redoxreaktion Elektronen ab und wird oxidiert; das Oxidationsmittel wird reduziert. Eine antioxidative Wirkung kann Oxidationsprozesse beeinflussen, ist aber nicht gleichbedeutend mit antimikrobieller Konservierung.",
                "essentialUnderstandingEn": "In an appropriate redox reaction ascorbic acid donates electrons and is oxidised, while the oxidising agent is reduced. Antioxidant action can affect oxidation processes but is not identical to antimicrobial preservation.",
                "observablePerformanceDe": "An bereitgestellten Reaktions- und Vergleichsdaten die Rollen von Reduktionsmittel und Oxidationsmittel begründen und oxidative Veränderung von mikrobiellen Befunden trennen.",
                "observablePerformanceEn": "Use supplied reaction and comparison data to justify reducing/oxidising-agent roles and distinguish oxidative change from microbial observations."
              },
              {
                "id": "material-bounded-preservation-decision",
                "essentialUnderstandingDe": "Eine Bewertung braucht die konkrete Matrix, Bedingungen und getrennte Kriterien wie Oxidationsmarker, mikrobielle Belastung und Produktqualität. Weniger Bräunung oder ein Elektronenpfeil garantieren weder Sterilität noch eine allgemeine Haltbarkeit.",
                "essentialUnderstandingEn": "Evaluation requires the specific matrix, conditions and separate criteria such as oxidation markers, microbial load and product quality. Reduced browning or an electron arrow guarantees neither sterility nor general shelf life.",
                "observablePerformanceDe": "Eine redoxaktive Strategie mit passenden Kriterien beurteilen, Gegenbefunde berücksichtigen und die Aussage ausdrücklich auf die vorgegebenen Daten begrenzen.",
                "observablePerformanceEn": "Assess a redox-active strategy using suitable criteria, account for contrary observations and explicitly limit the conclusion to the supplied data."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "redox-antioxidant-role",
                "material-bounded-preservation-decision"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "fresh-controlled-chemical-case",
                "textDe": "Andere Oxidations- und mikrobielle Messgrößen; frische Lebensmittelmatrix und Vergleichsbedingungen; getrennte Reaktions-/Wirksamkeitsdaten; Nutzen und Grenze statt einseitigem Sicherheitsurteil.",
                "textEn": "Different oxidation and microbial measures; fresh food matrix and comparison conditions; separate reaction/efficacy data; benefits and limits rather than one-sided safety verdict."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "ascorbic-oxidation-versus-microbes",
                "taskDemandDe": "Eine ausdrücklich didaktische Tabelle vergleicht gleich behandelte geeignete Lebensmittelproben: Ohne Ascorbinsäure ist ein Oxidationsmarker100relativeEinheiten, mit Ascorbinsäure40; mikrobielle Keimzahlen bleiben in beiden Fällen bei1000progegebenemVolumen. Ein passendes Reaktionsmaterial gibt Ascorbinsäure→Dehydroascorbinsäure+2H⁺+2e⁻ an. Bewerte die Konservierungsstrategie anhand beider Messaspekte.",
                "taskDemandEn": "An explicitly didactic table compares equally treated suitable food samples: without ascorbic acid an oxidation marker is100relativeunits and with it40; microbial counts remain1000pergivenvolume in both. Matching reaction material gives ascorbic acid→dehydroascorbic acid+2H⁺+2e⁻. Evaluate the preservation strategy using both measurements.",
                "expectedPerformanceDe": "Ascorbinsäure ist Elektronendonator/Reduktionsmittel und wird oxidiert; passende Oxidantreduktion wird begründet. Der niedrigere Oxidationsmarker trägt eine antioxidative Verbesserung unter den angegebenen Bedingungen. Unveränderte Keimzahl trägt keine antimikrobielle Verbesserung und keine Sterilitäts-/Haltbarkeitsgarantie. Die Zahlen sind bereitgestellte Modellwerte, keine durch KI beobachteten Versuche.",
                "expectedPerformanceEn": "Ascorbic acid is an electron donor/reducing agent and is oxidised; explain the corresponding oxidant reduction. The lower oxidation marker supports antioxidant improvement under the given conditions. Unchanged microbial counts support no antimicrobial improvement or sterility/shelf-life guarantee. The numbers are supplied model values, not experiments observed by AI.",
                "understandingFocusDe": "Getrennte Redox- und mikrobielle Evidenz.",
                "understandingFocusEn": "Separate redox and microbial evidence."
              },
              {
                "id": "fresh-combined-strategy-and-counterexample",
                "taskDemandDe": "Frisches Material vergleicht Ascorbinsäure, eine antimikrobielle Maßnahme und deren Kombination in einer anderen geeigneten Lebensmittelmatrix. Die Daten zeigen getrennte Effekte auf Oxidationsmarker, Keimzahl und Geschmack bei gleicher Beobachtungszeit. Bewerte Nutzen und Grenzen jeder Strategie; ein Zusatzdatensatz bei anderen Lagerbedingungen zeigt keinen verbesserten Oxidationsmarker trotz Ascorbinsäure.",
                "taskDemandEn": "Fresh material compares ascorbic acid, an antimicrobial intervention and their combination in another suitable food matrix. Data show separate effects on oxidation markers, microbial counts and taste after equal observation times. Evaluate benefits and limitations of each strategy; an extra dataset under different storage conditions shows no improved oxidation marker despite ascorbic acid.",
                "expectedPerformanceDe": "Die Bewertung ordnet jede Wirkung den tatsächlich passenden Daten und Kriterien zu. Eine Kombination kann unterschiedliche Aspekte verbessern, wird aber nicht pauschal als sicher oder dauerhaft wirksam bezeichnet. Der geänderte Lagerfall begrenzt die Aussage; das vorgegebene positive Redoxmodell darf gegenteilige Wirksamkeitsdaten nicht ersetzen.",
                "expectedPerformanceEn": "The evaluation assigns each effect to the actually relevant data and criteria. A combination may improve different aspects but is not labelled universally safe or permanently effective. The changed storage case limits the conclusion; a supplied favourable redox model cannot replace contrary efficacy data.",
                "understandingFocusDe": "Frischer kriteriengebundener Bewertungsfall.",
                "understandingFocusEn": "Fresh criterion-based evaluation."
              }
            ]
          }
        }
      ],

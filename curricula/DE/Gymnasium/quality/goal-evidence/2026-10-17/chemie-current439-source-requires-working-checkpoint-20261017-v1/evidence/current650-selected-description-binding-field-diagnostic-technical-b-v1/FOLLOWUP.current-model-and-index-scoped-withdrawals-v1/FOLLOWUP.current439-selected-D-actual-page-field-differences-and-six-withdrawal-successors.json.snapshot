            "archetype": "representation",
            "expectations": [
              {
                "id": "b002-e9b61d96-core",
                "essentialUnderstandingDe": "Konstitutionsisomere besitzen dieselbe Summenformel, aber unterschiedliche Verknüpfungen der Atome; bei Alkanolen kann sich Kette oder OH-Position ändern.",
                "essentialUnderstandingEn": "Constitutional isomers share a molecular formula but differ in atomic connectivity; in alkanols either the chain or OH position can change.",
                "observablePerformanceDe": "Die lernende Person zeichnet zwei korrekte Alkanolstrukturen zu einer Summenformel, vergleicht ihre Konnektivität und schließt bloße Drehungen als neue Isomere aus.",
                "observablePerformanceEn": "The learner draws two valid alkanol structures for one molecular formula, compares connectivity, and excludes mere rotations as new isomers."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b002-e9b61d96-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "connectivity",
                "textDe": "Positions- und Kettenisomerie werden variiert.",
                "textEn": "Position and chain isomerism are varied."
              },
              {
                "id": "formula",
                "textDe": "Ein bekannter C4- und ein frischer C5-Fall werden verglichen.",
                "textEn": "A familiar C4 case and a fresh C5 case are compared."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "c4-alkanol-isomers",
                "taskDemandDe": "Zeichne Butan-1-ol und Butan-2-ol und prüfe Summenformel sowie Atomverknüpfung. Warum sind sie keine bloßen gedrehten Zeichnungen?",
                "taskDemandEn": "Draw butan-1-ol and butan-2-ol and check molecular formula and connectivity. Why are these not merely rotated drawings?",
                "expectedPerformanceDe": "Die lernende Person nennt für beide C4H10O, aber unterschiedliche OH-Bindungsstellen; eine räumliche Drehung ändert diese Bindung nicht.",
                "expectedPerformanceEn": "The learner identifies C4H10O for both but different OH attachment positions; rotation does not change that bond.",
                "understandingFocusDe": "Gleiche Summenformel allein bedeutet noch keine identische Konstitution.",
                "understandingFocusEn": "The same formula does not mean identical connectivity."
              },
              {
                "id": "fresh-c5-chain-isomer",
                "taskDemandDe": "Für C5H12O werden Pentan-1-ol und 2-Methylbutan-1-ol vorgeschlagen. Zeichne beide und entscheide, welche Art Konstitutionsisomerie vorliegt.",
                "taskDemandEn": "Pentan-1-ol and 2-methylbutan-1-ol are proposed for C5H12O. Draw both and determine the kind of constitutional isomerism.",
                "expectedPerformanceDe": "Die lernende Person zeigt gleiche Summenformel und OH-Endlage, aber unterschiedliche C-Gerüste; sie ordnet Kettenisomerie zu.",
                "expectedPerformanceEn": "The learner shows the same molecular formula and terminal OH but different carbon skeletons, so classifies chain isomerism.",
                "understandingFocusDe": "Neues Gerüst prüft Transfer über die Bildbeispiele hinaus.",
                "understandingFocusEn": "A new skeleton tests transfer beyond pictured examples."
              }
            ]
          }
        }

        "bookDigest": "sha256:1faf19b8e9d0961e7387109bed769ed10a8f7a6db3856c74a7ca5c505bdda491",
        "pageFingerprint": "sha256:4398ebfef4078a950ff44d69ef44f9a154afe930f70641da7fbabf929ab8fbcd",

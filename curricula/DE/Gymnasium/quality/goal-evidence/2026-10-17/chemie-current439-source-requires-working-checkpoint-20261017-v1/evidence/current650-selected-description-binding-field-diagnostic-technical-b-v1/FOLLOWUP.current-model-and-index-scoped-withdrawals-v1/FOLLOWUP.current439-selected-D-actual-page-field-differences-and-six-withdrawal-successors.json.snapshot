      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "primary-ultimate-biodegradation",
                "essentialUnderstandingDe": "Primärer biologischer Abbau verändert den Ausgangsstoff; vollständige aerobe Mineralisierung betrifft den weiteren Abbau zu einfachen Endprodukten wie CO₂ und Wasser. Verlust von Tensidfunktion allein beweist keine vollständige Mineralisierung.",
                "essentialUnderstandingEn": "Primary biodegradation changes the parent compound; ultimate aerobic mineralization concerns further breakdown into simple products such as CO₂ and water. Loss of surfactant function alone does not prove complete mineralization.",
                "observablePerformanceDe": "Geeignete vorgegebene Messgrößen für Ausgangsstoffverlust und Mineralisierung unterscheiden und den jeweils erlaubten Schluss benennen.",
                "observablePerformanceEn": "Distinguish supplied measures of parent loss and mineralization and state their respective evidential limits."
              },
              {
                "id": "controlled-bio-test",
                "essentialUnderstandingDe": "Ein biologischer Abbaubefund benötigt passende Mikroorganismen, Bedingungen und Kontrollen. Adsorption oder ein ungeeigneter Test kann den Ausgangsstoff scheinbar entfernen, ohne biologischen Abbau zu beweisen.",
                "essentialUnderstandingEn": "A biodegradation finding needs appropriate microorganisms, conditions and controls. Adsorption or an unsuitable test can apparently remove the parent without proving biodegradation.",
                "observablePerformanceDe": "Kontrollierte vorgegebene Testdaten über Zeit, Ausgangsstoff und CO₂/Sauerstoffverbrauch vergleichen; Umwelt- oder Gesetzesfreigaben daraus nicht erfinden.",
                "observablePerformanceEn": "Compare controlled supplied test data over time, parent compound and CO₂/oxygen use without inventing environmental or statutory clearance."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "primary-ultimate-biodegradation",
                "controlled-bio-test"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "changed-chemical-case",
                "textDe": "Anderer Tensidstoff und Testbedingungen; Ausgangsstoffmessung gegen Mineralisierung und unbelebte Blindkontrolle.",
                "textEn": "Change surfactant and test conditions; compare parent measurement with mineralization and an abiotic blank."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "loss-versus-mineralization",
                "taskDemandDe": "Ein ausdrücklich didaktisches Testmodell meldet 80 % Verlust des Ausgangstensids, aber nur 15 % des theoretisch möglichen CO₂ nach gleicher Zeit. Erläutere primären und vollständigen Abbau und benenne, welche zusätzlichen Kontrollinformationen für eine biologische Deutung nötig sind.",
                "taskDemandEn": "An explicitly educational test model reports80% parent-surfactant loss but only15% of theoretical CO₂ after equal time. Explain primary and ultimate degradation and identify additional controls needed for a biological interpretation.",
                "expectedPerformanceDe": "Ausgangsstoffverlust und CO₂-Mineralisierung sind verschiedene Messgrößen. 15 % belegt keine vollständige Mineralisierung; ohne unbelebte/Adsorptions- und Inokulumblindkontrolle ist selbst der primäre biologische Anteil nicht gesichert. Keine gesetzliche Grenzzahl oder Unbedenklichkeit wird aus diesen Modellzahlen abgeleitet.",
                "expectedPerformanceEn": "Parent loss and CO₂ mineralization are different measures.15% does not establish complete mineralization; without abiotic/adsorption and inoculum blanks even the primary biological share is uncertain. No statutory threshold or harmlessness follows from these model numbers.",
                "understandingFocusDe": "Messkriterium und Schlussgrenze.",
                "understandingFocusEn": "Measurement criterion and inference limit."
              },
              {
                "id": "controlled-two-surfactants",
                "taskDemandDe": "Frische Daten vergleichen zwei Tenside bei gleichem eingesetzten organischen Kohlenstoff, Inokulum, Temperatur und Sauerstoffangebot. Nach Blindwertkorrektur zeigt A mehr CO₂ als B; eine zusätzliche unbelebte Kontrolle zeigt bei B starken Ausgangsstoffverlust ohne CO₂-Anstieg. Bewerte nur den durch die Daten belegten Unterschied.",
                "taskDemandEn": "Fresh data compare two surfactants at equal organic carbon, inoculum, temperature and oxygen supply. After blank correction A yields more CO₂ than B; an additional abiotic control shows strong parent loss for B without CO₂ increase. Evaluate only the supported difference.",
                "expectedPerformanceDe": "Unter den gegebenen Bedingungen hat A einen höheren belegten aeroben Mineralisierungsanteil. Bei B erklärt die unbelebte Kontrolle einen möglichen nichtbiologischen Verlust. Das beweist weder allgemeine Persistenz in jedem Milieu noch Sicherheit von A; Bedingungen und Testdauer begrenzen den Vergleich.",
                "expectedPerformanceEn": "Under these conditions A has a higher demonstrated aerobic mineralization fraction. B’s abiotic control supports possible nonbiological loss. This proves neither universal persistence in every environment nor safety of A; conditions and duration limit the comparison.",
                "understandingFocusDe": "Frischer Kontroll-/Bedingungstransfer.",
                "understandingFocusEn": "Fresh control and condition transfer."
              }
            ]
          }
        }
      ],

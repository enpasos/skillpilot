      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "formula-molar-mass-and-mass-amount",
                "essentialUnderstandingDe": "Molare Masse ist die Masse pro Stoffmenge eines Stoffes. Die Formel bestimmt die Anzahl der enthaltenen Atome je Molekül oder Verhältnisformeleinheit; Indizes und Klammern zählen mit. m und n sind verschiedene Größen, und eine Umrechnung benötigt den zum Stoff passenden Wert M mit Einheit g/mol.",
                "essentialUnderstandingEn": "Molar mass is mass per amount of substance. A formula determines the number of constituent atoms per molecule or formula unit; subscripts and parentheses matter. Mass and amount are different quantities, and their conversion requires the substance-specific molar mass in g/mol.",
                "observablePerformanceDe": "Die lernende Person erschließt M aus der Zusammensetzung, nutzt M zur Mengenübersetzung und begründet die Zählung sowie Größen und Einheiten statt nur einen Zahlenwert einzusetzen.",
                "observablePerformanceEn": "The learner derives molar mass from composition, uses it to translate between mass and amount and explains atom counting, quantities and units rather than just inserting numbers."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "formula-molar-mass-and-mass-amount"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "formula-structure",
                "textDe": "Eine einfache Molekülformel wird durch eine Verhältnisformel mit Klammergruppe ersetzt.",
                "textEn": "A simple molecular formula is replaced by a ratio formula containing a parenthesised group."
              },
              {
                "id": "comparison-basis",
                "textDe": "Gegebene Masse wird durch Vergleich gleicher Stoffmengen verschiedener Stoffe ersetzt.",
                "textEn": "A specified mass is replaced by comparing equal amounts of different substances."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "water-mass-amount",
                "taskDemandDe": "Für H2O gelten die gerundeten atombezogenen molaren Massen H: 1,0 g/mol, O: 16,0 g/mol. Eine reine Wasserprobe wiegt 9,0 g. Bestimme ihre molare Masse und Stoffmenge und erkläre, warum 9,0 g nicht automatisch 9,0 mol bedeutet.",
                "taskDemandEn": "For H2O, use rounded atom-based molar masses H: 1.0 g/mol and O: 16.0 g/mol. A pure water sample weighs 9.0 g. Determine its molar mass and amount and explain why 9.0 g does not automatically mean 9.0 mol.",
                "expectedPerformanceDe": "Zwei H und ein O ergeben M(H2O)=18,0 g/mol; 9,0 g entsprechen 0,50 mol. M übersetzt Gramm in Stoffmengenpakete; der Index2 gehört zu H und verdoppelt nicht die ganze Formel.",
                "expectedPerformanceEn": "Two H atoms and one O atom give M(H2O)=18.0 g/mol; 9.0 g corresponds to 0.50 mol. M translates grams into amount-of-substance packages; the subscript 2 belongs to H and does not double the entire formula.",
                "understandingFocusDe": "Die Formelzählung und die Bedeutung von Masse pro mol tragen die Umrechnung.",
                "understandingFocusEn": "Formula counting and the meaning of mass per mol support the conversion."
              },
              {
                "id": "hydroxide-parentheses-fresh",
                "taskDemandDe": "Frischer Fall ohne Formelangabe für den Rechenweg: Benötigt werden je 0,20 mol Mg(OH)2 und NaOH. Verwende Mg: 24,0, Na: 23,0, O: 16,0, H: 1,0 jeweils in g/mol für ein mol der Atome. Welche Massen müssen abgewogen werden? Ein Vorschlag zählt in Mg(OH)2 nur ein O-Atom. Prüfe ihn und begründe, ob gleiche Stoffmenge gleiche Masse bedeutet.",
                "taskDemandEn": "Fresh case without a calculation formula: 0.20 mol each of Mg(OH)2 and NaOH is required. Use Mg: 24.0, Na: 23.0, O: 16.0 and H: 1.0 g/mol per mol of atoms. Which masses should be weighed? A proposal counts only one O atom in Mg(OH)2. Check it and explain whether equal amount means equal mass.",
                "expectedPerformanceDe": "Mg(OH)2 enthält ein Mg, zwei O und zwei H je Formeleinheit: M=58,0 g/mol, m=11,6 g. NaOH hat M=40,0 g/mol, m=8,0 g. Der Klammerindex vervielfacht die ganze OH-Gruppe. Gleiche Zahl von Stoffmengenpaketen kann wegen anderer Zusammensetzung andere Masse haben.",
                "expectedPerformanceEn": "Mg(OH)2 contains one Mg, two O and two H atoms per formula unit: M=58.0 g/mol and m=11.6 g. NaOH has M=40.0 g/mol and m=8.0 g. The parenthesis subscript multiplies the entire OH group. Equal numbers of amount-of-substance packages can have different masses because of their composition.",
                "understandingFocusDe": "Ungeholfene Übertragung auf Klammerformeln und einen stoffübergreifenden Vergleich.",
                "understandingFocusEn": "Uncued transfer to parenthesised formulas and a comparison between substances."
              }
            ]
          }
        }
      ],

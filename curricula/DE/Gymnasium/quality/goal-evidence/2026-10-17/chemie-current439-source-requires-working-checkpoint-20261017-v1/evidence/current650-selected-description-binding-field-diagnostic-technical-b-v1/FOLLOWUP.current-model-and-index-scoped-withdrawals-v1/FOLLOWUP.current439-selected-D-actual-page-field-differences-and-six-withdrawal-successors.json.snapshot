      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "b010-b508-anion-classification",
                "essentialUnderstandingDe": "Die Klasse eines ausgewählten Salzes wird am charakteristischen Anion erkannt: Halogenid mit Cl⁻, Br⁻ oder I⁻, Sulfat mit SO₄²⁻, Nitrat mit NO₃⁻ und Carbonat mit CO₃²⁻. Unterschiedliche Kationen und Indizes in einer ladungsneutralen Formel ändern das namensgebende Anion nicht.",
                "essentialUnderstandingEn": "The class of a selected salt is identified by its characteristic anion: a halide with Cl⁻, Br⁻ or I⁻, a sulfate with SO₄²⁻, a nitrate with NO₃⁻, and a carbonate with CO₃²⁻. Different cations and subscripts in a charge-neutral formula do not change the class-defining anion.",
                "observablePerformanceDe": "Die lernende Person erkennt in neuen vorgegebenen Salzformeln oder Ionenkombinationen das charakteristische Anion und begründet damit die Klassenzuordnung trotz anderer Kationen und Zahlenverhältnisse, ohne Stoffeigenschaften bloß aus dem Klassennamen abzuleiten.",
                "observablePerformanceEn": "The learner identifies the characteristic anion in unfamiliar supplied salt formulas or ion combinations and uses it to justify the class despite different cations and ion ratios, without inferring material properties merely from the class label."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b010-b508-anion-classification"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "different-cations-and-ratios",
                "textDe": "Vorgegebene neue Formeln verwenden andere Kationen und Zahlenverhältnisse als die vier Beispiele des Bildes.",
                "textEn": "New supplied formulas use different cations and ion ratios from the four examples in the image."
              },
              {
                "id": "given-ion-combinations",
                "textDe": "Ein zweiter Fall stellt die Ionen bereits als Gruppen mit unterschiedlichen Zahlenverhältnissen bereit; allein das charakteristische Anion bestimmt die Klasse.",
                "textEn": "A second case supplies ions as groups with different ratios; the characteristic anion alone determines the class."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "unseen-salt-formulas",
                "taskDemandDe": "Ohne Abbildung liegen die Salzformeln MgCl₂, Al₂(SO₄)₃, Na₂CO₃ und Ca(NO₃)₂ vor. Benenne für jede das charakteristische Anion und die Salzklasse. Erkläre am Vergleich von MgCl₂ mit Na₂CO₃, warum ein Index 2 allein keine Salzklasse bestimmt.",
                "taskDemandEn": "Without a diagram, the salt formulas MgCl₂, Al₂(SO₄)₃, Na₂CO₃ and Ca(NO₃)₂ are supplied. Name the characteristic anion and salt class for each. Compare MgCl₂ with Na₂CO₃ to explain why a subscript 2 alone does not determine the salt class.",
                "expectedPerformanceDe": "MgCl₂ enthält Cl⁻ und ist ein Halogenid; Al₂(SO₄)₃ enthält SO₄²⁻ und ist ein Sulfat; Na₂CO₃ enthält CO₃²⁻ und ist ein Carbonat; Ca(NO₃)₂ enthält NO₃⁻ und ist ein Nitrat. Der Index gleicht Ionenladungen aus und bezeichnet nicht die Klasse; entscheidend ist jeweils die Anionenart.",
                "expectedPerformanceEn": "MgCl₂ contains Cl⁻ and is a halide; Al₂(SO₄)₃ contains SO₄²⁻ and is a sulfate; Na₂CO₃ contains CO₃²⁻ and is a carbonate; Ca(NO₃)₂ contains NO₃⁻ and is a nitrate. The subscript balances ionic charges and does not designate a class; the anion type does.",
                "understandingFocusDe": "Frische Klassifikation nach Anion statt Wiedererkennen der vier Bildbeispiele oder eines bloßen Zahlenmusters.",
                "understandingFocusEn": "Fresh classification by anion rather than recognition of the four image examples or a bare number pattern."
              },
              {
                "id": "given-ion-groups",
                "taskDemandDe": "Eine zweite, bildfreie Aufgabe gibt zwei bereits zusammengestellte Ionenlisten vor: Salz A enthält 2 K⁺ und CO₃²⁻, Salz B enthält Ca²⁺ und 2 NO₃⁻. Nenne für A und B das namensgebende Anion und die Salzklasse. Begründe, weshalb die unterschiedlichen Kationen und Zahlenverhältnisse nicht selbst den Klassennamen festlegen. Es sind keine Formeln zu bilden oder Stoffeigenschaften zu erraten.",
                "taskDemandEn": "A second diagram-free task supplies two already assembled ion lists: salt A contains 2 K⁺ and CO₃²⁻, and salt B contains Ca²⁺ and 2 NO₃⁻. For A and B, name the class-defining anion and salt class. Explain why the different cations and ion ratios do not themselves determine the class name. No formula construction or material-property guess is requested.",
                "expectedPerformanceDe": "A enthält Carbonat-Ionen CO₃²⁻ und gehört zur Klasse der Carbonate; B enthält Nitrat-Ionen NO₃⁻ und gehört zur Klasse der Nitrate. Die Anzahl der K⁺ beziehungsweise NO₃⁻ und das jeweilige Gegenion ändern das charakteristische Anion nicht. Eine Eigenschaft des konkreten Salzes folgt daraus allein nicht.",
                "expectedPerformanceEn": "A contains carbonate ions CO₃²⁻ and belongs to the carbonates; B contains nitrate ions NO₃⁻ and belongs to the nitrates. The number of K⁺ or NO₃⁻ ions and the respective counterion do not change the characteristic anion. This classification alone establishes no property of the particular salt.",
                "understandingFocusDe": "Transfer von vorgegebenen Ionengruppen auf die Klassifikation; prüft das charakteristische Anion unabhängig von der Bildtabelle, ohne Formelbau als zusätzliche Kompetenz zu fordern.",
                "understandingFocusEn": "Transfer from supplied ion groups to classification, testing the characteristic anion independently of the image table without requiring formula construction as an additional skill."
              }
            ]
          }
        }
      ],

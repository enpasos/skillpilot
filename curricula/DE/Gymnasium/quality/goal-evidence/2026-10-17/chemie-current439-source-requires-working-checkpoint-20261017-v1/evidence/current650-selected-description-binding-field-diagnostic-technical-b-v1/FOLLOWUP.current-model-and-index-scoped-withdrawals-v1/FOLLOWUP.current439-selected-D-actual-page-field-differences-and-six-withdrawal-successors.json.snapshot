      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "content-specific-understanding",
                "essentialUnderstandingDe": "GewinkeltepolareWassermoleküle bildenWasserstoffbrücken;daraus ergeben sichbesondereWärme-/Oberflächen-/Löseeigenschaften undeineoffeneEisstruktur,diebei gegebenenBedingungen biologischeFunktionen unterstützen.",
                "essentialUnderstandingEn": "Bent polar water molecules form hydrogen bonds;this supports distinctive heat/surface/solvation behaviour and an openice structure that serves biological functions under stated conditions.",
                "observablePerformanceDe": "OffenegeordneteEisstruktur enthältgrößerenVolumenanteilzwischenMolekülen,dahergibt dieDatenkartegeringereDichte/Schwimmen. WasserWärmekapazität dämpftTemperaturänderungen. SchwimmendeEisdecke undlangsamerWärmewechsel könnenuntergegebenenBedingungen LebensräumeunterderOberfläche erhalten;kein universellesNichtgefrieren folgt.",
                "observablePerformanceEn": "The open orderedice structure has more volume between molecules,hence the supplied lower density/floating.Water’s heat capacity moderates temperature changes.Floatingice and slow thermal change can preserve habitats beneath the surface under stated conditions;universal prevention of freezing does not follow."
              },
              {
                "id": "fresh-transfer-and-model-boundary",
                "essentialUnderstandingDe": "Wasserist keinUniversallösemittel;Oberflächenspannung ist keinefesteHaut unddieHydratationgarantiert nicht,dassjedesSalz gutlöslich ist.",
                "essentialUnderstandingEn": "Water is no universal solvent;surface tension is no solid skin,and hydration does not guarantee every salt is highly soluble.",
                "observablePerformanceDe": "O-Seite zuNa+,H-Seiten zuCl−;Ion-Dipol-Wechselwirkungen unterstützenHydratation. UnpolareÖlanteile bieten keinegleichwertigenpolarenKontaktmöglichkeiten;Mischbarkeitistbegrenzt. Kohäsion/H-Brücken tragenOberflächenspannung,unterstützenkleineTiere an derOberfläche. WasseralsLösungs-/Transportmedium wirdaufgeeigneteIonen begrenzt.",
                "observablePerformanceEn": "O side towardsNa+,H sides towardsCl−;ion-dipole interactions support hydration.Nonpolar oil lacks equivalent polar contact opportunities;mixing is limited.Cohesion/hydrogen bonds contribute to surface tension,supporting small surface-dwelling animals.Water as solvent/transport medium is bounded to suitable ions."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "content-specific-understanding",
                "fresh-transfer-and-model-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-material-variation",
                "textDe": "FlüssigesWasser/Eis undIonenhydration gegenüber unpolaremÖl undTemperaturpufferung.",
                "textEn": "Liquid water/ice and ion hydration versus nonpolar oil and temperature buffering."
              },
              {
                "id": "specific-model-limit",
                "textDe": "Wasserist keinUniversallösemittel;Oberflächenspannung ist keinefesteHaut unddieHydratationgarantiert nicht,dassjedesSalz gutlöslich ist.",
                "textEn": "Water is no universal solvent;surface tension is no solid skin,and hydration does not guarantee every salt is highly soluble."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next25-7a36f2a2-case-1",
                "taskDemandDe": "Gegeben:H2O gewinkelt104,5°,Oδ−/Hδ+;H-Brücken verbindenHδ+ einesMoleküls mitO einesanderen. Messdatenkarte:bei0°C/Normaldruck EisgeringereDichte alsWasser;Eis bildetoffenesNetzwerk. Wasser besitztvergleichsweisehoheWärmekapazität. VerbindeBau undH-Brücken mitSchwimmenvonEis undTemperaturpufferung undleite einenbegründetenNutzenfürGewässerlebewesen ab.",
                "taskDemandEn": "Given:H2O bent104.5°,Oδ−/Hδ+;hydrogen bonds connectHδ+ of one molecule withO of another.Data card:at0°C/normalpressureice is less dense thanwater;ice forms an opennetwork.Water has comparatively high heat capacity. Connect structure/hydrogen bonds to floatingice and thermal buffering;derive one justified benefit for aquatic life.",
                "expectedPerformanceDe": "OffenegeordneteEisstruktur enthältgrößerenVolumenanteilzwischenMolekülen,dahergibt dieDatenkartegeringereDichte/Schwimmen. WasserWärmekapazität dämpftTemperaturänderungen. SchwimmendeEisdecke undlangsamerWärmewechsel könnenuntergegebenenBedingungen LebensräumeunterderOberfläche erhalten;kein universellesNichtgefrieren folgt.",
                "expectedPerformanceEn": "The open orderedice structure has more volume between molecules,hence the supplied lower density/floating.Water’s heat capacity moderates temperature changes.Floatingice and slow thermal change can preserve habitats beneath the surface under stated conditions;universal prevention of freezing does not follow.",
                "understandingFocusDe": "EineWasserstoffbrücke ist keine zusätzlichekovalenteO–H-Bindung,diealleMoleküle zu einemRiesenmolekül macht.",
                "understandingFocusEn": "A hydrogen bond is not an extra covalentO–H bond joining all molecules into one giant molecule."
              },
              {
                "id": "chem-next25-7a36f2a2-case-2",
                "taskDemandDe": "FrischerFall:NaCl-Ionen werdeninWasser hydratisiert;Öl besteht imModell ausunpolarenKohlenwasserstoffen undbildet einezweitePhase. Wasserläuferfüße verursachenkleineOberflächendellen. Eswerden keineÖl-/Lebewesenversuche verlangt. Erkläre Wasserorientierung umbeideIonen,begrenzteÖlmischbarkeit undOberflächenspannung;verbindeein Phänomen mitbiologischerBedeutung.",
                "taskDemandEn": "Fresh case:NaCl ions hydrate inwater;oil is modelled as nonpolar hydrocarbons and forms a separate phase.Water-strider feet make small surface depressions.Nooil/organism experiment is demanded. Explain water orientation around both ions,limitedoil miscibility and surface tension;connect one phenomenon to biological meaning.",
                "expectedPerformanceDe": "O-Seite zuNa+,H-Seiten zuCl−;Ion-Dipol-Wechselwirkungen unterstützenHydratation. UnpolareÖlanteile bieten keinegleichwertigenpolarenKontaktmöglichkeiten;Mischbarkeitistbegrenzt. Kohäsion/H-Brücken tragenOberflächenspannung,unterstützenkleineTiere an derOberfläche. WasseralsLösungs-/Transportmedium wirdaufgeeigneteIonen begrenzt.",
                "expectedPerformanceEn": "O side towardsNa+,H sides towardsCl−;ion-dipole interactions support hydration.Nonpolar oil lacks equivalent polar contact opportunities;mixing is limited.Cohesion/hydrogen bonds contribute to surface tension,supporting small surface-dwelling animals.Water as solvent/transport medium is bounded to suitable ions.",
                "understandingFocusDe": "Wasserist keinUniversallösemittel;Oberflächenspannung ist keinefesteHaut unddieHydratationgarantiert nicht,dassjedesSalz gutlöslich ist.",
                "understandingFocusEn": "Water is no universal solvent;surface tension is no solid skin,and hydration does not guarantee every salt is highly soluble."
              }
            ]
          }
        }
      ],

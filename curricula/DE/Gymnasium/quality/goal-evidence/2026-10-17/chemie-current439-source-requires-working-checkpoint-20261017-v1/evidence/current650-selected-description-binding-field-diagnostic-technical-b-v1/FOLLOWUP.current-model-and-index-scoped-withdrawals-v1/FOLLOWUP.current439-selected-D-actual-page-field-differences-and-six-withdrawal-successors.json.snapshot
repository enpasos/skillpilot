      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "lead-battery-reversible-conversion",
                "essentialUnderstandingDe": "Beim Entladen eines Blei-Akkumulators wird Pb oxidiert und PbO2 reduziert; beide Elektroden bilden in Schwefelsäure PbSO4. Elektronen fließen im äußeren Stromkreis, der Elektrolyt ermöglicht den inneren Ladungsausgleich. Laden erfordert elektrische Energie und kehrt die Gesamtumsetzung zurück; hohe Masse, begrenzte Zyklen und Blei-/Säurehandhabung begrenzen den Speicher.",
                "essentialUnderstandingEn": "On discharging a lead–acid battery, Pb is oxidized and PbO2 is reduced; both electrodes form PbSO4 in sulfuric acid. Electrons flow through the external circuit and the electrolyte provides internal charge balance. Charging requires electrical energy and reverses the overall conversion; high mass, finite cycles and lead/acid handling constrain the store.",
                "observablePerformanceDe": "Die lernende Person erläutert einen neuen Lade-/Entladefall mithilfe von Elektrodenstoffen und Ladungswegen, deutet eine Konzentrationsänderung und begründet eine geeignete oder ungeeignete Nutzung.",
                "observablePerformanceEn": "The learner explains a fresh charge/discharge case through electrode materials and charge pathways, interprets a concentration change and justifies a suitable or unsuitable use."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "lead-battery-reversible-conversion"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "operating-direction",
                "textDe": "Entladen als galvanischer Betrieb wird mit erzwungenem Laden verglichen.",
                "textEn": "Galvanic discharge is compared with externally driven charging."
              },
              {
                "id": "use-demand",
                "textDe": "Kurzzeitig hoher Starterstrom wird mit einem gewichtsbegrenzten mobilen Speicher verglichen.",
                "textEn": "Brief high starter current is contrasted with a weight-limited mobile store."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "starter-discharge-acid-data",
                "taskDemandDe": "Ein bereitgestelltes Modell eines Fahrzeug-Blei-Akkus zeigt Pb, PbO2 und Schwefelsäure vor dem Start sowie PbSO4 an beiden Elektroden und geringere Säuredichte nach mehreren Starts. Erkläre Strom-/Ladungswege und Stoffänderungen, begründe die Wiederaufladbarkeit und einen Nutzen als Starterakku. Kein realer Akku wird geöffnet.",
                "taskDemandEn": "A supplied vehicle lead–acid model shows Pb, PbO2 and sulfuric acid before starting, then PbSO4 at both electrodes and lower acid density after several starts. Explain current/charge pathways and material changes, justify rechargeability and one benefit as a starter battery. No real battery is opened.",
                "expectedPerformanceDe": "Die lernende Person erklärt Oxidation von Pb und Reduktion von PbO2, elektronischen Außenweg und ionischen Innenweg. Sie deutet die Gesamtreaktion Pb + PbO2 + 2 H2SO4 → 2 PbSO4 + 2 H2O qualitativ mit Säureverbrauch, erklärt Wiederherstellung durch elektrische Ladeenergie und verbindet hohen kurzzeitigen Strom mit dem Einsatz; Masse/Umgang bleiben Grenzen.",
                "expectedPerformanceEn": "The learner explains Pb oxidation and PbO2 reduction, the external electron route and internal ionic route. They interpret Pb + PbO2 + 2 H2SO4 → 2 PbSO4 + 2 H2O qualitatively as acid consumption, explain restoration using charging energy and relate brief high current to the application while retaining mass/handling limits.",
                "understandingFocusDe": "Stoff- und Ladungsänderungen erklären die Speicherfunktion.",
                "understandingFocusEn": "Material and charge changes explain energy storage."
              },
              {
                "id": "fresh-charging-and-portable-choice",
                "taskDemandDe": "Ein neuer Papierfall zeigt einen weit entladenen Blei-Akku, ein geeignetes Ladegerät und eine leichte tragbare Anwendung. Prüfe „Ein Ladegerät ersetzt nur verlorene Elektronen; die Elektroden bleiben unverändert“ und „derselbe Akku ist wegen seiner Wiederaufladbarkeit für jede mobile Anwendung optimal“. Beschreibe die qualitative Stoffumkehr und eine Grenze; keine praktische Ladung.",
                "taskDemandEn": "A fresh paper case shows a discharged lead–acid battery, a suitable charger and a lightweight portable application. Assess “charging only replaces lost electrons; electrodes remain unchanged” and “rechargeability makes this battery optimal for every mobile use”. Describe qualitative material reversal and one limitation; no charging is performed.",
                "expectedPerformanceDe": "Die lernende Person erklärt, dass externe Energie PbSO4 wieder in die geladenen Elektrodenzustände umsetzt und die Säurezusammensetzung verändert; Elektronen werden nicht als verbrauchte Vorratsladung aufgefüllt. Sie begründet die Massengrenze für den tragbaren Einsatz und benennt sachgerechten Umgang/Entsorgung wegen Blei und Säure.",
                "expectedPerformanceEn": "The learner explains that external energy converts PbSO4 back into charged electrode states and changes acid composition; electrons are not replenished as a consumed stock. They justify the weight limit for portable use and identify proper handling/disposal because of lead and acid.",
                "understandingFocusDe": "Laden und ein geänderter Einsatz prüfen reversible Stoffumwandlung und Grenzen.",
                "understandingFocusEn": "Charging and a changed use probe reversible conversion and limitations."
              }
            ]
          }
        }
      ],

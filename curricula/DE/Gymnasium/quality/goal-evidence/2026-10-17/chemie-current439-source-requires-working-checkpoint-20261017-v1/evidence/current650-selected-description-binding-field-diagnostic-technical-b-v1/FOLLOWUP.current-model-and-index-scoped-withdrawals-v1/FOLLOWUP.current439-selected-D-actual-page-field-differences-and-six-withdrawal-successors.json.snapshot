      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "structure-model-reasoning",
                "essentialUnderstandingDe": "Die Hydroxygruppe von Ethanol ist polar, kann Wasserstoffbrücken bilden und erklärt zusammen mit dem Ethylrest ausgewählte Stoffeigenschaften.",
                "essentialUnderstandingEn": "Ethanol hydroxyl is polar and supports hydrogen bonding, explaining selected properties together with its ethyl group.",
                "observablePerformanceDe": "Die Person zeigt im selbst gezeichneten Ethanol-Wasser-Modell Donor und Akzeptor und trennt intermolekulare Anziehung von kovalenter OH-Bindung.",
                "observablePerformanceEn": "The learner shows donor and acceptor in an independently drawn ethanol-water model and distinguishes intermolecular attraction from the covalent OH bond."
              },
              {
                "id": "fresh-application-and-boundary",
                "essentialUnderstandingDe": "Hydroxygruppe bedeutet keine wässrige Hydroxidionenlösung; Mischbarkeit beweist weder Ionenleitung noch Dissoziation wie bei NaOH.",
                "essentialUnderstandingEn": "A hydroxyl group does not imply an aqueous hydroxide-ion solution; miscibility proves neither ionic conduction nor dissociation as in NaOH.",
                "observablePerformanceDe": "Die OH-Gruppe ist kovalent gebunden und trägt im neutralen Ethanol keine freie Hydroxidladung. Die gute Mischbarkeit wird durch polare Wechselwirkungen und Wasserstoffbrücken erklärt, nicht durch vollständige Bildung von Ethylkationen/Hydroxidionen. Das korrigierte Modell behauptet keine völlige Abwesenheit jeder Säure-Base-Reaktion; es widerlegt die falsche vollständige ionische Dissoziation als Mischbarkeitserklärung.",
                "observablePerformanceEn": "The OH group is covalently bonded and is not a free hydroxide ion in neutral ethanol. Miscibility is explained by polar interactions and hydrogen bonding, not complete formation of ethyl cations and hydroxide ions. The corrected model does not assert the complete absence of all acid-base chemistry; it rejects false complete ionic dissociation as the explanation of miscibility."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "structure-model-reasoning",
                "fresh-application-and-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "material-variation",
                "textDe": "Ethanol-Ethanol versus Ethanol-Wasser; Hydroxygruppe gegenüber gleichem Kohlenstoffrest ohne O.",
                "textEn": "Ethanol-ethanol versus ethanol-water; hydroxyl compared with the same carbon skeleton without O."
              },
              {
                "id": "counterexample",
                "textDe": "Hydroxygruppe bedeutet keine wässrige Hydroxidionenlösung; Mischbarkeit beweist weder Ionenleitung noch Dissoziation wie bei NaOH.",
                "textEn": "A hydroxyl group does not imply an aqueous hydroxide-ion solution; miscibility proves neither ionic conduction nor dissociation as in NaOH."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-current15-e1214210-case-1",
                "taskDemandDe": "Strukturen CH3CH2OH und CH3CH3, ergänzt um H2O; es geht ausschließlich um ein Strukturmodell. Leite zwei ausgewählte Unterschiede beim Sieden und Mischen mit Wasser aus der Hydroxygruppe ab und zeichne eine Wasserstoffbrücke.",
                "taskDemandEn": "Structures CH3CH2OH and CH3CH3, with H2O; this is solely a structural model. Derive two selected differences in boiling and water mixing from the hydroxyl group and draw a hydrogen bond.",
                "expectedPerformanceDe": "Ethanol kann über O-H und freie Elektronenpaare am O zusätzliche Wasserstoffbrücken bilden, Ethanmoleküle nicht in gleicher Weise. Ethanol siedet höher und mischt sich mit Wasser; die gestrichelte Brücke verbindet verschiedene Moleküle, nicht C und O im selben Molekül.",
                "expectedPerformanceEn": "Ethanol supports additional hydrogen bonding through O-H and O lone pairs, unlike ethane. Ethanol boils higher and mixes with water; the dashed hydrogen bond joins different molecules, not C and O within one molecule.",
                "understandingFocusDe": "Die kovalente O-H-Bindung im Molekül bleibt beim Verdampfen im Modell erhalten.",
                "understandingFocusEn": "The covalent intramolecular O-H bond remains intact during model evaporation."
              },
              {
                "id": "chem-current15-e1214210-case-2",
                "taskDemandDe": "Ein Modellzeichner schreibt: Weil Ethanol eine OH-Gruppe hat, zerfällt es in Wasser vollständig in OH− und C2H5+. Daneben steht das unveränderte Molekülmodell CH3CH2OH zwischen Wassermolekülen. Korrigiere die behauptete Erklärung und erkläre aus der Hydroxygruppe die Wechselwirkung mit Wasser ohne diese vollständige Spaltung.",
                "taskDemandEn": "A model author writes: Because ethanol has an OH group, it splits completely in water into OH− and C2H5+. Beside it is an unchanged CH3CH2OH molecule among water molecules. Correct the claimed explanation and use the hydroxyl group to explain water interactions without that complete splitting.",
                "expectedPerformanceDe": "Die OH-Gruppe ist kovalent gebunden und trägt im neutralen Ethanol keine freie Hydroxidladung. Die gute Mischbarkeit wird durch polare Wechselwirkungen und Wasserstoffbrücken erklärt, nicht durch vollständige Bildung von Ethylkationen/Hydroxidionen.",
                "expectedPerformanceEn": "The OH group is covalently bonded and is not a free hydroxide ion in neutral ethanol. Miscibility is explained by polar interactions and hydrogen bonding, not complete formation of ethyl cations and hydroxide ions.",
                "understandingFocusDe": "Das korrigierte Modell behauptet keine völlige Abwesenheit jeder Säure-Base-Reaktion; es widerlegt die falsche vollständige ionische Dissoziation als Mischbarkeitserklärung.",
                "understandingFocusEn": "The corrected model does not assert the complete absence of all acid-base chemistry; it rejects false complete ionic dissociation as the explanation of miscibility."
              }
            ]
          }
        }
      ],

      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "modeling",
            "expectations": [
              {
                "id": "structure-model-reasoning",
                "essentialUnderstandingDe": "Bei radikalischer Substitution erzeugt die Initiierung Radikale, die Kettenfortpflanzung erneuert den Kettenträger und Rekombination beendet einzelne Ketten.",
                "essentialUnderstandingEn": "In radical substitution initiation creates radicals, propagation regenerates the chain carrier and recombination terminates individual chains.",
                "observablePerformanceDe": "Die Person zeichnet ungepaarte Elektronen, bilanziert jede Modellstufe und erklärt, warum ein Radikal wieder erscheint.",
                "observablePerformanceEn": "The learner draws unpaired electrons, balances each model step and explains why a radical reappears."
              },
              {
                "id": "fresh-application-and-boundary",
                "essentialUnderstandingDe": "Ein ausgeglichener Gesamtumsatz erklärt noch keinen Mechanismus; die Kette liefert ohne kinetische Bedingungen keine genauen Produktanteile.",
                "essentialUnderstandingEn": "A balanced overall reaction does not itself explain a mechanism; the chain supplies no exact product fractions without kinetic conditions.",
                "observablePerformanceDe": "Br· + C2H6 → HBr + C2H5·; C2H5· + Br2 → C2H5Br + Br·. Zwei C2H5· bilden C4H10. Weitere Substitution und Abbruchprodukte sind prinzipiell möglich; das Erstmodell begründet keine reine Produktausbeute. Abbruch verbraucht Radikale ohne einen neuen Kettenträger zu erzeugen; Produktreinheit darf nicht aus der Summengleichung behauptet werden.",
                "observablePerformanceEn": "Br· + C2H6 → HBr + C2H5·; C2H5· + Br2 → C2H5Br + Br·. Two C2H5· form C4H10. Further substitution and termination products are possible; the initial model establishes no pure product yield. Termination consumes radicals without regenerating a carrier; product purity cannot be claimed from the overall equation."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "structure-model-reasoning",
                "fresh-application-and-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "material-variation",
                "textDe": "Methan versus Ethan, Kettenfortpflanzung versus Abbruch, einfacher Erstumsatz versus weitere Substitution.",
                "textEn": "Methane versus ethane, propagation versus termination, initial substitution versus further substitution."
              },
              {
                "id": "counterexample",
                "textDe": "Ein ausgeglichener Gesamtumsatz erklärt noch keinen Mechanismus; die Kette liefert ohne kinetische Bedingungen keine genauen Produktanteile.",
                "textEn": "A balanced overall reaction does not itself explain a mechanism; the chain supplies no exact product fractions without kinetic conditions."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-current15-3be2d0b7-case-1",
                "taskDemandDe": "Papiermodell: CH4 und Br2 unter Licht; nur die erste Substitution wird betrachtet. Keine Durchführung oder Mischanweisung. Formuliere Initiierung, zwei Fortpflanzungsschritte und einen möglichen Abbruch und leite den Gesamtumsatz her.",
                "taskDemandEn": "Paper model: CH4 and Br2 under light; only the first substitution is considered. No practical procedure or mixing instruction. Write initiation, two propagation steps and one possible termination, then derive the overall reaction.",
                "expectedPerformanceDe": "Br2 → 2 Br·; Br· + CH4 → HBr + CH3·; CH3· + Br2 → CH3Br + Br·; z.B. 2 Br· → Br2 als Abbruch. Die Summe der Fortpflanzung ist CH4 + Br2 → CH3Br + HBr.",
                "expectedPerformanceEn": "Br2 → 2 Br·; Br· + CH4 → HBr + CH3·; CH3· + Br2 → CH3Br + Br·; e.g. 2 Br· → Br2 for termination. Summing propagation gives CH4 + Br2 → CH3Br + HBr.",
                "understandingFocusDe": "Die Initiierung ist homolytische Spaltung; Br− oder Br+ als alleinige Kettenträger passen nicht zu diesem Radikalmodell.",
                "understandingFocusEn": "Initiation is homolytic cleavage; Br− or Br+ alone are not the chain carriers in this radical model."
              },
              {
                "id": "chem-current15-3be2d0b7-case-2",
                "taskDemandDe": "Frischer Papierfall: Ethan reagiert im gleichen vereinfachten Erstsubstitutionsmodell mit Brom; zwei Ethylradikale können zusammentreffen. Übertrage die Fortpflanzung auf Ethan und stelle den Abbruch durch zwei Ethylradikale dar. Beurteile die Aussage, ausschließlich Bromoethan müsse entstehen.",
                "taskDemandEn": "Fresh paper case: ethane reacts with bromine in the same simplified first-substitution model; two ethyl radicals may meet. Transfer propagation to ethane and draw termination by two ethyl radicals. Evaluate the claim that only bromoethane must form.",
                "expectedPerformanceDe": "Br· + C2H6 → HBr + C2H5·; C2H5· + Br2 → C2H5Br + Br·. Zwei C2H5· bilden C4H10. Weitere Substitution und Abbruchprodukte sind prinzipiell möglich; das Erstmodell begründet keine reine Produktausbeute.",
                "expectedPerformanceEn": "Br· + C2H6 → HBr + C2H5·; C2H5· + Br2 → C2H5Br + Br·. Two C2H5· form C4H10. Further substitution and termination products are possible; the initial model establishes no pure product yield.",
                "understandingFocusDe": "Abbruch verbraucht Radikale ohne einen neuen Kettenträger zu erzeugen; Produktreinheit darf nicht aus der Summengleichung behauptet werden.",
                "understandingFocusEn": "Termination consumes radicals without regenerating a carrier; product purity cannot be claimed from the overall equation."
              }
            ]
          }
        }
      ],

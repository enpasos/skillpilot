          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "b002-cdd4ee76-core",
                "essentialUnderstandingDe": "SN1 verläuft im vereinfachten Modell über eine geschwindigkeitsbestimmende Ionisierung; SN2 hat einen konzertierten Angriff. Daraus folgen verschiedene Kinetik und Einflüsse von Substrat und Lösungsmittel.",
                "essentialUnderstandingEn": "In the simplified model, SN1 involves rate-limiting ionization while SN2 has a concerted attack. This yields different kinetics and substrate and solvent effects.",
                "observablePerformanceDe": "Die lernende Person vergleicht für zwei gegebene Substrate Geschwindigkeitsgesetze, Zwischenstufe versus Übergangszustand und plausible Lösungsmittelwirkungen.",
                "observablePerformanceEn": "The learner compares rate laws, intermediate versus transition state, and plausible solvent effects for two supplied substrates."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b002-cdd4ee76-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "rate-law",
                "textDe": "Konzentrationsabhängigkeit eines und zweier Reaktionspartner wird verglichen.",
                "textEn": "Rate dependence on one versus two reactants is compared."
              },
              {
                "id": "substrate-solvent",
                "textDe": "Substratklasse und Lösungsmittel werden in einem zweiten Fall verändert.",
                "textEn": "Substrate class and solvent are changed in a second case."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "sn-rate-data",
                "taskDemandDe": "Zwei Halogenalkanreaktionen liefern bei sonst gleichen Bedingungen v=k[RX] und v=k[RX][Nu]. Ordne die vereinfachten SN1- und SN2-Modelle zu und begründe Zwischenstufe oder konzertierten Schritt.",
                "taskDemandEn": "Two haloalkane reactions under otherwise equal conditions give v=k[RX] and v=k[RX][Nu]. Match simplified SN1 and SN2 models and justify an intermediate or concerted step.",
                "expectedPerformanceDe": "Die lernende Person ordnet die erste Kinetik einer geschwindigkeitsbestimmenden Ionisierung und die zweite einem bimolekularen Angriff zu; sie benennt Carbokation versus Übergangszustand.",
                "expectedPerformanceEn": "The learner links the first kinetics to rate-limiting ionization and the second to bimolecular attack, naming carbocation versus transition state.",
                "understandingFocusDe": "Kinetik ist Evidenz für unterschiedliche Mechanismusmodelle.",
                "understandingFocusEn": "Kinetics is evidence for different mechanism models."
              },
              {
                "id": "fresh-substrate-solvent-choice",
                "taskDemandDe": "Ein neuer Vergleich enthält tert-Butylbromid in polarem protischem Medium und Brommethan mit starkem Nukleophil. Welcher Weg ist jeweils plausibler und welche Grenze hat die Kurzregel?",
                "taskDemandEn": "A new comparison gives tert-butyl bromide in a polar protic medium and bromomethane with a strong nucleophile. Which path is more plausible for each, and what limits the shortcut rule?",
                "expectedPerformanceDe": "Die lernende Person begründet SN1-Tendenz durch Carbokationstabilisierung und SN2-Tendenz durch geringe sterische Hinderung; sie nennt Konkurrenz von Reagenz, Medium und Bedingungen.",
                "expectedPerformanceEn": "The learner justifies an SN1 tendency through carbocation stabilization and an SN2 tendency through low steric hindrance, noting competition among reagent, medium, and conditions.",
                "understandingFocusDe": "Neue Bedingungen prüfen eine bedingte statt starre Zuordnung.",
                "understandingFocusEn": "New conditions test a conditional rather than rigid classification."
              }
            ]
          }
        }
      ],

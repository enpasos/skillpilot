            "archetype": "concept",
            "expectations": [
              {
                "id": "whole-duty-1",
                "essentialUnderstandingDe": "Alternativen Weg/Barrieren und beide Richtungen erklären.",
                "essentialUnderstandingEn": "Explain alternative pathway/barriers and both directions.",
                "observablePerformanceDe": "Alternativen Weg/Barrieren und beide Richtungen erklären. Zweiter unabhängiger Kontext: Beide Barrierendifferenzen richtig bestimmen.",
                "observablePerformanceEn": "Explain alternative pathway/barriers and both directions. Second independent context: Determine both barrier differences correctly."
              },
              {
                "id": "whole-duty-2",
                "essentialUnderstandingDe": "Zeit bis Gleichgewicht von Endausbeute/K trennen.",
                "essentialUnderstandingEn": "Distinguish time to equilibrium and final yield/K.",
                "observablePerformanceDe": "Zeit bis Gleichgewicht von Endausbeute/K trennen. Zweiter unabhängiger Kontext: Unveränderte Zustandsdifferenz und K erklären.",
                "observablePerformanceEn": "Distinguish time to equilibrium and final yield/K. Second independent context: Explain unchanged state difference and K."
              },
              {
                "id": "whole-duty-3",
                "essentialUnderstandingDe": "Homogenes Beispiel anhand Phase einordnen.",
                "essentialUnderstandingEn": "Classify homogeneous example by phase.",
                "observablePerformanceDe": "Homogenes Beispiel anhand Phase einordnen. Zweiter unabhängiger Kontext: Einstellzeit mit beiden Reaktionsrichtungen verknüpfen.",
                "observablePerformanceEn": "Classify homogeneous example by phase. Second independent context: Connect equilibration time with both directions."
              },
              {
                "id": "whole-duty-4",
                "essentialUnderstandingDe": "Heterogenes Beispiel anhand Phase einordnen.",
                "essentialUnderstandingEn": "Classify heterogeneous example by phase.",
                "observablePerformanceDe": "Heterogenes Beispiel anhand Phase einordnen. Zweiter unabhängiger Kontext: Beide Phasenbeispiele fachlich einordnen.",
                "observablePerformanceEn": "Classify heterogeneous example by phase. Second independent context: Classify both phase examples scientifically."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "whole-duty-1",
                "whole-duty-2",
                "whole-duty-3",
                "whole-duty-4"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "whole-case-material",
                "textDe": "Schnelleres Estergleichgewicht / Gleichgewichtsmodell mit Energieprofil",
                "textEn": "Faster ester equilibrium / Equilibrium model with energy profile"
              },
              {
                "id": "independent-transfer",
                "textDe": "Frisch: beide Proben sind schon im Gleichgewicht; nur einer wird Katalysator zugesetzt, T unverändert. / Frisch: Beim Katalysatorzusatz wird zugleich erwärmt. Kann ein geänderter Endumsatz allein dem Katalysator zugeschrieben werden?",
                "textEn": "Fresh: both samples are already at equilibrium; catalyst is added to one, T unchanged. / Fresh: catalyst addition also heats the mixture. Can a changed endpoint be attributed solely to catalyst?"
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "q3-06-a",
                "taskDemandDe": "Synthetische homogene Estermischungen bei gleichem T und Start erreichen ohne Katalysator nach60min, mit gelöstem Säurekatalysator nach10min denselben Endumsatz70%. Vergleichsprozess: gasförmige N₂/H₂-Reaktion an festem Eisen. Keine Versuchsanleitung. Erkläre Teilchenmodell, Gleichgewichtseinstellung und unveränderten Endzustand. Ordne beide Beispiele homogener bzw. heterogener Katalyse zu und widerlege „mehr Produkt, weil K steigt“. Separat frischer Transfer: Frisch: beide Proben sind schon im Gleichgewicht; nur einer wird Katalysator zugesetzt, T unverändert.",
                "expectedPerformanceDe": "Ein katalytischer Reaktionsweg besitzt geringere Aktivierungsbarrieren und beschleunigt Hin- und Rückreaktion. Das gleiche thermodynamische Gleichgewicht wird früher erreicht; K und70% Endumsatz bleiben bei T gleich. Gelöster Säurekatalysator und Reaktionsgemisch sind in einer Phase: homogen. Festes Eisen und Gasphase sind verschiedene Phasen: heterogen. In endlicher Zeit kann mehr Produkt vorliegen, ohne höhere Gleichgewichtsausbeute. Transferantwort: Keine Netto-Gleichgewichtsverschiebung; schnellere mikroskopische Hin-/Rückumsätze können dennoch auftreten. Scoring /10: 2P: Alternativen Weg/Barrieren und beide Richtungen erklären.; 2P: Zeit bis Gleichgewicht von Endausbeute/K trennen.; 2P: Homogenes Beispiel anhand Phase einordnen.; 2P: Heterogenes Beispiel anhand Phase einordnen.; 2P: Keine Netto-Gleichgewichtsverschiebung; schnellere mikroskopische Hin-/Rückumsätze können dennoch auftreten.",
                "understandingFocusDe": "Ganzes aktuelles Ziel einschließlich aller Operatoren; keine Punktvergabe für nicht ausgeführte Experimente. Eine Katalysecharakterisierung im Gleichgewicht: alternative Barrieren, schnellere Einstellung und Phasenzuordnung der Beispiele gehören zur Erklärung; keine K-Änderung behauptet.",
                "taskDemandEn": "Synthetic homogeneous ester mixtures at the same T and start reach the same70% final conversion after60min without catalyst and10min with dissolved acid catalyst. Comparison process: gaseous N₂/H₂ reaction on solid iron. No experiment instructions. Explain particle model, equilibration and unchanged endpoint. Classify both examples as homogeneous or heterogeneous catalysis and refute “more product because K rises”. Separate fresh transfer: Fresh: both samples are already at equilibrium; catalyst is added to one, T unchanged.",
                "expectedPerformanceEn": "A catalytic pathway has lower activation barriers and accelerates forward and reverse reactions. The same thermodynamic equilibrium is reached sooner; K and70% final conversion stay unchanged at T. Dissolved acid catalyst and reacting mixture share a phase: homogeneous. Solid iron and gas differ in phase: heterogeneous. More product may be present at a finite time without greater equilibrium yield. Transfer response: No net equilibrium shift; faster microscopic forward/reverse turnover may nevertheless occur. Scoring /10: 2P: Explain alternative pathway/barriers and both directions.; 2P: Distinguish time to equilibrium and final yield/K.; 2P: Classify homogeneous example by phase.; 2P: Classify heterogeneous example by phase.; 2P: No net equilibrium shift; faster microscopic forward/reverse turnover may nevertheless occur.",
                "understandingFocusEn": "Whole current goal including all operators; explain the evidence, perform the specified calculation or judgment and apply the separate fresh transfer. Synthetic authored work is not actual learner performance."
              },
              {
                "id": "q3-06-b",
                "taskDemandDe": "A⇌B, Energien A0 und B−20kJ/mol. Unkatalysierter Übergangszustand80, katalysierter40kJ/mol relativ zu A. Beispiele: löslicher Katalysator im Flüssiggemisch und fester Platinkatalysator für Gasreaktion. Dieselbe Temperatur, keine Nebenreaktionen. Vergleiche Aktivierungsbarrieren in beiden Richtungen, Gleichgewichtskonstante und Einstellzeit. Erläutere die Katalyseformen an den Beispielen. Separat frischer Transfer: Frisch: Beim Katalysatorzusatz wird zugleich erwärmt. Kann ein geänderter Endumsatz allein dem Katalysator zugeschrieben werden?",
                "expectedPerformanceDe": "Hinbarriere sinkt80→40, Rückbarriere100→60kJ/mol; die Energiedifferenz der Zustände bleibt−20. Beide Richtungen werden schneller, Einstellung früher, K unverändert. Löslicher Katalysator in derselben Flüssigphase ist homogen; Gas an festem Pt heterogen. Aus den Barrieren allein folgt kein numerischer neuer K-Wert oder universell gleicher Beschleunigungsfaktor. Transferantwort: Nein; Temperatur kann K verändern. Die Variablen müssen getrennt werden, bevor die reine Katalysatorwirkung bewertet wird. Scoring /10: 2P: Beide Barrierendifferenzen richtig bestimmen.; 2P: Unveränderte Zustandsdifferenz und K erklären.; 2P: Einstellzeit mit beiden Reaktionsrichtungen verknüpfen.; 2P: Beide Phasenbeispiele fachlich einordnen.; 2P: Nein; Temperatur kann K verändern. Die Variablen müssen getrennt werden, bevor die reine Katalysatorwirkung bewertet wird.",
                "understandingFocusDe": "Ganzes aktuelles Ziel einschließlich aller Operatoren; keine Punktvergabe für nicht ausgeführte Experimente. Eine Katalysecharakterisierung im Gleichgewicht: alternative Barrieren, schnellere Einstellung und Phasenzuordnung der Beispiele gehören zur Erklärung; keine K-Änderung behauptet.",
                "taskDemandEn": "A⇌B with energies A0 and B−20kJ/mol. Uncatalysed transition state80, catalysed40kJ/mol relative to A. Examples: soluble catalyst in a liquid mixture and solid platinum for a gas reaction. Same temperature, no side reactions. Compare activation barriers in both directions, equilibrium constant and equilibration time. Explain catalysis types using the examples. Separate fresh transfer: Fresh: catalyst addition also heats the mixture. Can a changed endpoint be attributed solely to catalyst?",
                "expectedPerformanceEn": "Forward barrier drops80→40 and reverse100→60kJ/mol; state energy difference stays−20. Both directions accelerate, equilibrium is reached sooner and K is unchanged. Soluble catalyst in the same liquid phase is homogeneous; gas on solid Pt heterogeneous. Barriers alone do not give a numerical new K or universally identical acceleration factors. Transfer response: No; temperature can change K. Variables must be separated before evaluating catalyst effect alone. Scoring /10: 2P: Determine both barrier differences correctly.; 2P: Explain unchanged state difference and K.; 2P: Connect equilibration time with both directions.; 2P: Classify both phase examples scientifically.; 2P: No; temperature can change K. Variables must be separated before evaluating catalyst effect alone.",
                "understandingFocusEn": "Whole current goal including all operators; explain the evidence, perform the specified calculation or judgment and apply the separate fresh transfer. Synthetic authored work is not actual learner performance."
              }
            ]
          }
        }
      ],

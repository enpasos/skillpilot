      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "experiment",
            "expectations": [
              {
                "id": "core-understanding",
                "essentialUnderstandingDe": "Qualitative Ionenanalyse benötigt selektive Nachweise, getrennte Proben, Kontrollen und eine begrenzte Stoffhypothese. Positive Teilnachweise belegen ausgewählte Bestandteile; Zusammensetzung, Stoffmengen und Herkunft lassen sich daraus nicht beliebig eindeutig rekonstruieren.",
                "essentialUnderstandingEn": "Qualitative ion analysis requires selective tests, separate portions, controls and bounded composition hypotheses. Positive tests support selected components; amounts, provenance and exact composition cannot be inferred without limits.",
                "observablePerformanceDe": "Unter der ausdrücklich binären Reinstoffannahme ist A NaCl. Ag+ + Cl− → AgCl↓ erklärt den weißen Niederschlag. Der negative Sulfattest widerspricht hier Na2SO4, sofern die durch Kontrollen geprüfte Empfindlichkeit ausreicht. Ba2+ + SO42− → BaSO4↓ wäre die positive Sulfatreaktion. Leerproben begrenzen Reagenzverunreinigung, positive Kontrollen prüfen Funktionsfähigkeit. Der Natrium-Nachweis unterscheidet die beiden Kandidaten nicht. Ohne die vorgegebene Auswahl wären weitere Ionen und Störungen möglich.",
                "observablePerformanceEn": "Within the explicit binary pure-substance assumption A is NaCl. Ag+ + Cl− → AgCl↓ explains the white precipitate. The negative sulfate test argues against Na2SO4 here if sensitivity confirmed by controls is sufficient. A positive sulfate test would be Ba2+ + SO42− → BaSO4↓. Blanks check reagent contamination and positive controls check functioning. The sodium test does not distinguish these candidates. Without the stated candidate restriction, additional ions and interferences could occur."
              },
              {
                "id": "fresh-transfer-and-limit",
                "essentialUnderstandingDe": "Ein erlaubter Zweistoff-Salzkandidat mit Chlorid- und Sulfatkontrollen gegenüber einem unbekannten Produktgemisch mit belegten Ionen und offenem Mischungsverhältnis. Vorhandene Ionen in Lösung beweisen keine eindeutige Paarung im ursprünglichen Salzgemisch.",
                "essentialUnderstandingEn": "A restricted two-salt candidate set with chloride and sulfate controls versus an unknown product mixture with supported ions but an unresolved mixing ratio. Detected solution ions do not establish unique pairings in the original salt mixture.",
                "observablePerformanceDe": "Natrium und Chlorid sind mit der NaCl-Angabe vereinbar; sie beweisen bei einem beliebigen Gemisch aber nicht allein, dass sämtliches Natrium mit Chlorid verknüpft aus NaCl stammt. Der gültige positive Sulfattest widerspricht „keine Sulfate“. Chlorid, Sulfat und Natrium sind qualitativ belegt; weitere Kationen, genaue Salzarten und Massenanteile bleiben offen. In Lösung sind Ionen getrennt vorhanden; das ursprüngliche Salzgemisch ist ohne zusätzliche Einschränkungen nicht eindeutig rekonstruierbar. Mengenbehauptungen brauchen quantitative Analyse. C ist sauer mit überwiegendem H3O+, D basisch mit überwiegendem OH−; beide widersprechen der angegebenen Neutralität. Natrium-/Chloridnachweise erfassen diese Protonen-/Hydroxidverhältnisse nicht. Als mögliche, nicht bewiesene Modellbeispiele wären NaCl plus HCl beziehungsweise NaCl plus NaOH vereinbar; pH allein identifiziert weder die zugrunde liegende Säure/Base noch deren Gesamtkonzentration.",
                "observablePerformanceEn": "Sodium and chloride are compatible with NaCl, but in an arbitrary mixture do not prove that all these ions originated together as NaCl. A valid positive sulfate result contradicts “no sulfates.” Chloride, sulfate and sodium are qualitatively supported; other cations, original salts and mass fractions remain unknown. Solution ions do not uniquely reconstruct the original salt mixture; amount claims need quantitative analysis. C is acidic with predominant H3O+ and D basic with predominant OH−; both contradict stated neutrality. Sodium/chloride tests do not measure these proton/hydroxide ratios. Possible, unproven model examples are NaCl plus HCl and NaCl plus NaOH respectively; pH alone identifies neither the source acid/base nor its total concentration."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "core-understanding",
                "fresh-transfer-and-limit"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-system-variation",
                "textDe": "Ein erlaubter Zweistoff-Salzkandidat mit Chlorid- und Sulfatkontrollen gegenüber einem unbekannten Produktgemisch mit belegten Ionen und offenem Mischungsverhältnis.",
                "textEn": "A restricted two-salt candidate set with chloride and sulfate controls versus an unknown product mixture with supported ions but an unresolved mixing ratio."
              },
              {
                "id": "model-boundary",
                "textDe": "Vorhandene Ionen in Lösung beweisen keine eindeutige Paarung im ursprünglichen Salzgemisch.",
                "textEn": "Detected solution ions do not establish unique pairings in the original salt mixture."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next20-a44af1fa-case-1",
                "taskDemandDe": "Fiktive Auswertung einer bereits fachgerecht durchgeführten Analyse, keine Durchführung verlangt: Probe A ist laut Aufgabenannahme entweder reines NaCl oder reines Na2SO4. Bei einer geeignet vorbehandelten getrennten Teilprobe ergibt der Chloridtest mit Ag+-Reagenz einen weißen Niederschlag; der Sulfattest mit Ba2+-Reagenz ist negativ. Reagenz-Leerproben sind negativ, positive Kontrolllösungen reagieren erwartungsgemäß. Beide Salze liefern denselben Natrium-Nachweis. Bestimme A innerhalb der erlaubten Kandidaten und formuliere die Nachweisgleichung. Erkläre die Funktion der Kontrollen und die Grenze der Natrium-Beobachtung.",
                "taskDemandEn": "Fictional evaluation of an already professionally performed analysis, not a request to perform it: under the supplied assumption sample A is either pure NaCl or pure Na2SO4. In a suitably pretreated separate portion, an Ag+ chloride test gives a white precipitate; a Ba2+ sulfate test is negative. Reagent blanks are negative and positive controls react as expected. Both salts give the same sodium test. Identify A within the allowed candidates and write the detection equation. Explain the controls and the limit of the sodium observation.",
                "expectedPerformanceDe": "Unter der ausdrücklich binären Reinstoffannahme ist A NaCl. Ag+ + Cl− → AgCl↓ erklärt den weißen Niederschlag. Der negative Sulfattest widerspricht hier Na2SO4, sofern die durch Kontrollen geprüfte Empfindlichkeit ausreicht. Ba2+ + SO42− → BaSO4↓ wäre die positive Sulfatreaktion. Leerproben begrenzen Reagenzverunreinigung, positive Kontrollen prüfen Funktionsfähigkeit. Der Natrium-Nachweis unterscheidet die beiden Kandidaten nicht. Ohne die vorgegebene Auswahl wären weitere Ionen und Störungen möglich.",
                "expectedPerformanceEn": "Within the explicit binary pure-substance assumption A is NaCl. Ag+ + Cl− → AgCl↓ explains the white precipitate. The negative sulfate test argues against Na2SO4 here if sensitivity confirmed by controls is sufficient. A positive sulfate test would be Ba2+ + SO42− → BaSO4↓. Blanks check reagent contamination and positive controls check functioning. The sodium test does not distinguish these candidates. Without the stated candidate restriction, additional ions and interferences could occur.",
                "understandingFocusDe": "Ein weißer Niederschlag ohne Reagenz-, Vorbehandlungs- und Kandidateninformation ist keine eindeutige Identifikation.",
                "understandingFocusEn": "A white precipitate without reagent, pretreatment and candidate information is not a unique identification."
              },
              {
                "id": "chem-next20-a44af1fa-case-2",
                "taskDemandDe": "Frisches fiktives Produktetikett: „Enthält Natriumchlorid; keine Sulfate“. Bei geeigneten getrennten Proben zeigen Chlorid- und Sulfatnachweise positive Ergebnisse; zugehörige Kontrollen sind gültig. Der Natrium-Nachweis ist ebenfalls positiv. Andere Kationen sind nicht geprüft; quantitative Messdaten fehlen. Zwei weitere wässrige Produktproben C und D enthalten ebenfalls Natrium- und Chloridionen. Ein separat kalibrierter pH-Nachweis gibt C: pH 2, D: pH 12 bei 25 °C. Beide Etiketten behaupten „neutrale reine Kochsalzlösung“; Störstoffe der pH-Messung sind im Modell ausgeschlossen. Prüfe alle Etikettaussagen. Formuliere die belegte Zusammensetzung und die offenen Mischungsverhältnisse. Deute C und D zusätzlich über H3O+/OH− und erkläre, warum Natrium-/Chloridnachweise den sauren oder basischen Anteil nicht ausschließen.",
                "taskDemandEn": "Fresh fictional product label: “Contains sodium chloride; no sulfates.” Suitable separate portions test positive for chloride and sulfate, with valid controls. Sodium is also detected. Other cations have not been tested and no quantitative measurements exist. Two further aqueous product samples C and D also contain sodium and chloride. A separately calibrated pH measurement gives C: pH 2, D: pH 12 at 25 °C. Both labels claim “neutral pure table-salt solution”; the model excludes pH-measurement interference. Evaluate all label statements. State supported composition and unknown mixture proportions. Interpret C and D using H3O+/OH− and explain why sodium/chloride tests do not exclude acidic or basic components.",
                "expectedPerformanceDe": "Natrium und Chlorid sind mit der NaCl-Angabe vereinbar; sie beweisen bei einem beliebigen Gemisch aber nicht allein, dass sämtliches Natrium mit Chlorid verknüpft aus NaCl stammt. Der gültige positive Sulfattest widerspricht „keine Sulfate“. Chlorid, Sulfat und Natrium sind qualitativ belegt; weitere Kationen, genaue Salzarten und Massenanteile bleiben offen. In Lösung sind Ionen getrennt vorhanden; das ursprüngliche Salzgemisch ist ohne zusätzliche Einschränkungen nicht eindeutig rekonstruierbar. Mengenbehauptungen brauchen quantitative Analyse. C ist sauer mit überwiegendem H3O+, D basisch mit überwiegendem OH−; beide widersprechen der angegebenen Neutralität. Natrium-/Chloridnachweise erfassen diese Protonen-/Hydroxidverhältnisse nicht. Als mögliche, nicht bewiesene Modellbeispiele wären NaCl plus HCl beziehungsweise NaCl plus NaOH vereinbar; pH allein identifiziert weder die zugrunde liegende Säure/Base noch deren Gesamtkonzentration.",
                "expectedPerformanceEn": "Sodium and chloride are compatible with NaCl, but in an arbitrary mixture do not prove that all these ions originated together as NaCl. A valid positive sulfate result contradicts “no sulfates.” Chloride, sulfate and sodium are qualitatively supported; other cations, original salts and mass fractions remain unknown. Solution ions do not uniquely reconstruct the original salt mixture; amount claims need quantitative analysis. C is acidic with predominant H3O+ and D basic with predominant OH−; both contradict stated neutrality. Sodium/chloride tests do not measure these proton/hydroxide ratios. Possible, unproven model examples are NaCl plus HCl and NaCl plus NaOH respectively; pH alone identifies neither the source acid/base nor its total concentration.",
                "understandingFocusDe": "Vorhandene Ionen in Lösung beweisen keine eindeutige Paarung im ursprünglichen Salzgemisch.",
                "understandingFocusEn": "Detected solution ions do not establish unique pairings in the original salt mixture."
              }
            ]
          }
        }
      ],
      "oldPProfilePresent": false,

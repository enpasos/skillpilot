      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "b010-d726-lime-cycle-transformations",
                "essentialUnderstandingDe": "Beim Brennen zerfällt Calciumcarbonat zu Calciumoxid und CO₂; beim Löschen reagiert Calciumoxid mit Wasser zu Calciumhydroxid; beim Abbinden reagiert Calciumhydroxid mit CO₂ wieder zu Calciumcarbonat und Wasser. Der vereinfachte Kreislauf verbindet drei Stoffumwandlungen, kein unveränderter Stoff oder bloßer Phasenwechsel läuft im Kreis.",
                "essentialUnderstandingEn": "Calcination decomposes calcium carbonate to calcium oxide and CO₂; slaking reacts calcium oxide with water to form calcium hydroxide; setting reacts calcium hydroxide with CO₂ to form calcium carbonate and water again. The simplified cycle links three substance transformations; no unchanged substance or mere phase change circles around.",
                "observablePerformanceDe": "Die lernende Person ordnet neue Stoff- oder Beobachtungsdaten den Schritten zu, benennt jeweils benötigte Reaktionspartner und Produkte, kann die passenden ausgeglichenen Gleichungen angeben und erklärt die Rückkehr zum Carbonat samt Rolle des CO₂.",
                "observablePerformanceEn": "The learner assigns new substance or observation data to the steps, names the required reactants and products, can give the corresponding balanced equations, and explains the return to carbonate and the role of CO₂."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b010-d726-lime-cycle-transformations"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "entry-point-and-material-state",
                "textDe": "Ein Fall beginnt bei Branntkalk statt bei Kalkstein und verlangt die richtige Fortsetzung und Rückkehr zum Carbonat.",
                "textEn": "One case starts with quicklime instead of limestone and asks for the correct continuation and return to carbonate."
              },
              {
                "id": "carbon-dioxide-control",
                "textDe": "Ein zweiter Fall variiert bei gleichem gelöschtem Kalk den CO₂-Zutritt und prüft, ob Wasser allein das Abbinden zu Carbonat erklären kann.",
                "textEn": "A second case varies CO₂ access for the same slaked lime and tests whether water alone can explain setting to carbonate."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "quicklime-start-and-return",
                "taskDemandDe": "Ohne Kreislaufbild ist eine Dose mit CaO als Ausgangspunkt angegeben. Nach Zugabe von Wasser entsteht Stoff A; nach längerem Kontakt von A mit Luft-CO₂ entsteht wieder ein Carbonat B. Benenne A und B, gib die beiden ausgeglichenen Stoffgleichungen an und erkläre, durch welchen vorausgehenden Schritt aus B erneut CaO gewonnen werden kann. Die Situation ist nur eine Papieraufgabe, kein Versuch.",
                "taskDemandEn": "Without a cycle diagram, a container of CaO is the starting point. Adding water gives substance A; after longer contact of A with atmospheric CO₂ a carbonate B forms again. Name A and B, give the two balanced substance equations, and explain which preceding step could produce CaO from B again. This is a written task, not an experiment.",
                "expectedPerformanceDe": "A ist Ca(OH)₂: CaO + H₂O → Ca(OH)₂. B ist CaCO₃: Ca(OH)₂ + CO₂ → CaCO₃ + H₂O. Erhitzen von CaCO₃ beim Brennen liefert wieder CaO und CO₂: CaCO₃ → CaO + CO₂. Wasserzugabe und Abbinden sind unterschiedliche chemische Reaktionen; die reale Brennstufe erfordert hohe Temperatur.",
                "expectedPerformanceEn": "A is Ca(OH)₂: CaO + H₂O → Ca(OH)₂. B is CaCO₃: Ca(OH)₂ + CO₂ → CaCO₃ + H₂O. Heating CaCO₃ during calcination gives CaO and CO₂ again: CaCO₃ → CaO + CO₂. Water addition and setting are different chemical reactions; actual calcination needs high temperature.",
                "understandingFocusDe": "Transfer mit neuem Startpunkt und stofflicher Bilanz der drei Schritte, statt die Pfeile eines Bildes auswendig wiederzugeben.",
                "understandingFocusEn": "Transfer from a new starting point with material balance across all three steps, rather than memorizing arrows in an image."
              },
              {
                "id": "sealed-versus-air-exposed-mortar-data",
                "taskDemandDe": "Zwei bereits gelöschte Kalkproben mit gleichem Ca(OH)₂- und Wasseranteil werden in einem gelieferten Datensatz verglichen: Probe I hat Zutritt zu normaler Luft, Probe II bleibt unter CO₂-armer Schutzatmosphäre; nur bei I weist ein Test später deutlich Carbonat nach. Erkläre den Unterschied chemisch, formuliere die Abbinde-Reaktion und begründe, warum bloßes Trocknen bei II nicht denselben Carbonatnachweis liefert. Keine praktische Durchführung.",
                "taskDemandEn": "A supplied data set compares two already slaked lime samples with the same Ca(OH)₂ and water content: sample I has access to ordinary air, whereas sample II is kept under a CO₂-poor atmosphere; only I later shows a clear carbonate test. Explain the chemical difference, write the setting reaction, and explain why mere drying in II does not yield the same carbonate evidence. No practical procedure is requested.",
                "expectedPerformanceDe": "Luft-CO₂ reagiert in I mit Ca(OH)₂ zu CaCO₃ und H₂O: Ca(OH)₂ + CO₂ → CaCO₃ + H₂O. In II fehlt weitgehend der benötigte CO₂-Reaktionspartner; Wasserverdunstung kann die Probe trocknen, bildet aber für sich kein Carbonat. Das ist ein Stoffumwandlungs- und kein bloßes Phasenwechselargument.",
                "expectedPerformanceEn": "Atmospheric CO₂ reacts with Ca(OH)₂ in I to form CaCO₃ and H₂O: Ca(OH)₂ + CO₂ → CaCO₃ + H₂O. In II the necessary CO₂ reactant is largely absent; water evaporation may dry the sample but does not by itself form carbonate. This is a substance-transformation argument, not merely a phase-change argument.",
                "understandingFocusDe": "Unabhängiger Transfer auf einen Kontrollvergleich, der den CO₂-Bedarf und die Grenze des Trockenmodells offenlegt.",
                "understandingFocusEn": "Independent transfer to a control comparison revealing the need for CO₂ and the limit of a drying-only model."
              }
            ]
          }
        }
      ],

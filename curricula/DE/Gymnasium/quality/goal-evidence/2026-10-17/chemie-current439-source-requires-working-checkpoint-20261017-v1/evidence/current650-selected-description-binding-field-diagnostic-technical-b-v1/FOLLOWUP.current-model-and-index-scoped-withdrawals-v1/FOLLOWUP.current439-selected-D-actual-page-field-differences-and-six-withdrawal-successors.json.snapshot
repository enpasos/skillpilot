      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "content-specific-understanding",
                "essentialUnderstandingDe": "Elektronen werden einzeln lokal registriert,aber vieleNachweise ergeben unter kohärenten Bedingungen einInterferenzmuster;klassischeKugel- undWellenmodelle erklären jeweils nurTeilaspekte. Welche-Weg-Information verändert dieInterferenzbedingungen.",
                "essentialUnderstandingEn": "Electrons are registered locally one at a time,but many detections form interference under coherent conditions;classical particle and wave models explain only parts.Which-path information changes interference conditions.",
                "observablePerformanceDe": "LokaleEinzelklicks zeigenDetektions-/Teilchenaspekt;Häufigkeitsinterferenz zeigtWellenaspekt des quantenmechanischenZustands. Eine klassischeSumme zweierKugelverteilungen erklärt kohärenteMinima nicht. Historisch liefernWellen- undTeilchenerkenntnisse Anlass für dasQuantenmodell statt beliebigem Wechsel zweier unveränderterKlassikmodelle.",
                "observablePerformanceEn": "Local clicks show the detection/particle aspect;accumulated interference shows the state’s wave aspect.A classical sum of two particle distributions does not explain coherent minima.Historically,wave and particle evidence motivates a quantum model rather than arbitrary switching between unchanged classical models."
              },
              {
                "id": "fresh-transfer-and-model-boundary",
                "essentialUnderstandingDe": "„KeineInterferenz“ erlaubt ohnegegebeneDetails keine universelleVorhersage exaktzweier schmalerStreifen;auchEinzelspaltbeugung undDetektorauflösung könnenrelevantbleiben.",
                "essentialUnderstandingEn": "“No interference”does not universally predict exactly two narrow bands without setup details;single-slit diffraction and detector resolution may remain relevant.",
                "observablePerformanceDe": "DierelevanteÄnderung ist physischeWegmessung/Wechselwirkung undverfügbareWeginformation,nichtmenschlichesBewusstsein. LokaleNachweise gibt esinbeidenFällen;die kohärenteInterferenzbedingungen sindnun verändert. DasQuantenmodell verbindet beideAspekte abhängig vomAufbau.",
                "observablePerformanceEn": "The relevant change is physical path measurement/interaction and available path information,not human consciousness.Local detections occur in both cases;coherent interference conditions have changed.The quantum model connects both aspects depending on the setup."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "content-specific-understanding",
                "fresh-transfer-and-model-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-material-variation",
                "textDe": "Einzelereignis gegenüberHäufigkeitsmuster;offeneSpalte ohneWegdetektion gegenüber physischerWegmessung.",
                "textEn": "Individual event versus accumulated pattern;open slits without path detection versus physical path measurement."
              },
              {
                "id": "specific-model-limit",
                "textDe": "„KeineInterferenz“ erlaubt ohnegegebeneDetails keine universelleVorhersage exaktzweier schmalerStreifen;auchEinzelspaltbeugung undDetektorauflösung könnenrelevantbleiben.",
                "textEn": "“No interference”does not universally predict exactly two narrow bands without setup details;single-slit diffraction and detector resolution may remain relevant."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next25-2bc1a15b-case-1",
                "taskDemandDe": "Referenzdaten einesElektronen-Doppelspalts:einzelne Detektorklicks bleiben lokal;nachvielen einzeln ausgesandtenElektronen entstehen mehrere abwechselndeMaxima/Minima. Quelle kohärent,beideSpalteoffen,keineWelche-Weg-Aufzeichnung. HistorischerVergleich:Youngs Lichtinterferenz vor späterenMateriewellen-/Elektronenversuchen. Ordne lokalenNachweis undInterferenz denModellaspekten zu undbegründe diehistorischeErweiterung gegenüber nur klassischenKugeln.",
                "taskDemandEn": "Reference electron double-slit data:individual detector clicks are local;many individually emitted electrons produce alternating maxima/minima.The source is coherent,both slits open,no which-path recording.Historical comparison:Young’s light interference predates later matter-wave/electron experiments. Assign local detection and interference to model aspects;explain the historical extension beyond classical particles alone.",
                "expectedPerformanceDe": "LokaleEinzelklicks zeigenDetektions-/Teilchenaspekt;Häufigkeitsinterferenz zeigtWellenaspekt des quantenmechanischenZustands. Eine klassischeSumme zweierKugelverteilungen erklärt kohärenteMinima nicht. Historisch liefernWellen- undTeilchenerkenntnisse Anlass für dasQuantenmodell statt beliebigem Wechsel zweier unveränderterKlassikmodelle.",
                "expectedPerformanceEn": "Local clicks show the detection/particle aspect;accumulated interference shows the state’s wave aspect.A classical sum of two particle distributions does not explain coherent minima.Historically,wave and particle evidence motivates a quantum model rather than arbitrary switching between unchanged classical models.",
                "understandingFocusDe": "DerFall beweist keine ausgelesene klassischeBahn jedesElektrons durch einenbestimmtenSpalt.",
                "understandingFocusEn": "The case establishes no measured classical path of each electron through one particular slit."
              },
              {
                "id": "chem-next25-2bc1a15b-case-2",
                "taskDemandDe": "Frischer Aufbaubefund:EinephysischeWegdetektion speichert zuverlässig,welchenSpalt einElektron passierte;imReferenzprotokoll fehlt dieMehrspaltinterferenz. EinText behauptet,einMensch müsse nur hinschauen,damitElektronen zuKugelnwerden. Korrigiere dieBeobachterbehauptung unddeute denUnterschied zumerstenFall;trenneDetektionsereignis,Weginformation undMuster.",
                "taskDemandEn": "Fresh setup:physical path detection reliably records which slit an electron passed;the reference protocol loses the multi-slit interference.A text claims a person merely looking turns electrons into particles. Correct the observer claim and interpret the difference from case1;distinguish detection event,path information and pattern.",
                "expectedPerformanceDe": "DierelevanteÄnderung ist physischeWegmessung/Wechselwirkung undverfügbareWeginformation,nichtmenschlichesBewusstsein. LokaleNachweise gibt esinbeidenFällen;die kohärenteInterferenzbedingungen sindnun verändert. DasQuantenmodell verbindet beideAspekte abhängig vomAufbau.",
                "expectedPerformanceEn": "The relevant change is physical path measurement/interaction and available path information,not human consciousness.Local detections occur in both cases;coherent interference conditions have changed.The quantum model connects both aspects depending on the setup.",
                "understandingFocusDe": "„KeineInterferenz“ erlaubt ohnegegebeneDetails keine universelleVorhersage exaktzweier schmalerStreifen;auchEinzelspaltbeugung undDetektorauflösung könnenrelevantbleiben.",
                "understandingFocusEn": "“No interference”does not universally predict exactly two narrow bands without setup details;single-slit diffraction and detector resolution may remain relevant."
              }
            ]
          }
        }
      ],

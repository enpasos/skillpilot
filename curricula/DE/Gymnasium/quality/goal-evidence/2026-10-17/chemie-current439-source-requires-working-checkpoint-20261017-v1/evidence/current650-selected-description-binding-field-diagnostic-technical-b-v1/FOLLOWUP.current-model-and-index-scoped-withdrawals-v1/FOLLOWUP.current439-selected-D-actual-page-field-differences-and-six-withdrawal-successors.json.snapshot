          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "b003-321d801d-core",
                "essentialUnderstandingDe": "Hybridisierungsmodelle betonen lokale Orbitalrichtung und σ/π-Bindungen, Computer-Modelle räumliche Geometrie aus Annahmen; keines zeigt automatisch die vollständige Elektronendynamik.",
                "essentialUnderstandingEn": "Hybridization models emphasize local orbital direction and sigma/pi bonds, while computer models show spatial geometry based on assumptions; neither automatically shows full electron dynamics.",
                "observablePerformanceDe": "Die lernende Person vergleicht für dasselbe Molekül zwei Darstellungen und begründet, welche Frage zu Bindungstyp oder Raumform jeweils besser beantwortet wird.",
                "observablePerformanceEn": "The learner compares two representations of the same molecule and justifies which better answers a bonding or spatial-shape question."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b003-321d801d-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "question",
                "textDe": "Bindungsfrage und Raumformfrage erfordern andere Modelldetails.",
                "textEn": "Bonding and spatial-shape questions need different model details."
              },
              {
                "id": "molecule",
                "textDe": "Kleines Methan und konformationsreiches Cyclohexan werden verglichen.",
                "textEn": "Small methane and conformationally rich cyclohexane are compared."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "methane-two-models",
                "taskDemandDe": "Zu Methan liegen ein sp3-Hybridorbitalbild und ein digitales Kugel-Stab-Modell vor. Welches zeigt lokale σ-Bindungsrichtungen, welches die räumliche Form? Nenne je eine Grenze.",
                "taskDemandEn": "For methane, an sp3 hybrid-orbital image and a digital ball-and-stick model are supplied. Which shows local sigma directions and which spatial shape? Name one limit of each.",
                "expectedPerformanceDe": "Die lernende Person ordnet σ-Erklärung dem Hybridbild und tetraedrische Anordnung der 3D-Ansicht zu; sie behauptet nicht, Kugeln seien echte Atomoberflächen oder Hybridorbitale direkt fotografiert.",
                "expectedPerformanceEn": "The learner assigns sigma explanation to the hybrid image and tetrahedral arrangement to the 3D view; they do not claim balls are real atom surfaces or hybrid orbitals photographed directly.",
                "understandingFocusDe": "Modellauswahl folgt der fachlichen Frage.",
                "understandingFocusEn": "Model choice follows the scientific question."
              },
              {
                "id": "fresh-cyclohexane-question",
                "taskDemandDe": "Eine neue Aufgabe fragt, welche Cyclohexan-Konformation räumlich plausibel ist und ob die einzelnen C-Zentren sp3 sind. Wähle für jede Teilfrage ein geeignetes Modell und erkläre die Grenzen.",
                "taskDemandEn": "A fresh task asks which cyclohexane conformation is spatially plausible and whether individual carbon centers are sp3. Choose a suitable model for each question and explain limits.",
                "expectedPerformanceDe": "Die lernende Person nutzt 3D-Modellierung für die Ringkonformation und Hybridisierung für lokale C-Bindungsgeometrie; sie kennzeichnet berechnete Modelle als modellabhängig.",
                "expectedPerformanceEn": "The learner uses 3D modelling for ring conformation and hybridization for local C bonding geometry, marking computed structures as model-dependent.",
                "understandingFocusDe": "Neuer Modellbedarf prüft begründete Auswahl.",
                "understandingFocusEn": "A new model need tests justified selection."
              }
            ]
          }
        }
      ],

      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "modeling",
            "expectations": [
              {
                "id": "suitable-reversible-cell",
                "essentialUnderstandingDe": "Beim Entladen einer geeigneten reversibel arbeitenden Zelle treibt der freiwillige chemische Vorgang die Abgabe elektrischer Energie. Beim Laden liefert eine äußere Quelle elektrische Energie und erzwingt die geeignete umgekehrte chemische Betriebsrichtung.",
                "essentialUnderstandingEn": "During discharge of a suitable reversible cell, a spontaneous chemical process supplies electrical energy. During charging, an external source supplies electrical energy and forces the suitable reverse chemical operating direction.",
                "observablePerformanceDe": "Die lernende Person vergleicht anhand eines neuen gegebenen geeigneten Zellmodells die beiden chemischen Betriebsrichtungen, Energieflüsse und Elektronenabgabe/-aufnahme, ohne aus dem Orientierungsbild eine vollständige Zellchemie abzulesen.",
                "observablePerformanceEn": "Using a fresh supplied suitable cell model, the learner compares chemical operating directions, energy flows and electron loss/gain without treating the orientation image as a complete cell chemistry."
              },
              {
                "id": "everyday-claims-with-limits",
                "essentialUnderstandingDe": "Wiederaufladbarkeit setzt passende Zellchemie und Betriebsbedingungen voraus. Leer bezeichnet mangelnde Nutzbarkeit für die Anwendung, nicht automatisch chemisches Gleichgewicht oder völlige Abwesenheit gespeicherter Energie; angelegte Spannung macht nicht jede Batterie reversibel.",
                "essentialUnderstandingEn": "Rechargeability requires suitable cell chemistry and operating conditions. Empty denotes insufficient usability for the application, not automatically chemical equilibrium or complete absence of stored energy; applied voltage does not make every battery reversible.",
                "observablePerformanceDe": "Die lernende Person beurteilt neue Alltagsbehauptungen zu Batterien und Akkus mit diesen Kriterien und formuliert eine positive fachliche Erklärung der passenden Lade-/Entladerichtung.",
                "observablePerformanceEn": "The learner evaluates fresh everyday claims about batteries and rechargeable cells using these criteria and positively explains suitable charging/discharging directions."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "suitable-reversible-cell",
                "everyday-claims-with-limits"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "cell-and-device",
                "textDe": "Gegebene andere geeignete Zellchemie oder veränderte Gerätegrenze; stets dieselbe Zelle in beiden Betriebsrichtungen vergleichen.",
                "textEn": "A different supplied suitable chemistry or device-use threshold; always compare the same cell in both operating directions."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "provided-rechargeable-lead-cell-model",
                "taskDemandDe": "Als gegebenes Modell einer dafür ausgelegten wiederaufladbaren Zelle gilt beim Entladen Pb + PbO₂ + 2H₂SO₄ → 2PbSO₄ + 2H₂O. Beim geeigneten Laden wird die umgekehrte Nettoreaktion erzwungen. Die Oxidationszahlen der Bleikomponenten sind im gegebenen Modell vor dem Entladen 0 und +IV, im Produkt jeweils +II; auch diese Daten sind vorgegeben. Vergleiche Energiezufuhr/-abgabe und die gekoppelte Oxidation/Reduktion; die Reaktion ist bereitgestellt und nicht auswendig zu lernen. Keine Durchführung oder Handhabung von Blei/Säure.",
                "taskDemandEn": "A supplied model of a purpose-designed rechargeable cell discharges by Pb + PbO₂ + 2H₂SO₄ → 2PbSO₄ + 2H₂O. Suitable charging forces the reverse net reaction. The supplied model gives the lead components oxidation states 0 and +IV before discharge and +II in each product; these data are also provided. Compare energy supply/release and coupled oxidation/reduction; the equation is provided, not a recall requirement. No handling of lead or acid is required.",
                "expectedPerformanceDe": "Entladen liefert elektrische Energie: Pb(0) wird zu Pb(II) oxidiert, Pb(IV) aus PbO₂ zu Pb(II) reduziert. Beim geeigneten Laden muss die äußere Quelle Energie zuführen; diese Elektronenrollen kehren für die beiden Bleikomponenten um. Die Gleichung ist atomar ausgeglichen; dies belegt keine Umkehrbarkeit einer beliebigen anderen Zellchemie und keine verlustfreie Umwandlung.",
                "expectedPerformanceEn": "Discharge supplies electrical energy: Pb(0) is oxidized to Pb(II), while Pb(IV) in PbO₂ is reduced to Pb(II). Suitable charging requires external energy, reversing these electron roles for the two lead components. The equation balances atoms; this does not establish arbitrary other cell chemistries as reversible or imply lossless conversion.",
                "understandingFocusDe": "Chemisch begründeter Vergleich derselben gegebenen Zelle, nicht bloße Energiepfeilerkennung.",
                "understandingFocusEn": "Chemically reasoned comparison of the same supplied cell, not mere energy-arrow recognition."
              },
              {
                "id": "device-empty-and-nonrechargeable-claim",
                "taskDemandDe": "Frischer Fall ohne Bild: Ein Akku liefert unter Belastung weniger Spannung als ein Gerät benötigt und wird leer genannt. Daneben steht eine nicht zum Laden ausgelegte Primärbatterie. Jemand behauptet: Beide sind im chemischen Gleichgewicht und werden durch irgendeine angelegte Spannung wieder aufgeladen. Beurteile beide Teile, erkläre fachlich, was geeignete Akkuladung bedeutet und weshalb das Bild eines Akkus keine Freigabe zum Laden der Primärbatterie ist.",
                "taskDemandEn": "Fresh case without the image: a rechargeable cell supplies less voltage under load than a device needs and is called empty. A primary battery not designed for charging is beside it. Someone claims both are at chemical equilibrium and any applied voltage recharges them. Evaluate both parts, explain suitable rechargeable-cell charging, and explain why an accumulator picture does not authorize charging the primary battery.",
                "expectedPerformanceDe": "Die Gerätegrenze beschreibt aktuelle Nichtnutzbarkeit, nicht nachgewiesenes chemisches Gleichgewicht oder völlige Energielosigkeit. Nur die dafür ausgelegte geeignete Zelle darf als reversibel ladbar betrachtet werden; passende Energiezufuhr erzwingt ihre passende umgekehrte Reaktionsrichtung. Primärbatterie und beliebige Spannung erfüllen diese Bedingungen nicht; Laden wird nicht empfohlen oder durchgeführt.",
                "expectedPerformanceEn": "The device threshold establishes current lack of usability, not chemical equilibrium or complete absence of energy. Only the suitable purpose-designed cell is treated as reversibly rechargeable; appropriate energy input forces its appropriate reverse reaction direction. A primary battery and arbitrary voltage do not meet these conditions; charging is neither recommended nor performed.",
                "understandingFocusDe": "Unabhängige Alltagskritik mit positiver Akkuerklärung und tatsächlicher Nutzbarkeitsgrenze.",
                "understandingFocusEn": "Independent everyday-claim evaluation with a positive rechargeable-cell explanation and actual usability limits."
              }
            ]
          }
        }
      ],

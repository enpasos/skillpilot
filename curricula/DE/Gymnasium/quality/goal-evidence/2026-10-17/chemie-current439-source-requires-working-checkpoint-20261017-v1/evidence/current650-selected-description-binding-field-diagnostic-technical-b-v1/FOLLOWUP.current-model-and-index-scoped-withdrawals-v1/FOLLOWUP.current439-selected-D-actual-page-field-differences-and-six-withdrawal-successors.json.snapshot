        "bookDigest": "sha256:1faf19b8e9d0961e7387109bed769ed10a8f7a6db3856c74a7ca5c505bdda491",
        "pageFingerprint": "sha256:ceca2e457bcd0d119ae28681c4b316a83545105ce06a92b6a11cfa3ae061beae",

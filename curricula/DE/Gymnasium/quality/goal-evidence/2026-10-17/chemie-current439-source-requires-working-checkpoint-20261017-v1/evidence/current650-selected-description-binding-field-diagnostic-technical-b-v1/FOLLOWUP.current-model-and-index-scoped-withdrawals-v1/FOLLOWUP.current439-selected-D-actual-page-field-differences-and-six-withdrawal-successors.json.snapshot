      "roundGoalInputsEqual": true,
      "finalTextDifferences": [],
      "canonicalContextDifferences": [],
      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "modeling",
            "expectations": [
              {
                "id": "core-understanding",
                "essentialUnderstandingDe": "Reversible Protonenübertragungen können durch Zugabe oder Entzug beteiligter Teilchen beeinflusst werden. Die Erklärung verbindet Beobachtung, Protonendonator/-akzeptor und Hin-/Rückreaktion; sie braucht hier keine quantitative MWG-Berechnung und behauptet keine beliebige Irreversibilität.",
                "essentialUnderstandingEn": "Reversible proton transfers can be influenced by adding or removing participating species. Explanation links observation, proton donor/acceptor and forward/reverse reaction; no numerical equilibrium-law calculation or arbitrary irreversibility claim is needed here.",
                "observablePerformanceDe": "CO2-Entzug begünstigt im ersten Modell den Rückweg zu CO2, sodass H2CO3 nachgebildetes CO2 liefert. Damit wird auch der Rückweg der Protolyse begünstigt: HCO3− nimmt ein Proton von H3O+ auf und bildet H2CO3 sowie Wasser. H3O+ nimmt ab, pH steigt. Wieder erhöhte CO2-Verfügbarkeit kann die andere Richtung begünstigen; die Reaktionsmöglichkeit ist nicht unwiederbringlich zerstört. Aus den Angaben folgt eine qualitative Erklärung, kein genauer End-pH oder ein vollständiges reales Getränkemodell.",
                "observablePerformanceEn": "CO2 removal favors the reverse route of the first model, with H2CO3 supplying replacement CO2. This also favors reverse proton transfer: HCO3− accepts a proton from H3O+ to form H2CO3 and water. H3O+ decreases and pH rises. Increased CO2 availability can favor the other direction again; the reaction capacity is not irretrievably destroyed. The data support a qualitative explanation, not an exact final pH or a complete real beverage model."
              },
              {
                "id": "fresh-transfer-and-limit",
                "essentialUnderstandingDe": "CO2-Entzug aus einem Kohlensäuresystem gegenüber gezielter Protonierung und Deprotonierung von NH3/NH4+. Die Beeinflussung wird auf die ausdrücklich vorgegebenen Protonenreaktionen begrenzt; kein ungerechtfertigter Endpunkt-pH wird errechnet.",
                "essentialUnderstandingEn": "Removing CO2 from a carbonic-acid system versus targeted protonation and deprotonation of NH3/NH4+. Influence is bounded to the supplied proton reactions; no unjustified endpoint pH is calculated.",
                "observablePerformanceDe": "Säurefall: NH3 + H3O+ → NH4+ + H2O; NH3 nimmt ein Proton auf. Basenfall: NH4+ + OH− → NH3 + H2O; NH4+ gibt ein Proton ab. Säure- bzw. Basezugabe macht jeweils den entgegengesetzten Protonenweg möglich und verändert den Anteil der beiden Formen. Das Paar NH4+/NH3 ist korrespondierend. Weder Elektronenverlust noch eine Umwandlung des N-Elements ist erforderlich; alle Atome und Gesamtladungen bleiben bilanziert. „Umkehrbar“ bedeutet nicht gleiche Anteile oder gleiche Geschwindigkeit.",
                "observablePerformanceEn": "Acid case: NH3 + H3O+ → NH4+ + H2O; NH3 accepts a proton. Base case: NH4+ + OH− → NH3 + H2O; NH4+ donates a proton. Acid or base addition permits the opposite proton-transfer route and changes relative amounts of the forms. NH4+/NH3 is a conjugate pair. No electron loss or change of nitrogen element is needed; atoms and total charge remain balanced. “Reversible” does not mean equal amounts or identical rates."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "core-understanding",
                "fresh-transfer-and-limit"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-system-variation",
                "textDe": "CO2-Entzug aus einem Kohlensäuresystem gegenüber gezielter Protonierung und Deprotonierung von NH3/NH4+.",
                "textEn": "Removing CO2 from a carbonic-acid system versus targeted protonation and deprotonation of NH3/NH4+."
              },
              {
                "id": "model-boundary",
                "textDe": "Die Beeinflussung wird auf die ausdrücklich vorgegebenen Protonenreaktionen begrenzt; kein ungerechtfertigter Endpunkt-pH wird errechnet.",
                "textEn": "Influence is bounded to the supplied proton reactions; no unjustified endpoint pH is calculated."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next20-9751b6d8-case-1",
                "taskDemandDe": "Fiktives Modell bei gleicher Temperatur: CO2 + H2O ⇌ H2CO3; H2CO3 + H2O ⇌ HCO3− + H3O+. Eine frisch geöffnete Modelllösung gibt CO2 ab; nach dem Entgasen ist ihr gemessener pH höher. Andere Säuren sind im Modell ausgeschlossen. Mengen und Gleichgewichtskonstanten fehlen. Erkläre den pH-Anstieg über die gekoppelten reversiblen Vorgänge und die Protonenübertragung. Prüfe die Aussage „Die Säure wurde durch Entgasen für immer chemisch zerstört“.",
                "taskDemandEn": "Fictional model at constant temperature: CO2 + H2O ⇌ H2CO3; H2CO3 + H2O ⇌ HCO3− + H3O+. A freshly opened model solution releases CO2; measured pH is higher after degassing. Other acids are excluded and quantities and equilibrium constants are not supplied. Explain the pH rise using the coupled reversible processes and proton transfer. Evaluate “Degassing has chemically destroyed the acid forever.”",
                "expectedPerformanceDe": "CO2-Entzug begünstigt im ersten Modell den Rückweg zu CO2, sodass H2CO3 nachgebildetes CO2 liefert. Damit wird auch der Rückweg der Protolyse begünstigt: HCO3− nimmt ein Proton von H3O+ auf und bildet H2CO3 sowie Wasser. H3O+ nimmt ab, pH steigt. Wieder erhöhte CO2-Verfügbarkeit kann die andere Richtung begünstigen; die Reaktionsmöglichkeit ist nicht unwiederbringlich zerstört. Aus den Angaben folgt eine qualitative Erklärung, kein genauer End-pH oder ein vollständiges reales Getränkemodell.",
                "expectedPerformanceEn": "CO2 removal favors the reverse route of the first model, with H2CO3 supplying replacement CO2. This also favors reverse proton transfer: HCO3− accepts a proton from H3O+ to form H2CO3 and water. H3O+ decreases and pH rises. Increased CO2 availability can favor the other direction again; the reaction capacity is not irretrievably destroyed. The data support a qualitative explanation, not an exact final pH or a complete real beverage model.",
                "understandingFocusDe": "CO2-Austausch allein ist physikalisch; der pH-Effekt benötigt zusätzlich die dargestellten chemischen Gleichgewichte.",
                "understandingFocusEn": "CO2 exchange alone is physical; its pH effect also requires the represented chemical equilibria."
              },
              {
                "id": "chem-next20-9751b6d8-case-2",
                "taskDemandDe": "Frischer wässriger Modellfall: NH3 + H2O ⇌ NH4+ + OH−. Bei einer getrennten Zugabe einer geeigneten kleinen Säuremenge wird NH3 zu NH4+ protoniert; bei geeigneter Basezugabe zu einer NH4+-Lösung entsteht mehr NH3. Die Temperatur bleibt konstant; es ist eine schriftliche Auswertung und keine Mischanweisung. Formuliere beide gezielt beeinflussten Protonenübertragungen, kennzeichne die Rollen und erläutere, weshalb die Beobachtungen die Reversibilität der NH3/NH4+-Umsetzung zeigen.",
                "taskDemandEn": "Fresh aqueous model: NH3 + H2O ⇌ NH4+ + OH−. In a separate treatment with a suitable small acid amount, NH3 is protonated to NH4+; suitable base addition to an NH4+ solution produces more NH3. Temperature stays constant; this is written evaluation, not a mixing instruction. Write both deliberately influenced proton transfers, identify roles and explain how the observations show reversibility of the NH3/NH4+ conversion.",
                "expectedPerformanceDe": "Säurefall: NH3 + H3O+ → NH4+ + H2O; NH3 nimmt ein Proton auf. Basenfall: NH4+ + OH− → NH3 + H2O; NH4+ gibt ein Proton ab. Säure- bzw. Basezugabe macht jeweils den entgegengesetzten Protonenweg möglich und verändert den Anteil der beiden Formen. Das Paar NH4+/NH3 ist korrespondierend. Weder Elektronenverlust noch eine Umwandlung des N-Elements ist erforderlich; alle Atome und Gesamtladungen bleiben bilanziert. „Umkehrbar“ bedeutet nicht gleiche Anteile oder gleiche Geschwindigkeit.",
                "expectedPerformanceEn": "Acid case: NH3 + H3O+ → NH4+ + H2O; NH3 accepts a proton. Base case: NH4+ + OH− → NH3 + H2O; NH4+ donates a proton. Acid or base addition permits the opposite proton-transfer route and changes relative amounts of the forms. NH4+/NH3 is a conjugate pair. No electron loss or change of nitrogen element is needed; atoms and total charge remain balanced. “Reversible” does not mean equal amounts or identical rates.",
                "understandingFocusDe": "Die Beeinflussung wird auf die ausdrücklich vorgegebenen Protonenreaktionen begrenzt; kein ungerechtfertigter Endpunkt-pH wird errechnet.",
                "understandingFocusEn": "Influence is bounded to the supplied proton reactions; no unjustified endpoint pH is calculated."
              }
            ]
          }
        }
      ],

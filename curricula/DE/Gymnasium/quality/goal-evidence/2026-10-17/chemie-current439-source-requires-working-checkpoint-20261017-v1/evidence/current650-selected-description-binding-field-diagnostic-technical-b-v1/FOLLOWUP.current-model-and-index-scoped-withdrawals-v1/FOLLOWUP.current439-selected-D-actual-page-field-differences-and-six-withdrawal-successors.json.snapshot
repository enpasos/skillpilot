        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "avogadro-constant-entity-proportionality",
                "essentialUnderstandingDe": "NA verknüpft Stoffmenge und Zahl der jeweils benannten Elementarteilchen über N=n·NA. NA hat Einheit mol^-1, N ist eine Anzahl. Atomzahlen in Molekülen ergeben sich zusätzlich aus deren Zusammensetzung; die Avogadro-Konstante ändert sich dabei nicht.",
                "essentialUnderstandingEn": "NA relates amount to the number of specified elementary entities through N=n·NA. Its unit is mol^-1, while N is a count. Constituent-atom counts also depend on molecular composition; that does not change the Avogadro constant.",
                "observablePerformanceDe": "Die lernende Person wählt den passenden Teilchenbezug, übersetzt N↔n proportional mit Einheitenbegründung und vergleicht Proben selbstständig auf Molekül- beziehungsweise Atomebene.",
                "observablePerformanceEn": "The learner chooses the appropriate reference entity, translates proportionally between N and n with unit reasoning and independently compares samples at molecular and atomic levels."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "avogadro-constant-entity-proportionality"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "conversion-direction",
                "textDe": "Stoffmenge→Teilchenzahl wird durch Teilchenzahl→Stoffmenge ersetzt.",
                "textEn": "Amount-to-count conversion is replaced by count-to-amount conversion."
              },
              {
                "id": "entity-comparison",
                "textDe": "Molekülzahlen und enthaltene Atomzahlen liefern unterschiedliche Rangfolgen.",
                "textEn": "Molecular counts and constituent-atom counts can produce different rankings."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "quarter-mol-oxygen",
                "taskDemandDe": "Für eine Probe mit0,25mol O2-Molekülen gilt NA=6,02214076·10^23mol^-1. Bestimme die Zahl der O2-Moleküle und der enthaltenen O-Atome. Erkläre den verwendeten Proportionalitätsfaktor und seine Einheit.",
                "taskDemandEn": "For a sample containing0.25mol O2 molecules, NA=6.02214076×10^23mol^-1. Determine the number of O2 molecules and constituent O atoms. Explain the proportionality factor and its unit.",
                "expectedPerformanceDe": "N(O2)=1,50553519·10^23 Moleküle; N(O-Atome)=3,01107038·10^23. Der Faktor gibt die Anzahl je mol an, deshalb kürzt sich mol gegen mol^-1. Die Zweizahl der O-Atome je Molekül ist ein eigener Zusammensetzungsfaktor und kein anderer Wert vonNA.",
                "expectedPerformanceEn": "N(O2)=1.50553519×10^23 molecules and N(O atoms)=3.01107038×10^23. NA gives the count per mol, so mol cancels mol^-1. The two oxygen atoms per molecule are a separate composition factor, not a different value ofNA.",
                "understandingFocusDe": "Konstante, Einheit und Zusammensetzung müssen zusammen richtig gedeutet werden.",
                "understandingFocusEn": "The constant, unit and composition must all be interpreted correctly."
              },
              {
                "id": "carbon-dioxide-helium-count-fresh",
                "taskDemandDe": "Frischer Vergleich ohne Rechenweg: A enthält6,02214076·10^22 CO2-Moleküle; B enthält1,204428152·10^23 He-Atome. NA=6,02214076·10^23mol^-1. Bestimme die Stoffmengen der benannten Teilchen und entscheide begründet, welche Probe insgesamt mehr Atome enthält.",
                "taskDemandEn": "Fresh comparison without a worked method: A contains6.02214076×10^22 CO2 molecules and B contains1.204428152×10^23 He atoms. NA=6.02214076×10^23mol^-1. Determine the amounts of the specified entities and explain which sample contains more atoms in total.",
                "expectedPerformanceDe": "A enthält0,10mol CO2-Moleküle, B0,20mol He-Atome. A enthält wegen drei Atomen je Molekül0,30mol Atome, B0,20mol Atome; A hat trotz kleinerer Molekülzahl mehr Atome. Die drei CO2-Atome verteilen sich auf0,10mol C- und0,20mol O-Atome.",
                "expectedPerformanceEn": "A contains0.10mol CO2 molecules and B0.20mol He atoms. With three atoms per molecule A contains0.30mol atoms, compared with B’s0.20mol atoms; A therefore has more atoms despite its smaller molecular count. A’s atoms consist of0.10mol C and0.20mol O atoms.",
                "understandingFocusDe": "Umgekehrte Mengenübersetzung und ungeholfener Wechsel der Vergleichseinheit.",
                "understandingFocusEn": "Reverse conversion and an uncued change of comparison entity."
              }
            ]
          }
        }
      ],

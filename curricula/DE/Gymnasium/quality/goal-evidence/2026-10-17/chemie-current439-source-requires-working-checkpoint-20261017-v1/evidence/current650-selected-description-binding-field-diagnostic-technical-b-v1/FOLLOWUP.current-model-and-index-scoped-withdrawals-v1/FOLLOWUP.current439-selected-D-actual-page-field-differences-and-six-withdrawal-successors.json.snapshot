      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "two-product-routes",
                "essentialUnderstandingDe": "Ausgewählte Alkalimetalle reagieren mit Wasser zu Hydroxid und Wasserstoff. Die ausgewählten einfachen Alkalimetalloxide reagieren mit Wasser zu Hydroxid, ohne Wasserstoff als Reaktionsprodukt. Andere Oxide/Peroxide werden nicht pauschal gleichgesetzt.",
                "essentialUnderstandingEn": "Selected alkali metals react with water to form hydroxide and hydrogen. The selected simple alkali metal oxides react with water to form hydroxide without hydrogen as a reaction product. Other oxides and peroxides are not automatically treated alike.",
                "observablePerformanceDe": "Die lernende Person vergleicht beide vorgegebenen Reaktionssysteme anhand von Beobachtungen und Produktinformationen und unterscheidet den gemeinsamen Hydroxidanteil vom zusätzlichen Wasserstoff der Metallroute.",
                "observablePerformanceEn": "The learner compares both supplied reaction systems using observations and product information, distinguishing their shared hydroxide product from the additional hydrogen of the metal route."
              },
              {
                "id": "alkaline-caused-by-hydroxide",
                "essentialUnderstandingDe": "Alkalische Lösungen entstehen durch die Hydroxidprodukte und die darin vorhandenen OH⁻-Ionen. Wasserstoffgas erklärt die alkalische Indikatorreaktion nicht. Ein einfaches Hydroxid-/OH⁻-Modell wird bereitgestellt; vollständige Elektronentheorie ist kein vorausgesetzter Eingang.",
                "essentialUnderstandingEn": "The hydroxide products and their OH⁻ ions cause alkaline solutions. Hydrogen gas does not explain the alkaline indicator response. A simple hydroxide/OH⁻ model is supplied; complete electron theory is not assumed as prior mastery.",
                "observablePerformanceDe": "Die lernende Person verbindet vorgegebene Hydroxidprodukte mit alkalischer Indikatorreaktion und korrigiert eine Wasserstoff-Erklärung begründet, ohne eine selbst ausgeführte Reaktion zu behaupten.",
                "observablePerformanceEn": "The learner connects supplied hydroxide products to the alkaline indicator response and corrects a hydrogen explanation with reasons without claiming a personally performed reaction."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "two-product-routes",
                "alkaline-caused-by-hydroxide"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "metal-vs-specific-oxide",
                "textDe": "Wechsel der ausgewählten Metalle/einfachen Oxide und Indikatordaten bei bereitgestellten Produktidentitäten; keine Ausweitung auf jede Sauerstoffverbindung der Alkalimetalle.",
                "textEn": "Vary selected metals/simple oxides and indicator data with supplied product identities; do not generalize to every alkali-metal oxygen compound."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "sodium-and-simple-sodium-oxide",
                "taskDemandDe": "Ein Aufgabenblatt gibt die Produkte und Beobachtungen von Natrium und Na₂O mit Wasser sowie 2 Na + 2 H₂O → 2 NaOH + H₂ und Na₂O + H₂O → 2 NaOH vor. NaOH in Wasser liefert Na⁺ und OH⁻; beide Lösungen zeigen alkalische Indikatorfarbe. Vergleiche die Systeme und erkläre die Farbe. Es ist eine Interpretation bereitgestellter Daten, kein Auftrag zur eigenständigen gefährlichen Versuchsdurchführung.",
                "taskDemandEn": "A task sheet supplies products and observations for sodium and Na₂O with water, including 2 Na + 2 H₂O → 2 NaOH + H₂ and Na₂O + H₂O → 2 NaOH. NaOH in water supplies Na⁺ and OH⁻; both solutions show the alkaline indicator colour. Compare the systems and explain the colour. This interprets provided data and does not request independent hazardous experimentation.",
                "expectedPerformanceDe": "Beide Wege erzeugen Natriumhydroxid und dadurch OH⁻ in der Lösung; dies erklärt die gemeinsame Alkalität. Nur die Metallroute erzeugt hier Wasserstoff. Gasentwicklung ist daher kein notwendiges Kriterium der alkalischen Lösung. Die beiden Gleichungen sind Produktinformationen, keine vorausgesetzte Elektronenbilanzleistung.",
                "expectedPerformanceEn": "Both routes form sodium hydroxide and therefore OH⁻ in solution, explaining their shared alkalinity. Only the metal route produces hydrogen here. Gas production is therefore not required for an alkaline solution. The equations provide product information and do not assume independent electron balancing.",
                "understandingFocusDe": "Produktvergleich auf frühem Stoffniveau.",
                "understandingFocusEn": "Product comparison at an early material level."
              },
              {
                "id": "potassium-fresh-no-gas-claim",
                "taskDemandDe": "Frisch vorgegeben sind 2 K + 2 H₂O → 2 KOH + H₂ und K₂O + H₂O → 2 KOH sowie der Hinweis, dass KOH OH⁻ in Wasser liefert. Prüfe: Ohne Wasserstoff kann die Oxidprobe nicht alkalisch sein. Erkläre den gemeinsamen und den unterschiedlichen Produktbefund. Die Probe ist ausdrücklich K₂O, nicht Peroxid oder Superoxid.",
                "taskDemandEn": "Freshly supplied are 2 K + 2 H₂O → 2 KOH + H₂ and K₂O + H₂O → 2 KOH and the information that KOH supplies OH⁻ in water. Evaluate the claim that without hydrogen the oxide sample cannot be alkaline. Explain the shared and different products. The sample is explicitly K₂O, not peroxide or superoxide.",
                "expectedPerformanceDe": "Die Behauptung ist falsch: KOH/OH⁻ erklärt in beiden Proben die alkalische Lösung. Wasserstoff ist nur im vorgegebenen Metallfall zusätzlich vorhanden und ist nicht der Grund der Alkalität. Die Aussage wird auf die ausgewählten Stoffe beschränkt.",
                "expectedPerformanceEn": "The claim is false: KOH/OH⁻ explains alkalinity in both samples. Hydrogen additionally occurs only in the supplied metal case and does not cause alkalinity. The conclusion stays limited to the selected substances.",
                "understandingFocusDe": "Unabhängiger Produkttransfer und kausale Fehlvorstellung.",
                "understandingFocusEn": "Independent product transfer and a causal misconception."
              }
            ]
          }
        }
      ],

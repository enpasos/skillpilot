      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "experiment",
            "expectations": [
              {
                "id": "e1",
                "essentialUnderstandingDe": "Isolierung und Reinigung werden aus Löslichkeit und Gemischzusammensetzung ausgewählt.",
                "essentialUnderstandingEn": "Isolation and purification are selected from solubility and mixture composition.",
                "observablePerformanceDe": "Die Person begründet Trennfolge und Lösemittelwahl, statt nur ein Rezept zu wiederholen.",
                "observablePerformanceEn": "The learner justifies separation sequence and solvent choice instead of merely repeating a recipe."
              },
              {
                "id": "e2",
                "essentialUnderstandingDe": "Reinigung verändert Produktmenge und Verunreinigungen unter sicheren Arbeitsbedingungen.",
                "essentialUnderstandingEn": "Purification changes product amount and impurities under safe conditions.",
                "observablePerformanceDe": "Die Person filtriert, wäscht, kristallisiert und trocknet eigene gewogene Proben tatsächlich unter Aufsicht.",
                "observablePerformanceEn": "The learner actually filters, washes, crystallises and dries original weighed samples under supervision."
              },
              {
                "id": "e3",
                "essentialUnderstandingDe": "Ein selbst synthetisiertes Präparat wird im Herstellungsweg erhalten und anschließend gereinigt.",
                "essentialUnderstandingEn": "An originally synthesised preparation is obtained through a production route and subsequently purified.",
                "observablePerformanceDe": "Die Person führt die ASS-Synthese am eigenen Ansatz aus, dokumentiert Reagenzien, tatsächliche Mengen, Reaktion und getrennte Aufarbeitung.",
                "observablePerformanceEn": "The learner performs ASA synthesis on an original batch and records reagents, actual amounts, reaction and separate work-up."
              },
              {
                "id": "e4",
                "essentialUnderstandingDe": "Eine spezifische Verunreinigungsprüfung besitzt Referenzen, Matrixkontrollen und begrenzte Selektivität.",
                "essentialUnderstandingEn": "A specific impurity assay uses references, matrix controls and bounded selectivity.",
                "observablePerformanceDe": "Die Person führt die freie-SA-Referenzanalyse und Schmelztests am eigenen Roh-/Reinprodukt aus; negative/positive Kontrollen und Spike bestimmen die Verwertbarkeit.",
                "observablePerformanceEn": "The learner performs free-SA reference analysis and melting tests on original crude/purified product; negative/positive controls and spike determine usability."
              },
              {
                "id": "e5",
                "essentialUnderstandingDe": "Ein Originalprotokoll trennt eigene Handlungen und rohe Messwerte von Übungsdaten.",
                "essentialUnderstandingEn": "An original record separates original actions and raw measurements from teaching data.",
                "observablePerformanceDe": "Die Person hält Massenkonstanz, alle analytischen Abzweigungen, Lösungsmengen, Zeiten, Temperaturen, Farbe und Schmelzbereiche unverändert fest.",
                "observablePerformanceEn": "The learner records constant mass, every analytical withdrawal, solution quantities, times, temperatures, colour and melting ranges unchanged."
              },
              {
                "id": "e6",
                "essentialUnderstandingDe": "Reinheit, Reaktions-Massenausbeute und Reinigungs-Rückgewinnung haben unterschiedliche Nenner und Aussagegrenzen.",
                "essentialUnderstandingEn": "Purity, reaction mass yield and purification recovery use different denominators and claim limits.",
                "observablePerformanceDe": "Die Person berechnet Quellenstoff-bezogene Ausbeute, Teilansatz-Rückgewinnung und freie-SA-Probenanteile getrennt und kennzeichnet nur bedingte ASS-Reinheitskorrekturen.",
                "observablePerformanceEn": "The learner separately calculates starting-material-based yield, portion-based recovery and free-SA sample fractions and marks only conditional ASA purity corrections."
              },
              {
                "id": "e7",
                "essentialUnderstandingDe": "Neue lösliche Begleitstoffe oder Hydrolysebedingungen können die Selektivität und Auswertung verändern.",
                "essentialUnderstandingEn": "New soluble components or hydrolysis conditions can change selectivity and interpretation.",
                "observablePerformanceDe": "Die Person passt bei neuem Zucker im Salzfall oder feuchter ASS-Lagerung unabhängige Kontrollen an und führt die erforderlichen praktischen Prüfungen selbst aus.",
                "observablePerformanceEn": "The learner independently adapts controls for sugar in salt or damp ASA storage and personally performs required practical tests."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "e1",
                "e2",
                "e3",
                "e4",
                "e5",
                "e6",
                "e7"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "additional-soluble-component",
                "textDe": "Frisch enthält das Gemisch zusätzlich gelösten Zucker. Wähle selbst eine weitere Prüfung und erkläre, weshalb Wasserverdampfen nun keine selektive Salzreinigung garantiert.",
                "textEn": "A fresh mixture additionally contains dissolved sugar. Independently choose a further test and explain why evaporating water no longer guarantees selective salt purification."
              },
              {
                "id": "storage-vs-analysis-hydrolysis",
                "textDe": "Neue, erst nach der ersten selbständigen Antwort auszugebende Situation: Ein Teil des eigenen Produkts wurde feucht gelagert; gleichzeitig stand seine Analyselösung länger als die frische ASS-Referenz. Plane und führe mit frischen getrennten Proben/Referenzen eine zeitlich angeglichene Prüfserie aus, um bereits im Feststoff vorhandene freie SA von während der Analyse entstandener Hydrolyse zu unterscheiden. Begründe Kontrollen und Grenzen, ohne eine positive oder unveränderte Farbe vorwegzunehmen. Eigene Herstellung/Analyse aus dem Hauptfall bleibt Pflicht und wird nicht durch diesen Plan ersetzt.",
                "textEn": "Fresh situation released only after the first independent response: part of the original product was stored damp while its assay solution stood longer than the fresh ASA reference. Plan and perform a time-matched series with fresh separate samples/references to distinguish free SA already in the solid from hydrolysis during analysis. Justify controls and limits without predetermining a positive or unchanged colour. Original synthesis/analysis in the main case remains mandatory and is not replaced by this plan."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "lab15-06-a",
                "taskDemandDe": "Vollständiges Fallmaterial: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-lab15-preparation-purity-whole-author-20261015-v1/materials/two-complete-DE-EN-cases.one-goal.author.json #lab15-06-a; sha256:2031642fe9434a1342d75380e01bb6d68bf913f4a154be1986f73760920064af. Führe das geplante Verfahren aus, protokolliere Originalmengen und Verluste und schlage eine Reinheitsprüfung vor. Berechne aus den Lehrdaten Produktreinheit und NaCl-Rückgewinnung getrennt. Entscheide, ob Filtration allein genügt.",
                "taskDemandEn": "Complete case material: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-lab15-preparation-purity-whole-author-20261015-v1/materials/two-complete-DE-EN-cases.one-goal.author.json #lab15-06-a; sha256:2031642fe9434a1342d75380e01bb6d68bf913f4a154be1986f73760920064af. Execute the plan, record original quantities/losses and propose a purity test. Calculate product purity and NaCl recovery separately from the practice data. Decide whether filtration alone suffices.",
                "expectedPerformanceDe": "Filtration entfernt Sand, nicht gelöstes NaCl; Kristallisation trennt Wasser ab. Reinheit=2,565/2,70=95,0%; NaCl-Rückgewinnung=2,565/3,00=85,5%; bloße Produktmasse ergibt90% und ist keine reine NaCl-Ausbeute. Zu viel Waschwasser erhöht Verdampfungsaufwand; ungetrocknete Kristalle verfälschen Masse. Eigene Ausführung muss beobachtet werden.",
                "expectedPerformanceEn": "Filtration removes sand, not dissolved NaCl; crystallisation removes water. Purity=2.565/2.70=95.0%; NaCl recovery=2.565/3.00=85.5%; gross product mass gives90%, not pure NaCl yield. Excess rinse water increases evaporation demand; wet crystals distort mass. Own performance must be observed.",
                "understandingFocusDe": "Frisch enthält das Gemisch zusätzlich gelösten Zucker. Wähle selbst eine weitere Prüfung und erkläre, weshalb Wasserverdampfen nun keine selektive Salzreinigung garantiert.",
                "understandingFocusEn": "A fresh mixture additionally contains dissolved sugar. Independently choose a further test and explain why evaporating water no longer guarantees selective salt purification."
              },
              {
                "id": "lab15-06-b-synthesis-purity-v2",
                "taskDemandDe": "Vollständiges Fallmaterial: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-lab15-preparation-purity-whole-author-20261015-v1/materials/two-complete-DE-EN-cases.one-goal.author.json #lab15-06-b-synthesis-purity-v2; sha256:2031642fe9434a1342d75380e01bb6d68bf913f4a154be1986f73760920064af. Begründe Auswahl von Filtration und Rekristallisation aus den Stoffeigenschaften. Stelle das Präparat selbst her und reinige genau deinen gewogenen Ansatz. Führe die gezielte Fe(III)-Referenzanalyse und Schmelzbereichsprüfung an eigenen Proben selbst aus; prüfe Kontrollen und kennzeichne methodisch ungültige Serien. Dokumentiere Originalmassen, Abzweigungen, Lösungen, Zeiten, Temperaturen, Farben und Schmelzbereiche. Berechne an den fremden Übungsdaten theoretische ASS-Masse, rohe Massenausbeute, tatsächlich isolierte gereinigte Massenausbeute, Rekristallisations-Rückgewinnung und freie-SA-Massenanteilsintervalle. Welche Aussage über gesamte ASS-Reinheit und reinheitskorrigierte Reaktionsausbeute bleibt ohne weiteres Verfahren offen?",
                "taskDemandEn": "Complete case material: curricula/DE/Gymnasium/quality/goal-evidence/2026-10-15/chemie-lab15-preparation-purity-whole-author-20261015-v1/materials/two-complete-DE-EN-cases.one-goal.author.json #lab15-06-b-synthesis-purity-v2; sha256:2031642fe9434a1342d75380e01bb6d68bf913f4a154be1986f73760920064af. Justify filtration and recrystallisation from material properties. Personally synthesise and purify your exact weighed batch. Personally perform the targeted Fe(III) reference assay and melting-range comparison on your own samples, check controls and mark invalid series. Record original masses, withdrawals, solutions, times, temperatures, colours and melting ranges. Using the external teaching data, calculate theoretical ASA mass, crude mass yield, actually isolated purified mass yield, recrystallisation recovery and free-SA mass-fraction intervals. What remains unknown about total ASA purity and purity-corrected reaction yield without another method?",
                "expectedPerformanceDe": "SA+Essigsäureanhydrid→ASS+Essigsäure ist1:1;0,2300/138,12=1,66522mmol SA und0,9000/102,09=8,81575mmol Anhydrid, SA begrenzt; theoretisch0,300006g ASS. Rohe Massenausbeute0,2470/0,300006≈82,3%; tatsächlich isolierte gereinigte Massenausbeute0,1600/0,300006≈53,3%. Rekristallisations-Rückgewinnung0,1600/0,1950≈82,1%; nicht durch0,2470 teilen, weil0,0520g vorher analytisch abgezweigt wurden. Keine Hochrechnung wird als tatsächlich hergestellte Masse ausgegeben. Freie SA im Rohprodukt1,2–1,6Massen%, gereinigt0,4–0,8Massen% (je SA-Masse in25mL geteilt durch50,0mg eigene Probe). Spike bestätigt größenordnungsmäßige Matrixantwort. Der engere Schmelzbereich und geringere freie-SA-Anteil stützen Reinigung; sie belegen weder100% ASS noch Arzneitauglichkeit. Nur unter zusätzlicher Zwei-Stoff-Annahme ASS+SA wäre ASS99,2–99,6% und die korrigierte gereinigte Massenausbeute52,9–53,1%; das ist ein ausdrücklich bedingtes Modell, kein Gesamtreinheitsmesswert. Andere Wasser-/Säure-/Nebenproduktanteile bleiben möglich. Tatsächlich gemessene eigene Daten und gegebenenfalls fehlgeschlagene Kontrollen sind die spätere Beurteilungsgrundlage.",
                "expectedPerformanceEn": "SA+ethanoic anhydride→ASA+ethanoic acid is1:1;0.2300/138.12=1.66522mmol SA and0.9000/102.09=8.81575mmol anhydride, so SA limits and theoretical ASA is0.300006g. Crude mass yield0.2470/0.300006≈82.3%; actually isolated purified mass yield0.1600/0.300006≈53.3%. Recrystallisation recovery0.1600/0.1950≈82.1%, not divided by0.2470 because0.0520g was withdrawn for analysis. Do not report an extrapolated batch as an actually prepared mass. Free SA is1.2–1.6mass% crude and0.4–0.8mass% purified (SA mass in25mL divided by the original50.0mg sample). Spike supports the approximate matrix response. Narrower melting and reduced free SA support purification, establishing neither100% ASA nor medicinal suitability. Only under an additional ASA+SA binary-mixture assumption would ASA be99.2–99.6% and corrected purified mass yield52.9–53.1%; that is an explicitly conditional model, not measured total purity. Other water/acid/by-product content remains possible. Actual original data and any failed controls form the later assessment basis.",
                "understandingFocusDe": "Neue, erst nach der ersten selbständigen Antwort auszugebende Situation: Ein Teil des eigenen Produkts wurde feucht gelagert; gleichzeitig stand seine Analyselösung länger als die frische ASS-Referenz. Plane und führe mit frischen getrennten Proben/Referenzen eine zeitlich angeglichene Prüfserie aus, um bereits im Feststoff vorhandene freie SA von während der Analyse entstandener Hydrolyse zu unterscheiden. Begründe Kontrollen und Grenzen, ohne eine positive oder unveränderte Farbe vorwegzunehmen. Eigene Herstellung/Analyse aus dem Hauptfall bleibt Pflicht und wird nicht durch diesen Plan ersetzt.",
                "understandingFocusEn": "Fresh situation released only after the first independent response: part of the original product was stored damp while its assay solution stood longer than the fresh ASA reference. Plan and perform a time-matched series with fresh separate samples/references to distinguish free SA already in the solid from hydrolysis during analysis. Justify controls and limits without predetermining a positive or unchanged colour. Original synthesis/analysis in the main case remains mandatory and is not replaced by this plan."
              }
            ]
          }
        }
      ],

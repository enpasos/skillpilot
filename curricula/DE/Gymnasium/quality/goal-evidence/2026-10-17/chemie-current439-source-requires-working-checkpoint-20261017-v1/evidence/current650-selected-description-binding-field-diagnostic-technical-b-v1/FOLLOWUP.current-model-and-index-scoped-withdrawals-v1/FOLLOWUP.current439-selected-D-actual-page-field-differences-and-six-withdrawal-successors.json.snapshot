      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "paraben-structure-efficacy-solubility",
                "essentialUnderstandingDe": "Parabene sind vorgegebene p-Hydroxybenzoesäureester: phenolische OH-Gruppe und Carbonsäureester stehen am aromatischen Ring para zueinander. Der Esterrest beeinflusst Eigenschaften; Wirksamkeits- und Löslichkeitsdaten müssen gemeinsam statt als unbegrenzte Kettenlängenregel beurteilt werden.",
                "essentialUnderstandingEn": "The specified parabens are p-hydroxybenzoic-acid esters: phenolic OH and a carboxylic-acid ester occupy para positions on the aromatic ring. The ester substituent affects properties; efficacy and solubility data must be assessed together rather than as an unlimited chain-length rule.",
                "observablePerformanceDe": "Die richtige para-Esterstruktur erkennen und bereitgestellte Wirkungs-/Löslichkeitsdaten für eine begründete Konservierungsstoffwahl verknüpfen.",
                "observablePerformanceEn": "Identify the correct para-ester structure and connect supplied efficacy/solubility data to a justified preservative choice."
              },
              {
                "id": "dated-product-use-limits",
                "essentialUnderstandingDe": "Eine datierte produktbezogene Verwendungsregel einschließlich Kombinationen und Gruppenlimits begrenzt den Einsatz; höhere Modellwirksamkeit hebt diese Bedingungen nicht auf. Eine schematische Produktpackung ist keine Rechts- oder Sicherheitsfreigabe.",
                "essentialUnderstandingEn": "A dated product-specific use rule, including combinations and group limits, constrains use; higher model efficacy does not override those conditions. A schematic product package is not legal or safety clearance.",
                "observablePerformanceDe": "Dosierungen und Grenzen für die konkrete Kategorie anwenden, Nutzen und Risiken materialbezogen abwägen und ungeprüfte andere Produkte oder Gegenwartsregeln ausdrücklich offenlassen.",
                "observablePerformanceEn": "Apply dosages and limits to the specific category, weigh material-supported benefits and risks, and explicitly leave unverified other products or present rules open."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "paraben-structure-efficacy-solubility",
                "dated-product-use-limits"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "fresh-controlled-chemical-case",
                "textDe": "Frischer vorgegebener Ester beziehungsweise Mischung; geänderte Löslichkeit/Wirkungsdaten; konkrete Lebensmittelkategorie mit datierter Mengenbasis und Fußnoten; keine GK-Pflichtbehauptung für diesen HE-LK-Komponentenfall.",
                "textEn": "Fresh specified ester or mixture; changed solubility/efficacy data; specific food category with dated quantity basis and footnotes; no GK obligation claimed for this HE-LK component."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "dated-confectionery-paraben-limits",
                "taskDemandDe": "Für geeignete Zuckerwaren (keine kandierten/glasierten Früchte oder Gemüse) gibt ein bereitgestellter EU1333/2008-Auszug, konsolidierte didaktische Fassung04.11.2025, für die relevante E200–219-Gruppe1500mg/kg als freie Säure und für p-Hydroxybenzoate darin maximal300mg/kg an. Eine Probe enthält320mg/kg bereitgestellter PHB-freie-Säure-Äquivalente und400mg/kg anderer zur Gruppe gehörender zulässiger Konservierungsstoffe. Vergleiche vorgegebene Methyl-/Ethylparabenstrukturen mit Wirkungs-/Löslichkeitsdaten und beurteile die Probe.",
                "taskDemandEn": "For suitable sugar confectionery excluding candied/crystallised/glacé fruit or vegetables, a supplied EU1333/2008extract, consolidated teaching edition04.11.2025, gives1500mg/kg as free acid for the relevant E200–219group and within it at most300mg/kg p-hydroxybenzoates. A sample contains320mg/kg supplied PHB free-acid equivalents and400mg/kg other permitted group preservatives. Compare specified methyl/ethylparaben structures with efficacy/solubility data and assess the sample.",
                "expectedPerformanceDe": "Beide Strukturen besitzen para-OH und den richtigen Ester, Unterschiede des Alkylrests werden mit den bereitgestellten Daten begründet. Summe720mg/kg liegt unter1500, PHB-Anteil320aber über300mg/kg: Gruppenmaximum allein genügt nicht. Die datierte Materialentscheidung erlaubt keine gegenwärtige Produktfreigabe; Löslichkeit und konkrete Wirksamkeit bleiben weitere Kriterien.",
                "expectedPerformanceEn": "Both structures have para-OH and the correct ester, and alkyl differences are explained using supplied data. The720mg/kg sum is below1500, but320mg/kg PHB exceeds300: the group maximum alone does not suffice. This dated material decision is not present product clearance; solubility and specific efficacy remain additional criteria.",
                "understandingFocusDe": "Struktur-/Wirkungsabwägung mit separatem Gruppen- und PHB-Limit.",
                "understandingFocusEn": "Structure/efficacy reasoning with separate group and PHB limits."
              },
              {
                "id": "fresh-solubility-and-unverified-product",
                "taskDemandDe": "Frische Vergleichsdaten zeigen für einen vorgegebenen längeren Paraben-Ester unter bestimmten Bedingungen stärkere Modellhemmung, aber geringere Wasserlöslichkeit; das geprüfte Produkt hat eine begrenzte gelöste Konzentration. Ein anderes Produkt liegt außerhalb der bereitgestellten datierten Lebensmittelregel. Beurteile die beiden Einsatzvorschläge anhand der Strukturen und Daten.",
                "taskDemandEn": "Fresh comparison data show stronger model inhibition but lower water solubility for a specified longer paraben ester under stated conditions; the investigated product has a limited dissolved concentration. Another product lies outside the supplied dated food rule. Assess both use proposals from structures and data.",
                "expectedPerformanceDe": "Die strukturelle Änderung erklärt eine passende Eigenschaftstendenz, aber die schlechtere Löslichkeit kann die tatsächlich erreichbare Konzentration begrenzen. Höhere Modellwirkung wird nicht automatisch als bessere Verwendung bewertet. Für das andere Produkt wird eine passende datierte Regel beziehungsweise weitere Daten verlangt; eine Lebensmittelgrenze wird nicht auf Kosmetika übertragen.",
                "expectedPerformanceEn": "The structural change explains an appropriate property tendency, but lower solubility may limit the actually attainable concentration. Higher model efficacy is not automatically judged a better use. The other product requires an appropriate dated rule or further data; food limits are not transferred to cosmetics.",
                "understandingFocusDe": "Frischer Struktur-/Produktfokus mit klarer Materialgrenze.",
                "understandingFocusEn": "Fresh structure/product focus with a clear material boundary."
              }
            ]
          }
        }
      ],

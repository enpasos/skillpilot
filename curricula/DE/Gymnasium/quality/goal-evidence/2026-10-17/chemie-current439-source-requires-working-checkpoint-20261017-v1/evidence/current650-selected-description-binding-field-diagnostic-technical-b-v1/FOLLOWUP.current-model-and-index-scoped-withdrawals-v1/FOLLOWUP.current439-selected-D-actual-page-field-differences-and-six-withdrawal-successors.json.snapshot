      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "b009-350a-fire-triangle",
                "essentialUnderstandingDe": "Ein einfacher Brand benötigt Brennstoff, Sauerstoff und ausreichend Wärme. Ein geeignetes Löschprinzip unterbricht je nach Brandstoff mindestens eine notwendige Bedingung. Wasser auf brennendem Speisefett ist gefährlich; eine Löschdecke ist kein allgemein geeignetes Fettbrandmittel. Geeignete Mittel und reale Maßnahmen bleiben Fachkräften bzw. zuständigen Erwachsenen vorbehalten.",
                "essentialUnderstandingEn": "A simple fire needs fuel, oxygen and sufficient heat. A suitable extinguishing principle interrupts at least one necessary condition according to the burning material. Water on burning cooking fat is dangerous; a fire blanket is not a generally suitable fat-fire agent. Suitable equipment and real action remain with trained staff or responsible adults.",
                "observablePerformanceDe": "Die lernende Person erklärt an sicheren vorgegebenen Szenarien, welche Bedingung durch ein beschriebenes Mittel unterbrochen wird, und weist Wasser oder eine pauschale Löschdecke bei Fettbrand begründet zurück. Keine eigene Brandbekämpfung.",
                "observablePerformanceEn": "Using safe supplied scenarios, the learner explains which condition a described measure interrupts and rejects water or a blanket recommendation for a cooking-fat fire with reasons. No learner firefighting."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b009-350a-fire-triangle"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "material-context",
                "textDe": "Fester Papierbrand und heißes Speisefett wechseln zu einer geschützten Modellflamme mit begrenztem Sauerstoffangebot.",
                "textEn": "Solid paper and hot cooking fat change to a protected model flame with limited oxygen supply."
              },
              {
                "id": "interrupted-condition",
                "textDe": "Kühlen und Trennen vom Sauerstoff werden an verschiedenen Befunden unterschieden.",
                "textEn": "Cooling and excluding oxygen are distinguished from different observations."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "paper-bin-versus-catering-fryer-data",
                "taskDemandDe": "Zwei neue, ausschließlich schriftliche Einsatzkarten sind gegeben: (A) Papier in einem kleinen Abfallbehälter brennt; ein freigegebenes Fachkräfteprotokoll nennt geeignetes Wasser zur Kühlung. (B) In einer Gemeinschaftsküche brennt heißes Speisefett; das Fachkräfteprotokoll nennt einen geprüften Brandklasse-F-Löscher, dessen Löschmittel eine abdeckende Schicht bildet. Erkläre jeweils, welche Verbrennungsbedingung vermindert wird, und warum weder Wasser noch eine pauschal genannte Löschdecke für B geeignet sind. Im echten Ereignis Abstand, Erwachsene/Notruf; keine Handlung ausführen.",
                "taskDemandEn": "Two fresh written response cards are supplied: (A) paper burns in a small waste container and a trained-staff protocol lists suitable water for cooling; (B) hot cooking fat burns in a communal kitchen and the trained-staff protocol lists an approved class-F extinguisher whose agent forms a covering layer. Explain which combustion condition is reduced in each case and why neither water nor a blanket recommended without qualification is suitable for B. In a real incident keep distance and alert adults/emergency services; perform no action.",
                "expectedPerformanceDe": "Für A erklärt die Person Wärmeentzug durch geeignetes Wasser als Fachkräfteprinzip. Für B deutet sie die abdeckende Schicht des geprüften F-Mittels als Unterbrechung des Luft-/Sauerstoffkontakts und lehnt Wasser wegen Fettbrandspritz-/Explosionsgefahr sowie Löschdecken als pauschale Empfehlung aufgrund von Flammendurchschlag/Verbrennungsrisiko ab. Keine eigenständige Brandbekämpfung.",
                "expectedPerformanceEn": "For A the learner explains heat removal by suitable water as a trained-staff measure. For B they explain that the covering layer formed by the approved class-F agent interrupts air/oxygen contact, reject water because of violent spattering and blanket advice as a general solution because of flame breakthrough and burn risk. No independent firefighting.",
                "understandingFocusDe": "Sichere, quellengebundene Prinzipienwahl über zwei neue Kontexte statt Wiederholung des alten Bildfehlers.",
                "understandingFocusEn": "Safe, source-bound choice of principle in two fresh contexts rather than repetition of the old image error."
              },
              {
                "id": "fresh-covered-model-flame-data",
                "taskDemandDe": "Eine Lehrkraft zeigt nur Messdaten einer geschützten Modellflamme: Bei gleicher Brennstoffmenge bleibt die Temperatur zunächst hoch; nach dem Abdecken sinkt der Sauerstoffanteil im Modellraum stark und die Flamme erlischt. In einem zweiten Datensatz sinkt die Temperatur unter die für dieselbe Modellflamme nötige Schwelle, während Sauerstoff vorhanden bleibt. Erkläre in jedem Datensatz die unterbrochene Bedingung und warum beide Befunde das gleiche Branddreieck auf unterschiedliche Weise nutzen. Keine Durchführung und keine Anleitung zum Anzünden.",
                "taskDemandEn": "A teacher supplies only data from a protected model flame: with the same fuel amount, temperature initially stays high; after covering, oxygen in the model space falls sharply and the flame goes out. In a second data set, temperature falls below the threshold needed by the same model flame while oxygen remains available. Explain the interrupted condition in each set and why both observations use the same fire triangle in different ways. No experiment or ignition instructions.",
                "expectedPerformanceDe": "Abdecken wird als Sauerstoffbegrenzung, der zweite Befund als Wärmeentzug unter die notwendige Temperatur erklärt. Die Person behauptet nicht, dass bei beiden Versuchen der Brennstoff verbraucht sei oder jedes Mittel bei jedem Brand sicher sei.",
                "expectedPerformanceEn": "Covering is explained as oxygen limitation, and the second observation as heat removal below the required temperature. The learner does not claim that fuel was exhausted in both trials or that every agent is safe for every fire.",
                "understandingFocusDe": "Unabhängiger Transfer auf Beobachtungsdaten und klare Trennung von Sauerstoff- und Wärmewirkung.",
                "understandingFocusEn": "Independent transfer to observation data and clear distinction between oxygen and heat effects."
              }
            ]
          }
        }
      ],

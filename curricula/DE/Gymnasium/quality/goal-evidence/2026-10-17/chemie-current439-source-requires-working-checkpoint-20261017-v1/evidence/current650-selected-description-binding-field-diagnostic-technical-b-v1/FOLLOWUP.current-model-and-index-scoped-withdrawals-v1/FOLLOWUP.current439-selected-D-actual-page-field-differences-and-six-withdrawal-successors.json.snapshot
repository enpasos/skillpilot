      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "procedure",
            "expectations": [
              {
                "id": "specified-paraben-structure-and-method",
                "essentialUnderstandingDe": "Die bereitgestellte Struktur eines vorgegebenen p-Hydroxybenzoesäureesters begründet eine geeignete quantitative Mess- und Trennmethode. Ein geeignetes kalibriertes chromatographisches Verfahren ist ein Beispiel, nicht die einzige erlaubte Methode oder eine überall verfügbare Schulausstattung.",
                "essentialUnderstandingEn": "The supplied structure of a specified p-hydroxybenzoic acid ester justifies a suitable quantitative measurement and separation method. Appropriate calibrated chromatography is one example, not the only permitted method or equipment available in every school.",
                "observablePerformanceDe": "Für den tatsächlich vorgegebenen einzelnen Paraben-Ester eine geeignete Methode anhand von Struktur, Matrix und verfügbaren Verfahrensdaten auswählen und begründen.",
                "observablePerformanceEn": "Select and justify an appropriate method for the one actually specified paraben ester using structure, matrix and available method data."
              },
              {
                "id": "actual-controlled-paraben-planning-and-execution",
                "essentialUnderstandingDe": "Die quantitative Parabenbestimmung verlangt eigene Planung UND tatsächliche Durchführung mit passenden Blind-/Matrixkontrollen, Referenzstandards und nachvollziehbarer Probenvorbereitung. Ein fremdes Chromatogramm oder eine simulierte Messung allein belegt keine eigene Durchführung.",
                "essentialUnderstandingEn": "Quantitative paraben determination requires the learner’s own planning AND actual execution with appropriate blank/matrix controls, reference standards and traceable preparation. Another person’s chromatogram or a simulated measurement alone does not demonstrate the learner’s execution.",
                "observablePerformanceDe": "Eine geeignete autorisierte Bestimmung für den vorgegebenen Ester tatsächlich planen und durchführen; eigene Kontrollen, Standards, Probenvorbereitung und Messwerte dokumentieren.",
                "observablePerformanceEn": "Actually plan and carry out a suitable authorised assay for the specified ester; document the learner’s own controls, standards, sample preparation and readings."
              },
              {
                "id": "paraben-calibration-range-dilution-selectivity",
                "essentialUnderstandingDe": "Chromatographische Retentionszeit identifiziert Peaklagen und ist keine Konzentration. Ein geeigneter kalibrierter Signalbezug liefert Konzentration nur im validierten Arbeitsbereich; Verdünnung, unterschiedliche Analytenantwort und koeluierende Matrixbestandteile müssen berücksichtigt werden.",
                "essentialUnderstandingEn": "Chromatographic retention time locates peaks and is not concentration. Appropriate calibrated signal response gives concentration only within the validated working range; dilution, different analyte response and coeluting matrix components must be considered.",
                "observablePerformanceDe": "Kalibrierung oder passende Stöchiometrie gültig anwenden, den Gehalt mit Einheiten und Verdünnung bestimmen und bei frischer Range-/Selektivitätsstörung wirklich neu messen statt extrapolieren oder Peakzeit als Gehalt auszugeben.",
                "observablePerformanceEn": "Apply valid calibration or suitable stoichiometry, determine content with units and dilution, and for fresh range/selectivity interference actually remeasure rather than extrapolate or present peak time as content."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "specified-paraben-structure-and-method",
                "actual-controlled-paraben-planning-and-execution",
                "paraben-calibration-range-dilution-selectivity"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "fresh-analyte-specific-controlled-assay",
                "textDe": "Jeweils ein vorgegebener Ester und frische Matrix; geeignete neue analytspezifische Standards, veränderte Verdünnung/Kalibrierung, Arbeitsbereich und Koelution; tatsächliche Planung/Durchführung.",
                "textEn": "One specified ester at a time and fresh matrix; suitable new analyte-specific standards, changed dilution/calibration, working range and coelution; actual planning/execution."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "fresh-specified-methylparaben-own-calibrated-assay",
                "taskDemandDe": "Plane und führe eine geeignete quantitative Bestimmung von vorgegebenem Methylparaben in einer geeigneten Schulprobe tatsächlich durch. In diesem konkreten Material steht ein freigegebenes HPLC-Verfahren zur Verfügung; begründe es aus Struktur und Matrix, nutze Blankprobe und analytspezifische Standards und lege eigene Vorbereitung, Kontroll- und Rohmessprotokolle vor. Zusätzliche Rechenkontrolle: Standards c=0,5;2,0;5,0mg/L liefern A=65;200;470. Gültiger Bereich0,5–5,0mg/L, Probenfläche A=290, Verdünnungsfaktor8.",
                "taskDemandEn": "Plan and actually perform an appropriate quantitative determination of specified methylparaben in a suitable school sample. This particular material provides an authorised HPLC procedure; justify it from structure and matrix, use a blank and analyte-specific standards, and submit the learner’s own preparation, control and raw-measurement records. Additional calculation check: standards c=0.5;2.0;5.0mg/L give A=65;200;470. Valid range0.5–5.0mg/L, sample area A=290, dilution factor8.",
                "expectedPerformanceDe": "Die eigenen Durchführungsschritte und Kontrollen sind von den Zusatzdaten getrennt belegt. Kontrollgerade A=90c+20; c=3,0mg/L Messlösung und24,0mg/L Original, innerhalb des Bereichs. Retentionszeit ist nicht Konzentration; passende Standards und Matrix-/Trennkontrollen müssen die Zuordnung des Signals tragen. Kein Anspruch, HPLC sei überall verfügbar oder für alle Parabene zwingend.",
                "expectedPerformanceEn": "The learner’s own execution and controls are evidenced separately from the extra data. Check line A=90c+20; c=3.0mg/L measured solution and24.0mg/L original, within range. Retention time is not concentration; appropriate standards and matrix/separation controls must support assignment of the signal. Do not claim HPLC is universally available or mandatory for every paraben.",
                "understandingFocusDe": "Tatsächliche analytspezifische Bestimmung, getrennte Zeit-/Konzentrationsachsen und gültige Kalibrierung.",
                "understandingFocusEn": "Actual analyte-specific assay, distinct time/concentration axes and valid calibration."
              },
              {
                "id": "fresh-specified-ethylparaben-range-and-matrix-remeasurement",
                "taskDemandDe": "Plane und führe eine Bestimmung an einer frischen geeigneten Probe des nun vorgegebenen Ethylparabens durch; begründe geeignete Methode und Standards erneut aus seiner bereitgestellten Struktur. Eine Peaküberlagerung durch Matrix ist zunächst möglich. Die neue gültige Kalibrierung A=75c+10 gilt nur0,5–4,0mg/L. Nach anfänglicher Probenverdünnung6 liefert die Probe A=460. Plane UND führe geeignete Selektivitätskontrollen und zusätzliche Verdünnung mit neuer Messung aus; eine weitere dreifache Verdünnung liefert bei geeigneter Trennung A=160.",
                "taskDemandEn": "Plan and carry out an assay on a fresh suitable sample of now-specified ethylparaben; justify suitable method and standards again using its supplied structure. Matrix peak overlap is initially possible. New valid calibration A=75c+10 applies only to0.5–4.0mg/L. After initial sample dilution6 the sample gives A=460. Plan AND actually perform appropriate selectivity controls and additional dilution with new measurement; a further threefold dilution gives A=160 when separation is suitable.",
                "expectedPerformanceDe": "Eigene frische Kontroll-/Messprotokolle belegen Durchführung und geprüfte Trennung; weder identische Retentionszeit noch allein ein Standard beweisen Abwesenheit von Koelution. A=460 ergäbe6,0mg/L außerhalb des Bereichs und darf nicht als gültiger Gehalt extrapoliert werden. Neue tatsächlich geeignet getrennte Messung A=160 liefert2,0mg/L; Gesamtverdünnung18 ergibt36,0mg/L Original. Ohne belegte Selektivität bleibt die präzise analytspezifische Gehaltsangabe offen. Keine ungeprüfte Übernahme der Methylparaben-Kalibrierung.",
                "expectedPerformanceEn": "The learner’s fresh control/measurement records demonstrate execution and checked separation; neither matching retention time nor a standard alone proves absence of coelution. A=460 would give6.0mg/L outside range and cannot be extrapolated as a valid content. The new actually suitably separated measurement A=160 gives2.0mg/L; total dilution18 gives36.0mg/L original. Without evidenced selectivity the precise analyte-specific content remains open. Do not reuse the methylparaben calibration unchecked.",
                "understandingFocusDe": "Frischer eigenständiger analytspezifischer Experimentaltransfer mit Bereichs- und Matrixgrenzen.",
                "understandingFocusEn": "Fresh independent analyte-specific experimental transfer with range and matrix limitations."
              }
            ]
          }
        }
      ],

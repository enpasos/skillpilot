      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "procedure",
            "expectations": [
              {
                "id": "core-understanding",
                "essentialUnderstandingDe": "Grundlegende IUPAC-Benennung verbindet Stammkette, funktionelle Hauptgruppe, Nummerierung und Positionen. Der Name muss dieselbe Konstitution ausdrücken; Auswahl einer längeren Kette darf die Hauptgruppe nicht ausschließen. Hier werden einfache acyclische Beispiele betrachtet.",
                "essentialUnderstandingEn": "Basic IUPAC naming combines parent chain, principal functional group, numbering and locants. A name must preserve connectivity; choosing a longer chain must not exclude the principal group. Simple acyclic examples are considered here.",
                "observablePerformanceDe": "A Ethanol; B Propanal; C Butan-2-on; D Propansäure. Bei B und D zählt das Carbonyl-/Carboxyl-C zur dreigliedrigen Stammkette und ist C1. Bei C wird die Kette so nummeriert, dass die Ketonfunktion die kleinere Positionszahl 2 erhält; Butan-3-on ist hier dieselbe Struktur mit ungünstiger Nummerierung. Die Endungen -ol, -al, -on und -säure kennzeichnen die passende Gruppe, nicht die Zahl der O-Atome allein.",
                "observablePerformanceEn": "A ethanol; B propanal; C butan-2-one; D propanoic acid. The carbonyl/carboxyl carbon is included in the three-carbon parent of B and D and is C1. C is numbered to give the ketone function the lower locant 2; butan-3-one would describe the same structure with unfavorable numbering. Suffixes -ol, -al, -one and -oic acid designate the group, not merely oxygen count."
              },
              {
                "id": "fresh-transfer-and-limit",
                "essentialUnderstandingDe": "Unverzweigte Vertreter aller vier Klassen gegenüber verzweigten Alkoholen, Ketonen und einer Carbonsäure; Position und Kettenwahl. Eine Positionsnummer oder Verzweigung wird nicht aus einer bloßen Summenformel ohne Struktur erschlossen.",
                "essentialUnderstandingEn": "Unbranched examples of all four classes versus branched alcohols, ketones and a carboxylic acid; locants and parent-chain choice. A locant or branching pattern is not inferred from a molecular formula without structural information.",
                "observablePerformanceDe": "E: 3-Methylbutan-2-ol; F: 3-Methylbutan-2-on; G: 2-Methylpropansäure; H: Butan-2-ol. In E hat die OH-Hauptgruppe Vorrang bei der Nummerierung: 2 statt 3, auch wenn dadurch Methyl 3 erhält. G zählt das COOH-C als C1. CH3CH2CH2CH2OH wäre Butan-1-ol und eine andere Konstitution als H; vier C und die Endung -ol allein bestimmen die Position nicht. Die Beispiele haben keine festgelegte räumliche Konfiguration, daher werden keine R/S-Namen erfunden.",
                "observablePerformanceEn": "E: 3-methylbutan-2-ol; F: 3-methylbutan-2-one; G: 2-methylpropanoic acid; H: butan-2-ol. In E, OH takes numbering priority, receiving 2 rather than 3 even though methyl then receives 3. In G the COOH carbon is C1. CH3CH2CH2CH2OH is butan-1-ol, a different connectivity from H; four carbons and -ol alone do not determine position. Spatial configuration is not specified, so no R/S descriptors are invented."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "core-understanding",
                "fresh-transfer-and-limit"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-system-variation",
                "textDe": "Unverzweigte Vertreter aller vier Klassen gegenüber verzweigten Alkoholen, Ketonen und einer Carbonsäure; Position und Kettenwahl.",
                "textEn": "Unbranched examples of all four classes versus branched alcohols, ketones and a carboxylic acid; locants and parent-chain choice."
              },
              {
                "id": "model-boundary",
                "textDe": "Eine Positionsnummer oder Verzweigung wird nicht aus einer bloßen Summenformel ohne Struktur erschlossen.",
                "textEn": "A locant or branching pattern is not inferred from a molecular formula without structural information."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next20-e14abd24-case-1",
                "taskDemandDe": "Gegebene Halbstrukturformeln: A CH3CH2OH; B CH3CH2CHO; C CH3COCH2CH3; D CH3CH2COOH. Es ist jeweils genau eine der Hauptgruppen Alkohol, Aldehyd, Keton oder Carbonsäure vorhanden; Isotopen- und Stereodeskriptoren werden nicht verlangt. Benenne alle vier systematisch und erläutere für C die Nummerierung sowie für B und D, ob das funktionelle C zur Stammkette zählt.",
                "taskDemandEn": "Supplied condensed formulas: A CH3CH2OH; B CH3CH2CHO; C CH3COCH2CH3; D CH3CH2COOH. Each contains exactly one principal alcohol, aldehyde, ketone or carboxylic-acid group; isotope and stereochemical descriptors are not required. Give systematic names for all four and explain numbering in C and whether the functional carbon is counted in B and D.",
                "expectedPerformanceDe": "A Ethanol; B Propanal; C Butan-2-on; D Propansäure. Bei B und D zählt das Carbonyl-/Carboxyl-C zur dreigliedrigen Stammkette und ist C1. Bei C wird die Kette so nummeriert, dass die Ketonfunktion die kleinere Positionszahl 2 erhält; Butan-3-on ist hier dieselbe Struktur mit ungünstiger Nummerierung. Die Endungen -ol, -al, -on und -säure kennzeichnen die passende Gruppe, nicht die Zahl der O-Atome allein.",
                "expectedPerformanceEn": "A ethanol; B propanal; C butan-2-one; D propanoic acid. The carbonyl/carboxyl carbon is included in the three-carbon parent of B and D and is C1. C is numbered to give the ketone function the lower locant 2; butan-3-one would describe the same structure with unfavorable numbering. Suffixes -ol, -al, -one and -oic acid designate the group, not merely oxygen count.",
                "understandingFocusDe": "Englische Säurenamen nutzen -oic acid, deutsche -säure; gleiche Konstitution trotz verschiedener sprachlicher Endungen.",
                "understandingFocusEn": "English acid names use -oic acid and German names -säure; the same connectivity is retained across languages."
              },
              {
                "id": "chem-next20-e14abd24-case-2",
                "taskDemandDe": "Frische Halbstrukturformeln: E CH3CH(OH)CH(CH3)CH3; F CH3COCH(CH3)CH3; G (CH3)2CHCOOH; H CH3CH(OH)CH2CH3. Die Hauptgruppe soll die niedrigste zulässige Nummer erhalten; die Kette muss sie enthalten. Benenne E bis H, begründe für E die Richtung und zeichne als Text-Halbstrukturformel einen anderen Alkohol mit vier C-Atomen als Gegenprobe zur Eindeutigkeit von H.",
                "taskDemandEn": "Fresh condensed formulas: E CH3CH(OH)CH(CH3)CH3; F CH3COCH(CH3)CH3; G (CH3)2CHCOOH; H CH3CH(OH)CH2CH3. The principal functional group receives the lowest permissible locant and must be included in the parent chain. Name E through H, justify numbering direction in E and give a condensed formula for a different four-carbon alcohol to check that H has a specific identity.",
                "expectedPerformanceDe": "E: 3-Methylbutan-2-ol; F: 3-Methylbutan-2-on; G: 2-Methylpropansäure; H: Butan-2-ol. In E hat die OH-Hauptgruppe Vorrang bei der Nummerierung: 2 statt 3, auch wenn dadurch Methyl 3 erhält. G zählt das COOH-C als C1. CH3CH2CH2CH2OH wäre Butan-1-ol und eine andere Konstitution als H; vier C und die Endung -ol allein bestimmen die Position nicht. Die Beispiele haben keine festgelegte räumliche Konfiguration, daher werden keine R/S-Namen erfunden.",
                "expectedPerformanceEn": "E: 3-methylbutan-2-ol; F: 3-methylbutan-2-one; G: 2-methylpropanoic acid; H: butan-2-ol. In E, OH takes numbering priority, receiving 2 rather than 3 even though methyl then receives 3. In G the COOH carbon is C1. CH3CH2CH2CH2OH is butan-1-ol, a different connectivity from H; four carbons and -ol alone do not determine position. Spatial configuration is not specified, so no R/S descriptors are invented.",
                "understandingFocusDe": "Eine Positionsnummer oder Verzweigung wird nicht aus einer bloßen Summenformel ohne Struktur erschlossen.",
                "understandingFocusEn": "A locant or branching pattern is not inferred from a molecular formula without structural information."
              }
            ]
          }
        }
      ],

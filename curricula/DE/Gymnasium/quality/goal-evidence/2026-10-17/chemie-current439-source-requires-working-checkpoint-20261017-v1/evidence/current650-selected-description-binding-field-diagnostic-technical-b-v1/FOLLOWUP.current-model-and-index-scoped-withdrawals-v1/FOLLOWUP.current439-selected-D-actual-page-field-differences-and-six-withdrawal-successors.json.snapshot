      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "modeling",
            "expectations": [
              {
                "id": "whole-duty-1",
                "essentialUnderstandingDe": "Thermodynamische Tendenz von kinetischer Geschwindigkeit trennen.",
                "essentialUnderstandingEn": "Distinguish thermodynamic tendency and kinetic rate.",
                "observablePerformanceDe": "Thermodynamische Tendenz von kinetischer Geschwindigkeit trennen. Zweiter unabhängiger Kontext: Schutzfilmwirkung im Legierungsmodell erklären.",
                "observablePerformanceEn": "Distinguish thermodynamic tendency and kinetic rate. Second independent context: Explain protective-film effect in alloy model."
              },
              {
                "id": "whole-duty-2",
                "essentialUnderstandingDe": "Dichten Film und porösen Rost anhand Daten erklären.",
                "essentialUnderstandingEn": "Explain dense film and porous rust using data.",
                "observablePerformanceDe": "Dichten Film und porösen Rost anhand Daten erklären. Zweiter unabhängiger Kontext: Lokale Ausnahme statt pauschaler Beständigkeit begründen.",
                "observablePerformanceEn": "Explain dense film and porous rust using data. Second independent context: Explain local exception instead of universal resistance."
              },
              {
                "id": "whole-duty-3",
                "essentialUnderstandingDe": "Verwendungsurteil an konkrete Umgebung binden.",
                "essentialUnderstandingEn": "Bind use judgment to specific environment.",
                "observablePerformanceDe": "Verwendungsurteil an konkrete Umgebung binden. Zweiter unabhängiger Kontext: Verwendungsoptionen mit Umgebung und Kosten verbinden.",
                "observablePerformanceEn": "Bind use judgment to specific environment. Second independent context: Connect use options with environment and cost."
              },
              {
                "id": "whole-duty-4",
                "essentialUnderstandingDe": "Legierungs- und Chloridgrenzen fachlich nennen.",
                "essentialUnderstandingEn": "State alloy and chloride limits scientifically.",
                "observablePerformanceDe": "Legierungs- und Chloridgrenzen fachlich nennen. Zweiter unabhängiger Kontext: Datenbedarf und Standardpotenzialgrenze benennen.",
                "observablePerformanceEn": "State alloy and chloride limits scientifically. Second independent context: State data requirements and standard-potential limit."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "whole-duty-1",
                "whole-duty-2",
                "whole-duty-3",
                "whole-duty-4"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "whole-case-material",
                "textDe": "Unedles Aluminium mit Schutzfilm / Legierung mit Passivierung und lokale Ausnahme",
                "textEn": "Base aluminium with protective film / Alloy passivation and local exception"
              },
              {
                "id": "independent-transfer",
                "textDe": "Frisch: Schutzfilm wird lokal beschädigt, kann in neutraler Umgebung rasch nachwachsen. Was folgt, und was folgt nicht? / Frisch: gleicher WerkstoffR, aber neuer unbekannter saurer Prozess. Ist bisheriges Urteil übertragbar?",
                "textEn": "Fresh:protective film is locally damaged but can regrow quickly in neutral environment. What follows and what does not? / Fresh:same materialR but a new unknown acidic process. Is the previous judgment transferable?"
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "q3-16-a",
                "taskDemandDe": "Fiktive Vergleichsdaten: Standardpotenzial Al³⁺/Al−1,66V,Fe²⁺/Fe−0,44V. In neutraler Umgebung bildet Al eine dichte haftende Oxidschicht, Eisen im Modell porösen Rost. Chloridhaltige Umgebung kann den Al-Film lokal stören. Erkläre die Abweichung von einfacher Potenzialerwartung und leite Verwendungsmöglichkeiten unter den genannten Bedingungen ab. Beziehe Legierungen und Grenzen allgemeiner Korrosionsurteile ein. Separat frischer Transfer: Frisch: Schutzfilm wird lokal beschädigt, kann in neutraler Umgebung rasch nachwachsen. Was folgt, und was folgt nicht?",
                "expectedPerformanceDe": "Al ist thermodynamisch unedel, reagiert aber nach Filmaufbau kinetisch langsamer, weil die dichte Schicht weiteren Stoff-/Ladungstransport hemmt. Poröser Eisenrost schützt hier weniger. Al ist deshalb im neutralen Modell für Außenbauteile plausibel; chloridbelastete Anwendungen brauchen eigene Prüfung gegen lokalen Angriff. Legierungszusammensetzung kann Schutzfilme und Lokalelemente verändern; „unedel heißt immer schnell“ ist falsch. Transferantwort: Lokaler Angriff kann zunächst steigen, nachwachsende Passivschicht kann ihn begrenzen. Daraus folgt weder Immunität in jeder Lösung noch eine Änderung der Standardpotenziale der unveränderten Redoxpaare. Scoring /10: 2P: Thermodynamische Tendenz von kinetischer Geschwindigkeit trennen.; 2P: Dichten Film und porösen Rost anhand Daten erklären.; 2P: Verwendungsurteil an konkrete Umgebung binden.; 2P: Legierungs- und Chloridgrenzen fachlich nennen.; 2P: Lokaler Angriff kann zunächst steigen, nachwachsende Passivschicht kann ihn begrenzen. Daraus folgt weder Immunität in jeder Lösung noch eine Änderung der Standardpotenziale der unveränderten Redoxpaare.",
                "understandingFocusDe": "Ganzes aktuelles Ziel einschließlich aller Operatoren; keine Punktvergabe für nicht ausgeführte Experimente. Eine begründete Werkstoffverwendung aus Korrosions-/Passivierungsdaten. Erklärung und Nutzungsurteil beziehen sich auf dieselbe Werkstoff-Umgebungsbeziehung.",
                "taskDemandEn": "Fictional comparison data:standard potential Al³⁺/Al−1.66V,Fe²⁺/Fe−0.44V. In neutral environmentAl forms a dense adhering oxide film;iron forms porous rust in the model. Chloride-containing environment can locally disruptAl film. Explain departure from simple potential-based expectation and derive possible uses under the stated conditions. Include alloys and limits of general corrosion judgments. Separate fresh transfer: Fresh:protective film is locally damaged but can regrow quickly in neutral environment. What follows and what does not?",
                "expectedPerformanceEn": "Al is thermodynamically base but reacts more slowly after film formation because the dense layer inhibits further material/charge transport. Porous iron rust protects less here. ThusAl is plausible for external components in the neutral model;chloride exposure needs separate checks for local attack. Alloy composition can change protective films and local cells;“base always means fast” is false. Transfer response: Local attack can initially increase and regrowing passive film can limit it. This implies neither immunity in every solution nor changed standard potentials. Scoring /10: 2P: Distinguish thermodynamic tendency and kinetic rate.; 2P: Explain dense film and porous rust using data.; 2P: Bind use judgment to specific environment.; 2P: State alloy and chloride limits scientifically.; 2P: Local attack can initially increase and regrowing passive film can limit it. This implies neither immunity in every solution nor changed standard potentials.",
                "understandingFocusEn": "Whole current goal including all operators; explain the evidence, perform the specified calculation or judgment and apply the separate fresh transfer. Synthetic authored work is not actual learner performance."
              },
              {
                "id": "q3-16-b",
                "taskDemandDe": "Synthetische Werkstoffdaten: StahlS bildet porösen Rost; LegierungR enthält genügend Cr für dichten passiven Oxidfilm in belüfteter neutraler Umgebung. In einer sauerstoffarmen chloridhaltigen Spalte kann R lokal angegriffen werden. Kosten R3,S1; Masse und Lastanforderung gleich. Erkläre unterschiedliches Korrosionsverhalten und mögliche Ausnahme. Leite eine bedingte Verwendung für belüftete Oberfläche versus chloridhaltige Spalte ab. Separat frischer Transfer: Frisch: gleicher WerkstoffR, aber neuer unbekannter saurer Prozess. Ist bisheriges Urteil übertragbar?",
                "expectedPerformanceDe": "Cr-bedingte Passivierung hemmt weitere Reaktion durch einen dichten Film; R kann trotz unedler Bestandteile beständiger sein als S. Die Spalte kann lokale Filmstörung und unzureichende Repassivierung ermöglichen, sodass „rostfrei“ nicht universell gilt. R ist im belüfteten neutralen Modell plausibel, höhere Kosten sind abzuwägen. Für die Spalte sind zusätzliche Werkstoff-/Umgebungsdaten erforderlich; bloße Standardpotenziale reichen nicht. Transferantwort: Nicht ohne neue Filmstabilitäts- und Korrosionsdaten. Legierungsname allein beweist Eignung nicht. Scoring /10: 2P: Schutzfilmwirkung im Legierungsmodell erklären.; 2P: Lokale Ausnahme statt pauschaler Beständigkeit begründen.; 2P: Verwendungsoptionen mit Umgebung und Kosten verbinden.; 2P: Datenbedarf und Standardpotenzialgrenze benennen.; 2P: Nicht ohne neue Filmstabilitäts- und Korrosionsdaten. Legierungsname allein beweist Eignung nicht.",
                "understandingFocusDe": "Ganzes aktuelles Ziel einschließlich aller Operatoren; keine Punktvergabe für nicht ausgeführte Experimente. Eine begründete Werkstoffverwendung aus Korrosions-/Passivierungsdaten. Erklärung und Nutzungsurteil beziehen sich auf dieselbe Werkstoff-Umgebungsbeziehung.",
                "taskDemandEn": "Synthetic materials data:steelS forms porous rust;alloyR contains enoughCr for dense passive oxide film in aerated neutral environment. In an oxygen-poor chloride-containing creviceR can suffer local attack. CostR3,S1;mass and load requirement equal. Explain different corrosion behaviour and possible exception. Derive conditional use for aerated surface versus chloride-containing crevice. Separate fresh transfer: Fresh:same materialR but a new unknown acidic process. Is the previous judgment transferable?",
                "expectedPerformanceEn": "Cr-related passivation inhibits further reaction with a dense film;R can be more resistant thanS despite base constituents. A crevice can allow local film disruption and insufficient repassivation,so “stainless” is not universal. R is plausible in the aerated neutral model,while higher cost must be weighed. The crevice needs additional material/environment data;standard potentials alone are insufficient. Transfer response: Not without new film-stability and corrosion data. Alloy name alone does not establish suitability. Scoring /10: 2P: Explain protective-film effect in alloy model.; 2P: Explain local exception instead of universal resistance.; 2P: Connect use options with environment and cost.; 2P: State data requirements and standard-potential limit.; 2P: Not without new film-stability and corrosion data. Alloy name alone does not establish suitability.",
                "understandingFocusEn": "Whole current goal including all operators; explain the evidence, perform the specified calculation or judgment and apply the separate fresh transfer. Synthetic authored work is not actual learner performance."
              }
            ]
          }
        }
      ],

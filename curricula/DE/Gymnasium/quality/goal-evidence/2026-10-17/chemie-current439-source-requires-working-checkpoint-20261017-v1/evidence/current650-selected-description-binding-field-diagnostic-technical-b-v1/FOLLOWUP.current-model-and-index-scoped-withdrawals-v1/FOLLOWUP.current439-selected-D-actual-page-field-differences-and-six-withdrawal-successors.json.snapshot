      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "single-particle-u-and-bulk-grams",
                "essentialUnderstandingDe": "u ist eine Masseneinheit für einzelne Teilchen, g ist für Proben praktikabel. Eine Teilchenmasse von etwa x u entspricht numerisch etwa einer molaren Masse x g/mol, weil ein mol sehr viele Teilchen enthält. Das ist keine Gleichsetzung u=g; der Zahlenbezug ist bei heutiger SI-Definition näherungsweise, nicht exakt.",
                "essentialUnderstandingEn": "The unit u is convenient for individual-particle masses, while grams are practical for samples. A particle mass of about x u corresponds numerically to about x g/mol because a mol contains very many particles. This does not mean u=g; with the current SI definition the numerical correspondence is approximate rather than exact.",
                "observablePerformanceDe": "Die lernende Person verbindet einzelne Teilchen und Probenmasse mit nachvollziehbarer Teilchenzahl, kennzeichnet Näherungen und erkennt einen Größenordnungsfehler durch unzulässigen Austausch von u und g.",
                "observablePerformanceEn": "The learner connects individual-particle and sample mass using a justified particle count, marks approximations and detects an order-of-magnitude error caused by replacing u with g."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "single-particle-u-and-bulk-grams"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "scale",
                "textDe": "Masse eines einzelnen Moleküls wird mit der Masse einer großen angegebenen Teilchenzahl verglichen.",
                "textEn": "One molecule’s mass is compared with the mass of a specified large particle count."
              },
              {
                "id": "sample-size",
                "textDe": "Ein mol wird durch eine Viertel-mol entsprechende Molekülzahl ersetzt.",
                "textEn": "One mol is replaced by a particle count corresponding to a quarter mol."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "carbon-dioxide-scale",
                "taskDemandDe": "Ein CO2-Molekül besitzt in diesem gerundeten Modell 44,0 u Masse. Nutze 1 u≈1,66054·10^-24 g und NA≈6,02214·10^23 mol^-1. Schätze die Masse eines Moleküls und von einem mol CO2. Prüfe: „Ein CO2-Molekül wiegt 44 g.“ Erkläre den Zusammenhang der Zahlen44 auf den beiden Maßstäben.",
                "taskDemandEn": "In this rounded model, one CO2 molecule has a mass of 44.0 u. Use 1 u≈1.66054×10^-24 g and NA≈6.02214×10^23 mol^-1. Estimate the mass of one molecule and of one mol CO2. Check: “One CO2 molecule weighs 44 g.” Explain how the number44 is related across the two scales.",
                "expectedPerformanceDe": "Ein Molekül wiegt etwa7,31·10^-23 g; ein mol wiegt etwa44,0 g. Die sehr große Zahl von Molekülen multipliziert die sehr kleine Teilchenmasse. 44u für ein Molekül und44g für ein mol teilen einen annähernden Zahlenwert, aber nicht dieselbe Einheit oder denselben Bezug; das ist keine exakte SI-Identität u=g.",
                "expectedPerformanceEn": "One molecule weighs about7.31×10^-23 g; one mol weighs about44.0 g. The very large particle count multiplies the very small particle mass. A molecule’s44u and a mol’s44g have approximately corresponding numerical values but different units and reference entities; they do not establish an exact SI identity u=g.",
                "understandingFocusDe": "Die Größenordnung und der Teilchenzahlfaktor erklären den Maßstabwechsel.",
                "understandingFocusEn": "Order of magnitude and the particle-count factor explain the change of scale."
              },
              {
                "id": "methane-quarter-count-fresh",
                "taskDemandDe": "Frischer Fall: Eine Probe enthält 1,505535·10^23 CH4-Moleküle. Jedes besitzt im gerundeten Modell16,0u. Gegeben: 1u≈1,66054·10^-24g und NA≈6,02214·10^23mol^-1. Bestimme die Probenmasse und erkläre, warum weder16g je Molekül noch16g für diese Probe richtig ist. Lege deinen Maßstabwechsel offen.",
                "taskDemandEn": "Fresh case: a sample contains1.505535×10^23 CH4 molecules, each with mass16.0u in a rounded model. Given1u≈1.66054×10^-24g and NA≈6.02214×10^23mol^-1, determine the sample mass and explain why neither16g per molecule nor16g for this sample is correct. Make your change of scale explicit.",
                "expectedPerformanceDe": "Ein Molekül hat etwa2,66·10^-23g; die angegebene Anzahl ist ein Viertel der Molekülzahl pro mol. Die Probe wiegt daher etwa4,00g. Die16u werden erst in Gramm pro Molekül umgerechnet und anschließend mit der Anzahl multipliziert; alternativ begründete Viertel-mol-Masse von etwa16g/mol.",
                "expectedPerformanceEn": "One molecule weighs about2.66×10^-23g; the given count is a quarter of the count in one mol. The sample therefore weighs about4.00g. Convert16u into grams per molecule before multiplying by the count, or justify the quarter-mol amount with a molar mass of about16g/mol.",
                "understandingFocusDe": "Frische Teilchenzahl statt bereitstehender Stoffmenge; erklärter statt bloß formaler u/g-Austausch.",
                "understandingFocusEn": "A fresh particle count replaces a ready-made amount; the u/g relation must be explained rather than substituted mechanically."
              }
            ]
          }
        }
      ],

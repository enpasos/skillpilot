      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "content-specific-understanding",
                "essentialUnderstandingDe": "ZweidimensionaleSchnitte derWellenfunktion tragenAmplitude undPhase;dasBetragsquadrat beschreibt nichtnegativeDichte. BeimH2-Modell verändert Überlagerung derAtomfunktionen dieDichte zwischen denKernen.",
                "essentialUnderstandingEn": "Two-dimensional wave-function sections carry amplitude and phase;the modulus square describes nonnegative density.Overlap of atomic functions changes inter-nuclear density in theH2 model.",
                "observablePerformanceDe": "RelativeDichten4/1/nahe0;nichtnegativeDichte nimmt hier mitAbstand ab. Räumlich kugelsymmetrische1s-Verteilung statt gezeichneterKreisbahn. ψ und−ψ hätten gleicheDichte;Phase geht imisoliertenBetragsquadrat verloren. DieZahlen sind relativeDichten,keine normiertenGesamtwahrscheinlichkeiten.",
                "observablePerformanceEn": "Relative densities4/1/near0;nonnegative density here decreases with distance.Spatial spherical1s distribution rather than a circular path.ψ and−ψ have identical density;phase is lost in the isolated modulus square.Numbers are relative densities,not normalised total probabilities."
              },
              {
                "id": "fresh-transfer-and-model-boundary",
                "essentialUnderstandingDe": "DievorgegebenenlokalenAmplituden undNormierungsfaktoren bestimmen keineGesamtwahrscheinlichkeit ohne räumlicheIntegration;H2 allein beweist nicht alleMO-Reihenfolgen derzweitenPeriode.",
                "essentialUnderstandingEn": "The supplied local amplitudes and normalisation factors give no total probability without spatial integration;H2 alone does not establish every second-periodMO order.",
                "observablePerformanceDe": "ImMittelbereichψ+=2N+,Dichte4N+²;ψ−=0,Dichte0,Knoten. BeimBetragsquadrat derSumme tritt einInterferenzterm auf;|ψA|²+|ψB|² allein lässt ihn aus. BindendesModell erhöht inter-nukleareDichte;antibindend hat denKnoten. RäumlicheKonturen sindaus demModell abgeleitet,nicht gezeichneteElektronenbahnen.",
                "observablePerformanceEn": "Centrallyψ+=2N+,density4N+²;ψ−=0,density0,a node.Squaring a sum includes an interference term;|ψA|²+|ψB|² alone omits it.The bonding model enhances inter-nuclear density;antibonding has the node.Spatial contours derive from the model,not drawn electron paths."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "content-specific-understanding",
                "fresh-transfer-and-model-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-material-variation",
                "textDe": "H-1s-Schnitt gegenüberH2-Bindungs-/Antibindungsmodell;Phase undDichte statt elektrischeLadungsfarben.",
                "textEn": "H1s section versusH2 bonding/antibonding model;phase and density rather than charge colours."
              },
              {
                "id": "specific-model-limit",
                "textDe": "DievorgegebenenlokalenAmplituden undNormierungsfaktoren bestimmen keineGesamtwahrscheinlichkeit ohne räumlicheIntegration;H2 allein beweist nicht alleMO-Reihenfolgen derzweitenPeriode.",
                "textEn": "The supplied local amplitudes and normalisation factors give no total probability without spatial integration;H2 alone does not establish every second-periodMO order."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next25-fbc5a920-case-1",
                "taskDemandDe": "QualitativerH-1s-Schnitt um einenKern:ψ in zentralerRegion+2,weiteraußen+1,fernnahe0 in unnormiertenModell-Amplitudeneinheiten. DieZeichen+ kennzeichnenPhase. Für1s ist derSchnitt rotationssymmetrisch undknotenfrei;eine zeichnerischeKontur ist keinphysischerRand. Ordne denSchnitt einer räumlichen1s-Dichte zu,quadriere dieAmplituden undbegründe,welcheInformation durchQuadrieren verschwindet.",
                "taskDemandEn": "QualitativeH1s section about one nucleus:ψ central+2,farther out+1,distant near0 in unnormalised model amplitude units.Plus signs indicate phase.The1s section is rotationally symmetric and node-free;a contour is no physical boundary. Relate the section to spatial1s density,square the amplitudes and explain what information is lost by squaring.",
                "expectedPerformanceDe": "RelativeDichten4/1/nahe0;nichtnegativeDichte nimmt hier mitAbstand ab. Räumlich kugelsymmetrische1s-Verteilung statt gezeichneterKreisbahn. ψ und−ψ hätten gleicheDichte;Phase geht imisoliertenBetragsquadrat verloren. DieZahlen sind relativeDichten,keine normiertenGesamtwahrscheinlichkeiten.",
                "expectedPerformanceEn": "Relative densities4/1/near0;nonnegative density here decreases with distance.Spatial spherical1s distribution rather than a circular path.ψ and−ψ have identical density;phase is lost in the isolated modulus square.Numbers are relative densities,not normalised total probabilities.",
                "understandingFocusDe": "HoheDichte nahe demKern bedeutet nicht,dass die Wahrscheinlichkeit eines exaktpunktförmigenOrtes endlich ist.",
                "understandingFocusEn": "High density near the nucleus does not mean a finite probability for an exact mathematical point."
              },
              {
                "id": "chem-next25-fbc5a920-case-2",
                "taskDemandDe": "FrischerH2-Schnitt:zwischen denKernen liefern zweiH-Atomfunktionen lokaleAmplitudenψA=+1,ψB=+1. BindendesModellψ+=N+(ψA+ψB);antibindendesψ−=N−(ψA−ψB),mit positivenNormierungsfaktoren. Farben markierenPhase,keineLadung. Außerhalb desMittelbereichs sindFunktionen nichtidentisch. Deute beide2D-Amplituden undihre räumlicheDichte;erkläreMittelknoten bzw.konstruktiveÜberlagerung undkorrigiere bloßesAddieren derAtomdichten.",
                "taskDemandEn": "FreshH2 section:between nuclei twoH functions have local amplitudesψA=+1,ψB=+1.Bondingψ+=N+(ψA+ψB);antibondingψ−=N−(ψA−ψB),with positive normalisation factors.Colours mark phase,not charge.Outside the central region functions are not identical. Interpret both2D amplitudes and spatial densities;explain the central node versus constructive overlap and correct merely adding atomic densities.",
                "expectedPerformanceDe": "ImMittelbereichψ+=2N+,Dichte4N+²;ψ−=0,Dichte0,Knoten. BeimBetragsquadrat derSumme tritt einInterferenzterm auf;|ψA|²+|ψB|² allein lässt ihn aus. BindendesModell erhöht inter-nukleareDichte;antibindend hat denKnoten. RäumlicheKonturen sindaus demModell abgeleitet,nicht gezeichneteElektronenbahnen.",
                "expectedPerformanceEn": "Centrallyψ+=2N+,density4N+²;ψ−=0,density0,a node.Squaring a sum includes an interference term;|ψA|²+|ψB|² alone omits it.The bonding model enhances inter-nuclear density;antibonding has the node.Spatial contours derive from the model,not drawn electron paths.",
                "understandingFocusDe": "DievorgegebenenlokalenAmplituden undNormierungsfaktoren bestimmen keineGesamtwahrscheinlichkeit ohne räumlicheIntegration;H2 allein beweist nicht alleMO-Reihenfolgen derzweitenPeriode.",
                "understandingFocusEn": "The supplied local amplitudes and normalisation factors give no total probability without spatial integration;H2 alone does not establish every second-periodMO order."
              }
            ]
          }
        }
      ],

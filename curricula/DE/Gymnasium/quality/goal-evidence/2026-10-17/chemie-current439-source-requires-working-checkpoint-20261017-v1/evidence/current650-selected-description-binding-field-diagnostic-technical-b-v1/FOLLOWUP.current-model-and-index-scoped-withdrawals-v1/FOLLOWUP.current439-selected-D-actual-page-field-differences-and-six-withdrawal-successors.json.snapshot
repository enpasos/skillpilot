      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "procedure",
            "expectations": [
              {
                "id": "content-specific-understanding",
                "essentialUnderstandingDe": "ComputergestützteMoleküldarstellung verlangt einen tatsächlich erzeugten/bedienten digitalenStrukturgegenstand mit korrekterAtomverknüpfung und räumlicherAnsicht;Modelldarstellung und physischeMolekülmessung bleiben getrennt.",
                "essentialUnderstandingEn": "Computer molecular modelling requires an actually created/manipulated digital structure with correct connectivity and spatial views;model display remains distinct from physical molecular measurement.",
                "observablePerformanceDe": "Erforderlicher spätererNachweis:eigeneDigitaleingabe mitC2H6 undje4Bindungsvalenzen amC,Rotations-/Ansichtswechsel anhandeigenerDatei/Ansichten nachvollziehbar. TetraedrischelokaleStruktur wird erläutert,Kugelgrößen sindDarstellungskonventionen. Ohne tatsächlichen digitalenNachweis bleibt dieAusführung offen.",
                "observablePerformanceEn": "Required future evidence:personal digital input withC2H6 and four bond valences perC;rotation/view changes traceable through the personal file/views.Local tetrahedral structure is explained,sphere sizes are display conventions.Without actual digital evidence execution stays open."
              },
              {
                "id": "fresh-transfer-and-model-boundary",
                "essentialUnderstandingDe": "DieSoftware kann mitfalscherBindungsordnung ein anderesMolekül generieren;eine automatischeBildausgabe ist daher kein fachlicherKorrektheitsbeleg und kein bereits erfüllterAusführungsnachweis.",
                "essentialUnderstandingEn": "Software can generate a different molecule from incorrect bond order;automatic image output therefore proves neither correctness nor already demonstrated execution.",
                "observablePerformanceDe": "ErforderlicherNachweis:korrektes eigenbearbeitetesC3H6-Modell mitC1=C2 undMethyl-C;lokal planar amAlken,tetraedrisch amMethyl im verwendetenModell. EigeneDatei/Ansichten machenEingriff undRotation prüfbar;diePerson nenntTool-/Geometrie-Modell statt einegezeichneteLänge alsMessung auszugeben.",
                "observablePerformanceEn": "Required evidence:personally edited correctC3H6 model withC1=C2 and a methylC;locally planar at thealkene,tetrahedral at methyl in the chosen model.Personal files/views make edits and rotation checkable;the learner states tool/geometry model instead of treating displayed lengths as measurements."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "content-specific-understanding",
                "fresh-transfer-and-model-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-material-variation",
                "textDe": "Ethan gegenüberPropen;Kugel-Stab/Kalotten,digitaleRotation und unterschiedliche lokaleGeometrie.",
                "textEn": "Ethane versuspropene;ball-and-stick/space-filling,digital rotation and different local geometries."
              },
              {
                "id": "specific-model-limit",
                "textDe": "DieSoftware kann mitfalscherBindungsordnung ein anderesMolekül generieren;eine automatischeBildausgabe ist daher kein fachlicherKorrektheitsbeleg und kein bereits erfüllterAusführungsnachweis.",
                "textEn": "Software can generate a different molecule from incorrect bond order;automatic image output therefore proves neither correctness nor already demonstrated execution."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next25-707998c1-case-1",
                "taskDemandDe": "Späterer praktischerLeistungsfall mit bereitgestelltem schulischenMolecular-Modelling-Programm:ethaneCH3–CH3,zweiC/sechsH,Einfachbindungen. DieSoftware bietet3D-Rotation undKugel-Stab/Kalottenansicht. EinebloßePapierzeichnung und diehier genanntenSollbefunde ersetzen keine eigeneBedienung. Erzeuge tatsächlich denEthan-Strukturgegenstand,prüfeValenzen,rotiere ihn undwechsle dieAnsicht. Speichere dieeigeneModelldatei undzweiAnsichten mitTool-/Modellangabe;erkläre dieDarstellungsgrenze.",
                "taskDemandEn": "Future practical performance using supplied school molecular-modelling software:ethaneCH3–CH3,twoC/sixH,single bonds.The software offers3D rotation andball-and-stick/space-filling views.A paper drawing and the stated expected findings do not replace personal tool use. Actually create theethane structure,check valences,rotate it and change views.Save the personal model file and two views with tool/model attribution;explain the representation limit.",
                "expectedPerformanceDe": "Erforderlicher spätererNachweis:eigeneDigitaleingabe mitC2H6 undje4Bindungsvalenzen amC,Rotations-/Ansichtswechsel anhandeigenerDatei/Ansichten nachvollziehbar. TetraedrischelokaleStruktur wird erläutert,Kugelgrößen sindDarstellungskonventionen. Ohne tatsächlichen digitalenNachweis bleibt dieAusführung offen.",
                "expectedPerformanceEn": "Required future evidence:personal digital input withC2H6 and four bond valences perC;rotation/view changes traceable through the personal file/views.Local tetrahedral structure is explained,sphere sizes are display conventions.Without actual digital evidence execution stays open.",
                "understandingFocusDe": "EinehübschevorgegebeneScreenshot-Lösung oderbloßeSoftwarebeschreibung belegt keine selbst ausgeführteComputer-Modellierung;keinHumanTrial wird behauptet.",
                "understandingFocusEn": "A supplied attractive screenshot or software description establishes no personally executed computer modelling;no human trial is claimed."
              },
              {
                "id": "chem-next25-707998c1-case-2",
                "taskDemandDe": "Frischer praktischerFall:PropenCH2=CH–CH3. Einbereitgestellter fehlerhafterDatensatz setzt alleC–C-Bindungen einfach undergänzt dadurchC3H8;dieLernperson darfBindungsordnung undAnsichten ändern. Es existiert hiernochkeine Lernenden-Datei. Korrigiere tatsächlich dieDatendatei zuC3H6,prüfe dieDoppelbindung,zeige räumlicheAlken-/Methylbereiche unddokumentiere Vorher/Nachher. Begründe denVorteil digitalerRotation gegenüber einem2D-Screenshot.",
                "taskDemandEn": "Fresh practical case:propeneCH2=CH–CH3.A supplied faulty dataset makes allC–C bonds single and adds hydrogens,givingC3H8;the learner may edit bond order and views.No learner file yet exists here. Actually correct the dataset toC3H6,check the double bond,show spatial alkene/methyl regions and document before/after.Explain the advantage of digital rotation over a2D screenshot.",
                "expectedPerformanceDe": "ErforderlicherNachweis:korrektes eigenbearbeitetesC3H6-Modell mitC1=C2 undMethyl-C;lokal planar amAlken,tetraedrisch amMethyl im verwendetenModell. EigeneDatei/Ansichten machenEingriff undRotation prüfbar;diePerson nenntTool-/Geometrie-Modell statt einegezeichneteLänge alsMessung auszugeben.",
                "expectedPerformanceEn": "Required evidence:personally edited correctC3H6 model withC1=C2 and a methylC;locally planar at thealkene,tetrahedral at methyl in the chosen model.Personal files/views make edits and rotation checkable;the learner states tool/geometry model instead of treating displayed lengths as measurements.",
                "understandingFocusDe": "DieSoftware kann mitfalscherBindungsordnung ein anderesMolekül generieren;eine automatischeBildausgabe ist daher kein fachlicherKorrektheitsbeleg und kein bereits erfüllterAusführungsnachweis.",
                "understandingFocusEn": "Software can generate a different molecule from incorrect bond order;automatic image output therefore proves neither correctness nor already demonstrated execution."
              }
            ]
          }
        }
      ],

        "bookDigest": "sha256:1faf19b8e9d0961e7387109bed769ed10a8f7a6db3856c74a7ca5c505bdda491",
        "pageFingerprint": "sha256:0aaadf4200ea42dc8e3397c4f13667dc32bf12863002c245304d91d3e5de49b8",

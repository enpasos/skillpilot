      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "experiment",
            "expectations": [
              {
                "id": "qualitative-hydrocarbon-elemental-evidence-and-controls",
                "essentialUnderstandingDe": "Kohlenstoff und Wasserstoff eines verbrannten Kohlenwasserstoffs können über CO2 und Wasser in den Produkten qualitativ nachgewiesen werden. Ein positiver Nachweis muss gegenüber Hintergrund aus Apparatur und zugeführten Gasen abgesichert sein. Er belegt Vorhandensein, nicht Menge, Molekülformel oder das Fehlen anderer Elemente in einer unbekannten Probe; Sauerstoff im Verbrennungsprodukt kann aus dem zugeführten O2 stammen.",
                "essentialUnderstandingEn": "Carbon and hydrogen in a combusted hydrocarbon can be qualitatively detected through CO2 and water among its products. A positive result must be distinguished from background due to the apparatus or incoming gases. It shows presence, not quantity, molecular formula or absence of other elements in an unknown sample; oxygen in the products can come from the supplied O2.",
                "observablePerformanceDe": "Die lernende Person deutet Nachweis- und Blindbefunde kausal, ordnet C/H der Probe nur bei passender Kontrolle zu und begrenzt die daraus möglichen Elementaranalyse-Aussagen.",
                "observablePerformanceEn": "The learner interprets assay and blank results causally, attributes C/H to the sample only with suitable controls and states the limits of the elemental-analysis claims."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "qualitative-hydrocarbon-elemental-evidence-and-controls"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "control-quality",
                "textDe": "Saubere Blindprobe wird durch eine Wasser-Hintergrundstörung ersetzt.",
                "textEn": "A clean blank is replaced by water-background interference."
              },
              {
                "id": "claim-scope",
                "textDe": "Positiver Nachweis wird von Mengen-, Formel- und Ausschließlichkeitsbehauptung getrennt.",
                "textEn": "A positive assay is distinguished from quantitative, formula and exclusivity claims."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "dry-combustion-controls",
                "taskDemandDe": "Eine reine Kohlenwasserstoffprobe wird mit trockenem, CO2-freiem O2 verbrannt. Die Apparatur ist trocken. Tabelle der Nachweise: wasserfreies CuSO4 wird bei Wasser blau; Kalkwasser wird bei CO2 trüb. Der Durchlauf ohne Probe bleibt weiß/klar, mit Verbrennung blau/trüb. Deute beide Befunde, erkläre den Bezug zu C/H im Ausgangsstoff und prüfe, ob CO2 beweist, dass schon Sauerstoff im Ausgangsstoff enthalten war.",
                "taskDemandEn": "A pure hydrocarbon sample is combusted with dry, CO2-free O2 in dry apparatus. Detection table: anhydrous CuSO4 turns blue with water and limewater turns cloudy with CO2. A run without sample stays white/clear, whereas combustion gives blue/cloudy. Interpret both results, connect them to C/H in the original sample and evaluate whether CO2 proves oxygen was already present in it.",
                "expectedPerformanceDe": "Wasser und CO2 sind nachgewiesen; gegenüber der sauberen Blindprobe stützen sie Wasserstoff und Kohlenstoff der verbrannten Probe. H wird zu Wasser, C zu CO2 überführt. Der Produktsauerstoff kann vom zugeführten O2 stammen, daher kein Sauerstoffnachweis im Ausgangsstoff. Qualitative Befunde liefern hier keine Stoffmengen oder Molekülformel.",
                "expectedPerformanceEn": "Water and CO2 are detected; compared with the clean blank they support hydrogen and carbon in the combusted sample. H becomes water and C becomes CO2. Product oxygen can originate from the supplied O2, so this does not detect oxygen in the original sample. The qualitative results do not provide amounts or a molecular formula.",
                "understandingFocusDe": "Nachweistabelle ist gelieferte Fachinformation; unabhängige Leistung ist die kontrollierte Zuordnung zur Probe und die Aussagegrenze.",
                "understandingFocusEn": "The detection table supplies factual information; the independent performance is controlled attribution to the sample and limitation of the claim."
              },
              {
                "id": "wet-apparatus-fresh",
                "taskDemandDe": "Frischer Fall: Eine unbekannte brennbare Probe wird auf Kohlenstoff/Wasserstoff untersucht. Die Nachweistabelle ist unverändert: CuSO4 blau bei Wasser, Kalkwasser trüb bei CO2. Wegen einer noch feuchten Apparatur ist der Blindlauf ohne Probe bereits blau, Kalkwasser aber klar. Mit verbrannter Probe wird CuSO4 blau und Kalkwasser trüb. Welche Elementaussage ist so gestützt, welche nicht? Schlage eine gezielte Wiederholung vor. Würden später saubere Blindwerte plus beide positive Probennachweise allein „nur C und H, keinerlei O“ beweisen?",
                "taskDemandEn": "Fresh case: an unknown combustible sample is tested for carbon/hydrogen. The same detection table applies: CuSO4 blue with water, limewater cloudy with CO2. A still-wet apparatus gives a blue blank without sample but clear limewater. Combustion gives blue CuSO4 and cloudy limewater. Which elemental claim is supported and which is not? Propose a targeted repeat. Would clean blank results and both positive sample assays alone prove “only C and H, with no O”?",
                "expectedPerformanceDe": "CO2 gegenüber klarem Blindwert stützt C in der Probe. Der Wasser-/H-Befund ist wegen des bereits blauen Blindlaufs nicht eindeutig der Probe zuzuordnen; trockenes Gerät/trockener Zulauf und erneute negative Wasserblindprobe sind nötig. Erst dann stützt ein neuer positiver Wassernachweis H. Selbst beide kontrolliert positiven Nachweise schließen O oder andere Elemente in der unbekannten Probe nicht aus.",
                "expectedPerformanceEn": "CO2 relative to clear blank limewater supports carbon in the sample. The water/H result cannot be uniquely attributed to the sample because the blank is already blue; dry apparatus/input and a fresh negative water blank are required. A new positive sample water assay can then support hydrogen. Even both controlled positive results do not exclude oxygen or other elements in an unknown sample.",
                "understandingFocusDe": "Frische Störung verlangt ungeholfene Kontrollentscheidung; keine vorschnelle Formel- oder Kohlenwasserstoffidentifikation.",
                "understandingFocusEn": "A fresh interference requires an uncued control decision rather than premature formula or hydrocarbon identification."
              }
            ]
          }
        }
      ],

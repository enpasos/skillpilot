        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "b005-9f355f63-core",
                "essentialUnderstandingDe": "Koeffizienten einer ausgeglichenen Molekülreaktion geben Stoffmengenverhältnisse an. Größenbeziehungen wie n=m/M führen von gegebener Masse zur Stoffmenge; bei zwei gegebenen Edukten bestimmt das begrenzende Edukt den maximalen Umsatz.",
                "essentialUnderstandingEn": "Coefficients of a balanced molecular reaction give amount-of-substance ratios. Relations such as n=m/M convert given mass to amount; with two supplied reactants, the limiting one sets maximum conversion.",
                "observablePerformanceDe": "Die lernende Person berechnet aus korrekter Gleichung und gegebener Masse/Stoffmenge einen Produktumsatz, identifiziert den begrenzenden Stoff und prüft Einheiten sowie Rest.",
                "observablePerformanceEn": "The learner computes product yield from a balanced equation and supplied mass/amount, identifies the limiting reactant and checks units and leftovers."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b005-9f355f63-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "reaction",
                "textDe": "Wasserbildung und Kohlenmonoxid-Oxidation haben beide das Koeffizientenverhältnis 2:1:2; die Stoffe und der jeweils begrenzende Reaktionspartner unterscheiden sich.",
                "textEn": "Water formation and carbon monoxide oxidation both have the coefficient ratio 2:1:2; the substances and the limiting reactant differ."
              },
              {
                "id": "quantity",
                "textDe": "Mol-Angaben und Masse-zu-Mol-Umrechnung werden verglichen.",
                "textEn": "Mole amounts and mass-to-mole conversion are compared."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "water-limiting-oxygen",
                "taskDemandDe": "Für die Papierreaktion 2 H2 + O2 → 2 H2O stehen 3 mol H2 und 1 mol O2 zur Verfügung. Berechne maximale Stoffmenge und Masse des Wassers (M=18 g/mol) sowie einen Rest.",
                "taskDemandEn": "For the paper reaction 2 H2 + O2 → 2 H2O, 3 mol H2 and 1 mol O2 are available. Calculate maximum water amount and mass (M=18 g/mol) and a leftover.",
                "expectedPerformanceDe": "Die lernende Person erkennt O2 als begrenzend, erhält 2 mol H2O = 36 g und 1 mol H2 Rest; sie nutzt die Koeffizienten als Mol-Verhältnis, nicht als Gramm-Verhältnis.",
                "expectedPerformanceEn": "The learner identifies O2 as limiting, obtains 2 mol H2O = 36 g and 1 mol H2 left; coefficients are mole ratios, not gram ratios.",
                "understandingFocusDe": "Andere Reaktion als Bestandsbild prüft Mol-Verhältnis und Masse.",
                "understandingFocusEn": "A reaction different from the existing image tests mole ratios and mass."
              },
              {
                "id": "fresh-carbon-monoxide-oxidation",
                "taskDemandDe": "Ein neuer Papierdatensatz gibt 56 g CO (M=28 g/mol) und 1,5 mol O2 für 2 CO + O2 → 2 CO2 vor. Berechne maximale Stoffmenge und Masse CO2 (M=44 g/mol) sowie den O2-Rest; keine reale Gasarbeit.",
                "taskDemandEn": "A fresh paper data set supplies 56 g CO (M=28 g/mol) and 1.5 mol O2 for 2 CO + O2 → 2 CO2. Calculate maximum CO2 amount and mass (M=44 g/mol) plus leftover O2; no gas experiment.",
                "expectedPerformanceDe": "Die lernende Person rechnet 56/28=2 mol CO, benötigt 1 mol O2, erhält 2 mol CO2 = 88 g und 0,5 mol O2 Rest; sie führt keine gefährliche CO-Handlung aus.",
                "expectedPerformanceEn": "The learner converts 56/28=2 mol CO, needs 1 mol O2, obtains 2 mol CO2 = 88 g and 0.5 mol O2 left; no hazardous CO handling occurs.",
                "understandingFocusDe": "Frischer Massen-Eingang prüft begrenzendes Edukt und Einheiten.",
                "understandingFocusEn": "Fresh mass input tests limiting reactant and units."
              }
            ]
          }
        }
      ],

      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "redox-process-and-criterion-based-significance",
                "essentialUnderstandingDe": "Redoxreaktionen koppeln Elektronenabgabe und Elektronenaufnahme. Ob ein Beispiel im Alltag oder in der Technik nützlich oder problematisch ist, folgt aus dem konkreten chemischen Vorgang und offengelegten Kriterien wie Energiegewinn, Materialerhalt oder Aufwand.",
                "essentialUnderstandingEn": "Redox reactions couple electron loss and electron gain. Whether an everyday or technological example is useful or problematic depends on the particular chemical process and stated criteria such as energy use, material preservation, or effort.",
                "observablePerformanceDe": "Die lernende Person deutet vorgelegte Reaktions- oder Beobachtungsdaten als Redoxvorgang, unterscheidet Befund und Urteil und begründet die Bedeutung des Vorgangs anhand mindestens eines zum Fall passenden Kriteriums.",
                "observablePerformanceEn": "The learner interprets supplied reaction or observation data as a redox process, separates finding from judgment, and explains the process's significance with at least one case-appropriate criterion."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "redox-process-and-criterion-based-significance"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "application",
                "textDe": "Nutzbare elektrische Energie wird mit unerwünschtem Materialabbau verglichen.",
                "textEn": "Useful electrical energy is compared with unwanted material degradation."
              },
              {
                "id": "decision-criterion",
                "textDe": "Ein Fall gewichtet Funktion, der andere Schutzaufwand und Lebensdauer.",
                "textEn": "One case weighs function; the other weighs protection effort and lifetime."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "simple-cell-benefit",
                "taskDemandDe": "Ein vereinfachtes galvanisches Element liefert Strom; ein Metall gibt Elektronen ab, Ionen eines anderen Metalls nehmen sie auf. Erkläre die Redoxbeteiligung und erörtere, weshalb der Vorgang technisch nützlich ist und welcher Materialverbrauch mitbedacht werden muss.",
                "taskDemandEn": "A simplified galvanic cell supplies current; one metal releases electrons and ions of another metal gain them. Explain the redox aspect and discuss why the process is technically useful and what material consumption must also be considered.",
                "expectedPerformanceDe": "Die lernende Person koppelt Oxidation und Reduktion, nennt elektrische Energie als Nutzen und berücksichtigt die Umsetzung der beteiligten Stoffe. Sie trennt diese chemischen Angaben von der Gewichtung des Nutzens.",
                "expectedPerformanceEn": "The learner couples oxidation and reduction, identifies electrical energy as a benefit, and considers conversion of the participating substances. They distinguish these chemical facts from how the benefit is valued.",
                "understandingFocusDe": "Elektronenübertragung kann eine nützliche technische Funktion ermöglichen.",
                "understandingFocusEn": "Electron transfer can enable a useful technological function."
              },
              {
                "id": "fresh-corrosion-judgment",
                "taskDemandDe": "Ein neuer Datensatz beschreibt Rost an zwei gleichartigen Stahlteilen; eines ist geschützt, das andere verliert nach längerer Feuchtigkeitseinwirkung Material. Erkläre den Redoxbezug und erörtere die Bedeutung des Schutzes anhand von Materialerhalt und Aufwand, ohne aus den Daten eine genaue Lebensdauer zu erfinden.",
                "taskDemandEn": "A fresh data set describes rust on two comparable steel parts; one is protected, while the other loses material after prolonged moisture exposure. Explain the redox aspect and discuss the significance of protection in terms of material preservation and effort without inventing an exact lifetime from the data.",
                "expectedPerformanceDe": "Die lernende Person erklärt die Oxidation des Eisens als Teil einer Redoxreaktion, benennt den Materialverlust als Befund und wägt Schutzaufwand gegen Materialerhalt als explizite Kriterien ab. Sie kennzeichnet fehlende Lebensdauerdaten als Grenze des Urteils.",
                "expectedPerformanceEn": "The learner explains oxidation of iron as part of a redox reaction, identifies material loss as a finding, and weighs protection effort against material preservation as explicit criteria. They mark absent lifetime data as a limit on the judgment.",
                "understandingFocusDe": "Die Bedeutung eines Redoxvorgangs wird chemisch und kriterienbezogen begründet.",
                "understandingFocusEn": "A redox process's significance is justified chemically and through stated criteria."
              }
            ]
          }
        }
      ],

            "archetype": "representation",
            "expectations": [
              {
                "id": "b002-536b48b2-core",
                "essentialUnderstandingDe": "Die Endung -ol kennzeichnet die Hydroxygruppe; Stammkette und Positionszahl folgen der tatsächlich zusammenhängenden Kohlenstoffstruktur.",
                "essentialUnderstandingEn": "The -ol suffix identifies the hydroxyl group; parent chain and position number follow the actual connected carbon structure.",
                "observablePerformanceDe": "Die lernende Person verfolgt die längste passende Kette in einer gegebenen Struktur, nummeriert die OH-Position und begründet einen eindeutigen systematischen Namen.",
                "observablePerformanceEn": "The learner traces the appropriate parent chain in a supplied structure, numbers the OH position, and justifies an unambiguous systematic name."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b002-536b48b2-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "branching",
                "textDe": "Unverzweigte und verzweigte Kohlenstoffgerüste werden unterschieden.",
                "textEn": "Unbranched and branched carbon skeletons are distinguished."
              },
              {
                "id": "position",
                "textDe": "Die OH-Position liegt einmal an einer End- und einmal an einer inneren Kettenposition.",
                "textEn": "The OH group is once terminal and once at an internal chain position."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "name-butanol-structures",
                "taskDemandDe": "Gegeben sind Strukturformeln von Butan-1-ol und Butan-2-ol. Benenne beide und begründe Stammkette, Nummerierung und OH-Endung.",
                "taskDemandEn": "Structures of butan-1-ol and butan-2-ol are supplied. Name both and justify parent chain, numbering, and OH suffix.",
                "expectedPerformanceDe": "Die lernende Person gibt beide Namen korrekt an und begründet, warum die OH-Gruppe im zweiten Fall die Positionszahl 2 erhält.",
                "expectedPerformanceEn": "The learner gives both names correctly and explains why the OH group receives locant 2 in the second case.",
                "understandingFocusDe": "Struktur und Name werden über die OH-Position verknüpft.",
                "understandingFocusEn": "Structure and name are linked through the OH position."
              },
              {
                "id": "fresh-branched-name",
                "taskDemandDe": "Eine neue Struktur zeigt HO-CH2-CH(CH3)-CH2-CH3; ein Vorschlag lautet 3-Methylbutan-4-ol. Prüfe und verbessere ihn.",
                "taskDemandEn": "A fresh structure shows HO-CH2-CH(CH3)-CH2-CH3; a proposed name is 3-methylbutan-4-ol. Check and correct it.",
                "expectedPerformanceDe": "Die lernende Person nummeriert vom OH-Ende und nennt 2-Methylbutan-1-ol; sie erklärt, weshalb die vorgeschlagene Nummerierung falsch ist.",
                "expectedPerformanceEn": "The learner numbers from the OH end, gives 2-methylbutan-1-ol, and explains why the proposed numbering is wrong.",
                "understandingFocusDe": "Ein neuer Verzweigungsfall prüft eigenständige Regelanwendung.",
                "understandingFocusEn": "A new branching case tests independent rule use."
              }
            ]
          }
        }
      ],

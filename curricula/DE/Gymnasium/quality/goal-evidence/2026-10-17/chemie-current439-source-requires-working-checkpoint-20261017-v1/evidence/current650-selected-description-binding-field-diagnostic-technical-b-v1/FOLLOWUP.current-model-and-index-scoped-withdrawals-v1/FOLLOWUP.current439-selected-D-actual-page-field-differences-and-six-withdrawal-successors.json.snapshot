      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "modeling",
            "expectations": [
              {
                "id": "hardness-ion-classes",
                "essentialUnderstandingDe": "Gesamthärte bezieht sich auf Calcium-/Magnesiumionen. Hydrogencarbonatanteile tragen zur temporären, andere geeignete Gegenionen zur permanenten Härte bei; Gegenionen allein ohne Härtebildner erzeugen keine Wasserhärte.",
                "essentialUnderstandingEn": "Total hardness concerns calcium/magnesium ions. Hydrogencarbonate portions contribute temporary hardness and other suitable counterions permanent hardness; counterions alone without hardness cations do not create hardness.",
                "observablePerformanceDe": "Aus gegebenen Ionen-/Salzdaten temporäre, permanente und Gesamthärte im ausdrücklich vereinfachten Modell zuordnen und unterscheiden.",
                "observablePerformanceEn": "Classify temporary, permanent and total hardness from supplied ion/salt data in an explicitly simplified model."
              },
              {
                "id": "softening-process-limit",
                "essentialUnderstandingDe": "Erhitzen kann einen Calciumhydrogencarbonatanteil als Calciumcarbonat entfernen. Ionenaustausch kann Härtebildner gegen Natrium ersetzen; enthärtetes Wasser ist deshalb nicht notwendig entsalzt.",
                "essentialUnderstandingEn": "Heating can remove a calcium hydrogencarbonate portion as calcium carbonate. Ion exchange can replace hardness cations with sodium; softened water is therefore not necessarily demineralized.",
                "observablePerformanceDe": "Geeignete Verfahren aus der konkreten Ionenlage auswählen, Reaktionen/Austausch ladungsrichtig erklären und die jeweilige Resthärte oder verbleibenden Ionen beurteilen.",
                "observablePerformanceEn": "Select suitable processes from the ion composition, explain reactions/exchange with correct charge balance and assess remaining hardness or ions."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "hardness-ion-classes",
                "softening-process-limit"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "changed-chemical-case",
                "textDe": "Hydrogencarbonat-/Sulfat-/Chloridgemische und Wechsel von Erhitzen zu Natrium-Ionenaustausch; Stoff-/Ladungsbilanzen und Grenzen.",
                "textEn": "Use hydrogencarbonate/sulfate/chloride mixtures and switch from heating to sodium ion exchange; track atom/charge balances and limits."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "calcium-carbonate-magnesium-sulfate",
                "taskDemandDe": "Ein vereinfachtes Wasser enthält 1,0 mmol/L Ca(HCO₃)₂ und 0,5 mmol/L MgSO₄. Ordne die Härteanteile zu. Das Modell entfernt beim Erhitzen den Calciumhydrogencarbonatanteil vollständig, nicht das Magnesiumsulfat. Formuliere die Calciumreaktion und bestimme die verbleibende Härte.",
                "taskDemandEn": "Simplified water contains1.0 mmol/L Ca(HCO₃)₂ and0.5 mmol/L MgSO₄. Classify hardness portions. The model removes the calcium hydrogencarbonate portion completely by heating, not magnesium sulfate. Write calcium precipitation and determine remaining hardness.",
                "expectedPerformanceDe": "Temporär 1,0, permanent 0,5 und gesamt 1,5 mmol/L zweiwertige Härtebildner. Ca²⁺ +2 HCO₃⁻ → CaCO₃(s) +CO₂ +H₂O; nach der ausdrücklich vorgegebenen vollständigen Modellfällung verbleiben 0,5 mmol/L. Daraus wird keine universelle Magnesiumcarbonatfällung oder reale vollständige Enthärtung behauptet.",
                "expectedPerformanceEn": "Temporary1.0, permanent0.5 and total1.5 mmol/L divalent hardness cations. Ca²⁺ +2 HCO₃⁻ → CaCO₃(s) +CO₂ +H₂O; the explicitly complete model precipitation leaves0.5 mmol/L. This does not assert universal magnesium-carbonate precipitation or actual complete softening.",
                "understandingFocusDe": "Härteanteile und begrenzte thermische Wirkung.",
                "understandingFocusEn": "Hardness portions and bounded heating effect."
              },
              {
                "id": "chloride-water-ion-exchange",
                "taskDemandDe": "Frisch gegeben sind 0,75 mmol/L CaCl₂ und 0,25 mmol/L MgCl₂. Ein vorgegebenes Harz tauscht jedes zweiwertige Ion gegen zwei Na⁺ aus. Erkläre, warum bloßes Erhitzen hier nicht wie im vorigen Calciumhydrogencarbonatmodell wirkt; bilanziere Austausch und verbleibende Ionen.",
                "taskDemandEn": "Fresh water contains0.75 mmol/L CaCl₂ and0.25 mmol/L MgCl₂. Supplied resin exchanges each divalent ion for two Na⁺. Explain why heating does not act as in the preceding calcium-hydrogencarbonate model; balance exchange and remaining ions.",
                "expectedPerformanceDe": "Im Modell permanente Gesamthärte 1,0 mmol/L; kein Hydrogencarbonat für den genannten Fällungsweg. Vollständiger vorgegebener Austausch ersetzt Ca/Mg durch 2,0 mmol/L Na⁺ bei unverändertem Chlorid. Härte fällt im Modell auf null, aber das Wasser enthält weiterhin Ionen und ist nicht entsalzt.",
                "expectedPerformanceEn": "Model permanent total hardness is1.0 mmol/L; no hydrogencarbonate supports that precipitation route. Complete supplied exchange replaces Ca/Mg with2.0 mmol/L Na⁺ while chloride remains. Model hardness reaches zero but ions remain, so water is not demineralized.",
                "understandingFocusDe": "Frischer Gegenion-/Verfahrenstransfer.",
                "understandingFocusEn": "Fresh counterion and process transfer."
              }
            ]
          }
        }
      ],

        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "content-specific-understanding",
                "essentialUnderstandingDe": "QuantenmechanischeZustände haben gekoppelteOrts-/Impulsstreuungen;dieUnbestimmtheit ist keine bloß unbekannte klassischeBahn undmotiviert eineBeschreibung durchWahrscheinlichkeitsverteilungen.",
                "essentialUnderstandingEn": "Quantum states have coupled position/momentum spreads;uncertainty is not merely an unknown classical orbit and motivates probability-distribution descriptions.",
                "observablePerformanceDe": "Δp≥5,275×10⁻²⁵kgm/s. DasProdukt hatnichtverschwindendeMindestgröße;für diesenZustand liefert dieWellenfunktion eineOrtsverteilung statt exaktbekannter klassischerBahn. DieAussage ist intrinsischeZustandsstreuung,keine bloßeUnfähigkeit desMessgeräts.",
                "observablePerformanceEn": "Δp≥5.275×10⁻²⁵kgm/s.The product has a nonzero lower bound;this state gives a position distribution rather than an exactly known classical path.The statement concerns intrinsic state spread,not mere instrument inability."
              },
              {
                "id": "fresh-transfer-and-model-boundary",
                "essentialUnderstandingDe": "Messwechselwirkung kann relevant sein;dieRelation ist jedoch nicht ausschließlich dasStören einer zuvor exakten klassischenElektronenbahn.",
                "essentialUnderstandingEn": "Measurement interactions may matter,but the relation is not solely disturbance of a previously exact classical electron path.",
                "observablePerformanceDe": "DieMindestgrenze fürB ist2,6375×10⁻²⁵kgm/s gegenüberA5,275×10⁻²⁵. Daraus folgt weder tatsächlichesΔpB=ΔpA/2 noch ein halbierterMittelimpuls. BreitereOrtsverteilung erlaubt einekleinereUntergrenze,erzwingt sie nicht. Aufenthaltswahrscheinlichkeit bleibt die geeigneteZustandsbeschreibung.",
                "observablePerformanceEn": "B’s lower bound is2.6375×10⁻²⁵kgm/s versusA’s5.275×10⁻²⁵.Neither actualΔpB=ΔpA/2 nor a halved mean momentum follows.A broader position distribution permits a lower minimum,but does not force it.Probability remains the appropriate state description."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "content-specific-understanding",
                "fresh-transfer-and-model-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-material-variation",
                "textDe": "Schmales/breitesWellenpaket und Mindestgrenze gegenüber tatsächlicherStreuung.",
                "textEn": "Narrow/broad wave packet and a minimum bound versus actual spread."
              },
              {
                "id": "specific-model-limit",
                "textDe": "Messwechselwirkung kann relevant sein;dieRelation ist jedoch nicht ausschließlich dasStören einer zuvor exakten klassischenElektronenbahn.",
                "textEn": "Measurement interactions may matter,but the relation is not solely disturbance of a previously exact classical electron path."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next25-73547696-case-1",
                "taskDemandDe": "GegebenΔx·Δp≥ℏ/2,ℏ=1,055×10⁻³⁴Js;Δ sindStandardabweichungen in einemZustand. EinElektronenpaket hatΔx=1,0×10⁻¹⁰m. KeinMessgerätfehler ist angegeben. Bestimme dieuntereΔp-Grenze undbegründe,warum exaktdefinierteBahnorte undImpulse nichtgleichzeitig verlangt werdenkönnen.",
                "taskDemandEn": "GivenΔx·Δp≥ℏ/2,ℏ=1.055×10⁻³⁴Js;Δ denotes standard deviations of one state.An electron packet hasΔx=1.0×10⁻¹⁰m.No instrument error is specified. Determine the lowerΔp bound and explain why exact trajectory positions and momenta cannot be simultaneously demanded.",
                "expectedPerformanceDe": "Δp≥5,275×10⁻²⁵kgm/s. DasProdukt hatnichtverschwindendeMindestgröße;für diesenZustand liefert dieWellenfunktion eineOrtsverteilung statt exaktbekannter klassischerBahn. DieAussage ist intrinsischeZustandsstreuung,keine bloßeUnfähigkeit desMessgeräts.",
                "expectedPerformanceEn": "Δp≥5.275×10⁻²⁵kgm/s.The product has a nonzero lower bound;this state gives a position distribution rather than an exactly known classical path.The statement concerns intrinsic state spread,not mere instrument inability.",
                "understandingFocusDe": "DieUngleichung legt einenMindestwert fest,keinen bereitsgemessenen exaktenImpuls.",
                "understandingFocusEn": "The inequality supplies a lower bound,not an already measured exact momentum."
              },
              {
                "id": "chem-next25-73547696-case-2",
                "taskDemandDe": "Frischer Modellvergleich:ZustandA Δx=1,0×10⁻¹⁰m;ZustandB Δx=2,0×10⁻¹⁰m. KeineAngabe,dass dieZustände dieMindestgrenze sättigen. Text:„doppelt so breiteOrtswolke bedeutet immer halb so großen tatsächlichenImpuls“. Korrigiere denText,vergleicheMindeststreuungen undtrenneMittelimpuls vonImpulsstreuung.",
                "taskDemandEn": "Fresh model comparison:stateAΔx=1.0×10⁻¹⁰m;stateBΔx=2.0×10⁻¹⁰m.No claim that either saturates the bound.Text:“twice the position spread always means half the actual momentum”. Correct the text,compare minimum spreads and distinguish mean momentum from momentum spread.",
                "expectedPerformanceDe": "DieMindestgrenze fürB ist2,6375×10⁻²⁵kgm/s gegenüberA5,275×10⁻²⁵. Daraus folgt weder tatsächlichesΔpB=ΔpA/2 noch ein halbierterMittelimpuls. BreitereOrtsverteilung erlaubt einekleinereUntergrenze,erzwingt sie nicht. Aufenthaltswahrscheinlichkeit bleibt die geeigneteZustandsbeschreibung.",
                "expectedPerformanceEn": "B’s lower bound is2.6375×10⁻²⁵kgm/s versusA’s5.275×10⁻²⁵.Neither actualΔpB=ΔpA/2 nor a halved mean momentum follows.A broader position distribution permits a lower minimum,but does not force it.Probability remains the appropriate state description.",
                "understandingFocusDe": "Messwechselwirkung kann relevant sein;dieRelation ist jedoch nicht ausschließlich dasStören einer zuvor exakten klassischenElektronenbahn.",
                "understandingFocusEn": "Measurement interactions may matter,but the relation is not solely disturbance of a previously exact classical electron path."
              }
            ]
          }
        }
      ],

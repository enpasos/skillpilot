        "bookDigest": "sha256:1faf19b8e9d0961e7387109bed769ed10a8f7a6db3856c74a7ca5c505bdda491",
        "pageFingerprint": "sha256:cb3a9b62c65d42ef12d7433bb59fdffc2775afa221574dded063ba5467777da8",

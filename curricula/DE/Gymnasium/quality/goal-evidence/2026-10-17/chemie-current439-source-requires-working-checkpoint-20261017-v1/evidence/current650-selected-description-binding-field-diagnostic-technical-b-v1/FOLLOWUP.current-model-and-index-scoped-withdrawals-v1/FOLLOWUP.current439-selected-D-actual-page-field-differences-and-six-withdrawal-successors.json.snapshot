      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "gas-molar-mass-from-composition-or-state-data",
                "essentialUnderstandingDe": "Die molare Masse eines reinen Gases ist stoffbezogen und kann aus Formel/Atommassen oder aus Masse und Volumen mit passendem Vm erschlossen werden. rho·Vm hat Einheit g/mol, sofern beide Angaben denselben Zustand betreffen. Ein Druck-/Temperaturwechsel verändert die Dichte und Vm, nicht die molare Masse derselben unveränderten Gasart. Ein passender Wert allein beweist keine eindeutige Stoffidentität.",
                "essentialUnderstandingEn": "The molar mass of a pure gas is substance-specific and can be inferred from formula/atomic masses or from mass and volume with the appropriate molar volume. Density multiplied by molar volume has unit g/mol if both refer to the same state. Pressure or temperature changes affect density and molar volume but not an unchanged gas species’ molar mass. Agreement in molar mass alone does not uniquely identify a substance.",
                "observablePerformanceDe": "Die lernende Person verknüpft Gasdaten und Zusammensetzung konsistent, begründet Zustand und Einheiten und trennt passende Formel-Hypothese von eindeutiger Identifikation.",
                "observablePerformanceEn": "The learner links gas data and composition consistently, explains state and units and distinguishes a compatible formula hypothesis from unique identification."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "gas-molar-mass-from-composition-or-state-data"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "data-route",
                "textDe": "Formelsumme wird mit unabhängigen Masse-/Volumendaten verglichen.",
                "textEn": "A formula-based molar mass is compared with independent mass/volume data."
              },
              {
                "id": "pressure-change",
                "textDe": "Frische Gasdaten stammen aus einem Zustand mit anderem molarem Volumen.",
                "textEn": "Fresh gas data come from a state with a different molar volume."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "carbon-dioxide-cross-check",
                "taskDemandDe": "Eine reine CO2-Probe wiegt1,10g und besitzt bei den angegebenen idealen Modellbedingungen0,600L. Hier gilt Vm=24,0L/mol. Atombezogene molare Massen: C12,0g/mol, O16,0g/mol. Bestimme M unabhängig über die Formel und die Gasdaten, prüfe die Übereinstimmung und erkläre die Einheit des aus Dichte und Vm entstehenden Ergebnisses.",
                "taskDemandEn": "A pure CO2 sample weighs1.10g and occupies0.600L under the stated ideal-model conditions, where Vm=24.0L/mol. Atom-based molar masses are C12.0g/mol and O16.0g/mol. Determine molar mass independently from the formula and gas data, check agreement and explain the unit obtained from density and molar volume.",
                "expectedPerformanceDe": "Formelweg:12,0+2·16,0=44,0g/mol. Gasweg:n=0,0250mol, M=1,10g/0,0250mol=44,0g/mol; alternativ rho≈1,833g/L mal24,0L/mol. Beide Wege stimmen in den gerundeten Daten überein. Die Liter kürzen sich; Dichte allein hat eine andere Einheit und ist nicht M.",
                "expectedPerformanceEn": "Formula route:12.0+2×16.0=44.0g/mol. Gas route:n=0.0250mol and M=1.10g/0.0250mol=44.0g/mol, or density≈1.833g/L multiplied by24.0L/mol. The routes agree within the rounded data. Litres cancel; density alone has a different unit and is not molar mass.",
                "understandingFocusDe": "Zwei Begründungswege und Zustands-/Einheitenkontrolle statt bloßer Zahlenpassung.",
                "understandingFocusEn": "Two reasoning routes and state/unit checks replace mere numerical agreement."
              },
              {
                "id": "unknown-gas-new-state-fresh",
                "taskDemandDe": "Frischer Fall: Ein reines unbekanntes Gas wiegt1,60g und hat bei ZustandB0,300L. FürB ist Vm=12,0L/mol angegeben, für einen anderen ZustandA24,0L/mol. Kandidatenformeln sind SO2 und CO2, mit atombezogenen Massen S32,0,C12,0,O16,0 jeweils g/mol. Bestimme M und beurteile die Kandidaten sowie die Aussage „Aus M allein ist SO2 eindeutig bewiesen“. Begründe, welchen Vm-Wert du verwendest.",
                "taskDemandEn": "Fresh case: a pure unknown gas weighs1.60g and occupies0.300L at stateB, where Vm=12.0L/mol; a different stateA has24.0L/mol. Candidate formulas are SO2 and CO2, using atom-based molar masses S32.0,C12.0,O16.0g/mol. Determine molar mass, evaluate the candidates and the claim “M alone proves SO2 uniquely”. Explain which molar volume you select.",
                "expectedPerformanceDe": "Die B-Probe enthält0,0250mol, also M=64,0g/mol. SO2 passt dazu, CO2 mit44,0g/mol nicht. A-Daten unzulässig aufB übertragen ergäben128g/mol. Der passende64-Wert macht SO2 unter diesen Kandidaten plausibel, ist aber allein kein eindeutiger Identitätsnachweis; weitere Stoffinformationen wären erforderlich.",
                "expectedPerformanceEn": "The B sample contains0.0250mol, so M=64.0g/mol. SO2 is compatible while CO2 at44.0g/mol is not. Incorrectly applying A data toB would give128g/mol. The matching64 value makes SO2 plausible among the listed candidates but is not a unique identification without further substance information.",
                "understandingFocusDe": "Frische Zustandsauswahl und begrenzte Identitätsinferenz werden selbstständig begründet.",
                "understandingFocusEn": "Fresh state selection and the limit of identity inference require independent reasoning."
              }
            ]
          }
        }
      ],

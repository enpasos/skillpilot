          "label": "Inhalte: organische Verbindungen darstellen: Verhältnis-, Summen-, Halb- und ausführliche Strukturformel"
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-BE",
          "stage:SekII",
          "topic:3.1.4",
          "category:Inhalte"

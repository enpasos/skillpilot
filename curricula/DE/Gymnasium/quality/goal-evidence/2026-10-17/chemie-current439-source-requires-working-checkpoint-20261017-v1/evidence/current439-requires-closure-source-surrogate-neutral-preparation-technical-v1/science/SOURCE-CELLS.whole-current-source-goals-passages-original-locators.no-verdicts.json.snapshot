      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-sekii-kc2022-ep-2-kompetenz-005-520edb49",
        "passageId": "ni-chemistry-sekii-kc2022-ep-2",
        "topicCode": "EP-2",
        "topicTitle": "Reaktionen von Alkanen",
        "category": "Kompetenz",
        "title": "beurteilen die Bedeutung von Verbrennungsreaktionen für das globale Klima: Treibhauseffekt.",
        "description": "Die lernende Person kann beurteilen die Bedeutung von Verbrennungsreaktionen für das globale Klima: Treibhauseffekt..",
        "sourceDocumentKey": "NI-KC-CHEMIE-SEKII-2022",
        "sourceRef": "Niedersachsen Kerncurriculum Chemie gymnasiale Oberstufe 2022, Reaktionen von Alkanen, S. 13.",

      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-seki-kc2015-st-9-10-6-kompetenz-007-781f5cde",
        "passageId": "ni-chemistry-seki-kc2015-st-9-10-6",
        "topicCode": "ST-9-10-6",
        "topicTitle": "Stoff-Teilchen (6/7)",
        "headingTitle": "Bedeutung des PSE erschließen",
        "title": "wenden Sicherheitsaspekte beim Experimentieren an.",
        "description": "Die lernende Person kann wenden Sicherheitsaspekte beim Experimentieren an.",
        "sourceDocumentKey": "NI-KC-NATURWISSENSCHAFTEN-SEKI-2015-CHEMIE",

      "wholeCurrentSourceGoal": {
        "id": "de-hh-chemie-sekii-bildungsplan-2022-3-1-064-45ac6de5",
        "passageId": "de-hh-chemie-sekii-bildungsplan-2022:3-1",
        "topicCode": "3.1",
        "title": "Redoxreaktionen als Elektronenuebergaenge mit Teilreaktionen beschreiben",
        "description": "Die lernende Person kann Redoxreaktionen als Elektronenuebergaenge mit Teilreaktionen beschreiben.",
        "sourceDocumentKey": "HH-CHEMIE-GYO-2022",
        "sourceRef": "Hamburg Bildungsplan Studienstufe Chemie 2022, 3.1, S. 31.",
        "sourceText": "Redoxreaktionen als Elektronenuebergaenge mit Teilreaktionen beschreiben",
        "sourceSpan": {
          "passageId": "de-hh-chemie-sekii-bildungsplan-2022:3-1",
          "label": "3.1, S. 31: Redoxreaktionen als Elektronenuebergaenge mit Teilreaktionen beschreiben"
        },
        "courseLevel": "GK_LK",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-HH",
          "stage:SekII",
          "section:3-1",
          "courseLevel:GK_LK"
        ],
        "metadata": {
          "extractionMethod": "manual-transcription-from-official-hamburg-pdf-passages",

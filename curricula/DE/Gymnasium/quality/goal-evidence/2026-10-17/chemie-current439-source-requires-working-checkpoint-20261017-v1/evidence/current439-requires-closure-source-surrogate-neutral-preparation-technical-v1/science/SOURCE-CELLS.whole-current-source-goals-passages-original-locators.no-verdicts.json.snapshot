        "passageId": "sl-chemistry-sekii:sl-ch-sekii-lk-2023-2025:p038",
        "topicCode": "SL-CH-SEKII-LK-2023-2025-P038",
        "bulletIndex": 4,
        "aspectIndex": 1,
        "title": "definieren den Säureexponenten pKS und den Basenexponenten pKB als negativen dekadischen Logarithmus des Zahlenwertes der Säurekonstanten KS bzw. Basenkonstanten KB",
        "description": "Die lernende Person kann definieren den Säureexponenten pKS und den Basenexponenten pKB als negativen dekadischen Logarithmus des Zahlenwertes der Säurekonstanten KS bzw. Basenkonstanten KB.",
        "sourceText": "definieren den Säureexponenten pKS und den Basenexponenten pKB als negativen dekadischen Logarithmus des Zahlenwertes der Säurekonstanten KS bzw. Basenkonstanten KB,",
        "sourceSpan": "Hauptphase Leistungskurs, S. 38, Source-Ziel 4",
        "parentBulletText": "definieren den Säureexponenten pKS und den Basenexponenten pKB als negativen dekadischen Logarithmus des Zahlenwertes der Säurekonstanten KS bzw. Basenkonstanten KB,",
        "sourceRef": "SL-CH-SEKII-LK-2023-2025 S. 38",
        "courseLevel": "LK",
        "granularity": "source-atom",
        "tags": [

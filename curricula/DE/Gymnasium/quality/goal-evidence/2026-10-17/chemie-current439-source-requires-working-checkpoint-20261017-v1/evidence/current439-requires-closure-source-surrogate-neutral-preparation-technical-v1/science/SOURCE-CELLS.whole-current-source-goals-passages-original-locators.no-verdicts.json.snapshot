      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-nw-2024-p011-002-e986ef7a",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p011",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P011",
        "bulletIndex": 2,
        "aspectIndex": 1,
        "title": "führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus",
        "description": "Die lernende Person kann führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus.",
        "sourceText": "führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus,",
        "sourceSpan": "Einführungsphase NW-Zweig, S. 11, Source-Ziel 2",
        "parentBulletText": "führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus,",
        "sourceRef": "SL-CH-SEKII-EP-NW-2024 S. 11",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [

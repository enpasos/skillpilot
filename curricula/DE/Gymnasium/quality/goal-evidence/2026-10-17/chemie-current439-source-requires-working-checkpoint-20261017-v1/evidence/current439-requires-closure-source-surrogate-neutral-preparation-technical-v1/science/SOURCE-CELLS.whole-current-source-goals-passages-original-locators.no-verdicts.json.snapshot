      "wholeCurrentSourceGoal": {
        "id": "hb-chemistry-sekii-gyo2022-3-3-2-2-aminosaeuren-proteine-055-efa929f0",
        "passageId": "hb-chemistry-sekii:3.3-2-2-AMINOSAEUREN-PROTEINE",

        "topicCode": "SL-CH-SEKII-EP-NW-2024-P022",
        "bulletIndex": 10,
        "aspectIndex": 1,
        "title": "benennen einfach verzweigte und substituierte Alkanole nach der IUPAC-Nomenklatur",
        "description": "Die lernende Person kann benennen einfach verzweigte und substituierte Alkanole nach der IUPAC-Nomenklatur.",
        "sourceText": "benennen einfach verzweigte und substituierte Alkanole nach der IUPAC-Nomenklatur,",
        "sourceSpan": "Einführungsphase NW-Zweig, S. 22, Source-Ziel 10",
        "parentBulletText": "benennen einfach verzweigte und substituierte Alkanole nach der IUPAC-Nomenklatur,",
        "sourceRef": "SL-CH-SEKII-EP-NW-2024 S. 22",

      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-nw-2024-p021-001-94b5049a",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p021",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P021",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "leiten aus der homologen Reihe die allgemeine Summenformel der Alkene/Alkine ab",
        "description": "Die lernende Person kann leiten aus der homologen Reihe die allgemeine Summenformel der Alkene/Alkine ab.",
        "sourceText": "leiten aus der homologen Reihe die allgemeine Summenformel der Alkene/Alkine ab,",
        "sourceSpan": "Einführungsphase NW-Zweig, S. 21, Source-Ziel 1",
        "parentBulletText": "leiten aus der homologen Reihe die allgemeine Summenformel der Alkene/Alkine ab,",
        "sourceRef": "SL-CH-SEKII-EP-NW-2024 S. 21",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [

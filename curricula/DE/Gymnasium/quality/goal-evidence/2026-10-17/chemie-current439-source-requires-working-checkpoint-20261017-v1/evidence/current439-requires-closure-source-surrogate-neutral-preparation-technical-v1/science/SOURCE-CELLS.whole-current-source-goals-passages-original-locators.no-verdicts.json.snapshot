        "bulletIndex": 2,
        "aspectIndex": 1,
        "title": "erklären die pH-Abhängigkeit von Redoxpotenzialen mit Hilfe des chemischen Gleichgewichts",
        "description": "Die lernende Person kann erklären die pH-Abhängigkeit von Redoxpotenzialen mit Hilfe des chemischen Gleichgewichts.",
        "sourceText": "erklären die pH-Abhängigkeit von Redoxpotenzialen mit Hilfe des chemischen Gleichgewichts,",
        "sourceSpan": "Hauptphase Grundkurs, S. 42, Source-Ziel 2",
        "parentBulletText": "erklären die pH-Abhängigkeit von Redoxpotenzialen mit Hilfe des chemischen Gleichgewichts,",
        "sourceRef": "SL-CH-SEKII-GK-2023-2025 S. 42",
        "courseLevel": "GK",

      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-sekii-kc2022-q-protolyse-1-kompetenz-001-07e80047",
        "passageId": "ni-chemistry-sekii-kc2022-q-protolyse-1",
        "topicCode": "Q-PROTOLYSE-1",
        "topicTitle": "Protonenübertragungsreaktionen",
        "category": "Kompetenz",
        "title": "erläutern die Säure-Base-Theorie nach Brönsted.",
        "description": "Die lernende Person kann erläutern die Säure-Base-Theorie nach Brönsted..",
        "sourceDocumentKey": "NI-KC-CHEMIE-SEKII-2022",
        "sourceRef": "Niedersachsen Kerncurriculum Chemie gymnasiale Oberstufe 2022, Protonenübertragungsreaktionen, S. 21.",

    {
      "cellId": "7516a41d-2eb2-5ce4-8f38-31570f0ffa81::de-hh-chemie-sekii-bildungsplan-2022-1-2-012-06456ca4",
      "sourceFieldProvenance": {
        "filePin": {
          "path": "/mnt/e/skillpilot-chemie-L7-20261017/current439-remediation14-guarded-root-integration-technical-v1/capsule/curricula/DE/Gymnasium/input/HH/upper-secondary/source-extraction/DE_HH_CHEMIE_SEKII_BILDUNGSPLAN_2022.source-extraction.json",

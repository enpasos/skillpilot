      "wholeCurrentSourceGoal": {
        "id": "sn-chem-sekii-sn-ch-jahrgangsstufe-11-grundkurs-lb1-002-06-18ea6fc3",
        "passageId": "sn-chemistry-sekii:sn-ch-jahrgangsstufe-11-grundkurs-lb1",
        "topicCode": "SN-CH-jahrgangsstufe-11-grundkurs-LB1",
        "bulletIndex": 2,
        "aspectIndex": 6,
        "title": "Anwenden des Wissens über den Zusammenhang zwischen Struktur und Eigenschaften von Stoffen zur Ordnung von ausgewählten anorganischen und organischen Stoffen Basiskonzept: Konze...",
        "description": "Die lernende Person kann Anwenden des Wissens über den Zusammenhang zwischen Struktur und Eigenschaften von Stoffen zur Ordnung von ausgewählten anorganischen und organischen Stoffen Basiskonzept: Konzept vom Aufbau und von den Eigenschaften der Stoffe und ihrer Teilchen: experimentelles Untersuchen verschiedener Stoffe auch unter Nutzung digitaler Werkzeuge Löslichkeit, Siede- und Schmelztemperatur, Leitfähigkeit, Flammenfärbung projektorientiertes Arbeiten digitale Erfassung von Messwerten.",
        "sourceText": "Anwenden des Wissens über den Zusammenhang zwischen Struktur und Eigenschaften von Stoffen zur Ordnung von ausgewählten anorganischen und organischen Stoffen Basiskonzept: Konzept vom Aufbau und von den Eigenschaften der Stoffe und ihrer Teilchen: experimentelles Untersuchen verschiedener Stoffe auch unter Nutzung digitaler Werkzeuge Löslichkeit, Siede- und Schmelztemperatur, Leitfähigkeit, Flammenfärbung projektorientiertes Arbeiten digitale Erfassung von Messwerten",
        "sourceSpan": "Jahrgangsstufe 11 Grundkurs, Stoffe – von der Vielfalt zur Ordnung – PSE, PDF-S. 38",
        "parentBulletText": "Anwenden des Wissens über den Zusammenhang zwischen Struktur und Eigenschaften von Stoffen zur Ordnung von ausgewählten anorganischen und organischen Stoffen Basiskonzept: Konzept vom Aufbau und von den Eigenschaften der Stoffe und ihrer Teilchen",
        "sourceRef": "Lehrplan Gymnasium Chemie Sachsen 2025, Jahrgangsstufe 11 Grundkurs, Stoffe – von der Vielfalt zur Ordnung – PSE, PDF-S. 38",
        "courseLevel": "GK",
        "granularity": "officialCompetencyAspect",
        "tags": [
          "source:sachsen",

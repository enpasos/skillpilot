      "wholeCurrentSourceGoal": {
        "id": "de-nw-chemie-sekii-klp-2022-GK-elektrochemische-prozesse-und-energetik-bewertungskompetenz-001-d2b24d55",
        "passageId": "de-nw-chemie-sekii-klp-2022:GK-elektrochemische-prozesse-und-energetik-bewertungskompetenz",
        "topicCode": "GK-elektrochemische-prozesse-und-energetik-bewertungskompetenz",
        "title": "bewerten die Verbrennung fossiler Energieträger und elektrochemische Energiewandler hinsichtlich Effizienz und Nachhaltigkeit auch mithilfe von recherchierten thermodynamischen Daten",
        "description": "Die lernende Person kann bewerten die Verbrennung fossiler Energieträger und elektrochemische Energiewandler hinsichtlich Effizienz und Nachhaltigkeit auch mithilfe von recherchierten thermodynamischen Daten.",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "sourceRef": "Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Grundkurs, Elektrochemische Prozesse und Energetik, Bewertungskompetenz, S. 41.",
        "sourceText": "bewerten die Verbrennung fossiler Energieträger und elektrochemische Energiewandler hinsichtlich Effizienz und Nachhaltigkeit auch mithilfe von recherchierten thermodynamischen Daten",
        "sourceSpan": {
          "passageId": "de-nw-chemie-sekii-klp-2022:GK-elektrochemische-prozesse-und-energetik-bewertungskompetenz",

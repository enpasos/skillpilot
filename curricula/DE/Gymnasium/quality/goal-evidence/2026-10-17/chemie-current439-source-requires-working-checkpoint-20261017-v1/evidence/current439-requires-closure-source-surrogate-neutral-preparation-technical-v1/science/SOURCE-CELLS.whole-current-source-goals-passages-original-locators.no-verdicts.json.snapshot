      "wholeCurrentSourceGoal": {
        "id": "sn-chem-seki-sn-ch-klassenstufe-9-lb1-049-01-d1d107f8",
        "passageId": "sn-chemistry-seki:sn-ch-klassenstufe-9-lb1",
        "topicCode": "SN-CH-klassenstufe-9-LB1",
        "bulletIndex": 49,
        "aspectIndex": 1,
        "title": "Kennen der sauren, basischen oder neutralen Eigenschaft von Lösungen verschiedene Lösungen des Alltags: experimentelles Untersuchen von Lösungen mit Indikatoren Verhaltensregeln...",
        "description": "Die lernende Person kann Kennen der sauren, basischen oder neutralen Eigenschaft von Lösungen verschiedene Lösungen des Alltags: experimentelles Untersuchen von Lösungen mit Indikatoren Verhaltensregeln beim Umgang mit basischen Lösungen.",
        "sourceText": "Kennen der sauren, basischen oder neutralen Eigenschaft von Lösungen verschiedene Lösungen des Alltags: experimentelles Untersuchen von Lösungen mit Indikatoren Verhaltensregeln beim Umgang mit basischen Lösungen",
        "sourceSpan": "Klassenstufe 9, Saure, basische und neutrale Lösungen, PDF-S. 27",
        "parentBulletText": "Kennen der sauren, basischen oder neutralen Eigenschaft von Lösungen verschiedene Lösungen des Alltags",

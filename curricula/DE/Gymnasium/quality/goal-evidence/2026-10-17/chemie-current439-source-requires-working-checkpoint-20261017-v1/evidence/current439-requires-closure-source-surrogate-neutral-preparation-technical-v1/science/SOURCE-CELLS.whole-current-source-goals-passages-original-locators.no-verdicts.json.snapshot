      "wholeCurrentSourceGoal": {
        "id": "sl-chem-seki-sl-ch-seki-8-2024-p021-001-d8a6a27e",
        "passageId": "sl-chemistry-seki:sl-ch-seki-8-2024:p021",
        "topicCode": "SL-CH-SEKI-8-2024-P021",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "planen Experimente zur Überprüfung von Stoffeigenschaften von Metallen und führen diese durch",
        "description": "Die lernende Person kann planen Experimente zur Überprüfung von Stoffeigenschaften von Metallen und führen diese durch.",
        "sourceText": "planen Experimente zur Überprüfung von Stoffeigenschaften von Metallen und führen diese durch,",
        "sourceSpan": "Klasse 8, S. 21, Source-Ziel 1",
        "parentBulletText": "planen Experimente zur Überprüfung von Stoffeigenschaften von Metallen und führen diese durch,",
        "sourceRef": "SL-CH-SEKI-8-2024 S. 21",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekI",
          "courseLevel:GK_LK",
          "sourceDocument:SL-CH-SEKI-8-2024",
          "sourcePage:21"
        ],
        "rawSourceText": "planen Experimente zur Überprüfung von Stoffeigenschaften von Metallen und führen diese durch,",
        "rawSourceSpan": "Klasse 8, S. 21, Source-Ziel 1",
        "rawParentBulletText": "planen Experimente zur Überprüfung von Stoffeigenschaften von Metallen und führen diese durch,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-seki:sl-ch-seki-8-2024:p021",
        "topicCode": "SL-CH-SEKI-8-2024-P021",
        "title": "Klasse 8: Kompetenzpassage S. 21",
        "text": "- planen Experimente zur Überprüfung von Stoffeigenschaften von Metallen und führen diese durch,\n- recherchieren Anwendungen gängiger Werkund Schmuckmetalle,\n- geben für ausgewählte Metalle die Elementsymbole an,\n- beschreiben Legierungen als homogene erstarrte Lösungen mindestens zweier Metalle oder eines Metalls und eines weiteren Elementes,\n- recherchieren die Zusammensetzung und Verwendung gebräuchlicher Legierungen,\n- nennen ausgewählte Nichtmetalle (Wasserstoff, Kohlenstoff, Stickstoff, Sauerstoff, Schwefel, Iod),\n- nennen spezifische Eigenschaften der genannten Nichtmetalle (Farbe, Geruch, Vorkommen als Feststoff, Schmelzund Siedetemperatur, Löslichkeit in Wasser, Dichte, Brennbarkeit),\n- geben die Modifikationen von Schwefel, Sauerstoff oder Kohlenstoff an.",
        "page": 21,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_Gymnasium_G9_Klasse_8_2024_red_2025.pdf",

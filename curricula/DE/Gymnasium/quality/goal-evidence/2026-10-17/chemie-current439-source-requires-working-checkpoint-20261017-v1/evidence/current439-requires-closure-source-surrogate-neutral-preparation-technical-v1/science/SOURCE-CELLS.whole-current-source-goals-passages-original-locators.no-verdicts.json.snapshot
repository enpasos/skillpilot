        ],
        "rawSourceText": "bestimmen die pH-Werte verschiedener Nahrungsmittel und Haushaltschemikalien mithilfe von Indikatoren, Indikatorgemischen oder eines pH-Meters.",
        "rawSourceSpan": "Klasse 9, S. 13, Source-Ziel 8",
        "rawParentBulletText": "bestimmen die pH-Werte verschiedener Nahrungsmittel und Haushaltschemikalien mithilfe von Indikatoren, Indikatorgemischen oder eines pH-Meters."
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-seki:sl-ch-seki-9-2025:p013",
        "topicCode": "SL-CH-SEKI-9-2025-P013",
        "title": "Klasse 9: Kompetenzpassage S. 13",
        "text": "- unterscheiden neutrale, saure und alkalische Lösungen,\n- erklären den Begriff Indikator,\n- stellen eigene Indikatoren her und untersuchen deren Farbe in neutralen, sauren und alkalischen Lösungen,\n- nennen ausgewählte Indikatoren und ihre Farben im sauren, neutralen und alkalischen Milieu,\n- unterscheiden saure, neutrale und alkalische Lösungen mit ausgewählten Indikatoren und Indikatorgemischen,\n- definieren den pH-Wert,\n- erklären die pH-Wert-Skala,\n- bestimmen die pH-Werte verschiedener Nahrungsmittel und Haushaltschemikalien mithilfe von Indikatoren, Indikatorgemischen oder eines pH-Meters.",
        "page": 13,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_Gymnasium_G9_Klasse_9_2025.pdf",

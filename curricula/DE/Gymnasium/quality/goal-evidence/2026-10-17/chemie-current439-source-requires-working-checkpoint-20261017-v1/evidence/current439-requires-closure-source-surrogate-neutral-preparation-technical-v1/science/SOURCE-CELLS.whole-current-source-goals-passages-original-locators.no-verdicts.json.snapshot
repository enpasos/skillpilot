      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-sekii-kc2022-q-redox-2-kompetenz-007-52843844",
        "passageId": "ni-chemistry-sekii-kc2022-q-redox-2",
        "topicCode": "Q-REDOX-2",
        "topicTitle": "Elektronenübertragungsreaktionen",
        "category": "Kompetenz",
        "title": "planen Experimente zum Bau funktionsfähiger galvanischer Zellen und führen diese durch.",
        "description": "Die lernende Person kann planen Experimente zum Bau funktionsfähiger galvanischer Zellen und führen diese durch..",
        "sourceDocumentKey": "NI-KC-CHEMIE-SEKII-2022",
        "sourceRef": "Niedersachsen Kerncurriculum Chemie gymnasiale Oberstufe 2022, Elektronenübertragungsreaktionen, S. 25.",
        "sourceText": "planen Experimente zum Bau funktionsfähiger galvanischer Zellen und führen diese durch.",
        "sourceSpan": {
          "passageId": "ni-chemistry-sekii-kc2022-q-redox-2",
          "label": "Kompetenz: planen Experimente zum Bau funktionsfähiger galvanischer Zellen und führen diese durch."
        },
        "courseLevel": "GK_LK",
        "tags": [

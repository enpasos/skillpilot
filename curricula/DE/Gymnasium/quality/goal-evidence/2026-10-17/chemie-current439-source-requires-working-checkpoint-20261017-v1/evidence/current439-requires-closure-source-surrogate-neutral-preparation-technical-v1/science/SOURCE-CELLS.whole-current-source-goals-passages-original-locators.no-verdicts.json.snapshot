      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-spr-2024-p021-011-f8887bc3",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-spr-2024:p021",
        "topicCode": "SL-CH-SEKII-EP-SPR-2024-P021",
        "bulletIndex": 11,
        "aspectIndex": 1,
        "title": "erklären die Schmelzbzw. Siedetemperaturen von cis/trans-Isomeren (Z-/E-Isomeren) mithilfe der zwischenmolekularen Kräfte",
        "description": "Die lernende Person kann erklären die Schmelzbzw. Siedetemperaturen von cis/trans-Isomeren (Z-/E-Isomeren) mithilfe der zwischenmolekularen Kräfte.",
        "sourceText": "erklären die Schmelzbzw. Siedetemperaturen von cis/trans-Isomeren (Z-/E-Isomeren) mithilfe der zwischenmolekularen Kräfte,",
        "sourceSpan": "Einführungsphase sprachlicher Zweig, S. 21, Source-Ziel 11",
        "parentBulletText": "erklären die Schmelzbzw. Siedetemperaturen von cis/trans-Isomeren (Z-/E-Isomeren) mithilfe der zwischenmolekularen Kräfte,",
        "sourceRef": "SL-CH-SEKII-EP-SPR-2024 S. 21",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [

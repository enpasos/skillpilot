      },
      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-nw-2024-p018-002-b2cec702",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p018",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P018",
        "bulletIndex": 2,
        "aspectIndex": 1,
        "title": "zeichnen die Orbitaldarstellungen von Wasserstoff, Halogenen und Halogenwasserstoffen",
        "description": "Die lernende Person kann zeichnen die Orbitaldarstellungen von Wasserstoff, Halogenen und Halogenwasserstoffen.",
        "sourceText": "zeichnen die Orbitaldarstellungen von Wasserstoff, Halogenen und Halogenwasserstoffen,",
        "sourceSpan": "Einführungsphase NW-Zweig, S. 18, Source-Ziel 2",
        "parentBulletText": "zeichnen die Orbitaldarstellungen von Wasserstoff, Halogenen und Halogenwasserstoffen,",
        "sourceRef": "SL-CH-SEKII-EP-NW-2024 S. 18",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:GK_LK",
          "sourceDocument:SL-CH-SEKII-EP-NW-2024",
          "sourcePage:18"
        ],
        "rawSourceText": "zeichnen die Orbitaldarstellungen von Wasserstoff, Halogenen und Halogenwasserstoffen,",
        "rawSourceSpan": "Einführungsphase NW-Zweig, S. 18, Source-Ziel 2",
        "rawParentBulletText": "zeichnen die Orbitaldarstellungen von Wasserstoff, Halogenen und Halogenwasserstoffen,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p018",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P018",
        "title": "Einführungsphase NW-Zweig: Kompetenzpassage S. 18",
        "text": "- beschreiben ausgehend von Atomorbitalen modellhaft die Entstehung von Molekülorbitalen durch Überlappen von halbbesetzten sund p-Atomorbitalen,\n- zeichnen die Orbitaldarstellungen von Wasserstoff, Halogenen und Halogenwasserstoffen,\n- geben Methan als einfachste Kohlenwasserstoff-Verbindung an,\n- recherchieren weitere Namen (Trivialnamen) für Methan,\n- recherchieren und beschreiben die Entstehung von Methan bei der Zersetzung organischer Stoffe,\n- geben an, aus welchen natürlichen und technischen Quellen Methan in die Atmosphäre gelangt,\n- erklären die Tetraederstruktur (Bindungswinkel, Molekülgeometrie) des Methan-Moleküls mithilfe des EPA-Modells,\n- beschreiben den Aufbau weiterer Alkane mithilfe von Strukturformeln,\n- erstellen einfache Molekülmodelle der Alkane mithilfe eines Molekülbaukastens.",
        "page": 18,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Einfuehrungsphase_naturwissenschaftlicher_Zweig_2024.pdf",

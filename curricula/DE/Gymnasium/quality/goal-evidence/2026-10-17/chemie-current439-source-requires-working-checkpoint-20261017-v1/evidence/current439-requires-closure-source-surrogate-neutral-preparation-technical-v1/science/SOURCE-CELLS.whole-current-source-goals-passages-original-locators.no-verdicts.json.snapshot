      "wholeCurrentSourceGoal": {
        "id": "mv-chem-sekii-mv-ch-sekii-2022-erprobung-q-saeure-base-loeslichkeit-013-eeb281b4",
        "passageId": "mv-chemistry-sekii:q-saeure-base-loeslichkeit",
        "topicCode": "Q-SAEURE-BASE-LOESLICHKEIT",
        "bulletIndex": 75,
        "aspectIndex": 1,
        "title": "Fällungs- und Löseprozesse sowie Auflösen von Salzen in Wasser teilchenmäßig und energetisch beschreiben",
        "description": "Die lernende Person kann Fällungs- und Löseprozesse sowie Auflösen von Salzen in Wasser teilchenmäßig und energetisch beschreiben.",
        "sourceText": "Fällungs- und Löseprozesse sowie Auflösen von Salzen in Wasser teilchenmäßig und energetisch beschreiben",
        "sourceSpan": "Qualifikationsphase, Qualifikationsphase: Säure-Base- und Löslichkeitsgleichgewichte, S. 24",
        "parentBulletText": "Fällungs- und Löseprozesse sowie Auflösen von Salzen in Wasser teilchenmäßig und energetisch beschreiben",
        "sourceRef": "Rahmenplan Chemie Qualifikationsphase gymnasiale Oberstufe Mecklenburg-Vorpommern 2022 Erprobungsfassung, Qualifikationsphase, Qualifikationsphase: Säure-Base- und Löslichkeitsgleichgewichte, S. 24",
        "courseLevel": "LK",
        "granularity": "officialContentGoal",
        "tags": [

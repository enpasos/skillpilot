        ],
        "rawSourceText": "erklären die pH-Abhängigkeit von Redoxpotenzialen mit Hilfe des chemischen Gleichgewichts,",
        "rawSourceSpan": "Hauptphase Leistungskurs, S. 54, Source-Ziel 6",
        "rawParentBulletText": "erklären die pH-Abhängigkeit von Redoxpotenzialen mit Hilfe des chemischen Gleichgewichts,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-lk-2023-2025:p054",
        "topicCode": "SL-CH-SEKII-LK-2023-2025-P054",
        "title": "Hauptphase Leistungskurs: Kompetenzpassage S. 54",
        "text": "- skizzieren und beschreiben einen Versuchsaufbau zur Messung von Standardredoxpotenzialen,\n- geben eine Definition für das Standardredoxpotenzial E0 an,\n- führen einfache Experimente zur elektrochemischen Spannungsreihe von Metallen durch,\n- erklären das Zustandekommen der Spannung zwischen verschiedenen Redoxpaaren,\n- vergleichen Standardredoxpotenziale von Redoxpaaren und interpretieren diese hinsichtlich ihrer Bedeutung für den Ablauf von Redoxreaktionen,\n- erklären die pH-Abhängigkeit von Redoxpotenzialen mit Hilfe des chemischen Gleichgewichts,\n- beschreiben den Aufbau des DANIELL-Elementes.",
        "page": 54,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Leistungskurs_2023_ab_2027_red_2025.pdf",

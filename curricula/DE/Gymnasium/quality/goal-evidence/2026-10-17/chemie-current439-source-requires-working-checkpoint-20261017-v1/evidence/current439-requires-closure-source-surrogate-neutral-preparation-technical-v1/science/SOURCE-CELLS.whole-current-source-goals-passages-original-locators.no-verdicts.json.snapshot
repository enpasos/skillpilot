      "wholeCurrentSourceGoal": {
        "id": "mv-chem-sekii-mv-ch-sekii-2022-erprobung-q-saeure-base-loeslichkeit-007-8094fae5",
        "passageId": "mv-chemistry-sekii:q-saeure-base-loeslichkeit",
        "topicCode": "Q-SAEURE-BASE-LOESLICHKEIT",
        "bulletIndex": 69,
        "aspectIndex": 1,
        "title": "Grundlagen der Maßanalyse und Prinzip einer Säure-Base-Titration beschreiben",
        "description": "Die lernende Person kann Grundlagen der Maßanalyse und Prinzip einer Säure-Base-Titration beschreiben.",
        "sourceText": "Grundlagen der Maßanalyse und Prinzip einer Säure-Base-Titration beschreiben",
        "sourceSpan": "Qualifikationsphase, Qualifikationsphase: Säure-Base- und Löslichkeitsgleichgewichte, S. 24",
        "parentBulletText": "Grundlagen der Maßanalyse und Prinzip einer Säure-Base-Titration beschreiben",
        "sourceRef": "Rahmenplan Chemie Qualifikationsphase gymnasiale Oberstufe Mecklenburg-Vorpommern 2022 Erprobungsfassung, Qualifikationsphase, Qualifikationsphase: Säure-Base- und Löslichkeitsgleichgewichte, S. 24",
        "courseLevel": "GK_LK",
        "granularity": "officialContentGoal",
        "tags": [

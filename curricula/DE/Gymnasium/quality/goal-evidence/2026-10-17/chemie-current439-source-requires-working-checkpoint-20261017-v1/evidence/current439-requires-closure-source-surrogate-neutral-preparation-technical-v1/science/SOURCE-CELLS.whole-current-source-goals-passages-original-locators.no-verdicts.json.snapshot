        "sourceSpan": {
          "passageId": "ni-chemistry-sekii-kc2022-q-energie-1",
          "label": "Kompetenz: führen Experimente zur Ermittlung von Reaktionsenthalpien in einfachen Kalorimetern durch und reflektieren ihre Ergebnisse."
        },
        "courseLevel": "GK_LK",
        "tags": [

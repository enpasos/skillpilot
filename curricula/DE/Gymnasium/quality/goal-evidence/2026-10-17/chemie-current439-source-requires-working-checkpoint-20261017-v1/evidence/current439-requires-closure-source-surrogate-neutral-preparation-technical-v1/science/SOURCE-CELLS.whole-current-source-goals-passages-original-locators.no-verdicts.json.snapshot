      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-sekii-kc2022-q-protolyse-1-kompetenz-018-f6b067ff",
        "passageId": "ni-chemistry-sekii-kc2022-q-protolyse-1",
        "topicCode": "Q-PROTOLYSE-1",
        "topicTitle": "Protonenübertragungsreaktionen",
        "category": "Kompetenz",
        "title": "erklären den Zusammenhang zwischen der Autoprotolyse des Wassers und dem pH-Wert.",
        "description": "Die lernende Person kann erklären den Zusammenhang zwischen der Autoprotolyse des Wassers und dem pH-Wert..",
        "sourceDocumentKey": "NI-KC-CHEMIE-SEKII-2022",

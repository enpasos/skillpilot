      "wholeCurrentSourceGoal": {
        "id": "de-nw-chemie-sekii-klp-2022-LK-reaktionswege-in-der-organischen-chemie-sachkompetenz-009-ce40094e",
        "passageId": "de-nw-chemie-sekii-klp-2022:LK-reaktionswege-in-der-organischen-chemie-sachkompetenz",
        "topicCode": "LK-reaktionswege-in-der-organischen-chemie-sachkompetenz",
        "title": "klassifizieren Farbstoffe sowohl auf Grundlage struktureller Merkmale als auch nach ihrer Verwendung",
        "description": "Die lernende Person kann klassifizieren Farbstoffe sowohl auf Grundlage struktureller Merkmale als auch nach ihrer Verwendung.",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "sourceRef": "Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Leistungskurs, Reaktionswege in der organischen Chemie, Sachkompetenz, S. 53.",
        "sourceText": "klassifizieren Farbstoffe sowohl auf Grundlage struktureller Merkmale als auch nach ihrer Verwendung",
        "sourceSpan": {

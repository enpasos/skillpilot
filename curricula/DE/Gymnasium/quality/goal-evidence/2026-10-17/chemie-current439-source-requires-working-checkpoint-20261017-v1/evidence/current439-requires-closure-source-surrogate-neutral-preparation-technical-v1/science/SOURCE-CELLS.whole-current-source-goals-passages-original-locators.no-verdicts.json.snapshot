      "wholeCurrentSourceGoal": {
        "id": "hb-chemistry-seki-bp2006-2022-3-1-rohstoffe-010-9dbbaed6",
        "passageId": "hb-chemistry-seki:3.1-ROHSTOFFE",
        "topicCode": "3.1-ROHSTOFFE",
        "bulletIndex": 10,
        "aspectIndex": 1,
        "title": "Mineralien als Ausgangsstoffe fuer die Metallgewinnung kennen",
        "description": "Die lernende Person kann Mineralien als Ausgangsstoffe fuer die Metallgewinnung kennen.",

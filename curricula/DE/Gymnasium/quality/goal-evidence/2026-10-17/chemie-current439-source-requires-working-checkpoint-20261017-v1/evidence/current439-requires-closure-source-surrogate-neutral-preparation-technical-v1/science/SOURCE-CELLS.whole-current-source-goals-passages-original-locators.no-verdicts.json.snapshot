          "bytes": 129433
        },
        "sourceGoalPointer": "/sourceGoals/11",
        "sourceGoalFieldCanonicalSHA256": "ef603a8e9ba02bae86fa46bd86a3ac956d90110b3dd2c2399a322dfad974cacf",
        "wholePassagePointer": "/passages/1"
      },
      "wholeCurrentSourceGoal": {
        "id": "de-hh-chemie-sekii-bildungsplan-2022-1-2-012-06456ca4",
        "passageId": "de-hh-chemie-sekii-bildungsplan-2022:1-2",
        "topicCode": "1.2",
        "title": "den Reaktionsmechanismus der Veresterung als nukleophile Substitution beschreiben",
        "description": "Die lernende Person kann den Reaktionsmechanismus der Veresterung als nukleophile Substitution beschreiben.",
        "sourceDocumentKey": "HH-CHEMIE-GYO-2022",
        "sourceRef": "Hamburg Bildungsplan Studienstufe Chemie 2022, 1.2, S. 25.",
        "sourceText": "den Reaktionsmechanismus der Veresterung als nukleophile Substitution beschreiben",
        "sourceSpan": {
          "passageId": "de-hh-chemie-sekii-bildungsplan-2022:1-2",
          "label": "1.2, S. 25: den Reaktionsmechanismus der Veresterung als nukleophile Substitution beschreiben"
        },
        "courseLevel": "LK",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-HH",
          "stage:SekII",
          "section:1-2",
          "courseLevel:LK"
        ],
        "metadata": {
          "extractionMethod": "manual-transcription-from-official-hamburg-pdf-passages",
          "sectionCode": "1.2"
        }
      },
      "wholeOriginalPassage": {
        "id": "de-hh-chemie-sekii-bildungsplan-2022:1-2",
        "sourceDocumentKey": "HH-CHEMIE-GYO-2022",
        "topicCode": "1.2",
        "title": "1.2 Natuerliche Makromolekuele - Fette",
        "page": 25,
        "rawText": "- Fette als Triglyceride aufbauen und beschreiben\n- gesaettigte und ungesaettigte Fettsaeuren unterscheiden\n- Estersynthese aus Glycerin und Fettsaeuren sowie Veresterung beschreiben\n- hydrolytische Spaltung der Fette beschreiben\n- den Reaktionsmechanismus der Veresterung als nukleophile Substitution beschreiben\n- hydrophobe beziehungsweise lipophile Eigenschaften der Fette beschreiben\n- Schmelzbereich der Fette und Van-der-Waals-Wechselwirkungen erklaeren\n- essenzielle Fettsaeuren und Omega-3-Fettsaeuren in Nahrungsmitteln einordnen\n- Fette als Energiespeicher beschreiben\n- Fetthaertung und trans-Fettsaeuren chemisch einordnen\n- die Iodzahl mit Iodometrie als Redoxtitration bestimmen\n- Kennzahlen von Fetten wie Verseifungszahl und Saeurezahl verwenden",
        "sourceGoalIds": [
          "de-hh-chemie-sekii-bildungsplan-2022-1-2-008-4baf539a",
          "de-hh-chemie-sekii-bildungsplan-2022-1-2-009-894658c4",

      "wholeCurrentSourceGoal": {
        "id": "th-chem-seki-th-ch-seki-2-2-1-1-kohlenwasserstoffe-110-03-7c7710d5",
        "passageId": "th-chemistry-seki:th-ch-seki-2-2-1-1-kohlenwasserstoffe",
        "topicCode": "TH-CH-SekI-2.2.1.1-kohlenwasserstoffe",
        "bulletIndex": 110,
        "aspectIndex": 3,
        "title": "den Zusammenhang zwischen Struktur und Eigenschaften der n-Alkane erläutern: Löslichkeit in unpolaren und polaren Lösemitteln (hydrophil, hydrophob, lipophil, lipophob)",
        "description": "Die lernende Person kann den Zusammenhang zwischen Struktur und Eigenschaften der n-Alkane erläutern: Löslichkeit in unpolaren und polaren Lösemitteln (hydrophil, hydrophob, lipophil, lipophob).",
        "sourceText": "den Zusammenhang zwischen Struktur und Eigenschaften der n-Alkane erläutern: Löslichkeit in unpolaren und polaren Lösemitteln (hydrophil, hydrophob, lipophil, lipophob)",
        "sourceSpan": "Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Kohlenwasserstoffe, PDF-S. 27",
        "parentBulletText": "den Zusammenhang zwischen Struktur und Eigenschaften der n-Alkane erläutern:",
        "sourceRef": "Lehrplan Gymnasium Chemie Thueringen 2024, Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Kohlenwasserstoffe, PDF-S. 27",
        "courseLevel": "GK_LK",
        "granularity": "officialCompetencyAspect",
        "tags": [
          "source:thueringen",
          "subject:Chemie",
          "stage:SekI",
          "section:2.2.1.1",

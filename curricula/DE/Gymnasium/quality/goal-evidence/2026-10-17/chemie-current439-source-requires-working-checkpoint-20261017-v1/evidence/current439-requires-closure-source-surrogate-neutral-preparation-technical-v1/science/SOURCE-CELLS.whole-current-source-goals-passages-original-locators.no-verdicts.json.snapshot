      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-sekii-kc2022-q-redox-3-kompetenz-003-3fd40e3c",
        "passageId": "ni-chemistry-sekii-kc2022-q-redox-3",
        "topicCode": "Q-REDOX-3",
        "topicTitle": "Elektronenübertragungsreaktionen",
        "category": "Kompetenz",
        "title": "erklären den Korrosionsschutz durch eine Opferanode.",
        "description": "Die lernende Person kann erklären den Korrosionsschutz durch eine Opferanode..",
        "sourceDocumentKey": "NI-KC-CHEMIE-SEKII-2022",
        "sourceRef": "Niedersachsen Kerncurriculum Chemie gymnasiale Oberstufe 2022, Elektronenübertragungsreaktionen, S. 26.",
        "sourceText": "erklären den Korrosionsschutz durch eine Opferanode.",
        "sourceSpan": {
          "passageId": "ni-chemistry-sekii-kc2022-q-redox-3",
          "label": "Kompetenz: erklären den Korrosionsschutz durch eine Opferanode."
        },
        "courseLevel": "GK_LK",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-NI",
          "stage:SekII",

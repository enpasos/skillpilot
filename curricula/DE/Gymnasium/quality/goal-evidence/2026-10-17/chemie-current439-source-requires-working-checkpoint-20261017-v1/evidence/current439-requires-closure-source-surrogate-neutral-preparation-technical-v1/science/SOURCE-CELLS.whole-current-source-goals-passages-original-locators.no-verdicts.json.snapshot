      "wholeCurrentSourceGoal": {
        "id": "sn-chem-seki-sn-ch-klassenstufe-8-lb5-035-01-d0f98a3c",
        "passageId": "sn-chemistry-seki:sn-ch-klassenstufe-8-lb5",
        "topicCode": "SN-CH-klassenstufe-8-LB5",
        "bulletIndex": 35,
        "aspectIndex": 1,
        "title": "Einblick in die Bedeutung und Verwendung sowie den Umgang mit Säuren und deren sauren Lösungen im Alltag gewinnen Einteilung in anorganische und organische sauerstoffhaltige ano...",
        "description": "Die lernende Person kann Einblick in die Bedeutung und Verwendung sowie den Umgang mit Säuren und deren sauren Lösungen im Alltag gewinnen Einteilung in anorganische und organische sauerstoffhaltige anorganische Säuren Verhaltensregeln saurer Regen und dessen Wirkungen experimentelles Untersuchen von sauren Lösungen mit Indikatoren.",
        "sourceText": "Einblick in die Bedeutung und Verwendung sowie den Umgang mit Säuren und deren sauren Lösungen im Alltag gewinnen Einteilung in anorganische und organische sauerstoffhaltige anorganische Säuren Verhaltensregeln saurer Regen und dessen Wirkungen experimentelles Untersuchen von sauren Lösungen mit Indikatoren",
        "sourceSpan": "Klassenstufe 8, Säuren und deren saure Lösungen, PDF-S. 24",
        "parentBulletText": "Einblick in die Bedeutung und Verwendung sowie den Umgang mit Säuren und deren sauren Lösungen im Alltag gewinnen Einteilung in anorganische und organische sauerstoffhaltige anorganische Säuren Verhaltensregeln saurer Regen und dessen Wirkungen experimentelles Untersuchen von sauren Lösungen mit Indikatoren",
        "sourceRef": "Lehrplan Gymnasium Chemie Sachsen 2025, Klassenstufe 8, Säuren und deren saure Lösungen, PDF-S. 24",
        "courseLevel": "GK_LK",
        "granularity": "officialCompetencyRow",
        "tags": [
          "source:sachsen",
          "subject:Chemie",
          "stage:SekI",
          "topic:sn-ch-klassenstufe-8-lb5",
          "course:GK_LK",
          "sourceDocument:SN-CH-2025"
        ],
        "rawSourceText": "Einblick in die Bedeutung und Verwendung sowie den Umgang mit Säuren und deren sauren Lösungen im Alltag gewinnen Einteilung in anorganische und organische sauerstoffhaltige anorganische Säuren Verhaltensregeln saurer Regen und dessen Wirkungen experimentelles Untersuchen von sauren Lösungen mit Indikatoren",
        "rawSourceSpan": "Klassenstufe 8, Säuren und deren saure Lösungen, PDF-S. 24",
        "rawParentBulletText": "Einblick in die Bedeutung und Verwendung sowie den Umgang mit Säuren und deren sauren Lösungen im Alltag gewinnen Einteilung in anorganische und organische sauerstoffhaltige anorganische Säuren Verhaltensregeln saurer Regen und dessen Wirkungen experimentelles Untersuchen von sauren Lösungen mit Indikatoren"
      },
      "wholeOriginalPassage": {
        "id": "sn-chemistry-seki:sn-ch-klassenstufe-8-lb5",
        "topicCode": "SN-CH-klassenstufe-8-LB5",
        "title": "Klassenstufe 8: Säuren und deren saure Lösungen",
        "text": "Redaktionelle Zusammenfassung, kein wörtlicher Quellenauszug.\n\n- Einblick in die Bedeutung und Verwendung sowie den Umgang mit Säuren und deren sauren Lösungen im Alltag gewinnen Einteilung in anorganische und organische sauerstoffhaltige anorganische Säuren Verhaltensregeln saurer Regen und dessen Wirkungen experimentelles Untersuchen von sauren Lösungen mit Indikatoren\n- Anwenden des Wissens über den Zusammenhang von Bau und Eigenschaften von Stoffen auf Chlorwasserstoff und seine wässrige Lösung Molekülsubstanzen, Polarität der Atombindung, verdünnte und konzentrierte saure Lösungen, Massenanteil: experimentelles Untersuchen von Eigenschaften elektrische Leitfähigkeit, Wärmeentwicklung beim Lösen und Verdünnen Nutzung digitaler Werkzeuge zur Messwerterfassung\n- Kennen der Reaktion mit Protonenübergang am Beispiel der chemischen Reaktion von Chlorwasserstoff mit Wasser Donator-Akzeptor-Prinzip: Reaktionsgleichungen für Protonenabgabe, Protonenaufnahme und Gesamtreaktion in Ionenschreibweise, Bruttogleichung Teilgleichungen\n- Kennen der Reaktion mit Protonenübergang am Beispiel der chemischen Reaktion von Chlorwasserstoff mit Wasser Donator-Akzeptor-Prinzip: Oxonium-Ion Merkmal saurer Lösungen\n- Übertragen des Wissens über Reaktionen mit Protonenübergang auf die chemische Reaktion von Schwefelsäure mit Wasser Donator-Akzeptor-Prinzip vollständige Protolyse\n- Anwenden des Wissens über Redoxreaktionen auf chemische Reaktionen von verdünnten sauren Lösungen mit unedlen Metallen Salzlösungen experimentelles Untersuchen SE Interpretation als Redoxreaktion",
        "page": 24,
        "sourcePath": "curricula/DE/Gymnasium/input/SN/lehrplan-gymnasium-chemie-sachsen-2025.pdf",
        "sourceGoalIds": [
          "sn-chem-seki-sn-ch-klassenstufe-8-lb5-035-01-d0f98a3c",

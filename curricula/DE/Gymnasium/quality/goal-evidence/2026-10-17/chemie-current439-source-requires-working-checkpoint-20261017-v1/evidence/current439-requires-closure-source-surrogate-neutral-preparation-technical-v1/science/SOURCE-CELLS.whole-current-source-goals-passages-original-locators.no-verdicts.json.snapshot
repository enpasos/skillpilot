        "topicCode": "SL-CH-SEKI-8-2024-P014",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "nennen spezifische Stoffeigenschaften (Farbe, Geruch, Geschmack, Dichte, Leitfähigkeit, Löslichkeit, Schmelzund Siedetemperatur, Aggregatzustand, Brennbarkeit)",
        "description": "Die lernende Person kann nennen spezifische Stoffeigenschaften (Farbe, Geruch, Geschmack, Dichte, Leitfähigkeit, Löslichkeit, Schmelzund Siedetemperatur, Aggregatzustand, Brennbarkeit).",
        "sourceText": "nennen spezifische Stoffeigenschaften (Farbe, Geruch, Geschmack, Dichte, Leitfähigkeit, Löslichkeit, Schmelzund Siedetemperatur, Aggregatzustand, Brennbarkeit),",
        "sourceSpan": "Klasse 8, S. 14, Source-Ziel 1",
        "parentBulletText": "nennen spezifische Stoffeigenschaften (Farbe, Geruch, Geschmack, Dichte, Leitfähigkeit, Löslichkeit, Schmelzund Siedetemperatur, Aggregatzustand, Brennbarkeit),",
        "sourceRef": "SL-CH-SEKI-8-2024 S. 14",

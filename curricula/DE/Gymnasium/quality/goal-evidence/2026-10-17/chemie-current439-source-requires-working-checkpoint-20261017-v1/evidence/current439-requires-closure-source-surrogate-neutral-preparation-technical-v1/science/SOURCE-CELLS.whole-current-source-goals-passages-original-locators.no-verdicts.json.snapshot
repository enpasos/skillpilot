        "passageId": "sl-chemistry-seki:sl-ch-seki-8-2024:p015",
        "topicCode": "SL-CH-SEKI-8-2024-P015",
        "bulletIndex": 4,
        "aspectIndex": 1,
        "title": "beschreiben die Stoffgemische Lösung, Nebel, Rauch, Emulsion und Suspension und nennen die Aggregatzustände ihrer Bestandteile",
        "description": "Die lernende Person kann beschreiben die Stoffgemische Lösung, Nebel, Rauch, Emulsion und Suspension und nennen die Aggregatzustände ihrer Bestandteile.",
        "sourceText": "beschreiben die Stoffgemische Lösung, Nebel, Rauch, Emulsion und Suspension und nennen die Aggregatzustände ihrer Bestandteile,",
        "sourceSpan": "Klasse 8, S. 15, Source-Ziel 4",
        "parentBulletText": "beschreiben die Stoffgemische Lösung, Nebel, Rauch, Emulsion und Suspension und nennen die Aggregatzustände ihrer Bestandteile,",
        "sourceRef": "SL-CH-SEKI-8-2024 S. 15",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [

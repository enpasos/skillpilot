      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:LK-moderne-werkstoffe-erkenntnisgewinnungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "LK-moderne-werkstoffe-erkenntnisgewinnungskompetenz",
        "title": "Qualifikationsphase Leistungskurs: Moderne Werkstoffe / Erkenntnisgewinnungskompetenz",
        "page": 55,
        "rawText": "- führen eigenständig geplante Experimente zur Untersuchung von Eigenschaften organischer Werkstoffe durch und werten diese aus\n- planen zielgerichtet anhand der Eigenschaften verschiedener Kunststoffe Experimente zur Trennung und Verwertung von Verpackungsabfällen\n- erläutern ermittelte Stoffeigenschaften am Beispiel eines Funktionspolymers mit geeigneten Modellen\n- veranschaulichen die Größenordnung und Reaktivität von Nanopartikeln\n- erklären eine experimentell ermittelte Oberflächeneigenschaft eines ausgewählten Nanoprodukts anhand der Nanostruktur",
        "sourceGoalIds": [

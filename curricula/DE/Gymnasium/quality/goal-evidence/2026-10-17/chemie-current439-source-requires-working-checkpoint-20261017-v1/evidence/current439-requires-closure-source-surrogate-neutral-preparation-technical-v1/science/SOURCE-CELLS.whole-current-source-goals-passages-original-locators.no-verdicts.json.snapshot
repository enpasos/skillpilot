      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-sekii-kc2022-ep-3-kompetenz-014-2a3415f9",
        "passageId": "ni-chemistry-sekii-kc2022-ep-3",
        "topicCode": "EP-3",
        "topicTitle": "Reaktionen von Alkanolen",
        "category": "Kompetenz",
        "title": "beurteilen die Gefahren ausgewählter Oxidationsprodukte der Alkanole und leiten daraus begründet Handlungsoptionen ab.",
        "description": "Die lernende Person kann beurteilen die Gefahren ausgewählter Oxidationsprodukte der Alkanole und leiten daraus begründet Handlungsoptionen ab..",
        "sourceDocumentKey": "NI-KC-CHEMIE-SEKII-2022",
        "sourceRef": "Niedersachsen Kerncurriculum Chemie gymnasiale Oberstufe 2022, Reaktionen von Alkanolen, S. 14.",
        "sourceText": "beurteilen die Gefahren ausgewählter Oxidationsprodukte der Alkanole und leiten daraus begründet Handlungsoptionen ab.",
        "sourceSpan": {
          "passageId": "ni-chemistry-sekii-kc2022-ep-3",
          "label": "Kompetenz: beurteilen die Gefahren ausgewählter Oxidationsprodukte der Alkanole und leiten daraus begründet Handlungsoptionen ab."
        },
        "courseLevel": "GK_LK",

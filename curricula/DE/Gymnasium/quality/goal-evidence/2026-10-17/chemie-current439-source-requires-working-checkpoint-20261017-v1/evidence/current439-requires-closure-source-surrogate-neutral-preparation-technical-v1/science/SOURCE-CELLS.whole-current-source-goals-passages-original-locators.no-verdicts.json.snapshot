      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-seki-kc2015-st-9-10-7-kompetenz-012-cdbf76be",
        "passageId": "ni-chemistry-seki-kc2015-st-9-10-7",
        "topicCode": "ST-9-10-7",
        "topicTitle": "Stoff-Teilchen (7/7)",
        "headingTitle": "Nachweisreaktionen anwenden",
        "title": "erkennen anhand der pH-Skala, ob eine Lösung sauer, neutral oder alkalisch ist und können dieses auf die Anwesenheit von H+/H3O+ - bzw. OH-- Ionen zurückführen.",
        "description": "Die lernende Person kann erkennen anhand der pH-Skala, ob eine Lösung sauer, neutral oder alkalisch ist und können dieses auf die Anwesenheit von H+/H3O+ - bzw. OH-- Ionen zurückführen.",
        "sourceDocumentKey": "NI-KC-NATURWISSENSCHAFTEN-SEKI-2015-CHEMIE",
        "sourceRef": "Niedersachsen Kerncurriculum Naturwissenschaften Gymnasium Sekundarbereich I 2015, Chemie, Stoff-Teilchen (7/7), Schuljahrgänge 9/10, S. 57.",
        "sourceText": "erkennen anhand der pH-Skala, ob eine Lösung sauer, neutral oder alkalisch ist und können dieses auf die Anwesenheit von H+/H3O+ - bzw. OH-- Ionen zurückführen.",
        "sourceSpan": {
          "passageId": "ni-chemistry-seki-kc2015-st-9-10-7",
          "label": "Nachweisreaktionen anwenden: erkennen anhand der pH-Skala, ob eine Lösung sauer, neutral oder alkalisch ist und können dieses auf die Anwesenheit von H+/H3O+ - bzw. OH-- Ionen zurückführen."
        },

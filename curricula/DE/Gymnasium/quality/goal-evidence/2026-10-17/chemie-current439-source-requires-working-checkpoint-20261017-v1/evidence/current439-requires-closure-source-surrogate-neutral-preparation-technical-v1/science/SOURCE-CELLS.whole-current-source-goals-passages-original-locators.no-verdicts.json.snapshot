      "wholeCurrentSourceGoal": {
        "id": "bb-chemistry-sekii-rlp-3-2-1-inhalte-010-6c88be84",
        "passageId": "bb-chemistry-sekii-rlp-3-2-1",
        "topicCode": "3.2.1",

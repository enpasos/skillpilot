      "wholeCurrentSourceGoal": {
        "id": "mv-chem-sekii-mv-ch-sekii-2022-erprobung-q-saeure-base-loeslichkeit-015-b28a50ad",
        "passageId": "mv-chemistry-sekii:q-saeure-base-loeslichkeit",
        "topicCode": "Q-SAEURE-BASE-LOESLICHKEIT",
        "bulletIndex": 77,
        "aspectIndex": 1,
        "title": "Massenwirkungsgesetz auf Löslichkeitsgleichgewichte anwenden und Löslichkeitsprodukt für Salze vom Typ AmBn ableiten",
        "description": "Die lernende Person kann Massenwirkungsgesetz auf Löslichkeitsgleichgewichte anwenden und Löslichkeitsprodukt für Salze vom Typ AmBn ableiten.",
        "sourceText": "Massenwirkungsgesetz auf Löslichkeitsgleichgewichte anwenden und Löslichkeitsprodukt für Salze vom Typ AmBn ableiten",
        "sourceSpan": "Qualifikationsphase, Qualifikationsphase: Säure-Base- und Löslichkeitsgleichgewichte, S. 24",

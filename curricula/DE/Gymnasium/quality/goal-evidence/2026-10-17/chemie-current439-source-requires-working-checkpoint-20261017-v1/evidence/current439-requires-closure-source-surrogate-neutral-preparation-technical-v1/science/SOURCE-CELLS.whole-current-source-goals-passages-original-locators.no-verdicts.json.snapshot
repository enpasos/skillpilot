      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-lk-2023-2025:p014",
        "topicCode": "SL-CH-SEKII-LK-2023-2025-P014",
        "title": "Hauptphase Leistungskurs: Kompetenzpassage S. 14",
        "text": "- beschreiben Experimente, die die Beeinflussung der Geschwindigkeit chemischer Reaktionen durch; Konzentrationsänderung,; Temperaturänderung und; Änderung der Grenzfläche (bei heterogenen Reaktionen)\n- erläutern den Einfluss von; Konzentrationsänderungen,; Druckänderungen,; Temperaturänderungen und; der Grenzfläche (bei heterogenen Reaktionen) auf die Reaktionsgeschwindigkeit auf der Teilchenebene mithilfe der Kollisionstheorie (Stoßtheorie),\n- nennen den Wortlaut der Reaktionsgeschwindigkeit-TemperaturRegel (RGT-Regel) und wenden diese an.",
        "page": 14,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Leistungskurs_2023_ab_2027_red_2025.pdf",

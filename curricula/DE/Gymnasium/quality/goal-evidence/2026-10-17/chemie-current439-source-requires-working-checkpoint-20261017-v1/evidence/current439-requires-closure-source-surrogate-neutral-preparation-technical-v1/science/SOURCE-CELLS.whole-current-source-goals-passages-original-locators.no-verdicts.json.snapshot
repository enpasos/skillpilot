      "wholeCurrentSourceGoal": {
        "id": "rp-chem-seki-rp-ch-seki-2014-tf11-stoffe-im-fokus-von-umwelt-und-klima-001-fccbcb59",
        "passageId": "rp-chemistry-seki:tf11-stoffe-im-fokus-von-umwelt-und-klima",
        "topicCode": "TF11-STOFFE-IM-FOKUS-VON-UMWELT-UND-KLIMA",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "erschließen den Kohlenstoffkreislauf durch Experimente, Auswertung von Daten und unter Nutzung anderer Quellen",
        "description": "Die lernende Person kann erschließen den Kohlenstoffkreislauf durch Experimente, Auswertung von Daten und unter Nutzung anderer Quellen.",
        "sourceText": "erschließen den Kohlenstoffkreislauf durch Experimente, Auswertung von Daten und unter Nutzung anderer Quellen,",
        "sourceSpan": "Themenfeld 11: Stoffe im Fokus von Umwelt und Klima, Source-Ziel 1",
        "parentBulletText": "erschließen den Kohlenstoffkreislauf durch Experimente, Auswertung von Daten und unter Nutzung anderer Quellen,",
        "sourceRef": "RP-CH-SEKI-2014 S. 88",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-RP",
          "stage:SekI",
          "topic:tf11-stoffe-im-fokus-von-umwelt-und-klima",
          "courseLevel:GK_LK"
        ],
        "rawSourceText": "erschließen den Kohlenstoffkreislauf durch Experimente, Auswertung von Daten und unter Nutzung anderer Quellen,",
        "rawSourceSpan": "Themenfeld 11: Stoffe im Fokus von Umwelt und Klima, Source-Ziel 1",
        "rawParentBulletText": "erschließen den Kohlenstoffkreislauf durch Experimente, Auswertung von Daten und unter Nutzung anderer Quellen,"
      },
      "wholeOriginalPassage": {
        "id": "rp-chemistry-seki:tf11-stoffe-im-fokus-von-umwelt-und-klima",
        "topicCode": "TF11-STOFFE-IM-FOKUS-VON-UMWELT-UND-KLIMA",
        "title": "Themenfeld 11: Stoffe im Fokus von Umwelt und Klima",
        "text": "- erschließen den Kohlenstoffkreislauf durch Experimente, Auswertung von Daten und unter Nutzung anderer Quellen,\n- stellen den globalen Kohlenstoffkreislauf als ein System chemischer Reaktionen dar,\n- erstellen Regelkreisschemata, um Folgen von natürlichen und anthropogenen Einflüssen auf den Kohlenstoffdioxidkreislauf abzuschätzen (Modellierung),\n- unterscheiden modellierte Daten von Messdaten und beurteilen deren Aussagekraft,\n- wenden Dimensionen der Nachhaltigkeit (Ökologie, Ökonomie, Soziales) an, um die Einflüsse auf den Kohlenstoffkreislauf zu bewerten.\n- zentrale Basiskonzepte und Fachbegriffe des Themenfeldes fachsprachlich verwenden: Fachbegriffe: Auf der Stoffebene: Wasserdampf, Kohlenstoffdioxid und Methan sind wichtige Natürlicher und anthropogeklimawirksame Gase, die in der Atmosphäre mit Strahlung ner Treibhauseffekt wechselwirken. (SEF, WW) Der Kohlenstoffkreislauf ist ein komplexes System chemiKohlenstoffkreislauf scher Reaktionen. Absorption, Emission Kohlenstoffsenke Dieses System wird durch natürliche und anthropogene Faktoren beeinflusst und stellt sich auf die veränderten Bedingungen neu ein. (CR) Bei der Verbrennung fossiler Brennstoffe wird Energie an Fossile und regenerative die Umgebung abgegeben. Energieträger Der Energieträgerwechsel (Energieabgabe) wird erkennbar Dynamisches Modell an Erwärmung, Bewegung bzw. Licht. (E) Modellierung 86",
        "page": 88,
        "sourcePath": "curricula/DE/Gymnasium/input/RP/Chemie_Sekundarstufe_I_Biologie_Physik_Chemie_2014.pdf",

      "wholeOriginalPassage": {
        "id": "de-nw-chemie-seki-klp-2019:Stufe2-7-chemische-reaktionen-durch-elektronenubertragung-umgang-mit-fachwissen",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKI-2019",
        "topicCode": "Stufe2-7-chemische-reaktionen-durch-elektronenubertragung-umgang-mit-fachwissen",
        "title": "Zweite Stufe: 7: Chemische Reaktionen durch Elektronenübertragung / Umgang mit Fachwissen",
        "page": 30,
        "rawText": "- die Abgabe von Elektronen als Oxidation einordnen\n- die Aufnahme von Elektronen als Reduktion einordnen\n- Reaktionen zwischen Metallatomen und Metallionen als Elektronenübertragungsreaktionen deuten und diese auch mithilfe digitaler Animationen und Teilgleichungen erläutern\n- die chemischen Prozesse eines galvanischen Elements und einer Elektrolyse unter dem Aspekt der Umwandlung in Stoffen gespeicherter Energie in elektrische Energie und umgekehrt erläutern\n- den grundlegenden Aufbau und die Funktionsweise einer Batterie, eines Akkumulators und einer Brennstoffzelle beschreiben",
        "sourceGoalIds": [
          "de-nw-chemie-seki-klp-2019-Stufe2-7-chemische-reaktionen-durch-elektronenubertragung-umgang-mit-fachwissen-001-86178f85",

      },
      "wholeCurrentSourceGoal": {
        "id": "bb-chemistry-sekii-rlp-3-1-6-inhalte-003-0504d3ec",
        "passageId": "bb-chemistry-sekii-rlp-3-1-6",
        "topicCode": "3.1.6",
        "topicTitle": "Angewandte organische Chemie – Waschmittel",
        "category": "Inhalte",
        "title": "Eigenschaften der Tenside (u. a. Grenzflächenaktivität, Micellenbildung, Dispergiervermögen, Schaumbildung)",
        "description": "Die lernende Person kann Eigenschaften der Tenside (u. a. Grenzflächenaktivität, Micellenbildung, Dispergiervermögen, Schaumbildung) fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",

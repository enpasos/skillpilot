      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:GK-reaktionswege-in-der-organischen-chemie-sachkompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "GK-reaktionswege-in-der-organischen-chemie-sachkompetenz",
        "title": "Qualifikationsphase Grundkurs: Reaktionswege in der organischen Chemie / Sachkompetenz",
        "page": 42,
        "rawText": "- stellen den Aufbau von Vertretern der Stoffklassen der Alkane, Halogenalkane, Alkene, Alkine, Alkanole, Alkanale, Alkanone, Carbonsäuren, Ester und Amine auch mit digitalen Werkzeugen dar und berücksichtigen dabei auch ausgewählte Isomere\n- erläutern den Aufbau und die Eigenschaften von gesättigten und ungesättigten Fetten\n- erklären Stoffeigenschaften und Reaktionsverhalten mit dem Einfluss der jeweiligen funktionellen Gruppen unter Berücksichtigung von interund intramolekularen Wechselwirkungen\n- erklären Redoxreaktionen in organischen Synthesewegen unter Berücksichtigung der Oxidationszahlen\n- erklären die Estersynthese aus Alkanolen und Carbonsäuren unter Berücksichtigung der Katalyse\n- erläutern die Reaktionsmechanismen der radikalischen Substitutionsund elektrophilen Additionsreaktion unter Berücksichtigung der spezifischen Reaktionsbedingungen auch mit digitalen Werkzeugen",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-GK-reaktionswege-in-der-organischen-chemie-sachkompetenz-001-3533be08",

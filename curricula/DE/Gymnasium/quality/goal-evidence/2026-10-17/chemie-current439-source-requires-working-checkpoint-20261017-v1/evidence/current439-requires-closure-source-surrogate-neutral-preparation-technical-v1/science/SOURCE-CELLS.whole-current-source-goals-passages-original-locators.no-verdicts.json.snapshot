        "passageId": "mv-chemistry-sekii:q-thermodynamik",
        "topicCode": "Q-THERMODYNAMIK",
        "bulletIndex": 41,
        "aspectIndex": 1,
        "title": "Effizienz verschiedener Brennstoffe unter ökonomischen und ökologischen Gesichtspunkten beurteilen",
        "description": "Die lernende Person kann Effizienz verschiedener Brennstoffe unter ökonomischen und ökologischen Gesichtspunkten beurteilen.",
        "sourceText": "Effizienz verschiedener Brennstoffe unter ökonomischen und ökologischen Gesichtspunkten beurteilen",

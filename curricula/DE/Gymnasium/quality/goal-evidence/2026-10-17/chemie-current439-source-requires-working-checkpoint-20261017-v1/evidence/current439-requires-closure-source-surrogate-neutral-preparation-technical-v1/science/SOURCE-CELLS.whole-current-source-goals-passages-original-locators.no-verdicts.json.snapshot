      "wholeCurrentSourceGoal": {
        "id": "th-chem-seki-th-ch-seki-2-2-1-1-kohlenwasserstoffe-108-02-60bcf35a",
        "passageId": "th-chemistry-seki:th-ch-seki-2-2-1-1-kohlenwasserstoffe",
        "topicCode": "TH-CH-SekI-2.2.1.1-kohlenwasserstoffe",
        "bulletIndex": 108,
        "aspectIndex": 2,
        "title": "die Merkmale der homologen Reihe auf die n-Alkane anwenden: Erweiterung um „CH2“-Molekülgruppe",
        "description": "Die lernende Person kann die Merkmale der homologen Reihe auf die n-Alkane anwenden: Erweiterung um „CH2“-Molekülgruppe.",
        "sourceText": "die Merkmale der homologen Reihe auf die n-Alkane anwenden: Erweiterung um „CH2“-Molekülgruppe",
        "sourceSpan": "Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Kohlenwasserstoffe, PDF-S. 26",
        "parentBulletText": "die Merkmale der homologen Reihe auf die n-Alkane anwenden:",
        "sourceRef": "Lehrplan Gymnasium Chemie Thueringen 2024, Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Kohlenwasserstoffe, PDF-S. 26",
        "courseLevel": "GK_LK",
        "granularity": "officialCompetencyAspect",
        "tags": [
          "source:thueringen",
          "subject:Chemie",
          "stage:SekI",

      "wholeCurrentSourceGoal": {
        "id": "be-chemistry-sekii-rlp-3-2-9-inhalte-005-681e2e5c",
        "passageId": "be-chemistry-sekii-rlp-3-2-9",
        "topicCode": "3.2.9",
        "topicTitle": "Elektrochemie",
        "category": "Inhalte",
        "title": "Arten elektrochemischer Spannungsquellen (Primär-, Sekundärelement und Brennstoffzelle)",
        "description": "Die lernende Person kann Arten elektrochemischer Spannungsquellen (Primär-, Sekundärelement und Brennstoffzelle) fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.2.9 Elektrochemie, S. 53.",
        "sourceText": "Arten elektrochemischer Spannungsquellen (Primär-, Sekundärelement und Brennstoffzelle)",
        "sourceSpan": {

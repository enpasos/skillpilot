      "wholeCurrentSourceGoal": {
        "id": "be-chemistry-sekii-rlp-3-1-4-inhalte-011-4f8f456d",
        "passageId": "be-chemistry-sekii-rlp-3-1-4",
        "topicCode": "3.1.4",
        "topicTitle": "Grundlagen der organischen Chemie",
        "category": "Inhalte",
        "title": "Isopren und Terpene – Inhaltsstoffe von Naturstoffgemischen (Bau, Einteilung und Eigenschaften)",
        "description": "Die lernende Person kann Isopren und Terpene – Inhaltsstoffe von Naturstoffgemischen (Bau, Einteilung und Eigenschaften) fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.1.4 Grundlagen der organischen Chemie, S. 21.",
        "sourceText": "Isopren und Terpene – Inhaltsstoffe von Naturstoffgemischen (Bau, Einteilung und Eigenschaften)",
        "sourceSpan": {
          "passageId": "be-chemistry-sekii-rlp-3-1-4",
          "label": "Inhalte: Isopren und Terpene – Inhaltsstoffe von Naturstoffgemischen (Bau, Einteilung und Eigenschaften)"
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-BE",
          "stage:SekII",
          "topic:3.1.4",
          "category:Inhalte"

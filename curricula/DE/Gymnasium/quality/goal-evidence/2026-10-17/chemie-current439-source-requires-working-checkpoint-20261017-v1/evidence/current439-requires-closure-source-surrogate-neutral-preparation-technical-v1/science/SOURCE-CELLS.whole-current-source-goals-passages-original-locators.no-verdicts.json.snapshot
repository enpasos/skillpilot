        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-HH",
          "stage:SekI",
          "section:3-1-uf-j10",
          "courseLevel:unspecified"
        ],
        "metadata": {
          "extractionMethod": "manual-transcription-from-official-hamburg-pdf-passages",
          "sectionCode": "3.1-UF-J10"
        }
      },
      "wholeOriginalPassage": {
        "id": "de-hh-chemie-seki-bildungsplan-2014-2018:3-1-uf-j10",
        "sourceDocumentKey": "HH-CHEMIE-GYM-SEKI",
        "topicCode": "3.1-UF-J10",
        "title": "3.1-UF-J10 Umgang mit Fachwissen fuer den Uebergang in die Studienstufe",
        "page": 19,
        "rawText": "- bedeutsame anorganische und organische Stoffe mit ihren typischen Eigenschaften nennen und beschreiben\n- die Vielfalt der Stoffe auf der Basis unterschiedlicher Kombinationen und Anordnungen von Teilchen erklaeren\n- aus Stoffeigenschaften auf Verwendungsmöglichkeiten sowie damit verbundene Vor- und Nachteile schliessen\n- die Umkehrbarkeit chemischer Reaktionen beschreiben\n- Stoff- und Energieumwandlungen hinsichtlich Teilchenveraenderung und Umbau chemischer Bindungen deuten\n- die Beeinflussbarkeit chemischer Reaktionen durch Katalysatoren beschreiben\n- den Bau von Atomen mithilfe geeigneter differenzierter Atommodelle beschreiben\n- Bindungsmodelle zur Interpretation von Molekuelen, Gittern, raeumlichen Strukturen und zwischenmolekularen Wechselwirkungen verwenden\n- Ordnungsprinzipien fuer Stoffe mit Eigenschaften oder charakteristischen Merkmalen der Teilchenzusammensetzung und -struktur beschreiben und begruenden\n- Reaktionsschemata und Reaktionsgleichungen mit Atom-Erhaltung und konstanten Atomzahlenverhaeltnissen erstellen\n- in ausgewaehlten Donator-Akzeptor-Reaktionen die Teilchenuebertragung kennzeichnen und die Reaktionsart bestimmen\n- Möglichkeiten der Steuerung chemischer Reaktionen durch Variation von Reaktionsbedingungen beschreiben\n- angeben, dass sich bei chemischen Reaktionen der Energieinhalt des Reaktionssystems durch Austausch mit der Umgebung veraendert\n- energetische Erscheinungen bei chemischen Reaktionen auf die Umwandlung gespeicherter Energie in andere Energieformen zurueckfuehren",
        "sourceGoalIds": [
          "de-hh-chemie-seki-bildungsplan-2014-2018-3-1-uf-j10-008-693924f7",
          "de-hh-chemie-seki-bildungsplan-2014-2018-3-1-uf-j10-009-726a1279",

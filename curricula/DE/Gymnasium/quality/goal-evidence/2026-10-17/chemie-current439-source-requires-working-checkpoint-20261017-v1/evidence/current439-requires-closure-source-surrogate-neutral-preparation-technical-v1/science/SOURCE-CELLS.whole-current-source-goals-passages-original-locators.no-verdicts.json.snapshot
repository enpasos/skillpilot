      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-sekii-kc2022-q-energie-1-kompetenz-007-33124cde",
        "passageId": "ni-chemistry-sekii-kc2022-q-energie-1",
        "topicCode": "Q-ENERGIE-1",
        "topicTitle": "Energetische und kinetische Aspekte chemischer Reaktionen",
        "category": "Kompetenz",
        "title": "führen Experimente zur Ermittlung von Reaktionsenthalpien in einfachen Kalorimetern durch und reflektieren ihre Ergebnisse.",
        "description": "Die lernende Person kann führen Experimente zur Ermittlung von Reaktionsenthalpien in einfachen Kalorimetern durch und reflektieren ihre Ergebnisse..",
        "sourceDocumentKey": "NI-KC-CHEMIE-SEKII-2022",

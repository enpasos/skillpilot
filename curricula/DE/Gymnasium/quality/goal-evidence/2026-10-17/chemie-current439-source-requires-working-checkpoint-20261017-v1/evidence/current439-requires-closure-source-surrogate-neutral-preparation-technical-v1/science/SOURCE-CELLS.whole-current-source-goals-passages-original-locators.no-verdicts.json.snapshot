      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-sekii-kc2022-q-protolyse-1-kompetenz-013-53ff35b2",
        "passageId": "ni-chemistry-sekii-kc2022-q-protolyse-1",
        "topicCode": "Q-PROTOLYSE-1",
        "topicTitle": "Protonenübertragungsreaktionen",
        "category": "Kompetenz",
        "title": "beschreiben den historischen Weg der Entwicklung des Säure-Base-Begriffs bis Brönsted.",
        "description": "Die lernende Person kann beschreiben den historischen Weg der Entwicklung des Säure-Base-Begriffs bis Brönsted..",
        "sourceDocumentKey": "NI-KC-CHEMIE-SEKII-2022",
        "sourceRef": "Niedersachsen Kerncurriculum Chemie gymnasiale Oberstufe 2022, Protonenübertragungsreaktionen, S. 21.",
        "sourceText": "beschreiben den historischen Weg der Entwicklung des Säure-Base-Begriffs bis Brönsted.",
        "sourceSpan": {
          "passageId": "ni-chemistry-sekii-kc2022-q-protolyse-1",
          "label": "Kompetenz: beschreiben den historischen Weg der Entwicklung des Säure-Base-Begriffs bis Brönsted."
        },
        "courseLevel": "GK_LK",
        "tags": [

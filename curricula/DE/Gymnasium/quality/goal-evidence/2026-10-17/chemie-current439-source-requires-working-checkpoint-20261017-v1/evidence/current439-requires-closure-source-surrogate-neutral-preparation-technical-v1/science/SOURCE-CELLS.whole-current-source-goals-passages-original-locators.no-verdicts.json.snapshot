      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:GK-elektrochemische-prozesse-und-energetik-bewertungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "GK-elektrochemische-prozesse-und-energetik-bewertungskompetenz",
        "title": "Qualifikationsphase Grundkurs: Elektrochemische Prozesse und Energetik / Bewertungskompetenz",
        "page": 41,
        "rawText": "- bewerten die Verbrennung fossiler Energieträger und elektrochemische Energiewandler hinsichtlich Effizienz und Nachhaltigkeit auch mithilfe von recherchierten thermodynamischen Daten\n- diskutieren Möglichkeiten und Grenzen bei der Umwandlung, Speicherung und Nutzung elektrischer Energie auf Grundlage der relevanten chemischen und thermodynamischen Aspekte im Hinblick auf nachhaltiges Handeln\n- beurteilen Folgen von Korrosionsvorgängen und adäquate Korrosionsschutzmaßnahmen unter ökologischen und ökonomischen Aspekten",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-GK-elektrochemische-prozesse-und-energetik-bewertungskompetenz-001-d2b24d55",

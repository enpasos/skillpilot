      "wholeCurrentSourceGoal": {
        "id": "de-sh-chemie-seki-fachanforderungen-2022-2-2-1-stoff-teilchen-konzept-002-a1670c10",
        "passageId": "de-sh-chemie-seki-fachanforderungen-2022:2-2-1-stoff-teilchen-konzept",

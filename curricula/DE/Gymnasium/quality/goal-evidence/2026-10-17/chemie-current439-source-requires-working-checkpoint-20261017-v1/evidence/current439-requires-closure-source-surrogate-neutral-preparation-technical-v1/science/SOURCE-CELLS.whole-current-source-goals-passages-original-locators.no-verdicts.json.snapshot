      "wholeCurrentSourceGoal": {
        "id": "sl-chem-seki-sl-ch-seki-8-2024-p026-005-69ccb1a9",
        "passageId": "sl-chemistry-seki:sl-ch-seki-8-2024:p026",
        "topicCode": "SL-CH-SEKI-8-2024-P026",
        "bulletIndex": 5,
        "aspectIndex": 1,
        "title": "berechnen die mittlere Atommasse von Elementen",
        "description": "Die lernende Person kann berechnen die mittlere Atommasse von Elementen.",
        "sourceText": "berechnen die mittlere Atommasse von Elementen,",
        "sourceSpan": "Klasse 8, S. 26, Source-Ziel 5",
        "parentBulletText": "berechnen die mittlere Atommasse von Elementen,",
        "sourceRef": "SL-CH-SEKI-8-2024 S. 26",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",

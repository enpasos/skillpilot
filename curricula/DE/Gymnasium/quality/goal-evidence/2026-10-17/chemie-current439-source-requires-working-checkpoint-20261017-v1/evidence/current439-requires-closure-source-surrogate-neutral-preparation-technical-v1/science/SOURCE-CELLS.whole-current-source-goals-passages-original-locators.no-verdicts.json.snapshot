      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:GK-sauren-basen-und-analytische-verfahren-erkenntnisgewinnungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "GK-sauren-basen-und-analytische-verfahren-erkenntnisgewinnungskompetenz",
        "title": "Qualifikationsphase Grundkurs: Säuren, Basen und analytische Verfahren / Erkenntnisgewinnungskompetenz",
        "page": 38,
        "rawText": "- weisen ausgewählte Ionensorten (Halogenid-Ionen, Ammonium-Ionen, Carbonat-Ionen) salzartiger Verbindungen qualitativ nach\n- planen hypothesengeleitet Experimente zur Konzentrationsbestimmung von Säuren und Basen auch in Alltagsprodukten\n- führen das Verfahren einer Säure-Base-Titration mit Endpunktbestimmung mittels Indikator am Beispiel starker Säuren und Basen durch und werten die Ergebnisse auch unter Berücksichtigung einer Fehleranalyse aus\n- bestimmen die Reaktionsenthalpie der Neutralisationsreaktion von starken Säuren mit starken Basen kalorimetrisch und vergleichen das Ergebnis mit Literaturdaten",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-GK-sauren-basen-und-analytische-verfahren-erkenntnisgewinnungskompetenz-001-267cfa72",

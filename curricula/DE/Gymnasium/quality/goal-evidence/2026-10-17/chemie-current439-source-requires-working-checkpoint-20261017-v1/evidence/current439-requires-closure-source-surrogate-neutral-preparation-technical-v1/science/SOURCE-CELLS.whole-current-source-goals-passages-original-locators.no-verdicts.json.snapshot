    {
      "cellId": "7995e414-2401-5987-89e8-f4dfd816bd68::rp-chem-sekii-rp-ch-sekii-2022-baustein-1-5-006-47af77da",
      "sourceFieldProvenance": {
        "filePin": {
          "path": "/mnt/e/skillpilot-chemie-L7-20261017/current439-remediation14-guarded-root-integration-technical-v1/capsule/curricula/DE/Gymnasium/input/RP/upper-secondary/source-extraction/DE_RP_CHEMIE_SEKII_MSS_2022.source-extraction.json",
          "sha256": "e202e20ded05a702974c9b7c38eee58ab90ddab7b98745da9f5605e7cadde13d",
          "bytes": 511705
        },
        "sourceGoalPointer": "/sourceGoals/25",
        "sourceGoalFieldCanonicalSHA256": "0509a5b1e486b035fe53c0b470d300a7a0cdb13be73d5a07598c807b7260de27",
        "wholePassagePointer": "/passages/5"
      },
      "wholeCurrentSourceGoal": {
        "id": "rp-chem-sekii-rp-ch-sekii-2022-baustein-1-5-006-47af77da",
        "passageId": "rp-chemistry-sekii:baustein-1-5",
        "topicCode": "BAUSTEIN-1-5",
        "bulletIndex": 6,
        "aspectIndex": 1,
        "title": "Fällungstitration (z. B. Argentometrie)",
        "description": "Die lernende Person kann fällungstitration (z. B. Argentometrie).",
        "sourceText": "Fällungstitration (z. B. Argentometrie)",
        "sourceSpan": "1.5 Spektroskopie, Source-Ziel 6",
        "parentBulletText": "Fällungstitration (z. B. Argentometrie)",
        "sourceRef": "RP-CH-SEKII-2022 S. 26",
        "courseLevel": "LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-RP",
          "stage:SekII",
          "topic:baustein-1-5",
          "courseLevel:LK"
        ],
        "rawSourceText": "Fällungstitration (z. B. Argentometrie)",
        "rawSourceSpan": "1.5 Spektroskopie, Source-Ziel 6",
        "rawParentBulletText": "Fällungstitration (z. B. Argentometrie)"
      },
      "wholeOriginalPassage": {
        "id": "rp-chemistry-sekii:baustein-1-5",
        "topicCode": "BAUSTEIN-1-5",
        "title": "1.5 Spektroskopie",
        "text": "- Grundlagen:; elektromagnetische Strahlung (Zusammenhang zwischen Wellenlänge und Energie, elektromagnetisches Spektrum); Wechselwirkung zwischen Strahlung und Materie (Elektronenanregung); Absorption, Emission, Transmission, Reflektion, Spektren\n- Fotometrie (UV/VIS-Spektroskopie):; Fotometer (Aufbau und Funktion), Elektronenanregungen, Extinktion (E) als Absorptionsmaß; einfache Spektrenauswertung (z. B. zur Bestimmung von λmax ); einfache Konzentrationsbestimmung (z. B. durch graphische Auswertung einer Kalibriergeraden)\n- Fotometrie (UV/VIS-Spektroskopie): Lambert-Beer‘sches Gesetz\n- Ableitung von Strukturen organischer Moleküle auf Basis zusammengehöriger Spektrensätze\n- Atomabsorptionsund Atomemissionsspektroskopie\n- Fällungstitration (z. B. Argentometrie)\n- Gegenüberstellung halbquantitativer und quantitativer Analysen von Ionen, Nachweisgrenzen\n- Gravimetrie\n- Infrarotspektroskopie: Spektrometer (Aufbau und Funktion), Wechselwirkung zwischen Strahlung und Materie (Molekülschwingungsanregungen …), Spektrenauswertung\n- Kernmagnetische Resonanzspektroskopie (NMR): Spektrometer (Aufbau und Funktion), Wechselwirkung zwischen Strahlung und Materie (Kernspinanregungen, Beschränkung auf 1 H-NMR und 13 C-NMR), Spektrenauswertung\n- Komplexometrie (Komplexone, Metallindikatoren)  Komplexchemie II (9.2)\n- Konduktometrie\n- Kopplung von Massenspektrometrie und Gaschromatografie bzw. Spektroskopie\n- Polarimetrie: Polarimeter (Aufbau und Funktion), optische Aktivität, Drehwinkel  Makromoleküle I − Kohlenhydrate (11)  Makromoleküle II – Proteine (12)\n- Trennung von Stoffgemischen zur quantitativen Reinstoffgewinnung (präparative Chromatografie)",
        "page": 26,
        "sourcePath": "curricula/DE/Gymnasium/input/RP/Chemie_Sekundarstufe_II_MSS_2022.pdf",

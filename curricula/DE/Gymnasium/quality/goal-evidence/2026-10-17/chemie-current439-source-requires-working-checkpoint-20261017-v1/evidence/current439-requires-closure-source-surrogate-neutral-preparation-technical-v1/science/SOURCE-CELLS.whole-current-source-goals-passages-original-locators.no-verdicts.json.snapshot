      "wholeCurrentSourceGoal": {
        "id": "th-chem-seki-th-ch-seki-2-2-1-1-kohlenwasserstoffe-112-01-db0f8a17",
        "passageId": "th-chemistry-seki:th-ch-seki-2-2-1-1-kohlenwasserstoffe",
        "topicCode": "TH-CH-SekI-2.2.1.1-kohlenwasserstoffe",
        "bulletIndex": 112,
        "aspectIndex": 1,
        "title": "n-Alkane bis n-Decan und verzweigte Alkane benennen und dabei die NomenklaturRegeln nach IUPAC anwenden",
        "description": "Die lernende Person kann n-Alkane bis n-Decan und verzweigte Alkane benennen und dabei die NomenklaturRegeln nach IUPAC anwenden.",
        "sourceText": "n-Alkane bis n-Decan und verzweigte Alkane benennen und dabei die NomenklaturRegeln nach IUPAC anwenden",
        "sourceSpan": "Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Kohlenwasserstoffe, PDF-S. 27",
        "parentBulletText": "n-Alkane bis n-Decan und verzweigte Alkane benennen und dabei die NomenklaturRegeln nach IUPAC anwenden",
        "sourceRef": "Lehrplan Gymnasium Chemie Thueringen 2024, Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Kohlenwasserstoffe, PDF-S. 27",
        "courseLevel": "GK_LK",
        "granularity": "officialCompetencyRow",
        "tags": [
          "source:thueringen",
          "subject:Chemie",
          "stage:SekI",
          "section:2.2.1.1",

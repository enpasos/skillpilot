      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-nw-2024-p019-010-97cb5e8a",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p019",

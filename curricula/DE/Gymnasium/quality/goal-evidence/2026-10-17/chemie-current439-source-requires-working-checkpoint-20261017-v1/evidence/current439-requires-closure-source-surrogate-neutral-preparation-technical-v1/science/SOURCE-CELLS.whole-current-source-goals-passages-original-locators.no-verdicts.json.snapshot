      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p025",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P025",
        "title": "Einführungsphase NW-Zweig: Kompetenzpassage S. 25",
        "text": "- nennen die radikalische Substitution als charakteristischen Reaktionsmechanismus der Alkane,\n- formulieren die Reaktionsgleichung für die Reaktion eines Alkans mit einem Halogen,\n- geben die Reaktionsbedingungen für die radikalische Substitution an,\n- stellen den Reaktionsmechanismus für die radikalische Substitution von einem Halogen an ein Alkan mithilfe von Strukturformeln dar und erklären diesen unter Verwendung der Fachsprache,\n- bewerten unter dem Aspekt der Nachhaltigkeit das Verbot bestimmter halogenierter Alkane.",
        "page": 25,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Einfuehrungsphase_naturwissenschaftlicher_Zweig_2024.pdf",
        "sourceGoalIds": [
          "sl-chem-sekii-sl-ch-sekii-ep-nw-2024-p025-001-3710d69a",

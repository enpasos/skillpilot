      "wholeCurrentSourceGoal": {
        "id": "rp-chem-sekii-rp-ch-sekii-2022-baustein-3-3-001-8d6493bf",
        "passageId": "rp-chemistry-sekii:baustein-3-3",
        "topicCode": "BAUSTEIN-3-3",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "Esterbildung (Kondensation): Ester-Synthese am Beispiel der Carbonsäurealkylester, Vorkommen, Verwendung, Nomenklatur",
        "description": "Die lernende Person kann esterbildung (Kondensation): Ester-Synthese am Beispiel der Carbonsäurealkylester, Vorkommen, Verwendung, Nomenklatur.",
        "sourceText": "Esterbildung (Kondensation): Ester-Synthese am Beispiel der Carbonsäurealkylester, Vorkommen, Verwendung, Nomenklatur",
        "sourceSpan": "3.3 Esterbildung und Esterspaltung, Source-Ziel 1",
        "parentBulletText": "Esterbildung (Kondensation): Ester-Synthese am Beispiel der Carbonsäurealkylester, Vorkommen, Verwendung, Nomenklatur",
        "sourceRef": "RP-CH-SEKII-2022 S. 21",
        "courseLevel": "LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-RP",
          "stage:SekII",
          "topic:baustein-3-3",
          "courseLevel:LK"
        ],
        "rawSourceText": "Esterbildung (Kondensation): Ester-Synthese am Beispiel der Carbonsäurealkylester, Vorkommen, Verwendung, Nomenklatur",
        "rawSourceSpan": "3.3 Esterbildung und Esterspaltung, Source-Ziel 1",
        "rawParentBulletText": "Esterbildung (Kondensation): Ester-Synthese am Beispiel der Carbonsäurealkylester, Vorkommen, Verwendung, Nomenklatur"
      },
      "wholeOriginalPassage": {
        "id": "rp-chemistry-sekii:baustein-3-3",
        "topicCode": "BAUSTEIN-3-3",
        "title": "3.3 Esterbildung und Esterspaltung",
        "text": "- Esterbildung (Kondensation): Ester-Synthese am Beispiel der Carbonsäurealkylester, Vorkommen, Verwendung, Nomenklatur\n- Reaktionsmechanismus der nukleophilen Substitution (Additions-Eliminierungs-Mechanismus)\n- Reaktionsmechanismus der sauren und alkalischen Hydrolyse z. B.; Biodieselherstellung (Umesterung)  Lipide (10.2); Seifenherstellung (Verseifung)  Lipide (10.2),Tenside (16); biologisch abbaubare Polyester,  ökologisch-ökonomische Betrachtungen bei Kunststoffen (13.4); …\n- Bildung von; Aldolen (nukleophile Addition); Iminen, Oximen, Hydrazonen (nukleophile Substitution)\n- Carbonsäurederivate, weitere mögliche Beispiele; Carbonsäureamide  Makromoleküle II – III (Proteine (12), Kunststoffe (13)); Carbonsäureanhydride  Arzneimittelforschung (2.3); Carbonsäurechloride  bei Kunststoffen Syntheseverfahren (13.1), Struktur und Eigenschaften (13.2)\n- Einfluss der Carbonylaktivität auf die Reaktionsgeschwindigkeit und Gleichgewichtslage  Energetik (5) und Gleichgewicht und Kinetik (7)\n- Ester anorganischer Säuren (z. B. Phosphorsäure-, Schwefelsäureund Salpetersäureester)\n- Identifizierung der Carbonyl-Gruppe mittels IR-Spektroskopie  Analytik (1)\n- Paracetamol, Aspirin®  Arzneimittel (2)",
        "page": 21,
        "sourcePath": "curricula/DE/Gymnasium/input/RP/Chemie_Sekundarstufe_II_MSS_2022.pdf",
        "sourceGoalIds": [
          "rp-chem-sekii-rp-ch-sekii-2022-baustein-3-3-001-8d6493bf",

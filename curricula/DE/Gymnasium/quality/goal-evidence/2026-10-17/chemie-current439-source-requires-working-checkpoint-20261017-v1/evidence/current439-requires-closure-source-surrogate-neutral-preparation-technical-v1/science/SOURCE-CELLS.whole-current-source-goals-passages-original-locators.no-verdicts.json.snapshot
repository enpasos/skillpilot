      "wholeCurrentSourceGoal": {
        "id": "de-nw-chemie-seki-klp-2019-Stufe2-9-saure-und-alkalische-losungen-erkenntnisgewinnung-001-dc9e3375",
        "passageId": "de-nw-chemie-seki-klp-2019:Stufe2-9-saure-und-alkalische-losungen-erkenntnisgewinnung",
        "topicCode": "Stufe2-9-saure-und-alkalische-losungen-erkenntnisgewinnung",
        "title": "charakteristische Eigenschaften von sauren Lösungen (elektrische Leitfähigkeit, Reaktionen mit Metallen, Reaktionen mit Kalk) und alkalischen Lösungen ermitteln und auch unter Angabe von Reaktionsgleichungen erläutern",
        "description": "Die lernende Person kann charakteristische Eigenschaften von sauren Lösungen (elektrische Leitfähigkeit, Reaktionen mit Metallen, Reaktionen mit Kalk) und alkalischen Lösungen ermitteln und auch unter Angabe von Reaktionsgleichungen erläutern.",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKI-2019",
        "sourceRef": "Nordrhein-Westfalen Kernlehrplan Chemie Sekundarstufe I Gymnasium 2019, Zweite Stufe, 9: Saure und alkalische Lösungen, Erkenntnisgewinnung, S. 33.",
        "sourceText": "charakteristische Eigenschaften von sauren Lösungen (elektrische Leitfähigkeit, Reaktionen mit Metallen, Reaktionen mit Kalk) und alkalischen Lösungen ermitteln und auch unter Angabe von Reaktionsgleichungen erläutern",
        "sourceSpan": {
          "passageId": "de-nw-chemie-seki-klp-2019:Stufe2-9-saure-und-alkalische-losungen-erkenntnisgewinnung",
          "label": "Zweite Stufe, 9: Saure und alkalische Lösungen, Erkenntnisgewinnung, S. 33: charakteristische Eigenschaften von sauren Lösungen (elektrische Leitfähigkeit, Reaktionen mit Metallen, Reaktionen mit Kalk) und alkalischen Lösungen ermitteln und auch unter Angabe von Reaktionsgleichungen erläutern"
        },
        "courseLevel": "unspecified",

      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-spr-2024-p011-002-a1eaca10",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-spr-2024:p011",
        "topicCode": "SL-CH-SEKII-EP-SPR-2024-P011",
        "bulletIndex": 2,
        "aspectIndex": 1,
        "title": "führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus",
        "description": "Die lernende Person kann führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus.",
        "sourceText": "führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus,",
        "sourceSpan": "Einführungsphase sprachlicher Zweig, S. 11, Source-Ziel 2",
        "parentBulletText": "führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus,",
        "sourceRef": "SL-CH-SEKII-EP-SPR-2024 S. 11",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:GK_LK",
          "sourceDocument:SL-CH-SEKII-EP-SPR-2024",
          "sourcePage:11"
        ],
        "rawSourceText": "führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus,",
        "rawSourceSpan": "Einführungsphase sprachlicher Zweig, S. 11, Source-Ziel 2",
        "rawParentBulletText": "führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-ep-spr-2024:p011",
        "topicCode": "SL-CH-SEKII-EP-SPR-2024-P011",
        "title": "Einführungsphase sprachlicher Zweig: Kompetenzpassage S. 11",
        "text": "- geben für beide Dissoziationsstufen der Kohlensäure die Dissoziationsgleichung an,\n- führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus,\n- geben die Formeln und Namen wichtiger Carbonate und Hydrogencarbonate an: Natriumcarbonat (Soda), Natriumhydrogencarbonat (Natron), Calciumcarbonat (Kalk, Marmor), Calciumhydrogencarbonat,\n- führen ein Experiment zum Nachweis der Carbonate durch und werten dieses mithilfe einer Reaktionsgleichung aus,\n- recherchieren Eigenschaften, Vorkommen, Bedeutung und mögliche weitere Namen wichtiger Salze der Kohlensäure in der Natur und im Alltag und präsentieren ihre Ergebnisse tabellarisch,\n- geben an, dass Hydrogencarbonate alkalisch reagieren,\n- begründen die Verwendung von Hydrogencarbonaten bei Sodbrennen,\n- entwickeln eine Reaktionsgleichung zur Neutralisation der Magensäure (HCl) mit Natriumhydrogencarbonat.",
        "page": 11,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Einfuehrungsphase_sprachlicher_Zweig_2024.pdf",
        "sourceGoalIds": [

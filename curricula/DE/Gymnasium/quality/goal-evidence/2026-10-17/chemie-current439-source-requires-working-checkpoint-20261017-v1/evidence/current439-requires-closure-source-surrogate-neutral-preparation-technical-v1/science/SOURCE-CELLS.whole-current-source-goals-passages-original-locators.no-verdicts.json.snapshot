      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-lk-2023-2025-p075-001-c6a39eb4",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-lk-2023-2025:p075",
        "topicCode": "SL-CH-SEKII-LK-2023-2025-P075",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "stellen den Reaktionsmechanismus für die radikalische Substitution (SR) eines Alkans mit einem Halogen in Strukturformeln dar und erläutern diesen unter Verwendung der Fachsprac...",
        "description": "Die lernende Person kann stellen den Reaktionsmechanismus für die radikalische Substitution (SR) eines Alkans mit einem Halogen in Strukturformeln dar und erläutern diesen unter Verwendung der Fachsprache (Homolyse, Radikal, Kettenstart, Kettenreaktion, Kettenabbruchreaktionen).",
        "sourceText": "stellen den Reaktionsmechanismus für die radikalische Substitution (SR) eines Alkans mit einem Halogen in Strukturformeln dar und erläutern diesen unter Verwendung der Fachsprache (Homolyse, Radikal, Kettenstart, Kettenreaktion, Kettenabbruchreaktionen),",
        "sourceSpan": "Hauptphase Leistungskurs, S. 75, Source-Ziel 1",
        "parentBulletText": "stellen den Reaktionsmechanismus für die radikalische Substitution (SR) eines Alkans mit einem Halogen in Strukturformeln dar und erläutern diesen unter Verwendung der Fachsprache (Homolyse, Radikal, Kettenstart, Kettenreaktion, Kettenabbruchreaktionen),",
        "sourceRef": "SL-CH-SEKII-LK-2023-2025 S. 75",
        "courseLevel": "LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:LK",
          "sourceDocument:SL-CH-SEKII-LK-2023-2025",
          "sourcePage:75"
        ],
        "rawSourceText": "stellen den Reaktionsmechanismus für die radikalische Substitution (SR) eines Alkans mit einem Halogen in Strukturformeln dar und erläutern diesen unter Verwendung der Fachsprache (Homolyse, Radikal, Kettenstart, Kettenreaktion, Kettenabbruchreaktionen),",
        "rawSourceSpan": "Hauptphase Leistungskurs, S. 75, Source-Ziel 1",
        "rawParentBulletText": "stellen den Reaktionsmechanismus für die radikalische Substitution (SR) eines Alkans mit einem Halogen in Strukturformeln dar und erläutern diesen unter Verwendung der Fachsprache (Homolyse, Radikal, Kettenstart, Kettenreaktion, Kettenabbruchreaktionen),"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-lk-2023-2025:p075",
        "topicCode": "SL-CH-SEKII-LK-2023-2025-P075",
        "title": "Hauptphase Leistungskurs: Kompetenzpassage S. 75",
        "text": "- stellen den Reaktionsmechanismus für die radikalische Substitution (SR) eines Alkans mit einem Halogen in Strukturformeln dar und erläutern diesen unter Verwendung der Fachsprache (Homolyse, Radikal, Kettenstart, Kettenreaktion, Kettenabbruchreaktionen),\n- stellen den Reaktionsmechanismus für die nucleophile Substitution SN) eines Halogenalkans mit Hydroxidionen in Strukturformeln dar und erläutern diesen unter Verwendung der Fachsprache,; SN1: Nucleophil, Carbeniumion (Carbokation), Zwischenprodukt, Abgangsgruppe,; SN2: Nucleophil, Übergangszustand, Rückseitenangriff, Abgangsgruppe,\n- stellen den Reaktionsmechanismus für die säurekatalysierte Veresterung eines Alkohols mit einer organischen Säure (SN-Reaktion) in Strukturformeln dar und erläutern diesen unter Verwendung der Fachsprache (Katalysator, Protonierung, Nucleophil, Abspaltung, Deprotonierung).",
        "page": 75,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Leistungskurs_2023_ab_2027_red_2025.pdf",

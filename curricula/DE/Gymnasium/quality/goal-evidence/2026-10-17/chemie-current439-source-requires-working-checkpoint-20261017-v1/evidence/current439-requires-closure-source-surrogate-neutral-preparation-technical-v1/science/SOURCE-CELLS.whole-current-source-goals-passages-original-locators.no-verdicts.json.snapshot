      "wholeOriginalPassage": {
        "id": "de-hh-chemie-sekii-bildungsplan-2022:3-2",
        "sourceDocumentKey": "HH-CHEMIE-GYO-2022",
        "topicCode": "3.2",
        "title": "3.2 Elektrolyse und Korrosion",
        "page": 32,
        "rawText": "- Elektrolyse als erzwungene Redoxreaktion mit Grundprinzip beschreiben\n- Elektrolysen quantitativ mithilfe der Faraday-Gesetze betrachten\n- Prinzip der Ueberspannung beschreiben\n- industrielle Elektrolysen zur Rohstoffgewinnung und -verarbeitung beschreiben\n- Prinzip der Metallkorrosion als Sauerstoffkorrosion beschreiben\n- kathodischen Korrosionsschutz beschreiben",
        "sourceGoalIds": [
          "de-hh-chemie-sekii-bildungsplan-2022-3-2-075-18367477",
          "de-hh-chemie-sekii-bildungsplan-2022-3-2-076-193dae34",

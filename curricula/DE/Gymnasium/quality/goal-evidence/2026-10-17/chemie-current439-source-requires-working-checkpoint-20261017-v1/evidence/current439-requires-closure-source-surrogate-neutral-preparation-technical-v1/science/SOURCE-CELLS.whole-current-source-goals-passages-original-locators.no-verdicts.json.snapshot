      },
      "wholeCurrentSourceGoal": {
        "id": "bw-chem-sekii-3-4-2-b01-a01-cf29d3b8",
        "passageId": "bw-chem-sekii:3.4.2",
        "topicCode": "3.4.2",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "BW 3.4.2 (1): die Umkehrbarkeit einer Reaktion als Voraussetzung für die Einstellung eines Gleichgewichts nenn...",
        "description": "Source-Ziel aus 3.4.2 (1): die Umkehrbarkeit einer Reaktion als Voraussetzung für die Einstellung eines Gleichgewichts nennen",
        "sourceText": "die Umkehrbarkeit einer Reaktion als Voraussetzung für die Einstellung eines Gleichgewichts nennen",
        "sourceSpan": "3.4.2 (1)",
        "parentBulletText": "die Umkehrbarkeit einer Reaktion als Voraussetzung für die Einstellung eines Gleichgewichts nennen",
        "sourceRef": "Bildungsplan 2016 Gymnasium Chemie Baden-Wuerttemberg, 3.4.2 (1), S. 31.",

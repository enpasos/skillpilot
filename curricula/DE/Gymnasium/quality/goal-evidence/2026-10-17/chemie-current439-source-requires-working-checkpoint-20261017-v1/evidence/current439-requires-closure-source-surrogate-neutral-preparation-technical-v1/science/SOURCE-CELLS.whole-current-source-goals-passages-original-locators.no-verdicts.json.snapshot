        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-spr-2024:p014",
        "topicCode": "SL-CH-SEKII-EP-SPR-2024-P014",
        "bulletIndex": 3,
        "aspectIndex": 1,
        "title": "wenden die Valenzstrich-Schreibweise bei Molekülverbindungen an",
        "description": "Die lernende Person kann wenden die Valenzstrich-Schreibweise bei Molekülverbindungen an.",
        "sourceText": "wenden die Valenzstrich-Schreibweise bei Molekülverbindungen an,",
        "sourceSpan": "Einführungsphase sprachlicher Zweig, S. 14, Source-Ziel 3",
        "parentBulletText": "wenden die Valenzstrich-Schreibweise bei Molekülverbindungen an,",
        "sourceRef": "SL-CH-SEKII-EP-SPR-2024 S. 14",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [

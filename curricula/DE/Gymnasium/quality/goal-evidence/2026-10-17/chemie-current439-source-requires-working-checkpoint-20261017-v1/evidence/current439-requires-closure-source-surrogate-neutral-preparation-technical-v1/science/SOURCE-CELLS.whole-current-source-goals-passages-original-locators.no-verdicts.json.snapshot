        "passageId": "sl-chemistry-sekii:sl-ch-sekii-gk-2023-2025:p050",
        "topicCode": "SL-CH-SEKII-GK-2023-2025-P050",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "erklären mit Hilfe der zwischenmolekularen Wechselwirkungen die physikalischen Eigenschaften der Alkohole, Aldehyde, Ketone, Carbonsäuren, Dicarbonsäuren und Carbonsäureester",
        "description": "Die lernende Person kann erklären mit Hilfe der zwischenmolekularen Wechselwirkungen die physikalischen Eigenschaften der Alkohole, Aldehyde, Ketone, Carbonsäuren, Dicarbonsäuren und Carbonsäureester.",
        "sourceText": "erklären mit Hilfe der zwischenmolekularen Wechselwirkungen die physikalischen Eigenschaften der Alkohole, Aldehyde, Ketone, Carbonsäuren, Dicarbonsäuren und Carbonsäureester,",
        "sourceSpan": "Hauptphase Grundkurs, S. 50, Source-Ziel 1",
        "parentBulletText": "erklären mit Hilfe der zwischenmolekularen Wechselwirkungen die physikalischen Eigenschaften der Alkohole, Aldehyde, Ketone, Carbonsäuren, Dicarbonsäuren und Carbonsäureester,",
        "sourceRef": "SL-CH-SEKII-GK-2023-2025 S. 50",
        "courseLevel": "GK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:GK",
          "sourceDocument:SL-CH-SEKII-GK-2023-2025",
          "sourcePage:50"
        ],
        "rawSourceText": "erklären mit Hilfe der zwischenmolekularen Wechselwirkungen die physikalischen Eigenschaften der Alkohole, Aldehyde, Ketone, Carbonsäuren, Dicarbonsäuren und Carbonsäureester,",
        "rawSourceSpan": "Hauptphase Grundkurs, S. 50, Source-Ziel 1",
        "rawParentBulletText": "erklären mit Hilfe der zwischenmolekularen Wechselwirkungen die physikalischen Eigenschaften der Alkohole, Aldehyde, Ketone, Carbonsäuren, Dicarbonsäuren und Carbonsäureester,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-gk-2023-2025:p050",
        "topicCode": "SL-CH-SEKII-GK-2023-2025-P050",
        "title": "Hauptphase Grundkurs: Kompetenzpassage S. 50",
        "text": "- erklären mit Hilfe der zwischenmolekularen Wechselwirkungen die physikalischen Eigenschaften der Alkohole, Aldehyde, Ketone, Carbonsäuren, Dicarbonsäuren und Carbonsäureester,\n- führen einfache Experimente zur Untersuchung des Löslichkeitsverhaltens verschiedener Stoffe dieser Stoffklassen durch und werten diese aus,\n- erstellen einen tabellarischen Überblick über die bisherigen Stoffklassen mit Strukturformel und Benennung der funktionellen Gruppen,\n- nennen Beispiele für höhere Fettsäuren,\n- beschreiben den Molekülbau der natürlich vorkommenden Fette,",
        "page": 50,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Grundkurs_2023_ab_2027_red_2025.pdf",

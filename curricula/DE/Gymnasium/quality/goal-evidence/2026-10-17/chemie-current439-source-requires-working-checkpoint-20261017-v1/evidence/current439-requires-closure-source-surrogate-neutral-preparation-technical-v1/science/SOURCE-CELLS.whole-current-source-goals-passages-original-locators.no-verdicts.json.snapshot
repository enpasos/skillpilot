      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:GK-moderne-werkstoffe-bewertungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "GK-moderne-werkstoffe-bewertungskompetenz",
        "title": "Qualifikationsphase Grundkurs: Moderne Werkstoffe / Bewertungskompetenz",
        "page": 44,
        "rawText": "- bewerten den Einsatz von Erdöl und nachwachsenden Rohstoffen für die Herstellung und die Verwendung von Produkten aus Kunststoffen im Sinne einer nachhaltigen Entwicklung aus ökologischer, ökonomischer und sozialer Perspektive\n- vergleichen anhand von Bewertungskriterien Produkte aus unterschiedlichen Kunststoffen und leiten daraus Handlungsoptionen für die alltägliche Nutzung ab\n- bewerten stoffliche und energetische Verfahren der Kunststoffverwertung unter Berücksichtigung ausgewählter Nachhaltigkeitsziele",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-GK-moderne-werkstoffe-bewertungskompetenz-001-10aec9db",

      "wholeCurrentSourceGoal": {
        "id": "bb-chemistry-sekii-rlp-3-2-5-inhalte-001-427ee278",
        "passageId": "bb-chemistry-sekii-rlp-3-2-5",
        "topicCode": "3.2.5",

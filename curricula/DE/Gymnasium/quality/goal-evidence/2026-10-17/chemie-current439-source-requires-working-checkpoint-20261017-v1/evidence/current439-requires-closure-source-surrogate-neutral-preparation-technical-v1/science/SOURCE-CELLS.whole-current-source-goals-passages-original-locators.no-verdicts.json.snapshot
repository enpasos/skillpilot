      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-nw-2024-p011-008-33d90135",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p011",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P011",
        "bulletIndex": 8,
        "aspectIndex": 1,
        "title": "entwickeln eine Reaktionsgleichung zur Neutralisation der Magensäure (HCl) mit Natriumhydrogencarbonat",
        "description": "Die lernende Person kann entwickeln eine Reaktionsgleichung zur Neutralisation der Magensäure (HCl) mit Natriumhydrogencarbonat.",
        "sourceText": "entwickeln eine Reaktionsgleichung zur Neutralisation der Magensäure (HCl) mit Natriumhydrogencarbonat.",
        "sourceSpan": "Einführungsphase NW-Zweig, S. 11, Source-Ziel 8",
        "parentBulletText": "entwickeln eine Reaktionsgleichung zur Neutralisation der Magensäure (HCl) mit Natriumhydrogencarbonat.",
        "sourceRef": "SL-CH-SEKII-EP-NW-2024 S. 11",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:GK_LK",
          "sourceDocument:SL-CH-SEKII-EP-NW-2024",
          "sourcePage:11"
        ],
        "rawSourceText": "entwickeln eine Reaktionsgleichung zur Neutralisation der Magensäure (HCl) mit Natriumhydrogencarbonat.",
        "rawSourceSpan": "Einführungsphase NW-Zweig, S. 11, Source-Ziel 8",
        "rawParentBulletText": "entwickeln eine Reaktionsgleichung zur Neutralisation der Magensäure (HCl) mit Natriumhydrogencarbonat."
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p011",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P011",
        "title": "Einführungsphase NW-Zweig: Kompetenzpassage S. 11",
        "text": "- geben für beide Dissoziationsstufen der Kohlensäure die Dissoziationsgleichung an,\n- führen ein Experiment zur Wirkung von Säuren auf Kalk durch und werten dieses mithilfe einer Reaktionsgleichung aus,\n- geben die Formeln und Namen wichtiger Carbonate und Hydrogencarbonate an: Natriumcarbonat (Soda), Natriumhydrogencarbonat (Natron), Calciumcarbonat (Kalk, Marmor), Calciumhydrogencarbonat,\n- führen ein Experiment zum Nachweis der Carbonate durch und werten dieses mithilfe einer Reaktionsgleichung aus,\n- recherchieren Eigenschaften, Vorkommen, Bedeutung und mögliche weitere Namen wichtiger Salze der Kohlensäure in der Natur und im Alltag und präsentieren ihre Ergebnisse tabellarisch,\n- geben an, dass Hydrogencarbonate alkalisch reagieren,\n- begründen die Verwendung von Hydrogencarbonaten bei Sodbrennen,\n- entwickeln eine Reaktionsgleichung zur Neutralisation der Magensäure (HCl) mit Natriumhydrogencarbonat.",
        "page": 11,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Einfuehrungsphase_naturwissenschaftlicher_Zweig_2024.pdf",

      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-spr-2024-p021-003-76ce616e",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-spr-2024:p021",
        "topicCode": "SL-CH-SEKII-EP-SPR-2024-P021",
        "bulletIndex": 3,
        "aspectIndex": 1,
        "title": "geben zu vorgegebenen Namen von Alkenen/Alkinen jeweils die Strukturformel an",
        "description": "Die lernende Person kann geben zu vorgegebenen Namen von Alkenen/Alkinen jeweils die Strukturformel an.",
        "sourceText": "geben zu vorgegebenen Namen von Alkenen/Alkinen jeweils die Strukturformel an,",
        "sourceSpan": "Einführungsphase sprachlicher Zweig, S. 21, Source-Ziel 3",
        "parentBulletText": "geben zu vorgegebenen Namen von Alkenen/Alkinen jeweils die Strukturformel an,",
        "sourceRef": "SL-CH-SEKII-EP-SPR-2024 S. 21",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:GK_LK",
          "sourceDocument:SL-CH-SEKII-EP-SPR-2024",
          "sourcePage:21"
        ],
        "rawSourceText": "geben zu vorgegebenen Namen von Alkenen/Alkinen jeweils die Strukturformel an,",
        "rawSourceSpan": "Einführungsphase sprachlicher Zweig, S. 21, Source-Ziel 3",
        "rawParentBulletText": "geben zu vorgegebenen Namen von Alkenen/Alkinen jeweils die Strukturformel an,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-ep-spr-2024:p021",
        "topicCode": "SL-CH-SEKII-EP-SPR-2024-P021",
        "title": "Einführungsphase sprachlicher Zweig: Kompetenzpassage S. 21",
        "text": "- leiten aus der homologen Reihe die allgemeine Summenformel der Alkene/Alkine ab,\n- benennen einfach verzweigte und substituierte Alkene und Alkine nach der IUPACNomenklatur,\n- geben zu vorgegebenen Namen von Alkenen/Alkinen jeweils die Strukturformel an,\n- erstellen einfache Modelle von Gerüstund Stellungsisomeren der Alkene/Alkine mithilfe eines Molekülbaukastens,\n- wenden die IUPAC-Regeln zur Benennung von Gerüstund Stellungsisomeren der Alkene/Alkine an,\n- erkennen am Modell die freie Drehbarkeit um die C-C-Einfachbindung im Gegensatz zur C=C-Doppelbindung,\n- unterscheiden konjugierte, kumulierte und isolierte Doppelbindungen in Alkenen,\n- geben eine Definition für den Begriff cis/trans-Isomerie an,\n- wenden die IUPAC-Regeln zur Benennung von cis/trans-Isomeren an,\n- erklären die Schmelzbzw. Siedetemperaturen der Alkene/Alkine (unpolare organische Verbindungen) mithilfe der zwischenmolekularen Kräfte,\n- erklären die Schmelzbzw. Siedetemperaturen von cis/trans-Isomeren (Z-/E-Isomeren) mithilfe der zwischenmolekularen Kräfte,\n- erklären das Löslichkeitsverhalten der Alkene und Alkine und verwenden dabei die Fachbegriffe hydrophob/hydrophil bzw. lipophob/lipophil bzw. unpolar/polar.",
        "page": 21,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Einfuehrungsphase_sprachlicher_Zweig_2024.pdf",
        "sourceGoalIds": [

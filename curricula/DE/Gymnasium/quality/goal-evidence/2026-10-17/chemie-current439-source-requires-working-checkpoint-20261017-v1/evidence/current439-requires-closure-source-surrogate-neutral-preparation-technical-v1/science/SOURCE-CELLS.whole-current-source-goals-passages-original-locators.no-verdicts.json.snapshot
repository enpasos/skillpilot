      "wholeCurrentSourceGoal": {
        "id": "90c8f1ca-9779-50b9-bcdf-a8dd44b8c9c6",
        "passageId": "8e98b3ef-4689-5dbe-91db-6604741aade8",
        "topicCode": "BcP12.1",
        "bulletIndex": 4,
        "aspectIndex": 1,
        "title": "setzen fachgemäße Arbeitsmethoden und -techniken bei der selbständigen, sicherheitsgerechten Durchfü...",
        "description": "setzen fachgemäße Arbeitsmethoden und -techniken bei der selbständigen, sicherheitsgerechten Durchführung qualitativer und quantitativer naturwissenschaftlicher Untersuchungen oder bei der Herstellung von biologischen Präparaten sowie der Synthese und Isolierung von Stoffen ein.",
        "sourceText": "setzen fachgemäße Arbeitsmethoden und -techniken bei der selbständigen, sicherheitsgerechten Durchführung qualitativer und quantitativer naturwissenschaftlicher Untersuchungen oder bei der Herstellung von biologischen Präparaten sowie der Synthese und Isolierung von Stoffen ein.",
        "sourceSpan": "BcP12.1.4",
        "parentBulletText": "setzen fachgemäße Arbeitsmethoden und -techniken bei der selbständigen, sicherheitsgerechten Durchführung qualitativer und quantitativer naturwissenschaftlicher Untersuchungen oder bei der Herstellung von biologischen Präparaten sowie der Synthese und Isolierung von Stoffen ein.",
        "sourceRef": "LehrplanPLUS Bayern Gymnasium Biologisch-chemisches Praktikum, BcP12.1.4",

        "bulletIndex": 9,
        "aspectIndex": 1,
        "title": "nennen den Säurewasserstoff als charakteristisches Merkmal von Säuren",
        "description": "Die lernende Person kann nennen den Säurewasserstoff als charakteristisches Merkmal von Säuren.",
        "sourceText": "nennen den Säurewasserstoff als charakteristisches Merkmal von Säuren,",
        "sourceSpan": "Klasse 9, S. 20, Source-Ziel 9",
        "parentBulletText": "nennen den Säurewasserstoff als charakteristisches Merkmal von Säuren,",
        "sourceRef": "SL-CH-SEKI-9-2025 S. 20",
        "courseLevel": "GK_LK",

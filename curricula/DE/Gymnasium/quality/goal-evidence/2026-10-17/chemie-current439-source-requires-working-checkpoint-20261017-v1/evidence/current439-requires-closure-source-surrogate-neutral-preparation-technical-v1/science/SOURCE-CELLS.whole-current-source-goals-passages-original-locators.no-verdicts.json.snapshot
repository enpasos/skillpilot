      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-seki-kc2015-cr-9-10-3-kompetenz-015-6f78d238",
        "passageId": "ni-chemistry-seki-kc2015-cr-9-10-3",
        "topicCode": "CR-9-10-3",
        "topicTitle": "Chemische Reaktion (3/3)",
        "headingTitle": "Lebensweltliche Bedeutung der Chemie erkennen",
        "title": "erkennen die Bedeutung von Redoxreaktionen und Säure-Base-Reaktionen in Alltag und Technik.",
        "description": "Die lernende Person kann erkennen die Bedeutung von Redoxreaktionen und Säure-Base-Reaktionen in Alltag und Technik.",
        "sourceDocumentKey": "NI-KC-NATURWISSENSCHAFTEN-SEKI-2015-CHEMIE",
        "sourceRef": "Niedersachsen Kerncurriculum Naturwissenschaften Gymnasium Sekundarbereich I 2015, Chemie, Chemische Reaktion (3/3), Schuljahrgänge 9/10, S. 61.",

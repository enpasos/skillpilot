      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:EF-organische-stoffklassen-bewertungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "EF-organische-stoffklassen-bewertungskompetenz",
        "title": "Einführungsphase: Organische Stoffklassen / Bewertungskompetenz",
        "page": 28,
        "rawText": "- beurteilen die Auswirkungen der Aufnahme von Ethanol hinsichtlich oxidativer Abbauprozesse im menschlichen Körper unter Aspekten der Gesunderhaltung\n- diskutieren den Einsatz von Konservierungsund Aromastoffen in der Lebensmittelindustrie aus gesundheitlicher und ökonomischer Perspektive und leiten entsprechende Handlungsoptionen zu deren Konsum ab\n- beurteilen die Verwendung von Lösemitteln in Produkten des Alltags auch im Hinblick auf die Entsorgung aus chemischer und ökologischer Perspektive",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-EF-organische-stoffklassen-bewertungskompetenz-001-1d335640",

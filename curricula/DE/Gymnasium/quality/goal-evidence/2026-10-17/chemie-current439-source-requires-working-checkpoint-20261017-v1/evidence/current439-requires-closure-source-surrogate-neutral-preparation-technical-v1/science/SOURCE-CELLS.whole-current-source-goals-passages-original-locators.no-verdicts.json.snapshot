      },
      "wholeCurrentSourceGoal": {
        "id": "sl-chem-seki-sl-ch-seki-9-2025-p016-003-2fced649",
        "passageId": "sl-chemistry-seki:sl-ch-seki-9-2025:p016",
        "topicCode": "SL-CH-SEKI-9-2025-P016",
        "bulletIndex": 3,
        "aspectIndex": 1,
        "title": "formulieren die Reaktionsgleichungen für die vollständige und unvollständige Verbrennung von Kohlenstoff",
        "description": "Die lernende Person kann formulieren die Reaktionsgleichungen für die vollständige und unvollständige Verbrennung von Kohlenstoff.",
        "sourceText": "formulieren die Reaktionsgleichungen für die vollständige und unvollständige Verbrennung von Kohlenstoff,",
        "sourceSpan": "Klasse 9, S. 16, Source-Ziel 3",
        "parentBulletText": "formulieren die Reaktionsgleichungen für die vollständige und unvollständige Verbrennung von Kohlenstoff,",
        "sourceRef": "SL-CH-SEKI-9-2025 S. 16",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekI",
          "courseLevel:GK_LK",
          "sourceDocument:SL-CH-SEKI-9-2025",
          "sourcePage:16"
        ],
        "rawSourceText": "formulieren die Reaktionsgleichungen für die vollständige und unvollständige Verbrennung von Kohlenstoff,",
        "rawSourceSpan": "Klasse 9, S. 16, Source-Ziel 3",
        "rawParentBulletText": "formulieren die Reaktionsgleichungen für die vollständige und unvollständige Verbrennung von Kohlenstoff,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-seki:sl-ch-seki-9-2025:p016",
        "topicCode": "SL-CH-SEKI-9-2025-P016",
        "title": "Klasse 9: Kompetenzpassage S. 16",
        "text": "- nennen Kohlenstoffdioxid und Kohlenstoffmonooxid als weitere Beispiele für Molekülverbindungen, die aus zwei Atomsorten aufgebaut sind,\n- nennen die Bedingungen für die Bildung der Kohlenstoffoxide CO2 und CO bei Verbrennungen (vollständige und unvollständige Verbrennung),\n- formulieren die Reaktionsgleichungen für die vollständige und unvollständige Verbrennung von Kohlenstoff,\n- recherchieren wichtige Eigenschaften von Kohlenstoffmonooxid,\n- leiten aus Experimenten wichtige Eigenschaften von Kohlenstoffdioxid ab (Dichte, Nichtbrennbarkeit, erstickende Wirkung, Löslichkeit),\n- recherchieren mögliche Gefahren durch Einatmen von Kohlenstoffmonooxid und Kohlenstoffdioxid,\n- weisen Kohlenstoffdioxid nach,\n- erläutern und bewerten die Bedeutung von Kohlenstoffdioxid für den Klimawandel (natürliche und anthropogene Quellen von CO2, Treibhauseffekt),\n- diskutieren Aussagen zum Treibhauseffekt aus unterschiedlichen Quellen.",
        "page": 16,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_Gymnasium_G9_Klasse_9_2025.pdf",
        "sourceGoalIds": [
          "sl-chem-seki-sl-ch-seki-9-2025-p016-001-f3824c68",

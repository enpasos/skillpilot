      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-gk-2023-2025:p044",
        "topicCode": "SL-CH-SEKII-GK-2023-2025-P044",
        "title": "Hauptphase Grundkurs: Kompetenzpassage S. 44",
        "text": "- beschreiben ein allgemeines Konstruktionsprinzip einer Elektrolysezelle,\n- erklären die Funktionsweise einer Elektrolysezelle,\n- begründen die Elektrodenreaktionen bei einer Elektrolyse mit Hilfe der Standardredoxpotenziale,\n- geben eine Definition für den Begriff Elektrolyse an,\n- führen Experimente zur Elektrolyse von Salzlösungen durch,\n- erklären den Begriff Zersetzungsspannung.",
        "page": 44,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Grundkurs_2023_ab_2027_red_2025.pdf",

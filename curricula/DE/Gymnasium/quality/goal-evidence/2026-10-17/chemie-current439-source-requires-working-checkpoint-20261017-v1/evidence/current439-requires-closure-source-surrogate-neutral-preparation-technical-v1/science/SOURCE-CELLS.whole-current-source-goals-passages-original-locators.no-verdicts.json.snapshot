      "wholeCurrentSourceGoal": {
        "id": "sl-chem-seki-sl-ch-seki-9-2025-p020-001-810a3018",
        "passageId": "sl-chemistry-seki:sl-ch-seki-9-2025:p020",
        "topicCode": "SL-CH-SEKI-9-2025-P020",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "nennen spezifische Stoffeigenschaften der Halogene am Beispiel von Chlor (Farbe, Geruch, Aggregatzustand, Giftigkeit, Dichte, Reaktionsfähigkeit sowie Schmelzund Siedetemperatur)",
        "description": "Die lernende Person kann nennen spezifische Stoffeigenschaften der Halogene am Beispiel von Chlor (Farbe, Geruch, Aggregatzustand, Giftigkeit, Dichte, Reaktionsfähigkeit sowie Schmelzund Siedetemperatur).",
        "sourceText": "nennen spezifische Stoffeigenschaften der Halogene am Beispiel von Chlor (Farbe, Geruch, Aggregatzustand, Giftigkeit, Dichte, Reaktionsfähigkeit sowie Schmelzund Siedetemperatur),",
        "sourceSpan": "Klasse 9, S. 20, Source-Ziel 1",
        "parentBulletText": "nennen spezifische Stoffeigenschaften der Halogene am Beispiel von Chlor (Farbe, Geruch, Aggregatzustand, Giftigkeit, Dichte, Reaktionsfähigkeit sowie Schmelzund Siedetemperatur),",
        "sourceRef": "SL-CH-SEKI-9-2025 S. 20",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [

        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "ermitteln in Redoxgleichungen Änderungen der Oxidationszahlen und interpretieren diese mit Hilfe des erweiterten Redoxbegriffs (Oxidation, Reduktion, Oxidationsmittel, Reduktion...",
        "description": "Die lernende Person kann ermitteln in Redoxgleichungen Änderungen der Oxidationszahlen und interpretieren diese mit Hilfe des erweiterten Redoxbegriffs (Oxidation, Reduktion, Oxidationsmittel, Reduktionsmittel).",
        "sourceText": "ermitteln in Redoxgleichungen Änderungen der Oxidationszahlen und interpretieren diese mit Hilfe des erweiterten Redoxbegriffs (Oxidation, Reduktion, Oxidationsmittel, Reduktionsmittel),",
        "sourceSpan": "Hauptphase Leistungskurs, S. 52, Source-Ziel 1",
        "parentBulletText": "ermitteln in Redoxgleichungen Änderungen der Oxidationszahlen und interpretieren diese mit Hilfe des erweiterten Redoxbegriffs (Oxidation, Reduktion, Oxidationsmittel, Reduktionsmittel),",
        "sourceRef": "SL-CH-SEKII-LK-2023-2025 S. 52",
        "courseLevel": "LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:LK",
          "sourceDocument:SL-CH-SEKII-LK-2023-2025",
          "sourcePage:52"
        ],
        "rawSourceText": "ermitteln in Redoxgleichungen Änderungen der Oxidationszahlen und interpretieren diese mit Hilfe des erweiterten Redoxbegriffs (Oxidation, Reduktion, Oxidationsmittel, Reduktionsmittel),",
        "rawSourceSpan": "Hauptphase Leistungskurs, S. 52, Source-Ziel 1",
        "rawParentBulletText": "ermitteln in Redoxgleichungen Änderungen der Oxidationszahlen und interpretieren diese mit Hilfe des erweiterten Redoxbegriffs (Oxidation, Reduktion, Oxidationsmittel, Reduktionsmittel),"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-lk-2023-2025:p052",
        "topicCode": "SL-CH-SEKII-LK-2023-2025-P052",
        "title": "Hauptphase Leistungskurs: Kompetenzpassage S. 52",
        "text": "- ermitteln in Redoxgleichungen Änderungen der Oxidationszahlen und interpretieren diese mit Hilfe des erweiterten Redoxbegriffs (Oxidation, Reduktion, Oxidationsmittel, Reduktionsmittel),\n- formulieren für Reaktionen im sauren und alkalischen Medium Teilgleichungen für Oxidation und Reduktion und leiten daraus die Redoxgleichung (ohne Gegenionen) ab,\n- recherchieren und erklären die Redoxtitration als ein Verfahren der quantitativen Analyse am Beispiel der Manganometrie.",
        "page": 52,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Leistungskurs_2023_ab_2027_red_2025.pdf",

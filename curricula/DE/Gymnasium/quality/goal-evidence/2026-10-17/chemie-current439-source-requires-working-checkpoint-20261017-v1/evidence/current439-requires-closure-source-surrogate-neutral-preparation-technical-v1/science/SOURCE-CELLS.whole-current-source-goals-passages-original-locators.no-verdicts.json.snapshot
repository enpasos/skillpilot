      "wholeCurrentSourceGoal": {
        "id": "de-hh-chemie-sekii-bildungsplan-2022-2-4-054-9f9a6c97",
        "passageId": "de-hh-chemie-sekii-bildungsplan-2022:2-4",
        "topicCode": "2.4",
        "title": "pH-Wert-Berechnungen waessriger Loesungen von Saeuren und Basen bei vollstaendiger Protolyse durchfuehren",
        "description": "Die lernende Person kann pH-Wert-Berechnungen waessriger Loesungen von Saeuren und Basen bei vollstaendiger Protolyse durchfuehren.",
        "sourceDocumentKey": "HH-CHEMIE-GYO-2022",
        "sourceRef": "Hamburg Bildungsplan Studienstufe Chemie 2022, 2.4, S. 30.",
        "sourceText": "pH-Wert-Berechnungen waessriger Loesungen von Saeuren und Basen bei vollstaendiger Protolyse durchfuehren",
        "sourceSpan": {
          "passageId": "de-hh-chemie-sekii-bildungsplan-2022:2-4",
          "label": "2.4, S. 30: pH-Wert-Berechnungen waessriger Loesungen von Saeuren und Basen bei vollstaendiger Protolyse durchfuehren"
        },
        "courseLevel": "GK_LK",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-HH",
          "stage:SekII",
          "section:2-4",
          "courseLevel:GK_LK"
        ],
        "metadata": {
          "extractionMethod": "manual-transcription-from-official-hamburg-pdf-passages",

      "wholeCurrentSourceGoal": {
        "id": "bb-chemistry-sekii-rlp-3-1-3-inhalte-003-03ca4de5",
        "passageId": "bb-chemistry-sekii-rlp-3-1-3",
        "topicCode": "3.1.3",
        "topicTitle": "Säuren, Basen, Salze",
        "category": "Inhalte",
        "title": "Zusammenhang zwischen der Oxonium-Ionenkonzentration und dem pH-Wert einer sauren Lösung",
        "description": "Die lernende Person kann Zusammenhang zwischen der Oxonium-Ionenkonzentration und dem pH-Wert einer sauren Lösung fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.1.3 Säuren, Basen, Salze, S. 20.",
        "sourceText": "Zusammenhang zwischen der Oxonium-Ionenkonzentration und dem pH-Wert einer sauren Lösung",
        "sourceSpan": {
          "passageId": "bb-chemistry-sekii-rlp-3-1-3",
          "label": "Inhalte: Zusammenhang zwischen der Oxonium-Ionenkonzentration und dem pH-Wert einer sauren Lösung"
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-BB",
          "stage:SekII",
          "topic:3.1.3",
          "category:Inhalte"

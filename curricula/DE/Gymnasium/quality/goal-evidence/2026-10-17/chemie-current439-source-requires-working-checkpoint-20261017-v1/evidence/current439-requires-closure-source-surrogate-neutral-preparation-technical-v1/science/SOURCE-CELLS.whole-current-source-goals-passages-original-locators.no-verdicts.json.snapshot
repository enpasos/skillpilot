      "wholeCurrentSourceGoal": {
        "id": "rp-chem-seki-rp-ch-seki-2014-tf05-sauber-und-schon-002-d01349a0",
        "passageId": "rp-chemistry-seki:tf05-sauber-und-schon",
        "topicCode": "TF05-SAUBER-UND-SCHON",
        "bulletIndex": 2,
        "aspectIndex": 1,
        "title": "erklären typische Stoffeigenschaften, insbesondere die Polarität von Lösungsmitteln (Alkan, Alkanol und Wasser) mit Hilfe der Molekülstruktur",
        "description": "Die lernende Person kann erklären typische Stoffeigenschaften, insbesondere die Polarität von Lösungsmitteln (Alkan, Alkanol und Wasser) mit Hilfe der Molekülstruktur.",
        "sourceText": "erklären typische Stoffeigenschaften, insbesondere die Polarität von Lösungsmitteln (Alkan, Alkanol und Wasser) mit Hilfe der Molekülstruktur,",
        "sourceSpan": "Themenfeld 5: Sauber und schön, Source-Ziel 2",
        "parentBulletText": "erklären typische Stoffeigenschaften, insbesondere die Polarität von Lösungsmitteln (Alkan, Alkanol und Wasser) mit Hilfe der Molekülstruktur,",
        "sourceRef": "RP-CH-SEKI-2014 S. 76",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-RP",
          "stage:SekI",
          "topic:tf05-sauber-und-schon",
          "courseLevel:GK_LK"
        ],
        "rawSourceText": "erklären typische Stoffeigenschaften, insbesondere die Polarität von Lösungsmitteln (Alkan, Alkanol und Wasser) mit Hilfe der Molekülstruktur,",
        "rawSourceSpan": "Themenfeld 5: Sauber und schön, Source-Ziel 2",
        "rawParentBulletText": "erklären typische Stoffeigenschaften, insbesondere die Polarität von Lösungsmitteln (Alkan, Alkanol und Wasser) mit Hilfe der Molekülstruktur,"
      },
      "wholeOriginalPassage": {
        "id": "rp-chemistry-seki:tf05-sauber-und-schon",
        "topicCode": "TF05-SAUBER-UND-SCHON",
        "title": "Themenfeld 5: Sauber und schön",
        "text": "- planen einfache Untersuchungen zum Lösungsverhalten von Stoffen, führen sie durch und protokollieren,\n- erklären typische Stoffeigenschaften, insbesondere die Polarität von Lösungsmitteln (Alkan, Alkanol und Wasser) mit Hilfe der Molekülstruktur,\n- wenden Wissen über Lösungsmittel in verschiedenen alltagsbezogenen Problemstellungen an.\n- zentrale Basiskonzepte und Fachbegriffe des Themenfeldes fachsprachlich verwenden: Fachbegriffe: Auf der Stoffebene: Kohlenstoffverbindungen mit ähnlicher Struktur (z. B. funktionelle Gruppen) bilden eine Stoffklasse (z. B. Alkanole). Kohlenstoffverbindung, Alkane, Alkanole Die Eigenschaften der Stoffe (z. B. Lösungseigenschaften) bedingen ihre Verwendung (z. B. Lösungsmittel). funktionelle Gruppe Die Polarität von Wasser und Kohlenstoffverbindungen wird durch ihre Molekülstruktur bestimmt. (SEF) hydrophil, hydrophob, lipophil, lipophob, Auf der Teilchenebene: Die Vielfalt der Kohlenstoffverbindungen ergibt sich aus der polar, unpolar Fähigkeit des Kohlenstoffatoms zur Ausbildung von Elektronenpaarbindungen mit anderen Kohlenstoffatomen. (TMS) Dipol Innerhalb einer Stoffklasse verändern sich die Eigenschaften in Abhängigkeit von der Größe des Moleküls. (SEF) 74",
        "page": 76,
        "sourcePath": "curricula/DE/Gymnasium/input/RP/Chemie_Sekundarstufe_I_Biologie_Physik_Chemie_2014.pdf",

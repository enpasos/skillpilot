    {
      "cellId": "2f391ba2-ba1e-40e4-a8d2-dff049516c13::he-chem-sekii-q2-1-b06-a01-98df595c",
      "sourceFieldProvenance": {
        "filePin": {
          "path": "/mnt/e/skillpilot-chemie-L7-20261017/current439-remediation14-guarded-root-integration-technical-v1/capsule/curricula/DE/Gymnasium/input/HE/upper-secondary/source-extraction/DE_HE_CHEMIE_SEKII_KC2024.source-extraction.json",

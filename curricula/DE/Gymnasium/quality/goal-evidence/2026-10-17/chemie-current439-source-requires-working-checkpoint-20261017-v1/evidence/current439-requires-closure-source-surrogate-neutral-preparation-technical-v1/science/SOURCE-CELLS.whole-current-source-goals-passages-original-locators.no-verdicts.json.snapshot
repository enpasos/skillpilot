      "wholeCurrentSourceGoal": {
        "id": "de-sh-chemie-seki-fachanforderungen-2022-2-2-4-energie-010-b06edd65",
        "passageId": "de-sh-chemie-seki-fachanforderungen-2022:2-2-4-energie",
        "topicCode": "2-2-4-energie",
        "title": "beschreiben mithilfe der Ionisierungsenergien, dass sich Elektronen in einem Atom in ihrem Energiegehalt unterscheiden.",
        "description": "Die lernende Person kann beschreiben mithilfe der Ionisierungsenergien, dass sich Elektronen in einem Atom in ihrem Energiegehalt unterscheiden.",
        "sourceDocumentKey": "SH-FA-CHEMIE-SEK-2022",
        "sourceRef": "Schleswig-Holstein Fachanforderungen Chemie Sekundarstufe I/II 2022, 2.2.4 Energie, S. 24.",
        "sourceText": "beschreiben mithilfe der Ionisierungsenergien, dass sich Elektronen in einem Atom in ihrem Energiegehalt unterscheiden.",
        "sourceSpan": {
          "passageId": "de-sh-chemie-seki-fachanforderungen-2022:2-2-4-energie",
          "label": "2.2.4 Energie, S. 24: beschreiben mithilfe der Ionisierungsenergien, dass sich Elektronen in einem Atom in ihrem Energiegehalt unterscheiden."
        },
        "courseLevel": "unspecified",
        "tags": [

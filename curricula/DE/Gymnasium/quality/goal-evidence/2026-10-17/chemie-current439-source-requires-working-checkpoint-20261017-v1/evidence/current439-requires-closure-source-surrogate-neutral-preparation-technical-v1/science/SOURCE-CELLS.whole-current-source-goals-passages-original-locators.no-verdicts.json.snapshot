        "wholePassagePointer": "/passages/18"
      },
      "wholeCurrentSourceGoal": {
        "id": "be-chemistry-sekii-rlp-3-2-5-inhalte-001-427ee278",
        "passageId": "be-chemistry-sekii-rlp-3-2-5",
        "topicCode": "3.2.5",
        "topicTitle": "Chemisches Gleichgewicht",
        "category": "Inhalte",
        "title": "Umkehrbarkeit chemischer Reaktionen als Voraussetzung für das chemische Gleichgewicht",
        "description": "Die lernende Person kann Umkehrbarkeit chemischer Reaktionen als Voraussetzung für das chemische Gleichgewicht fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.2.5 Chemisches Gleichgewicht, S. 41.",
        "sourceText": "Umkehrbarkeit chemischer Reaktionen als Voraussetzung für das chemische Gleichgewicht",
        "sourceSpan": {
          "passageId": "be-chemistry-sekii-rlp-3-2-5",
          "label": "Inhalte: Umkehrbarkeit chemischer Reaktionen als Voraussetzung für das chemische Gleichgewicht"
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-BE",
          "stage:SekII",
          "topic:3.2.5",

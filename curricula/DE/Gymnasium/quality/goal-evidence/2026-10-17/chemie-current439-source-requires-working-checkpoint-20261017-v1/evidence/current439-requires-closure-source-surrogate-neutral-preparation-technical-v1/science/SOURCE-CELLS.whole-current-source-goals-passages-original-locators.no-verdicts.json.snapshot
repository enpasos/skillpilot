      },
      "wholeCurrentSourceGoal": {
        "id": "de-sh-chemie-seki-fachanforderungen-2022-2-1-3-bewertung-001-1369c287",
        "passageId": "de-sh-chemie-seki-fachanforderungen-2022:2-1-3-bewertung",
        "topicCode": "2-1-3-bewertung",
        "title": "Problemund Entscheidungsfelder nennen, in denen die Chemie persönlich und gesellschaftlich relevant ist.",
        "description": "Die lernende Person kann Problemund Entscheidungsfelder nennen, in denen die Chemie persönlich und gesellschaftlich relevant ist.",
        "sourceDocumentKey": "SH-FA-CHEMIE-SEK-2022",
        "sourceRef": "Schleswig-Holstein Fachanforderungen Chemie Sekundarstufe I/II 2022, 2.1.3 Bewertung, S. 19.",
        "sourceText": "Problemund Entscheidungsfelder nennen, in denen die Chemie persönlich und gesellschaftlich relevant ist.",
        "sourceSpan": {
          "passageId": "de-sh-chemie-seki-fachanforderungen-2022:2-1-3-bewertung",
          "label": "2.1.3 Bewertung, S. 19: Problemund Entscheidungsfelder nennen, in denen die Chemie persönlich und gesellschaftlich relevant ist."
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-SH",
          "stage:SekI",
          "section:2-1-3-bewertung",
          "courseLevel:unspecified"
        ],
        "metadata": {
          "extractionMethod": "pdftotext-raw-official-pdf-bullet-extraction",

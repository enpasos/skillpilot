      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-sekii-kc2022-ep-2-kompetenz-016-12e9d722",
        "passageId": "ni-chemistry-sekii-kc2022-ep-2",
        "topicCode": "EP-2",
        "topicTitle": "Reaktionen von Alkanen",
        "category": "Kompetenz",
        "title": "entwickeln aus Alltagssituationen chemische Fragestellungen zum Kohlenstoffdioxidausstoß.",
        "description": "Die lernende Person kann entwickeln aus Alltagssituationen chemische Fragestellungen zum Kohlenstoffdioxidausstoß..",
        "sourceDocumentKey": "NI-KC-CHEMIE-SEKII-2022",
        "sourceRef": "Niedersachsen Kerncurriculum Chemie gymnasiale Oberstufe 2022, Reaktionen von Alkanen, S. 13.",
        "sourceText": "entwickeln aus Alltagssituationen chemische Fragestellungen zum Kohlenstoffdioxidausstoß.",
        "sourceSpan": {
          "passageId": "ni-chemistry-sekii-kc2022-ep-2",
          "label": "Kompetenz: entwickeln aus Alltagssituationen chemische Fragestellungen zum Kohlenstoffdioxidausstoß."
        },
        "courseLevel": "GK_LK",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-NI",
          "stage:SekII",
          "topic:EP-2",
          "courseLevel:GK_LK"
        ],
        "metadata": {

    {
      "cellId": "4eb03df6-9416-5dc8-8957-a9cd3d5ce6a9::rp-chem-seki-rp-ch-seki-2014-tf03-heizen-und-antreiben-001-8e13881a",
      "sourceFieldProvenance": {
        "filePin": {
          "path": "/mnt/e/skillpilot-chemie-L7-20261017/current439-remediation14-guarded-root-integration-technical-v1/capsule/curricula/DE/Gymnasium/input/RP/lower-secondary/source-extraction/DE_RP_CHEMIE_SEKI_RAHMENLEHRPLAN_2014.source-extraction.json",
          "sha256": "aef5035f5da0970fe5a4465f9633aed8c7b0815ec667a36dfcb77dfa1ae23701",

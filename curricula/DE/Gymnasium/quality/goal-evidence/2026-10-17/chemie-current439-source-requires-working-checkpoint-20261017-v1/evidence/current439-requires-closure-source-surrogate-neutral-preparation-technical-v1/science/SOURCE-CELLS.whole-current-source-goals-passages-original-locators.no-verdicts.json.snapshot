        "topicCode": "SL-CH-SEKI-8-2024-P030",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "schließen aus Stoffumwandlung und Energieumwandlung auf eine chemische Reaktion",
        "description": "Die lernende Person kann schließen aus Stoffumwandlung und Energieumwandlung auf eine chemische Reaktion.",
        "sourceText": "schließen aus Stoffumwandlung und Energieumwandlung auf eine chemische Reaktion,",
        "sourceSpan": "Klasse 8, S. 30, Source-Ziel 1",
        "parentBulletText": "schließen aus Stoffumwandlung und Energieumwandlung auf eine chemische Reaktion,",
        "sourceRef": "SL-CH-SEKI-8-2024 S. 30",
        "courseLevel": "GK_LK",

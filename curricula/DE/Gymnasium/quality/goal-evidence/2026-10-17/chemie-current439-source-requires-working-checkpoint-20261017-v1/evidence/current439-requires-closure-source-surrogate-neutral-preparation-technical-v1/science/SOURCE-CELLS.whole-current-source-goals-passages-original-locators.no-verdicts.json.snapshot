      "wholeCurrentSourceGoal": {
        "id": "de-nw-chemie-sekii-klp-2022-LK-elektrochemische-prozesse-und-energetik-sachkompetenz-003-35e0f689",
        "passageId": "de-nw-chemie-sekii-klp-2022:LK-elektrochemische-prozesse-und-energetik-sachkompetenz",
        "topicCode": "LK-elektrochemische-prozesse-und-energetik-sachkompetenz",
        "title": "erläutern den Aufbau und die Funktionsweise galvanischer Zellen hinsichtlich der chemischen Prozesse auch mithilfe digitaler Werkzeuge und berechnen auch unter Berücksichtigung der Nernst-Gleichung die jeweilige Zellspannung",
        "description": "Die lernende Person kann erläutern den Aufbau und die Funktionsweise galvanischer Zellen hinsichtlich der chemischen Prozesse auch mithilfe digitaler Werkzeuge und berechnen auch unter Berücksichtigung der Nernst-Gleichung die jeweilige Zellspannung.",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "sourceRef": "Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Leistungskurs, Elektrochemische Prozesse und Energetik, Sachkompetenz, S. 49.",
        "sourceText": "erläutern den Aufbau und die Funktionsweise galvanischer Zellen hinsichtlich der chemischen Prozesse auch mithilfe digitaler Werkzeuge und berechnen auch unter Berücksichtigung der Nernst-Gleichung die jeweilige Zellspannung",
        "sourceSpan": {
          "passageId": "de-nw-chemie-sekii-klp-2022:LK-elektrochemische-prozesse-und-energetik-sachkompetenz",
          "label": "Qualifikationsphase Leistungskurs, Elektrochemische Prozesse und Energetik, Sachkompetenz, S. 49: erläutern den Aufbau und die Funktionsweise galvanischer Zellen hinsichtlich der chemischen Prozesse auch mithilfe digitaler Werkzeuge und berechnen auch unter Berücksichtigung der Nernst-Gleichung die jeweilige Zellspannung"
        },
        "courseLevel": "LK",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-NW",

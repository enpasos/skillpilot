      "wholeCurrentSourceGoal": {
        "id": "sl-chem-seki-sl-ch-seki-8-2024-p015-009-23710bb3",
        "passageId": "sl-chemistry-seki:sl-ch-seki-8-2024:p015",
        "topicCode": "SL-CH-SEKI-8-2024-P015",
        "bulletIndex": 9,
        "aspectIndex": 1,
        "title": "planen Experimente zur Trennung komplexer Stoffgemische in ihre Bestandteile und führen diese durch",
        "description": "Die lernende Person kann planen Experimente zur Trennung komplexer Stoffgemische in ihre Bestandteile und führen diese durch.",
        "sourceText": "planen Experimente zur Trennung komplexer Stoffgemische in ihre Bestandteile und führen diese durch.",
        "sourceSpan": "Klasse 8, S. 15, Source-Ziel 9",
        "parentBulletText": "planen Experimente zur Trennung komplexer Stoffgemische in ihre Bestandteile und führen diese durch.",
        "sourceRef": "SL-CH-SEKI-8-2024 S. 15",

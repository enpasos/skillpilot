      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-nw-2024-p014-009-c77e509a",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p014",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P014",
        "bulletIndex": 9,
        "aspectIndex": 1,
        "title": "geben die Formeln der Moleküle in der Valenzstrich-Schreibweise und die Partialladungen an",
        "description": "Die lernende Person kann geben die Formeln der Moleküle in der Valenzstrich-Schreibweise und die Partialladungen an.",
        "sourceText": "geben die Formeln der Moleküle in der Valenzstrich-Schreibweise und die Partialladungen an,",
        "sourceSpan": "Einführungsphase NW-Zweig, S. 14, Source-Ziel 9",
        "parentBulletText": "geben die Formeln der Moleküle in der Valenzstrich-Schreibweise und die Partialladungen an,",
        "sourceRef": "SL-CH-SEKII-EP-NW-2024 S. 14",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [

        "passageId": "sl-chemistry-seki:sl-ch-seki-9-2025:p015",
        "topicCode": "SL-CH-SEKI-9-2025-P015",
        "bulletIndex": 4,
        "aspectIndex": 1,
        "title": "erklären am Beispiel von Wasser die Begriffe Molekülformel (Summenformel) und Verhältnisformel",
        "description": "Die lernende Person kann erklären am Beispiel von Wasser die Begriffe Molekülformel (Summenformel) und Verhältnisformel.",
        "sourceText": "erklären am Beispiel von Wasser die Begriffe Molekülformel (Summenformel) und Verhältnisformel,",
        "sourceSpan": "Klasse 9, S. 15, Source-Ziel 4",
        "parentBulletText": "erklären am Beispiel von Wasser die Begriffe Molekülformel (Summenformel) und Verhältnisformel,",
        "sourceRef": "SL-CH-SEKI-9-2025 S. 15",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [

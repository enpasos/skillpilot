      "wholeCurrentSourceGoal": {
        "id": "be-chemistry-sekii-rlp-3-2-9-inhalte-011-34111fe9",
        "passageId": "be-chemistry-sekii-rlp-3-2-9",
        "topicCode": "3.2.9",
        "topicTitle": "Elektrochemie",
        "category": "Inhalte",

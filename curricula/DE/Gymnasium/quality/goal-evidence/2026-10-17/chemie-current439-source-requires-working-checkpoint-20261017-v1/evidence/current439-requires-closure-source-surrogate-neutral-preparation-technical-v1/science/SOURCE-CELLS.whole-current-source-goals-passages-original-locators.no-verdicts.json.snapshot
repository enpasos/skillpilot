          {
            "heading": "Verbindliche Fachbegriffe",
            "courseLevel": "GK_LK",
            "literalText": "Brönsted Säure-Base-Theorie, Protolysegleichgewicht, korrespondierendes Säure-Base-Paar, Autoprotolyse, Ionenprodukt des Wassers, pH-Wert, Säurestärke und Basenstärke, Neutralisation, Titration, Titrationskurve und charakteristische Punkte"
          },
          {
            "heading": "Verbindliche Fachbegriffe – LK",
            "courseLevel": "LK",
            "literalText": "Puffersysteme, Konduktometrie, koordinative Bindung bei hydratisierten Metallkationen"
          },
          {
            "heading": "Konkretisierung prozessbezogener Kompetenzen",
            "courseLevel": "GK_LK",
            "literalParent": "Die Lernenden ...",
            "literalBullets": [
              "planen quantitative Untersuchungen zur Bestimmung der Stoffmengenkonzentration von Säuren und Basen, führen diese durch und werten sie u. a. mit Hilfe von Titrationskurven aus (auch unter Zuhilfenahme von digitalen Werkzeugen).",
              "recherchieren und präsentieren die Relevanz von Säuren und Basen im Alltag in analogen und digitalen Medien.",
              "bewerten die ökologische Bedeutung der Ozeanversauerung durch den Menschen und leiten daraus Handlungsoptionen ab."
            ]
          },
          {
            "heading": "Vertiefungen",
            "sourceRole": "Vertiefung; no compulsory whole goal inferred from examples",
            "literalBullets": [
              "Physiologisch bedeutsame Puffersysteme (z. B. Blutpuffer, Antazida)",
              "Ökologisch bedeutsame Puffersysteme (z. B. Bodenpuffer, Meerwasser)"
            ]
          },
          {
            "heading": "Beispiele für experimentelle Arbeiten",
            "sourceRole": "illustrative experimental examples; no blanket compulsory allocation",
            "literalBullets": [
              "pH-Wert-Bestimmung und Titration von Säuren/ Basen in Lebens- und Reinigungsmitteln",
              "Untersuchung von CO2-Gleichgewichten (Mineralwasser, Meerwasser)",
              "Herstellung und Untersuchung eines Puffers (z. B. Acetatpuffer)",
              "Leitfähigkeitstitration (z. B. Salzsäure mit Natronlauge)",
              "Bestimmung des pH-Werts von Salzlösungen und Salzlösungen mit hydratisierten Metallkationen (Aluminium-, Kupfer- oder Eisenchlorid)"
            ]
          }
        ],

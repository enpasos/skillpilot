      "wholeCurrentSourceGoal": {
        "id": "be-chemistry-sekii-rlp-3-1-2-inhalte-012-aca9dbe8",
        "passageId": "be-chemistry-sekii-rlp-3-1-2",
        "topicCode": "3.1.2",
        "topicTitle": "Vom Atom zur chemischen Verbindung",
        "category": "Inhalte",
        "title": "Modifikationen des Kohlenstoffs (Diamant, Graphit, Graphen, Fullerene, Nanotubes): Bau, Eigenschaften und Verwendung",
        "description": "Die lernende Person kann Modifikationen des Kohlenstoffs (Diamant, Graphit, Graphen, Fullerene, Nanotubes): Bau, Eigenschaften und Verwendung fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.1.2 Vom Atom zur chemischen Verbindung, S. 19.",
        "sourceText": "Modifikationen des Kohlenstoffs (Diamant, Graphit, Graphen, Fullerene, Nanotubes): Bau, Eigenschaften und Verwendung",
        "sourceSpan": {
          "passageId": "be-chemistry-sekii-rlp-3-1-2",
          "label": "Inhalte: Modifikationen des Kohlenstoffs (Diamant, Graphit, Graphen, Fullerene, Nanotubes): Bau, Eigenschaften und Verwendung"
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-BE",
          "stage:SekII",

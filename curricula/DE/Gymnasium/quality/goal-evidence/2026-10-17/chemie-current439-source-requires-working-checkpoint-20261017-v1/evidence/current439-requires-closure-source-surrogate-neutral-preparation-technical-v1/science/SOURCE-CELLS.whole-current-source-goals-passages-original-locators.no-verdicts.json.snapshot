      "wholeCurrentSourceGoal": {
        "id": "be-chemistry-sekii-rlp-3-1-6-inhalte-005-c3e76719",
        "passageId": "be-chemistry-sekii-rlp-3-1-6",
        "topicCode": "3.1.6",
        "topicTitle": "Angewandte organische Chemie – Waschmittel",
        "category": "Inhalte",
        "title": "Seife - Struktur, Herstellung, Eigenschaften, Nachteile (Säure- und Härteempfindlichkeit)",
        "description": "Die lernende Person kann Seife - Struktur, Herstellung, Eigenschaften, Nachteile (Säure- und Härteempfindlichkeit) fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",

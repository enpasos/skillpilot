      "wholeCurrentSourceGoal": {
        "id": "hb-chemistry-seki-bp2006-2022-3-2-haushalt-029-8ef32e03",
        "passageId": "hb-chemistry-seki:3.2-HAUSHALT",
        "topicCode": "3.2-HAUSHALT",
        "bulletIndex": 29,
        "aspectIndex": 1,
        "title": "Salze als Ionenverbindungen aus Kationen und Anionen benennen und einfache Bildungsreaktionen formulieren",
        "description": "Die lernende Person kann Salze als Ionenverbindungen aus Kationen und Anionen benennen und einfache Bildungsreaktionen formulieren.",
        "sourceText": "Salze als Ionenverbindungen aus Kationen und Anionen benennen und einfache Bildungsreaktionen formulieren",
        "sourceSpan": "3.2-HAUSHALT, S. 42",
        "sourceDocumentKey": "HB_NW_GYM_2022_RESTRICTION",
        "parentBulletText": "Salze als Ionenverbindungen aus Kationen und Anionen benennen und einfache Bildungsreaktionen formulieren",
        "sourceRef": "Bremen Bildungsplan Naturwissenschaften/Chemie Gymnasium 5-10 mit Einschränkung 2022, 3.2-HAUSHALT, S. 42",
        "courseLevel": "GK_LK",
        "granularity": "officialCompetencyBullet",
        "tags": [
          "source:bremen",
          "stage:SekI",
          "topic:3.2-HAUSHALT",
          "course:GK_LK"
        ],
        "rawSourceText": "Salze als Ionenverbindungen aus Kationen und Anionen benennen und einfache Bildungsreaktionen formulieren",
        "rawSourceSpan": "3.2-HAUSHALT, S. 42",
        "rawParentBulletText": "Salze als Ionenverbindungen aus Kationen und Anionen benennen und einfache Bildungsreaktionen formulieren"
      },
      "wholeOriginalPassage": {
        "id": "hb-chemistry-seki:3.2-HAUSHALT",
        "topicCode": "3.2-HAUSHALT",
        "title": "3.2-HAUSHALT Chemie im Haushalt",
        "text": "- Saeuren und Laugen als Inhaltsstoffe von Haushaltsreinigern nennen und ihre Wirkung beschreiben\n- die pH-Skala beschreiben und Loesungen als sauer, basisch und neutral kennzeichnen\n- Reaktionsgleichungen zur Neutralisation formulieren\n- die Ionenbildung und -bindung mithilfe des Schalenmodells erklaeren\n- die Elektrolyse beschreiben und sie auf der Teilchenebene erklaeren\n- den Zusammenhang zwischen dem Bau von Atomen und der Anordnung der Elemente im PSE herstellen\n- Salze als Ionenverbindungen aus Kationen und Anionen benennen und einfache Bildungsreaktionen formulieren\n- Elemente in Elementfamilien ordnen und das PSE als Ordnungsprinzip anwenden\n- Indikatoren zur Identifizierung von Saeuren und Laugen anwenden\n- die pH-Werte von Haushaltsreinigern experimentell ermitteln\n- sparsamen Umgang mit Reinigungsmitteln als Beitrag zum Gewaesserschutz begreifen\n- einige in Wasser geloeste Anionen nachweisen",
        "page": 42,
        "sourceDocumentKey": "HB_NW_GYM_2022_RESTRICTION",
        "sourcePath": "curricula/DE/Gymnasium/input/HB/Naturwissenschaften_Gymnasium_5_9_Einschraenkungen_2022.pdf",
        "rawText": "- Saeuren und Laugen als Inhaltsstoffe von Haushaltsreinigern nennen und ihre Wirkung beschreiben\n- die pH-Skala beschreiben und Loesungen als sauer, basisch und neutral kennzeichnen\n- Reaktionsgleichungen zur Neutralisation formulieren\n- die Ionenbildung und -bindung mithilfe des Schalenmodells erklaeren\n- die Elektrolyse beschreiben und sie auf der Teilchenebene erklaeren\n- den Zusammenhang zwischen dem Bau von Atomen und der Anordnung der Elemente im PSE herstellen\n- Salze als Ionenverbindungen aus Kationen und Anionen benennen und einfache Bildungsreaktionen formulieren\n- Elemente in Elementfamilien ordnen und das PSE als Ordnungsprinzip anwenden\n- Indikatoren zur Identifizierung von Saeuren und Laugen anwenden\n- die pH-Werte von Haushaltsreinigern experimentell ermitteln\n- sparsamen Umgang mit Reinigungsmitteln als Beitrag zum Gewaesserschutz begreifen\n- einige in Wasser geloeste Anionen nachweisen",

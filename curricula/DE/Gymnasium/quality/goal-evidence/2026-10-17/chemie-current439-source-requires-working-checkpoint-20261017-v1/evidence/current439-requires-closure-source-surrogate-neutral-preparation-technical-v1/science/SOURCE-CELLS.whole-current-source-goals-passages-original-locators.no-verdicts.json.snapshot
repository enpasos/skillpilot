      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:EF-reaktionsgeschwindigkeit-und-chemisches-gleichgewicht-bewertungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "EF-reaktionsgeschwindigkeit-und-chemisches-gleichgewicht-bewertungskompetenz",
        "title": "Einführungsphase: Reaktionsgeschwindigkeit und chemisches Gleichgewicht / Bewertungskompetenz",
        "page": 30,
        "rawText": "- beurteilen den ökologischen wie ökonomischen Nutzen und die Grenzen der Beeinflussbarkeit chemischer Gleichgewichtslagen in einem technischen Verfahren\n- analysieren und beurteilen im Zusammenhang mit der jeweiligen Intention der Urheberschaft verschiedene Quellen und Darstellungsformen zu den Folgen anthropogener Einflüsse in einen natürlichen Stoffkreislauf\n- bewerten die Folgen eines Eingriffs in einen Stoffkreislauf mit Blick auf Gleichgewichtsprozesse in aktuell-gesellschaftlichen Zusammenhängen",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-EF-reaktionsgeschwindigkeit-und-chemisches-gleichgewicht-bewertungskompetenz-001-26906fed",

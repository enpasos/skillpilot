      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:GK-elektrochemische-prozesse-und-energetik-erkenntnisgewinnungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "GK-elektrochemische-prozesse-und-energetik-erkenntnisgewinnungskompetenz",
        "title": "Qualifikationsphase Grundkurs: Elektrochemische Prozesse und Energetik / Erkenntnisgewinnungskompetenz",
        "page": 40,
        "rawText": "- entwickeln Hypothesen zum Auftreten von Redoxreaktionen zwischen Metallatomen und -ionen und überprüfen diese experimentell\n- entwickeln eigenständig ausgewählte Experimente zum Korrosionsschutz (Galvanik, Opferanode) und führen sie durch\n- ermitteln Messdaten ausgewählter galvanischer Zellen zur Einordnung in die elektrochemische Spannungsreihe\n- ermitteln auch rechnerisch die Standardreaktionsenthalpien ausgewählter Redoxreaktionen unter Anwendung des Satzes von Hess",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-GK-elektrochemische-prozesse-und-energetik-erkenntnisgewinnungskompetenz-001-650eb8ba",

        "topicCode": "SL-CH-SEKII-EP-SPR-2024-P023",
        "bulletIndex": 3,
        "aspectIndex": 1,
        "title": "erklären das Löslichkeitsverhalten der Alkanole und verwenden dabei die Fachbegriffe hydrophob/hydrophil bzw. lipophob/lipophil bzw. unpolar/polar",
        "description": "Die lernende Person kann erklären das Löslichkeitsverhalten der Alkanole und verwenden dabei die Fachbegriffe hydrophob/hydrophil bzw. lipophob/lipophil bzw. unpolar/polar.",
        "sourceText": "erklären das Löslichkeitsverhalten der Alkanole und verwenden dabei die Fachbegriffe hydrophob/hydrophil bzw. lipophob/lipophil bzw. unpolar/polar,",
        "sourceSpan": "Einführungsphase sprachlicher Zweig, S. 23, Source-Ziel 3",
        "parentBulletText": "erklären das Löslichkeitsverhalten der Alkanole und verwenden dabei die Fachbegriffe hydrophob/hydrophil bzw. lipophob/lipophil bzw. unpolar/polar,",
        "sourceRef": "SL-CH-SEKII-EP-SPR-2024 S. 23",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [

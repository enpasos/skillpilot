      },
      "wholeCurrentSourceGoal": {
        "id": "bb-chemistry-sekii-rlp-3-1-3-inhalte-001-e7b48a01",
        "passageId": "bb-chemistry-sekii-rlp-3-1-3",
        "topicCode": "3.1.3",
        "topicTitle": "Säuren, Basen, Salze",
        "category": "Inhalte",
        "title": "Säuren und Basen nach BRÖNSTED definieren sowie Säuren von sauren Lösungen und Basen von basischen Lösungen unterscheiden",
        "description": "Die lernende Person kann Säuren und Basen nach BRÖNSTED definieren sowie Säuren von sauren Lösungen und Basen von basischen Lösungen unterscheiden fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.1.3 Säuren, Basen, Salze, S. 20.",
        "sourceText": "Säuren und Basen nach BRÖNSTED definieren sowie Säuren von sauren Lösungen und Basen von basischen Lösungen unterscheiden",
        "sourceSpan": {
          "passageId": "bb-chemistry-sekii-rlp-3-1-3",
          "label": "Inhalte: Säuren und Basen nach BRÖNSTED definieren sowie Säuren von sauren Lösungen und Basen von basischen Lösungen unterscheiden"
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-BB",
          "stage:SekII",
          "topic:3.1.3",
          "category:Inhalte"
        ],
        "metadata": {

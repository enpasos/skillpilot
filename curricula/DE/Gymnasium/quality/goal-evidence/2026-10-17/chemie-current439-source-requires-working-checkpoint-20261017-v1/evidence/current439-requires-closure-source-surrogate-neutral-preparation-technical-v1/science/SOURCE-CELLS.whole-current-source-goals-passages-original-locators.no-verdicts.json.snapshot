        },
        "sourceGoalPointer": "/sourceGoals/40",
        "sourceGoalFieldCanonicalSHA256": "5622ac12b8e0e100f117ad8090e9785ef62a2e4e884081d6b2b7196906895215",
        "wholePassagePointer": "/passages/10"
      },
      "wholeCurrentSourceGoal": {
        "id": "1dc77e5a-24f2-5efc-a6e2-8c4a920162fe",
        "passageId": "543c1d23-649c-5740-aff2-c5ec864e93de",
        "topicCode": "BcP13.4",
        "bulletIndex": 4,
        "aspectIndex": 1,
        "title": "setzen alltagsrelevante Techniken zur Zubereitung und Veredelung von Lebensmitteln ein und erklären ...",
        "description": "setzen alltagsrelevante Techniken zur Zubereitung und Veredelung von Lebensmitteln ein und erklären die biologischen und chemischen Grundlagen der Verfahren.",
        "sourceText": "setzen alltagsrelevante Techniken zur Zubereitung und Veredelung von Lebensmitteln ein und erklären die biologischen und chemischen Grundlagen der Verfahren.",
        "sourceSpan": "BcP13.4.4",
        "parentBulletText": "setzen alltagsrelevante Techniken zur Zubereitung und Veredelung von Lebensmitteln ein und erklären die biologischen und chemischen Grundlagen der Verfahren.",
        "sourceRef": "LehrplanPLUS Bayern Gymnasium Biologisch-chemisches Praktikum, BcP13.4.4",
        "courseLevel": "unspecified",
        "granularity": "officialCompetency",
        "tags": [
          "jurisdiction:DE-BY",
          "stage:SekII",
          "courseLevel:unspecified",
          "topic:BcP13.4"
        ],
        "rawSourceText": "setzen alltagsrelevante Techniken zur Zubereitung und Veredelung von Lebensmitteln ein und erklären die biologischen und chemischen Grundlagen der Verfahren.",
        "rawSourceSpan": "BcP13.4.4",
        "rawParentBulletText": "setzen alltagsrelevante Techniken zur Zubereitung und Veredelung von Lebensmitteln ein und erklären die biologischen und chemischen Grundlagen der Verfahren."
      },
      "wholeOriginalPassage": {
        "id": "543c1d23-649c-5740-aff2-c5ec864e93de",
        "topicCode": "BcP13.4",
        "title": "BcP12/13 Lernbereich 4: Herstellung, Prüfung und Verwendung von Grund- und Werkstoffen",
        "text": "1) wenden biotechnologische und chemische Verfahren zur Synthese von Stoffen an.\n2) führen präparative Verfahren sicherheitsgerecht durch und dokumentieren ihre Tätigkeit.\n3) wählen Verfahren aus und wenden diese an, um synthetisierte Stoffe zu reinigen, und setzen Analyseverfahren ein, um die Reinheit und Ausbeute eines selbst hergestellten Präparates zu überprüfen.\n4) setzen alltagsrelevante Techniken zur Zubereitung und Veredelung von Lebensmitteln ein und erklären die biologischen und chemischen Grundlagen der Verfahren.\n5) stellen Arznei- oder Körperpflegemittel her und erklären die chemischen Grundlagen der Herstellung.\n6) stellen Werk- und Baustoffe her und beurteilen deren Einsatzmöglichkeiten, indem sie deren Eigenschaften unter gleichen Bedingungen überprüfen.\n7) kombinieren ausgewählte Werk- und Baustoffe zu funktionellen Systemen und zeigen mögliche Anwendungen in Alltag und Technik auf.",
        "sourcePath": "curricula/DE/Gymnasium/input/BY/gymnasium/Biologisch-chemisches_Praktikum.json",

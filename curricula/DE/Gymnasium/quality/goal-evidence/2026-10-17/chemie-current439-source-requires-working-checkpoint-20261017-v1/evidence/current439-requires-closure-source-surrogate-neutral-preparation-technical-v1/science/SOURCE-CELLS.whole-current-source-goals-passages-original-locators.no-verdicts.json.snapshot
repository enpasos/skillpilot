      "wholeCurrentSourceGoal": {
        "id": "be-chemistry-sekii-rlp-3-1-4-inhalte-001-a3cd3c25",
        "passageId": "be-chemistry-sekii-rlp-3-1-4",
        "topicCode": "3.1.4",
        "topicTitle": "Grundlagen der organischen Chemie",
        "category": "Inhalte",
        "title": "organische Verbindungen darstellen: Verhältnis-, Summen-, Halb- und ausführliche Strukturformel",
        "description": "Die lernende Person kann organische Verbindungen darstellen: Verhältnis-, Summen-, Halb- und ausführliche Strukturformel fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.1.4 Grundlagen der organischen Chemie, S. 21.",
        "sourceText": "organische Verbindungen darstellen: Verhältnis-, Summen-, Halb- und ausführliche Strukturformel",
        "sourceSpan": {

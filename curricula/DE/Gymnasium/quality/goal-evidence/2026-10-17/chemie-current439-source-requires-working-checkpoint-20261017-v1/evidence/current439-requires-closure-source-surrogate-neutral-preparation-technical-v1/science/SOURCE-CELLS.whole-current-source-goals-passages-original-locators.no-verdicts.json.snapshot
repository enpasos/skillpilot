      "wholeCurrentSourceGoal": {
        "id": "th-chem-seki-th-ch-seki-2-2-1-1-kohlenwasserstoffe-110-01-9bf52aaa",
        "passageId": "th-chemistry-seki:th-ch-seki-2-2-1-1-kohlenwasserstoffe",
        "topicCode": "TH-CH-SekI-2.2.1.1-kohlenwasserstoffe",
        "bulletIndex": 110,
        "aspectIndex": 1,
        "title": "den Zusammenhang zwischen Struktur und Eigenschaften der n-Alkane erläutern: unterschiedliche Siedetemperaturen",
        "description": "Die lernende Person kann den Zusammenhang zwischen Struktur und Eigenschaften der n-Alkane erläutern: unterschiedliche Siedetemperaturen.",
        "sourceText": "den Zusammenhang zwischen Struktur und Eigenschaften der n-Alkane erläutern: unterschiedliche Siedetemperaturen",
        "sourceSpan": "Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Kohlenwasserstoffe, PDF-S. 27",
        "parentBulletText": "den Zusammenhang zwischen Struktur und Eigenschaften der n-Alkane erläutern:",
        "sourceRef": "Lehrplan Gymnasium Chemie Thueringen 2024, Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Kohlenwasserstoffe, PDF-S. 27",
        "courseLevel": "GK_LK",
        "granularity": "officialCompetencyAspect",
        "tags": [
          "source:thueringen",
          "subject:Chemie",
          "stage:SekI",

      "wholeCurrentSourceGoal": {
        "id": "de-hh-chemie-sekii-bildungsplan-2022-3-1-066-cb37e9a9",
        "passageId": "de-hh-chemie-sekii-bildungsplan-2022:3-1",
        "topicCode": "3.1",
        "title": "Grundbauprinzip einer galvanischen Zelle und elektrochemische Spannungsreihe beschreiben",
        "description": "Die lernende Person kann Grundbauprinzip einer galvanischen Zelle und elektrochemische Spannungsreihe beschreiben.",
        "sourceDocumentKey": "HH-CHEMIE-GYO-2022",
        "sourceRef": "Hamburg Bildungsplan Studienstufe Chemie 2022, 3.1, S. 31.",
        "sourceText": "Grundbauprinzip einer galvanischen Zelle und elektrochemische Spannungsreihe beschreiben",
        "sourceSpan": {
          "passageId": "de-hh-chemie-sekii-bildungsplan-2022:3-1",

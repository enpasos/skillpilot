      "wholeCurrentSourceGoal": {
        "id": "be-chemistry-sekii-rlp-3-1-4-inhalte-008-7ba4e4eb",
        "passageId": "be-chemistry-sekii-rlp-3-1-4",
        "topicCode": "3.1.4",
        "topicTitle": "Grundlagen der organischen Chemie",
        "category": "Inhalte",
        "title": "Elementaranalyse: die elementare Zusammensetzung eines organischen Stoffes und seiner Verhältnisformel ermitteln",
        "description": "Die lernende Person kann Elementaranalyse: die elementare Zusammensetzung eines organischen Stoffes und seiner Verhältnisformel ermitteln fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.1.4 Grundlagen der organischen Chemie, S. 21.",
        "sourceText": "Elementaranalyse: die elementare Zusammensetzung eines organischen Stoffes und seiner Verhältnisformel ermitteln",
        "sourceSpan": {
          "passageId": "be-chemistry-sekii-rlp-3-1-4",
          "label": "Inhalte: Elementaranalyse: die elementare Zusammensetzung eines organischen Stoffes und seiner Verhältnisformel ermitteln"
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-BE",
          "stage:SekII",
          "topic:3.1.4",
          "category:Inhalte"

      "wholeOriginalPassage": {
        "id": "hb-chemistry-sekii:3.1-PROZESS",
        "topicCode": "3.1-PROZESS",
        "title": "3.1-PROZESS Uebergreifende Kompetenzen und Digitalisierung",
        "text": "- chemische Fragestellungen hypothesengeleitet untersuchen und Experimente planen, durchfuehren, dokumentieren und auswerten\n- Theorien, Modelle und Simulationen zur Erklaerung chemischer Sachverhalte nutzen und kritisch vergleichen\n- Fachsprache, Reaktionsgleichungen, Diagramme und andere Darstellungen adressatengerecht verwenden\n- analoge und digitale Quellen zu chemischen Sachverhalten recherchieren und quellenkritisch auswerten\n- chemische Sachverhalte unter gesellschaftlichen, oekologischen und oekonomischen Perspektiven bewerten\n- Messwerte digital erfassen, auswerten und dokumentieren\n- digitale Modelle, Visualisierungen und Simulationen zur Struktur- und Reaktionsdeutung einsetzen",
        "page": 14,
        "sourceDocumentKey": "HB-GYO-CHEMIE-2022",
        "sourcePath": "curricula/DE/Gymnasium/input/HB/GyO_Chemie_2022.pdf",

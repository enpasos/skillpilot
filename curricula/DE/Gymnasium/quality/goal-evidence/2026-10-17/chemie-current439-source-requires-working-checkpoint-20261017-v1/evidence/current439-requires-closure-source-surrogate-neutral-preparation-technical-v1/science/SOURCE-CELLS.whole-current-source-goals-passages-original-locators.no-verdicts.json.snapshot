        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "geben einen Überblick über die Formeln und die Namen weiterer sauerstoffhaltiger Säuren (Salpetersäure, Schwefelsäure, Phosphorsäure)",
        "description": "Die lernende Person kann geben einen Überblick über die Formeln und die Namen weiterer sauerstoffhaltiger Säuren (Salpetersäure, Schwefelsäure, Phosphorsäure).",
        "sourceText": "geben einen Überblick über die Formeln und die Namen weiterer sauerstoffhaltiger Säuren (Salpetersäure, Schwefelsäure, Phosphorsäure),",
        "sourceSpan": "Einführungsphase sprachlicher Zweig, S. 12, Source-Ziel 1",
        "parentBulletText": "geben einen Überblick über die Formeln und die Namen weiterer sauerstoffhaltiger Säuren (Salpetersäure, Schwefelsäure, Phosphorsäure),",
        "sourceRef": "SL-CH-SEKII-EP-SPR-2024 S. 12",
        "courseLevel": "GK_LK",

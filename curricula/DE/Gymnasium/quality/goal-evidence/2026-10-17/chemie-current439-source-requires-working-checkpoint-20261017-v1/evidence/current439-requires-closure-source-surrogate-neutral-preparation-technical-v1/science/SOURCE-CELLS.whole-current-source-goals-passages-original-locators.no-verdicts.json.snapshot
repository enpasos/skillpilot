    {
      "cellId": "c8d559dc-e8de-52a7-851a-6e411907daf6::sl-chem-seki-sl-ch-seki-8-2024-p012-001-1dc8368a",
      "sourceFieldProvenance": {
        "filePin": {
          "path": "/mnt/e/skillpilot-chemie-L7-20261017/current439-remediation14-guarded-root-integration-technical-v1/capsule/curricula/DE/Gymnasium/input/SL/lower-secondary/source-extraction/DE_SL_CHEMIE_SEKI_GYM9_2024_2025.source-extraction.json",
          "sha256": "04fd855508778e19305e23e722d4fab0e2b7f618b31f6dcd5e6f7462b47c72dc",
          "bytes": 303991
        },
        "sourceGoalPointer": "/sourceGoals/0",
        "sourceGoalFieldCanonicalSHA256": "e9340945bf21b3e257917bb90da137b950e8cccaddc6e20e890676a61b284b03",
        "wholePassagePointer": "/passages/0"
      },
      "wholeCurrentSourceGoal": {
        "id": "sl-chem-seki-sl-ch-seki-8-2024-p012-001-1dc8368a",
        "passageId": "sl-chemistry-seki:sl-ch-seki-8-2024:p012",
        "topicCode": "SL-CH-SEKI-8-2024-P012",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "nennen und beachten die Verhaltensregeln in den naturwissenschaftlichen Fachräumen (z. B. Tragen von Schutzbrille und Schutzkleidung beim Experimentieren, nicht Essen und Trinke...",
        "description": "Die lernende Person kann nennen und beachten die Verhaltensregeln in den naturwissenschaftlichen Fachräumen (z. B. Tragen von Schutzbrille und Schutzkleidung beim Experimentieren, nicht Essen und Trinken in den Fachräumen).",
        "sourceText": "nennen und beachten die Verhaltensregeln in den naturwissenschaftlichen Fachräumen (z. B. Tragen von Schutzbrille und Schutzkleidung beim Experimentieren, nicht Essen und Trinken in den Fachräumen),",
        "sourceSpan": "Klasse 8, S. 12, Source-Ziel 1",
        "parentBulletText": "nennen und beachten die Verhaltensregeln in den naturwissenschaftlichen Fachräumen (z. B. Tragen von Schutzbrille und Schutzkleidung beim Experimentieren, nicht Essen und Trinken in den Fachräumen),",
        "sourceRef": "SL-CH-SEKI-8-2024 S. 12",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",

      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-lk-2023-2025-p054-001-5ebd33ab",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-lk-2023-2025:p054",
        "topicCode": "SL-CH-SEKII-LK-2023-2025-P054",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "skizzieren und beschreiben einen Versuchsaufbau zur Messung von Standardredoxpotenzialen",
        "description": "Die lernende Person kann skizzieren und beschreiben einen Versuchsaufbau zur Messung von Standardredoxpotenzialen.",
        "sourceText": "skizzieren und beschreiben einen Versuchsaufbau zur Messung von Standardredoxpotenzialen,",
        "sourceSpan": "Hauptphase Leistungskurs, S. 54, Source-Ziel 1",
        "parentBulletText": "skizzieren und beschreiben einen Versuchsaufbau zur Messung von Standardredoxpotenzialen,",
        "sourceRef": "SL-CH-SEKII-LK-2023-2025 S. 54",
        "courseLevel": "LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:LK",
          "sourceDocument:SL-CH-SEKII-LK-2023-2025",
          "sourcePage:54"
        ],
        "rawSourceText": "skizzieren und beschreiben einen Versuchsaufbau zur Messung von Standardredoxpotenzialen,",
        "rawSourceSpan": "Hauptphase Leistungskurs, S. 54, Source-Ziel 1",
        "rawParentBulletText": "skizzieren und beschreiben einen Versuchsaufbau zur Messung von Standardredoxpotenzialen,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-lk-2023-2025:p054",
        "topicCode": "SL-CH-SEKII-LK-2023-2025-P054",
        "title": "Hauptphase Leistungskurs: Kompetenzpassage S. 54",
        "text": "- skizzieren und beschreiben einen Versuchsaufbau zur Messung von Standardredoxpotenzialen,\n- geben eine Definition für das Standardredoxpotenzial E0 an,\n- führen einfache Experimente zur elektrochemischen Spannungsreihe von Metallen durch,\n- erklären das Zustandekommen der Spannung zwischen verschiedenen Redoxpaaren,\n- vergleichen Standardredoxpotenziale von Redoxpaaren und interpretieren diese hinsichtlich ihrer Bedeutung für den Ablauf von Redoxreaktionen,\n- erklären die pH-Abhängigkeit von Redoxpotenzialen mit Hilfe des chemischen Gleichgewichts,\n- beschreiben den Aufbau des DANIELL-Elementes.",
        "page": 54,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Leistungskurs_2023_ab_2027_red_2025.pdf",

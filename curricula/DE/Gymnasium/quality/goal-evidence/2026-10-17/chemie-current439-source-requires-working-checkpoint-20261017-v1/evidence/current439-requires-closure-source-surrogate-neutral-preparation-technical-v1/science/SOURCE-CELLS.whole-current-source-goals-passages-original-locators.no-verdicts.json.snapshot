      "wholeCurrentSourceGoal": {
        "id": "ni-chemistry-seki-kc2015-st-9-10-6-kompetenz-005-d5c070ac",
        "passageId": "ni-chemistry-seki-kc2015-st-9-10-6",
        "topicCode": "ST-9-10-6",
        "topicTitle": "Stoff-Teilchen (6/7)",
        "headingTitle": "Elemente lassen sich nach verschiedenen Prinzipien ordnen",
        "title": "vergleichen die Alkalimetalle und Halogene innerhalb einer Familie und stellen Gemeinsamkeiten und Unterschiede fest.",
        "description": "Die lernende Person kann vergleichen die Alkalimetalle und Halogene innerhalb einer Familie und stellen Gemeinsamkeiten und Unterschiede fest.",
        "sourceDocumentKey": "NI-KC-NATURWISSENSCHAFTEN-SEKI-2015-CHEMIE",
        "sourceRef": "Niedersachsen Kerncurriculum Naturwissenschaften Gymnasium Sekundarbereich I 2015, Chemie, Stoff-Teilchen (6/7), Schuljahrgänge 9/10, S. 56.",

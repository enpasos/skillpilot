      },
      "wholeCurrentSourceGoal": {
        "id": "de-nw-chemie-sekii-klp-2022-LK-sauren-basen-und-analytische-verfahren-sachkompetenz-001-8f7482ba",
        "passageId": "de-nw-chemie-sekii-klp-2022:LK-sauren-basen-und-analytische-verfahren-sachkompetenz",
        "topicCode": "LK-sauren-basen-und-analytische-verfahren-sachkompetenz",
        "title": "klassifizieren die auch in Produkten des Alltags identifizierten Säuren und Basen mithilfe des Säure-Base-Konzepts von Brønsted und erläutern ihr Reaktionsverhalten unter Berücksichtigung von Protolysegleichungen",
        "description": "Die lernende Person kann klassifizieren die auch in Produkten des Alltags identifizierten Säuren und Basen mithilfe des Säure-Base-Konzepts von Brønsted und erläutern ihr Reaktionsverhalten unter Berücksichtigung von Protolysegleichungen.",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "sourceRef": "Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Leistungskurs, Säuren, Basen und analytische Verfahren, Sachkompetenz, S. 46.",
        "sourceText": "klassifizieren die auch in Produkten des Alltags identifizierten Säuren und Basen mithilfe des Säure-Base-Konzepts von Brønsted und erläutern ihr Reaktionsverhalten unter Berücksichtigung von Protolysegleichungen",
        "sourceSpan": {
          "passageId": "de-nw-chemie-sekii-klp-2022:LK-sauren-basen-und-analytische-verfahren-sachkompetenz",
          "label": "Qualifikationsphase Leistungskurs, Säuren, Basen und analytische Verfahren, Sachkompetenz, S. 46: klassifizieren die auch in Produkten des Alltags identifizierten Säuren und Basen mithilfe des Säure-Base-Konzepts von Brønsted und erläutern ihr Reaktionsverhalten unter Berücksichtigung von Protolysegleichungen"
        },
        "courseLevel": "LK",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-NW",
          "stage:SekII",

      "wholeCurrentSourceGoal": {
        "id": "de-nw-chemie-sekii-klp-2022-LK-reaktionswege-in-der-organischen-chemie-sachkompetenz-004-febabd9d",
        "passageId": "de-nw-chemie-sekii-klp-2022:LK-reaktionswege-in-der-organischen-chemie-sachkompetenz",
        "topicCode": "LK-reaktionswege-in-der-organischen-chemie-sachkompetenz",
        "title": "erklären Redoxreaktionen in organischen Synthesewegen unter Berücksichtigung der Oxidationszahlen",
        "description": "Die lernende Person kann erklären Redoxreaktionen in organischen Synthesewegen unter Berücksichtigung der Oxidationszahlen.",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "sourceRef": "Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Leistungskurs, Reaktionswege in der organischen Chemie, Sachkompetenz, S. 52.",
        "sourceText": "erklären Redoxreaktionen in organischen Synthesewegen unter Berücksichtigung der Oxidationszahlen",
        "sourceSpan": {
          "passageId": "de-nw-chemie-sekii-klp-2022:LK-reaktionswege-in-der-organischen-chemie-sachkompetenz",
          "label": "Qualifikationsphase Leistungskurs, Reaktionswege in der organischen Chemie, Sachkompetenz, S. 52: erklären Redoxreaktionen in organischen Synthesewegen unter Berücksichtigung der Oxidationszahlen"
        },
        "courseLevel": "LK",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-NW",
          "stage:SekII",
          "phase:LK",
          "field:reaktionswege-in-der-organischen-chemie",
          "competency:sachkompetenz",
          "courseLevel:LK"
        ],
        "metadata": {

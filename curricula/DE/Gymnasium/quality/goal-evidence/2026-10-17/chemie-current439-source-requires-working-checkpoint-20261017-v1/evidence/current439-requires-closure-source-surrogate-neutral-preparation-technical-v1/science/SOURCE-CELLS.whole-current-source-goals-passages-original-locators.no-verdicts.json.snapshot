        "granularity": "officialCompetency",
        "tags": [
          "jurisdiction:DE-BW",
          "subject:Chemie",
          "stage:SekII",
          "topic:3.4.2",
          "courseLevel:LK",
          "Leistungsfach",
          "LK"
        ],
        "rawSourceText": "die Umkehrbarkeit einer Reaktion als Voraussetzung für die Einstellung eines Gleichgewichts nennen",
        "rawSourceSpan": "3.4.2 (1)",

      "wholeCurrentSourceGoal": {
        "id": "be-chemistry-sekii-rlp-3-2-7-inhalte-011-490e550a",
        "passageId": "be-chemistry-sekii-rlp-3-2-7",
        "topicCode": "3.2.7",
        "topicTitle": "Indikatorfarbstoffe",
        "category": "Inhalte",
        "title": "Säure-Base-Theorie nach BRÖNSTED auf Indikatorfarbstoffe anwenden",
        "description": "Die lernende Person kann Säure-Base-Theorie nach BRÖNSTED auf Indikatorfarbstoffe anwenden fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.2.7 Indikatorfarbstoffe, S. 48.",
        "sourceText": "Säure-Base-Theorie nach BRÖNSTED auf Indikatorfarbstoffe anwenden",
        "sourceSpan": {
          "passageId": "be-chemistry-sekii-rlp-3-2-7",
          "label": "Inhalte: Säure-Base-Theorie nach BRÖNSTED auf Indikatorfarbstoffe anwenden"
        },
        "courseLevel": "unspecified",

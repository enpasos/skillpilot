      "wholeCurrentSourceGoal": {
        "id": "rp-chem-sekii-rp-ch-sekii-2022-baustein-integrationsphase-003-9f1f3b2b",
        "passageId": "rp-chemistry-sekii:baustein-integrationsphase",
        "topicCode": "BAUSTEIN-integrationsphase",
        "bulletIndex": 3,
        "aspectIndex": 1,
        "title": "Ionenbindung (Bildung eines Ionengitters), Salze, Ionengruppe, Verhältnisformel",
        "description": "Die lernende Person kann ionenbindung (Bildung eines Ionengitters), Salze, Ionengruppe, Verhältnisformel.",
        "sourceText": "Ionenbindung (Bildung eines Ionengitters), Salze, Ionengruppe, Verhältnisformel",
        "sourceSpan": "Integrationsphase, Source-Ziel 3",
        "parentBulletText": "Ionenbindung (Bildung eines Ionengitters), Salze, Ionengruppe, Verhältnisformel",
        "sourceRef": "RP-CH-SEKII-2022 S. 24",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-RP",
          "stage:SekII",
          "topic:baustein-integrationsphase",
          "courseLevel:GK_LK"
        ],
        "rawSourceText": "Ionenbindung (Bildung eines Ionengitters), Salze, Ionengruppe, Verhältnisformel",
        "rawSourceSpan": "Integrationsphase, Source-Ziel 3",
        "rawParentBulletText": "Ionenbindung (Bildung eines Ionengitters), Salze, Ionengruppe, Verhältnisformel"
      },
      "wholeOriginalPassage": {
        "id": "rp-chemistry-sekii:baustein-integrationsphase",
        "topicCode": "BAUSTEIN-integrationsphase",
        "title": "Integrationsphase",
        "text": "- Atommodell; Ionisierungsenergien; Energiestufenmodell\n- Aufbau des PSE: Elektronenkonfiguration und Atommasse chemische Bindungen\n- Ionenbindung (Bildung eines Ionengitters), Salze, Ionengruppe, Verhältnisformel\n- Elektronenpaarbindung, Einfachund Mehrfachbindungen; Darstellung von Molekülen und Molekül-Ionen: Summen-, Lewis-, Skelett-, HalbstrukturFormel, Formalladungen; Elektronegativität, polare Atombindung, Partialladung, Molekülgeometrie, Dipol; Konstitutionsisomerie (weitere Isomerieformen  Aliphaten I und II (8.1 und 8.2)), IUPAC-Nomenklatur\n- Metallbindung (Bildung eines Metallgitters), Elektronengasmodell 33 Struktur und Eigenschaften\n- Wechselwirkungen; Dipol-Dipol-Wechselwirkungen (temporäre Dipole, permanente Dipole); Wasserstoffbrücken; Ion-Dipol-Wechselwirkungen\n- Folgen von Wechselwirkungen, wie z. B. Schmelzund Siedetemperaturen, Löslichkeit (z. B. Vergleich von Alkanen mit Alkanolen …) Stöchiometrie\n- Reaktionsgleichungen auf Stoff-, Teilchenund Formelebene\n- chemisches Rechnen (Grundlagen, die kontinuierlich bei anderen Bausteinen angewandt und vertieft werden); Stoffmenge; molare Größen: molare Masse, molares Volumen; Gehaltsangaben: Massenkonzentration, Stoffmengenkonzentration",
        "page": 24,
        "sourcePath": "curricula/DE/Gymnasium/input/RP/Chemie_Sekundarstufe_II_MSS_2022.pdf",
        "sourceGoalIds": [
          "rp-chem-sekii-rp-ch-sekii-2022-baustein-integrationsphase-001-8cfbba80",

    {
      "cellId": "55e02c7e-ddca-4b30-a895-dc27c5f107ca::1dc77e5a-24f2-5efc-a6e2-8c4a920162fe",
      "sourceFieldProvenance": {
        "filePin": {
          "path": "/mnt/e/skillpilot-chemie-L7-20261017/current439-remediation14-guarded-root-integration-technical-v1/capsule/curricula/DE/Gymnasium/input/BY/gymnasium/source-extraction/DE_BY_BIOLOGISCH_CHEMISCHES_PRAKTIKUM_GYMNASIUM_LEHRPLANPLUS.source-extraction.json",

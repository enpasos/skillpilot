      },
      "wholeCurrentSourceGoal": {
        "id": "8e4fc3b2-bfa4-5c67-b107-7997fc89cc45",
        "passageId": "543c1d23-649c-5740-aff2-c5ec864e93de",
        "topicCode": "BcP13.4",
        "bulletIndex": 5,
        "aspectIndex": 1,
        "title": "stellen Arznei- oder Körperpflegemittel her und erklären die chemischen Grundlagen der Herstellung.",
        "description": "stellen Arznei- oder Körperpflegemittel her und erklären die chemischen Grundlagen der Herstellung.",

        "wholePassagePointer": "/passages/4"
      },
      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-nw-2024-p014-001-5a9d4a91",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p014",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P014",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "nennen die Oktettregel (Edelgasregel/Regel von KOSSEL) und wenden diese auf geeignete Beispiele an",
        "description": "Die lernende Person kann nennen die Oktettregel (Edelgasregel/Regel von KOSSEL) und wenden diese auf geeignete Beispiele an.",
        "sourceText": "nennen die Oktettregel (Edelgasregel/Regel von KOSSEL) und wenden diese auf geeignete Beispiele an,",
        "sourceSpan": "Einführungsphase NW-Zweig, S. 14, Source-Ziel 1",
        "parentBulletText": "nennen die Oktettregel (Edelgasregel/Regel von KOSSEL) und wenden diese auf geeignete Beispiele an,",
        "sourceRef": "SL-CH-SEKII-EP-NW-2024 S. 14",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:GK_LK",
          "sourceDocument:SL-CH-SEKII-EP-NW-2024",
          "sourcePage:14"
        ],
        "rawSourceText": "nennen die Oktettregel (Edelgasregel/Regel von KOSSEL) und wenden diese auf geeignete Beispiele an,",
        "rawSourceSpan": "Einführungsphase NW-Zweig, S. 14, Source-Ziel 1",
        "rawParentBulletText": "nennen die Oktettregel (Edelgasregel/Regel von KOSSEL) und wenden diese auf geeignete Beispiele an,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p014",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P014",
        "title": "Einführungsphase NW-Zweig: Kompetenzpassage S. 14",
        "text": "- nennen die Oktettregel (Edelgasregel/Regel von KOSSEL) und wenden diese auf geeignete Beispiele an,\n- erklären die Atombindung an einfachen Beispielen,\n- wenden die Valenzstrich-Schreibweise bei Molekülverbindungen an,\n- geben eine Definition für den Begriff Elektronegativität an,\n- ermitteln die Polarität einer Atombindung über die Elektronegativitätsdifferenzen,\n- vergleichen die Bindungsstärken polarer und unpolarer Atombindungen,\n- geben eine Definition für den Begriff Dipol an,\n- stellen polare Bindungen modellhaft als elektrische Dipole dar,\n- geben die Formeln der Moleküle in der Valenzstrich-Schreibweise und die Partialladungen an,\n- beschreiben und erklären die räumlichen Strukturen von Molekülen (Molekülgeometrie und Bindungswinkel) nach dem EPAModell (VSEPR-Modell),\n- erklären anhand der Beispiele H2O und NH3 die Abweichungen vom Tetraederwinkel,\n- erklären, dass die Polarität der Bindungen und eine bestimmte Molekülgeometrie Voraussetzungen für den Dipolcharakter eines Moleküls sind.",
        "page": 14,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Einfuehrungsphase_naturwissenschaftlicher_Zweig_2024.pdf",
        "sourceGoalIds": [

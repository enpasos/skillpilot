      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:LK-sauren-basen-und-analytische-verfahren-erkenntnisgewinnungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "LK-sauren-basen-und-analytische-verfahren-erkenntnisgewinnungskompetenz",
        "title": "Qualifikationsphase Leistungskurs: Säuren, Basen und analytische Verfahren / Erkenntnisgewinnungskompetenz",
        "page": 47,
        "rawText": "- weisen ausgewählte Ionensorten (Halogenid-Ionen, Ammonium-Ionen, Carbonat-Ionen) salzartiger Verbindungen qualitativ nach\n- planen hypothesengeleitet Experimente zur Konzentrationsbestimmung von Säuren und Basen auch in Alltagsprodukten\n- führen das Verfahren einer Säure-Base-Titration mit Endpunktbestimmung mittels Indikator durch und werten die Ergebnisse auch unter Berücksichtigung einer Fehleranalyse aus\n- werten pH-metrische Titrationen von einund mehrprotonigen Säuren aus und erläutern den Verlauf der Titrationskurven auch bei unvollständiger Protolyse\n- bestimmen die Reaktionsenthalpie der Neutralisationsreaktion von starken Säuren mit starken Basen kalorimetrisch und vergleichen das Ergebnis mit Literaturdaten\n- interpretieren die Messdaten von Lösungsenthalpien verschiedener Salze unter Berücksichtigung der Entropie",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-LK-sauren-basen-und-analytische-verfahren-erkenntnisgewinnungskompetenz-001-267cfa72",

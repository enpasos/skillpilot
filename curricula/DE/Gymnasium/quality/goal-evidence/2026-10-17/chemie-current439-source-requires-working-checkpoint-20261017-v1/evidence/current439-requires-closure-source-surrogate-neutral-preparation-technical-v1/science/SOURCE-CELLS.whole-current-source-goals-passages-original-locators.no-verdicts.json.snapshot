      "wholeOriginalPassage": {
        "id": "de-hh-chemie-sekii-bildungsplan-2022:2-1",
        "sourceDocumentKey": "HH-CHEMIE-GYO-2022",
        "topicCode": "2.1",
        "title": "2.1 Energie chemischer Reaktionen",
        "page": 27,
        "rawText": "- Energieumwandlung, Energieerhaltung und Kalorimetrie bei chemischen Reaktionen beschreiben\n- Reaktionswaerme experimentell bestimmen\n- den ersten Hauptsatz der Thermodynamik mit Enthalpie und Satz von Hess anwenden\n- Standard-Reaktionsenthalpien berechnen\n- Brennwert und Heizwert verschiedener Energietraeger fakultativ einordnen\n- Entropie und Gibbs-Helmholtz-Gleichung als zweiten Hauptsatz der Thermodynamik nutzen\n- freie Reaktionsenthalpie berechnen",
        "sourceGoalIds": [
          "de-hh-chemie-sekii-bildungsplan-2022-2-1-032-35313854",

      "wholeCurrentSourceGoal": {
        "id": "hb-chemistry-seki-bp2006-2022-3-1-luft-feuer-002-60755f50",
        "passageId": "hb-chemistry-seki:3.1-LUFT-FEUER",
        "topicCode": "3.1-LUFT-FEUER",
        "bulletIndex": 2,
        "aspectIndex": 1,
        "title": "Verbrennungsvoraussetzungen nennen und daraus Loeschtechniken ableiten",
        "description": "Die lernende Person kann Verbrennungsvoraussetzungen nennen und daraus Loeschtechniken ableiten.",
        "sourceText": "Verbrennungsvoraussetzungen nennen und daraus Loeschtechniken ableiten",
        "sourceSpan": "3.1-LUFT-FEUER, S. 40",
        "sourceDocumentKey": "HB_NW_GYM_2006",
        "parentBulletText": "Verbrennungsvoraussetzungen nennen und daraus Loeschtechniken ableiten",
        "sourceRef": "Bremen Bildungsplan Naturwissenschaften/Chemie Gymnasium 5-10 mit Einschränkung 2022, 3.1-LUFT-FEUER, S. 40",
        "courseLevel": "GK_LK",
        "granularity": "officialCompetencyBullet",
        "tags": [
          "source:bremen",
          "stage:SekI",
          "topic:3.1-LUFT-FEUER",
          "course:GK_LK"
        ],
        "rawSourceText": "Verbrennungsvoraussetzungen nennen und daraus Loeschtechniken ableiten",
        "rawSourceSpan": "3.1-LUFT-FEUER, S. 40",
        "rawParentBulletText": "Verbrennungsvoraussetzungen nennen und daraus Loeschtechniken ableiten"
      },
      "wholeOriginalPassage": {
        "id": "hb-chemistry-seki:3.1-LUFT-FEUER",
        "topicCode": "3.1-LUFT-FEUER",
        "title": "3.1-LUFT-FEUER Luft und Feuer",
        "text": "- Luft als Stoffgemisch beschreiben\n- Verbrennungsvoraussetzungen nennen und daraus Loeschtechniken ableiten\n- an Beispielen Energieumwandlungen mit eigenen Worten beschreiben\n- einfache Oxidationsreaktionen mithilfe der Fachsprache beschreiben und Reaktionsgleichungen aufstellen\n- Elemente, Verbindungen, Elementsymbole und Formeln unterscheiden\n- aus Versuchsergebnissen das Gesetz von der Erhaltung der Masse ableiten und es auf Alltagssituationen uebertragen\n- die Auswirkungen von Verbrennungsprodukten auf Umwelt und Gesundheit beschreiben\n- Diagramme lesen und erstellen\n- einfache Experimente sicherheitsgerecht durchfuehren, protokollieren und auswerten",
        "page": 40,
        "sourceDocumentKey": "HB_NW_GYM_2006",
        "sourcePath": "curricula/DE/Gymnasium/input/HB/Naturwissenschaften_Gymnasium_5_10_2006.pdf",
        "rawText": "- Luft als Stoffgemisch beschreiben\n- Verbrennungsvoraussetzungen nennen und daraus Loeschtechniken ableiten\n- an Beispielen Energieumwandlungen mit eigenen Worten beschreiben\n- einfache Oxidationsreaktionen mithilfe der Fachsprache beschreiben und Reaktionsgleichungen aufstellen\n- Elemente, Verbindungen, Elementsymbole und Formeln unterscheiden\n- aus Versuchsergebnissen das Gesetz von der Erhaltung der Masse ableiten und es auf Alltagssituationen uebertragen\n- die Auswirkungen von Verbrennungsprodukten auf Umwelt und Gesundheit beschreiben\n- Diagramme lesen und erstellen\n- einfache Experimente sicherheitsgerecht durchfuehren, protokollieren und auswerten",

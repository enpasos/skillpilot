      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:LK-moderne-werkstoffe-bewertungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "LK-moderne-werkstoffe-bewertungskompetenz",
        "title": "Qualifikationsphase Leistungskurs: Moderne Werkstoffe / Bewertungskompetenz",
        "page": 55,
        "rawText": "- bewerten den Einsatz von Erdöl und nachwachsenden Rohstoffen für die Herstellung und die Verwendung von Produkten aus Kunststoffen im Sinne einer nachhaltigen Entwicklung aus ökologischer, ökonomischer und sozialer Perspektive\n- vergleichen anhand von Bewertungskriterien Produkte aus unterschiedlichen Kunststoffen und leiten daraus Handlungsoptionen für die alltägliche Nutzung ab\n- bewerten stoffliche und energetische Verfahren der Kunststoffverwertung unter Berücksichtigung ausgewählter Nachhaltigkeitsziele\n- beurteilen die Bedeutung der Reaktionsbedingungen für die Synthese eines Kunststoffs im Hinblick auf Atomund Energieeffizienz, Abfallund Risikovermeidung sowie erneuerbare Ressourcen\n- recherchieren in verschiedenen Quellen die Chancen und Risiken von Nanomaterialien am Beispiel eines Alltagsproduktes und bewerten diese unter Berücksichtigung der Intention der Autoren",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-LK-moderne-werkstoffe-bewertungskompetenz-001-10aec9db",

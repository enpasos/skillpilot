      "wholeCurrentSourceGoal": {
        "id": "9be83d32-7f3e-50c6-ae44-092e769ab98e",
        "passageId": "c56cb89f-f41e-525b-bd9e-0bc8c152caa1",
        "topicCode": "BcP13.5",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "wählen Verfahren zur Herstellung mikroskopischer Präparate und anschließenden mikroskopischen Unters...",
        "description": "wählen Verfahren zur Herstellung mikroskopischer Präparate und anschließenden mikroskopischen Untersuchung von u. a. Mikroorganismen, Geweben und Zellen aus, um den mikroskopischen Aufbau verschiedener Funktionseinheiten von Lebewesen auf zellulärer Ebene zu untersuchen.",
        "sourceText": "wählen Verfahren zur Herstellung mikroskopischer Präparate und anschließenden mikroskopischen Untersuchung von u. a. Mikroorganismen, Geweben und Zellen aus, um den mikroskopischen Aufbau verschiedener Funktionseinheiten von Lebewesen auf zellulärer Ebene zu untersuchen.",
        "sourceSpan": "BcP13.5.1",
        "parentBulletText": "wählen Verfahren zur Herstellung mikroskopischer Präparate und anschließenden mikroskopischen Untersuchung von u. a. Mikroorganismen, Geweben und Zellen aus, um den mikroskopischen Aufbau verschiedener Funktionseinheiten von Lebewesen auf zellulärer Ebene zu untersuchen.",
        "sourceRef": "LehrplanPLUS Bayern Gymnasium Biologisch-chemisches Praktikum, BcP13.5.1",

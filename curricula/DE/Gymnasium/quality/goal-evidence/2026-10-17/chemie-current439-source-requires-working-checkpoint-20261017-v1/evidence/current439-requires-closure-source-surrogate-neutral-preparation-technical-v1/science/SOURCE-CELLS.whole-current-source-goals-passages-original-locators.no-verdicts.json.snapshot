      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:LK-sauren-basen-und-analytische-verfahren-bewertungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "LK-sauren-basen-und-analytische-verfahren-bewertungskompetenz",
        "title": "Qualifikationsphase Leistungskurs: Säuren, Basen und analytische Verfahren / Bewertungskompetenz",
        "page": 47,
        "rawText": "- beurteilen den Einsatz, die Wirksamkeit und das Gefahrenpotenzial von Säuren, Basen und Salzen als Inhaltsstoffe in Alltagsprodukten und leiten daraus begründet Handlungsoptionen ab\n- bewerten die Qualität von Produkten des Alltags oder Umweltparameter auf der Grundlage von qualitativen und quantitativen Analyseergebnissen und beurteilen die Daten hinsichtlich ihrer Aussagekraft\n- beurteilen verschiedene Säure-Base-Titrationsverfahren hinsichtlich ihrer Angemessenheit und Grenzen",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-LK-sauren-basen-und-analytische-verfahren-bewertungskompetenz-001-abcec9e7",

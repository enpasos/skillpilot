      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-gk-2023-2025-p034-001-a8659f16",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-gk-2023-2025:p034",
        "topicCode": "SL-CH-SEKII-GK-2023-2025-P034",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "geben die Säurekonstante KS und Basenkonstante KB als ein Maß für die Stärke einer Säure bzw. Base an",
        "description": "Die lernende Person kann geben die Säurekonstante KS und Basenkonstante KB als ein Maß für die Stärke einer Säure bzw. Base an.",
        "sourceText": "geben die Säurekonstante KS und Basenkonstante KB als ein Maß für die Stärke einer Säure bzw. Base an,",
        "sourceSpan": "Hauptphase Grundkurs, S. 34, Source-Ziel 1",
        "parentBulletText": "geben die Säurekonstante KS und Basenkonstante KB als ein Maß für die Stärke einer Säure bzw. Base an,",
        "sourceRef": "SL-CH-SEKII-GK-2023-2025 S. 34",
        "courseLevel": "GK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:GK",
          "sourceDocument:SL-CH-SEKII-GK-2023-2025",
          "sourcePage:34"
        ],
        "rawSourceText": "geben die Säurekonstante KS und Basenkonstante KB als ein Maß für die Stärke einer Säure bzw. Base an,",
        "rawSourceSpan": "Hauptphase Grundkurs, S. 34, Source-Ziel 1",
        "rawParentBulletText": "geben die Säurekonstante KS und Basenkonstante KB als ein Maß für die Stärke einer Säure bzw. Base an,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-gk-2023-2025:p034",
        "topicCode": "SL-CH-SEKII-GK-2023-2025-P034",
        "title": "Hauptphase Grundkurs: Kompetenzpassage S. 34",
        "text": "- geben die Säurekonstante KS und Basenkonstante KB als ein Maß für die Stärke einer Säure bzw. Base an,\n- definieren den Säureexponenten pKS und den Basenexponenten pKB als negativen dekadischen Logarithmus des Zahlenwertes der Säurekonstanten KS bzw. Basenkonstanten KB,\n- vergleichen die Stärke von Säuren und Basen anhand ihrer KSund KB-Werte bzw. ihrer pKSund pKB-Werte,\n- beurteilen den Ablauf von Protolysereaktionen anhand der KSund KB-Werte bzw. pKSund pKB-Werte,\n- leiten den mathematischen Zusammenhang zwischen KS, KB und KW bzw. pKS, pKB und pKW her,\n- begründen, dass der pH-Wert kein Maß für die Stärke einer Säure bzw. Base darstellt.",
        "page": 34,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Grundkurs_2023_ab_2027_red_2025.pdf",
        "sourceGoalIds": [

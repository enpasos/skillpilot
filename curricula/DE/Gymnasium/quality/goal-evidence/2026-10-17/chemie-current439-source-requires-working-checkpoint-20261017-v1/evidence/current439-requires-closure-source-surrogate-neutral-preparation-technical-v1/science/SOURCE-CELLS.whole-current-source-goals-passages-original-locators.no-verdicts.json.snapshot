        "wholePassagePointer": "/passages/21"
      },
      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-nw-2024-p031-005-d0e6cae8",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p031",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P031",
        "bulletIndex": 5,
        "aspectIndex": 1,
        "title": "geben Alltagsgegenstände (auch Gegenstände aus ihrem Haushalt) an, die auf Erdölprodukten basieren",
        "description": "Die lernende Person kann geben Alltagsgegenstände (auch Gegenstände aus ihrem Haushalt) an, die auf Erdölprodukten basieren.",
        "sourceText": "geben Alltagsgegenstände (auch Gegenstände aus ihrem Haushalt) an, die auf Erdölprodukten basieren,",
        "sourceSpan": "Einführungsphase NW-Zweig, S. 31, Source-Ziel 5",
        "parentBulletText": "geben Alltagsgegenstände (auch Gegenstände aus ihrem Haushalt) an, die auf Erdölprodukten basieren,",
        "sourceRef": "SL-CH-SEKII-EP-NW-2024 S. 31",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:GK_LK",
          "sourceDocument:SL-CH-SEKII-EP-NW-2024",
          "sourcePage:31"
        ],
        "rawSourceText": "geben Alltagsgegenstände (auch Gegenstände aus ihrem Haushalt) an, die auf Erdölprodukten basieren,",
        "rawSourceSpan": "Einführungsphase NW-Zweig, S. 31, Source-Ziel 5",
        "rawParentBulletText": "geben Alltagsgegenstände (auch Gegenstände aus ihrem Haushalt) an, die auf Erdölprodukten basieren,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-ep-nw-2024:p031",
        "topicCode": "SL-CH-SEKII-EP-NW-2024-P031",
        "title": "Einführungsphase NW-Zweig: Kompetenzpassage S. 31",
        "text": "- vergleichen konventionelle Förderung und Fracking hinsichtlich der Durchführung und der Risiken für die Umwelt,\n- recherchieren und bewerten Risiken des Transports von fossilen Brennstoffen für die Umwelt,\n- geben Maßnahmen zur Reduzierung der Umweltbelastungen an,\n- erläutern das Verfahren der fraktionierten Destillation,\n- geben Alltagsgegenstände (auch Gegenstände aus ihrem Haushalt) an, die auf Erdölprodukten basieren,\n- erstellen einen Überblick über die Bedeutung von Erdölprodukten für die pharmazeutische Chemie und die Polymerchemie.\n- erläutern die Herstellungsverfahren von Bioethanol, Biogas und Biodiesel,\n- erstellen einen tabellarischen Überblick über Ausgangsstoffe und Reaktionen zur Herstellung von Bioethanol, Biogas und Biodiesel,\n- geben die Reaktionsgleichung für die Herstellung von Bioethanol an.",
        "page": 31,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Einfuehrungsphase_naturwissenschaftlicher_Zweig_2024.pdf",
        "sourceGoalIds": [

      "wholeCurrentSourceGoal": {
        "id": "de-nw-chemie-sekii-klp-2022-LK-moderne-werkstoffe-bewertungskompetenz-005-2a61b1df",
        "passageId": "de-nw-chemie-sekii-klp-2022:LK-moderne-werkstoffe-bewertungskompetenz",
        "topicCode": "LK-moderne-werkstoffe-bewertungskompetenz",
        "title": "recherchieren in verschiedenen Quellen die Chancen und Risiken von Nanomaterialien am Beispiel eines Alltagsproduktes und bewerten diese unter Berücksichtigung der Intention der Autoren",
        "description": "Die lernende Person kann recherchieren in verschiedenen Quellen die Chancen und Risiken von Nanomaterialien am Beispiel eines Alltagsproduktes und bewerten diese unter Berücksichtigung der Intention der Autoren.",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "sourceRef": "Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Leistungskurs, Moderne Werkstoffe, Bewertungskompetenz, S. 56.",
        "sourceText": "recherchieren in verschiedenen Quellen die Chancen und Risiken von Nanomaterialien am Beispiel eines Alltagsproduktes und bewerten diese unter Berücksichtigung der Intention der Autoren",
        "sourceSpan": {
          "passageId": "de-nw-chemie-sekii-klp-2022:LK-moderne-werkstoffe-bewertungskompetenz",
          "label": "Qualifikationsphase Leistungskurs, Moderne Werkstoffe, Bewertungskompetenz, S. 56: recherchieren in verschiedenen Quellen die Chancen und Risiken von Nanomaterialien am Beispiel eines Alltagsproduktes und bewerten diese unter Berücksichtigung der Intention der Autoren"
        },

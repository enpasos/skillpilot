      "wholeCurrentSourceGoal": {
        "id": "mv-chem-sekii-mv-ch-sekii-2022-erprobung-q-struktur-eigenschaften-001-5e9110dc",
        "passageId": "mv-chemistry-sekii:q-struktur-eigenschaften",
        "topicCode": "Q-STRUKTUR-EIGENSCHAFTEN",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "Chemische Bindung, Struktur und Eigenschaften anorganischer Stoffe mit Elektronenpaarbindung, Ionenbindung und Metallbindung erklären",
        "description": "Die lernende Person kann Chemische Bindung, Struktur und Eigenschaften anorganischer Stoffe mit Elektronenpaarbindung, Ionenbindung und Metallbindung erklären.",
        "sourceText": "Chemische Bindung, Struktur und Eigenschaften anorganischer Stoffe mit Elektronenpaarbindung, Ionenbindung und Metallbindung erklären",
        "sourceSpan": "Qualifikationsphase, Qualifikationsphase: Stoffe, Strukturen und Eigenschaften, S. 14",
        "parentBulletText": "Chemische Bindung, Struktur und Eigenschaften anorganischer Stoffe mit Elektronenpaarbindung, Ionenbindung und Metallbindung erklären",
        "sourceRef": "Rahmenplan Chemie Qualifikationsphase gymnasiale Oberstufe Mecklenburg-Vorpommern 2022 Erprobungsfassung, Qualifikationsphase, Qualifikationsphase: Stoffe, Strukturen und Eigenschaften, S. 14",
        "courseLevel": "GK_LK",
        "granularity": "officialContentGoal",
        "tags": [

      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:EF-reaktionsgeschwindigkeit-und-chemisches-gleichgewicht-sachkompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "EF-reaktionsgeschwindigkeit-und-chemisches-gleichgewicht-sachkompetenz",
        "title": "Einführungsphase: Reaktionsgeschwindigkeit und chemisches Gleichgewicht / Sachkompetenz",
        "page": 29,
        "rawText": "- erklären den Einfluss eines Katalysators auf die Reaktionsgeschwindigkeit auch anhand grafischer Darstellungen\n- beschreiben die Merkmale eines chemischen Gleichgewichtes anhand ausgewählter Reaktionen\n- erklären anhand ausgewählter Reaktionen die Beeinflussung des chemischen Gleichgewichts nach dem Prinzip von Le Chatelier auch im Zusammenhang mit einem technischen Verfahren\n- bestimmen rechnerisch Gleichgewichtslagen ausgewählter Reaktionen mithilfe des Massenwirkungsgesetzes und interpretieren die Ergebnisse",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-EF-reaktionsgeschwindigkeit-und-chemisches-gleichgewicht-sachkompetenz-001-7a2ff13c",

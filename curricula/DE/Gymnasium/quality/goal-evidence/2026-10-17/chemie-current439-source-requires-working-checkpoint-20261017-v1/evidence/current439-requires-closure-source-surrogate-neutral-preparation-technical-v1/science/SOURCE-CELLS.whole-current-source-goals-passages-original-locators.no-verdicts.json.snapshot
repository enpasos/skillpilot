      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-spr-2024-p016-001-9fdf9fe3",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-spr-2024:p016",

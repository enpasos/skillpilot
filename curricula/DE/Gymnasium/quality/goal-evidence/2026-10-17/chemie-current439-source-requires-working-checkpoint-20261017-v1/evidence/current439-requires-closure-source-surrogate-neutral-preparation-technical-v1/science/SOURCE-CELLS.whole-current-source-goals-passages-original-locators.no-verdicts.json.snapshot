        "topicCode": "TH-CH-SekI-2.2.1.1-alkohole-und-carbonsauren",
        "bulletIndex": 119,
        "aspectIndex": 1,
        "title": "die Herstellung von Ethanol beschreiben und Reaktionsgleichungen formulieren: durch Addition",
        "description": "Die lernende Person kann die Herstellung von Ethanol beschreiben und Reaktionsgleichungen formulieren: durch Addition.",
        "sourceText": "die Herstellung von Ethanol beschreiben und Reaktionsgleichungen formulieren: durch Addition",
        "sourceSpan": "Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Alkohole und Carbonsäuren, PDF-S. 27",
        "parentBulletText": "die Herstellung von Ethanol beschreiben und Reaktionsgleichungen formulieren:",
        "sourceRef": "Lehrplan Gymnasium Chemie Thueringen 2024, Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Alkohole und Carbonsäuren, PDF-S. 27",
        "courseLevel": "GK_LK",
        "granularity": "officialCompetencyAspect",
        "tags": [
          "source:thueringen",
          "subject:Chemie",
          "stage:SekI",

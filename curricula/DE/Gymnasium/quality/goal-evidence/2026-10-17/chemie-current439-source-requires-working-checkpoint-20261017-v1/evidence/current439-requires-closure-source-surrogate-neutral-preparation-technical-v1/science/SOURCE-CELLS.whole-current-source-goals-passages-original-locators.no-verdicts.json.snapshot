      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:LK-elektrochemische-prozesse-und-energetik-erkenntnisgewinnungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "LK-elektrochemische-prozesse-und-energetik-erkenntnisgewinnungskompetenz",
        "title": "Qualifikationsphase Leistungskurs: Elektrochemische Prozesse und Energetik / Erkenntnisgewinnungskompetenz",
        "page": 50,
        "rawText": "- entwickeln Hypothesen zum Auftreten von Redoxreaktionen zwischen Metallund Nichtmetallatomen sowie Ionen und überprüfen diese experimentell\n- wenden das Verfahren der Redoxtitration zur Ermittlung der Konzentration eines Stoffes begründet an\n- ermitteln Messdaten ausgewählter galvanischer Zellen zur Einordnung in die elektrochemische Spannungsreihe\n- ermitteln die Ionenkonzentration von ausgewählten Metallund Nichtmetallionen mithilfe der Nernst-Gleichung aus Messdaten galvanischer Zellen\n- erklären die Herleitung elektrochemischer und thermodynamischer Gesetzmäßigkeiten (Faraday, Nernst, Gibbs-Helmholtz) aus experimentellen Daten\n- ermitteln die Leistung einer elektrochemischen Spannungsquelle an einem Beispiel\n- entwickeln Hypothesen zur Bildung von Lokalelementen als Grundlage von Korrosionsvorgängen und überprüfen diese experimentell\n- entwickeln ausgewählte Verfahren zum Korrosionsschutz (Galvanik, Opferanode) und führen diese durch\n- ermitteln die Standardreaktionsenthalpien ausgewählter Redoxreaktionen unter Anwendung des Satzes von Hess auch rechnerisch",
        "sourceGoalIds": [
          "de-nw-chemie-sekii-klp-2022-LK-elektrochemische-prozesse-und-energetik-erkenntnisgewinnungskompetenz-001-ed6522a5",

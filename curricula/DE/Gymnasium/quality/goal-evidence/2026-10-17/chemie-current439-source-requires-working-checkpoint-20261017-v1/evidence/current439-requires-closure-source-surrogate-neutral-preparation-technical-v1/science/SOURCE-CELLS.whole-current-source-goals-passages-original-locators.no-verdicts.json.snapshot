      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-gk-2023-2025-p042-001-a8810123",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-gk-2023-2025:p042",
        "topicCode": "SL-CH-SEKII-GK-2023-2025-P042",
        "bulletIndex": 1,
        "aspectIndex": 1,
        "title": "vergleichen Standardredoxpotenziale von Redoxpaaren und interpretieren diese hinsichtlich ihrer Bedeutung für den Ablauf von Redoxreaktionen",
        "description": "Die lernende Person kann vergleichen Standardredoxpotenziale von Redoxpaaren und interpretieren diese hinsichtlich ihrer Bedeutung für den Ablauf von Redoxreaktionen.",
        "sourceText": "vergleichen Standardredoxpotenziale von Redoxpaaren und interpretieren diese hinsichtlich ihrer Bedeutung für den Ablauf von Redoxreaktionen,",
        "sourceSpan": "Hauptphase Grundkurs, S. 42, Source-Ziel 1",
        "parentBulletText": "vergleichen Standardredoxpotenziale von Redoxpaaren und interpretieren diese hinsichtlich ihrer Bedeutung für den Ablauf von Redoxreaktionen,",
        "sourceRef": "SL-CH-SEKII-GK-2023-2025 S. 42",
        "courseLevel": "GK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekII",
          "courseLevel:GK",
          "sourceDocument:SL-CH-SEKII-GK-2023-2025",
          "sourcePage:42"
        ],
        "rawSourceText": "vergleichen Standardredoxpotenziale von Redoxpaaren und interpretieren diese hinsichtlich ihrer Bedeutung für den Ablauf von Redoxreaktionen,",
        "rawSourceSpan": "Hauptphase Grundkurs, S. 42, Source-Ziel 1",
        "rawParentBulletText": "vergleichen Standardredoxpotenziale von Redoxpaaren und interpretieren diese hinsichtlich ihrer Bedeutung für den Ablauf von Redoxreaktionen,"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-sekii:sl-ch-sekii-gk-2023-2025:p042",
        "topicCode": "SL-CH-SEKII-GK-2023-2025-P042",
        "title": "Hauptphase Grundkurs: Kompetenzpassage S. 42",
        "text": "- vergleichen Standardredoxpotenziale von Redoxpaaren und interpretieren diese hinsichtlich ihrer Bedeutung für den Ablauf von Redoxreaktionen,\n- erklären die pH-Abhängigkeit von Redoxpotenzialen mit Hilfe des chemischen Gleichgewichts,\n- beschreiben den Aufbau des DANIELL-Elementes,\n- erklären die Entstehung der Potenzialdifferenz (Spannung) zwischen den Halbzellen,\n- erklären die Funktionsweise eines Galvanischen Elementes unter Verwendung geeigneter Reaktionsgleichungen,\n- untersuchen den Einfluss der Art der Elektroden, der Elektrolytlösung, der Elektrodenfläche und des Abstands der Elektroden auf die Spannung und die Stromstärke.",
        "page": 42,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_GOS_Grundkurs_2023_ab_2027_red_2025.pdf",
        "sourceGoalIds": [

      "wholeCurrentSourceGoal": {
        "id": "bb-chemistry-sekii-rlp-3-2-3-inhalte-003-02de6d5f",
        "passageId": "bb-chemistry-sekii-rlp-3-2-3",
        "topicCode": "3.2.3",
        "topicTitle": "Chemische Thermodynamik",
        "category": "Inhalte",
        "title": "Zusammenhang zwischen Temperatur, kinetischer Energie der Teilchen und Aggregatzustand des Stoffes",
        "description": "Die lernende Person kann Zusammenhang zwischen Temperatur, kinetischer Energie der Teilchen und Aggregatzustand des Stoffes fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.2.3 Chemische Thermodynamik, S. 34.",
        "sourceText": "Zusammenhang zwischen Temperatur, kinetischer Energie der Teilchen und Aggregatzustand des Stoffes",
        "sourceSpan": {

        "sourceGoalPointer": "/sourceGoals/31",
        "sourceGoalFieldCanonicalSHA256": "97d6d0427a12c6da5d6c7c14008ba53f0dc772c63129b34880b738cc56596266",
        "wholePassagePointer": "/passages/3"
      },
      "wholeCurrentSourceGoal": {
        "id": "de-hh-chemie-sekii-bildungsplan-2022-2-1-032-35313854",
        "passageId": "de-hh-chemie-sekii-bildungsplan-2022:2-1",
        "topicCode": "2.1",
        "title": "Energieumwandlung, Energieerhaltung und Kalorimetrie bei chemischen Reaktionen beschreiben",
        "description": "Die lernende Person kann Energieumwandlung, Energieerhaltung und Kalorimetrie bei chemischen Reaktionen beschreiben.",
        "sourceDocumentKey": "HH-CHEMIE-GYO-2022",
        "sourceRef": "Hamburg Bildungsplan Studienstufe Chemie 2022, 2.1, S. 27.",
        "sourceText": "Energieumwandlung, Energieerhaltung und Kalorimetrie bei chemischen Reaktionen beschreiben",
        "sourceSpan": {
          "passageId": "de-hh-chemie-sekii-bildungsplan-2022:2-1",
          "label": "2.1, S. 27: Energieumwandlung, Energieerhaltung und Kalorimetrie bei chemischen Reaktionen beschreiben"
        },
        "courseLevel": "GK_LK",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-HH",
          "stage:SekII",
          "section:2-1",
          "courseLevel:GK_LK"
        ],
        "metadata": {
          "extractionMethod": "manual-transcription-from-official-hamburg-pdf-passages",
          "sectionCode": "2.1"
        }
      },
      "wholeOriginalPassage": {
        "id": "de-hh-chemie-sekii-bildungsplan-2022:2-1",
        "sourceDocumentKey": "HH-CHEMIE-GYO-2022",
        "topicCode": "2.1",
        "title": "2.1 Energie chemischer Reaktionen",
        "page": 27,
        "rawText": "- Energieumwandlung, Energieerhaltung und Kalorimetrie bei chemischen Reaktionen beschreiben\n- Reaktionswaerme experimentell bestimmen\n- den ersten Hauptsatz der Thermodynamik mit Enthalpie und Satz von Hess anwenden\n- Standard-Reaktionsenthalpien berechnen\n- Brennwert und Heizwert verschiedener Energietraeger fakultativ einordnen\n- Entropie und Gibbs-Helmholtz-Gleichung als zweiten Hauptsatz der Thermodynamik nutzen\n- freie Reaktionsenthalpie berechnen",
        "sourceGoalIds": [

        "sourceSpan": "17.2 Umweltanalytik, Source-Ziel 5",
        "parentBulletText": "Wirkungsgradoptimierung durch angepasste Technologien",
        "sourceRef": "RP-CH-SEKII-2022 S. 27",
        "courseLevel": "LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-RP",
          "stage:SekII",
          "topic:baustein-17-2",

      "wholeCurrentSourceGoal": {
        "id": "bb-chemistry-sekii-rlp-3-2-6-inhalte-001-f0b7a06d",
        "passageId": "bb-chemistry-sekii-rlp-3-2-6",
        "topicCode": "3.2.6",
        "topicTitle": "Säure-Base-Reaktionen",
        "category": "Inhalte",
        "title": "Donator-Akzeptor-Prinzip von Protolysereaktionen",
        "description": "Die lernende Person kann Donator-Akzeptor-Prinzip von Protolysereaktionen fachlich einordnen und anwenden.",
        "sourceDocumentKey": "RLP-GOST-CHEMIE-2022",
        "sourceRef": "Rahmenlehrplan Berlin-Brandenburg Gymnasiale Oberstufe Teil C Chemie 2022, 3.2.6 Säure-Base-Reaktionen, S. 44.",
        "sourceText": "Donator-Akzeptor-Prinzip von Protolysereaktionen",
        "sourceSpan": {
          "passageId": "bb-chemistry-sekii-rlp-3-2-6",
          "label": "Inhalte: Donator-Akzeptor-Prinzip von Protolysereaktionen"
        },
        "courseLevel": "unspecified",

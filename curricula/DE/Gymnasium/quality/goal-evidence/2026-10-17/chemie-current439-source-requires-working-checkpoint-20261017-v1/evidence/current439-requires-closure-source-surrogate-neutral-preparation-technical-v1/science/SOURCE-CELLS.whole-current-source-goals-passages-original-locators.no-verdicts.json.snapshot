      "wholeCurrentSourceGoal": {
        "id": "de-nw-chemie-sekii-klp-2022-LK-sauren-basen-und-analytische-verfahren-erkenntnisgewinnungskompetenz-001-267cfa72",
        "passageId": "de-nw-chemie-sekii-klp-2022:LK-sauren-basen-und-analytische-verfahren-erkenntnisgewinnungskompetenz",
        "topicCode": "LK-sauren-basen-und-analytische-verfahren-erkenntnisgewinnungskompetenz",
        "title": "weisen ausgewählte Ionensorten (Halogenid-Ionen, Ammonium-Ionen, Carbonat-Ionen) salzartiger Verbindungen qualitativ nach",
        "description": "Die lernende Person kann weisen ausgewählte Ionensorten (Halogenid-Ionen, Ammonium-Ionen, Carbonat-Ionen) salzartiger Verbindungen qualitativ nach.",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "sourceRef": "Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Leistungskurs, Säuren, Basen und analytische Verfahren, Erkenntnisgewinnungskompetenz, S. 47.",
        "sourceText": "weisen ausgewählte Ionensorten (Halogenid-Ionen, Ammonium-Ionen, Carbonat-Ionen) salzartiger Verbindungen qualitativ nach",
        "sourceSpan": {
          "passageId": "de-nw-chemie-sekii-klp-2022:LK-sauren-basen-und-analytische-verfahren-erkenntnisgewinnungskompetenz",
          "label": "Qualifikationsphase Leistungskurs, Säuren, Basen und analytische Verfahren, Erkenntnisgewinnungskompetenz, S. 47: weisen ausgewählte Ionensorten (Halogenid-Ionen, Ammonium-Ionen, Carbonat-Ionen) salzartiger Verbindungen qualitativ nach"
        },
        "courseLevel": "LK",

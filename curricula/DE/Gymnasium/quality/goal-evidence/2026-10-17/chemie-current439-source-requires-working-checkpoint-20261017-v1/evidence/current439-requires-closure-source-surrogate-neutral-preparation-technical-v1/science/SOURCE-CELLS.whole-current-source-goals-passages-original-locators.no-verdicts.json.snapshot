      "wholeCurrentSourceGoal": {
        "id": "sl-chem-seki-sl-ch-seki-9-2025-p023-009-08251147",
        "passageId": "sl-chemistry-seki:sl-ch-seki-9-2025:p023",
        "topicCode": "SL-CH-SEKI-9-2025-P023",
        "bulletIndex": 9,
        "aspectIndex": 1,
        "title": "führen Experimente zur Salzbildung aus unedlen Metallen mit Halogenwasserstoffsäuren durch und werten diese aus. Hinweise zum Sprachsensiblen Fachunterricht „Die Elemente der 8....",
        "description": "Die lernende Person kann führen Experimente zur Salzbildung aus unedlen Metallen mit Halogenwasserstoffsäuren durch und werten diese aus. Hinweise zum Sprachsensiblen Fachunterricht „Die Elemente der 8. Hauptgruppe nennst du Edelgase.“ „Die Reaktionsbereitschaft der Halogene kannst du mit ihrer Ste „Du kannst die Alkalimetalle nach ihrer Reaktionsbereitschaft m „Geladene Teilchen nennst du Ionen.“.",
        "sourceText": "führen Experimente zur Salzbildung aus unedlen Metallen mit Halogenwasserstoffsäuren durch und werten diese aus. Hinweise zum Sprachsensiblen Fachunterricht „Die Elemente der 8. Hauptgruppe nennst du Edelgase.“ „Die Reaktionsbereitschaft der Halogene kannst du mit ihrer Ste „Du kannst die Alkalimetalle nach ihrer Reaktionsbereitschaft m „Geladene Teilchen nennst du Ionen.“",
        "sourceSpan": "Klasse 9, S. 23, Source-Ziel 9",
        "parentBulletText": "führen Experimente zur Salzbildung aus unedlen Metallen mit Halogenwasserstoffsäuren durch und werten diese aus. Hinweise zum Sprachsensiblen Fachunterricht „Die Elemente der 8. Hauptgruppe nennst du Edelgase.“ „Die Reaktionsbereitschaft der Halogene kannst du mit ihrer Ste „Du kannst die Alkalimetalle nach ihrer Reaktionsbereitschaft m „Geladene Teilchen nennst du Ionen.“",
        "sourceRef": "SL-CH-SEKI-9-2025 S. 23",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [
          "jurisdiction:DE-SL",
          "stage:SekI",
          "courseLevel:GK_LK",
          "sourceDocument:SL-CH-SEKI-9-2025",
          "sourcePage:23"
        ],
        "rawSourceText": "führen Experimente zur Salzbildung aus unedlen Metallen mit Halogenwasserstoffsäuren durch und werten diese aus. Hinweise zum Sprachsensiblen Fachunterricht „Die Elemente der 8. Hauptgruppe nennst du Edelgase.“ „Die Reaktionsbereitschaft der Halogene kannst du mit ihrer Ste „Du kannst die Alkalimetalle nach ihrer Reaktionsbereitschaft m „Geladene Teilchen nennst du Ionen.“",
        "rawSourceSpan": "Klasse 9, S. 23, Source-Ziel 9",
        "rawParentBulletText": "führen Experimente zur Salzbildung aus unedlen Metallen mit Halogenwasserstoffsäuren durch und werten diese aus. Hinweise zum Sprachsensiblen Fachunterricht „Die Elemente der 8. Hauptgruppe nennst du Edelgase.“ „Die Reaktionsbereitschaft der Halogene kannst du mit ihrer Ste „Du kannst die Alkalimetalle nach ihrer Reaktionsbereitschaft m „Geladene Teilchen nennst du Ionen.“"
      },
      "wholeOriginalPassage": {
        "id": "sl-chemistry-seki:sl-ch-seki-9-2025:p023",
        "topicCode": "SL-CH-SEKI-9-2025-P023",
        "title": "Klasse 9: Kompetenzpassage S. 23",
        "text": "- unterscheiden zwischen Atomund Molekül-Ionen,\n- geben die Ladung wichtiger Ionen an (Wasserstoff-, Alkalimetall-, Erdalkalimetall-, Säurerestund Hydroxid-Ionen),\n- erklären Salze als Verbindungen aus Metallkomponente und Säurerest,\n- wenden die Nomenklaturregeln zur Benennung binärer Salze an,\n- führen Nachweisreaktionen auf Halogenide durch,\n- beschreiben ein Experiment zur Neutralisation,\n- stellen Reaktionsgleichungen der Reaktionen von Alkalibzw. Erdalkalimetallhydroxiden mit Halogenwasserstoffsäuren auf,\n- führen Neutralisationsexperimente selbstständig durch,\n- führen Experimente zur Salzbildung aus unedlen Metallen mit Halogenwasserstoffsäuren durch und werten diese aus. Hinweise zum Sprachsensiblen Fachunterricht „Die Elemente der 8. Hauptgruppe nennst du Edelgase.“ „Die Reaktionsbereitschaft der Halogene kannst du mit ihrer Ste „Du kannst die Alkalimetalle nach ihrer Reaktionsbereitschaft m „Geladene Teilchen nennst du Ionen.“",
        "page": 23,
        "sourcePath": "curricula/DE/Gymnasium/input/SL/Chemie_Gymnasium_G9_Klasse_9_2025.pdf",

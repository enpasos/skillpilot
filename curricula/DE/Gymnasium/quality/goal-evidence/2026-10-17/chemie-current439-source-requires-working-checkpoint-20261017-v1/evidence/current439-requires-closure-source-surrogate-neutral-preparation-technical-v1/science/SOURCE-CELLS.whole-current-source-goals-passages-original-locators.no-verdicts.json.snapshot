      "wholeCurrentSourceGoal": {
        "id": "sl-chem-sekii-sl-ch-sekii-ep-spr-2024-p014-006-1e530bb0",
        "passageId": "sl-chemistry-sekii:sl-ch-sekii-ep-spr-2024:p014",
        "topicCode": "SL-CH-SEKII-EP-SPR-2024-P014",
        "bulletIndex": 6,
        "aspectIndex": 1,
        "title": "vergleichen die Bindungsstärken polarer und unpolarer Atombindungen",
        "description": "Die lernende Person kann vergleichen die Bindungsstärken polarer und unpolarer Atombindungen.",
        "sourceText": "vergleichen die Bindungsstärken polarer und unpolarer Atombindungen,",
        "sourceSpan": "Einführungsphase sprachlicher Zweig, S. 14, Source-Ziel 6",
        "parentBulletText": "vergleichen die Bindungsstärken polarer und unpolarer Atombindungen,",
        "sourceRef": "SL-CH-SEKII-EP-SPR-2024 S. 14",

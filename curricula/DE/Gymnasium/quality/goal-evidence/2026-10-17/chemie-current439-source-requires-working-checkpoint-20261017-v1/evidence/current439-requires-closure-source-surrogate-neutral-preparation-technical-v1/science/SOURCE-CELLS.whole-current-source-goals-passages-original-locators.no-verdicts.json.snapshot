        "wholePassagePointer": "/passages/6"
      },
      "wholeCurrentSourceGoal": {
        "id": "de-nw-chemie-sekii-klp-2022-GK-sauren-basen-und-analytische-verfahren-sachkompetenz-001-74732954",
        "passageId": "de-nw-chemie-sekii-klp-2022:GK-sauren-basen-und-analytische-verfahren-sachkompetenz",
        "topicCode": "GK-sauren-basen-und-analytische-verfahren-sachkompetenz",
        "title": "klassifizieren die auch in Alltagsprodukten identifizierten Säuren und Basen mithilfe des Säure-Base-Konzepts von Brønsted und erläutern ihr Reaktionsverhalten unter Berücksichtigung von Protolysegleichungen",
        "description": "Die lernende Person kann klassifizieren die auch in Alltagsprodukten identifizierten Säuren und Basen mithilfe des Säure-Base-Konzepts von Brønsted und erläutern ihr Reaktionsverhalten unter Berücksichtigung von Protolysegleichungen.",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "sourceRef": "Nordrhein-Westfalen Kernlehrplan Chemie Gymnasiale Oberstufe 2022, Qualifikationsphase Grundkurs, Säuren, Basen und analytische Verfahren, Sachkompetenz, S. 37.",
        "sourceText": "klassifizieren die auch in Alltagsprodukten identifizierten Säuren und Basen mithilfe des Säure-Base-Konzepts von Brønsted und erläutern ihr Reaktionsverhalten unter Berücksichtigung von Protolysegleichungen",
        "sourceSpan": {
          "passageId": "de-nw-chemie-sekii-klp-2022:GK-sauren-basen-und-analytische-verfahren-sachkompetenz",
          "label": "Qualifikationsphase Grundkurs, Säuren, Basen und analytische Verfahren, Sachkompetenz, S. 37: klassifizieren die auch in Alltagsprodukten identifizierten Säuren und Basen mithilfe des Säure-Base-Konzepts von Brønsted und erläutern ihr Reaktionsverhalten unter Berücksichtigung von Protolysegleichungen"
        },
        "courseLevel": "GK",

        "topicCode": "SL-CH-SEKI-9-2025-P023",
        "bulletIndex": 6,
        "aspectIndex": 1,
        "title": "beschreiben ein Experiment zur Neutralisation",
        "description": "Die lernende Person kann beschreiben ein Experiment zur Neutralisation.",
        "sourceText": "beschreiben ein Experiment zur Neutralisation,",
        "sourceSpan": "Klasse 9, S. 23, Source-Ziel 6",
        "parentBulletText": "beschreiben ein Experiment zur Neutralisation,",
        "sourceRef": "SL-CH-SEKI-9-2025 S. 23",
        "courseLevel": "GK_LK",
        "granularity": "source-atom",
        "tags": [

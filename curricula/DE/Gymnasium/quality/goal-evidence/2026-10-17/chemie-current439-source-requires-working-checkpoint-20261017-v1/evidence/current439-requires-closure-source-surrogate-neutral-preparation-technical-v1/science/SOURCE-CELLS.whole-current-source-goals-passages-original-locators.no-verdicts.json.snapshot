      "wholeOriginalPassage": {
        "id": "de-nw-chemie-sekii-klp-2022:EF-organische-stoffklassen-erkenntnisgewinnungskompetenz",
        "sourceDocumentKey": "NW-KLP-CHEMIE-SEKII-2022",
        "topicCode": "EF-organische-stoffklassen-erkenntnisgewinnungskompetenz",
        "title": "Einführungsphase: Organische Stoffklassen / Erkenntnisgewinnungskompetenz",
        "page": 27,
        "rawText": "- stellen auch unter Nutzung digitaler Werkzeuge die Molekülgeometrie von Kohlenstoffverbindungen dar und erklären die Molekülgeometrie mithilfe des EPA-Modells\n- deuten die Beobachtungen von Experimenten zur Oxidationsreihe der Alkanole und weisen die jeweiligen Produkte nach\n- führen Estersynthesen durch und leiten aus Stoffeigenschaften der erhaltenen Produkte Hypothesen zum strukturellen Aufbau der Estergruppe ab\n- stellen Hypothesen zu Struktureigenschaftsbeziehungen einer ausgewählten Stoffklasse auf und untersuchen diese experimentell",
        "sourceGoalIds": [

      "wholeCurrentSourceGoal": {
        "id": "st-chem-seki-st-schuljahrgang-9-ausgewahlte-derivate-der-alkane-untersuchen-208-8549349e",
        "passageId": "st-chemistry-seki:st-schuljahrgang-9-ausgewahlte-derivate-der-alkane-untersuchen",
        "topicCode": "ST-schuljahrgang-9-ausgewahlte-derivate-der-alkane-untersuchen",
        "bulletIndex": 208,
        "aspectIndex": 1,
        "title": "Erkenntnisgewinnungskompetenz: Reaktionsverhalten der Ethansäure untersuchen",
        "description": "Die lernende Person kann Erkenntnisgewinnungskompetenz: Reaktionsverhalten der Ethansäure untersuchen.",
        "sourceText": "Erkenntnisgewinnungskompetenz: Reaktionsverhalten der Ethansäure untersuchen",
        "sourceSpan": "Schuljahrgang 9, Ausgewählte Derivate der Alkane untersuchen, Erkenntnisgewinnungskompetenz, PDF-S. 32",

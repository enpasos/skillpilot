      "wholeCurrentSourceGoal": {
        "id": "de-sh-chemie-seki-fachanforderungen-2022-3-verbindliche-inhalte-043-d4565f6f",
        "passageId": "de-sh-chemie-seki-fachanforderungen-2022:3-verbindliche-inhalte",
        "topicCode": "3-verbindliche-inhalte",
        "title": "Verbrennungsreaktionen der Alkane und Alkanole",
        "description": "Die lernende Person kann Verbrennungsreaktionen der Alkane und Alkanole.",
        "sourceDocumentKey": "SH-FA-CHEMIE-SEK-2022",
        "sourceRef": "Schleswig-Holstein Fachanforderungen Chemie Sekundarstufe I/II 2022, 3 Verbindliche Inhalte, S. 26.",
        "sourceText": "Verbrennungsreaktionen der Alkane und Alkanole",
        "sourceSpan": {
          "passageId": "de-sh-chemie-seki-fachanforderungen-2022:3-verbindliche-inhalte",
          "label": "3 Verbindliche Inhalte, S. 26: Verbrennungsreaktionen der Alkane und Alkanole"
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-SH",
          "stage:SekI",
          "section:3-verbindliche-inhalte",

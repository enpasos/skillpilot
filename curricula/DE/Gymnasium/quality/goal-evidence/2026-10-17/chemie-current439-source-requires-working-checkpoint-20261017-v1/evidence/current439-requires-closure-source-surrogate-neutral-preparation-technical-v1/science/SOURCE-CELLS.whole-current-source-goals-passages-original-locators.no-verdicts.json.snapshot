      "wholeCurrentSourceGoal": {
        "id": "th-chem-seki-th-ch-seki-2-2-1-1-kohlenwasserstoffe-115-02-78758867",
        "passageId": "th-chemistry-seki:th-ch-seki-2-2-1-1-kohlenwasserstoffe",
        "topicCode": "TH-CH-SekI-2.2.1.1-kohlenwasserstoffe",
        "bulletIndex": 115,
        "aspectIndex": 2,
        "title": "den Molekülbau von Ethen und Ethin als Vertreter ungesättigter Kohlenwasserstoffe beschreiben: Valenzstrichformel und Halbstrukturformel",
        "description": "Die lernende Person kann den Molekülbau von Ethen und Ethin als Vertreter ungesättigter Kohlenwasserstoffe beschreiben: Valenzstrichformel und Halbstrukturformel.",
        "sourceText": "den Molekülbau von Ethen und Ethin als Vertreter ungesättigter Kohlenwasserstoffe beschreiben: Valenzstrichformel und Halbstrukturformel",
        "sourceSpan": "Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Kohlenwasserstoffe, PDF-S. 27",
        "parentBulletText": "den Molekülbau von Ethen und Ethin als Vertreter ungesättigter Kohlenwasserstoffe beschreiben:",
        "sourceRef": "Lehrplan Gymnasium Chemie Thueringen 2024, Klassenstufen 9/10, 2.2.1.1 Kohlenstoff und Kohlenstoffverbindungen, Kohlenwasserstoffe, PDF-S. 27",
        "courseLevel": "GK_LK",
        "granularity": "officialCompetencyAspect",
        "tags": [
          "source:thueringen",
          "subject:Chemie",
          "stage:SekI",

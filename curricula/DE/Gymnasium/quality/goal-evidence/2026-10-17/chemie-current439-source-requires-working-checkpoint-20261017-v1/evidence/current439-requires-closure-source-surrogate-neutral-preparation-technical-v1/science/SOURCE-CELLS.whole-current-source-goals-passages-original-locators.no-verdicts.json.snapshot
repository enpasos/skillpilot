          "be-chemistry-sekii-rlp-3-1-7-inhalte-006-695c3af1",
          "be-chemistry-sekii-rlp-3-1-7-inhalte-007-06601142",
          "be-chemistry-sekii-rlp-3-1-7-inhalte-008-b5081400"
        ]

      "wholeCurrentSourceGoal": {
        "id": "de-sh-chemie-seki-fachanforderungen-2022-2-2-1-stoff-teilchen-konzept-004-07a73a45",
        "passageId": "de-sh-chemie-seki-fachanforderungen-2022:2-2-1-stoff-teilchen-konzept",
        "topicCode": "2-2-1-stoff-teilchen-konzept",
        "title": "erklären den Aufbau der Stoffe und Stoffgemische mithilfe eines Teilchenmodells.",
        "description": "Die lernende Person kann erklären den Aufbau der Stoffe und Stoffgemische mithilfe eines Teilchenmodells.",
        "sourceDocumentKey": "SH-FA-CHEMIE-SEK-2022",
        "sourceRef": "Schleswig-Holstein Fachanforderungen Chemie Sekundarstufe I/II 2022, 2.2.1 Stoff-Teilchen-Konzept, S. 20.",
        "sourceText": "erklären den Aufbau der Stoffe und Stoffgemische mithilfe eines Teilchenmodells.",
        "sourceSpan": {
          "passageId": "de-sh-chemie-seki-fachanforderungen-2022:2-2-1-stoff-teilchen-konzept",
          "label": "2.2.1 Stoff-Teilchen-Konzept, S. 20: erklären den Aufbau der Stoffe und Stoffgemische mithilfe eines Teilchenmodells."
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-SH",
          "stage:SekI",
          "section:2-2-1-stoff-teilchen-konzept",

        "sourceGoalPointer": "/sourceGoals/9",
        "sourceGoalFieldCanonicalSHA256": "ec40572355ac143ed6df7567cdf3b76fb01c34bcc4622255bfd71276e111c62c",
        "wholePassagePointer": "/passages/1"
      },
      "wholeCurrentSourceGoal": {
        "id": "de-hh-chemie-seki-bildungsplan-2014-2018-3-1-uf-j10-010-84a725c6",
        "passageId": "de-hh-chemie-seki-bildungsplan-2014-2018:3-1-uf-j10",
        "topicCode": "3.1-UF-J10",
        "title": "aus Stoffeigenschaften auf Verwendungsmöglichkeiten sowie damit verbundene Vor- und Nachteile schliessen",
        "description": "Die lernende Person kann aus Stoffeigenschaften auf Verwendungsmöglichkeiten sowie damit verbundene Vor- und Nachteile schliessen.",
        "sourceDocumentKey": "HH-CHEMIE-GYM-SEKI",
        "sourceRef": "Hamburg Bildungsplan Gymnasium Sekundarstufe I Chemie, 3.1-UF-J10, S. 19.",
        "sourceText": "aus Stoffeigenschaften auf Verwendungsmöglichkeiten sowie damit verbundene Vor- und Nachteile schliessen",
        "sourceSpan": {
          "passageId": "de-hh-chemie-seki-bildungsplan-2014-2018:3-1-uf-j10",
          "label": "3.1-UF-J10, S. 19: aus Stoffeigenschaften auf Verwendungsmöglichkeiten sowie damit verbundene Vor- und Nachteile schliessen"
        },
        "courseLevel": "unspecified",
        "tags": [
          "subject:Chemie",
          "jurisdiction:DE-HH",
          "stage:SekI",
          "section:3-1-uf-j10",
          "courseLevel:unspecified"
        ],
        "metadata": {
          "extractionMethod": "manual-transcription-from-official-hamburg-pdf-passages",

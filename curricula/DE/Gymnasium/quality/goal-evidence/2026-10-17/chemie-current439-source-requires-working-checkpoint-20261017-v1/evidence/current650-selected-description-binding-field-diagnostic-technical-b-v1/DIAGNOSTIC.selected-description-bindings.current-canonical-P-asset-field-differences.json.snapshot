        "oldPageStockFingerprint": "sha256:477a9d7694c60aa753eaa3a55c09f41c299cc71566012733186bd62668ebcf55",
        "profileFingerprint": "sha256:2e72b5a40638363cf9cc149ea6fd90ae459642d49b9b987b100a5d65c58ddd75",

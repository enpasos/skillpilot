        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Bindungs- und Molekülpolarität ableiten",
          "url": "/assets/goal-visualizations/chemie/747c5777-07d7-51a9-9be3-7d0d6f51d4e2/747c5777-07d7-51a9-9be3-7d0d6f51d4e2.png",
          "altText": "Schematische ladungscodierte Oberflächen: Bei HCl ist H blau und δ+, Cl rot und δ−; das Molekül ist polar. Im linearen CO₂ sind beide O-Enden rot und δ−, C blau und δ+. Die entgegengesetzten Bindungsdipole heben sich auf, CO₂ ist unpolar. Blau bedeutet elektronenarm, Rot elektronenreich.",
          "originalDigest": "sha256:d5a0c71d88d4939975e11c97365df4d1389e28866df06fd574f9bb17f29e5b5e",
          "qaStatus": "review_candidate",
          "approvedForPublication": false
        }
      },
      "finalTextDifferences": [],
      "oldInputTextDifferences": [],
      "canonicalContextDifferences": [],
      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "content-specific-understanding",
                "essentialUnderstandingDe": "Bindungspolarität folgt ungleicher Anziehung der Bindungselektronen; der Moleküldipol hängt zusätzlich von Geometrie und vektorieller Überlagerung ab. Farbige Oberflächen benötigen eine ausdrückliche Legende.",
                "essentialUnderstandingEn": "Bond polarity follows unequal attraction of bonding electrons; a molecular dipole additionally depends on geometry and vector combination. Coloured surfaces require an explicit legend.",
                "observablePerformanceDe": "HClΔEN1,0:Hδ+/Clδ− und Nettodipol. C–OΔEN0,8:Cδ+/Oδ−; im linearenCO2 heben zwei gleichgroße entgegengesetzte Bindungsdipole einander auf. Farben kodieren gemäß Legende lokale Verteilung, nicht die Gesamtladung oder eine absolute Elektronenzahl.",
                "observablePerformanceEn": "HClΔEN1.0:Hδ+/Clδ− and net dipole. C–OΔEN0.8:Cδ+/Oδ−; two equal opposite bond dipoles cancel in linearCO2. Colours encode local distribution according to the legend, not total charge or absolute electron count."
              },
              {
                "id": "fresh-transfer-and-model-boundary",
                "essentialUnderstandingDe": "Partialladungen sind keine freienH+-/O2−-Ionen in einem Wassermolekül; eine Farbgrafik ohne Zahlen liefert keine absolute Ladung.",
                "essentialUnderstandingEn": "Partial charges are not freeH+/O2− ions inside a water molecule; an unnumbered colour graphic gives no absolute charge.",
                "observablePerformanceDe": "O–HΔEN1,2;Oδ−,Hδ+. Die gewinkelte Geometrie verhindert vollständige Aufhebung, daher Nettodipol. Die Person liest die jeweilige Legende statt „rot immer negativ“ zu memorieren und unterscheidet Dichte, elektrostatische Farbkodierung und Ionenladung.",
                "observablePerformanceEn": "O–HΔEN1.2;Oδ−,Hδ+. Bent geometry prevents complete cancellation, giving a net dipole. The learner reads each legend rather than memorising “red always negative”, distinguishing density, electrostatic colour coding and ionic charge."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "content-specific-understanding",
                "fresh-transfer-and-model-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-material-variation",
                "textDe": "HCl, linearesCO2 und gewinkeltesH2O; Dichtebild gegenüber ladungscodierter Oberfläche.",
                "textEn": "HCl, linearCO2 and bentH2O; density image versus charge-coded surface."
              },
              {
                "id": "specific-model-limit",
                "textDe": "Partialladungen sind keine freienH+-/O2−-Ionen in einem Wassermolekül; eine Farbgrafik ohne Zahlen liefert keine absolute Ladung.",
                "textEn": "Partial charges are not freeH+/O2− ions inside a water molecule; an unnumbered colour graphic gives no absolute charge."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next25-747c5777-case-1",
                "taskDemandDe": "Gegeben EN:H2,2;C2,6;O3,4;Cl3,2. HCl ist zweiatomig, CO2 linear180°. Schematische Oberflächenkarte CO2:[rot O]—[blau C]—[rot O]; Legende rot=elektronenreicher/δ−,blau=elektronenärmer/δ+. Eine separate Dichtekarte für HCl zeigt stärkere Dichte auf der Cl-Seite. BerechneΔEN, markiere Partialladungen und deute beide Darstellungsarten. Begründe unterschiedliche Nettodipole trotz polarer Bindungen.",
                "taskDemandEn": "Given EN:H2.2;C2.6;O3.4;Cl3.2. HCl is diatomic, CO2 linear180°. Schematic CO2 surface card:[red O]—[blue C]—[red O]; legend red=electron-rich/δ−,blue=electron-poor/δ+. A separate HCl density card shows greater density on the Cl side. CalculateΔEN, mark partial charges and interpret both representations. Explain different net dipoles despite polar bonds.",
                "expectedPerformanceDe": "HClΔEN1,0:Hδ+/Clδ− und Nettodipol. C–OΔEN0,8:Cδ+/Oδ−; im linearenCO2 heben zwei gleichgroße entgegengesetzte Bindungsdipole einander auf. Farben kodieren gemäß Legende lokale Verteilung, nicht die Gesamtladung oder eine absolute Elektronenzahl.",
                "expectedPerformanceEn": "HClΔEN1.0:Hδ+/Clδ− and net dipole. C–OΔEN0.8:Cδ+/Oδ−; two equal opposite bond dipoles cancel in linearCO2. Colours encode local distribution according to the legend, not total charge or absolute electron count.",
                "understandingFocusDe": "Unpolar als Gesamtmolekül bedeutet nicht, dass die einzelneC–O-Bindung unpolar ist.",
                "understandingFocusEn": "A nonpolar overall molecule does not mean that eachC–O bond is nonpolar."
              },
              {
                "id": "chem-next25-747c5777-case-2",
                "taskDemandDe": "Frische Oberfläche eines gewinkeltenH2O-Modells104,5°:[blau H]↘[rot O]↗[blau H], gleiche Rot-/Blau-Legende. Daneben eine erfundene zweite Software mit umgekehrter Farblegende:blau=δ−. Keine vollständigen Ionenladungen sind angegeben. LeiteH2O-Polarität ab und erkläre, warum dieselbe Farbe ohne Legende in zwei Programmen keine gleiche Bedeutung hat.",
                "taskDemandEn": "Fresh surface of a bentH2O model104.5°:[blue H]↘[red O]↗[blue H], same red/blue legend. A fictional second software uses the reverse legend:blue=δ−. No full ionic charges are specified. DeriveH2O polarity and explain why identical colours without legends need not mean the same thing in two programs.",
                "expectedPerformanceDe": "O–HΔEN1,2;Oδ−,Hδ+. Die gewinkelte Geometrie verhindert vollständige Aufhebung, daher Nettodipol. Die Person liest die jeweilige Legende statt „rot immer negativ“ zu memorieren und unterscheidet Dichte, elektrostatische Farbkodierung und Ionenladung.",
                "expectedPerformanceEn": "O–HΔEN1.2;Oδ−,Hδ+. Bent geometry prevents complete cancellation, giving a net dipole. The learner reads each legend rather than memorising “red always negative”, distinguishing density, electrostatic colour coding and ionic charge.",
                "understandingFocusDe": "Partialladungen sind keine freienH+-/O2−-Ionen in einem Wassermolekül; eine Farbgrafik ohne Zahlen liefert keine absolute Ladung.",
                "understandingFocusEn": "Partial charges are not freeH+/O2− ions inside a water molecule; an unnumbered colour graphic gives no absolute charge."
              }
            ]
          }
        }
      ],

        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Reduzierende Kohlenhydrate nachweisen und erklären",
          "url": "/assets/goal-visualizations/chemie/1d2e7b80-653d-57b8-a284-8ede5a353b73/1d2e7b80-653d-57b8-a284-8ede5a353b73.png",
          "altText": "Ein ausdrücklich vereinfachtes Bausteinmodell vergleicht Glucose mit freiem anomerem Zentrum C1 und Saccharose mit verknüpften Zentren C1 und C2. Darunter stehen ein positiver roter und ein negativer blauer Kupfer-Nachweis.",
          "originalDigest": "sha256:962a90624a2b7b2203bce57757cce401d6ef6b0627348723e6a53738a70d393e",
          "qaStatus": "review_candidate",
          "approvedForPublication": false
        }
      },

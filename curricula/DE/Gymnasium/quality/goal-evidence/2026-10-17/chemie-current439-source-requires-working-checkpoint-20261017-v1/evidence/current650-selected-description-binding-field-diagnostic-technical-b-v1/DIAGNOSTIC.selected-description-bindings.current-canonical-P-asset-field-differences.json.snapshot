      "canonicalContextDifferences": [],
      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "nutrient-ion-source",
                "essentialUnderstandingDe": "Ausgewählte mineralische Dünger liefern konkrete Nährstoffionen, zum Beispiel NH₄⁺/NO₃⁻ oder K⁺. Düngerstoffmasse, Masse eines Nährstoffelements und tatsächlich gelöste Ionen sind verschiedene Größen. Phosphat ist eine Nährstoffkategorie; das Bild beweist keine Dominanz freien PO₄³⁻ im Boden.",
                "essentialUnderstandingEn": "Selected mineral fertilizers supply specific nutrient ions, such as NH₄⁺/NO₃⁻ or K⁺. Fertilizer mass, nutrient-element mass and dissolved ions are different quantities. Phosphate names a nutrient category; the image does not prove dominance of free PO₄³⁻ in soil.",
                "observablePerformanceDe": "Die lernende Person ordnet vorgegebene Düngerverbindungen ihren Nährstoffionen zu und verwendet bereitgestellte Elementgehalte korrekt, statt jedes Salz als dieselbe Nährstoffquelle zu behandeln.",
                "observablePerformanceEn": "The learner assigns supplied fertilizer compounds to their nutrient ions and uses given elemental contents correctly rather than treating every salt as the same nutrient source."
              },
              {
                "id": "conditional-benefit-risk",
                "essentialUnderstandingDe": "Nutzen und Risiko hängen von bereitgestelltem Pflanzenbedarf, Düngermenge und Stofftransport ab. Eine passende Nährstoffquelle kann Mangel begrenzen; Überschuss und Transport in Gewässer können Risiken erhöhen. Aussagen müssen die gegebenen Bedingungen und die jeweilige Ionensorte berücksichtigen.",
                "essentialUnderstandingEn": "Benefits and risks depend on supplied plant demand, dose and substance transport. A suitable nutrient source can limit deficiency; surplus and transport into waters can raise risks. Conclusions must use the given conditions and ion species.",
                "observablePerformanceDe": "Die lernende Person verbindet konkreten Nährstoffbedarf, Dosis und bereitgestellte Transportdaten zu einer begründeten bedingten Bewertung und erklärt, weshalb mehr Dünger oder dasselbe Vorgehen auf anderem Boden nicht automatisch besser ist.",
                "observablePerformanceEn": "The learner links specific nutrient demand, dose and supplied transport data into a reasoned conditional judgment and explains why more fertilizer or the same practice on another soil is not automatically better."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "nutrient-ion-source",
                "conditional-benefit-risk"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "nutrient-demand-dose-transport",
                "textDe": "Andere bereitgestellte mineralische Nährstoffionen, Elementgehalte, Bedarfsmengen und Boden-/Regen-/Transportdaten; lesbare Angaben ersetzen keine reale Labor-/Feldleistung.",
                "textEn": "Other supplied mineral nutrient ions, elemental contents, demands and soil/rain/transport data; legible data do not constitute actual laboratory or field performance."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "ammonium-nitrate-dose-demand",
                "taskDemandDe": "Eine Modellpflanzung benötigt laut Aufgabenblatt 2,0 g Stickstoff. Der ausgewählte mineralische Dünger NH₄NO₃ liefert NH₄⁺/NO₃⁻ und enthält gegeben 35 % Stickstoff nach Masse. Vergleiche 5,0 g und 8,0 g Dünger. Es wird angegeben, dass nicht aufgenommener gelöster Stickstoff bei starkem Regen in Gewässer gelangen kann. Begründe Nutzen und Risiko ohne eine reale Düngeempfehlung oder beobachtete Pflanzenleistung zu behaupten.",
                "taskDemandEn": "A model planting has a supplied demand of 2.0 g nitrogen. The selected NH₄NO₃ fertilizer provides NH₄⁺/NO₃⁻ and is given as 35% nitrogen by mass. Compare 5.0 g and 8.0 g fertilizer. The task states that unabsorbed dissolved nitrogen can reach waters during heavy rain. Explain benefits and risks without claiming a real fertilization recommendation or observed plant performance.",
                "expectedPerformanceDe": "5,0 g liefern 1,75 g N, also weniger als der vorgegebene Bedarf; 8,0 g liefern 2,80 g N, also 0,80 g über dem Bedarf. Die passende Stickstoffquelle kann den angegebenen Mangel begrenzen. Die höhere Dosis erzeugt unter den bereitgestellten Aufnahme-/Regenannahmen potenziell transportierbaren Überschuss. Eine exakte reale Verlustmenge wird ohne entsprechende Daten nicht erfunden.",
                "expectedPerformanceEn": "5.0 g provides 1.75 g N, below the supplied demand; 8.0 g provides 2.80 g N, 0.80 g above demand. The suitable nitrogen source can limit the stated deficiency. Under the supplied uptake/rain assumptions the larger dose creates potentially transported surplus. An exact real loss is not invented without corresponding data.",
                "understandingFocusDe": "Nährstoffionenquelle und mengen-/transportabhängige Bewertung.",
                "understandingFocusEn": "Nutrient-ion source and a dose/transport-dependent judgment."
              },
              {
                "id": "potassium-and-nitrate-transport-transfer",
                "taskDemandDe": "Frisch vorgegeben: Eine Pflanzung benötigt 4,5 g K; K₂SO₄ enthält im Aufgabenmodell 45 % K und liefert K⁺/SO₄²⁻. Ein zweites Beet erhält einen Nitratdünger; die Tabelle weist für Boden A starken Nitrattransport bei Regen, für B geringeren Transport aus. Ordne die Nährstoffquellen zu, prüfe 10,0 g K₂SO₄ für den K-Bedarf und erkläre, warum dieselbe Nitratdosis auf A/B unterschiedliche Risiken haben kann. Alle Transportangaben stehen lesbar im Aufgabenblatt.",
                "taskDemandEn": "Fresh data state a demand of 4.5 g K; the task model gives K₂SO₄ as 45% K supplying K⁺/SO₄²⁻. Another plot receives nitrate fertilizer; a table shows strong nitrate transport in rain on soil A and less on B. Assign nutrient sources, evaluate 10.0 g K₂SO₄ for K demand and explain why the same nitrate dose can have different risks on A/B. All transport data are legible on the task sheet.",
                "expectedPerformanceDe": "10,0 g des vorgegebenen Düngers liefern 4,5 g K und entsprechen dem Modellbedarf; K₂SO₄ ist keine Stickstoffquelle. Der Nitratfall betrifft eine andere Nährstoffionenquelle. Gleiche Dosis und Bedarf bestimmen nicht allein das Gewässerrisiko: nach Tabelle ist auf A mehr Nitrattransport möglich. Aus dem Bild oder Gruppennamen wird keine allgemeine Transport- oder Risikogleichheit aller Ionen abgeleitet.",
                "expectedPerformanceEn": "10.0 g of the supplied fertilizer provides 4.5 g K and matches the model demand; K₂SO₄ is not a nitrogen source. The nitrate case involves another nutrient-ion source. Equal dose and demand do not alone determine aquatic risk: the table permits greater nitrate transport on A. Neither the image nor category names imply equal transport or risk for all ions.",
                "understandingFocusDe": "Frische Verbindung, andere Nährstoffgröße und bedingter Transporttransfer.",
                "understandingFocusEn": "Fresh compound, another nutrient quantity and conditional transport transfer."
              }
            ]
          }
        }
      ],

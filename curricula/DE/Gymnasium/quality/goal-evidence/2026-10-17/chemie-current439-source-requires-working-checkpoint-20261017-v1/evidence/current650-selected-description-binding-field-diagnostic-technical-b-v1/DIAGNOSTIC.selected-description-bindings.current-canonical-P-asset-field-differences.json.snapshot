      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "modeling",
            "expectations": [
              {
                "id": "condition-specific-molar-volume",
                "essentialUnderstandingDe": "Vm ist das Volumen pro Stoffmenge eines Gases unter festgelegten Bedingungen. Im idealen Modell gilt die proportionale Volumen-Stoffmengen-Beziehung bei diesen Bedingungen; ein anderer Vm-Wert kann bei geändertem Druck oder geänderter Temperatur gelten. In einem geschlossenen System ohne Reaktion bleibt n beim Zustandswechsel erhalten, während V sich ändern kann.",
                "essentialUnderstandingEn": "Molar volume is gas volume per amount under specified conditions. The ideal model gives a proportional volume-to-amount relation at those conditions; pressure or temperature changes can give a different molar volume. In a closed nonreacting system, amount is conserved during a change of state although volume can change.",
                "observablePerformanceDe": "Die lernende Person deutet L/mol, bestimmt V oder n mit dem zum Zustand passenden Vm und begründet, warum ein fester Zahlenwert nicht ohne Bedingungen übertragen werden darf.",
                "observablePerformanceEn": "The learner interprets L/mol, determines volume or amount using the molar volume for the actual state and explains why a numerical value cannot be transferred without its conditions."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "condition-specific-molar-volume"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "conversion-direction",
                "textDe": "Stoffmenge→Volumen wird durch Volumen→Stoffmenge ersetzt.",
                "textEn": "Amount-to-volume is replaced by volume-to-amount conversion."
              },
              {
                "id": "state-change",
                "textDe": "Bei einem geschlossenen Zustandswechsel ändert sich Vm, nicht die Stoffmenge.",
                "textEn": "Molar volume changes during a closed state change while amount remains constant."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "molar-volume-reference-state",
                "taskDemandDe": "Für ideale Gase gelten in den gerundeten Schulmodelldaten bei20°C und101,6kPa: Vm=24,0L/mol. Bestimme das Volumen von0,25mol N2 und die Stoffmenge in12,0L He bei denselben Bedingungen. Erkläre die Bedeutung von24,0L/mol und ob es ein universeller Wert für alle Gaszustände ist.",
                "taskDemandEn": "The rounded school-model data for ideal gases at20°C and101.6kPa give Vm=24.0L/mol. Determine the volume of0.25mol N2 and the amount in12.0L He under those same conditions. Explain24.0L/mol and whether it is universal across all gas states.",
                "expectedPerformanceDe": "0,25mol N2 haben6,00L;12,0L He entsprechen0,500mol.24,0L/mol bezeichnet das Volumen je mol Gasteilchen bei den angegebenen Bedingungen. Es ist kein bedingungsloser oder stoffunabhängig real-exakter Naturwert; die Aussagen nutzen das ideale Modell und gerundete Daten.",
                "expectedPerformanceEn": "0.25mol N2 occupies6.00L and12.0L He corresponds to0.500mol.24.0L/mol denotes volume per mol of gas particles under the stated conditions. It is not an unconditional, exactly real-gas constant; the results use the ideal model and rounded data.",
                "understandingFocusDe": "Beide Umrechnungsrichtungen werden aus Volumen pro mol einschließlich Bedingungen begründet.",
                "understandingFocusEn": "Both conversion directions are justified using volume per mol and its conditions."
              },
              {
                "id": "closed-volume-change-fresh",
                "taskDemandDe": "Frischer Fall ohne Rechenweg: Ein geschlossenes, nicht reagierendes ideales Gas hat bei ZustandB20°C/81,3kPa9,00L. FürB geben die gerundeten Modelldaten Vm=30,0L/mol; für ZustandA20°C/101,6kPa Vm=24,0L/mol. Welches Volumen erhält dieselbe Gasprobe inA? Prüfe die Behauptung,9,00L müsse erhalten bleiben, weil kein Gas verloren geht.",
                "taskDemandEn": "Fresh case without a worked method: a closed, nonreacting ideal gas occupies9.00L at stateB20°C/81.3kPa. The rounded model data give Vm=30.0L/mol forB and Vm=24.0L/mol for stateA20°C/101.6kPa. What volume does the same sample occupy inA? Check the claim that9.00L must be conserved because no gas is lost.",
                "expectedPerformanceDe": "InB enthält die Probe0,300mol. Ohne Teilchenaustausch oder Reaktion bleibt diese Stoffmenge inA gleich; bei24,0L/mol ergeben sich7,20L. Erhalten ist die Teilchen-/Stoffmenge, nicht das Volumen. Ein mit24,0L/mol aus dem B-Volumen berechnetes n wäre ein Zustandsfehler.",
                "expectedPerformanceEn": "The sample contains0.300mol inB. With no particle exchange or reaction, its amount remains the same inA, giving7.20L at24.0L/mol. Particle count/amount is conserved, not volume. Calculating the B amount using24.0L/mol would mix states.",
                "understandingFocusDe": "Ungeholfener Zustandswechsel: passende Modelldaten auswählen und Erhaltungsgröße erklären.",
                "understandingFocusEn": "An uncued state change requires selecting the correct model data and explaining the conserved quantity."
              }
            ]
          }
        }
      ],

            "archetype": "concept",
            "expectations": [
              {
                "id": "b004-ebaae4f5-core",
                "essentialUnderstandingDe": "Ein Gefahrmerkmal beschreibt die mögliche Schädigung durch Stoff oder Verfahren; das konkrete Risiko hängt von Exposition, Menge, Arbeitsweise und Schutzmaßnahmen ab. Eine Maßnahme muss zum jeweiligen Expositionsweg passen.",
                "essentialUnderstandingEn": "A hazard describes a substance or procedure’s harmful potential; actual risk also depends on exposure, amount, procedure and controls. A control must address the relevant exposure route.",
                "observablePerformanceDe": "Die lernende Person liest vorgegebene Schulinformationen zu einem Stoff, benennt einen konkreten Kontaktweg und entwickelt begründete Maßnahmen, die genau diesen Weg verringern.",
                "observablePerformanceEn": "The learner reads supplied school-lab information, identifies a specific exposure route and proposes justified controls that reduce it."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b004-ebaae4f5-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "exposure-route",
                "textDe": "Spritzer und Dampf werden als unterschiedliche Kontaktwege betrachtet.",
                "textEn": "Splash and vapor are treated as different exposure routes."
              },
              {
                "id": "procedure",
                "textDe": "Menge und Arbeitsweise verändern das Risiko bei gleichem Gefahrmerkmal.",
                "textEn": "Amount and procedure change risk under the same hazard classification."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "dilute-acid-splash-card",
                "taskDemandDe": "Eine bereitgestellte Schullaborkarte beschreibt eine verdünnte saure Lösung und ein mögliches Spritzrisiko beim Umfüllen. Beurteile den Kontaktweg und schlage vor Beginn zwei passende Schutzmaßnahmen vor; es wird nicht umgefüllt.",
                "taskDemandEn": "A supplied school-lab card describes a dilute acidic solution and a possible splash while transferring it. Assess the exposure route and propose two suitable controls before starting; no transfer is performed.",
                "expectedPerformanceDe": "Die lernende Person trennt das Gefahrmerkmal vom konkreten Spritzrisiko und begründet z. B. Schutzbrille sowie kleine Mengen/geeignete Handhabung unter Lehrkraftanweisung; sie erklärt, warum ein bloßes Symbol keine Freigabe ist.",
                "expectedPerformanceEn": "The learner separates hazard from the specific splash risk and justifies eye protection plus small amounts/suitable handling under teacher direction; a symbol alone grants no permission.",
                "understandingFocusDe": "Maßnahmen adressieren Spritzer und Exposition.",
                "understandingFocusEn": "Controls address splashes and exposure."
              },
              {
                "id": "fresh-vapor-comparison",
                "taskDemandDe": "Ein neues Papierprotokoll vergleicht denselben flüchtigen Stoff in einem offenen großen Gefäß und in einer kleinen geschlossenen Demonstration der Lehrkraft. Welche Situation birgt eher Einatmerisiko und welche Änderung mindert es? Keine reale Durchführung.",
                "taskDemandEn": "A fresh paper protocol compares the same volatile substance in a large open vessel and in a small teacher-run closed demonstration. Which situation has greater inhalation risk and what change reduces it? No experiment is performed.",
                "expectedPerformanceDe": "Die lernende Person nennt Verdunstung und Einatmen als konkreten Weg, bevorzugt geschlossene/kleine Lehrkraftdemonstration beziehungsweise geeignete Lüftung nach lokalen Vorgaben und behauptet nicht, dass das Stoffmerkmal verschwunden sei.",
                "expectedPerformanceEn": "The learner identifies evaporation and inhalation, prefers the small closed teacher demonstration or suitable ventilation under local rules, and does not claim the substance’s hazard has vanished.",
                "understandingFocusDe": "Gleicher Stoff, anderes Expositionsrisiko.",
                "understandingFocusEn": "Same substance, different exposure risk."
              }
            ]
          }
        }
      ],
      "PRecordMetadataDifferences": [
        {
          "field": "",

          "path": "/home/enpasos/projects/skillpilot/tmp/chemie-m7-resumed-20261016/chemie-shared640-recycling-native-author-capsule-L6-v1/curricula/DE/Gymnasium/quality/goal-description-review/chemie/rollout-v1/2026-10-01/b009-fossil-carbon-current-1-20261001-v2/round-b/description-review-input.json",

      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "preservation-mechanisms",
                "essentialUnderstandingDe": "Historisch verbreitete Verfahren wie Trocknen, Salzen oder Säuern und moderne Prozess-/Verpackungstechniken beeinflussen Wasserverfügbarkeit, pH, Temperatur oder Gasumgebung. Die Einordnung historisch/modern allein erklärt keine Wirkung.",
                "essentialUnderstandingEn": "Historically widespread drying, salting or acidification and modern processing/packaging affect water availability, pH, temperature or gas composition. Historical/modern labels alone do not explain action.",
                "observablePerformanceDe": "Vorgegebene Verfahren gegenüberstellen und die zum jeweiligen Modell passende Wachstumshemmung bzw. thermische Inaktivierung erklären.",
                "observablePerformanceEn": "Compare supplied procedures and explain model-specific growth inhibition or thermal inactivation."
              },
              {
                "id": "conditional-risk-comparison",
                "essentialUnderstandingDe": "Konservierungswirkung ist bedingt durch Verfahren, Ausgangsprodukt und Organismen. Hemmung ist nicht notwendig Sterilisation; Risiken können etwa verbleibendes Wachstum, Wiederverunreinigung oder Qualitätsänderung sein.",
                "essentialUnderstandingEn": "Preservation depends on process, initial product and organisms. Inhibition is not necessarily sterilization; risks include remaining growth, recontamination or quality changes.",
                "observablePerformanceDe": "Aus bereitgestellten Prozess-/Beobachtungsdaten Grenzen und Risiken verschiedener Methoden benennen, ohne Haltbarkeitsfristen oder Gesundheitsfreigaben zu erfinden.",
                "observablePerformanceEn": "Identify limitations and risks from supplied process/observation data without inventing shelf lives or health clearance."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "preservation-mechanisms",
                "conditional-risk-comparison"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "changed-chemical-case",
                "textDe": "Neue Lebensmittelmodelle und Verfahrenskombinationen; Wirkmechanismus und belegte Grenzen statt pauschale Sicherheitsrangfolge.",
                "textEn": "Use fresh food models and process combinations; compare mechanisms and evidenced limits instead of a blanket safety ranking."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "historical-and-modern-comparison",
                "taskDemandDe": "Eine didaktische Tabelle vergleicht Trocknen/Salzen und Säuern mit Kühlung und einem vorgegebenen Wärmeprozess. Messdaten zu Wasseraktivität, pH, Temperatur und modellhaftem Wachstum liegen vor. Ordne Wirkprinzipien zu und benenne für jedes Verfahren eine durch die Daten begründete Grenze.",
                "taskDemandEn": "An educational table compares drying/salting and acidification with cooling and a supplied heat process. Water activity, pH, temperature and model growth data are given. Assign mechanisms and identify a data-supported limit for each.",
                "expectedPerformanceDe": "Trocknen/Salzen vermindert verfügbare Wasseraktivität, Säuern verändert pH, Kühlung verlangsamt im gegebenen Modell Wachstum, Wärme kann Organismen gemäß den vorgegebenen Daten inaktivieren. Hemmung wird nicht mit vollständiger Keimfreiheit gleichgesetzt; Restwachstum, Wiederverunreinigung oder Qualitätsänderung werden stoff-/prozessbezogen erklärt.",
                "expectedPerformanceEn": "Drying/salting lowers available water activity, acidification changes pH, cooling slows model growth, and heat can inactivate organisms according to supplied data. Inhibition is not equated with sterility; remaining growth, recontamination or quality change are explained for the product/process.",
                "understandingFocusDe": "Wirkmechanismen und Grenzen vergleichen.",
                "understandingFocusEn": "Compare mechanisms and limits."
              },
              {
                "id": "changed-packaging-organisms",
                "taskDemandDe": "Frische Modellverpackungsdaten zeigen weniger Sauerstoff und geringeres Wachstum eines aeroben Organismus, aber Wachstum eines ausdrücklich vorgegebenen anderen Organismus. Vergleiche dieses moderne Verfahren mit Säuern/Trocknen anhand einer zweiten Datentabelle und begründe eine Grenze; keine Anwendungsempfehlung oder reale Haltbarkeit.",
                "taskDemandEn": "Fresh packaging-model data show lower oxygen and reduced growth of an aerobic organism but growth of another explicitly supplied organism. Compare the modern process with acidification/drying using a second table and explain a limitation; no application advice or actual shelf life.",
                "expectedPerformanceDe": "Verminderter Sauerstoff betrifft bestimmte Wachstumsbedingungen, nicht alle Organismen gleichermaßen. Die vorgegebenen Daten widerlegen einen allgemeinen Sterilitätsanspruch. Säuern/Trocknen wirken über andere Bedingungen; Kombinationen sind nur im Umfang vorhandener Daten bewertbar, nicht automatisch sicher.",
                "expectedPerformanceEn": "Lower oxygen affects particular growth conditions rather than every organism equally. Supplied data contradict a universal sterility claim. Acidification/drying act through other conditions; combinations can be evaluated only within available data and are not automatically safe.",
                "understandingFocusDe": "Frischer Organismen-/Verfahrensvergleich.",
                "understandingFocusEn": "Fresh organism and process comparison."
              }
            ]
          }
        }
      ],

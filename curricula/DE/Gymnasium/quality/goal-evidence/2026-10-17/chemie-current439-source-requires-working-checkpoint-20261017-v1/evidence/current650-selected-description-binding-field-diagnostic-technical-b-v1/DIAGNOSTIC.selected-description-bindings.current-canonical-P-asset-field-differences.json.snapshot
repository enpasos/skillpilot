      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "experiment",
            "expectations": [
              {
                "id": "e1",
                "essentialUnderstandingDe": "Ein Absorptionsmaximum wird unter kontrollierten Messbedingungen aus einem Spektrum ermittelt; Leerprobe und gleiche Schichtdicke ermöglichen den Vergleich.",
                "essentialUnderstandingEn": "An absorption maximum is determined from a spectrum under controlled conditions; a blank and equal optical path length enable comparison.",
                "observablePerformanceDe": "Die lernende Person misst nach örtlicher Freigabe den vorgesehenen Scan und die Leerprobe, protokolliert die Bedienung und benennt das Maximum unter den gemessenen Wellenlängen samt Auflösungsgrenze.",
                "observablePerformanceEn": "After local authorization, the learner measures the specified scan and blank, records instrument use and identifies the maximum among measured wavelengths with its resolution limit."
              },
              {
                "id": "e2",
                "essentialUnderstandingDe": "Eine Kalibriergerade ist ein empirisch geprüfter Zusammenhang in einem begrenzten Bereich; ein abweichender Standard darf nicht unbemerkt als linear behandelt werden.",
                "essentialUnderstandingEn": "A calibration line is an empirically checked relationship over a limited range; a deviating standard cannot silently be treated as linear.",
                "observablePerformanceDe": "Sie stellt Standards her und misst sie unter tatsächlich beobachteter Bedienung; sie bestimmt Steigung, Achsenabschnitt und gültigen Bereich und begründet die Behandlung des nichtlinearen oberen Standards.",
                "observablePerformanceEn": "The learner prepares and measures standards under actual observation, determines slope, intercept and valid range, and justifies treatment of the nonlinear upper standard."
              },
              {
                "id": "e3",
                "essentialUnderstandingDe": "Der Probengehalt folgt aus der gültigen Kalibrierung und dem Verdünnungsfaktor; eine rechnerisch mögliche Interpolation ist noch keine bestätigte Richtigkeit.",
                "essentialUnderstandingEn": "Sample concentration follows from valid calibration and dilution; mathematically valid interpolation is not yet confirmed trueness.",
                "observablePerformanceDe": "Sie berechnet aus dem mittleren Absorptionswert den verdünnten und ursprünglichen Gehalt und kennzeichnet ein Ergebnis bei fehlgeschlagener Kontrolle als vorläufig.",
                "observablePerformanceEn": "The learner calculates diluted and original concentrations from mean absorbance and labels a result provisional when its control fails."
              },
              {
                "id": "e4",
                "essentialUnderstandingDe": "Enge Wiederholstreuung belegt Wiederholbarkeit; eine unabhängige Kontrolle prüft die Richtigkeit unter den angegebenen Bedingungen.",
                "essentialUnderstandingEn": "Narrow replicate scatter indicates repeatability; an independent control checks trueness under stated conditions.",
                "observablePerformanceDe": "Sie berechnet die relative Referenzabweichung, trennt sie von der Streuung und entscheidet begründet zwischen Freigabe im Modell und Zurückhalten des Ergebnisses.",
                "observablePerformanceEn": "The learner calculates relative reference deviation, distinguishes it from scatter and justifies accepting the model result or withholding it."
              }
            ],
            "variationAxes": [
              {
                "id": "calibration-validity",
                "textDe": "Eine lineare Standardreihe mit einer Reihe mit oberer Abweichung vergleichen; den gültigen Bereich begründen.",
                "textEn": "Compare a linear standard series with one showing upper-range deviation and justify the valid range."
              },
              {
                "id": "precision-versus-trueness",
                "textDe": "Ähnlich kleine Wiederholstreuung bei bestandener und fehlgeschlagener Referenzkontrolle beurteilen.",
                "textEn": "Judge similarly small replicate scatter with passing and failing reference controls."
              },
              {
                "id": "measurement-versus-data",
                "textDe": "Eigenen Scan und Standardherstellung beobachten; synthetische Daten ausschließlich als Auswertungsmaterial nutzen.",
                "textEn": "Observe the learner's scan and standard preparation; use synthetic data solely as evaluation material."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "t02-c1",
                "taskDemandDe": "Scan, lineare Standards und eine fünffach verdünnte Probe mit unabhängiger Kontrolle auswerten; eigene Messung getrennt beobachten. Vollständiges Material, Auftrag, Lösung und vier Kriterien: materials/twenty-complete-DEEN-cases.author.json, Fall T02-C1.",
                "taskDemandEn": "Evaluate a scan, linear standards and a fivefold diluted sample with an independent control; observe actual measurement separately. Complete material, task, solution and four criteria: materials/twenty-complete-DEEN-cases.author.json, case T02-C1.",
                "expectedPerformanceDe": "1. Unter den gemessenen Wellenlängen hat 450 nm die höchste Absorption. Ein genaueres kontinuierliches Maximum benötigt einen feineren Scan. Leerwert 0.020 und gleiche 1.00-cm-Küvetten sichern den Vergleich. 2. Die fünf Standards ergeben A=0.050 (L/mg)·c+0.020 im geprüften Bereich 0–8 mg/L. Der Leerwert ist im Achsenabschnitt bereits berücksichtigt. 3. Der Mittelwert A=0.275 ergibt (0.275−0.020)/0.050=5.10 mg/L; mit Faktor 5 ursprünglich 25.5 mg/L. 4. Die Referenz ergibt 6.04 mg/L, also +0.67 % und damit innerhalb ±2 %. Die kleine Absorptionsspannweite 0.004 zeigt allein keine Richtigkeit. Standardherstellung, Volumengeräte und Matrixkonstanz benötigen eigene Kontroll-/Unsicherheitsnachweise. Scan, Standardherstellung und Bedienung sind hier nicht ausgeführt; praktische Leistung verlangt spätere tatsächliche Beobachtung.",
                "expectedPerformanceEn": "1. 450 nm has highest absorption among supplied wavelengths; finer scanning is needed for an exact continuous maximum. Blank.020 and equal 1.00 cm cells keep comparisons valid. 2. A=.050(L/mg)c+.020 over the supplied 0–8 mg/L standard range. 3. Mean A=.275 gives c=5.10 mg/L and original concentration 25.5 mg/L after fivefold correction. 4. Reference recovery 6.04 mg/L differs by+.67%, within the supplied±2% tolerance. Replicate range.004 in A is small but alone cannot establish trueness. Standard preparation, volumetric equipment and matrix consistency need separate uncertainty/control evidence. No instrument was actually operated here. Practical full performance requires actually observed standard preparation, matched cells/blank, recorded scan and own calibration measurements. No observations are present here.",
                "understandingFocusDe": "Das gemessene Maximum, die lineare Interpolation und die Referenzprüfung müssen zusammenpassen.",
                "understandingFocusEn": "The sampled maximum, linear interpolation and reference check must agree."
              },
              {
                "id": "t02-c2",
                "taskDemandDe": "Eine obere Kalibrierabweichung und eine trotz kleiner Streuung um 10 % abweichende Kontrolle beurteilen. Vollständiges Material, Auftrag, Lösung und vier Kriterien: materials/twenty-complete-DEEN-cases.author.json, Fall T02-C2.",
                "taskDemandEn": "Judge upper-range calibration deviation and a control biased by 10% despite narrow scatter. Complete material, task, solution and four criteria: materials/twenty-complete-DEEN-cases.author.json, case T02-C2.",
                "expectedPerformanceDe": "1. Das größte gemessene Signal liegt bei 540 nm; A=0.010 bei c=0 ist der Leerwertbeitrag. 2. Die ersten vier Standards ergeben A=0.400·c+0.010. Für 2.0 mg/L wären 0.810 erwartet, gegeben sind 0.650. Eine gemeinsame lineare Ausgleichung aller Punkte ist deshalb nicht begründet. 3. Der Mittelwert 0.510 ergibt verdünnt 1.25 mg/L und mit Faktor 4 ursprünglich 5.00 mg/L. 4. Die Referenz ergibt 1.10 mg/L, also +10 % statt erlaubter ±2 %. Kleine Wiederholstreuung (Spannweite 0.002) schließt einen systematischen Fehler nicht aus. Dessen Ursache ist nicht eindeutig: unabhängige Standard-/Referenzherstellung sowie Geräte-/Leerwertprüfung sind nötig. 5.00 mg/L bleibt ein vorläufiger Rechenwert. Praktische Herstellung, Scan und Kalibrierung wurden hier nicht beobachtet.",
                "expectedPerformanceEn": "1. 540 nm is the largest sampled absorption; A=.010 at c=0 is the intercept. 2. The first four standards give A=.400 c+.010;2.0 mg/L should give.810 but gives.650, so fitting every point to one line is unjustified. 3. (.510−.010)/.400=1.25 mg/L; fourfold correction gives 5.00 mg/L. 4. Reference recovery 1.10 mg/L is+10%, outside±2%. Precise replicates (A range.002) do not exclude systematic error. These data do not uniquely identify its cause; independent standard/reference preparation and instrument/blank checks are needed.5.00 mg/L is thus a method-derived content, not a fully verified result. Practical full performance requires actually observed standard preparation, matched cells/blank, recorded scan and own calibration measurements. No observations are present here.",
                "understandingFocusDe": "Ein plausibler Rechenwert darf bei fehlgeschlagener Richtigkeitskontrolle nicht als bestätigter Gehalt ausgegeben werden.",
                "understandingFocusEn": "A plausible calculation must not be reported as confirmed concentration after a failed trueness check."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "e1",
                "e2",
                "e3",
                "e4"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            }
          }
        }

        "pageFingerprint": "sha256:25fb540fdb07655dc7c8a807ccab26b25bb14940d009c697e82bd54e2fd395a2",
        "stockGoalReviewContextFingerprint": "sha256:ac841af5767c3787a6df00f81894a549bb9f8f321502f472e73b54f37bcd37ad",
        "oldPageStockFingerprint": "sha256:25fb540fdb07655dc7c8a807ccab26b25bb14940d009c697e82bd54e2fd395a2",
        "profileFingerprint": null,
        "reviewInputFingerprint": null,
        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Brønsted-Konzept anwenden",
          "url": "/assets/goal-visualizations/chemie/1c1420c2-a8e2-520f-8015-6df637a973bd/1c1420c2-a8e2-520f-8015-6df637a973bd.png",
          "altText": "Protonenübertragung von einer Säure auf eine Base, am Beispiel HCl und Wasser mit den konjugierten Paaren HCl/Cl− und H₂O/H₃O⁺. Wasser wird mit zwei, Hydronium mit drei Wasserstoffatomen dargestellt. Zwei schematische Lösungsbilder zeigen ausdrücklich beschriftete Teilchenarten statt ungenauer Atommodelle: H₃O⁺, Cl− und H₂O sowie OH−, Na⁺ und H₂O.",
          "originalDigest": "sha256:fde25896ba5856c2d18235726e71e5e59d6269f16188028ba23589fc6ca67c1b",
          "qaStatus": "review_candidate",
          "approvedForPublication": false
        }
      },
      "finalTextDifferences": [],
      "oldInputTextDifferences": [],
      "canonicalContextDifferences": [
        {
          "field": "requires",
          "before": [

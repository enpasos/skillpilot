            "archetype": "modeling",
            "expectations": [
              {
                "id": "whole-duty-1",
                "essentialUnderstandingDe": "Anodisches Eisen mit Gleichung erklären.",
                "essentialUnderstandingEn": "Explain anodic iron using equation.",
                "observablePerformanceDe": "Anodisches Eisen mit Gleichung erklären. Zweiter unabhängiger Kontext: Anode/Kathode und Elektronenrichtung richtig darstellen.",
                "observablePerformanceEn": "Explain anodic iron using equation. Second independent context: Represent anode/cathode and electron direction correctly."
              },
              {
                "id": "whole-duty-2",
                "essentialUnderstandingDe": "Kupfer als kathodischen Ort statt zwingendem Cu²⁺-Akzeptor deuten.",
                "essentialUnderstandingEn": "Interpret copper as cathodic site,not necessarily Cu²⁺ acceptor.",
                "observablePerformanceDe": "Kupfer als kathodischen Ort statt zwingendem Cu²⁺-Akzeptor deuten. Zweiter unabhängiger Kontext: Kathodischen Akzeptor und Ionenleitung erklären.",
                "observablePerformanceEn": "Interpret copper as cathodic site,not necessarily Cu²⁺ acceptor. Second independent context: Explain cathodic acceptor and ionic conduction."
              },
              {

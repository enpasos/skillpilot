        "bookDigest": "sha256:bfbc4ff204938d39615ca5391087d7c21719f15e8ca6d3544ae7250e1bfc7c58",
        "goalFingerprint": "sha256:ce2e0341e7253b66b4c7fd8623e291a9876d9d6a07bc38ff1a457d188b8856e9",
        "pageFingerprint": "sha256:e47106d7f2ea9690674f655de1d957a5e6de7154d82d1bb9573113e5189aeff6",
        "stockGoalReviewContextFingerprint": "sha256:8bef007615098738d58e5ecb5e1bc921182cebc300c2e60872007a800f791480",

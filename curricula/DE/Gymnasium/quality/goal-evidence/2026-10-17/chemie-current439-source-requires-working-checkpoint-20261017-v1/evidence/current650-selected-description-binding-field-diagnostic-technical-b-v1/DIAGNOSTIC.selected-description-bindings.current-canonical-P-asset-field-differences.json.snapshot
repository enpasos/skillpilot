      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "procedure",
            "expectations": [
              {
                "id": "ascorbic-structure-and-suitable-method",
                "essentialUnderstandingDe": "Die reduzierende Molekülstruktur der Ascorbinsäure kann eine geeignete redoxstöchiometrische Bestimmung begründen. Bei einer geeigneten Iodbestimmung reagieren Ascorbinsäure und I₂ im Stoffmengenverhältnis1:1. Das macht einen Iodverbrauch in einer unbekannten Matrix nicht automatisch ascorbinspezifisch.",
                "essentialUnderstandingEn": "The reducing molecular structure of ascorbic acid can justify an appropriate redox-stoichiometric assay. In a suitable iodine assay, ascorbic acid and I₂ react in a1:1 molar ratio. This does not automatically make iodine consumption in an unknown matrix specific to ascorbic acid.",
                "observablePerformanceDe": "Aus der bereitgestellten Molekülstruktur und den Matrixbedingungen eine geeignete quantitative Ascorbinbestimmung auswählen und die relevante Kalibrierung oder Reaktionsstöchiometrie begründen.",
                "observablePerformanceEn": "Select an appropriate quantitative ascorbic assay from the supplied molecular structure and matrix conditions, and justify the relevant calibration or reaction stoichiometry."
              },
              {
                "id": "actual-controlled-ascorbic-planning-and-execution",
                "essentialUnderstandingDe": "Das Ziel verlangt eigene Planung UND tatsächliche Durchführung mit passenden Blind-/Referenz- beziehungsweise Matrixkontrollen, bekannter Probenvorbereitung und Rohwerten. Eine Rechnung an bereitgestellten Beispielwerten oder ein simulierter Versuch belegt keine praktische Durchführung.",
                "essentialUnderstandingEn": "The goal requires the learner’s own planning AND actual execution with appropriate blank/reference or matrix controls, known sample preparation and raw measurements. Calculation using supplied example data or a simulated experiment does not demonstrate practical execution.",
                "observablePerformanceDe": "Einen geeigneten autorisierten Schulversuch planen und tatsächlich durchführen; eigene Vorbereitung, Kontrollen und Messwerte nachvollziehbar protokollieren.",
                "observablePerformanceEn": "Plan and actually perform an appropriate authorised school experiment; record the learner’s own preparation, controls and readings traceably."
              },
              {
                "id": "ascorbic-content-dilution-and-interference",
                "essentialUnderstandingDe": "Ein tragfähiger Gehalt braucht korrekte Blindwertkorrektur, Stöchiometrie oder gültige Kalibrierung, Einheiten und Verdünnung. Oxidationsverluste und weitere reduzierende Matrixbestandteile können die Bestimmung verfälschen; zusätzliche Messungen oder eine geeignetere Methode können nötig sein.",
                "essentialUnderstandingEn": "A supported content requires correct blank correction, stoichiometry or valid calibration, units and dilution. Oxidative losses and other reducing matrix components can distort the assay; additional measurements or a more appropriate method may be needed.",
                "observablePerformanceDe": "Den Ascorbingehalt mit vollständigem Probenbezug bestimmen und bei einer frischen veränderten Matrix die Kontrolle tatsächlich prüfen, das Verfahren begründet anpassen und Grenzen des Ergebnisses benennen.",
                "observablePerformanceEn": "Determine ascorbic content with a complete sample basis, and for a fresh changed matrix actually examine controls, justify method adaptation and state the limits of the result."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "ascorbic-structure-and-suitable-method",
                "actual-controlled-ascorbic-planning-and-execution",
                "ascorbic-content-dilution-and-interference"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "fresh-analyte-specific-controlled-assay",
                "textDe": "Frische geeignete Ascorbinprobe, veränderte Verdünnung/Blindwert, Referenzkontrolle, weitere Reduktionsmittel, tatsächliche eigene Planung/Durchführung.",
                "textEn": "Fresh suitable ascorbic sample, changed dilution/blank, reference control, other reducing agents, the learner’s actual planning/execution."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "fresh-ascorbic-school-assay-own-records",
                "taskDemandDe": "Plane und führe eine geeignete quantitative Ascorbinsäurebestimmung an einer frischen geeigneten Schulprobe tatsächlich durch. Nutze die bereitgestellte Ascorbinstruktur zur Methodenwahl; dokumentiere eigene Probenvorbereitung, passenden Blindwert, Referenzkontrolle und Rohwerte. Zusätzliche Rechenkontrolle, nicht Durchführungsevidenz: I₂0,0045mol/L; Verbrauch10,60mL minus Blindwert0,60mL für20,00mL einer fünffach verdünnten Probe; M(Ascorbinsäure)=176,12g/mol; Stoffmengenverhältnis1:1.",
                "taskDemandEn": "Plan and actually perform an appropriate quantitative ascorbic-acid assay on a fresh suitable school sample. Use the supplied ascorbic structure to select the method; document the learner’s own preparation, appropriate blank, reference control and raw readings. Additional calculation check, not execution evidence: I₂0.0045mol/L; consumption10.60mL minus blank0.60mL for20.00mL of a fivefold-diluted sample; M(ascorbic acid)=176.12g/mol;1:1 molar ratio.",
                "expectedPerformanceDe": "Eigene Planung und tatsächliche Durchführung sind belegt und von den Zusatzdaten getrennt. Kontrollrechnung: korrigierter Verbrauch10,00mL, n=0,000045mol, m=7,9254mg in20,00mL Messlösung;396,27mg/L Messlösung und1981,35mg/L Original. Kontrollen begründen die Gültigkeit für diese Matrix; nicht bloß allen Iodverbrauch ohne Störstoffprüfung Ascorbinsäure zuordnen.",
                "expectedPerformanceEn": "The learner’s own planning and actual execution are evidenced separately from the extra data. Check: corrected consumption10.00mL, n=0.000045mol, m=7.9254mg in20.00mL measured solution;396.27mg/L measured solution and1981.35mg/L original. Controls establish validity for this matrix; do not simply attribute all iodine consumption to ascorbic acid without interference checks.",
                "understandingFocusDe": "Strukturbegründete tatsächlich kontrollierte Bestimmung und vollständiger Probenbezug.",
                "understandingFocusEn": "Structure-based actual controlled assay and complete sample basis."
              },
              {
                "id": "fresh-ascorbic-matrix-interference-and-new-measurement",
                "taskDemandDe": "Untersuche eine andere frische geeignete Probe mit veränderter Verdünnung. Ein bereitgestellter Matrixzusatz enthält zusätzlich einen reduzierenden Stoff. Plane UND führe Kontroll- und Bestimmungsschritte tatsächlich durch, um zu prüfen, ob ein erhöhter Iodverbrauch der Ascorbinsäure zugeordnet werden darf oder eine geeignetere Methode nötig ist. Rechenkontrolle nur unter nachgewiesen geeigneten Bedingungen: I₂0,0040mol/L;7,80mL minus0,30mL Blindwert in10,00mL einer dreifach verdünnten Probe.",
                "taskDemandEn": "Investigate a different fresh suitable sample with changed dilution. A supplied matrix addition includes another reducing substance. Plan AND actually perform control and assay steps to examine whether increased iodine consumption can be assigned to ascorbic acid or a more appropriate method is needed. Calculation check only under demonstrated suitable conditions: I₂0.0040mol/L;7.80mL minus0.30mL blank in10.00mL of a threefold-diluted sample.",
                "expectedPerformanceDe": "Eigene frische Mess-/Kontrollprotokolle zeigen die Überprüfung. Mehrverbrauch durch weitere Reduktionsmittel wird nicht automatisch als Ascorbin gezählt; ein einfacher Lösemittelblindwert beseitigt nicht jede Matrixstörung. Geeignete zusätzliche Kontrollen beziehungsweise ein geeignetes spezifischeres Verfahren und neue Messungen sind erforderlich. Nur bei belegter Eignung gilt die Kontrollrechnung n=0,000030mol, m=5,2836mg,528,36mg/L Messlösung und1585,08mg/L Original. Andernfalls kein scheinpräziser Ascorbingehalt.",
                "expectedPerformanceEn": "The learner’s fresh measurement/control records show the examination. Consumption by other reducing agents is not automatically counted as ascorbic acid; a simple solvent blank does not remove every matrix interference. Appropriate additional controls or a suitable more-selective procedure and new measurements are required. Only when suitability is evidenced does the check yield n=0.000030mol, m=5.2836mg,528.36mg/L measured solution and1585.08mg/L original. Otherwise do not report a falsely precise ascorbic content.",
                "understandingFocusDe": "Eigenständiger frischer Experimentaltransfer, Matrixselektivität und ehrliche Verfahrensgrenzen.",
                "understandingFocusEn": "Independent fresh experimental transfer, matrix selectivity and honest method limits."
              }
            ]
          }
        }
      ],

              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "steric",
                "textDe": "Zugang zum Reaktionszentrum wird mit der Substitution des C-Atoms variiert.",
                "textEn": "Access to the reaction center varies with carbon substitution."
              },
              {
                "id": "electronic",
                "textDe": "Induktive Stabilisierung eines Carbokations wird zusätzlich beurteilt.",
                "textEn": "Inductive stabilization of a carbocation is additionally considered."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "primary-tertiary-mechanism",
                "taskDemandDe": "Vergleiche 1-Brombutan und tert-Butylbromid bei einem geeigneten nukleophilen Austausch. Skizziere Rückseitenangriff und Carbokationweg; begründe die unterschiedlichen Tendenzen.",
                "taskDemandEn": "Compare 1-bromobutane and tert-butyl bromide in a suitable nucleophilic substitution. Sketch backside attack and the carbocation route; justify different tendencies.",
                "expectedPerformanceDe": "Die lernende Person erklärt bessere Zugänglichkeit des primären C für SN2 und Stabilisierung des tertiären Carbokations durch Alkylgruppen für SN1; sie behauptet keine absolute Ausschließlichkeit.",
                "expectedPerformanceEn": "The learner explains better primary-carbon access for SN2 and alkyl-group stabilization of the tertiary carbocation for SN1 without claiming either route is absolutely exclusive.",
                "understandingFocusDe": "Sterische und elektronische Beiträge werden gemeinsam begründet.",
                "understandingFocusEn": "Steric and electronic contributions are justified together."
              },
              {
                "id": "fresh-neopentyl-counterexample",
                "taskDemandDe": "Ein neuer Stoff ist Neopentylbromid: Das Br-tragende C ist formal primär, daneben sitzt eine stark verzweigte Gruppe. Prüfe die Aussage „primär heißt immer schnelle SN2“.",
                "taskDemandEn": "A new compound is neopentyl bromide: the Br-bearing carbon is formally primary, next to a strongly branched group. Check the claim that primary always means fast SN2.",
                "expectedPerformanceDe": "Die lernende Person verwirft die Pauschalregel wegen sterischer Abschirmung des Rückseitenangriffs und trennt das vom schwach stabilisierten primären Carbokation für SN1.",
                "expectedPerformanceEn": "The learner rejects the blanket rule because branching hinders backside attack and separates this from poor stabilization of a primary carbocation for SN1.",
                "understandingFocusDe": "Gegenbeispiel prüft Mechanismenverständnis über Etiketten hinaus.",
                "understandingFocusEn": "A counterexample tests mechanism understanding beyond labels."
              }
            ]
          }
        }
      ],

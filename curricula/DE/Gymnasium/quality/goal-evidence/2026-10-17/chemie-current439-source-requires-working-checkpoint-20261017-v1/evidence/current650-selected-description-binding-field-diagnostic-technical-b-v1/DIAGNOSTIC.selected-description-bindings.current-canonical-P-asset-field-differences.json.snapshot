      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "selected-diatomic-elements-and-equation-notation",
                "essentialUnderstandingDe": "Wichtige elementare Gase wie H2,O2,N2 und Cl2 können aus zwei gleichartigen gebundenen Atomen je Molekül bestehen; das bedeutet weder ein Gemisch noch eine Verbindung verschiedener Elemente. Nicht alle Gase sind zweiatomig. Formelindizes beschreiben ein Teilchen, Koeffizienten dessen Anzahl in einem Reaktionsverhältnis; beim Ausgleichen bleibt die vorgegebene Stoffformel erhalten.",
                "essentialUnderstandingEn": "Important elemental gases such as H2,O2,N2 and Cl2 can consist of two bonded atoms of the same element per molecule; this is neither a mixture nor a compound of different elements. Not all gases are diatomic. Formula subscripts describe one particle, whereas coefficients count particles in a reaction ratio; balancing retains the given substance formulas.",
                "observablePerformanceDe": "Die lernende Person deutet gegebene Teilchenmodelle wichtiger elementarer Gase und nutzt die Zweizahl fachlich richtig in Formeln und atomar bilanzierten Reaktionsgleichungen.",
                "observablePerformanceEn": "The learner interprets supplied particle models of important elemental gases and uses their two-atom composition correctly in formulas and atom-balanced reaction equations."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "selected-diatomic-elements-and-equation-notation"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "elemental-gas",
                "textDe": "Sauerstoff/Wasserstoff werden durch Chlor/Wasserstoff und eine einatomige Ausnahme ergänzt.",
                "textEn": "Oxygen/hydrogen are replaced by chlorine/hydrogen with a monatomic exception."
              },
              {
                "id": "notation-layer",
                "textDe": "Indizes innerhalb eines Moleküls werden von Koeffizienten vor Formeln unterschieden.",
                "textEn": "Subscripts within a molecule are distinguished from coefficients before formulas."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "oxygen-model-and-water",
                "taskDemandDe": "Gegebene Gasmodelle: Sauerstoff zeigt O–O-Paare, Stickstoff N–N-Paare, Argon einzelne Ar-Atome. Formuliere die Stoffformeln und erkläre, warum Sauerstoff trotzdem ein Element ist. Für Wasserbildung sind die Stoffformeln H2,O2,H2O vorgegeben. Stelle die ausgeglichene Gleichung auf und erläutere die unterschiedliche Bedeutung von O2 und2H2O.",
                "taskDemandEn": "Supplied gas models show oxygen as O–O pairs, nitrogen as N–N pairs and argon as individual Ar atoms. Give the formulas and explain why oxygen is still an element. Water formation uses the specified substance formulas H2,O2,H2O. Write the balanced equation and explain the different meanings of O2 and2H2O.",
                "expectedPerformanceDe": "Formeln O2,N2,Ar; die Paare enthalten jeweils nur Atome einer Elementsorte. Wasserbildung:2H2+O2→2H2O. O2 benennt zwei O-Atome in einem Sauerstoffmolekül;2H2O benennt zwei Wassermoleküle mit zusammen vier H- und zwei O-Atomen. Argon widerlegt die Verallgemeinerung „jedes Gas ist zweiatomig“.",
                "expectedPerformanceEn": "Formulas are O2,N2,Ar; each pair contains only one type of element. Water formation is2H2+O2→2H2O. O2 specifies two O atoms in one oxygen molecule;2H2O specifies two water molecules, together containing four H and two O atoms. Argon refutes the generalisation that every gas is diatomic.",
                "understandingFocusDe": "Teilchenzusammensetzung und Stoff-/Reaktionsnotation sind konsistent zu verknüpfen.",
                "understandingFocusEn": "Particle composition, substance notation and reaction notation must be linked consistently."
              },
              {
                "id": "chlorine-hydrogen-fresh",
                "taskDemandDe": "Frischer Fall ohne vorgelegte Gleichung: Wasserstoffgas besteht aus H–H-Molekülen, Chlorgas aus Cl–Cl-Molekülen; das Produkt enthält H–Cl-Moleküle. Entwickle Formeln und Reaktionsverhältnis. Prüfe die Aussagen „Cl2 ist eine Verbindung aus zwei Elementen“ und „Beim Ausgleichen kann man HCl einfach in HCl2 ändern“.",
                "taskDemandEn": "Fresh case without a supplied equation: hydrogen gas consists of H–H molecules, chlorine gas of Cl–Cl molecules and the product of H–Cl molecules. Develop formulas and the reaction ratio. Evaluate “Cl2 is a compound of two elements” and “When balancing, one can simply change HCl to HCl2”.",
                "expectedPerformanceDe": "H2+Cl2→2HCl erhält jeweils zwei H- und Cl-Atome. Cl2 enthält zwei Atome desselben Elements, nicht zwei Elemente. HCl2 wäre eine andere Zusammensetzung; ausgeglichen wird hier mit dem Koeffizienten2 vor HCl. Die Begründung nutzt die gelieferten Molekülmodelle, keine unbelegte Regel für alle elementaren Gase.",
                "expectedPerformanceEn": "H2+Cl2→2HCl conserves two H and two Cl atoms. Cl2 has two atoms of one element, not two elements. HCl2 would have a different composition; balancing here uses the coefficient2 before HCl. The reasoning uses the supplied molecular models rather than an unsupported rule for all elemental gases.",
                "understandingFocusDe": "Neues Gas-/Produktpaar erfordert selbstständige molekulare Bilanz und Indexkritik.",
                "understandingFocusEn": "A new gas/product pair requires independent molecular balancing and critique of subscript changes."
              }
            ]
          }
        }
      ],

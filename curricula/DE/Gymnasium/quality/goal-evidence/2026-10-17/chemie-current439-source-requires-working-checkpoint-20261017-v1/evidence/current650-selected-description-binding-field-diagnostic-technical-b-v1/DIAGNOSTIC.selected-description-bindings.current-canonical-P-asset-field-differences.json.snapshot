        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Reaktionstypen mechanismisch einordnen",
          "url": "/assets/goal-visualizations/chemie/7a05a1ce-45d3-571e-be51-afcd8dfd33ca/7a05a1ce-45d3-571e-be51-afcd8dfd33ca.jpg",
          "altText": "Didaktische Visualisierung zum Lernziel \"Reaktionstypen mechanismisch einordnen\". Die lernende Person kann ausgewählte Reaktionsmechanismen, Umkehrbarkeit chemischer Reaktionen und das Donator-Akzeptor-Prinzip nutzen, um Reaktionstypen zu bestimmen und zu erklären.",
          "originalDigest": "sha256:1daf95fb4391d57981a63fdd2bc6fb6c05b40f1fd2f0d0a9506e796c183ae5c6",

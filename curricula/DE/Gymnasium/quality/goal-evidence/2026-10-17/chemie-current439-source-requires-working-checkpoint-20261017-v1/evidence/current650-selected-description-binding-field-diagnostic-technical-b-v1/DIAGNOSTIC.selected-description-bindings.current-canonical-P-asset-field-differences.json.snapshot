          "current": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "b003-70bcb6bd-core",
                "essentialUnderstandingDe": "Atomorbitale vergleichbarer Energie und passender Symmetrie können durch Linearkombination bindende und antibindende Molekülorbitale mit unterschiedlicher Elektronendichte ergeben.",
                "essentialUnderstandingEn": "Atomic orbitals of comparable energy and suitable symmetry can combine into bonding and antibonding molecular orbitals with different electron density.",
                "observablePerformanceDe": "Die lernende Person skizziert für zwei 1s-Orbitale gleichphasige und gegenphasige Kombination und ordnet die Energieniveaus im H2-Modell zu.",
                "observablePerformanceEn": "The learner sketches in-phase and out-of-phase combinations of two 1s orbitals and assigns their energy levels in an H2 model."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b003-70bcb6bd-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "phase",
                "textDe": "Gleich- und gegenphasige Überlappung werden kontrastiert.",
                "textEn": "In-phase and out-of-phase overlap are contrasted."
              },
              {
                "id": "symmetry",
                "textDe": "Zueinander orthogonale p-Orbitale werden von parallelen p-Orbitalen quer zur Kernachse mit möglicher π-Überlappung getrennt.",
                "textEn": "Mutually orthogonal p orbitals are distinguished from parallel p orbitals transverse to the internuclear axis, which may overlap as π orbitals."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "hydrogen-1s-combinations",
                "taskDemandDe": "Zwei vorgegebene H-1s-Orbitale werden einmal gleich- und einmal gegenphasig kombiniert. Skizziere Dichte zwischen den Kernen und ordne bindendes beziehungsweise antibindendes MO zu.",
                "taskDemandEn": "Two supplied H 1s orbitals are combined in phase and out of phase. Sketch density between nuclei and classify bonding versus antibonding MOs.",
                "expectedPerformanceDe": "Die lernende Person zeigt bei gleicher Phase erhöhte Dichte zwischen Kernen und niedrigere Energie, bei Gegenphase einen Knoten und höhere Energie.",
                "expectedPerformanceEn": "The learner shows increased internuclear density and lower energy for in-phase overlap, and a node with higher energy for opposite phase.",
                "understandingFocusDe": "Phasenlage erklärt Energieniveau-Aufspaltung.",
                "understandingFocusEn": "Phase relation explains energy-level splitting."
              },
              {
                "id": "fresh-p-orbital-sigma-pi-mismatch",
                "taskDemandDe": "Drei neue 2p-Orbitalpaare sind skizziert: A beide entlang der Kernachse, B beide parallel zueinander quer zur Kernachse, C zueinander orthogonal. Entscheide, wo σ- beziehungsweise π-Überlappung möglich ist und wo Symmetrie-Mismatch eine bindende Kombination verhindert.",
                "taskDemandEn": "Three fresh 2p orbital pairs are sketched: A both along the internuclear axis, B both parallel to one another transverse to that axis, and C mutually orthogonal. Decide where sigma or pi overlap is possible and where symmetry mismatch prevents a bonding combination.",
                "expectedPerformanceDe": "Die lernende Person ordnet A einer möglichen σ- und B einer möglichen π-Überlappung zu. Nur die zueinander orthogonalen Orbitale C liefern in dieser vereinfachten Geometrie keine passende bindende Überlappung; quer zur Kernachse allein bedeutet nicht „keine Bindung“.",
                "expectedPerformanceEn": "The learner identifies possible sigma overlap for A and pi overlap for B. Only the mutually orthogonal pair C lacks compatible bonding overlap in this simplified geometry; being transverse to the internuclear axis alone does not mean no bond.",
                "understandingFocusDe": "Symmetrie hängt von der gegenseitigen Orbitalorientierung ab; parallele p-Orbitale quer zur Achse können π-MOs bilden.",
                "understandingFocusEn": "Symmetry depends on orbital orientation relative to each other; parallel p orbitals transverse to the axis can form pi MOs."
              }
            ]
          }
        }
      ],

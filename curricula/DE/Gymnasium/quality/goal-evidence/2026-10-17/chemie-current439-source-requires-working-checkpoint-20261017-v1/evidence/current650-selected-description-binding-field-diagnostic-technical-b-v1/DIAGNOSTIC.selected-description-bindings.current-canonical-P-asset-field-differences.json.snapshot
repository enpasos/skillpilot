            "archetype": "representation",
            "expectations": [
              {
                "id": "b003-c98683ae-core",
                "essentialUnderstandingDe": "Im Hybridisierungsmodell bestimmt die Zahl und Art der Elektronendomänen am C die räumliche Anordnung von σ-Bindungen; nicht hybridisierte p-Orbitale tragen π-Bindungen.",
                "essentialUnderstandingEn": "In the hybridization model, the number and kind of electron domains at carbon determine sigma-bond geometry; unhybridized p orbitals contribute pi bonds.",
                "observablePerformanceDe": "Die lernende Person stellt ein gegebenes kleines organisches Molekül mit passenden sp3-, sp2- oder sp-Zentren und korrekter Bindungsgeometrie dar.",
                "observablePerformanceEn": "The learner represents a supplied small organic molecule with suitable sp3, sp2, or sp centers and correct bonding geometry."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b003-c98683ae-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "bond-order",
                "textDe": "Einfach-, Doppel- und Dreifachbindung werden in Darstellungen variiert.",
                "textEn": "Single, double, and triple bonds vary across representations."
              },
              {
                "id": "geometry",
                "textDe": "Tetraedrische, planare und lineare Zentren werden geprüft.",
                "textEn": "Tetrahedral, planar, and linear centers are checked."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "ethene-hybrid-drawing",
                "taskDemandDe": "Stelle Ethen als Hybridisierungsmodell dar: markiere an jedem C σ-Bindungsrichtungen, das unveränderte p-Orbital und die π-Bindung. Vergleiche die Geometrie mit einer planaren Strukturformel.",
                "taskDemandEn": "Represent ethene with a hybridization model: mark sigma directions, the unhybridized p orbital, and the pi bond at each carbon. Compare geometry with a planar structure.",
                "expectedPerformanceDe": "Die lernende Person zeichnet beide C als sp2/trigonal-planar, eine C-C-σ- und eine π-Bindung sowie passende C-H-σ-Bindungen.",
                "expectedPerformanceEn": "The learner draws both carbons sp2/trigonal planar, one C-C sigma plus one pi bond, and suitable C-H sigma bonds.",
                "understandingFocusDe": "Darstellung verbindet Bindungstyp und Geometrie.",
                "understandingFocusEn": "Representation links bond type and geometry."
              },
              {
                "id": "fresh-propyne-mixed-centers",
                "taskDemandDe": "Ein neues Molekül ist Propin CH3-C≡CH. Markiere die Hybridisierung jedes C und zeige, warum das terminale C linear, das CH3-C aber annähernd tetraedrisch ist.",
                "taskDemandEn": "A fresh molecule is propyne CH3-C≡CH. Mark hybridization at each carbon and show why terminal C is linear while methyl C is approximately tetrahedral.",
                "expectedPerformanceDe": "Die lernende Person ordnet CH3-C sp3 und beiden Dreifachbindungs-C sp zu; sie zeigt eine σ- und zwei π-Bindungsanteile der C≡C-Bindung.",
                "expectedPerformanceEn": "The learner assigns sp3 to methyl carbon and sp to both triple-bond carbons and shows one sigma and two pi components of C≡C.",
                "understandingFocusDe": "Gemischtes Molekül prüft lokale Modellauswahl.",
                "understandingFocusEn": "A mixed molecule tests local model choice."
              }
            ]
          }
        }
      ],

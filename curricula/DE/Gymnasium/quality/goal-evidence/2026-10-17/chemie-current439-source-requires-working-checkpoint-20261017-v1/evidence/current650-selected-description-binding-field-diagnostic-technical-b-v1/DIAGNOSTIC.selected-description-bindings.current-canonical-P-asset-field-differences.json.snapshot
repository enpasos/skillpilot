      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "elemental-properties",
                "essentialUnderstandingDe": "Ausgewählte Halogene haben stoffgenaue Eigenschaften: bei Raumtemperatur ist Cl₂ ein Gas, Br₂ eine Flüssigkeit und I₂ ein Feststoff. Zustände, Farbe, Löslichkeit und Reaktivität sind anhand bereitgestellter Stoffdaten zu charakterisieren; nicht alle Gruppenmitglieder sind gleich.",
                "essentialUnderstandingEn": "Selected halogens have substance-specific properties: at room temperature Cl₂ is a gas, Br₂ a liquid and I₂ a solid. State, colour, solubility and reactivity are characterized using supplied substance data; group members are not identical.",
                "observablePerformanceDe": "Die lernende Person beschreibt die ausgewählten Halogene mit tatsächlichen Stoffdaten und begründet eine konkrete Verwendung mit der zugehörigen Eigenschaft.",
                "observablePerformanceEn": "The learner describes selected halogens using actual substance data and justifies a concrete use through the relevant property."
              },
              {
                "id": "element-and-compound-use",
                "essentialUnderstandingDe": "Elementare Halogene und ihre Verbindungen sind verschiedene Stoffe. Eine Verwendung von Chlor, Hypochlorit, Iod oder Fluorid ist mit der Eigenschaft genau dieses Stoffes zu begründen; Gruppenzugehörigkeit oder das Vorhandensein eines Halogenatoms reicht nicht.",
                "essentialUnderstandingEn": "Elemental halogens and their compounds are different substances. A use of chlorine, hypochlorite, iodine or fluoride must be justified by the properties of that specific substance; group membership or containing a halogen atom is insufficient.",
                "observablePerformanceDe": "Die lernende Person trennt Elementstoff und Verbindung, ordnet bereitgestellte Gebrauchsdaten dem richtigen Stoff zu und widerlegt eine unzulässige Gleichsetzung ihrer Eigenschaften.",
                "observablePerformanceEn": "The learner distinguishes elemental substances and compounds, assigns supplied use data to the correct substance, and rejects an invalid equivalence of their properties."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "elemental-properties",
                "element-and-compound-use"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "substance-data-and-purpose",
                "textDe": "Andere konkrete elementare Stoffe und Verbindungen mit Daten zu Zustand, Löslichkeit und Wirkung; jede Verwendungsbegründung muss den passenden Stoff benennen.",
                "textEn": "Different specific elemental substances and compounds with state, solubility and activity data; every use justification must name the correct substance."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chlorine-hypochlorite-specific-use",
                "taskDemandDe": "Eine Datentabelle enthält Zustand/Farbe ausgewählter Halogene und gibt an: Chlor wird unter kontrollierten Bedingungen zur Desinfektion genutzt; gelöstes Hypochlorit in einem formulierten Reinigungsmittel wirkt oxidierend und bleichend. Charakterisiere Cl₂ und begründe beide Verwendungen getrennt. Die Angaben liefern chemische Zusammenhänge, keine Misch-/Anwendungsanleitung.",
                "taskDemandEn": "A table gives state/colour of selected halogens and states that chlorine is used for disinfection under controlled conditions; dissolved hypochlorite in a formulated cleaning product acts as an oxidant and bleach. Characterize Cl₂ and justify the two uses separately. The information provides chemistry, not a mixing or application procedure.",
                "expectedPerformanceDe": "Cl₂ wird mit seinen eigenen Tabellenmerkmalen beschrieben; seine angegebene desinfizierende Wirkung begründet den kontrollierten Einsatz. Das Reinigungsmittel enthält die Hypochloritverbindung, nicht einfach einen gasförmigen elementaren Halogenstoff. Seine eigene oxidierende Wirkung trägt die Bleichbegründung.",
                "expectedPerformanceEn": "Cl₂ is described through its own tabulated features; its supplied disinfectant activity justifies controlled use. The cleaner contains a hypochlorite compound, not simply an elemental gaseous halogen. Its own oxidizing activity supports the bleaching explanation.",
                "understandingFocusDe": "Eigenschaft trägt Verwendung; Elementstoff und Verbindung bleiben getrennt.",
                "understandingFocusEn": "Properties support uses while elements and compounds stay distinct."
              },
              {
                "id": "iodine-fluoride-transfer",
                "taskDemandDe": "Eine neue Tabelle nennt I₂ als festen Stoff, seine geringe Wasserlöslichkeit und antiseptische Wirkung einer passend formulierten Iodlösung; außerdem gibt sie den Nutzen kleiner geeigneter Fluoridanteile für Zahnschmelz an. Erkläre den Einsatz der Iodformulierung und einer fluoridhaltigen Zahncreme. Prüfe, ob elementares F₂ deshalb dieselbe Verwendung habe.",
                "taskDemandEn": "A new table identifies I₂ as a solid, its low water solubility and antiseptic activity in a suitably formulated iodine solution; it also supplies the benefit of small suitable fluoride amounts for enamel. Explain the iodine formulation and fluoride toothpaste, and assess whether elemental F₂ has the same use.",
                "expectedPerformanceDe": "Die Iodformulierung ermöglicht den angegebenen Wirkstoffgebrauch trotz geringer Wasserlöslichkeit; Stoffeigenschaften von I₂ und Formulierung werden nicht vertauscht. Fluoridionen aus einer geeigneten Verbindung tragen den angegebenen Zahnschmelznutzen. Daraus folgt keine Verwendung oder Sicherheit von elementarem F₂; Verbindungseigenschaften sind nicht die Eigenschaften des Elements.",
                "expectedPerformanceEn": "The iodine formulation enables the supplied use despite low water solubility; properties of I₂ and the formulation are not confused. Fluoride ions from a suitable compound support the supplied enamel benefit. This implies neither a use nor safety of elemental F₂; compound properties are not elemental properties.",
                "understandingFocusDe": "Frischer Halogen-/Verbindungsfall mit begründeter Unterscheidung.",
                "understandingFocusEn": "Fresh halogen/compound case with a reasoned distinction."
              }
            ]
          }
        }
      ],

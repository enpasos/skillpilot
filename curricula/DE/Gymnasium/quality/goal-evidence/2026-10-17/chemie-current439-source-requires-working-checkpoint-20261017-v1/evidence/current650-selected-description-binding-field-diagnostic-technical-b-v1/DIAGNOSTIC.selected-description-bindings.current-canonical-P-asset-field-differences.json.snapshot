        "bookDigest": "sha256:a51cdc387bb26ef66053050933866838c0d75f220ef570d900f2aa1da388514c",
        "goalFingerprint": "sha256:730fd25605fc7c30db155b352cac430ed4b7b4d4d3f7446c7782da794b7bfefa",
        "pageFingerprint": "sha256:b0918737104cc5132b0e3d637e065f8b98983ea7393c2c9b60f374b38fbceb46",
        "stockGoalReviewContextFingerprint": "sha256:1143137a1593e224258386120995d1ef8633f6b1c9b821e2530a50d7a5ae395f",
        "oldPageStockFingerprint": "sha256:b0918737104cc5132b0e3d637e065f8b98983ea7393c2c9b60f374b38fbceb46",
        "profileFingerprint": null,

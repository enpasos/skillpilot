        "pageFingerprint": "sha256:55d2ef983aa55df3ea604f8c4e95c4a06a76ef99b7934670f73939dac6b45c5c",
        "stockGoalReviewContextFingerprint": "sha256:752d4ca1a615a84117c93cf3a5b6dc14a3110fb6772ca5acacbedf16e9384cf5",
        "oldPageStockFingerprint": "sha256:55d2ef983aa55df3ea604f8c4e95c4a06a76ef99b7934670f73939dac6b45c5c",
        "profileFingerprint": null,

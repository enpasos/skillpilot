      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "energy-levels-barrier-and-catalyst-path",
                "essentialUnderstandingDe": "Im Energieprofil bestimmt die Lage der Produkt- relativ zur Eduktenergie exotherm oder endotherm. Der höchste Punkt über dem Eduktniveau kennzeichnet die Aktivierungsbarriere; ein katalysierter Weg kann sie senken, während Anfangs- und Endniveau gleich bleiben.",
                "essentialUnderstandingEn": "In an energy profile, the product level relative to the reactant level determines exothermic or endothermic change. The peak above the reactant level represents the activation barrier; a catalyzed path may lower it while leaving initial and final levels unchanged.",
                "observablePerformanceDe": "Die lernende Person stellt für vorgegebene qualitative Energielagen ein Profil mit beschrifteten Achsen, Edukten, Produkten und Barriere dar, ordnet die Energieänderung ein und deutet einen alternativen katalysierten Weg ohne Änderung der Reaktionsenergie.",
                "observablePerformanceEn": "Given qualitative energy levels, the learner constructs a profile with labeled axes, reactants, products, and barrier, classifies the energy change, and interprets an alternative catalyzed path without changing reaction energy."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "energy-levels-barrier-and-catalyst-path"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "energy-direction",
                "textDe": "Exotherme und endotherme Endniveaus wechseln.",
                "textEn": "Exothermic and endothermic final levels alternate."
              },
              {
                "id": "path",
                "textDe": "Unkatalysierter und katalysierter Reaktionsweg werden verglichen.",
                "textEn": "Uncatalyzed and catalyzed reaction paths are compared."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "exothermic-profile-construction",
                "taskDemandDe": "Ein neuer Text beschreibt eine Reaktion mit Produkten auf niedrigerem Energieniveau als die Edukte und einer deutlich höheren Zwischenbarriere. Zeichne ein qualitatives Energieprofil, kennzeichne Energieänderung und Aktivierungsenergie und ergänze einen katalysierten Weg.",
                "taskDemandEn": "A fresh text describes a reaction whose products lie below the reactants in energy and whose intermediate barrier is considerably higher. Draw a qualitative energy profile, mark reaction energy change and activation energy, and add a catalyzed path.",
                "expectedPerformanceDe": "Die lernende Person zeichnet eine Energie- und Reaktionsverlaufsachse, ein niedrigeres Produktniveau und eine Barriere oberhalb der Edukte. Die katalysierte Kurve hat einen niedrigeren Gipfel, aber dieselben Anfangs- und Endniveaus; die Reaktion bleibt exotherm.",
                "expectedPerformanceEn": "The learner labels energy and reaction-progress axes, places products below reactants, and shows a peak above the reactants. The catalyzed curve has a lower peak but the same initial and final levels; the reaction remains exothermic.",
                "understandingFocusDe": "Reaktionsenergie und Aktivierungsbarriere werden getrennt codiert.",
                "understandingFocusEn": "Reaction energy and activation barrier are encoded separately."
              },
              {
                "id": "fresh-endothermic-claim-check",
                "taskDemandDe": "In einem unabhängig vorgelegten endothermen Fall liegt das Produktniveau höher. Eine Skizze zeigt mit Katalysator einen niedrigeren Gipfel, aber zusätzlich ein Produktniveau unter den Edukten. Prüfe die Skizze und korrigiere sie mit Begründung.",
                "taskDemandEn": "In an independently supplied endothermic case, the products are at a higher level. A sketch shows a lower peak with a catalyst but also places the products below the reactants. Check and correct the sketch with reasons.",
                "expectedPerformanceDe": "Die lernende Person hält das höhere Produktniveau bei beiden Wegen fest, senkt nur die Barriere und erklärt, dass der Katalysator die Energiedifferenz und damit die Einordnung als endotherm nicht ändert.",
                "expectedPerformanceEn": "The learner keeps products above reactants for both paths, lowers only the barrier, and explains that the catalyst does not change the energy difference or the endothermic classification.",
                "understandingFocusDe": "Ein veränderter Weg darf die Anfangs-/Endbilanz nicht verfälschen.",
                "understandingFocusEn": "A changed path must not distort the initial-to-final balance."
              }
            ]
          }
        }
      ],

      "finalTextDifferences": [
        {
          "field": "descriptionDe",
          "before": "Die lernende Person kann Molekülgeometrien und einfache Bindungswinkel mit dem EPA-Modell erläutern.",
          "current": "Die lernende Person kann zu bereits dargestellten Molekülgestalten und EPA-Elektronendomänen passende idealisierte einfache Bindungswinkel zuordnen, qualitative Winkelabweichungen durch freie Elektronenpaare begründen und die Grenzen solcher Modellwinkel gegenüber exakten Messwerten erläutern."
        },
        {
          "field": "descriptionEn",
          "before": "The learner can explain molecular geometries and simple bond angles using the VSEPR model.",
          "current": "The learner can assign appropriate idealized simple bond angles to already depicted molecular shapes and VSEPR electron domains, explain qualitative angle deviations caused by lone pairs and distinguish the limits of such model angles from exact measured values."
        },
        {

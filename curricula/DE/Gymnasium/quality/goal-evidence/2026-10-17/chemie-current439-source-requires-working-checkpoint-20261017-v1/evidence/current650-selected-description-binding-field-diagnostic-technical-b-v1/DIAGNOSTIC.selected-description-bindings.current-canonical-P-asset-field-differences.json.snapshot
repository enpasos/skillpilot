            "goalFingerprint": "sha256:a13ea12c7c844f97972eca0447b82a6c7a63503e1afd8fc262ea6d1fcc6c2280",
            "reviewInputFingerprint": "sha256:ec0dd23c0880352c8b16b6907d3d46c0f5828624b9461c5136c754338fe73796",

        "bookDigest": "sha256:6dd1d31a512e2473ccc5d489962ac3b2cb4a1ca57bdc7b4d1a39b4602b2ec92f",
        "goalFingerprint": "sha256:3aa4633c04b3e1753a9baf8eecf678f4aab262773e9a090c8be651e5abf4b113",
        "pageFingerprint": "sha256:c8bc9610b69eae2fab9338fae3f4e0925d85784693ec9963a06d8e1eaa5ac91a",
        "stockGoalReviewContextFingerprint": "sha256:5f6c33c375a831c1d256ee1fbefd4d7686d77a6f7aad8cb97162b02e65cca498",
        "oldPageStockFingerprint": "sha256:c8bc9610b69eae2fab9338fae3f4e0925d85784693ec9963a06d8e1eaa5ac91a",
        "profileFingerprint": null,

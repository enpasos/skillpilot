      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "experiment",
            "expectations": [
              {
                "id": "fire-condition-and-safe-extinguishing-inference",
                "essentialUnderstandingDe": "Ein Brand benötigt Brennstoff, Sauerstoffzufuhr und ausreichende Energie. Eine Löschmaßnahme unterbricht mindestens eine dieser Bedingungen; ihre Eignung hängt vom Brennstoff und von Gefahren der Situation ab.",
                "essentialUnderstandingEn": "A fire needs fuel, an oxygen supply, and sufficient energy. An extinguishing measure interrupts at least one of these conditions; its suitability depends on the fuel and hazards of the situation.",
                "observablePerformanceDe": "Die lernende Person legt in einem kleinen lehrkraftbetreuten Brandmodell eine Vergleichsbedingung fest, erhebt und dokumentiert eigene Beobachtungen, ordnet eine Maßnahme der unterbrochenen Brandbedingung zu und begründet in einem getrennten schriftlichen Fall eine stoffgerechte Schutzentscheidung samt relevanter Gefahr. Zünden und alle Gefahrenhandlungen übernimmt die Lehrkraft.",
                "observablePerformanceEn": "In a small teacher-supervised fire model, the learner sets a comparison condition, collects and records their own observations, identifies the fire condition interrupted by a measure, and justifies a fuel-appropriate protective choice with a relevant hazard in a separate written case. The teacher handles ignition and every hazardous action."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "fire-condition-and-safe-extinguishing-inference"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "inquiry-mode",
                "textDe": "Eine eigene Beobachtungsreihe im lehrkraftbetreuten Modell wird einem schriftlich vorgelegten Gefahrfall gegenübergestellt.",
                "textEn": "The learner's own observation series in a teacher-supervised model is contrasted with a supplied written hazard case."
              },
              {
                "id": "fuel-hazard",
                "textDe": "Ein kleiner Kerzen-Modellbrand wird einem Fettbrand mit ungeeignetem Wasser gegenübergestellt.",
                "textEn": "A small candle model fire is contrasted with a grease fire for which water is unsuitable."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "supervised-candle-comparison-own-observations",
                "taskDemandDe": "Im Chemieunterricht stehen zwei gleiche kleine Kerzen in standsicheren, feuerfesten Schalen. Lege vorab fest, welche Kerze als offene Vergleichsbedingung dient und welche unter eine hitzefeste Glasglocke kommt. Die Lehrkraft zündet beide Kerzen an, setzt die Glasglocke auf und übernimmt sämtliche Handlungen an den Flammen. Beobachte selbst, notiere für beide Kerzen das Brennverhalten und die Reihenfolge des Erlöschens und erkläre mit den Brandbedingungen den Unterschied. Welche Grenze hat dieses Modell für Aussagen über den exakten Sauerstoffgehalt?",
                "taskDemandEn": "In a chemistry class, two identical small candles stand in stable, fireproof trays. Decide in advance which remains the open comparison and which will be covered by a heat-resistant glass bell. The teacher lights both candles, places the bell, and handles every action near the flames. Observe and record the burning behavior and order of extinction for both candles, then explain the difference using the fire conditions. What limits does this model have for claims about an exact oxygen concentration?",
                "expectedPerformanceDe": "Die lernende Person benennt die offene Kerze als Vergleich, dokumentiert ihre eigenen Beobachtungen für beide Kerzen und ordnet das frühere Erlöschen unter der Glocke der eingeschränkten Sauerstoffzufuhr zu. Sie behauptet aus der Brenndauer keinen genauen Sauerstoff-Grenzwert und fasst die Glocke oder Flamme nicht selbst an.",
                "expectedPerformanceEn": "The learner names the open candle as the comparison, records their own observations for both candles, and links the earlier extinction under the bell to restricted oxygen supply. They do not infer an exact oxygen threshold from burning time and do not handle the bell or flame themselves.",
                "understandingFocusDe": "Ein selbst geplanter und dokumentierter Vergleich stützt das Löschprinzip, ohne aus dem Modell einen exakten Sauerstoffwert abzuleiten.",
                "understandingFocusEn": "A learner-planned and recorded comparison supports the extinguishing principle without treating the model as a precise oxygen measurement."
              },
              {
                "id": "fresh-grease-fire-choice",
                "taskDemandDe": "Ein neuer schriftlicher Fall beschreibt brennendes Speiseöl. Unter bereitgestellten Maßnahmekarten stehen Wasser und ein ausdrücklich für Brandklasse F geeigneter Löscher. Wähle nur auf dem Papier eine fachlich geeignete Maßnahme, begründe das Löschprinzip und erkläre, warum Wasser hier ausgeschlossen wird. Keine praktische Durchführung.",
                "taskDemandEn": "A fresh written case describes burning cooking oil. Supplied response cards include water and an extinguisher explicitly rated for class F fires. Choose a chemically appropriate option on paper only, justify its extinguishing principle, and explain why water is excluded here. No practical attempt is requested.",
                "expectedPerformanceDe": "Die lernende Person wählt den ausdrücklich geeigneten Fettbrandlöscher, beschreibt die Unterbrechung der Brandbedingungen und erklärt, dass Wasser bei heißem Fett den Brand gefährlich ausbreiten kann. Die Antwort empfiehlt keinen unbetreuten Löschversuch.",
                "expectedPerformanceEn": "The learner selects the explicitly suitable grease-fire extinguisher, describes interruption of the fire conditions, and explains that water can dangerously spread a hot-fat fire. The answer does not recommend an unsupervised attempt to fight the fire.",
                "understandingFocusDe": "Schutzmaßnahmen müssen an Brandstoff und Gefahr angepasst werden.",
                "understandingFocusEn": "Protective measures must fit the burning material and hazard."
              }
            ]
          }
        }
      ],

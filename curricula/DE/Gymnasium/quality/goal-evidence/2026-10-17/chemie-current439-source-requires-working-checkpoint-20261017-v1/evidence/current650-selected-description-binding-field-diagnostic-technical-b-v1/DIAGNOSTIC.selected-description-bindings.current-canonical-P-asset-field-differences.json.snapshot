        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Halogenide, Sulfate, Nitrate und Carbonate einordnen",
          "url": "/assets/goal-visualizations/chemie/b5086548-169e-5d63-a14a-dabf631fa013/b5086548-169e-5d63-a14a-dabf631fa013.jpg",
          "altText": "Didaktische Visualisierung zum Lernziel \"Halogenide, Sulfate, Nitrate und Carbonate einordnen\". Die lernende Person kann ausgewaehlte Salzklassen wie Halogenide, Sulfate, Nitrate und Carbonate anhand ihrer Ionen fachlich einordnen.",
          "originalDigest": "sha256:9e9987acbd4199480770fd2f3e48d8d61fca14cc1c49998cf4f8ca85fa68708f",

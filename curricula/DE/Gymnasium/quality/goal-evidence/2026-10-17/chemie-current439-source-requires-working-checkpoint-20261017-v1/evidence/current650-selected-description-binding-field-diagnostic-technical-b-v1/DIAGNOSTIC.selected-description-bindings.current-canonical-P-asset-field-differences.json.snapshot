      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "b009-a530-bond-energy",
                "essentialUnderstandingDe": "Das Spalten chemischer Bindungen benötigt Energie, das Bilden neuer Bindungen setzt Energie frei. Ob eine Reaktion insgesamt Energie abgibt oder aufnimmt, ergibt sich aus dem Vergleich beider Beiträge auf derselben Stoffmenge. Eine Darstellung mit vollständig freien Atomen kann diesen Vergleich veranschaulichen, behauptet aber keinen tatsächlichen Reaktionsweg.",
                "essentialUnderstandingEn": "Breaking chemical bonds requires energy and forming new bonds releases energy. Whether a reaction overall releases or absorbs energy follows from comparing both contributions for the same amount of substance. A drawing with fully separated atoms can illustrate this comparison but does not assert the actual reaction pathway.",
                "observablePerformanceDe": "Die lernende Person vergleicht an neuen Reaktionsmodellen gegebene Bindungsänderungen und Energiebeträge qualitativ, entscheidet den Nettoenergieumsatz und erläutert die Grenze der schematischen freien Atome.",
                "observablePerformanceEn": "For fresh reaction models, the learner compares supplied bond changes and energy amounts qualitatively, decides the net energy change and explains the limit of schematic free atoms."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b009-a530-bond-energy"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "reaction-network",
                "textDe": "Methanverbrennung und Wasserspaltung nutzen unterschiedliche Bindungssätze und entgegengesetzte Nettoenergierichtungen.",
                "textEn": "Methane combustion and water splitting use different bond sets and opposite net-energy directions."
              },
              {
                "id": "energy-balance-and-model-limit",
                "textDe": "Jeweils auf dieselbe Reaktionsmenge bezogene qualitative Balken prüfen Freisetzung gegenüber Aufnahme; freie Atome sind keine behauptete Zwischenstufe.",
                "textEn": "Qualitative bars for the same reaction amount test release versus uptake; free atoms are not asserted intermediates."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "fresh-methane-combustion-qualitative",
                "taskDemandDe": "Ein neues Papiermodell zu CH₄ + 2 O₂ → CO₂ + 2 H₂O nennt gebrochene Bindungen (vier C–H, zwei O=O) und gebildete Bindungen (zwei C=O, vier O–H). Für genau diese Reaktionsmenge zeigt ein Balkenbild: Die beim Bilden frei werdende Energie ist deutlich größer als die zum Spalten benötigte. Erkläre die Nettorichtung und prüfe die Behauptung „Bindungen spalten kostet Energie, daher ist die gesamte Reaktion endotherm“. Keine reale Verbrennung.",
                "taskDemandEn": "A fresh paper model for CH₄ + 2 O₂ → CO₂ + 2 H₂O lists bonds broken (four C–H and two O=O) and formed (two C=O and four O–H). For this same reaction amount, qualitative bars show more energy released on formation than required for breaking. Explain the net direction and assess the claim “Breaking bonds costs energy, so the whole reaction is endothermic.” No actual combustion.",
                "expectedPerformanceDe": "Die Person nennt Energiebedarf für das Lösen und größere Freisetzung beim Bilden, erklärt daher insgesamt exothermen Umsatz und verwirft die Behauptung. Sie deutet die Bilanzkarten nicht als zeitlich nachgewiesene Folge vollständig freier Atome. Ein Zahlenwert wird nicht verlangt.",
                "expectedPerformanceEn": "The learner identifies input for breaking and greater release on formation, explains an exothermic net change and rejects the claim. They do not treat accounting cards as a proven sequence of fully free atoms. No numerical result is required.",
                "understandingFocusDe": "Neue Reaktion, qualitative Nettoabwägung und Grenze der Energiebuchhaltung.",
                "understandingFocusEn": "Fresh reaction, qualitative net comparison and limit of energy accounting."
              },
              {
                "id": "fresh-water-splitting-qualitative",
                "taskDemandDe": "Ein zweites, nur als Modell vorgegebenes Schema zeigt 2 H₂O → 2 H₂ + O₂. Die Beschreibung nennt zu lösende O–H-Bindungen sowie neu entstehende H–H- und O=O-Bindungen; qualitative Balken für dieselbe Reaktionsmenge zeigen, dass die benötigte Energie beim Lösen größer ist als die Freisetzung beim Bilden. Erkläre die Nettorichtung, ohne aus dem Schema eine spontane Wasserspaltung oder freie-Atom-Zwischenstufen abzuleiten. Keine Elektrolyse durchführen.",
                "taskDemandEn": "A second supplied model shows 2 H₂O → 2 H₂ + O₂. It lists O–H bonds to break and new H–H and O=O bonds to form; qualitative bars for the same reaction amount show more energy required for breaking than released upon forming. Explain the net direction without inferring spontaneous water splitting or free-atom intermediates from the diagram. No electrolysis is performed.",
                "expectedPerformanceDe": "Die Person erklärt die insgesamt notwendige Energiezufuhr trotz Freisetzung beim Bilden der Produktbindungen und unterscheidet den Nettoeffekt vom Energiebeitrag eines Teilschritts. Die Stoffbilanz bleibt zwei H₂O zu zwei H₂ und einem O₂; kein numerischer Wert oder realer Atommechanismus wird behauptet.",
                "expectedPerformanceEn": "The learner explains the net need for energy input despite release on forming product bonds and distinguishes the overall effect from one contribution. The matter balance remains two H₂O to two H₂ and one O₂; no numerical value or actual free-atom mechanism is asserted.",
                "understandingFocusDe": "Unabhängiger Transfer auf endotherme Richtung mit anderer Bindungsbilanz.",
                "understandingFocusEn": "Independent transfer to an energy-absorbing direction with a different bond balance."
              }
            ]
          }
        }
      ],

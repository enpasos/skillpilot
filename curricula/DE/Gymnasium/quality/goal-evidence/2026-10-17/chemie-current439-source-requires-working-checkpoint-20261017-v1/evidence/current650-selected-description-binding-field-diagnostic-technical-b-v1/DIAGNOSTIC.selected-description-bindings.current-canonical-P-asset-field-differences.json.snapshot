          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "b005-5c4788a7-core",
                "essentialUnderstandingDe": "Gasdruck entsteht modellhaft durch Stöße der bewegten Teilchen gegen Wände. Bei festem N und V führt höhere Temperatur zu höherer mittlerer Bewegungsenergie; bei festem N und T führt kleineres V zu häufigeren Wandstößen.",
                "essentialUnderstandingEn": "Gas pressure is modeled by moving particles striking container walls. At fixed N and V, higher temperature raises mean kinetic energy; at fixed N and T, a smaller V yields more frequent wall collisions.",
                "observablePerformanceDe": "Die lernende Person deutet zwei neue Zustandsänderungen mit Teilchengeschwindigkeit und Stoßhäufigkeit und benennt, welche Größen konstant gehalten werden.",
                "observablePerformanceEn": "The learner interprets two fresh state changes using particle speed and collision frequency and names the quantities held constant."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b005-5c4788a7-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "variable",
                "textDe": "Temperaturänderung und Volumenänderung werden getrennt variiert.",
                "textEn": "Temperature and volume changes are varied separately."
              },
              {
                "id": "boundary",
                "textDe": "Starrer Behälter und isothermer Kolben setzen andere Randbedingungen.",
                "textEn": "A rigid container and an isothermal piston impose different constraints."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "heated-rigid-flask-data",
                "taskDemandDe": "Ein geschlossener starrer Behälter mit gleicher Gasmenge wird moderat erwärmt; Messdaten zeigen höheren Druck. Erkläre qualitativ mit dem kinetischen Teilchenmodell und nenne die festgehaltenen Größen.",
                "taskDemandEn": "A closed rigid container with the same amount of gas is moderately heated; measured pressure rises. Explain qualitatively with the kinetic particle model and name held quantities.",
                "expectedPerformanceDe": "Die lernende Person hält N und V fest, erwartet im Mittel schnellere Teilchen und veränderte Wandstöße; sie behauptet nicht, Erwärmen erzeuge neue Gasteilchen.",
                "expectedPerformanceEn": "The learner holds N and V fixed, expects faster particles on average and changed wall impacts; heating does not create new gas particles.",
                "understandingFocusDe": "Temperaturfall prüft Bewegungsenergie.",
                "understandingFocusEn": "The temperature case tests kinetic energy."
              },
              {
                "id": "fresh-isothermal-piston",
                "taskDemandDe": "Ein neues Datenset beschreibt langsame Kompression eines Gases im Kolben bei kontrolliert gleicher Temperatur und gleicher Teilchenzahl: V wird halbiert, p steigt. Erkläre die Modellursache und warum die mittlere Geschwindigkeit hier nicht wegen Kompression zwingend steigen muss.",
                "taskDemandEn": "A fresh data set describes slow compression in a piston at controlled constant temperature and particle count: V halves and p rises. Explain the model cause and why average speed need not rise due to compression here.",
                "expectedPerformanceDe": "Die lernende Person nennt mehr Wandstöße pro Flächeneinheit und Zeit bei kleinerem Raum, hält T und N fest und behauptet keinen notwendigen Geschwindigkeitsanstieg.",
                "expectedPerformanceEn": "The learner cites more wall collisions per area and time in less space, holds T and N fixed and does not claim speed must increase.",
                "understandingFocusDe": "Neuer Volumenfall prüft Randbedingungen und Stoßhäufigkeit.",
                "understandingFocusEn": "A fresh volume case tests constraints and collision frequency."
              }
            ]
          }
        }
      ],

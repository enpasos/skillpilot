        "pageFingerprint": "sha256:f2c932d28bf93341ce126a48346ead90b9fa45b5666a4f04f2cd22063db10a8b",
        "stockGoalReviewContextFingerprint": "sha256:5103a2afc5efa35af015ea77af6702f5ffae49f13d19f9884f8298a37e27ddf8",
        "oldPageStockFingerprint": "sha256:f2c932d28bf93341ce126a48346ead90b9fa45b5666a4f04f2cd22063db10a8b",

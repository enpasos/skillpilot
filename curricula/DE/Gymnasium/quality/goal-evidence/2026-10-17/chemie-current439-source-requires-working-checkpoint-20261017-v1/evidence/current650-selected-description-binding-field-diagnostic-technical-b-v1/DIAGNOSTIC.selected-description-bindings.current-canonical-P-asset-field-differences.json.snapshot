      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "combustion-as-substance-transformation",
                "essentialUnderstandingDe": "Eine einfache Verbrennung ist eine chemische Reaktion eines brennbaren Ausgangsstoffs mit Sauerstoff. Neue Stoffe entstehen; Wärme und Licht können Begleiterscheinungen sein, sind für sich allein aber kein Stoffnachweis.",
                "essentialUnderstandingEn": "Simple combustion is a chemical reaction between a combustible starting substance and oxygen. New substances form; heat and light may accompany it but alone do not identify the substances.",
                "observablePerformanceDe": "Die lernende Person ordnet Ausgangsstoffe und nachweisbare Produkte aus bereitgestellten Beobachtungen zu und begründet, weshalb der Vorgang eine Stoffumwandlung ist.",
                "observablePerformanceEn": "The learner identifies starting substances and detectable products from supplied observations and explains why the process is a substance transformation."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "combustion-as-substance-transformation"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "fuel-class",
                "textDe": "Ein kohlenstoffhaltiger Brennstoff wird mit einem Metall verglichen.",
                "textEn": "A carbon-containing fuel is compared with a metal."
              },
              {
                "id": "evidence-type",
                "textDe": "Ein Fall nutzt Gas-/Kondensatnachweise, der andere eine feste Produktprobe.",
                "textEn": "One case uses gas/condensate evidence, the other a solid product sample."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "methane-product-evidence",
                "taskDemandDe": "Ein betreuter Versuch liefert Daten zur Verbrennung von Methan in Sauerstoff: Wärme und Licht treten auf, ein aufgefangener Stoff trübt Kalkwasser und ein kühler Deckel beschlägt. Deute die Ausgangsstoffe und Produkte; erkläre, was die Beobachtungen über die Stoffänderung zeigen.",
                "taskDemandEn": "Data from a supervised methane combustion show heat and light, a collected substance turning limewater cloudy, and condensation on a cool lid. Explain the starting substances and products and what the observations show about substance change.",
                "expectedPerformanceDe": "Die lernende Person nennt Methan und Sauerstoff als Ausgangsstoffe, deutet den Kalkwassernachweis als Hinweis auf Kohlenstoffdioxid und den Beschlag als Wasser. Sie trennt diese Produktbefunde von Wärme und Licht als Begleiterscheinungen.",
                "expectedPerformanceEn": "The learner names methane and oxygen as starting substances, interprets the limewater result as evidence of carbon dioxide and the condensation as water, and distinguishes those product findings from accompanying heat and light.",
                "understandingFocusDe": "Die Reaktion wird durch beteiligte Stoffe und Produktbefunde erklärt.",
                "understandingFocusEn": "The reaction is explained by participating substances and product evidence."
              },
              {
                "id": "fresh-magnesium-data",
                "taskDemandDe": "Ein neuer Datensatz beschreibt die betreute Verbrennung eines Magnesiumbands: helles Licht, danach ein weißer Feststoff mit anderen Eigenschaften als das Metall. Welche Rolle hat Luftsauerstoff? Erkläre, warum hier die Methanprodukte nicht übernommen werden dürfen. Keine eigene Durchführung.",
                "taskDemandEn": "A fresh data set describes supervised burning of magnesium ribbon: bright light followed by a white solid with properties unlike the metal. What role does oxygen in air play? Explain why methane's products must not be copied here. No practical execution is requested.",
                "expectedPerformanceDe": "Die lernende Person erkennt Magnesium und Sauerstoff als Reaktionspartner und Magnesiumoxid als plausibles neues Produkt. Sie begründet die Stoffumwandlung und verwirft Kohlenstoffdioxid und Wasser als pauschale Verbrennungsprodukte dieses Falls.",
                "expectedPerformanceEn": "The learner identifies magnesium and oxygen as reactants and magnesium oxide as a plausible new product, explains the substance transformation, and rejects carbon dioxide and water as universal products in this case.",
                "understandingFocusDe": "Gemeinsames Reaktionsprinzip und stoffabhängige Produkte werden auseinandergehalten.",
                "understandingFocusEn": "The shared reaction principle is distinguished from fuel-dependent products."
              }
            ]
          }
        }
      ],

        "bookDigest": "sha256:b12054ec049034a09d72d4a9b531b890574a3672874eb0ad191c9bd808492020",
        "goalFingerprint": "sha256:66bf2903847d2d77b86c18e6133c00d2596ce5ffe62bd567e995f0914b5e6c28",

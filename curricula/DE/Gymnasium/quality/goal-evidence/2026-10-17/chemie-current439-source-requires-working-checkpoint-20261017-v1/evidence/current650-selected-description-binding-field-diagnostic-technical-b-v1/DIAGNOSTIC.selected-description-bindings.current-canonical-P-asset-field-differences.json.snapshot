          "field": "",
          "before": null,
          "current": {
            "archetype": "data",
            "expectations": [
              {
                "id": "content-specific-understanding",
                "essentialUnderstandingDe": "Beim Lösen werden Gitterionen getrennt und von passend orientierten Wassermolekülen hydratisiert; endotherme Gittertrennung und exotherme Hydratation werden mit konsistenten Vorzeichen addiert.",
                "essentialUnderstandingEn": "Dissolution separates lattice ions and hydrates them with appropriately oriented water molecules; endothermic lattice separation and exothermic hydration are added with consistent signs.",
                "observablePerformanceDe": "O-Seite zu Na+, H-Seiten zu Cl−; hydratisierte Ionen beweglich.787−783=+4kJ/mol,0,10×4=+0,40kJ Aufnahme. Das Lösen ist im gegebenen Modell leicht endotherm; ohne weitere Daten folgt keine exakte Temperaturabsenkung.",
                "observablePerformanceEn": "O side towards Na+, H sides towards Cl−; hydrated ions are mobile.787−783=+4kJ/mol;0.10×4=+0.40kJ absorbed. Dissolution is slightly endothermic in this model; no exact temperature fall follows without further data."
              },
              {
                "id": "fresh-transfer-and-model-boundary",
                "essentialUnderstandingDe": "Das illustrative Modell liefert keine reale Salzidentität; ausΔH allein folgen weder Sättigungskonzentration noch die Entropiebilanz.",
                "essentialUnderstandingEn": "The illustrative model identifies no real salt;ΔH alone gives neither saturation concentration nor entropy balance.",
                "observablePerformanceDe": "700−740=−40kJ/mol,0,05×(−40)=−2kJ Freisetzung. Hydratation überwiegt hier Trennungsaufwand. Positivionen ziehen O-Enden, Negativionen H-Enden an. Die Person trennt Enthalpiebilanz von einer vollständigen Gleichgewichts-/Löslichkeitsentscheidung.",
                "observablePerformanceEn": "700−740=−40kJ/mol;0.05×(−40)=−2kJ released. Hydration outweighs separation here. Positive ions attract O ends and negative ions H ends. The learner distinguishes enthalpy balance from a full equilibrium/solubility decision."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "content-specific-understanding",
                "fresh-transfer-and-model-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-material-variation",
                "textDe": "Schwach endotherme gegenüber exothermer vorgegebener Lösebilanz; Betrag, Stoffmenge und Wasserorientierung.",
                "textEn": "Weakly endothermic versus exothermic supplied dissolution balance; magnitude, amount and water orientation."
              },
              {
                "id": "specific-model-limit",
                "textDe": "Das illustrative Modell liefert keine reale Salzidentität; ausΔH allein folgen weder Sättigungskonzentration noch die Entropiebilanz.",
                "textEn": "The illustrative model identifies no real salt;ΔH alone gives neither saturation concentration nor entropy balance."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next25-5abc5961-case-1",
                "taskDemandDe": "Schulmodell für NaCl-Lösen:ΔH Gittertrennung=+787, gesamte Hydratation=−783 kJ/mol. O-Seite des Wassersδ−, H-Seitenδ+. Es werden0,10mol betrachtet; Wärmeverluste im Rechenmodell vernachlässigt. Keine gemessene Temperaturkurve wird behauptet. Beschreibe das Teilchenmodell einschließlich Wasserorientierung. BerechneΔH Lösen und die Wärmebilanz für0,10mol und deute das Vorzeichen.",
                "taskDemandEn": "School model for NaCl dissolution:lattice separationΔH=+787, total hydration=−783 kJ/mol. Water’s O sideδ−, H sidesδ+. Consider0.10mol; heat losses ignored in calculation. No measured temperature curve is claimed. Describe the particle model including water orientation. Calculate dissolutionΔH and heat balance for0.10mol; interpret the sign.",
                "expectedPerformanceDe": "O-Seite zu Na+, H-Seiten zu Cl−; hydratisierte Ionen beweglich.787−783=+4kJ/mol,0,10×4=+0,40kJ Aufnahme. Das Lösen ist im gegebenen Modell leicht endotherm; ohne weitere Daten folgt keine exakte Temperaturabsenkung.",
                "expectedPerformanceEn": "O side towards Na+, H sides towards Cl−; hydrated ions are mobile.787−783=+4kJ/mol;0.10×4=+0.40kJ absorbed. Dissolution is slightly endothermic in this model; no exact temperature fall follows without further data.",
                "understandingFocusDe": "Positive Gittertrennungsenergie und negative Gitterbildungsenergie bezeichnen entgegengesetzte Vorgänge und dürfen nicht mit demselben Vorzeichen eingesetzt werden.",
                "understandingFocusEn": "Positive lattice separation and negative lattice formation describe opposite processes and cannot use the same sign."
              },
              {
                "id": "chem-next25-5abc5961-case-2",
                "taskDemandDe": "Frischer fiktiver Salzmodellfall S mit einwertigen Kationen/Anionen:Trennung+700, Hydratation−740kJ/mol;0,05mol. Der Text behauptet „weil Lösen Energie kostet, kühlt jede Salzlösung ab“. Widerlege die Behauptung durch Bilanz und korrektes Teilchenmodell. Gib die Grenze einer Aussage über tatsächliche Löslichkeit an.",
                "taskDemandEn": "Fresh fictional salt model S with monovalent cations/anions:separation+700, hydration−740kJ/mol;0.05mol. A text claims “dissolution costs energy, so every salt solution cools”. Refute the claim using the balance and a correct particle model. State a limit on conclusions about actual solubility.",
                "expectedPerformanceDe": "700−740=−40kJ/mol,0,05×(−40)=−2kJ Freisetzung. Hydratation überwiegt hier Trennungsaufwand. Positivionen ziehen O-Enden, Negativionen H-Enden an. Die Person trennt Enthalpiebilanz von einer vollständigen Gleichgewichts-/Löslichkeitsentscheidung.",
                "expectedPerformanceEn": "700−740=−40kJ/mol;0.05×(−40)=−2kJ released. Hydration outweighs separation here. Positive ions attract O ends and negative ions H ends. The learner distinguishes enthalpy balance from a full equilibrium/solubility decision.",
                "understandingFocusDe": "Das illustrative Modell liefert keine reale Salzidentität; ausΔH allein folgen weder Sättigungskonzentration noch die Entropiebilanz.",
                "understandingFocusEn": "The illustrative model identifies no real salt;ΔH alone gives neither saturation concentration nor entropy balance."
              }
            ]
          }
        }
      ],

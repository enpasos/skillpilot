        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Bioethanolproduktion erklären",
          "url": "/assets/goal-visualizations/chemie/a76ab487-4663-5005-8454-cb3196f3773b/a76ab487-4663-5005-8454-cb3196f3773b.jpg",
          "altText": "Didaktische Visualisierung zum Lernziel \"Bioethanolproduktion erklären\". Die lernende Person kann die Gewinnung von Glucose aus stärkehaltigen Pflanzen, den Aufbau eines Glucosemoleküls und die Umwandlung zu Ethanol durch Gärung beschreiben und Nutzen-Risiko-Aspekte bewerten.",
          "originalDigest": "sha256:e9d1bab607771d9d867fd71c34104a8fce99886d56c30d4612a6c6201ca9aa8f",

      "finalTextDifferences": [],
      "oldInputTextDifferences": [],
      "canonicalContextDifferences": [],
      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "modeling",
            "expectations": [
              {
                "id": "structure-model-reasoning",
                "essentialUnderstandingDe": "Halogenreaktionen verändern Bindungen je nach Substitution oder Addition unterschiedlich; Nachweise müssen zu den tatsächlich erwarteten Teilchen und Kontrollen passen.",
                "essentialUnderstandingEn": "Halogen reactions change bonds differently in substitution and addition; tests must fit the expected species and controls.",
                "observablePerformanceDe": "Die Person bilanziert Bindungsänderungen und verbindet Beobachtung, Modell und passende Begrenzung des Nachweises.",
                "observablePerformanceEn": "The learner balances bond changes and connects observation, model and the appropriate test limitation."
              },
              {
                "id": "fresh-application-and-boundary",
                "essentialUnderstandingDe": "Entfärbung von Brom ist kein allgemeiner eindeutiger Strukturbeweis; Lichtbedingungen und andere bromverbrauchende Stoffe müssen berücksichtigt werden.",
                "essentialUnderstandingEn": "Bromine decolorization is not a universal unique structural proof; light conditions and other bromine-consuming substances must be considered.",
                "observablePerformanceDe": "A passt zur Addition an C=C, B zur radikalischen Substitution unter Licht. Der Blindansatz kontrolliert eine unspezifische Farbabnahme. Die Entfärbung allein ist nicht eindeutig; das bekannte Alkan B ist bereits ein Gegenbeispiel. Ein begrenzter erster Ansatz ist ein Bromverbrauchstest im Dunkeln unter vergleichbaren Lösemittel- und Mischbedingungen: Eine passende Reaktion an C=C kann die Bromfarbe vermindern. Das bekannte Alken A dient als Positivkontrolle, das bekannte Alkan B im Dunkeln als Negativkontrolle, der Ansatz ohne organische Probe als Blindkontrolle. Der Vergleich darf weder Licht-induzierte Substitution noch bloße unterschiedliche Verteilung der Bromfarbe als C=C-Nachweis behandeln. Auch andere bromverbrauchende Stoffe können ein positives Ergebnis verursachen; der Befund allein identifiziert C nicht eindeutig. Fiktive Beobachtungen sind Material eines Lernfalls, keine tatsächlich ausgeführten Versuche oder empirische Lernendenevidenz.",
                "observablePerformanceEn": "A fits addition to C=C, B light-induced radical substitution. The blank controls nonspecific colour loss. Decolorization alone is not unique; the known alkane B is already a counterexample. A bounded initial choice is a bromine-consumption test in the dark under comparable solvent and mixing conditions: a suitable C=C reaction can diminish bromine colour. Known alkene A is the positive control, known alkane B in the dark the negative control, and the sample-free preparation the blank. Light-induced substitution and merely different partitioning of bromine colour must not be treated as proof of C=C. Other bromine-consuming compounds can also give a positive result; this observation alone does not uniquely identify C. Fictional observations are learning-case material, not actual experiments or empirical learner evidence."
              },
              {
                "id": "independent-test-choice-conditions-controls",
                "essentialUnderstandingDe": "Die lernende Person muss eine passende Nachweismethode selbst wählen und Bedingungen, erwartete Beobachtung, Kontrollansätze und die begrenzte Aussage begründen; bloße Deutung bereits gelieferter Farbbeobachtungen genügt nicht.",
                "essentialUnderstandingEn": "The learner must independently choose an appropriate test and justify conditions, expected observation, controls and the bounded inference; interpreting supplied colour observations alone is insufficient.",
                "observablePerformanceDe": "Für die neue Probe C schlägt die Person einen Bromverbrauchstest im Dunkeln unter vergleichbaren Lösemittel-/Mischbedingungen vor, erwartet gegebenenfalls Farbverminderung und benennt bekanntes Alken, bekanntes Alkan im Dunkeln und probenfreien Blindansatz als Positiv-/Negativ-/Blindkontrollen. Sie trennt mögliche Addition von Lichtsubstitution, physischer Farbverteilung und anderen bromverbrauchenden Reaktionen.",
                "observablePerformanceEn": "For new sample C the learner proposes a bromine-consumption test in the dark with comparable solvent/mixing conditions, anticipates possible colour loss and names a known alkene, a known alkane in the dark and a sample-free blank as positive, negative and blank controls. They distinguish possible addition from light-induced substitution, physical colour partitioning and other bromine-consuming reactions."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "structure-model-reasoning",
                "fresh-application-and-boundary",
                "independent-test-choice-conditions-controls"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "material-variation",
                "textDe": "Alkan unter Licht versus Alken ohne Licht; Addition versus Substitution; Materialkontrolle statt bloße Farbe.",
                "textEn": "Alkane under light versus alkene without light; addition versus substitution; material controls instead of colour alone."
              },
              {
                "id": "counterexample",
                "textDe": "Entfärbung von Brom ist kein allgemeiner eindeutiger Strukturbeweis; Lichtbedingungen und andere bromverbrauchende Stoffe müssen berücksichtigt werden.",
                "textEn": "Bromine decolorization is not a universal unique structural proof; light conditions and other bromine-consuming substances must be considered."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-current15-622f09e5-case-1",
                "taskDemandDe": "Zwei Papiermodelle: Methan/Brom unter Licht ergibt im Erstmodell CH3Br und HBr; Ethen/Brom ohne Licht ergibt im Additionsmodell BrCH2CH2Br. Vergleiche gebrochene und gebildete Bindungen sowie die Rolle der C=C-Bindung und des HBr-Produkts.",
                "taskDemandEn": "Two paper models: methane/bromine under light gives CH3Br and HBr in an initial model; ethene/bromine without light gives BrCH2CH2Br in an addition model. Compare broken and formed bonds, the role of C=C and the HBr product.",
                "expectedPerformanceDe": "Substitution ersetzt eine C-H-Bindung durch C-Br und bildet H-Br; Addition verbraucht den π-Anteil der Doppelbindung und bildet zwei C-Br-Bindungen bei erhaltener C-C-σ-Bindung. Im einfachen Ethen-Additionsmodell entsteht kein HBr.",
                "expectedPerformanceEn": "Substitution replaces C-H with C-Br and forms H-Br; addition consumes the π component of C=C and forms two C-Br bonds while retaining C-C σ. The simple ethene-addition model produces no HBr.",
                "understandingFocusDe": "Die C-C-Verbindung wird bei der Addition nicht vollständig getrennt.",
                "understandingFocusEn": "The C-C connection is not completely severed during addition."
              },
              {
                "id": "chem-current15-622f09e5-case-2",
                "taskDemandDe": "Fiktive kontrollierte Beobachtung: Probe A ist ein bekanntes Alken und entfärbt Brom im Dunkeln; Probe B ist ein bekanntes Alkan und entfärbt erst unter Licht. Ein Blindansatz ohne organische Probe bleibt unter denselben Bedingungen braun. Deute die unterschiedlichen Bedingungen und beurteile die Aussage: Jede Entfärbung beweist eine C=C-Bindung. Wähle außerdem für eine neue unbekannte organische Probe C eine geeignete erste Nachweismethode für eine C=C-Bindung. Nenne passende Licht-, Lösemittel- und Mischbedingungen, die erwartete Beobachtung sowie Positiv-, Negativ- und Blindkontrolle und begrenze die Schlussfolgerung.",
                "taskDemandEn": "Fictional controlled observation: sample A is a known alkene and decolorizes bromine in the dark; sample B is a known alkane and does so only under light. A blank without organic sample remains brown under the same conditions. Interpret the different conditions and evaluate the claim: every decolorization proves C=C. Also choose a suitable initial test for a C=C bond in a fresh unknown organic sample C. State appropriate light, solvent and mixing conditions, the expected observation, positive and negative controls and a blank, and limit the inference.",
                "expectedPerformanceDe": "A passt zur Addition an C=C, B zur radikalischen Substitution unter Licht. Der Blindansatz kontrolliert eine unspezifische Farbabnahme. Die Entfärbung allein ist nicht eindeutig; das bekannte Alkan B ist bereits ein Gegenbeispiel. Ein begrenzter erster Ansatz ist ein Bromverbrauchstest im Dunkeln unter vergleichbaren Lösemittel- und Mischbedingungen: Eine passende Reaktion an C=C kann die Bromfarbe vermindern. Das bekannte Alken A dient als Positivkontrolle, das bekannte Alkan B im Dunkeln als Negativkontrolle, der Ansatz ohne organische Probe als Blindkontrolle. Der Vergleich darf weder Licht-induzierte Substitution noch bloße unterschiedliche Verteilung der Bromfarbe als C=C-Nachweis behandeln. Auch andere bromverbrauchende Stoffe können ein positives Ergebnis verursachen; der Befund allein identifiziert C nicht eindeutig.",
                "expectedPerformanceEn": "A fits addition to C=C, B light-induced radical substitution. The blank controls nonspecific colour loss. Decolorization alone is not unique; the known alkane B is already a counterexample. A bounded initial choice is a bromine-consumption test in the dark under comparable solvent and mixing conditions: a suitable C=C reaction can diminish bromine colour. Known alkene A is the positive control, known alkane B in the dark the negative control, and the sample-free preparation the blank. Light-induced substitution and merely different partitioning of bromine colour must not be treated as proof of C=C. Other bromine-consuming compounds can also give a positive result; this observation alone does not uniquely identify C.",
                "understandingFocusDe": "Fiktive Beobachtungen sind Material eines Lernfalls, keine tatsächlich ausgeführten Versuche oder empirische Lernendenevidenz.",
                "understandingFocusEn": "Fictional observations are learning-case material, not actual experiments or empirical learner evidence."
              }
            ]
          }
        }
      ],

        "stockGoalReviewContextFingerprint": "sha256:7eff772eaddb6e6b1f9014a6e3aec95f7339b87fcfa6dd7ba4c92690017833cc",
        "oldPageStockFingerprint": "sha256:0ad0342dbbe9b3552b0a1f3af05e2e6998d606266b4a9dd403f9d46dca657063",
        "profileFingerprint": null,

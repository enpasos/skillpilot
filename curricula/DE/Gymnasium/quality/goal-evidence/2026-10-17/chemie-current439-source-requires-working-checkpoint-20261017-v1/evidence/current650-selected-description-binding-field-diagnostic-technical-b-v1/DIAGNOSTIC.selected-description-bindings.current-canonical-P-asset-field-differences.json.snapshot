        "oldPageStockFingerprint": "sha256:0f21db9de9b7f41bae50581ab57622a2e603bb581e2f3763a5f103cd2891e96c",
        "profileFingerprint": null,
        "reviewInputFingerprint": null,
        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Ionen nachweisen und Salzzusammensetzung bestimmen",
          "url": "/assets/goal-visualizations/chemie/a44af1fa-5988-5b7d-b206-691c6bbf7dd4/a44af1fa-5988-5b7d-b206-691c6bbf7dd4.png",
          "altText": "Ausgewählte Ionennachweise: Flammenproben zeigen Na+ gelb, K+ violett und Cu2+ blaugrün. Ein Chlorid-Beispiel zeigt nach HNO3 und AgNO3 weißen AgCl-Niederschlag. Für das gezeigte Reinsalz führen Na+ und Cl− im Verhältnis1:1 zu NaCl; bei einem Gemisch folgt aus nachgewiesenen Ionen keine eindeutige Zuordnung von Salzpaaren.",
          "originalDigest": "sha256:f9d8e3cbf1401f05fa587d1c9adab2c010034ab1d27832464fbb5392f31101ad",
          "qaStatus": "review_candidate",

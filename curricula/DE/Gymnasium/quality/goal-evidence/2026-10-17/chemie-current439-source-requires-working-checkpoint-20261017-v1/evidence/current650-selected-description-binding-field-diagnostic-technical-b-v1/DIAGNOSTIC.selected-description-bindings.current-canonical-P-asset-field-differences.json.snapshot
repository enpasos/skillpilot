            "archetype": "representation",
            "expectations": [
              {
                "id": "content-specific-understanding",
                "essentialUnderstandingDe": "Orbital-Kästchen und Lewis-Valenznotation beschreiben dieselben Valenzelektronen mit unterschiedlichen Abstraktionen; Elektronenbilanz und Ionenladung müssen in beiden Darstellungen stimmen.",
                "essentialUnderstandingEn": "Orbital boxes and Lewis valence notation describe the same valence electrons at different abstraction levels; electron accounting and ion charge must agree in both.",
                "observablePerformanceDe": "F:2s↑↓,2p↑↓/↑↓/↑, sieben Valenzelektronen bzw.drei Paare+ein Einzelpunkt. F−:2s↑↓,2p↑↓/↑↓/↑↓, achtValenzelektronen; Klammer/−-Ladung. Gesamtzahlen9 bzw.10;1s² wird in derValenznotation nicht zusätzlich gezeichnet.",
                "observablePerformanceEn": "F:2s↑↓,2p↑↓/↑↓/↑, seven valence electrons, three pairs plus one single dot. F−:2s↑↓,2p↑↓/↑↓/↑↓, eight valence electrons; bracket/negative charge. Totals9 versus10;1s² is not additionally drawn in valence notation."
              },
              {
                "id": "fresh-transfer-and-model-boundary",
                "essentialUnderstandingDe": "Die einfacheValenznotation ist keine maßstabsgetreue räumliche Elektronenposition; unterschiedliche Anordnung äquivalenter Punkte ist nicht automatisch ein anderes Atom.",
                "essentialUnderstandingEn": "Simple valence notation is no scaled spatial electron position; rearranging equivalent dots does not automatically make a different atom.",
                "observablePerformanceDe": "O:2s-Paar und2p einPaar+zwei Einzelbesetzungen; einfachesLewis-Symbol zweiPaare+zwei Einzelpunkte. O2−:2s²2p⁶,vierValenzpaare mit Klammer2−, insgesamt10Elektronen. Die Ladungsangabe allein ersetzt fehlendeElektronen nicht.",
                "observablePerformanceEn": "O:a2s pair and2p one pair plus two single occupancies; simple Lewis symbol two pairs plus two single dots. O2−:2s²2p⁶, four valence pairs in brackets with2−, ten electrons total. A charge label does not replace missing electrons."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "content-specific-understanding",
                "fresh-transfer-and-model-boundary"
              ],
              "alternativeExpectationGroups": [],

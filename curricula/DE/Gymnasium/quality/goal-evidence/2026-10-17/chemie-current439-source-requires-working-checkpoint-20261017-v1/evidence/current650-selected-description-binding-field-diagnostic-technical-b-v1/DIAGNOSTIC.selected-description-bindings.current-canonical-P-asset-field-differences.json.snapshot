            "archetype": "representation",
            "expectations": [
              {
                "id": "b004-988888bb-core",
                "essentialUnderstandingDe": "Beim Phasenwechsel bleiben die Stoffteilchen dieselben. In festen, flüssigen und gasförmigen Zuständen ändern sich vor allem Anordnung, Abstand und Bewegungsmöglichkeiten; Energieübertragung ändert das Verhalten, nicht die Größe oder Identität der Teilchen.",
                "essentialUnderstandingEn": "In a phase change, the substance particles remain the same. Solids, liquids and gases differ mainly in arrangement, spacing and mobility; energy transfer changes behavior, not particle size or identity.",
                "observablePerformanceDe": "Die lernende Person zeichnet und erläutert Teilchenbilder für einen Übergang und prüft, ob Zahl, Art, Abstand und Bewegung zu Beobachtung und Energiefluss passen.",
                "observablePerformanceEn": "The learner draws and explains particle diagrams for a transition and checks whether number, kind, spacing and motion agree with observation and energy flow."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b004-988888bb-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "transition",
                "textDe": "Schmelzen/Verdampfen und Sublimieren/Kondensieren variieren den Übergang.",
                "textEn": "Melting/evaporation and sublimation/condensation vary the transition."
              },
              {
                "id": "representation",
                "textDe": "Teilchenzeichnung und Fehlerdiagnose werden kombiniert.",
                "textEn": "Particle drawing and error diagnosis are combined."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "water-particle-sequence",
                "taskDemandDe": "Zeichne für dieselbe Wassermenge Eis, flüssiges Wasser und Wasserdampf in getrennten Kästen. Erkläre beim Verdampfen Teilchenart, Abstände und Energiezufuhr; die Skizze ist ein Modell, kein Foto.",
                "taskDemandEn": "Draw separate particle boxes for the same amount of ice, liquid water and water vapor. Explain particle type, spacing and energy uptake during evaporation; the sketch is a model, not a photo.",
                "expectedPerformanceDe": "Die lernende Person zeichnet gleichartige H2O-Teilchen mit erhaltener Anzahl, im Gas weiter auseinander und beweglicher; sie vergrößert nicht die Moleküle und erfindet keine H- und O-Atome als neue Stoffe.",
                "expectedPerformanceEn": "The learner draws the same number and kind of H2O particles, farther apart and more mobile in gas; they do not enlarge molecules or invent new H and O substances.",
                "understandingFocusDe": "Erhaltung und Bewegung tragen den Phasenwechsel.",
                "understandingFocusEn": "Conservation and movement explain the phase change."
              },
              {
                "id": "fresh-iodine-sublimation-error",
                "taskDemandDe": "Ein neues Papierbild zu festem Iod und Ioddampf behauptet, beim Sublimieren zerfielen I2-Moleküle zu einzelnen I-Atomen und würden größer. Korrigiere die Teilchenskizze und nenne die Energie-Richtung.",
                "taskDemandEn": "A fresh paper diagram for solid iodine and iodine vapor claims sublimation splits I2 molecules into individual I atoms and enlarges them. Correct the particle diagram and state the energy direction.",
                "expectedPerformanceDe": "Die lernende Person lässt I2-Moleküle erhalten, zeigt größeren Abstand und freie Bewegung im Gas und nennt Energieaufnahme beim Sublimieren; sie trennt Phasenwechsel von chemischer Zerlegung.",
                "expectedPerformanceEn": "The learner preserves I2 molecules, shows greater spacing and freer gas motion, and states that sublimation takes in energy; they distinguish phase change from chemical decomposition.",
                "understandingFocusDe": "Neuer Stoff prüft Modelltransfer und Fehlervorstellung.",
                "understandingFocusEn": "A new substance tests model transfer and misconception."
              }
            ]
          }
        }
      ],

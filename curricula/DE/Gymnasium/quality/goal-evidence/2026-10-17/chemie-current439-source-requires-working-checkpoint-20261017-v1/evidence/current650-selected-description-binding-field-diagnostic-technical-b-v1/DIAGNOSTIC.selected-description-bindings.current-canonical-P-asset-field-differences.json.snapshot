      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "surfactant-structure-classes",
                "essentialUnderstandingDe": "Seifen sind Fettsäuresalze mit Carboxylatkopf. Andere Tenside können etwa Sulfonatköpfe oder ungeladene hydrophile Gruppen besitzen; alle besitzen einen passenden hydrophoben Anteil.",
                "essentialUnderstandingEn": "Soaps are fatty-acid salts with carboxylate heads. Other surfactants may have sulfonate heads or uncharged hydrophilic groups; all have a suitable hydrophobic part.",
                "observablePerformanceDe": "Vorgegebene Strukturen als Seife oder anderes anionisches/nichtionisches Tensid einordnen und die Zuordnung an funktionellen Gruppen begründen.",
                "observablePerformanceEn": "Classify supplied structures as soap or another anionic/nonionic surfactant and justify with functional groups."
              },
              {
                "id": "conditional-benefits-limits",
                "essentialUnderstandingDe": "Eignung hängt von Struktur, Wasserhärte, pH, Temperatur, Dosierung und weiteren bereitgestellten Stoffdaten ab. Modern oder natürlich allein beweist weder gute Waschwirkung noch Umweltverträglichkeit.",
                "essentialUnderstandingEn": "Suitability depends on structure, hardness, pH, temperature, dose and other supplied substance data. Modern or natural alone proves neither good cleaning nor environmental compatibility.",
                "observablePerformanceDe": "Für konkrete vorgegebene Bedingungen Vor-/Nachteile fachlich abwägen und unbelegte Verallgemeinerungen über Sicherheit oder Abbaubarkeit vermeiden.",
                "observablePerformanceEn": "Weigh advantages/disadvantages under specific supplied conditions and avoid unsupported generalizations about safety or biodegradability."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "surfactant-structure-classes",
                "conditional-benefits-limits"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "changed-chemical-case",
                "textDe": "Anderer Tensidkopf, Wasserhärte und temperaturabhängige Stoffdaten; Entscheidungskriterien statt pauschale Rangfolge.",
                "textEn": "Change surfactant heads, water hardness and temperature-dependent data; use decision criteria rather than a blanket ranking."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "soap-and-sulfonate-hard-water",
                "taskDemandDe": "Vergleiche Natriumstearat CH₃(CH₂)₁₆COO⁻Na⁺ mit einem vorgegebenen Alkylsulfonat RSO₃⁻Na⁺. Daten zeigen im jeweiligen Modell schwer lösliche Calciumseife, aber kein entsprechendes Sulfonatpräzipitat. Begründe die Stoffklassen und eine begrenzte Empfehlung für hartes Wasser.",
                "taskDemandEn": "Compare sodium stearate CH₃(CH₂)₁₆COO⁻Na⁺ with supplied alkyl sulfonate RSO₃⁻Na⁺. Model data show poorly soluble calcium soap but no corresponding sulfonate precipitate. Explain classes and a bounded recommendation for hard water.",
                "expectedPerformanceDe": "Carboxylat versus Sulfonat identifiziert Seife versus anderes anionisches Tensid. Calcium entfernt Seifenanionen als schwer lösliches Salz; das gegebene Sulfonat hat hier einen Vorteil. Daraus folgen keine allgemeine Ungiftigkeit, gesetzliche Zulassung oder Abbaubarkeit aller Sulfonate.",
                "expectedPerformanceEn": "Carboxylate versus sulfonate identifies soap versus another anionic surfactant. Calcium removes soap anions as an insoluble salt; the supplied sulfonate has an advantage here. This does not imply universal harmlessness, legal approval or biodegradability of all sulfonates.",
                "understandingFocusDe": "Struktur und bedingter Stoffvergleich.",
                "understandingFocusEn": "Structure and conditional comparison."
              },
              {
                "id": "nonionic-temperature-selection",
                "taskDemandDe": "Eine frische Tabelle vergleicht Seife, Alkylsulfonat und ein nichtionisches Tensid mit vorgegebener Polyetherkopfgruppe bei 20 und 60 °C. Das nichtionische Tensid trübt oberhalb einer angegebenen Temperatur; Wasch-, Härte- und Abbaudaten sind getrennt. Wähle für das vorgegebene Waschziel und benenne einen Nachteil deiner Wahl.",
                "taskDemandEn": "A fresh table compares soap, alkyl sulfonate and a nonionic surfactant with a supplied polyether head at20 and60 °C. The nonionic surfactant clouds above a stated temperature; cleaning, hardness and degradation data are separate. Choose for the specified cleaning goal and identify a disadvantage.",
                "expectedPerformanceDe": "Der nichtionische Kopf ist hydrophil ohne Ionenladung; Trübung kann die temperaturabhängige Anwendung begrenzen. Auswahl und Nachteil folgen aus den konkreten Tabellendaten, nicht aus modern/natürlich oder allein der Ladung. Fehlende Daten werden als fehlend benannt.",
                "expectedPerformanceEn": "The nonionic head is hydrophilic without ionic charge; clouding can constrain temperature-dependent use. Choice and disadvantage follow the table rather than modern/natural labels or charge alone. Missing data remain missing.",
                "understandingFocusDe": "Frischer Kriterien-/Temperaturtransfer.",
                "understandingFocusEn": "Fresh criterion and temperature transfer."
              }
            ]
          }
        }
      ],

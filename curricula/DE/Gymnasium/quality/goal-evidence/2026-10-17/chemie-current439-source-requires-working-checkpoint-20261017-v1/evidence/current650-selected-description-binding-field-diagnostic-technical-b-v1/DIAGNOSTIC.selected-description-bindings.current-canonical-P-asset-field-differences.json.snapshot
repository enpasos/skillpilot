      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "fuel-cell-electrodes-and-storage-role",
                "essentialUnderstandingDe": "In einer Wasserstoff-Sauerstoff-Brennstoffzelle wird Wasserstoff oxidiert und Sauerstoff reduziert; die Gesamtreaktion 2 H2 + O2 → 2 H2O setzt chemische Energie als elektrische Energie und Wärme frei. Im PEM-Modell gelangen Elektronen über den Außenkreis und Protonen durch die Membran. Die Zelle ist ein Energiewandler; der zugeführte gespeicherte Wasserstoff trägt die chemische Energie und wird mit Sauerstoff umgesetzt.",
                "essentialUnderstandingEn": "In a hydrogen–oxygen fuel cell hydrogen is oxidized and oxygen reduced; the overall reaction 2 H2 + O2 → 2 H2O releases chemical energy as electrical energy and heat. In the PEM model electrons travel through the external circuit and protons through the membrane. The cell is an energy converter; supplied stored hydrogen carries chemical energy and reacts with oxygen.",
                "observablePerformanceDe": "Die lernende Person stellt die Elektroden- und Gesamtreaktion für eine benannte Wasserstoff-Sauerstoff-Zelle geeignet dar, erklärt getrennte Ladungswege und unterscheidet in einem neuen Anwendungssystem zugeführten Wasserstoffspeicher und Energiewandler. Die Hilfegrenze des ersten Falls bleibt ausdrücklich sichtbar: vorgegebene Halbgleichungen allein belegen keine ungelenkte Formulierung.",
                "observablePerformanceEn": "The learner suitably represents electrode and overall reactions for an identified hydrogen–oxygen cell, explains separate charge pathways and distinguishes supplied hydrogen storage from the energy converter in a fresh application system. The assistance boundary in the first case is explicit: supplied half-equations alone do not prove uncued formulation."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "fuel-cell-electrodes-and-storage-role"
              ],
              "alternativeExpectationGroups": [],

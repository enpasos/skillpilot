      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "experiment",
            "expectations": [
              {
                "id": "perform-qualitative-controlled-test",
                "essentialUnderstandingDe": "Ein qualitativer Nachweis verlangt geeignete Durchführung, Blind-/Vergleichskontrollen und Beobachtung. Die Farbe des DCPIP-Reagenzes hängt auch vom pH ab; ein positiver Reduktionsbefund ist nicht automatisch substanzspezifisch.",
                "essentialUnderstandingEn": "A qualitative test requires appropriate execution, blanks/comparators and observation. DCPIP reagent color also depends on pH; a positive reduction finding is not automatically substance-specific.",
                "observablePerformanceDe": "Eine freigegebene betreute Nachweisvorschrift mit Kontrollen tatsächlich durchführen, eigene Beobachtungen dokumentieren und den erlaubten qualitativen Schluss ziehen.",
                "observablePerformanceEn": "Actually perform an approved supervised detection protocol with controls, document observations and draw the permitted qualitative conclusion."
              },
              {
                "id": "redox-antioxidant-model",
                "essentialUnderstandingDe": "Ascorbinsäure kann Elektronen abgeben, wird dabei oxidiert und reduziert das Nachweisreagenz. Das erklärt eine antioxidative Wirkung in diesem chemischen Modell, nicht jeden biologischen oder gesundheitlichen Effekt.",
                "essentialUnderstandingEn": "Ascorbic acid can donate electrons, becoming oxidized while reducing the detection reagent. This explains antioxidant action in this chemical model rather than every biological or health effect.",
                "observablePerformanceDe": "Elektronendonator/-akzeptor im konkreten Versuch bestimmen, Reduktion des Reagenzes mit Oxidation der Ascorbinsäure verbinden und Störungen bzw. Nachweisgrenzen erklären.",
                "observablePerformanceEn": "Identify electron donor/acceptor in the experiment, connect reagent reduction to ascorbic-acid oxidation and explain interference or detection limits."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "perform-qualitative-controlled-test",
                "redox-antioxidant-model"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "changed-chemical-case",
                "textDe": "Frisches freigegebenes Reagenz-/Probenmodell mit eigenen betreuten Handgriffen, pH-kontrollierten Vergleichen und möglichen anderen Reduktionsmitteln.",
                "textEn": "Use a fresh approved reagent/sample model with actual supervised actions, pH-controlled comparisons and possible other reducing agents."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "controlled-dcpip-detection",
                "taskDemandDe": "Führe unter Aufsicht die freigegebene qualitative DCPIP-Vorschrift mit Reagenzblindprobe, bekannter Ascorbinsäure und vorgegebener unbekannter Probe durch. Alle Vergleiche sind pH-kontrolliert; das oxidierte Reagenz ist im vorgegebenen neutralen Modell blau. Dokumentiere Durchführung und Farbverlauf und erkläre den chemischen Schluss.",
                "taskDemandEn": "Under supervision carry out the approved qualitative DCPIP protocol with a reagent blank, known ascorbic acid and supplied unknown. Comparisons control pH; oxidized reagent is blue in the given neutral model. Record actions and color changes and explain the chemical inference.",
                "expectedPerformanceDe": "Zukünftiger Leistungsbeleg enthält eigene sachgerechte Durchführung/Beobachtung. Entfärbung gegenüber Kontrollen zeigt Reduktion; Ascorbinsäure gibt Elektronen ab und wird oxidiert. Andere Reduktionsmittel oder ungleicher pH können die Zuordnung stören; ohne zusätzliche Selektivitätsdaten ist die unbekannte Probe nicht eindeutig identifiziert, und ohne Kalibrierung ist keine Konzentration bestimmt.",
                "expectedPerformanceEn": "Future evidence includes actual appropriate execution/observation. Decolorization against controls shows reduction; ascorbic acid donates electrons and is oxidized. Other reducers or unequal pH can interfere; absent selectivity data the unknown is not uniquely identified, and without calibration no concentration is established.",
                "understandingFocusDe": "Praktischer qualitativer Nachweis mit Redoxdeutung.",
                "understandingFocusEn": "Practical qualitative detection with redox interpretation."
              },
              {
                "id": "fresh-iodine-comparison",
                "taskDemandDe": "Eine frische freigegebene betreute Aufgabe verwendet ein vorgegebenes Iod/Stärke-Reagenzmodell mit passenden Blind-/Ascorbinsäurekontrollen und einer möglichen anderen reduzierenden Substanz. Führe die zulässigen Prüfschritte aus, dokumentiere den Farbverlauf und verbinde I₂/2I⁻ mit C₆H₈O₆/C₆H₆O₆ in einer ladungsrichtigen Redoxbilanz.",
                "taskDemandEn": "A fresh approved supervised task uses a supplied iodine/starch model with blanks/ascorbic-acid controls and a possible other reducing substance. Perform permitted steps, record color changes and connect I₂/2I⁻ with C₆H₈O₆/C₆H₆O₆ in a charge-balanced redox equation.",
                "expectedPerformanceDe": "I₂ +2e⁻ →2I⁻ und C₆H₈O₆ →C₆H₆O₆ +2H⁺ +2e⁻ ergeben C₆H₈O₆ +I₂ →C₆H₆O₆ +2H⁺ +2I⁻. Verlust der Iod/Stärke-Färbung passt zur Reagenzreduktion; die andere reduzierende Substanz begrenzt Selektivität. Eigene Durchführung bleibt erforderlich, die Daten ersetzen sie nicht; keine allgemeine Gesundheits- oder Unbedenklichkeitsbehauptung.",
                "expectedPerformanceEn": "I₂ +2e⁻ →2I⁻ and C₆H₈O₆ →C₆H₆O₆ +2H⁺ +2e⁻ yield C₆H₈O₆ +I₂ →C₆H₆O₆ +2H⁺ +2I⁻. Loss of iodine/starch color fits reagent reduction; another reducing substance limits selectivity. Actual execution remains necessary and is not replaced by data; no general health or harmlessness claim.",
                "understandingFocusDe": "Frischer Reagenz-/Interferenztransfer.",
                "understandingFocusEn": "Fresh reagent and interference transfer."
              }
            ]
          }
        }
      ],

          "field": "",
          "before": null,
          "current": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "b004-5338b54c-core",
                "essentialUnderstandingDe": "Beim Lösen verteilen sich gelöste Teilchen im Lösungsmittel, statt zu verschwinden. Molekulare Stoffe können als Moleküle bleiben; geeignete Ionenkristalle liefern beim Lösen Ionen. Eine klare Lösung kann weiterhin gelösten Stoff enthalten.",
                "essentialUnderstandingEn": "During dissolution, solute particles disperse in the solvent rather than vanish. Molecular solutes can remain molecules; suitable ionic crystals yield ions when dissolved. A clear solution can still contain solute.",
                "observablePerformanceDe": "Die lernende Person zeichnet vor und nach dem Lösen eine passende Teilchenverteilung, bewahrt die Stoffmenge und unterscheidet gelöste Moleküle von Ionen.",
                "observablePerformanceEn": "The learner draws an appropriate before-and-after particle distribution, conserves the solute amount and distinguishes dissolved molecules from ions."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b004-5338b54c-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "solute",
                "textDe": "Molekularer Zucker und ionisches Salz werden unterschieden.",
                "textEn": "Molecular sugar and ionic salt are distinguished."
              },
              {
                "id": "observation",
                "textDe": "Unsichtbarkeit und Trennung durch Filtern werden fachlich gedeutet.",
                "textEn": "Invisibility and filtration are interpreted scientifically."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "sugar-water-particles",
                "taskDemandDe": "Ein neues Teilchenbild zeigt Zuckerkristalle vor dem Mischen mit Wasser. Zeichne eine klare Zuckerlösung: Wo sind die Zuckermoleküle, und was geschieht mit ihrer Anzahl?",
                "taskDemandEn": "A fresh particle diagram shows sugar crystals before mixing with water. Draw a clear sugar solution: where are the sugar molecules and what happens to their number?",
                "expectedPerformanceDe": "Die lernende Person verteilt unveränderte Zuckermoleküle zwischen Wassermolekülen und erhält ihre Anzahl; sie erklärt Klarheit ohne chemisches Verschwinden.",
                "expectedPerformanceEn": "The learner distributes unchanged sugar molecules among water molecules and conserves their number; clarity does not mean chemical disappearance.",
                "understandingFocusDe": "Molekulares Lösen als Teilchenverteilung.",
                "understandingFocusEn": "Molecular dissolution as particle distribution."
              },
              {
                "id": "fresh-salt-filter-model",
                "taskDemandDe": "Ein neuer Papierfall zeigt NaCl-Kristalle, Wasser und danach eine klare Lösung, die durch Papierfilter läuft. Skizziere passende gelöste Teilchen und sage voraus, warum der Filter das Salz nicht wie Sand zurückhält. Keine Durchführung.",
                "taskDemandEn": "A fresh paper case shows NaCl crystals, water and then a clear solution passing through paper filter. Sketch suitable dissolved particles and predict why the filter does not retain the salt like sand. No experiment is requested.",
                "expectedPerformanceDe": "Die lernende Person zeigt getrennte Na+ und Cl−-Ionen im Wasser im richtigen Verhältnis, keine verschwundenen Atome und kein Herausfiltern wie grobe unlösliche Sandkörner; sie behauptet nicht, die Ionen seien zu H2O geworden.",
                "expectedPerformanceEn": "The learner shows separate Na+ and Cl− ions in water in the correct ratio, no vanished atoms and no retention like coarse insoluble sand; they do not claim the ions became H2O.",
                "understandingFocusDe": "Ionisches Lösen und Filtergrenze als Transfer.",
                "understandingFocusEn": "Ionic dissolution and filter limit as transfer."
              }
            ]
          }
        }
      ],

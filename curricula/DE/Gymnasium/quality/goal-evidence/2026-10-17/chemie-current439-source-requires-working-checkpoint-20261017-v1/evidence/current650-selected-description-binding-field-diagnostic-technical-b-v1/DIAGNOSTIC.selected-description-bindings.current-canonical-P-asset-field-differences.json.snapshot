      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "b004-5dd180f1-core",
                "essentialUnderstandingDe": "Brownsche Bewegung ist unregelmäßige Bewegung suspendierter sichtbarer Teilchen durch Stöße kleinerer Flüssigkeits- oder Gasteilchen. Diffusion ist die Durchmischung durch zufällige Teilchenbewegung und zeigt im Mittel einen Konzentrationsausgleich; makroskopische Strömung ist davon zu unterscheiden.",
                "essentialUnderstandingEn": "Brownian motion is irregular movement of visible suspended particles caused by collisions with smaller liquid or gas particles. Diffusion is mixing by random particle motion, producing net concentration equalization; bulk flow must be distinguished.",
                "observablePerformanceDe": "Die lernende Person deutet eine mikroskopische Zickzackbahn und eine sich verteilende Farb- oder Duftstoffkonzentration mit dem Modell und benennt den Unterschied.",
                "observablePerformanceEn": "The learner interprets a microscopic zigzag track and a spreading dye or scent concentration with the model and states the difference."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b004-5dd180f1-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "phenomenon",
                "textDe": "Einzelteilchenbahn und Konzentrationsverteilung werden verglichen.",
                "textEn": "A single-particle track and a concentration distribution are compared."
              },
              {
                "id": "flow-control",
                "textDe": "Ruhige Probe und gerichtete Strömung werden unterschieden.",
                "textEn": "A still sample and directed flow are distinguished."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "bead-track-and-dye-data",
                "taskDemandDe": "Zwei vorgegebene Beobachtungsreihen stammen aus ruhigem Wasser: Ein feines suspendiertes Kügelchen zittert unregelmäßig; ein Farbstofffleck wird ohne Rühren breiter. Erkläre beide Befunde und ihren Unterschied.",
                "taskDemandEn": "Two supplied observations come from still water: a fine suspended bead jitters irregularly; a dye patch broadens without stirring. Explain both and their difference.",
                "expectedPerformanceDe": "Die lernende Person deutet die Kügelchenbahn durch ungleichmäßige Stöße kleinerer Wasserteilchen und den Farbstofftransport als allmähliche Durchmischung vieler Farbstoffteilchen; sie setzt beide Bilder nicht gleich.",
                "expectedPerformanceEn": "The learner explains the bead track by uneven impacts from smaller water particles and dye spreading as mixing of many dye particles over time; they do not equate the observations.",
                "understandingFocusDe": "Gemeinsamer Bewegungsgrund, verschiedene beobachtete Größen.",
                "understandingFocusEn": "Common motion basis, different observables."
              },
              {
                "id": "fresh-scent-and-airflow",
                "taskDemandDe": "Ein frischer Klassenraum-Datensatz zeigt einen Duftstoff, der sich bei ausgeschaltetem Ventilator langsam ausbreitet, aber bei eingeschaltetem Ventilator bevorzugt in eine Richtung gelangt. Welche Beobachtung stützt Diffusion, welche zeigt zusätzlich Strömung? Wie unterscheidet sich das von Brownscher Bewegung eines sichtbaren Rauchteilchens? Nur Datenauswertung.",
                "taskDemandEn": "A fresh classroom data set shows a scent spreading slowly with a fan off but traveling preferentially one way with a fan on. Which observation supports diffusion, which also shows flow? How does this differ from Brownian motion of a visible smoke particle? Data interpretation only.",
                "expectedPerformanceDe": "Die lernende Person erklärt langsame Durchmischung als Diffusion, die gerichtete Ausbreitung als Strömung plus mögliche Diffusion und die unregelmäßige Einzelteilchenbahn als Brownsche Bewegung; sie folgert nicht, dass jedes Lüftermuster reine Diffusion sei.",
                "expectedPerformanceEn": "The learner explains slow mixing as diffusion, directional transport as airflow with possible diffusion, and an irregular single-particle track as Brownian motion; not every fan pattern is pure diffusion.",
                "understandingFocusDe": "Neue Strömungsbedingung prüft Modellgrenze.",
                "understandingFocusEn": "A fresh flow condition tests the model boundary."
              }
            ]
          }
        }
      ],

        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Chemische Fach- und Symbolsprache ebenengerecht verwenden",
          "url": "/assets/goal-visualizations/chemie/95dc0ee5-a0af-5682-af32-d66e36fbeb50/95dc0ee5-a0af-5682-af32-d66e36fbeb50.jpg",
          "altText": "Didaktische Visualisierung zum Lernziel \"Chemische Fach- und Symbolsprache ebenengerecht verwenden\". Die lernende Person kann zwischen Alltags- und Fachsprache übersetzen, Stoff- und Teilchenebene unterscheiden sowie Nomenklatur, Symbole und Formelsprache zur Beschreibung von Atomen, Molekülen, Ionen, Teilchenänderungen und Wechselwirkungen sachgerecht nutzen.",
          "originalDigest": "sha256:19166552970936ec4c589a2ae217fb401a21fb45fa5556ac5b632c33d77dc043",
          "qaStatus": "review_candidate",
          "approvedForPublication": false
        }

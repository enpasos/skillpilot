        "oldPageStockFingerprint": "sha256:83f01383f68612c5a9d83b6158f045cd1dbe9ffe367f92a437c4b20a36af43a4",
        "profileFingerprint": "sha256:75fdf5d6e8872d98568994d11014df356de84267d57f88d5755401d69ebf689e",

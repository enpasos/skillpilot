          "field": "",
          "before": null,
          "current": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "b004-78109f6d-core",
                "essentialUnderstandingDe": "Die Stoffebene beschreibt beobachtbare Eigenschaften und Vorgänge, die Teilchenebene ein Modell unsichtbarer Teilchen und ihrer Erhaltung. Ein passendes Teilchenbild muss den Befund erklären, ohne Beobachtung und Modell zu verwechseln oder Atome verschwinden zu lassen.",
                "essentialUnderstandingEn": "The substance level reports observable properties and events; the particle level models unseen particles and their conservation. A valid particle representation must explain observations without confusing observation with model or losing atoms.",
                "observablePerformanceDe": "Die lernende Person formuliert erst einen Stoffbefund, dann eine passende Teilchenhypothese und prüft an einer neuen Skizze deren Erklärungskraft und Erhaltung.",
                "observablePerformanceEn": "The learner first states a substance-level observation, then a matching particle hypothesis, and checks a fresh diagram for explanatory fit and conservation."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b004-78109f6d-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "phenomenon",
                "textDe": "Lösen und Gasbildung variieren den chemischen Kontext.",
                "textEn": "Dissolving and gas formation vary the chemistry context."
              },
              {
                "id": "direction",
                "textDe": "Beobachtung→Modell und Modell→Prüfung am Befund wechseln.",
                "textEn": "Observation-to-model and model-to-observation checking alternate."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "clear-salt-solution-levels",
                "taskDemandDe": "Ein neues Protokoll meldet, dass Salzkristalle in Wasser nicht mehr sichtbar sind und die Flüssigkeit klar bleibt. Schreibe eine reine Stoffebenen-Aussage und ein Teilchenmodell, das den Befund erklärt; markiere, welche Aussage beobachtet und welche modelliert ist.",
                "taskDemandEn": "A fresh record says salt crystals are no longer visible in water and the liquid is clear. Write one substance-level statement and a particle model that explains it; identify observation versus model.",
                "expectedPerformanceDe": "Die lernende Person benennt die Klarheit als Beobachtung und verteilte gelöste Ionen als Modell, behauptet weder das direkte Sehen von Ionen noch das Verschwinden des Salzes.",
                "expectedPerformanceEn": "The learner labels clarity as observation and dispersed dissolved ions as model, claiming neither direct sight of ions nor disappearance of salt.",
                "understandingFocusDe": "Ebenenwechsel und Erklärung derselben Beobachtung.",
                "understandingFocusEn": "Switching levels to explain the same observation."
              },
              {
                "id": "fresh-gas-in-closed-bag",
                "taskDemandDe": "Ein neuer vorgegebener Datensatz beschreibt Essig und Natron im verschlossenen Beutel: Blasen und aufgeblähter Beutel, gleiche Gesamtmasse vorher/nachher. Eine Teilchenskizze lässt einige C- und O-Atome verschwinden. Korrigiere die Skizze qualitativ und erkläre den Befund; keine Durchführung.",
                "taskDemandEn": "A new supplied data set describes vinegar and baking soda in a closed bag: bubbles and an inflated bag, same total mass before/after. A particle diagram makes some C and O atoms vanish. Correct it qualitatively and explain the observation; no experiment is requested.",
                "expectedPerformanceDe": "Die lernende Person ergänzt eine Gasphase mit den zuvor fehlenden Atomen, erhält jede Atomsorte qualitativ und trennt beobachtete Blasen/Masse vom modellhaften Teilchenumbau; keine vollständige Reaktionsformel ist gefordert.",
                "expectedPerformanceEn": "The learner adds a gas phase containing the missing atoms, conserves each atom type qualitatively and separates observed bubbles/mass from modeled particle rearrangement; no full reaction equation is required.",
                "understandingFocusDe": "Neuer Gasbefund prüft Modellkonsistenz und Erhaltung.",
                "understandingFocusEn": "A new gas observation tests model consistency and conservation."
              }
            ]
          }
        }
      ],

            "archetype": "concept",
            "expectations": [
              {
                "id": "b002-a4bac92b-core",
                "essentialUnderstandingDe": "Sterische Abschirmung erschwert den Rückseitenangriff bei SN2; Stabilisierung eines entstehenden Carbokations begünstigt SN1, wobei induktive Effekte nur zusammen mit weiteren Faktoren bewertet werden dürfen.",
                "essentialUnderstandingEn": "Steric shielding hinders backside attack in SN2; stabilization of a carbocation favors SN1, while inductive effects must be judged together with other factors.",
                "observablePerformanceDe": "Die lernende Person stellt zwei Mechanismenskizzen gegenüber und erläutert an vergleichbaren Substraten, wie Substitution und Elektroneneffekte den plausiblen Weg ändern.",
                "observablePerformanceEn": "The learner contrasts two mechanism sketches and explains with comparable substrates how substitution and electronic effects alter the plausible route."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b002-a4bac92b-core"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,

        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Kalkkreislauf chemisch beschreiben",
          "url": "/assets/goal-visualizations/chemie/d726e00e-1f87-5ba5-8c79-76ad4022365e/d726e00e-1f87-5ba5-8c79-76ad4022365e.png",
          "altText": "Didaktische Visualisierung zum Lernziel \"Kalkkreislauf chemisch beschreiben\". Die lernende Person kann die wesentlichen Stoffumwandlungen im Kalkkreislauf chemisch beschreiben und mit Carbonaten verknuepfen.",
          "originalDigest": "sha256:51341eaf35f02e3bf70b9a65d9187895189c9d98daba97413c97b9eed992f6eb",
          "qaStatus": "review_candidate",
          "approvedForPublication": false

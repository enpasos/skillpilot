        "bookDigest": "sha256:edfce21e8acc849c8a37d537b545c545bcdf0f709c11f115090e8d51287c88a3",
        "goalFingerprint": "sha256:7b4373dc5dbaa2e1cd9d76ad97132d9480e5840380787c6eacee50a6455ef07f",

        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Enthalpien berechnen",
          "url": "/assets/goal-visualizations/chemie/4a08f31f-204c-5339-9d9f-5d2af28d5d5c/4a08f31f-204c-5339-9d9f-5d2af28d5d5c.jpg",
          "altText": "Didaktische Visualisierung zum Lernziel \"Enthalpien berechnen\". Die lernende Person kann Reaktionsenthalpien mit dem Satz von Hess und einfachen Kalorimetrieansätzen bestimmen.",
          "originalDigest": "sha256:6672d2948084af389c4cf1cbe66e689d5597e07e73f51d90a0bf58d90c339c3b",

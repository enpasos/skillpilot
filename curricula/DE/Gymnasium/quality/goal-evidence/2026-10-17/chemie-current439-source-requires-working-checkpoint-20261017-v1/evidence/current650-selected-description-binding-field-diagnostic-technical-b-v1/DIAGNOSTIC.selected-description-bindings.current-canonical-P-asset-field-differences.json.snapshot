      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "structure-model-reasoning",
                "essentialUnderstandingDe": "Struktur-, Halbstruktur- und Skelettformeln eines Alkanols müssen dieselbe Verknüpfung einschließlich C-O-H und korrekter Valenzen erhalten.",
                "essentialUnderstandingEn": "Structural, condensed and skeletal formulas of an alkanol must retain the same connectivity including C-O-H and correct valences.",
                "observablePerformanceDe": "Die Person erzeugt eigene äquivalente Darstellungen und prüft Anzahl der C, Bindungen und ausdrücklich dargestellten Heteroatome.",
                "observablePerformanceEn": "The learner creates equivalent representations and checks C count, bonds and explicitly drawn heteroatoms."
              },
              {
                "id": "fresh-application-and-boundary",
                "essentialUnderstandingDe": "OH darf nicht an die falsche Position wandern; ein endständiges O ohne H steht nicht automatisch für dieselbe neutrale Hydroxygruppe.",
                "essentialUnderstandingEn": "OH must not shift position; terminal O without H does not automatically represent the same neutral hydroxyl group.",
                "observablePerformanceDe": "Ethan-1,2-diol besitzt zwei C und zwei OH; Propan-1,2,3-triol drei C und drei OH. Die Darstellungen erhalten jede C-O-Verknüpfung und jede OH-Gruppe; die Summenformeln ergeben C2H6O2 und C3H8O3. Die zusätzliche OH-Gruppe wird nicht nur als Dekoration ergänzt, sondern verändert die tatsächliche atomare Verknüpfung und H-Bilanz.",
                "observablePerformanceEn": "Ethane-1,2-diol has two C and two OH; propane-1,2,3-triol three C and three OH. Drawings retain each C-O connection and OH group; formulas are C2H6O2 and C3H8O3. An extra OH is not decorative: it changes actual atomic connectivity and H accounting."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "structure-model-reasoning",
                "fresh-application-and-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "material-variation",
                "textDe": "OH-Position, unverzweigte/verzweigte Kette und ein-/mehrwertiges Alkanol.",
                "textEn": "OH position, linear/branched chains and mono/polyhydric alkanols."
              },
              {
                "id": "counterexample",
                "textDe": "OH darf nicht an die falsche Position wandern; ein endständiges O ohne H steht nicht automatisch für dieselbe neutrale Hydroxygruppe.",
                "textEn": "OH must not shift position; terminal O without H does not automatically represent the same neutral hydroxyl group."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-current15-345fdca9-case-1",
                "taskDemandDe": "Vorgegebene Halbstrukturformeln: CH3-CH2-CH2-OH und CH3-CH(OH)-CH3. Zeichne beide als vollständige Struktur- und Skelettformeln und begründe, welche Position der OH-Gruppe erhalten bleibt.",
                "taskDemandEn": "Supplied condensed formulas: CH3-CH2-CH2-OH and CH3-CH(OH)-CH3. Draw both as full structural and skeletal formulas and explain how the OH position is retained.",
                "expectedPerformanceDe": "Propan-1-ol trägt OH an einem endständigen C, Propan-2-ol am mittleren C. Beide haben drei C und C3H8O, sind aber nicht identisch verknüpft. O und OH-H werden in Skelettdarstellungen ausdrücklich gezeigt; C-Valenz vier/O-Valenz zwei bleiben korrekt.",
                "expectedPerformanceEn": "Propan-1-ol bears OH at a terminal C, propan-2-ol at the middle C. Both have three C and C3H8O but differ in connectivity. Skeletal drawings show O and hydroxyl H explicitly; C valence four and O valence two remain correct.",
                "understandingFocusDe": "Gleiche Summenformel erlaubt keine Vertauschung der beiden Strukturen.",
                "understandingFocusEn": "The same molecular formula does not allow swapping the two structures."
              },
              {
                "id": "chem-current15-345fdca9-case-2",
                "taskDemandDe": "Frischer Fall: HO-CH2-CH2-OH und HO-CH2-CH(OH)-CH2-OH. Ein fehlerhafter Entwurf zeichnet nur eine OH-Gruppe pro Molekül. Erstelle äquivalente Skelettdarstellungen und korrigiere die fehlenden OH-Gruppen einschließlich der H-Zählung.",
                "taskDemandEn": "Fresh case: HO-CH2-CH2-OH and HO-CH2-CH(OH)-CH2-OH. A faulty draft draws only one OH per molecule. Create equivalent skeletal drawings and correct missing OH groups including H counting.",
                "expectedPerformanceDe": "Ethan-1,2-diol besitzt zwei C und zwei OH; Propan-1,2,3-triol drei C und drei OH. Die Darstellungen erhalten jede C-O-Verknüpfung und jede OH-Gruppe; die Summenformeln ergeben C2H6O2 und C3H8O3.",
                "expectedPerformanceEn": "Ethane-1,2-diol has two C and two OH; propane-1,2,3-triol three C and three OH. Drawings retain each C-O connection and OH group; formulas are C2H6O2 and C3H8O3.",
                "understandingFocusDe": "Die zusätzliche OH-Gruppe wird nicht nur als Dekoration ergänzt, sondern verändert die tatsächliche atomare Verknüpfung und H-Bilanz.",
                "understandingFocusEn": "An extra OH is not decorative: it changes actual atomic connectivity and H accounting."
              }
            ]
          }
        }
      ],

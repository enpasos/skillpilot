      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "b009-1286-net-energy-flow",
                "essentialUnderstandingDe": "Exotherm bedeutet netto Energieabgabe an die Umgebung, endotherm netto Energieaufnahme aus ihr. Eine nötige Startenergie und eine Temperaturänderung ohne geklärte Systemgrenze sind nicht mit der gesamten Reaktionsenergie gleichzusetzen.",
                "essentialUnderstandingEn": "Exothermic means net energy transfer to the surroundings, endothermic means net uptake from them. Initial activation energy and a temperature change without a clear system boundary are not the same as the overall reaction energy.",
                "observablePerformanceDe": "Die lernende Person ordnet vorgegebene chemische Reaktionen anhand von Energie- und Kontextdaten begründet zu, benennt die Richtung des Netto-Energieflusses und grenzt Startenergie oder einen Störeffekt ab.",
                "observablePerformanceEn": "The learner classifies supplied chemical reactions from energy and context data, explains the direction of net energy transfer and distinguishes activation or a confounding effect."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "b009-1286-net-energy-flow"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "reaction-and-representation",
                "textDe": "Verbrennungs-Energiedaten werden gegen eine thermische Zersetzung mit Energieniveaus getauscht; beides sind ausdrücklich chemische Reaktionen.",
                "textEn": "Combustion energy data change to energy levels for thermal decomposition; both are explicitly chemical reactions."
              },
              {
                "id": "initial-versus-net",
                "textDe": "Eine nötige Zündung oder fortgesetzte Energiezufuhr wird vom Netto-Energieumsatz getrennt.",
                "textEn": "Necessary ignition or continued energy input is distinguished from net energy transfer."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "methane-combustion-paper-data",
                "taskDemandDe": "Ein Arbeitsblatt zeigt die ausgeglichene Verbrennung CH₄ + 2 O₂ → CO₂ + 2 H₂O und Lehrkraftdaten: Nach kurzer Zündung gibt die Reaktion auf die angegebene Stoffmenge mehr Energie an die Umgebung ab, als zum Start eingebracht wurde. Ordne die Reaktion ein, zeichne die relative Lage von Edukten und Produkten und erkläre, warum die Zündung die Nettoeinordnung nicht umkehrt. Es wird kein Versuch durchgeführt.",
                "taskDemandEn": "A worksheet shows the balanced combustion CH₄ + 2 O₂ → CO₂ + 2 H₂O and teacher-provided data: after brief ignition, the reaction releases more energy to the surroundings for the stated amount than was supplied to start it. Classify the reaction, draw the relative reactant and product energy levels, and explain why ignition does not reverse the net classification. No experiment is carried out.",
                "expectedPerformanceDe": "Die Person ordnet exotherm zu, zeigt Produkte energetisch unter den Edukten und beschreibt netto Energie nach außen; Zündenergie wird als Anfangsbedarf, nicht als endotherme Gesamtbilanz gedeutet.",
                "expectedPerformanceEn": "The learner classifies the reaction as exothermic, places products below reactants and describes net energy transfer outward; ignition is an initial requirement, not an endothermic overall balance.",
                "understandingFocusDe": "Beobachtetes Brennen wird mit der Richtung der Netto-Energiebilanz verbunden, ohne Aktivierung zu verwechseln.",
                "understandingFocusEn": "Observed combustion is linked to net energy transfer without confusing it with activation."
              },
              {
                "id": "calcium-carbonate-decomposition-paper-data",
                "taskDemandDe": "Eine neue Karte beschreibt die chemische Zersetzung CaCO₃ → CaO + CO₂. Vorgegebene Energiedaten für dieselbe Stoffmenge zeigen Produkte auf höherem Energieniveau als Edukte und fortgesetzte Netto-Energiezufuhr. Ordne die Reaktion ein, gib die Richtung des Energieflusses an und erkläre, warum bloßes Abkühlen eines gemischten Brausetablettenansatzes dafür kein gleichwertiger Beleg wäre. Nur Dateninterpretation, keine Durchführung.",
                "taskDemandEn": "A fresh card describes the chemical decomposition CaCO₃ → CaO + CO₂. Supplied energy data for the same amount show products above reactants and continued net energy input. Classify the reaction, state the direction of energy transfer and explain why mere cooling of a mixed effervescent-tablet sample would not provide equivalent evidence. Data interpretation only, no experiment.",
                "expectedPerformanceDe": "Die Person ordnet endotherm zu und beschreibt netto Energie hinein; das höhere Produktniveau stützt die Zuordnung. Beim Brausetablettengemisch könnten Lösen und Mischen mitwirken, sodass Temperaturabfall allein die Energieart der chemischen Teilreaktion nicht beweist.",
                "expectedPerformanceEn": "The learner classifies the decomposition as endothermic and describes net energy input; the higher product level supports this. Dissolution and mixing may affect the effervescent sample, so cooling alone does not prove the chemical subreaction's energy class.",
                "understandingFocusDe": "Transfer auf eine echte chemische endotherme Reaktion mit geklärter Systemgrenze und Störfaktor.",
                "understandingFocusEn": "Transfer to a genuine endothermic chemical reaction with a clear system boundary and a confounder."
              }
            ]
          }
        }
      ],

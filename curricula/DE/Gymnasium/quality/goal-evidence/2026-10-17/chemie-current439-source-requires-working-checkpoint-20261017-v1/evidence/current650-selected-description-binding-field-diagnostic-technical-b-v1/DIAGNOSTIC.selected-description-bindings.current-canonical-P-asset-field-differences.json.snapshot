        "goalFingerprint": "sha256:62606b4f668b83197e091461fa682dbc05290d693f643dbd23868a23bf2850c7",
        "pageFingerprint": "sha256:303f71248830d89ab3540d0837eaedad3253160f4760f495c007c239c3250a8d",
        "stockGoalReviewContextFingerprint": "sha256:354b5045c60727428cae21a4d3ad4c293d9d8f06a236664bb1f91a6a04f0f73d",
        "oldPageStockFingerprint": "sha256:303f71248830d89ab3540d0837eaedad3253160f4760f495c007c239c3250a8d",
        "profileFingerprint": "sha256:7e1234f9aa5608b660280589ca809ad53ae92d8b65fc193072b6a448ccff91a6",
        "reviewInputFingerprint": "sha256:bed59c6a131773e97cb520023df433485eb0e3a6d9f294da233bc24f6601705c",
        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: pE/pH- und Pourbaix-Diagramme",
          "url": "/assets/goal-visualizations/chemie/f0f2c5f8-06f1-5774-a176-d96505727acf/f0f2c5f8-06f1-5774-a176-d96505727acf.png",
          "altText": "Ein ausdrücklich schematisches pE/pH-Diagramm zeigt das idealisierte Modellmetall M. Nach oben steigt pE, nach rechts pH. Oberhalb der horizontalen Grenze liegt links gelöstes M²⁺; rechts der vertikalen Grenze und über der nach rechts fallenden Grenze liegt festes M(OH)₂. Unterhalb der horizontalen und fallenden Grenze liegt Metall M. Die drei Grenzen treffen sich in einem Punkt. Ein Pfeil führt bei gleichem pE zu höherem pH vom Ionen- in den Feststoffbereich. „Stabilität ≠ Tempo“ trennt Stabilität und Reaktionsgeschwindigkeit. Ohne Zahlenskalen, Wasserstabilitätslinien und weitere Spezies; ein Feststofffeld beweist keine Schutzschicht.",
          "originalDigest": "sha256:6778295209ab596f763c1f71ee08d372743b656f6a851a2129f183830d5fd2ad",
          "qaStatus": "review_candidate",
          "approvedForPublication": false
        }
      },

        "profileFingerprint": null,
        "reviewInputFingerprint": null,
        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Wirkstoff-Isolierung als Stofftrennung erklären",
          "url": "/assets/goal-visualizations/chemie/40f2db27-0ebe-5f03-941d-708aebcc64b7/40f2db27-0ebe-5f03-941d-708aebcc64b7.png",
          "altText": "Ein Extrakt mit sechs grünen Wirkstoff-Symbolen und acht grauen Begleitstoff-Symbolen wird getrennt. Die angereicherte rechte Fraktion enthält fünf grüne und zwei graue Symbole, die andere ein grünes und sechs graue. Die Symbolarten bleiben unverändert; keine reine oder klinisch geprüfte Substanz ist behauptet.",
          "originalDigest": "sha256:502fc4e43c5939fe0be26c2e91923b007f65a2abdad938c9edf02fa34f7a6f2b",
          "qaStatus": "review_candidate",

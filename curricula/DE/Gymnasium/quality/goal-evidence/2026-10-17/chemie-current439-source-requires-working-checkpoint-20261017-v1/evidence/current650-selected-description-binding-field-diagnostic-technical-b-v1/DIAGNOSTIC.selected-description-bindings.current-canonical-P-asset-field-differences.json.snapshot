        "stockGoalReviewContextFingerprint": "sha256:712b09aaaa40279d98c28822f41d5f9dd46cca8cc2182ed3a874c5949954aa8d",
        "oldPageStockFingerprint": "sha256:c5ce08659919e687abd3492581b1aca73dce04a73868e7e48303dda822ba9aa9",

        "stockGoalReviewContextFingerprint": "sha256:133d7532992d09688cf8de8dde2e65cd44922c1a3df0a1cca5e712506492782e",
        "oldPageStockFingerprint": "sha256:af5633e66c52f825618fc2d774c4a42b8876581c932db3e08d05e7e5a9b6ebd3",

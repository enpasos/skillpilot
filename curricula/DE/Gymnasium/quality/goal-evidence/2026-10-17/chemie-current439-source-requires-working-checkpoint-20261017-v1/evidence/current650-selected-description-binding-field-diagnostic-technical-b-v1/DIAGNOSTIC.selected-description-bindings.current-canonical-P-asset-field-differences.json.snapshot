      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "modeling",
            "expectations": [
              {
                "id": "equal-gas-volume-fixed-temperature-pressure",
                "essentialUnderstandingDe": "Im idealen Gasmodell enthalten gleiche Gasvolumina bei gleicher Temperatur und gleichem Druck gleich viele Gasteilchen und damit gleiche Stoffmengen der Gasteilchen. Das gilt für Moleküle oder einatomige Gasteilchen und bedeutet weder gleiche Masse noch gleiche Zahl enthaltener Atome. Bei anderen Temperaturen oder Drücken darf die Gleichheit nicht allein aus gleichen Volumina gefolgert werden.",
                "essentialUnderstandingEn": "In the ideal-gas model, equal gas volumes at the same temperature and pressure contain equal numbers of gas particles and equal amounts of those particles. These may be molecules or monatomic particles; equal volume does not imply equal mass or equal constituent-atom count. With different temperatures or pressures, equal particle count cannot be inferred solely from equal volumes.",
                "observablePerformanceDe": "Die lernende Person benennt die Bedingungen, begründet den Volumen-Teilchenzahl-Zusammenhang und weist einen unzulässigen Gleichheits- oder Massenschluss in einer frischen Gasvergleichssituation zurück.",
                "observablePerformanceEn": "The learner states the conditions, explains the volume-to-count relationship and rejects an invalid count or mass inference in a fresh gas-comparison situation."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "equal-gas-volume-fixed-temperature-pressure"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "gas-identity",
                "textDe": "Gleiches Gasvolumen wird trotz stark verschiedener Teilchenmassen verglichen.",
                "textEn": "Equal gas volumes are compared despite very different particle masses."
              },
              {
                "id": "conditions",
                "textDe": "Gleiche Temperatur/Druck werden durch einen Vergleich mit abweichender Temperatur ersetzt.",
                "textEn": "Matched temperature and pressure are replaced by a comparison with a different temperature."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "hydrogen-oxygen-one-litre",
                "taskDemandDe": "Je1,00L ideales H2 und O2 liegen bei20°C und100kPa vor. Gegeben M(H2)=2,0g/mol und M(O2)=32,0g/mol. Ein Mitschüler behauptet, das schwerere O2 enthalte mehr Moleküle. Beurteile dies und vergleiche begründet Stoffmengen und Massen, ohne die absolute Stoffmenge ausrechnen zu müssen.",
                "taskDemandEn": "There is1.00L each of ideal H2 and O2 at20°C and100kPa. Given M(H2)=2.0g/mol and M(O2)=32.0g/mol, a classmate claims that heavier O2 contains more molecules. Evaluate the claim and compare amounts and masses with reasons, without calculating the absolute amount.",
                "expectedPerformanceDe": "Gleiche V,T,p bedeuten im idealen Gasmodell gleiche Zahl von H2-/O2-Molekülen und gleiche Stoffmenge. O2 ist je Molekül beziehungsweise je mol16-mal schwerer; seine Probenmasse ist16-mal so groß. Schwerere Teilchen ändern die Molekülzahl bei diesen festgelegten Bedingungen nicht.",
                "expectedPerformanceEn": "Equal V,T,p imply equal H2/O2 molecule counts and equal amounts in the ideal-gas model. O2 is16 times heavier per molecule or mol, so its sample mass is16 times larger. Greater particle mass does not change molecular count under the specified conditions.",
                "understandingFocusDe": "Gasteilchenzahl wird aus den Modellbedingungen, Masse separat aus M begründet.",
                "understandingFocusEn": "Gas-particle count is justified by the model conditions and mass separately by molar mass."
              },
              {
                "id": "mismatched-temperature-fresh",
                "taskDemandDe": "Frischer Fall: A enthält3,0L ideales CO2 bei20°C und100kPa; B enthält3,0L ideales He bei40°C und100kPa. Beurteile: „Gleiche Volumina bedeuten hier gleiche Teilchenzahlen und gleiche Atomzahlen.“ Welche Angaben müsste ein zulässiger Gleichheitsvergleich zusätzlich gemeinsam festlegen? Beantworte auch, ob bei gleichen T,p eine gleiche CO2-Molekülzahl und He-Atomzahl gleiche Gesamtatomzahlen bedeuten würde.",
                "taskDemandEn": "Fresh case: A contains3.0L ideal CO2 at20°C and100kPa and B3.0L ideal He at40°C and100kPa. Evaluate: “Equal volumes here imply equal particle and atom counts.” Which conditions must a valid equal-count comparison match? Also explain whether equal CO2 molecule and He atom counts at matched T,p would imply equal total atom counts.",
                "expectedPerformanceDe": "Die Teilchenzahlgleichheit folgt hier nicht aus Avogadro, da die Temperaturen abweichen. Ein gültiger Vergleich gleicher Volumina verlangt gleiche Temperatur und gleichen Druck im idealen Modell. Selbst dann sind je CO2-Gasteilchen drei Atome und je He-Gasteilchen ein Atom vorhanden; gleiche Gasteilchenzahl bedeutet daher nicht gleiche Gesamtatomzahl. Keine exakte Zahlenquote aus den abweichenden Bedingungen wird für dieses Ziel verlangt.",
                "expectedPerformanceEn": "Equal particle counts do not follow here from Avogadro’s law because temperatures differ. Equal-volume comparison requires matched temperature and pressure in the ideal model. Even then, each CO2 particle has three atoms while each He particle has one; equal gas-particle count therefore does not mean equal total atom count. This goal does not require an exact ratio for the mismatched conditions.",
                "understandingFocusDe": "Frischer Bedingungsfehler und eigenständige Abgrenzung von Teilchen- und Atomzahl; keine stillschweigende Allgemeingültigkeit.",
                "understandingFocusEn": "A fresh condition mismatch and independent distinction between gas-particle and atom count prevent an unqualified universal rule."
              }
            ]
          }
        }
      ],

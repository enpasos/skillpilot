        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "representation",
            "expectations": [
              {
                "id": "content-specific-understanding",
                "essentialUnderstandingDe": "EinOrbital ist eine räumlicheWellenfunktion einesgeeignetenquantenmechanischenModells;|ψ|² isteine nichtnegativeWahrscheinlichkeitsdichte. Aufenthaltswahrscheinlichkeit für einenBereich entsteht ausDichte undBereichsgröße,keine klassischeBahnfläche.",
                "essentialUnderstandingEn": "An orbital is a spatial wave function of a suitable quantum model;|ψ|² is nonnegative probability density.Probability for a region depends on density and region size,not a classical orbit surface.",
                "observablePerformanceDe": "DasOrbital liefert eineWellenfunktion,keineBahn. Betragsquadrat nichtnegativ,Summe dergegebenenBereichswahrscheinlichkeiten1. Bei gleichemVolumenDichterangA>B>C>D;C/D bleiben positiveWahrscheinlichkeiten trotz negativemψ. Ladungszeichen werdennicht ausPhasenfarben abgeleitet.",
                "observablePerformanceEn": "The orbital supplies a wave function,not a trajectory.Modulus squared is nonnegative;the supplied region probabilities sum to1.Equal volumes give density orderA>B>C>D.C/D retain positive probabilities despite negativeψ.Charge signs are not inferred from phase colours."
              },
              {
                "id": "fresh-transfer-and-model-boundary",
                "essentialUnderstandingDe": "GezeichneteOrbitalwolken sindModellkonturen bzw.Dichtekodierungen;außerhalb einergewähltenKontur istElektronenwahrscheinlichkeit nichtautomatisch null.",
                "essentialUnderstandingEn": "Orbital clouds are model contours or density encodings;electron probability is not automatically zero outside a chosen contour.",
                "observablePerformanceDe": "PE=0,2×1=0,2;PF=0,1×3=0,3. E istdichter,F insgesamt wahrscheinlicher;0,2+0,3+0,5=1. Knoten|ψ|²=0. DiePerson verbindetDichte mitVolumen undunterscheidet eineKonturfläche vomfestenElektronenrand.",
                "observablePerformanceEn": "PE=0.2×1=0.2;PF=0.1×3=0.3.E has higher density,butF higher total probability;0.2+0.3+0.5=1.A node has|ψ|²=0.The learner combines density and volume and distinguishes a contour from a fixed electron boundary."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "content-specific-understanding",
                "fresh-transfer-and-model-boundary"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "specific-material-variation",
                "textDe": "Gleichgroße gegenüberunterschiedlichgroßenBereichen;ψ-Vorzeichen undDichte.",
                "textEn": "Equal versus unequal region volumes;wave-function sign and density."
              },
              {
                "id": "specific-model-limit",
                "textDe": "GezeichneteOrbitalwolken sindModellkonturen bzw.Dichtekodierungen;außerhalb einergewähltenKontur istElektronenwahrscheinlichkeit nichtautomatisch null.",
                "textEn": "Orbital clouds are model contours or density encodings;electron probability is not automatically zero outside a chosen contour."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-next25-0acc8cd2-case-1",
                "taskDemandDe": "EinmodelliertesOrbital besitztviergleichgroße kleineBereicheA–D. Gelieferte normierteBereichswahrscheinlichkeiten:A0,4;B0,3;C0,2;D0,1. Phasenzeichenψ inA/B positiv,inC/D negativ. Sie sindVorzeichen derWellenfunktion,keine elektrischenLadungen. BeschreibeOrbital/|ψ|²,ordne dieDichten dergleichgroßenBereiche undbeurteile„negativePhase bedeutet negativeWahrscheinlichkeit“.",
                "taskDemandEn": "A model orbital has four equally sized small regionsA–D.Supplied normalised region probabilities:A0.4;B0.3;C0.2;D0.1.Theψ signs are positive inA/B,negative inC/D.They are wave-function signs,not electrical charges. Describe orbital/|ψ|²,rank the densities of equal-sized regions and assess“negative phase means negative probability”.",
                "expectedPerformanceDe": "DasOrbital liefert eineWellenfunktion,keineBahn. Betragsquadrat nichtnegativ,Summe dergegebenenBereichswahrscheinlichkeiten1. Bei gleichemVolumenDichterangA>B>C>D;C/D bleiben positiveWahrscheinlichkeiten trotz negativemψ. Ladungszeichen werdennicht ausPhasenfarben abgeleitet.",
                "expectedPerformanceEn": "The orbital supplies a wave function,not a trajectory.Modulus squared is nonnegative;the supplied region probabilities sum to1.Equal volumes give density orderA>B>C>D.C/D retain positive probabilities despite negativeψ.Charge signs are not inferred from phase colours.",
                "understandingFocusDe": "An einer exaktmathematischenStelle istDichte nicht gleich derWahrscheinlichkeit einesendlichenRaumbereichs.",
                "understandingFocusEn": "Density at an exact mathematical point is not the probability of a finite spatial region."
              },
              {
                "id": "chem-next25-0acc8cd2-case-2",
                "taskDemandDe": "FrischerStückkonstanten-Modellfall:BereichE Volumen1mitDichte0,2;BereichF Volumen3mitDichte0,1 in gemeinsamen normiertenModelleinheiten. DieübrigenBereiche tragen zusammen0,5. EinKnoten besitztψ=0. VergleicheDichteundBereichswahrscheinlichkeit,prüfeNormierung unddeute denKnoten. Korrigiere„dunkelsteStelle muss derwahrscheinlichsteGroßbereich sein“.",
                "taskDemandEn": "Fresh piecewise-constant model:regionE volume1 and density0.2;regionF volume3 and density0.1 in shared normalised model units.The other regions contribute0.5.A node hasψ=0. Compare density and region probability,check normalisation and interpret the node.Correct“the darkest point must be the most probable large region”.",
                "expectedPerformanceDe": "PE=0,2×1=0,2;PF=0,1×3=0,3. E istdichter,F insgesamt wahrscheinlicher;0,2+0,3+0,5=1. Knoten|ψ|²=0. DiePerson verbindetDichte mitVolumen undunterscheidet eineKonturfläche vomfestenElektronenrand.",
                "expectedPerformanceEn": "PE=0.2×1=0.2;PF=0.1×3=0.3.E has higher density,butF higher total probability;0.2+0.3+0.5=1.A node has|ψ|²=0.The learner combines density and volume and distinguishes a contour from a fixed electron boundary.",
                "understandingFocusDe": "GezeichneteOrbitalwolken sindModellkonturen bzw.Dichtekodierungen;außerhalb einergewähltenKontur istElektronenwahrscheinlichkeit nichtautomatisch null.",
                "understandingFocusEn": "Orbital clouds are model contours or density encodings;electron probability is not automatically zero outside a chosen contour."
              }
            ]
          }
        }

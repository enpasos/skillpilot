        "visualization": {
          "resourceType": "image",
          "title": "Visualisierung: Quantenzahlen und Besetzungsregeln zur PSE-Anordnung nutzen",
          "url": "/assets/goal-visualizations/chemie/3bc48951-025c-5144-99b1-924db611a5f9/3bc48951-025c-5144-99b1-924db611a5f9.jpg",
          "altText": "Didaktische Visualisierung zum Lernziel \"Quantenzahlen und Besetzungsregeln zur PSE-Anordnung nutzen\". Die lernende Person kann aus der Natrium-Doppellinie die Erweiterung der Quantenzahlen begruenden, die Anordnung der Atome im vollstaendigen Periodensystem mit Aufbauprinzip, Pauli-Prinzip und Hundscher Regel beschreiben und Elektronenverteilungen in Atomen sowie Atom-Ionen erklaeren.",
          "originalDigest": "sha256:84ff056013a0d1f773f6d63a3a2475b12673d50cabb374133af74376516216f4",

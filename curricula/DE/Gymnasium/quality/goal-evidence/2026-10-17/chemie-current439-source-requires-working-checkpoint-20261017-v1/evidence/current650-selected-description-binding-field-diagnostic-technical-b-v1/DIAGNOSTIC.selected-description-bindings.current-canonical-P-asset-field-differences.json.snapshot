      "canonicalContextDifferences": [
        {
          "field": "requires",
          "before": [
            "448815cc-4127-54b7-96bf-e54b3d2a38c5",
            "9b56d01e-c2d7-51d8-b78e-237592c1ed20",
            "973c12d9-d863-5292-8c68-9c80cdacf9e2"
          ],
          "current": [
            "448815cc-4127-54b7-96bf-e54b3d2a38c5",

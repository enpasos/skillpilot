      "PProfileDifferences": [
        {
          "field": "",
          "before": null,
          "current": {
            "archetype": "concept",
            "expectations": [
              {
                "id": "structure-model-reasoning",
                "essentialUnderstandingDe": "Zwischenmolekulare Anziehung erklärt zusammen mit Molekülgröße/-form Siedeverhalten und Mischbarkeit; alle betrachteten Moleküle besitzen London-Wechselwirkungen.",
                "essentialUnderstandingEn": "Intermolecular attraction together with molecular size/shape explains boiling behaviour and miscibility; all molecules considered have London interactions.",
                "observablePerformanceDe": "Die Person identifiziert Wasserstoffbrücken-Donor/-Akzeptor und London-Beiträge und verbindet sie mit dem Trennen/Mischen von Molekülen.",
                "observablePerformanceEn": "The learner identifies hydrogen-bond donors/acceptors and London contributions and connects them to separating/mixing molecules."
              },
              {
                "id": "fresh-application-and-boundary",
                "essentialUnderstandingDe": "Die Stärke einer einzelnen Wechselwirkung ersetzt nicht die Betrachtung aller Beiträge; Schmelztemperaturen hängen zusätzlich von Kristallpackung ab.",
                "essentialUnderstandingEn": "The strength of an individual interaction does not replace considering all contributions; melting also depends on crystal packing.",
                "observablePerformanceDe": "Die größere Kohlenwasserstoffoberfläche erhöht polarisierbare Kontaktmöglichkeiten; der hydrophobe Anteil wächst relativ zur einen OH-Gruppe. Beide können Wasserstoffbrücken bilden, dennoch ist Hexan-1-ol viel schlechter mit Wasser mischbar. Eine sichere Schmelzrangfolge braucht Packungs-/Messinformationen. Beim Schmelzen wird die geordnete Festkörperpackung aufgehoben und die Anordnung der zwischenmolekularen Kontakte verändert; die Moleküle bleiben in der Flüssigkeit intakt und üben weiter London-Anziehung aus. Die vorgegebene günstigere symmetrische Packung stabilisiert im Modell die feste Phase und begründet zusammen mit den Fusionsdaten den höheren Schmelzwert des kompakten Isomers; dies ist keine direkte Folgerung aus einer Siedetemperatur oder eine allgemeine Verzweigungsregel. Eine OH-Gruppe macht nicht jedes Molekül vollständig wasserlöslich; höhere Siedetemperatur impliziert keine zwingend höhere Schmelztemperatur.",
                "observablePerformanceEn": "The larger hydrocarbon surface increases polarizable contact possibilities; the hydrophobic fraction grows relative to the single OH group. Both can hydrogen-bond, yet hexan-1-ol mixes much less well with water. A reliable melting order needs packing or measurement information. Melting disrupts ordered solid packing and changes the arrangement of intermolecular contacts; the molecules remain intact in the liquid and still exert London attraction. In the given model, favourable symmetrical packing stabilises the solid phase and, together with the fusion data, accounts for the compact isomer melting higher; this is not inferred directly from boiling temperature or a universal branching rule. One OH group does not make every molecule fully water-soluble; a higher boiling point does not imply a necessarily higher melting point."
              },
              {
                "id": "positive-melting-model-explanation",
                "essentialUnderstandingDe": "Schmelzen verändert die geordnete Packung und zwischenmolekulare Kontakte einer festen Phase; Moleküle bleiben intakt. London-Anziehung zusammen mit vorgegebenen Form-/Packungsinformationen und Fusionsdaten ermöglicht eine begründete Schmelzerklärung, ohne eine allgemeine Siede-Schmelz-Rangfolge zu behaupten.",
                "essentialUnderstandingEn": "Melting changes ordered packing and intermolecular contacts in a solid phase; molecules remain intact. London attraction together with supplied shape/packing information and fusion data supports a justified melting explanation without claiming a universal boiling-to-melting ranking.",
                "observablePerformanceDe": "Die Person erklärt am gegebenen n-Pentan/2,2-Dimethylpropan-Modell den höheren Fusionswert des symmetrischen kompakten Isomers mit der im Modell günstigeren Festkörperpackung; sie unterscheidet das Aufheben geordneter Packung von Molekültrennung beim Sieden und von kovalenter Bindungsspaltung.",
                "observablePerformanceEn": "Using the given n-pentane/2,2-dimethylpropane model, the learner accounts for the symmetrical compact isomer having the higher fusion value through favourable solid packing in that model, and distinguishes loss of ordered packing from molecular separation in boiling and from covalent-bond cleavage."
              }
            ],
            "coverageExpectations": {
              "requiredExpectationIds": [
                "structure-model-reasoning",
                "fresh-application-and-boundary",
                "positive-melting-model-explanation"
              ],
              "alternativeExpectationGroups": [],
              "minimumIndependentDemonstrations": 2,
              "freshVariationRequired": true,
              "independentTransferRequired": true
            },
            "variationAxes": [
              {
                "id": "material-variation",
                "textDe": "Hydroxygruppe, Kettenlänge, Molekülform und Wahl eines polaren oder unpolaren Lösemittels.",
                "textEn": "Hydroxyl group, chain length, molecular shape and choice of polar or nonpolar solvent."
              },
              {
                "id": "counterexample",
                "textDe": "Die Stärke einer einzelnen Wechselwirkung ersetzt nicht die Betrachtung aller Beiträge; Schmelztemperaturen hängen zusätzlich von Kristallpackung ab.",
                "textEn": "The strength of an individual interaction does not replace considering all contributions; melting also depends on crystal packing."
              }
            ],
            "applicationCaseBriefs": [
              {
                "id": "chem-current15-3d3231f9-case-1",
                "taskDemandDe": "Strukturen: Ethanol CH3CH2OH, Propan CH3CH2CH3, Wasser H2O. Ethanol und Propan besitzen ähnliche molare Masse; es werden keine Messwerte vorgegeben. Begründe den deutlich höheren Siedepunkt von Ethanol gegenüber Propan und die gute Mischbarkeit von Ethanol mit Wasser anhand der Strukturen.",
                "taskDemandEn": "Structures: ethanol CH3CH2OH, propane CH3CH2CH3, water H2O. Ethanol and propane have similar molar mass; no measurements are supplied. Explain ethanol boiling much higher than propane and mixing well with water using their structures.",
                "expectedPerformanceDe": "Beide besitzen London-Kräfte; Ethanol bietet zusätzlich polare O-H/C-O-Bindungen und Wasserstoffbrücken zwischen Molekülen sowie mit Wasser. Beim Sieden werden intermolekulare Wechselwirkungen überwunden, nicht C-C-Bindungen zerlegt.",
                "expectedPerformanceEn": "Both have London interactions; ethanol additionally offers polar O-H/C-O bonds and hydrogen bonding between molecules and with water. Boiling overcomes intermolecular interactions rather than breaking C-C bonds.",
                "understandingFocusDe": "Ein Wasserstoff an einem Kohlenstoff ist in diesen Stoffen kein gleichwertiger Wasserstoffbrücken-Donor.",
                "understandingFocusEn": "A hydrogen bonded to carbon in these substances is not an equivalent hydrogen-bond donor."
              },
              {
                "id": "chem-current15-3d3231f9-case-2",
                "taskDemandDe": "Frischer Vergleich: Ethanol CH3CH2OH und Hexan-1-ol CH3(CH2)5OH; beide enthalten genau eine Hydroxygruppe. Zusätzlich gegeben: n-Pentan CH3(CH2)3CH3 und 2,2-Dimethylpropan C(CH3)4 sind unpolare C5H12-Isomere; gerundete NIST-Fusionswerte sind 143 K beziehungsweise 255 K. Vorgegebenes qualitatives Packungsmodell: Beide Feststoffe werden durch London-Anziehung zusammengehalten; die kompakte, hochsymmetrische Form des 2,2-Dimethylpropans begünstigt im Modell eine regelmäßigere Packung und Stabilisierung der festen Phase. Dieses vereinfachte Modell ist kein neuer gemessener Kristallstrukturbeleg. Begründe, warum die längere Kette zugleich den London-Beitrag erhöht und die Mischbarkeit mit Wasser vermindert. Sage, welche Schmelzrangfolge aus diesen Angaben noch nicht sicher folgt. Erkläre anhand der gegebenen Packungs- und Fusionsangaben positiv den höheren Schmelzwert von 2,2-Dimethylpropan und was sich beim Schmelzen gegenüber dem Sieden ändert.",
                "taskDemandEn": "Fresh comparison: ethanol CH3CH2OH and hexan-1-ol CH3(CH2)5OH; each contains exactly one hydroxyl group. Additionally supplied: n-pentane CH3(CH2)3CH3 and 2,2-dimethylpropane C(CH3)4 are nonpolar C5H12 isomers; rounded NIST fusion values are 143 K and 255 K, respectively. Given qualitative packing model: London attraction holds both solids together; in the model the compact, highly symmetrical shape of 2,2-dimethylpropane favours more regular packing and stabilisation of the solid phase. This simplified model is not new measured crystal-structure evidence. Explain why the longer chain increases the London contribution while reducing water miscibility. State which melting order cannot yet be established. Using the supplied packing and fusion information, explain positively the higher melting value of 2,2-dimethylpropane and what changes in melting compared with boiling.",
                "expectedPerformanceDe": "Die größere Kohlenwasserstoffoberfläche erhöht polarisierbare Kontaktmöglichkeiten; der hydrophobe Anteil wächst relativ zur einen OH-Gruppe. Beide können Wasserstoffbrücken bilden, dennoch ist Hexan-1-ol viel schlechter mit Wasser mischbar. Eine sichere Schmelzrangfolge braucht Packungs-/Messinformationen. Beim Schmelzen wird die geordnete Festkörperpackung aufgehoben und die Anordnung der zwischenmolekularen Kontakte verändert; die Moleküle bleiben in der Flüssigkeit intakt und üben weiter London-Anziehung aus. Die vorgegebene günstigere symmetrische Packung stabilisiert im Modell die feste Phase und begründet zusammen mit den Fusionsdaten den höheren Schmelzwert des kompakten Isomers; dies ist keine direkte Folgerung aus einer Siedetemperatur oder eine allgemeine Verzweigungsregel.",
                "expectedPerformanceEn": "The larger hydrocarbon surface increases polarizable contact possibilities; the hydrophobic fraction grows relative to the single OH group. Both can hydrogen-bond, yet hexan-1-ol mixes much less well with water. A reliable melting order needs packing or measurement information. Melting disrupts ordered solid packing and changes the arrangement of intermolecular contacts; the molecules remain intact in the liquid and still exert London attraction. In the given model, favourable symmetrical packing stabilises the solid phase and, together with the fusion data, accounts for the compact isomer melting higher; this is not inferred directly from boiling temperature or a universal branching rule.",
                "understandingFocusDe": "Eine OH-Gruppe macht nicht jedes Molekül vollständig wasserlöslich; höhere Siedetemperatur impliziert keine zwingend höhere Schmelztemperatur.",
                "understandingFocusEn": "One OH group does not make every molecule fully water-soluble; a higher boiling point does not imply a necessarily higher melting point."
              }
            ]
          }
        }
      ],
      "PRecordMetadataDifferences": [

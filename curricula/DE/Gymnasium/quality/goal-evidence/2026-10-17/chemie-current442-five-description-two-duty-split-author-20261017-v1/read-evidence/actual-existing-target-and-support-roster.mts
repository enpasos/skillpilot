import fs from 'node:fs';import crypto from 'node:crypto';import {normalizeCompositionView,collectCompositionProjectionRoleGoalIds} from '../app/src/utils/authoring/compositionViewAuthoring.ts';
const read=(p:string)=>JSON.parse(fs.readFileSync(p,'utf8'));const pin=(p:string)=>{const b=fs.readFileSync(p);return{path:p,sha256:crypto.createHash('sha256').update(b).digest('hex'),bytes:b.length}};
const cp='curricula/DE/Gymnasium/canonical/DE_DEU_S_GYM_CANONICAL_CHEMIE.de.json';const c=read(cp);const by=new Map<string,any>(c.goals.map((g:any)=>[g.id,g]));const ids=['0959eef2-3c7d-5b33-a109-ddf332a5dbd9','3eb2a06c-d283-57aa-9eb4-088940c4801a','9f892457-c4e5-56da-830c-bf6cac0c98d7','f4d5a02d-711b-5a6b-a41d-971359c1f64d'];const dir='curricula/DE/Gymnasium/composition-views/chemie';const out:any[]=[];
const covers=(id:string,wanted:string)=>{const todo=[id],seen=new Set<string>();while(todo.length){const x=todo.pop()!;if(x===wanted)return true;if(seen.has(x))continue;seen.add(x);todo.push(...(by.get(x)?.contains??[]));}return false};
for(const f of fs.readdirSync(dir).filter(x=>x.endsWith('.view.json')).sort()){const p=dir+'/'+f;const v=normalizeCompositionView(read(p));const role=collectCompositionProjectionRoleGoalIds(v.rootNodes,by);for(const id of ids){if(!role.targetGoalIds.has(id)&&!role.prerequisiteOnlyGoalIds.has(id))continue;const refs:any[]=[];const walk=(ns:any[],base:string,labels:string[])=>ns.forEach((n,i)=>{const at=base+'/'+i;if(n.kind==='structure')walk(n.children,at+'/children',[...labels,n.label]);else if((n.kind==='goalEntry'&&n.goalId===id)||(n.kind==='canonicalSubtree'&&covers(n.goalId,id)))refs.push({pointer:at,node:n,ancestorLabels:labels})});walk(v.rootNodes,'/rootNodes',[]);out.push({goalId:id,view:pin(p),viewId:v.viewId,scope:v.scope,actualRole:role.targetGoalIds.has(id)?'target':'prerequisiteOnly',currentAuthoredReferences:refs})}}
fs.writeFileSync('tmp/chemie442_five_author_actual_target_roster.json',JSON.stringify({artifactType:'Read-only actual existing target/support roster from stock role collector; not source or new scope approval',atUTC:new Date().toISOString(),canonical:pin(cp),rows:out},null,2)+'\n');console.log(JSON.stringify(ids.map(id=>({goalId:id,targets:out.filter(x=>x.goalId===id&&x.actualRole==='target').map(x=>({view:x.viewId,scope:x.scope})),support:out.filter(x=>x.goalId===id&&x.actualRole==='prerequisiteOnly').length})),null,2));

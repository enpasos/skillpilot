import assert from 'node:assert/strict'
import {readFileSync} from 'node:fs'
import {join} from 'node:path'
import {collectMemoryDeckEvidence,fingerprintMemoryCard} from './independentV19MemoryCards.ts'
const input=JSON.parse(readFileSync(process.argv[2],'utf8'));const staticInput=JSON.parse(readFileSync(process.argv[3],'utf8'));const cap=input.privateRoot;const can=JSON.parse(readFileSync(join(cap,input.activeCanPath),'utf8'));const d=collectMemoryDeckEvidence(can);assert.deepEqual(d.errors,[]);assert.equal(d.primaryCards.length,66);assert.equal(d.memoryGoalIds.size,10);assert.equal(d.knownDeckIds.size,10);const review=readFileSync(join(cap,staticInput.cardReview66.path),'utf8').trim().split(/\r?\n/).map(l=>JSON.parse(l));assert.equal(review.length,66);const byKey=new Map(review.map(r=>[r.deckId+'::'+r.cardId,r]));const checked=d.primaryCards.map(c=>{const r:any=byKey.get(c.deckId+'::'+c.cardId);assert(r);const fp=fingerprintMemoryCard(c,r.ruleVersion);assert.equal(fp,r.fingerprint);return {deckId:c.deckId,cardId:c.cardId,fingerprint:fp,reviewStatus:r.status,source:c.source};});console.log(JSON.stringify({scope:'Existing-card technical integrity only; no repeated card science',memoryGoals:10,primaryDecks:10,primaryCards:66,actualPhysicalDeckFiles:d.deckFiles,actualRowsIncludingAnySecondaryLanguages:d.cardRows,errors:d.errors,checkedCurrentNativeFingerprints:checked,newCardOrHumanApproval:0},null,2))

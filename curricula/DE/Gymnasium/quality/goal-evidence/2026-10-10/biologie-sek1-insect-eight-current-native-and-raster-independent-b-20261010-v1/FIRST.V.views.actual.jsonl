{"schemaVersion": 1, "goalId": "e1ce88af-3cb7-599a-8a27-fd2ea2f6d492", "assetRole": "actualOriginalPNG", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/e1ce88af-3cb7-599a-8a27-fd2ea2f6d492/e1ce88af-3cb7-599a-8a27-fd2ea2f6d492.png", "sha256": "sha256:9d89b72ec7a36e356aa298d4303a431c3bf7ce863a7075e83633dd8b556f5ddb", "bytes": 2104018}, "width": 1672, "height": 941, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 1, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Außenskelett und Innenskelett sind durch zwei zusammengehörige Gelenk-Ausschnitte vergleichbar. Muskelansätze liegen innen an der Cuticula bzw. am inneren Knochen; die roten Bewegungspfeile bezeichnen Beugung und keine aktiv schiebende Muskelkraft."}
{"schemaVersion": 1, "goalId": "e1ce88af-3cb7-599a-8a27-fd2ea2f6d492", "assetRole": "phone360", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/e1ce88af-3cb7-599a-8a27-fd2ea2f6d492/inspection-360.png", "sha256": "sha256:2615fa4367a895cbcd885bf8687e4dcf600d59245c91161e70b673f31ba5496c", "bytes": 141034}, "width": 360, "height": 203, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 2, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Die zwei großen Labels und beide Gelenk-Ausschnitte bleiben bei 360 und 680 klar."}
{"schemaVersion": 1, "goalId": "e1ce88af-3cb7-599a-8a27-fd2ea2f6d492", "assetRole": "pc680", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/e1ce88af-3cb7-599a-8a27-fd2ea2f6d492/inspection-680.png", "sha256": "sha256:9a7a179c1cbafd378f8d11f06d091ad5fb0aa3eac3e11ae1bda8b0ae04a29e3b", "bytes": 430097}, "width": 680, "height": 383, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 3, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Die zwei großen Labels und beide Gelenk-Ausschnitte bleiben bei 360 und 680 klar."}
{"schemaVersion": 1, "goalId": "fa59721d-fdee-50dd-b0de-0082abd33741", "assetRole": "actualOriginalPNG", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/fa59721d-fdee-50dd-b0de-0082abd33741/fa59721d-fdee-50dd-b0de-0082abd33741.png", "sha256": "sha256:849b88d09108d7a962099dbbef6e35580686355526177720ff2da65fef772e7e", "bytes": 2076879}, "width": 1672, "height": 941, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 4, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Heuschrecken-Sprung, Libellenflug mit zwei Flügelpaaren und Käfer-Rudern mit verbreiterten Hinterbeinen zeigen drei aktive Bewegungsmechanismen. Land/Luft/Wasser und Bewegungsbögen sind eindeutig zugeordnet."}
{"schemaVersion": 1, "goalId": "fa59721d-fdee-50dd-b0de-0082abd33741", "assetRole": "phone360", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/fa59721d-fdee-50dd-b0de-0082abd33741/inspection-360.png", "sha256": "sha256:584204049a4a09d42b1ba9a85e460b1ec3473888f2bb38281d8f9e535f674e8e", "bytes": 138837}, "width": 360, "height": 203, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 5, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Bei 360 und 680 bleiben alle drei Vertreter, große Lebensraumlabels, Libellenflügel und die Ruderbeine erkennbar."}
{"schemaVersion": 1, "goalId": "fa59721d-fdee-50dd-b0de-0082abd33741", "assetRole": "pc680", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/fa59721d-fdee-50dd-b0de-0082abd33741/inspection-680.png", "sha256": "sha256:88fb07b1caead930e5ab48e75b426e4ec42ac45919ba2fe53661f8b69d45ebee", "bytes": 427421}, "width": 680, "height": 383, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 6, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Bei 360 und 680 bleiben alle drei Vertreter, große Lebensraumlabels, Libellenflügel und die Ruderbeine erkennbar."}
{"schemaVersion": 1, "goalId": "6ff8baef-ba6f-51ca-adb7-b9f785cf5b35", "assetRole": "actualOriginalPNG", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/6ff8baef-ba6f-51ca-adb7-b9f785cf5b35/6ff8baef-ba6f-51ca-adb7-b9f785cf5b35.png", "sha256": "sha256:699c8a1bfaafb9314117f6da284cd7eeb2bd9d166a21297cd3ea45c53d46c45a", "bytes": 1985194}, "width": 1672, "height": 941, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 7, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "O2 gelangt beim Insekt vom seitlichen Zugang durch blaue Tracheen zur Zelle; der dorsale Herzschlauch ist davon getrennt. Nährstoffsymbole führen vom Darm in den Körperraum zur Versorgung; es ist kein geschlossener Insekten-Blut-O2-Kreis eingezeichnet."}
{"schemaVersion": 1, "goalId": "6ff8baef-ba6f-51ca-adb7-b9f785cf5b35", "assetRole": "phone360", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/6ff8baef-ba6f-51ca-adb7-b9f785cf5b35/inspection-360.png", "sha256": "sha256:da3f29797e187aa6db1eaa42b83dbc34a012629a0bf50ee8a1918e740125b4b2", "bytes": 134783}, "width": 360, "height": 203, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 8, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Bei 360 ist Nährstoffe ein kleiner Zusatztext; O2-Zugang, Tracheen, Herzschlauch, Kiemen und Kreislauf sind dennoch klar. Bei 680 sind auch die Zusatzlabels lesbar."}
{"schemaVersion": 1, "goalId": "6ff8baef-ba6f-51ca-adb7-b9f785cf5b35", "assetRole": "pc680", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/6ff8baef-ba6f-51ca-adb7-b9f785cf5b35/inspection-680.png", "sha256": "sha256:bc946450af2f5171533140b35cb001321e1f745403ace58e896aea31b35945ad", "bytes": 405484}, "width": 680, "height": 383, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 9, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Bei 360 ist Nährstoffe ein kleiner Zusatztext; O2-Zugang, Tracheen, Herzschlauch, Kiemen und Kreislauf sind dennoch klar. Bei 680 sind auch die Zusatzlabels lesbar."}
{"schemaVersion": 1, "goalId": "64569988-1fbe-5a0b-a685-3a7da99d0229", "assetRole": "actualOriginalPNG", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/64569988-1fbe-5a0b-a685-3a7da99d0229/64569988-1fbe-5a0b-a685-3a7da99d0229.png", "sha256": "sha256:44a8a315964635b578f95e8e2c32b92ce216ca04013e8c56d3e39fd6d33f240b", "bytes": 2172695}, "width": 1672, "height": 941, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 10, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Mandibeln am Blatt, ein Saugrüssel an einer zugänglichen Blüte und stechend-saugender Hautzugang zeigen verschiedene Nahrungszugänge. Die Hautzeichnung behauptet weder eine genaue Gefäßpunktion noch einen Erregerbefund."}
{"schemaVersion": 1, "goalId": "64569988-1fbe-5a0b-a685-3a7da99d0229", "assetRole": "phone360", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/64569988-1fbe-5a0b-a685-3a7da99d0229/inspection-360.png", "sha256": "sha256:92ec9b8ebf5266bd15f410659c04d8efdf5017a179e42dd47f4c7dee5dc26426", "bytes": 143577}, "width": 360, "height": 203, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 11, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Kauen/Saugen/Stechen und die drei Mundzugänge bleiben bei 360 und 680 deutlich; das Bild benötigt keine mikroskopische Decodierung der Hautdetails."}
{"schemaVersion": 1, "goalId": "64569988-1fbe-5a0b-a685-3a7da99d0229", "assetRole": "pc680", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/64569988-1fbe-5a0b-a685-3a7da99d0229/inspection-680.png", "sha256": "sha256:d341fff71dbd39d4ac57da280b7dc310227018145702881d8de5d468033adf34", "bytes": 442042}, "width": 680, "height": 383, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 12, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Kauen/Saugen/Stechen und die drei Mundzugänge bleiben bei 360 und 680 deutlich; das Bild benötigt keine mikroskopische Decodierung der Hautdetails."}
{"schemaVersion": 1, "goalId": "47391e58-6937-5a47-bef0-19c6fcd27b4b", "assetRole": "actualOriginalPNG", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/47391e58-6937-5a47-bef0-19c6fcd27b4b/47391e58-6937-5a47-bef0-19c6fcd27b4b.png", "sha256": "sha256:32a93fb417af738efb40076fa93631d509b81af44b15bee500056ef2f1e45911", "bytes": 2150507}, "width": 1672, "height": 941, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 13, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Die zwei Zeilen trennen Befruchtung und Entwicklung. Käfer und Kaninchen zeigen innere Befruchtung, Fisch Eier/Spermien im Wasser; darunter liegen Käfereier an einer Pflanze, Fischeier im Wasser und ein Embryo im Mutterkörper."}
{"schemaVersion": 1, "goalId": "47391e58-6937-5a47-bef0-19c6fcd27b4b", "assetRole": "phone360", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/47391e58-6937-5a47-bef0-19c6fcd27b4b/inspection-360.png", "sha256": "sha256:85f69e020e919e3e5d924cf19033e584dae0ff0963b3ede3558471fa068cd934", "bytes": 143311}, "width": 360, "height": 203, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 14, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Zeilen-/Spaltenzuordnung und innen/außen bleiben bei 360 sowie 680 lesbar. Auch Eier außerhalb und Embryo innerhalb sind in beiden Ansichten unterscheidbar."}
{"schemaVersion": 1, "goalId": "47391e58-6937-5a47-bef0-19c6fcd27b4b", "assetRole": "pc680", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/47391e58-6937-5a47-bef0-19c6fcd27b4b/inspection-680.png", "sha256": "sha256:882219e259b384306c4deb9ff885a5efe82231d0f011de69f2aa192e9ed17610", "bytes": 444040}, "width": 680, "height": 383, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 15, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Zeilen-/Spaltenzuordnung und innen/außen bleiben bei 360 sowie 680 lesbar. Auch Eier außerhalb und Embryo innerhalb sind in beiden Ansichten unterscheidbar."}
{"schemaVersion": 1, "goalId": "fcc20f50-8eb3-5d6c-b37f-5be13c7d314e", "assetRole": "actualOriginalPNG", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/fcc20f50-8eb3-5d6c-b37f-5be13c7d314e/fcc20f50-8eb3-5d6c-b37f-5be13c7d314e.png", "sha256": "sha256:15ee06ce03a0cba783ac3f03b5d6e56e84a6a2fb3ecb1fabae6cfba2d54cf990", "bytes": 2065455}, "width": 1672, "height": 941, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 16, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Die Pfeile laufen jeweils Ei→Folgestadien. Schmetterling zeigt Raupe und Puppe vor dem erwachsenen Falter; Heuschrecke zeigt Nymphe, Häutungsrest und geflügelten Erwachsenen ohne Puppe."}
{"schemaVersion": 1, "goalId": "fcc20f50-8eb3-5d6c-b37f-5be13c7d314e", "assetRole": "phone360", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/fcc20f50-8eb3-5d6c-b37f-5be13c7d314e/inspection-360.png", "sha256": "sha256:d190119410f4a88c5e9bead072b14e7d1cf605289344ee23b506c8be202f38a5", "bytes": 134743}, "width": 360, "height": 203, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 17, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Alle drei Reihen, ihre Pfeilrichtungen, Puppenstadium, Häutungsrest und der Restschwanz des Jungfroschs bleiben bei 360 und 680 erkennbar."}
{"schemaVersion": 1, "goalId": "fcc20f50-8eb3-5d6c-b37f-5be13c7d314e", "assetRole": "pc680", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/fcc20f50-8eb3-5d6c-b37f-5be13c7d314e/inspection-680.png", "sha256": "sha256:1955a3ba3e4c2a2bb4f107d2428dbecf91b5638e38ddf17fbf6466924a567baa", "bytes": 416421}, "width": 680, "height": 383, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 18, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Alle drei Reihen, ihre Pfeilrichtungen, Puppenstadium, Häutungsrest und der Restschwanz des Jungfroschs bleiben bei 360 und 680 erkennbar."}
{"schemaVersion": 1, "goalId": "d74b252b-217f-563c-8263-8062a1442d2e", "assetRole": "actualOriginalPNG", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/d74b252b-217f-563c-8263-8062a1442d2e/d74b252b-217f-563c-8263-8062a1442d2e.png", "sha256": "sha256:0e7e25cd302dd1cf3a7ef246d0370b005b8e8f77799c74792fe8014a0e022327", "bytes": 2238086}, "width": 1672, "height": 941, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 19, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Orientierte Seitenansichten zeigen Kopfverarbeitung bei beiden Tieren, ventrale Ganglienstruktur beim Insekt und dorsales Rückenmark beim Wirbeltier. Bauchseite/Rückenseite-Pfeile treffen jeweils den markierten Nervenbereich."}
{"schemaVersion": 1, "goalId": "d74b252b-217f-563c-8263-8062a1442d2e", "assetRole": "phone360", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/d74b252b-217f-563c-8263-8062a1442d2e/inspection-360.png", "sha256": "sha256:31bc39327d81859fa9526bd5676ce6464cc4f9c9a8fd6fc76b60153b51aae4b5", "bytes": 140412}, "width": 360, "height": 203, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 20, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Die Nervenfarbe, beide Kopfzentren, ventraler Strang und dorsales Rückenmark sind bei 360 und 680 klar. Die großen Lagebezeichnungen bleiben lesbar."}
{"schemaVersion": 1, "goalId": "d74b252b-217f-563c-8263-8062a1442d2e", "assetRole": "pc680", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/d74b252b-217f-563c-8263-8062a1442d2e/inspection-680.png", "sha256": "sha256:f4f0b9bac39561148446fad0a40d82351f7214523a8dd4e1b4cea40614343d73", "bytes": 440630}, "width": 680, "height": 383, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 21, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Die Nervenfarbe, beide Kopfzentren, ventraler Strang und dorsales Rückenmark sind bei 360 und 680 klar. Die großen Lagebezeichnungen bleiben lesbar."}
{"schemaVersion": 1, "goalId": "62893858-64fb-5789-ad98-51b88e0de133", "assetRole": "actualOriginalPNG", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/62893858-64fb-5789-ad98-51b88e0de133/62893858-64fb-5789-ad98-51b88e0de133.png", "sha256": "sha256:27b710fbeb8498b687bb431b4fd2e1e00689f8ba5ce4c39e3be4926290b18ba9", "bytes": 2028296}, "width": 1672, "height": 941, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 22, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Duftspur führt zwischen Ameisen derselben Art und Nahrung; Flügelvibration/Schallbögen verbinden die Grillen. Wespen-Warnfarbe mit wahrnehmendem Vogel ist ein Beispiel zwischen verschiedener Arten."}
{"schemaVersion": 1, "goalId": "62893858-64fb-5789-ad98-51b88e0de133", "assetRole": "phone360", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/62893858-64fb-5789-ad98-51b88e0de133/inspection-360.png", "sha256": "sha256:2e83c0c62597f7c7bbfd017cf92465a67d5bd7c5ac6e877333619071cfe93285", "bytes": 137711}, "width": 360, "height": 203, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 23, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Alle drei Modalitätslabels, Spur, Schallbögen und Vogel-Wespe-Beziehung bleiben bei 360 und 680 deutlich."}
{"schemaVersion": 1, "goalId": "62893858-64fb-5789-ad98-51b88e0de133", "assetRole": "pc680", "asset": {"path": "curricula/DE/Gymnasium/quality/goal-evidence/2026-10-10/biologie-sek1-insect-eight-raster-native-technical-author-20261010-v1/assets/biologie/62893858-64fb-5789-ad98-51b88e0de133/inspection-680.png", "sha256": "sha256:f3ccb88dd8efe79017d9a463c1bae08d80d25d532fa1d000ce5d967ea0033bbc", "bytes": 416411}, "width": 680, "height": 383, "actualView": true, "tool": "tools.view_image", "detail": "original", "cropped": false, "viewSequence": 24, "viewBeforeCurrentAuthorOrPeerJudgments": true, "observationDe": "Alle drei Modalitätslabels, Spur, Schallbögen und Vogel-Wespe-Beziehung bleiben bei 360 und 680 deutlich."}

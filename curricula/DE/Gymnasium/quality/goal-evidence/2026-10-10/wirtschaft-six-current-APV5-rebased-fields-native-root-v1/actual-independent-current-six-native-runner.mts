import{readFileSync,writeFileSync,copyFileSync}from'node:fs';import{join}from'node:path';import assert from'node:assert/strict';import{buildApplicabilityCompilation}from'./applicabilityCompiler.ts';import{routeProfiles,evaluateRouteProfile,readJurisdictionCoverageByLandscapeId}from'./generateCurriculumQualityStatus.ts';
const R='/home/enpasos/projects/skillpilot',CAP=process.argv[2],O=process.argv[3],ix=JSON.parse(readFileSync(process.argv[4],'utf8'));const canpath=join(CAP,ix.actualCanonicalBefore.path);const can=()=>JSON.parse(readFileSync(canpath,'utf8'));const prof=routeProfiles.find(p=>p.landscapeId===can().landscapeId)!;const save=(n:string,x:any)=>writeFileSync(join(O,n),JSON.stringify(x,null,2)+'\n');function run(label:string){const compilation=buildApplicabilityCompilation(),report=compilation.reports.find(r=>r.landscapeId===can().landscapeId)!,route=evaluateRouteProfile(can(),prof,compilation),source=readJurisdictionCoverageByLandscapeId(compilation).get(can().landscapeId);const result={compiler:report,route,source};save(label+'.actual-native.json',result);return result;}
const before=run('before-current-APV5');copyFileSync(join(R,ix.actualCanonicalCandidate.path),canpath);for(const row of ix.views)copyFileSync(join(R,row.candidate.path),join(CAP,row.activePath));const after=run('after-six-flags-twelve-accesses-current-APV5');const metric=(r:any)=>r.route.rules.find((x:any)=>x.id==='CQR-104').metrics;assert.equal(metric(before).visibleSelectedGoalOccurrencesMissingDirectTerminalRoute,3764);assert.equal(metric(after).visibleSelectedGoalOccurrencesMissingDirectTerminalRoute,3704);assert.deepEqual(before.source,after.source);assert.equal(before.compiler.summary.errors,0);assert.equal(after.compiler.summary.errors,0);const bb=ix.views.find((r:any)=>r.activePath.endsWith('de-bb-gym-economics-gk.view.json'));assert.ok(bb);copyFileSync(join(R,bb.before.path),join(CAP,bb.activePath));const negative=run('actual-BB-GK-one-required-access-dropped-negative-current-APV5');assert.equal(metric(negative).visibleSelectedGoalOccurrencesMissingDirectTerminalRoute,3706);copyFileSync(join(R,bb.candidate.path),join(CAP,bb.activePath));save('actual-rebased-six-twelve-three-outputs-comparison.json',{beforeMetrics:metric(before),afterMetrics:metric(after),negativeMetrics:metric(negative),compilerBefore:before.compiler.summary,compilerAfter:after.compiler.summary,physicalSourceResultWholeExact:true,sourceGitAvailabilityModel:'No .git in owned capsule, physical-file fallback; production Git-index source availability separately passed current496 central',ordinaryTargetOccurrencesUnchanged:metric(before).visibleProjectedRouteTargetGoalOccurrences===metric(after).visibleProjectedRouteTargetGoalOccurrences,oldFiveQualifiedAPVFieldsRetained:true,strictGain:0,humanApproval:false});console.log(JSON.stringify({before:before.compiler.summary,after:after.compiler.summary,beforeGaps:3764,afterGaps:3704,realNegativeGaps:3706}));
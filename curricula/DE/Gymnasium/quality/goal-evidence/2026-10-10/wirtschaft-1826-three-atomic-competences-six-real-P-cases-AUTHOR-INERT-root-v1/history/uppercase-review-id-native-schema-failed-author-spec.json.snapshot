  "goals": [
    {
      "goalId": "1826fe19-4d06-5183-9b41-9121ae1cc219",
      "reason": "DE: Eigener ausdrücklich inaktiver Profilkandidat für genau den vorgeschlagenen Einzelmechanismus, mit zwei vollständig ausformulierten unterschiedlichen fiktiven Fällen. Die Erwartungen sind Autorenmaterial, keine beobachtete Lernendenleistung, unabhängige Freigabe oder menschliche Zustimmung. EN: Own explicitly inert candidate for this proposed single mechanism, with two fully written distinct fictional cases. Expectations are author material, not observed learner work, independent approval or human assent.",
      "evidenceLevel": "E1",
      "maximumClaimScope": "G1",
      "dissent": [],
      "profile": {
        "archetype": "concept",
        "expectations": [
          {
            "id": "power-output-mechanism",
            "essentialUnderstandingDe": "Tatsächliche Marktmacht und eingeschränkter Eintritt können gewinnorientierte Preis-/Mengenbeschränkungen ermöglichen. Mögliche Ineffizienz hängt von Nachfrage, Kosten, Ausweichmöglichkeiten und tatsächlich bindenden Regeln ab; die Firmenzahl allein ist kein Beweis.",
            "essentialUnderstandingEn": "Actual market power and restricted entry can enable privately profitable price/output restrictions. Possible inefficiency depends on demand, costs, alternatives and binding rules, not firm count alone.",
            "observablePerformanceDe": "Die Person verbindet gegebene Macht-/Eintrittsbedingungen mit Preis-/Mengenanreizen und möglicher Ineffizienz, nutzt den vorgegebenen Vergleich korrekt und begrenzt den Schluss bei bindenden Regeln statt nur einen Monopolnamen zu nennen.",
            "observablePerformanceEn": "The learner links supplied power/entry conditions to price/output incentives and possible inefficiency, uses the given comparison correctly and limits conclusions under binding constraints instead of merely naming monopoly."
          }
        ],
        "coverageExpectations": {
          "requiredExpectationIds": [
            "power-output-mechanism"
          ],
          "alternativeExpectationGroups": [],
          "minimumIndependentDemonstrations": 2,
          "freshVariationRequired": true,
          "independentTransferRequired": true
        },
        "variationAxes": [
          {
            "id": "private-incentive",
            "textDe": "Gegebene profitable Mengenbeschränkung versus Wettbewerbsreferenz.",
            "textEn": "Given profitable output restriction versus competitive reference."
          },
          {
            "id": "binding-constraint",
            "textDe": "Wirksame Preis-/Leistungsvorgabe verändert den Anreizspielraum bei weiter gesperrtem Eintritt.",
            "textEn": "An enforced price/service rule changes incentive scope despite blocked entry."
          }
        ],
        "applicationCaseBriefs": [
          {
            "id": "protected-supplier-price-output",
            "taskDemandDe": "Fiktiver Anbieter mit tatsächlicher Marktmacht: Kundschaft hat keine wirksame Ausweichmöglichkeit, Eintritt ist gesperrt. Bei gleicher Technik und Stückkosten20 sind nur folgende Unterrichtsoptionen gegeben: Preis40/Menge60/Gewinn1.200; Preis60/Menge40/Gewinn1.600; Preis80/Menge10/Gewinn600. Gewinnmaximierung unter diesen Optionen wird angenommen. Der vorgegebene Vergleich unter wirksamer Konkurrenz lautet Preis20/Menge100; zusätzliche Geschäfte oberhalb Menge40 können für Käufer und Anbieter bei diesen Kosten vorteilhaft sein. Erkläre die gewählte Option, den Preis-/Mengenunterschied und den möglichen Ineffizienzmechanismus. Begrenze die Aussage auf die gegebenen Optionen statt ein allgemeines Optimum oder einen genauen Wohlfahrtsverlust zu behaupten.",
            "taskDemandEn": "Fictional supplier with actual market power: customers lack effective alternatives and entry is blocked. With identical technology and unit cost20, the supplied teaching options are price40/quantity60/profit1,200; price60/quantity40/profit1,600; price80/quantity10/profit600. Assume profit maximisation among these options. Stipulated effective competition yields price20/quantity100; extra trades beyond quantity40can benefit buyers and seller at these costs. Explain the choice, price/output difference and potential inefficiency, without asserting a general optimum or exact welfare loss.",
            "expectedPerformanceDe": "Unter den drei angebotenen Optionen ist1.600 der höchste Gewinn, also60/40. Gegenüber20/100 liegt der Preis höher und die Menge niedriger. Ohne Ausweichen und Eintritt kann der Anbieter eine für seinen Gewinn günstige Beschränkung halten; nach Material können dadurch weitere vorteilhafte Geschäfte ausbleiben. Die Erklärung hängt an tatsächlicher Macht und der Eintrittssperre, nicht an der Firmenzahl allein. Die Tabelle erlaubt nur einen begrenzten Optionsvergleich und keine genaue Wohlfahrtsrechnung oder Aussage über ungenannte Preise.",
            "expectedPerformanceEn": "Profit1,600is highest among the three options, so the stipulated choice is60/40. Relative to20/100, price is higher and output lower. Absent alternatives and entry lets the supplier sustain a privately profitable restriction that can forgo beneficial trades under the supplied material. Actual power and blocked entry, not firm count alone, explain it. The table supports only a bounded choice comparison, not exact welfare calculation or conclusions about unlisted prices.",
            "understandingFocusDe": "Marktmacht führt über konkrete private Anreize zu möglicher Mengenbeschränkung.",
            "understandingFocusEn": "Market power acts through concrete private incentives to allow output restriction."
          },
          {
            "id": "licensed-ferry-binding-service-rule",
            "taskDemandDe": "Fiktive Fähre: Es gibt nur einen Betreiber, keine wirksame Ausweichroute, und neue Betreiber dürfen nicht eintreten. Stückkosten sind5 EUR; Kapazität50 Fahrten. Die vorgegebenen Möglichkeiten ohne bindende Regel sind Preis10/Menge30/Gewinn150 oder Preis5/Menge50/Gewinn0. Eine tatsächlich durchgesetzte Lizenz verlangt nun Preis5 und Bedienung aller50 gegebenen Fahrten; Kosten werden damit gedeckt. Erkläre erst den unregulierten Preis-/Mengenanreiz und dann, warum im geregelten Fall aus einem einzigen Anbieter und gesperrtem Eintritt nicht automatisch die gleiche Mengenbeschränkung folgt. Vergleiche mit der vorgegebenen Wettbewerbsreferenz5/50; bewerte keine zusätzlichen politischen Maßnahmen.",
            "taskDemandEn": "Fictional ferry: one operator has no effective substitute route and new operators cannot enter. Unit cost isEUR5and capacity50trips. Supplied unregulated options are price10/quantity30/profit150or price5/quantity50/profit0. An actually enforced licence now requires price5and serving all50stated trips, covering costs. Explain the unregulated price/output incentive and why one supplier plus blocked entry does not automatically imply the same restriction under the binding rule. Compare with the stipulated competitive reference5/50; do not assess additional policies.",
            "expectedPerformanceDe": "Ohne Regel wäre unter den beiden Optionen10/30 mit150 Gewinn attraktiver als5/50 mit0; das zeigt den möglichen Macht-/Mengenanreiz. Die durchgesetzte Lizenz schließt diese Wahl aber aus und verlangt5/50 bei ausreichender Kapazität und Kostendeckung. Im gegebenen Fall liegt deshalb dieselbe Preis-/Mengenversorgung wie in der Wettbewerbsreferenz vor; eine tatsächliche monopolistische Mengenbeschränkung ist daraus nicht belegt. Marktmachtpotenzial, bindende Regel und beobachtete Versorgung sind getrennt. Das Beispiel beweist weder, dass jede Lizenz wirksam wäre, noch dass ein einzelner Anbieter stets ineffizient oder stets gut sei.",
            "expectedPerformanceEn": "Without the rule,10/30with profit150is preferable to5/50with profit0among the given choices, showing the possible power/output incentive. The enforced licence removes that choice and requires5/50with sufficient capacity and covered costs. The supplied outcome therefore matches the competitive price/output reference; actual monopoly restriction is not demonstrated in this case. Potential power, binding constraints and delivered service must be distinguished. This establishes neither that every licence works nor that one supplier is always inefficient or always beneficial.",
            "understandingFocusDe": "Geänderte bindende Regel variiert die entscheidende Bedingung bei weiterhin nur einem Anbieter.",
            "understandingFocusEn": "A changed binding constraint varies the decisive condition while there is still one supplier."
          }
        ]
      }
    },
    {
      "goalId": "a2fa1186-df35-5954-a9a9-e311a55e218f",
      "reason": "DE: Eigener ausdrücklich inaktiver Profilkandidat für genau den vorgeschlagenen Einzelmechanismus, mit zwei vollständig ausformulierten unterschiedlichen fiktiven Fällen. Die Erwartungen sind Autorenmaterial, keine beobachtete Lernendenleistung, unabhängige Freigabe oder menschliche Zustimmung. EN: Own explicitly inert candidate for this proposed single mechanism, with two fully written distinct fictional cases. Expectations are author material, not observed learner work, independent approval or human assent.",
      "evidenceLevel": "E1",

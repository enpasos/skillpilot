{
  "role": "Local explicitly bounded structural schemas only; not source science, publication acceptance or official authoring schema",
  "sourceExtraction": {
    "type": "object",
    "required": [
      "schemaVersion",
      "extractionId",
      "sourceLandscapeId",
      "jurisdiction",
      "subject",
      "stage",
      "sourceDocument",
      "passages",
      "sourceGoals"
    ],
    "properties": {
      "sourceGoals": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "passageId",
            "title",
            "description",
            "sourceText",
            "tags"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "passageId": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "sourceText": {
              "type": "string",
              "minLength": 1
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "passages": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "topicCode",
            "title",
            "sourceGoalIds"
          ],
          "properties": {
            "sourceGoalIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      },
      "sourceDocument": {
        "type": "object",
        "required": [
          "key",
          "path",
          "official"
        ]
      }
    }
  },
  "mapping": {
    "type": "object",
    "required": [
      "version",
      "reviewId",
      "sourceLandscapeId",
      "targetLandscapeId",
      "sourceExtractionPath",
      "status",
      "mappings",
      "decisions"
    ],
    "properties": {
      "mappings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "legacyGoalId",
            "canonicalGoalId",
            "matchType",
            "reviewDecisionId"
          ],
          "properties": {
            "matchType": {
              "enum": [
                "exact",
                "partial"
              ]
            }
          }
        }
      },
      "decisions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "sourceGoalId",
            "decision",
            "canonicalGoalIds",
            "rationale",
            "reviewedAt",
            "reviewer"
          ],
          "properties": {
            "canonicalGoalIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}

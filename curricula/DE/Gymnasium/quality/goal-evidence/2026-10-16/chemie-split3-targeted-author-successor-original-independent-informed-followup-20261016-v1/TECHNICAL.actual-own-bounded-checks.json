        {
          "id": "energy20-18-b-split-current-r4-transfer",
          "points": 2,
          "criterionDe": "Verzweigter Alkylrest statt linearer C12-Kette: veränderte enzymatische Zugänglichkeit begründen; weder identischen Weg noch Geschwindigkeit oder Mineralisierung ungeprüft übertragen und passende Produkt-/C-Daten verlangen.",
          "criterionEn": "Branched tail replacing the linear C12 chain: explain changed enzymatic accessibility; do not transfer an identical route, rate or mineralisation without evidence, and identify suitable product/carbon data.",
          "requiredForIndependentTransfer": true
        }
      ],
      "designStatus": "designed_not_learner_observed"
    },

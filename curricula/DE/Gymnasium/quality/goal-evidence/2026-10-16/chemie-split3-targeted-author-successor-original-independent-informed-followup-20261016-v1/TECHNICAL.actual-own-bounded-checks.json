      "maximumPoints": 8,
      "pointSum": 8,
      "explicitTransferCriteria": [
        {
          "id": "energy20-18-c-split-current-r4-transfer",
          "points": 2,
          "criterionDe": "Al-Variation: Weniger Gerüst-Al bedeutet im gegebenen Substitutionsmodell weniger feste negative Ladung und weniger austauschbare Gegenionen. Gleiche Porengröße garantiert keine gleiche Kapazität; Zugänglichkeit und Selektivität bleiben Grenzen.",
          "criterionEn": "Al variation: less framework Al means less fixed negative charge and fewer exchangeable counterions in the supplied substitution model. Equal pores do not guarantee equal capacity; accessibility and selectivity remain limits.",
          "requiredForIndependentTransfer": true
        }
      ],
      "designStatus": "designed_not_learner_observed"
    },
    {
      "caseId": "energy20-18-b-split-current",

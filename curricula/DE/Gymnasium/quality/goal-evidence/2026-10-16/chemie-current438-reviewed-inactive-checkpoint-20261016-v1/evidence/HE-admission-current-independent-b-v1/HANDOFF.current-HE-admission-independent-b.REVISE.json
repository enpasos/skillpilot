  "findings": [
    {
      "id": "HE-GK-RECYCLING-WHOLE",
      "goalId": "8721d943-8368-5304-bd3c-7d7944099662",
      "affectedPrimaries": [
        "14577339-9e0c-5b44-8e47-91e1a4947367"
      ],
      "course": "GK",
      "sourcePage": 43,
      "decision": "REVISE",
      "reason": "Both actual complete cases require independently explaining PET ester hydrolysis and PET/PE cycles, not only interpreting a supplied number. HE43 common is monomer/feedstock and remelting eco/economic recycling; hydrolysis of polycondensates and PE material cycles are LK additions. Computations40/80=.50,100/75=1.333 and35*.8+50*.9=73kg are correct, but correctness does not establish common scope. Keep common recycling duty via a bounded genuine common carrier; no dropping all recycling or weakening the full LK whole. Existing historical954b/e6cb direct reentries must follow the actual carrier interface too."
    },
    {
      "id": "HE-GK-SECOND-LAW",
      "goalId": "dc5173e8-6e63-58d3-a79b-bd74ef3cb98b",
      "affectedPrimaries": [
        "14577339-9e0c-5b44-8e47-91e1a4947367"
      ],
      "course": "GK",
      "sourcePages": [
        49,
        50
      ],
      "decision": "REVISE",
      "reason": "Still a direct primary155 prerequisite and actual target in both GK views. Current whole P requires second-law/Kelvin-Planck judgement, reservoir entropy and reversible gas-expansion entropy, not merely energy conservation or supplied efficiency comparison. First-law common HE49 cannot justify this whole; HE50 assigns second-law/entropy to LK. Retain common internal-energy/enthalpy/calorimetry and actual foreign/full LK competence; repair HE GK role and direct admission only."
    },
    {
      "id": "HE-GK-NINHYDRIN-ACQUISITION",
      "goalId": "5c8f0bbb-103a-579f-87fc-c997afe4fd18",
      "affectedPrimaries": [
        "14577339-9e0c-5b44-8e47-91e1a4947367"
      ],
      "affectedMemory": "428b4d9c-f6e6-548f-b9da-336466ddb62e",
      "course": "GK",
      "sourcePage": 42,
      "decision": "REVISE",
      "reason": "Whole selected ordinary P expressly requires actual supervised Ninhydrin AND Biuret execution, including Ninhydrin paper/heat procedure as an essential execution expectation. It is not a supplied passive unusual-colour task. HE42 common asks protein Biuret, but Ninhydrin belongs to LK amino-acid chromatography. It remains target in both GK views and a direct155 admission; new428 inherits this whole prerequisite. Preserve common protein/Biuret duty and narrow card004 using a genuine common acquisition carrier; retain whole5c8 for its appropriate LK/other-source scope."
    },
    {
      "id": "HE-LK-PARABEN-QUANTITATIVE",
      "goalId": "18819a59-2442-530f-a7c3-26755398ec66",
      "affectedPrimaries": [

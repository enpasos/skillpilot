  "wholeUnderstandingProfileBody": {
    "archetype": "data",
    "expectations": [
      {
        "id": "b002-41396457-core",
        "essentialUnderstandingDe": "Bei nukleophiler Substitution kann eine abgehende Halogenidion-Spezies mit Silberionen einen charakteristischen Niederschlag bilden; der Befund ist an die Probe und Störionen gebunden.",
        "essentialUnderstandingEn": "In nucleophilic substitution, a released halide ion may form a characteristic precipitate with silver ions; the result depends on the sample and interfering ions.",
        "observablePerformanceDe": "Die lernende Person deutet für eine bereitgestellte Reaktionslösung einen passenden Silbernitratbefund und verbindet das Halogenidion mit der Abgangsgruppe.",
        "observablePerformanceEn": "The learner interprets a supplied silver-nitrate result for a reaction solution and links the halide ion to the leaving group."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "b002-41396457-core"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "halide",
        "textDe": "Bromid- und Chloridion liefern unterschiedliche Silberhalogenidbefunde.",
        "textEn": "Bromide and chloride give different silver-halide observations."
      },
      {
        "id": "control",
        "textDe": "Eine Blindprobe prüft bereits vorhandenes Halogenid.",
        "textEn": "A blank control checks pre-existing halide."
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "bromoethane-product-test",
        "taskDemandDe": "Nach einer vorgegebenen nukleophilen Substitution von Bromethan zeigt die wässrige Produktlösung mit Silbernitrat einen hellgelben Niederschlag. Deute dessen Bezug zur Abgangsgruppe.",
        "taskDemandEn": "After a supplied nucleophilic substitution of bromoethane, the aqueous product solution gives a pale-yellow precipitate with silver nitrate. Interpret its relation to the leaving group.",
        "expectedPerformanceDe": "Die lernende Person deutet den Befund als Hinweis auf Bromidionen und verbindet Br− mit der C-Br-Spaltung, ohne daraus allein die vollständige organische Produktstruktur abzuleiten.",
        "expectedPerformanceEn": "The learner interprets the result as evidence of bromide and links Br− to C-Br cleavage without deriving the full organic product structure from the precipitate alone.",
        "understandingFocusDe": "Der Nachweis stützt eine Teilbehauptung über die Substitution.",
        "understandingFocusEn": "The test supports a bounded claim about substitution."
      },
      {
        "id": "fresh-chloride-control",
        "taskDemandDe": "In einem neuen Chlorethan-Fall enthält schon die Ausgangsprobe Chlorid; nach Reaktion entsteht ebenfalls ein weißer Silbernitratniederschlag. Welche zusätzliche Vergleichsprobe ist für den Reaktionsschluss nötig?",
        "taskDemandEn": "In a fresh chloroethane case, the starting sample already contains chloride; a white silver-nitrate precipitate also appears after reaction. Which extra comparison is needed to infer reaction?",
        "expectedPerformanceDe": "Die lernende Person fordert eine geeignete Blind- oder Vorherprobe und erklärt, dass der weiße Niederschlag allein keine neu freigesetzten Cl−-Ionen beweist.",
        "expectedPerformanceEn": "The learner asks for a suitable blank or before sample and explains that the white precipitate alone does not prove newly released Cl−.",
        "understandingFocusDe": "Kontrolle trennt Nachweis von unzulässiger Kausalbehauptung.",
        "understandingFocusEn": "A control separates detection from an unsupported causal claim."
      }
    ]
  },

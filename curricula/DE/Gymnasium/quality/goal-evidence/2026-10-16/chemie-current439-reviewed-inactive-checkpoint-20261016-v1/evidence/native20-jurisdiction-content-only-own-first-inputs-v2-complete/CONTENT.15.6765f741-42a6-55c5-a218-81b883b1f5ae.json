  "wholeUnderstandingProfileBody": {
    "archetype": "experiment",
    "expectations": [
      {
        "id": "perform-saponification",
        "essentialUnderstandingDe": "Fett besitzt drei Esterbindungen am Glycerin. Alkalische Hydrolyse liefert Glycerin und Fettsäuresalze; Herstellung verlangt passende Durchführung und Beobachtung.",
        "essentialUnderstandingEn": "Fat has three ester bonds on glycerol. Alkaline hydrolysis yields glycerol and fatty-acid salts; preparation requires suitable execution and observation.",
        "observablePerformanceDe": "Eine zugelassene betreute Versuchsvorschrift eigenständig sachgerecht ausführen, Arbeitsschritte/Beobachtungen dokumentieren und Produkte über Esterstruktur/Bilanz erklären.",
        "observablePerformanceEn": "Independently carry out an approved supervised protocol, document steps/observations and explain products using ester structure and balance."
      },
      {
        "id": "salt-out-separate",
        "essentialUnderstandingDe": "Zugabe von geeignetem Salz kann Seife aus der wässrigen Phase aussalzen. Glycerin und gelöste Stoffe werden dadurch nicht automatisch ebenfalls zu festen Seifenprodukten.",
        "essentialUnderstandingEn": "Adding a suitable salt can salt soap out of the aqueous phase. Glycerol and dissolved substances do not thereby automatically become solid soap products.",
        "observablePerformanceDe": "Aussalzen und Trennung im betreuten Versuch durchführen und den Verbleib der Phasen/Stoffe anhand eigener Beobachtungen begründen.",
        "observablePerformanceEn": "Perform salting-out and separation in a supervised experiment and justify phase/substance locations from actual observations."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "perform-saponification",
        "salt-out-separate"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "changed-chemical-case",
        "textDe": "Vorgegebene Fette/Protokolle und kontrollierter Salzvergleich; reale Durchführung bleibt zukünftiges Leistungsmerkmal, vorgelegte Logs allein beweisen sie nicht.",
        "textEn": "Supplied fats/protocols and controlled salt comparison; actual execution remains a future performance requirement, not proved by supplied logs alone."
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "supervised-triolein",
        "taskDemandDe": "Führe unter Aufsicht eine freigegebene Seifenherstellung aus vorgegebenem Triolein/NaOH mit anschließendem Aussalzen aus; keine selbst festgelegten Gefahrstoffmengen. Dokumentiere Handgriffe, Phasentrennung und erkläre die Produkte.",
        "taskDemandEn": "Under supervision perform an approved soap preparation from supplied triolein/NaOH followed by salting-out; no self-prescribed hazardous amounts. Document actions, phase separation and explain products.",
        "expectedPerformanceDe": "Zukünftige Leistungsbelege umfassen sachgerechte eigene Durchführung und Beobachtung, nicht nur Protokollnacherzählung. Triolein +3NaOH →Glycerin +3Natriumoleat; Esterbindungen werden gespalten. Ausgesalzene Seife getrennt, Glycerin überwiegend wässrig; fehlende Trennung wird nicht als Erfolg behauptet.",
        "expectedPerformanceEn": "Future evidence includes correct actual execution/observation, not merely retelling a protocol. Triolein +3NaOH →glycerol +3sodium oleate; ester bonds cleave. Salted-out soap is separated, glycerol mainly aqueous; failed separation is not claimed successful.",
        "understandingFocusDe": "Eigene betreute Herstellung und Stoffschluss.",
        "understandingFocusEn": "Actual supervised preparation and inference."
      },
      {
        "id": "tristearin-salt-control",
        "taskDemandDe": "Eine frische freigegebene Aufgabe verwendet Tristearin und vergleicht nach gleicher Hydrolyse Ansätze mit/ohne Salzzugabe. Führe die erlaubten Trennschritte betreut aus; begründe, warum Salzzugabe nicht selbst Fett zu Seife umsetzt.",
        "taskDemandEn": "A fresh approved task uses tristearin and compares batches after identical hydrolysis with/without salt addition. Perform permitted separation steps under supervision; explain why salt addition itself does not turn fat into soap.",
        "expectedPerformanceDe": "Tristearin +3NaOH →Glycerin +3Natriumstearat. Der kontrollierte Salzvergleich betrifft Löslichkeit/Trennung bereits gebildeter Seife, nicht eine neue Fettspaltung. Eigene Handgriffe und Phasenbeobachtungen tragen den Durchführungsbeleg; ein Datensatz allein erfüllt den praktischen Operator nicht.",
        "expectedPerformanceEn": "Tristearin +3NaOH →glycerol +3sodium stearate. Controlled salt comparison concerns solubility/separation of existing soap, not new fat cleavage. Actual actions and phase observations evidence execution; a dataset alone does not satisfy the practical operator.",
        "understandingFocusDe": "Anderes Fett und Trennkontrolle.",
        "understandingFocusEn": "Different fat and separation control."
      }
    ]
  },

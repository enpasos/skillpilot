  "wholeUnderstandingProfileBody": {
    "archetype": "representation",
    "expectations": [
      {
        "id": "b002-bd36dc58-core",
        "essentialUnderstandingDe": "Di- und Tricarbonsäuren besitzen zwei beziehungsweise drei Carboxylgruppen in einem Molekül; die Gruppen müssen in der Struktur an unterschiedliche geeignete Bindungsstellen gesetzt werden.",
        "essentialUnderstandingEn": "Di- and tricarboxylic acids carry two or three carboxyl groups in one molecule; the groups must be placed at chemically valid positions in the structure.",
        "observablePerformanceDe": "Die lernende Person erkennt die Anzahl der Carboxylgruppen in gegebenen Strukturformeln und zeichnet ein valenzrichtiges Beispiel beider Klassen.",
        "observablePerformanceEn": "The learner counts carboxyl groups in supplied structures and draws a valence-correct example of both classes."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "b002-bd36dc58-core"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "group-count",
        "textDe": "Zwei und drei Carboxylgruppen werden kontrastiert.",
        "textEn": "Two and three carboxyl groups are contrasted."
      },
      {
        "id": "skeleton",
        "textDe": "Gerade und verzweigte Gerüste werden variiert.",
        "textEn": "Straight and branched skeletons are varied."
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "oxalic-citric-structures",
        "taskDemandDe": "Gegeben sind HOOC-COOH und eine Struktur von Citronensäure mit drei -COOH-Gruppen. Ordne Di- und Tricarbonsäure zu und markiere alle Gruppen.",
        "taskDemandEn": "HOOC-COOH and a citric-acid structure bearing three -COOH groups are supplied. Classify di- and tricarboxylic acid and mark all groups.",
        "expectedPerformanceDe": "Die lernende Person zählt zwei beziehungsweise drei vollständige Carboxylgruppen und unterscheidet eine Hydroxygruppe von einer weiteren Carboxylgruppe.",
        "expectedPerformanceEn": "The learner counts two versus three complete carboxyl groups and distinguishes a hydroxyl group from an extra carboxyl group.",
        "understandingFocusDe": "Die Gruppe, nicht die Zahl aller O-Atome, bestimmt die Klasse.",
        "understandingFocusEn": "The functional group, not the total oxygen count, determines the class."
      },
      {
        "id": "fresh-tartaric-acid",
        "taskDemandDe": "Eine neue Struktur zeigt HOOC-CH(OH)-CH(OH)-COOH. Zeichne die Bindungen valenzrichtig und entscheide, ob zwei OH-Seitengruppen die Säure tricarboxylisch machen.",
        "taskDemandEn": "A fresh structure shows HOOC-CH(OH)-CH(OH)-COOH. Draw correct valences and decide whether two OH substituents make the acid tricarboxylic.",
        "expectedPerformanceDe": "Die lernende Person zeichnet die Verbindung korrekt und ordnet sie als Dicarbonsäure mit zwei zusätzlichen Hydroxygruppen ein.",
        "expectedPerformanceEn": "The learner draws valid bonds and classifies it as a dicarboxylic acid with two additional hydroxyl groups.",
        "understandingFocusDe": "Ein neues Molekül prüft funktionelle Gruppengrenzen.",
        "understandingFocusEn": "A new molecule tests functional-group boundaries."
      }
    ]
  },

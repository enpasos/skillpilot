{"schemaVersion":1,"reviewId":"canonical-chemistry-full","ruleVersion":"memory-card-review-v1","landscapeId":"c436b994-8f44-5134-b9f8-0c9f5d6a5ba0","goalId":"cc5a626a-dc85-57e2-b422-259f92901545","status":"memory_required","memoryUseful":true,"memoryGoalIds":["e3e8582a-976b-5f0f-b31b-3cf59a4fff24","98781dda-8049-5173-899b-42a5c2902b86","21066929-2b7f-5d31-924b-338677053238"],"deckIds":["de_gymnasium_chemistry_organic_q1"],"reviewedAt":"2026-10-16T09:24:51.665938+00:00","reviewer":"/root/chemie_native15_fresh_independent_b_20261016","reason":"Funktionelle Gruppen sind erlernte Grundlage. Die zusätzliche Unterscheidung Primärabbau/Zwischenprodukt/Mineralisierung ist kompakter notwendiger Begriffsabruf; Reaktionsfolge, Kettenverkürzung und Stoffbilanz bleiben Verständnis. Eine eigene schmale Definitionsroute ist begründet. Ihre aktuelle Kartenformulierung bleibt wegen MEMORY6-PRIMARY-01 offen; Energieformeln6122 ersetzen sie nicht.","fingerprint":"sha256:4c6908fc490ef2d85fc94f593d2cbd8442ecc92f3fa236dabc9b1580631e818b","originalForeignFirstStatusBeforeTargetedCorrection":"needs_developer_review","targetedDefinitionConditionResolvedByForeignInformed":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-primary-definition-original-independent-b-informed-followup-20261016-v1/FIRST.informed-primary-definition.one-card.science.json","sha256":"sha256:9c2e3ee783ca21dc6df678baaf6fb1f1928af942b8bd627cd94587e78e60a3fa","bytes":4876},"scientificDecisionSource":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-memory6-independent-b-bounded-science-20261016-v1/FIRST.Memory6.independent-B.science.json","sha256":"sha256:7b10778605f7aea54410134872e1015e9f3fa45eac8c8482355e784de8975899","bytes":18887},"scientificDecisionPath":"/ordinaryMemorySuitabilityReviews/1","currentIndependentScopeAndDefinitionSelector":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-primary-definition-original-independent-b-inf
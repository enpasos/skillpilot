{"schemaVersion":1,"reviewId":"canonical-chemistry-full","ruleVersion":"memory-card-review-v1","landscapeId":"c436b994-8f44-5134-b9f8-0c9f5d6a5ba0","goalId":"4d9defde-d3bc-5c43-83ff-9cf6f2930643","status":"memory_required","memoryUseful":true,"memoryGoalIds":["e3e8582a-976b-5f0f-b31b-3cf59a4fff24","98781dda-8049-5173-899b-42a5c2902b86"],"deckIds":["de_gymnasium_chemistry_organic_q1"],"reviewedAt":"2026-10-16T09:24:51.665938+00:00","reviewer":"/root/chemie_native15_fresh_independent_b_20261016","reason":"Alkohol-, Carbonsäure- und Estergruppen sind kompakter Abruf für die Umesterung. Drei Esterstellen erklären die Stoffmengenrelation; Reaktionsplanung und Systembewertung bleiben normale Fachleistung. Die konkrete Karte enthält keine Carboxylatzeile: diese wird hier ausdrücklich nicht als Karteninhalt oder fehlende neue Merkkarte behauptet, sondern über vorhandenes Säure-Base-/Reaktionsverständnis vorausgesetzt.","fingerprint":"sha256:9831c27e85efbb8597f810154e74b6c2f71d07dad9ae5bdf3f55243a3ca25674","originalForeignFirstStatusBeforeTargetedCorrection":"memory_required","scientificDecisionSource":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-memory6-independent-b-bounded-science-20261016-v1/FIRST.Memory6.independent-B.science.json","sha256":"sha256:7b10778605f7aea54410134872e1015e9f3fa45eac8c8482355e784de8975899","bytes":18887},"scientificDecisionPath":"/ordinaryMemorySuitabilityReviews/3","currentIndependentScopeAndDefinitionSelector":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-primary-definition-original-independent-b-informed-followup-20261016-v1/OUTPUTS.finite-Memory6-B-142-bindings-and-targeted-informed-definition.selector.json","sha256":"sha256:7c0116a82a54e01c9e05d9ea7f78b0364bff87d4530ec3fd21d4fc46935d7b8b","bytes":5861},"actualCurrent593RoleAndCardBindingProof":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-current593-source2-memory77-inactive-composition-technical-20261016-v1/CHECK.actual593-stock-ordered-roles142-card-bindings-and-old75-retention.json","sha256":"sha256:c36589b2e6b615a73458f29cdaf47e9c3e2bb21c88bbb1b9bea1313fc3212c33","bytes":79958},"technicalSerializer":"/root/chemie_methods4_fresh_science_20261016","serializerIsAuthorOfMemoryDesign":true,"serializerIssuedNewIndependentScience":false}
{"schemaVersion":1,"reviewId":"canonical-chemistry-full","ruleVersion":"memory-card-review-v1","landscapeId":"c436b994-8f44-5134-b9f8-0c9f5d6a5ba0","goalId":"4955f745-b946-5d3d-82d6-5e52dc8549a3","status":"memory_required","memoryUseful":true,"memoryGoalIds":["e3e8582a-976b-5f0f-b31b-3cf59a4fff24","be8d0aa1-b3b5-55ca-bfc1-3b3ff3744b1b"],"deckIds":["de_gymnasium_chemistry_organic_q1"],"reviewedAt":"2026-10-16T09:24:51.665938+00:00","reviewer":"/root/chemie_native15_fresh_independent_b_20261016","reason":"Die vorhandene Konfigurations-/Konformationskarte liefert eine notwendige knappe Unterscheidung: Kettenbeweglichkeit erfordert keine konstitutive Neuverknüpfung. Monomer, Polymerisation, Vernetzung und Elastizitätsänderung müssen erklärt werden; weder Rezeptur, Schwefelmenge noch Tg werden als neue feste Abrufliste verlangt.","fingerprint":"sha256:49377d66dec942000589e009ec66bc98b082d3d5f9fe491a37d6fef26ddbfe84","originalForeignFirstStatusBeforeTargetedCorrection":"memory_required","scientificDecisionSource":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-memory6-independent-b-bounded-science-20261016-v1/FIRST.Memory6.independent-B.science.json","sha256":"sha256:7b10778605f7aea54410134872e1015e9f3fa45eac8c8482355e784de8975899","bytes":18887},"scientificDecisionPath":"/ordinaryMemorySuitabilityReviews/4","currentIndependentScopeAndDefinitionSelector":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-primary-definition-original-independent-b-informed-followup-20261016-v1/OUTPUTS.finite-Memory6-B-142-bindings-and-targeted-informed-definition.selector.json","sha256":"sha256:7c0116a82a54e01c9e05d9ea7f78b0364bff87d4530ec3fd21d4fc46935d7b8b","bytes":5861},"actualCurrent593RoleAndCardBindingProof":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-current593-source2-memory77-inactive-composition-technical-20261016-v1/CHECK.actual593-stock-ordered-roles142-card-bindings-and-old75-retention.json","sha256":"sha256:c36589b2e6b615a73458f29cdaf47e9c3e2bb21c88bbb1b9bea1313fc3212c33","bytes":79958},"technicalSerializer":"/root/chemie_methods4_fresh_science_20261016","serializerIsAuthorOfMemoryDesign":true,"serializerIssuedNewIndependentScience":false}
{"schemaVersion":1,"reviewId":"canonical-chemistry-full","ruleVersion":"memory-card-review-v1","landscapeId":"c436b994-8f44-5134-b9f8-0c9f5d6a5ba0","goalId":"f57d53b0-5bdf-5998-81f4-8bfb2fc5bde7","status":"memory_required","memoryUseful":true,"memoryGoalIds":["e3e8582a-976b-5f0f-b31b-3cf59a4fff24","98781dda-8049-5173-899b-42a5c2902b86","1e519951-9850-5a07-ac82-d9f0075e3d05","46ce8cc4-b639-5abd-9ef4-743e21888ab5","7513bc49-807b-5bae-9a8e-1587ac2340a5"],"deckIds":["de_gymnasium_chemistry_organic_q1","de_gymnasium_chemistry_bonding_structure","de_gymnasium_chemistry_natural_q2"],"reviewedAt":"2026-10-16T09:24:51.665938+00:00","reviewer":"/root/chemie_native15_fresh_independent_b_20261016","reason":"Gruppen und Wechselwirkungsnamen sind bereits erlernte Grundlagen. Viskose als regenerierte Cellulose gegenüber dauerhaft substituiertem Celluloseacetat ist zusätzliche kompakte Stoffidentität. Die neue Karte trennt Xanthat-Zwischenstufe vom Endprodukt korrekt. Erhaltenes Rückgrat bedeutet chemisches Grundmotiv, keine unveränderte Kettenlänge oder gleiche Eigenschaften. DS, Herstellungskonzept und Eigenschaftsfolgen bleiben Erklärung.","fingerprint":"sha256:2f2c36a2b974629262e0435fab4ef687fe6fb54509b7f48f68672bbbd8656dee","originalForeignFirstStatusBeforeTargetedCorrection":"memory_required","scientificDecisionSource":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-memory6-independent-b-bounded-science-20261016-v1/FIRST.Memory6.independent-B.science.json","sha256":"sha256:7b10778605f7aea54410134872e1015e9f3fa45eac8c8482355e784de8975899","bytes":18887},"scientificDecisionPath":"/ordinaryMemorySuitabilityReviews/5","currentIndependentScopeAndDefinitionSelector":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-primary-definition-original-independent-b-informed-followup-20261016-v1/OUTPUTS.finite-Memory6-B-142-bindings-and-targeted-informed-definition.selector.json","sha256":"sha256:7c0116a82a54e01c9e05d9ea7f78b0364bff87d4530ec3fd21d4fc46935d7b8b","bytes":5861},"actualCurrent593RoleAndCardBindingProof":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-current593-source2-memory77-inactive-composition-technical-20261016-v1/CHECK.actual593-stock-ordered-roles142-card-bindings-and-old75-retention.json","sha256":"sha256:c36589b2e6b615a73458f29cdaf47e9c3e2bb21c88bbb1b9bea1313fc3212c33","bytes":79958},"technicalSerializer":"/root/chemie_methods4_fresh_science_20261016","serializerIsAuthorOfMemoryDesign":true,"serializerIssuedNewIndependentScience":false}

{"schemaVersion":1,"reviewId":"canonical-chemistry-full","ruleVersion":"memory-card-review-v1","landscapeId":"c436b994-8f44-5134-b9f8-0c9f5d6a5ba0","goalId":"0959eef2-3c7d-5b33-a109-ddf332a5dbd9","status":"memory_required","memoryUseful":true,"memoryGoalIds":["e3e8582a-976b-5f0f-b31b-3cf59a4fff24","98781dda-8049-5173-899b-42a5c2902b86"],"deckIds":["de_gymnasium_chemistry_organic_q1"],"reviewedAt":"2026-10-16T09:24:51.665938+00:00","reviewer":"/root/chemie_native15_fresh_independent_b_20261016","reason":"Ester-/OH-/Carbonsäure-Kurzzeichen müssen für Triglyceridstrukturen verfügbar sein; die bestehende Gruppenkarte ist eine begrenzte gemeinsame Basis, kein neues Öl-Deck. Herkunft, Motorverträglichkeit und ökologische Folgen werden aus Struktur und Daten begründet, nicht memoriert.","fingerprint":"sha256:e4b4a679e6cd198cc4961984f7eacf797f4cffeb9ed79abdf70b66dd307ed65e","originalForeignFirstStatusBeforeTargetedCorrection":"memory_required","scientificDecisionSource":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-memory6-independent-b-bounded-science-20261016-v1/FIRST.Memory6.independent-B.science.json","sha256":"sha256:7b10778605f7aea54410134872e1015e9f3fa45eac8c8482355e784de8975899","bytes":18887},"scientificDecisionPath":"/ordinaryMemorySuitabilityReviews/2","currentIndependentScopeAndDefinitionSelector":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-split3-primary-definition-original-independent-b-informed-followup-20261016-v1/OUTPUTS.finite-Memory6-B-142-bindings-and-targeted-informed-definition.selector.json","sha256":"sha256:7c0116a82a54e01c9e05d9ea7f78b0364bff87d4530ec3fd21d4fc46935d7b8b","bytes":5861},"actualCurrent593RoleAndCardBindingProof":{"path":"curricula/DE/Gymnasium/quality/goal-evidence/2026-10-16/chemie-current593-source2-memory77-inactive-composition-technical-20261016-v1/CHECK.actual593-stock-ordered-roles142-card-bindings-and-old75-retention.json","sha256":"sha256:c36589b2e6b615a73458f29cdaf47
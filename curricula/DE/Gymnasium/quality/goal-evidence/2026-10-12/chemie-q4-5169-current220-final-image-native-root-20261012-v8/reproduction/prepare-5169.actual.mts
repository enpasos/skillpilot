import{readFileSync,writeFileSync,mkdirSync}from'node:fs';
import{resolve,dirname}from'node:path';
import{buildPositiveGoalEvidenceCandidateRecords}from'./scripts/materializePositiveGoalEvidenceCandidates.ts';
import{loadGoalBookBuildInputs,writeGoalBookModel}from'./scripts/goalBookModel.ts';
const R=resolve(import.meta.dirname,'..');
const b='curricula/DE/Gymnasium/quality/goal-evidence/2026-10-12/chemie-q4-eleven-current220-preserving-root-preparation-20261012-v5';
const n='curricula/DE/Gymnasium/quality/goal-evidence/2026-10-12/chemie-q4-5169-current220-final-image-native-root-20261012-v8';
const g='5169bb6b-f065-5798-8164-9b4521e44ae8';
const rd=(p:string)=>JSON.parse(readFileSync(resolve(R,p),'utf8'));
const wr=(p:string,d:any)=>{const f=resolve(R,p);mkdirSync(dirname(f),{recursive:true});writeFileSync(f,JSON.stringify(d,null,2)+'\n')};
const pc=rd(n+'/configs/P11.inactive.config.json');
mkdirSync(dirname(resolve(R,pc.reviewPath)),{recursive:true});
const records=await buildPositiveGoalEvidenceCandidateRecords({config:pc,candidateSet:rd(b+'/positive/P11.current-image-holds-resolved.author-input.json')});
const old=readFileSync(resolve(R,b+'/positive/P11.current-corrected-images.normal.review.jsonl'),'utf8').trim().split('\n');
const by=new Map(records.map(r=>[r.goalId,JSON.stringify(r)]));
const otherChanged=old.filter(l=>JSON.parse(l).goalId!==g&&l!==by.get(JSON.parse(l).goalId));
if(otherChanged.length)throw Error('Other10 P records changed unexpectedly');
writeFileSync(resolve(R,pc.reviewPath),old.map(l=>JSON.parse(l).goalId===g?by.get(g):l).join('\n')+'\n');
const p1={...pc,reviewPath:n+'/positive/P1.same-author-profile-new-image.exact.jsonl',scope:{...pc.scope,goalIds:[g]}};
wr(n+'/configs/P1.inactive.config.json',p1);writeFileSync(resolve(R,p1.reviewPath),by.get(g)+'\n');
const loaded=await loadGoalBookBuildInputs(n+'/configs/whole402.inactive.config.json',R);await writeGoalBookModel(loaded.model,loaded.outputPath);
const oldPages=rd(b+'/native/whole402.current-inputs.normal-model.json').pages;
const map=new Map(oldPages.map((p:any)=>[p.goalId,p.pageFingerprint]));
const changed=loaded.model.pages.filter((p:any)=>p.pageFingerprint!==map.get(p.goalId)).map(p=>p.goalId);
if(JSON.stringify(changed)!==JSON.stringify([g]))throw Error('Other pages changed: '+changed);
wr(n+'/checks/normal-P11-and-401-pages-exact.actual.json',{schemaVersion:1,role:'Normal materialization and exact comparison, not scientific review',other10PRawLinesExact:true,changedPageIds:changed,other401PageFingerprintsExact:true,current220PageFingerprintsExact:true,wholeModelDigest:loaded.model.digest,P11:records.length,activeWrites:false,strictGain:0});
console.log(JSON.stringify({P11:records.length,other10Pexact:true,onlyChangedPage:changed,digest:loaded.model.digest}));

{"schemaVersion":1,"bookId":"de-gym-biologie-ni-current-native-author-20261005-v2","bookDigest":"sha256:411ab2b4933568df82f754905770e70aa73145668bbcdf9554ef8183a869126b","page":{"pageNumber":5,"navigationOrder":4,"treeOrder":6,"goalId":"9e459608-bdea-55a1-b9c5-214bbd741be6","shortKey":"canonical_biology_nonmolecular_meiotic_chromatid_segment_exchange","anchor":"goal-9e459608-bdea-55a1-b9c5-214bbd741be6","title":"Abschnittsaustausch bei der Meiose erläutern","description":"Die lernende Person kann an vorgegebenen Meiose-Chromosomenmodellen erläutern, wie der Austausch entsprechender Abschnitte zwischen Nichtschwesterchromatiden homologer Chromosomen neue Kombinationen der Erbinformation in Keimzellen erzeugt.","breadcrumbs":["Biologie","Lebewesen ordnen, Verwandtschaft und Variabilität erklären"],"chapterIds":["structure:canonical-goal-e8d54127-d42e-51f5-bfa5-51d826069f95","structure:canonical-goal-9cd0dbbc-9507-5879-8c4f-df54529969ec"],"applicability":[{"jurisdiction":"DE-NI","scopes":[{"stage":"SekI","durationModel":"G9","courseProfile":null}]}],"requires":[],"reverseRequires":[{"goalId":"3d6b2504-346e-521f-8372-7269ec3a7091","title":"Variabilitätsvorteil geschlechtlicher Fortpflanzung erläutern","anchor":"goal-3d6b2504-346e-521f-8372-7269ec3a7091","pageNumber":13},{"goalId":"3417bb28-e707-57fc-8484-311d4966e26a","title":"Variabilität durch Mutation und Rekombination erklären","anchor":"goal-3417bb28-e707-57fc-8484-311d4966e26a","pageNumber":16}],"externalPrerequisites":[{"goalId":"b1dff57f-329e-5264-b2b9-2db71a0b2172","title":"Pflanzen- und Tierzellen vergleichen","canonicalUrl":"https://skillpilot.com/lernzielbuch?landscape=08a43a1b-d97e-522c-9dfa-c950a493364e&edition=curricular-atomic-v1#goal-b1dff57f-329e-5264-b2b9-2db71a0b2172"}],"externalReverseRequires":[],"visualization":{"resourceType":"image","title":"Visualisierung: Abschnittsaustausch bei der Meiose erläutern","url":"/assets/goal-visualizations/biologie/9e459608-bdea-55a1-b9c5-214bbd741be6/9e459608-bdea
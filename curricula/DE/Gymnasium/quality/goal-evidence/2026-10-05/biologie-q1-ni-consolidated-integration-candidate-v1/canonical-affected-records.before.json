            "sourceLandscapeTitle": "Biologie Oberstufe (Hessen, KC 2024)",
            "sourceGoalId": "4250b207-39bb-4316-a483-edd2295ce74f"
          }
        },
        "examData": {
          "reviewStatus": "released",
          "coveredGoalIds": [
            "475eebb4-4eb0-524f-b1ec-4a672bf856d2",
            "946ce2e7-c30d-5670-839d-003b0619c284",
            "7f76ff0b-218b-568d-91df-20bbe2b156e2"
          ],
          "coveredStrands": [

  "descriptionRevisions": [
    {
      "goalId": "98ae3f8e-4800-5ff3-bd2c-89434c006143",
      "recordId": "chemie455-final16-native-description-b-20261019-v1.goal-09",
      "reason": "D: „den Mechanismus von Kondensationsreaktionen“ benennt weder den gemeinten Acylmechanismus noch dessen notwendige unterschiedlichen Bedingungen und kann einen universellen Kondensationsmechanismus nahelegen. Die lokale Präzisierung nennt die bereits im Ziel beanspruchte mechanistische Erklärung; sie ergänzt keine Herstellungspflicht."
    },
    {
      "goalId": "9d97f628-c3ea-5dc0-8723-b17b16297af3",
      "recordId": "chemie455-final16-native-description-b-20261019-v1.goal-10",
      "reason": "D: Der aktuelle Text bleibt beim Aufgabennamen und lässt den chemischen Resttausch sowie den Gegenstand der Gleichgewichtsbeurteilung offen. Die knappe Präzisierung macht diese bereits beanspruchte Beziehung sichtbar. P-Befund P-B03: Das K=1-Modell ist rechnerisch stimmig (0,5 bzw.0,8 mol aus 1 mol Ester). Im frischen Triglyceridfall werden Abtrennungs- und Nebenreaktionsdaten angekündigt, aber weder konkret genannt noch gebunden. Ein begründeter Vergleich realer Planalternativen braucht diese Angaben; das allgemeine Schema allein belegt diesen Transfer nicht."
    },
    {
      "goalId": "2f3cdec5-f845-5b0f-841e-8b1d47de0281",
      "recordId": "chemie455-final16-native-description-b-20261019-v1.goal-15",
      "reason": "D: Estergruppen allein identifizieren kein Triacylglycerid. Die knappe Präzisierung nennt das bereits beanspruchte Glycerintriester-Gerüst und verhindert die Zuordnung eines beliebigen Esters als Fett."
    }
  ],
  "profileRecommendations": {
    "none": 12,
    "create": 0,
    "revise": 4
  },
  "separatePFindings": [
    {
      "findingId": "P-B01",
      "goalId": "18819a59-2442-530f-a7c3-26755398ec66",
      "status": "revise",
      "inputJsonPointer": "/goals/5/reviewContext/evidenceProfile/profile/applicationCaseBriefs",
      "findingDe": "Die als verfügbar behauptete konkrete freigegebene HPLC-Methode, Probenmatrix und Struktur-/Selektivitätsunterlagen fehlen im aktuellen gebundenen Fall. Die richtigen Rechenkontrollen allein tragen keine geplante und tatsächliche Eigenbestimmung.",
      "requiredResolutionDe": "Vollständiges analytspezifisches Material und geeignete lokale Durchführungsvorgaben konkret binden; echte spätere Messprotokolle bleiben von Lehrzahlen getrennt."
    },
    {
      "findingId": "P-B02",
      "goalId": "39c85aa0-b01f-56ec-a148-b8009bf650f5",
      "status": "revise",
      "inputJsonPointer": "/goals/6/reviewContext/evidenceProfile/profile/applicationCaseBriefs/1",
      "findingDe": "Für den frischen substituierten Lactonfall werden Strukturformeln, Anfangsgeschwindigkeits- und Gleichgewichtstabellen angekündigt, ohne diese konkret zu liefern oder zu binden.",
      "requiredResolutionDe": "Die beiden vollständigen Strukturen, getrennten Daten, gemeinsamen Bedingungen und den Vergleichsbezug relativer Stabilität liefern; keine allgemeine Ringstabilität allein aus unterschiedlich zusammengesetzten Systemen ableiten."
    },
    {
      "findingId": "P-B03",
      "goalId": "9d97f628-c3ea-5dc0-8723-b17b16297af3",
      "status": "revise",
      "inputJsonPointer": "/goals/9/reviewContext/evidenceProfile/profile/applicationCaseBriefs/1",
      "findingDe": "Der frische Triglyceridfall nennt Daten zur Glycerinabtrennung und Grenzen durch Nebenreaktionen, enthält aber keinen konkreten Datensatz oder Materiallink.",
      "requiredResolutionDe": "Für die tatsächliche Planbeurteilung relevante vollständige Trenn-/Nebenreaktionsangaben binden; das allgemeine Umesterungsschema reicht dafür nicht."
    },
    {
      "findingId": "P-B04",
      "goalId": "0d59b62e-d3f9-5969-b961-0c5e26316c04",
      "status": "revise",
      "inputJsonPointer": "/goals/13/reviewContext/evidenceProfile/profile/applicationCaseBriefs",
      "findingDe": "Ganzer datierter produktbezogener Regel-/Fußnotenauszug und konkrete Wirkungs-/Löslichkeitsdaten samt Strukturvergleich fehlen. Im frischen Fall sind Ester und Produkt nicht konkret bestimmt. Die behauptete Regel wird durch die arithmetisch richtige Limitrechnung nicht verifiziert.",
      "requiredResolutionDe": "Vollständigen datierten Originalauszug oder ehrlich als Modellregel ausgewiesenes Material, konkrete Strukturen und vollständige Wirkungs-/Löslichkeitsdaten inklusive frischem Produktfall binden."
    }
  ],

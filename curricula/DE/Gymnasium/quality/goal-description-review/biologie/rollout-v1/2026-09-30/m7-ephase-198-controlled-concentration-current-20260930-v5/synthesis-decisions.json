      "finalText": {
        "titleDe": "Substratabhängigkeit der Enzymaktivität deuten",
        "titleEn": "Interpret substrate dependence of enzyme activity",
        "descriptionDe": "Die lernende Person kann aus Daten bei konstanter Enzymmenge und sonst gleichen Bedingungen erklären, warum die Enzymaktivität mit steigender Substratkonzentration im einfachen Sättigungsmodell ein Plateau erreicht.",
        "descriptionEn": "The learner can use data at a fixed enzyme amount and otherwise equal conditions to explain why enzyme activity reaches a plateau as substrate concentration rises in a simple saturation model."
      },
      "resolutionDecision": "keep_current",
      "evidenceRound": "first",

ot.com/lernzielbuch?landscape=7f6fc60c-9fcc-4cc2-b07e-f897a1d0338a&edition=curricular-atomic-v1#goal-f1a078ae-6262-4444-a4bc-a5ab275621cf"},{"goalId":"28237994-9c24-5a06-82fe-be1f494768ba","title":"Spannung in einfachen Stromkreisen messen","canonicalUrl":"https://skillpilot.com/lernzielbuch?landscape=7f6fc60c-9fcc-4cc2-b07e-f897a1d0338a&edition=curricular-atomic-v1#goal-28237994-9c24-5a06-82fe-be1f494768ba"}],"externalReverseRequires":[{"goalId":"4ac5a07c-fff0-5eae-890d-89e13eaf69c3","title":"Eine echte Diodenkennlinie aufnehmen und prüfen","canonicalUrl":"https://skillpilot.com/lernzielbuch?landscape=7f6fc60c-9fcc-4cc2-b07e-f897a1d0338a&edition=curricular-atomic-v1#goal-4ac5a07c-fff0-5eae-890d-89e13eaf69c3"}],"visualization":{"resourceType":"image","title":"Visualisierung: Die Strom-Spannungs-Kennlinie einer Diode experimentell bestimmen","url":"/assets/goal-visualizations/physik/3857891b-d328-585b-9936-85c7aff122ee/3857891b-d328-585b-9936-85c7aff122ee.png","altText":"Explizit schematische qualitative I_D(U_D)-Kennlinie, kleiner negativer Sperrstrom und ansteigender positiver Durchlassstrom. Keine Messpunkte, keine universelle Schwellspannung, keine exakte Nullbehauptung. U an der Diode, I durch die Diode, Strombegrenzung und sichere Kleinspannung. Kein realer Aufbau oder Messdatennachweis.","originalDigest":"sha256:bfac74412968fe6865a8f6b56bc23edd690e05a30a0ff38acbee9f37c3f3da7e","qaStatus":"review_candidate","approvedForPublication":false},"evidenceReview":null,"goalFingerprint":"sha256:a0fa57a28313a5a4d54aa21686d17f0147f8701f75081196f26081b1319960b0","pageFingerprint":"sha256:d7e24014cef39f49074e6a85828998bddc8fe04b79155d48b68f6e5aea2db936"},"evidenceProfile":null}

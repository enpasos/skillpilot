        "inventorySha256": { "const": "515a1090a260022cc5cc0b357c552e3d5ae6b998d62ad8570fa323c1c29fcc37" },
        "sourceEdgeAdjudicationsSha256": { "const": "cb15ade2dadad4f6a6c7a583d50497a1eb1673e7b0d5cafd3b490add24abf4d0" },
        "applyPlanSha256": { "const": "430e8f668841a2fb65be1962ea860abcddccf60a63f91e87eea3d84b52e1b47b" },
        "applyPlanDigest": { "const": "70048d02ded23eeabae0429b1ed583a6557663ecdc5fd253456dfe6ec4b4e282" }

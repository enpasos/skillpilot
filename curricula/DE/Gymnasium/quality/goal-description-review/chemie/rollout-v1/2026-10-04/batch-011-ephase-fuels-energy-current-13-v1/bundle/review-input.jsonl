ioxid an. Die Stoffpfeile sind qualitative Umwandlungen, keine vollständigen Reaktionsgleichungen. Die graue Hülle ist ein isolierender Behälter. Ein Starterakku und ein Gewicht verweisen auf Anwendung und hohe Masse.","originalDigest":"sha256:fdbfe4bfb250f09ad73c829be506629a7f0a2ffb73059c84bbf150b35a296f11","qaStatus":"review_candidate","approvedForPublication":false},"evidenceReview":null,"goalFingerprint":"sha256:fb1c97896d2356dbe7b9eb3e157a56780835d20e1e6a31a46727482b9e585790","pageFingerprint":"sha256:144fb8a7e0a7b65a8dc709cf62d7c72fa0b7d490a7831e85fa1cfc8abc8daab5"},"evidenceProfile":null}

      "finalText": {
        "titleDe": "Aggregatzustände und Übergänge deuten",
        "titleEn": "Interpret states of matter and transitions",
        "descriptionDe": "Die lernende Person kann feste, flüssige und gasförmige Zustände anhand beobachtbarer Eigenschaften unterscheiden und Übergänge zwischen ihnen als Zustandsänderungen desselben Stoffes erklären.",
        "descriptionEn": "The learner can distinguish solid, liquid and gaseous states by observable properties and explain transitions between them as changes in the state of the same substance."
      },
      "resolutionDecision": "keep_current",
      "evidenceRound": "second",

{
  "landscapeId": "7f6fc60c-9fcc-4cc2-b07e-f897a1d0338a",
  "title": "Physik: Entwurf zur zweckgebundenen c648-Aufteilung",
  "goals": [
    {
      "id": "55dbede5-2fee-51e7-ac13-e3b0227c502e",
      "title": "Lage von Maxima und Minima am idealisierten Doppelspalt bestimmen",
      "titleEn": "Determine maxima and minima of idealized double-slit interference",
      "description": "Die lernende Person kann bei senkrechtem, kohärentem und monochromatischem Lichteinfall am idealisierten Doppelspalt die Bedingungen für helle und dunkle Streifen aus dem Gangunterschied begründen und daraus deren Winkel und Schirmpositionen in Fernfeldnäherung bestimmen. Sie unterscheidet dabei den Abstand der Spaltmitten vom Schirmabstand und verwendet die Kleinwinkelnäherung nur, wenn sie angemessen ist; die Einhüllende realer Spalte endlicher Breite wird hier vernachlässigt.",
      "descriptionEn": "The learner can explain the conditions for bright and dark fringes from the path difference for normally incident coherent monochromatic light at an idealized double slit, and determine their angles and screen positions in the far-field approximation. They distinguish slit-centre separation from screen distance and use the small-angle approximation only when appropriate; the envelope due to finite slit width is neglected here.",
      "contains": [],
      "requires": ["2c6af966-7703-4176-a117-5ddb8295bedf"]
    },
    {
      "id": "df4acb52-b700-5b44-bc1e-11d73f24d061",
      "title": "Lage der Hauptmaxima eines optischen Gitters bestimmen",
      "titleEn": "Determine the principal maxima of an optical diffraction grating",
      "description": "Die lernende Person kann bei senkrechtem, kohärentem und monochromatischem Lichteinfall die Hauptmaxima eines regelmäßigen optischen Gitters aus der Gleichphasigkeit benachbarter Spalte begründen und ihre Winkel und Schirmpositionen im Fernfeld bestimmen. Sie deutet die Gitterkonstante als Abstand benachbarter Spaltmitten, prüft die geometrisch möglichen Ordnungen und unterscheidet diese Hauptmaximabedingung von Aussagen über Nebenmaxima oder Minima.",
      "descriptionEn": "The learner can explain the principal maxima of a regular optical grating from the phase agreement of adjacent slits for normally incident coherent monochromatic light, and determine their angles and screen positions in the far field. They interpret the grating constant as the separation of adjacent slit centres, check geometrically possible orders and distinguish this principal-maximum condition from statements about secondary maxima or minima.",
      "contains": [],
      "requires": ["2c6af966-7703-4176-a117-5ddb8295bedf"]
    },
    {
      "id": "6e4faa1f-bccf-574e-bdb9-544f44c1d7f7",
      "title": "Extrema der Einzelspaltbeugung bestimmen",
      "titleEn": "Determine extrema of single-slit diffraction",
      "description": "Die lernende Person kann bei senkrechtem monochromatischem Lichteinfall auf einen gleichmäßig beleuchteten Einzelspalt die Minima im Fernfeld durch paarweise Auslöschung erklären und ihre Winkel und Schirmpositionen berechnen. Daraus bestimmt sie die Breite des Zentralmaximums; die Lage der Nebenmaxima ermittelt sie aus einem bereitgestellten Intensitätsverlauf und kennzeichnet Näherungen, statt halbe Ordnungen als exakte Maximapositionen anzunehmen.",
      "descriptionEn": "The learner can explain far-field minima by pairwise cancellation for normally incident monochromatic light illuminating a single slit uniformly, and calculate their angles and screen positions. From these they determine the width of the central maximum; they obtain secondary-maximum positions from a supplied intensity curve and identify approximations rather than treating half orders as exact maximum positions.",
      "contains": [],
      "requires": ["2c6af966-7703-4176-a117-5ddb8295bedf"]
    }
  ]
}

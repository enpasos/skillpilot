import{readFileSync}from'node:fs';import{join,resolve}from'node:path';import{pathToFileURL}from'node:url';import{createHash}from'node:crypto';
const[rootArg,dirArg,...aliases]=process.argv.slice(2);const root=resolve(rootArg),dir=resolve(dirArg),roots:Record<string,string>={repo:root};for(const item of aliases){const i=item.indexOf('=');if(i<1)throw Error('invalid root alias');roots[item.slice(0,i)]=resolve(item.slice(i+1))}const hash=(v:string|Buffer)=>createHash('sha256').update(v).digest('hex');const json=(p:string)=>JSON.parse(readFileSync(p,'utf8'));const{stableGoalBookJson,parseAndValidateGoalBookModel}=await import(pathToFileURL(join(root,'app/scripts/goalBookModel.ts')).href);const{fingerprintPositiveGoalEvidenceProfile}=await import(pathToFileURL(join(root,'app/scripts/positiveGoalEvidenceProfileModel.ts')).href);const{fingerprintGoalEvidenceProfile}=await import(pathToFileURL(join(root,'app/scripts/goalEvidenceProfileModel.ts')).href);const assert=(v:unknown,m:string)=>{if(!v)throw Error(m)};
const origins=json(join(dir,'binding-origins.actual.json')).origins;let values=0;for(const o of origins.filter((x:any)=>x.kind==='native_parsed_value')){assert(roots[o.location.root],`external root ${o.location.root} required`);const p=join(roots[o.location.root],o.location.path),b=readFileSync(p);assert(hash(b)===o.rawSha256,'Native value source raw hash drift');const v=p.endsWith('.jsonl')?b.toString().split(/\r?\n/).filter(l=>l.trim()).map(l=>JSON.parse(l)):JSON.parse(b.toString());assert(hash(stableGoalBookJson(v))===o.sha256,'Native value digest mismatch');values++}
const checks=json(join(dir,'native-value-checks.actual.json'));const cache=new Map<string,any>();function document(p:string){if(!cache.has(p)){const s=readFileSync(join(root,p),'utf8');cache.set(p,p.endsWith('.jsonl')?s.split(/\r?\n/).map(l=>l.trim()?JSON.parse(l):null):JSON.parse(s))}return cache.get(p)}function pointer(p:string,record:string){let v=document(record);const segments=p.split('/').slice(1);if(segments[0]?.startsWith('@line')){v=v[Number(segments.shift()!.slice(5))-1]}for(const s of segments)v=v[s.replaceAll('~1','/').replaceAll('~0','~')];return v}
for(const c of checks.allEmbeddedProfileBodyChecks){const p=c.pointer.slice(0,-'/profileFingerprint'.length),record=pointer(p,c.record);const fp=c.nativeFunction==='fingerprintPositiveGoalEvidenceProfile'?fingerprintPositiveGoalEvidenceProfile(record.profile):fingerprintGoalEvidenceProfile(record.profile,record.ruleVersion??'goal-evidence-v1');assert(fp===c.expected&&record.profileFingerprint===c.expected,`Profile body changed ${c.record}:${p}`)}for(const c of checks.sealedBookModels)parseAndValidateGoalBookModel(document(c.path));console.log(JSON.stringify({nativeParsedValueDigests:values,nativeEmbeddedProfileBodies:checks.allEmbeddedProfileBodyChecks.length,sealedBookModels:checks.sealedBookModels.length,unknownNativeContracts:0}));

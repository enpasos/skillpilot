  "goals": [
    {
      "id": "2b9e565f-d9b4-5e23-b5b7-b7977cecff06",
      "title": "Mehrphasenbewegung und Modellprüfung",
      "titleEn": "Multi-phase Motion and Model Validation",
      "description": "E.1/E.2 datenbasierte Modellierung, 30 BE.",
      "descriptionEn": "E.1/E.2 data-based modeling, 30 points.",

      "sourceRef": "docs/concept/skill-graph/examples/hessen-physik-e1/entwuerfe-kindeinheit/c-senkrechter-wurf.md",
      "dimensionTags": {
        "framework": "canonical-gymnasium-physics",
        "demandLevel": "AB3",
        "processCompetencies": [

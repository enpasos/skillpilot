          "DE-HE"
        ]
      },
      "dimensionTags": {
        "framework": "canonical-gymnasium-physics",
        "phase": "E",
        "area": "Klausurtraining",
        "demandLevel": "AB2",
        "processCompetencies": [
          "PK2_MODELLIEREN",
          "PK3_MATHEMATISIEREN",
          "PK4_KOMMUNIZIEREN"
        ],
        "guidingIdeas": [

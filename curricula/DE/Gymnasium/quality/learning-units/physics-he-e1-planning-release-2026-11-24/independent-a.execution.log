        "understandingFocusDe": "Übergang von endlichem zu lokalem Änderungsmaß.",
        "understandingFocusEn": "Transition from a finite to a local rate of change."
      },
      {
        "id": "same-average-different-local-motion",
        "taskDemandDe": "Zwei Bewegungen haben gleiche Anfangs- und Endorte sowie dieselbe Dauer; eine ist gleichförmig, die andere enthält Pause und Beschleunigungsphase. Vergleiche Durchschnitts- und Momentangeschwindigkeiten.",
        "taskDemandEn": "Two motions have the same initial and final positions and duration; one is uniform, while the other includes a pause and an acceleration phase. Compare average and instantaneous velocities.",
        "expectedPerformanceDe": "Gleiche Durchschnittsgeschwindigkeit wird erkannt, ohne daraus gleiche Momentangeschwindigkeiten oder gleiche Bewegungsverläufe abzuleiten.",
        "expectedPerformanceEn": "Equal average velocity is recognized without inferring equal instantaneous velocities or identical motion histories.",
        "understandingFocusDe": "Ein Durchschnittswert bestimmt den lokalen Verlauf nicht.",
        "understandingFocusEn": "An average does not determine local behavior."
      }
    ]
  }
}
{
  "goalId": "89a8cf15-7ba4-46c1-b1dc-fd161b20d9c2",
  "goalFingerprintRuleVersion": "goal-evidence-v1",
  "profileRuleVersion": "positive-understanding-evidence-v2",
  "goalFingerprint": "sha256:d589a725624dabbd81123d28bee9c6dd653735297c2a93a044d9165583e7616c",
  "reviewInputFingerprint": "sha256:88c4604918ea8fe38dbfdc3d8d885455b0834f1111fc859349a76a9163f1c6d0",
  "profileFingerprint": "sha256:491ba891366768f64f29121c4e8b43666e55d984a3bab8992282499548129594",
  "profile": {
    "archetype": "experiment",
    "expectations": [
      {
        "id": "measured-components",
        "essentialUnderstandingDe": "Beim waagerechten Wurf ohne wesentlichen Luftwiderstand ist x(t) gleichförmig, die vertikale Bewegung beginnt mit v_y=0 und wird durch g beschleunigt. Beide Komponenten teilen dieselbe Zeit.",
        "essentialUnderstandingEn": "For horizontal projection with negligible drag, x(t) is uniform while vertical motion starts with v_y=0 and accelerates under gravity. Both components share the same time.",
        "observablePerformanceDe": "Gewinnt eigene kalibrierte Orts-Zeit-Daten aus einem sicheren Versuch und prüft beide Komponenten getrennt unter Berücksichtigung von Bild-/Zeitauflösung.",
        "observablePerformanceEn": "Obtains independently calibrated position-time data from a safe experiment and tests each component separately with spatial/time resolution considered."
      },
      {
        "id": "trajectory-and-controls",
        "essentialUnderstandingDe": "Die x-y-Bahn ist eine räumliche Spur, kein Zeitdiagramm. Bei gleicher Abwurfhöhe und v_y=0 verändert eine andere Horizontalgeschwindigkeit im Idealmodell nicht die Fallzeit.",
        "essentialUnderstandingEn": "The x-y trajectory is a spatial path, not a time graph. At equal release height and v_y=0, changing horizontal speed does not alter ideal fall time.",
        "observablePerformanceDe": "Konstruiert aus den Messwerten die Bahn, variiert gezielt den horizontalen Start und deutet Abweichungen anhand kontrollierter Bedingungen.",
        "observablePerformanceEn": "Constructs the trajectory from measured data, deliberately varies horizontal launch and explains deviations using the controlled conditions."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "measured-components",
        "trajectory-and-controls"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "speed",
        "textDe": "Horizontale Anfangsgeschwindigkeit bei gleicher Höhe variieren.",
        "textEn": "Vary horizontal initial speed at fixed height."
      },
      {
        "id": "representation",
        "textDe": "x(t)/y(t)-Messwerte in ein x-y-Diagramm übersetzen.",
        "textEn": "Translate measured x(t)/y(t) data into an x-y diagram."
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "low-height-video",
        "taskDemandDe": "Unter Aufsicht verlässt eine kleine Kugel eine waagerechte Rampe in geringer Höhe über einer gesicherten Auffangwanne; niemand steht in Flugrichtung. Plane eine seitliche Videoaufnahme mit Maßstab und bekannten Bildzeiten, führe sie durch und bestimme mindestens fünf x/y-Orte. Lege Koordinaten fest, zeichne x(t), y(t) und die x-y-Bahn und prüfe die Überlagerungsaussage mit der Messauflösung.",
        "taskDemandEn": "Under supervision a small ball leaves a horizontal ramp at low height above a secured catching tray; nobody is in its path. Plan and record side-on video with a scale and known frame times, obtain at least five x/y positions, define coordinates, plot x(t), y(t) and the x-y path, and test superposition considering resolution.",
        "expectedPerformanceDe": "Belegt eigene Aufnahme/Auswertung statt vorgegebener Idealkoordinaten. x-Abstände in gleichen Zeiten sind näherungsweise gleich, vertikale Abstände wachsen; Achsen und Nullpunkt sind konsistent. Nennt etwa Parallaxe, unscharfen Schwerpunkt oder ungenau horizontale Ablösung als kontrollierbare Fehlerquellen.",
        "expectedPerformanceEn": "Provides own recording/analysis, not supplied ideal coordinates. Equal-time x increments are approximately equal while vertical increments grow; axes/origin are consistent. Identifies controllable errors such as parallax, blurred centre position or imperfect horizontal release.",
        "understandingFocusDe": "Messprinzip, tatsächliche Daten und getrennte Bewegungsanteile.",
        "understandingFocusEn": "Measurement principle, actual data and separated components."
      },
      {
        "id": "changed-horizontal-launch",
        "taskDemandDe": "Wiederhole den gesicherten Versuch bei gleicher Höhe mit anderer horizontaler Startgeschwindigkeit. Sage vorab den Effekt auf Fallzeit und Reichweite voraus. Vergleiche anschließend die gemessenen Fallzeiten samt Auflösung und beide x-y-Bahnen. Wie könnte ein unbemerkt aufwärts gerichteter Start die Modellprüfung verfälschen?",
        "taskDemandEn": "Repeat the secured experiment at the same height with a different horizontal speed. Predict effects on fall time and range before measuring. Compare measured fall times with resolution and both x-y paths. How could unnoticed upward launch bias the model test?",
        "expectedPerformanceDe": "Erwartet gleiche Fallzeit im Idealmodell und größere Reichweite bei größerem v_x. Prüft statt exakter Gleichheit Vereinbarkeit innerhalb der Messgrenzen. Aufwärtskomponente setzt v_y≠0 und verletzt die waagerechte Startbedingung; eine abweichende Zeit widerlegt dann nicht die Unabhängigkeit korrekt angesetzter Komponenten.",
        "expectedPerformanceEn": "Predicts equal ideal fall time and greater range for greater v_x. Tests agreement within measurement limits rather than exact equality. An upward component gives v_y≠0 and violates horizontal launch; a changed time then does not refute properly specified component independence.",
        "understandingFocusDe": "Eigenständig geprüfte Variation statt Wiederholung einer Standardparabel.",
        "understandingFocusEn": "Independently tested variation rather than repeating a standard parabola."
      }
    ]
  }
}
{
  "goalId": "d6dc0e02-831d-4894-a61a-852bcc74f147",
  "goalFingerprintRuleVersion": "goal-evidence-v1",
  "profileRuleVersion": "positive-understanding-evidence-v2",
  "goalFingerprint": "sha256:3f711d058fc50a4000d6c312529b7c1abbbef2f09a6563717a69bbf9761edcfb",
  "reviewInputFingerprint": "sha256:7aee2789ed7c27f340f4912afe77ff4aa44839b52dbf22bf4bdb13959dca9d17",
  "profileFingerprint": "sha256:4ee8d93ca2d11b9106e4051214494a52fd0b0538682e2f30bf8e2668a8c0fd4f",
  "profile": {
    "archetype": "modeling",
    "expectations": [
      {
        "id": "system-and-law-selection",
        "essentialUnderstandingDe": "Ein Bewegungsgesetz beschreibt die Position beziehungsweise Geschwindigkeit eines festgelegten Körpers relativ zu einem gewählten Bezugssystem und Zeitnullpunkt; seine Form muss zum angenommenen Bewegungstyp passen.",
        "essentialUnderstandingEn": "A law of motion describes the position or velocity of a specified body relative to a chosen reference frame and time origin; its form must match the assumed type of motion.",
        "observablePerformanceDe": "Die lernende Person legt Körper, Koordinatenrichtung, Orts- und Zeitnullpunkt fest, wählt oder entwickelt passende Zeit-Ort- und Zeit-Geschwindigkeits-Gesetze und erklärt die physikalische Bedeutung ihrer Parameter und Vorzeichen.",
        "observablePerformanceEn": "The learner specifies the body, coordinate direction, spatial and temporal origins, selects or develops suitable time-position and time-velocity laws, and explains the physical meaning of their parameters and signs."
      },
      {
        "id": "idealization-and-consistency",
        "essentialUnderstandingDe": "Massepunkt und Reibungsfreiheit sind begründungsbedürftige Idealisierungen: Sie sind nützlich, wenn Größe, Rotation oder Widerstand für die Fragestellung vernachlässigbar sind. Zeit-Ort- und Zeit-Geschwindigkeits-Gesetz müssen dieselbe Bewegung widerspruchsfrei beschreiben.",
        "essentialUnderstandingEn": "The point-particle approximation and neglect of friction are idealizations that require justification: they are useful when size, rotation, or resistance is negligible for the question. The time-position and time-velocity laws must describe the same motion consistently.",
        "observablePerformanceDe": "Die lernende Person begründet jede Idealisierung bezogen auf Fall und Zielgröße, prüft die gegenseitige Konsistenz der beiden Gesetze über Steigung beziehungsweise zeitliche Änderung und korrigiert ein Modell mit widersprüchlichen Vorhersagen.",
        "observablePerformanceEn": "The learner justifies each idealization in relation to the case and target quantity, checks mutual consistency of the two laws through slope or time variation, and corrects a model with contradictory predictions."
      },
      {
        "id": "validation-and-model-limit",
        "essentialUnderstandingDe": "Übereinstimmung in einem untersuchten Zeitbereich stützt ein Modell nur dort; systematische Abweichungen, lange Extrapolation oder ein Regimewechsel wie zunehmender Luftwiderstand markieren Grenzen seiner Vorhersagen.",
        "essentialUnderstandingEn": "Agreement over an investigated time interval supports a model only there; systematic deviations, long extrapolation, or a regime change such as increasing drag mark limits of its predictions.",
        "observablePerformanceDe": "Die lernende Person vergleicht Modellwerte oder Graphen mit frischen Bewegungsdaten, identifiziert den Gültigkeitsbereich, erklärt ein Abweichungsmuster physikalisch und formuliert eine begrenzte statt universelle Vorhersage.",
        "observablePerformanceEn": "The learner compares model values or graphs with fresh motion data, identifies the validity range, explains a deviation pattern physically, and states a limited rather than universal prediction."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "system-and-law-selection",
        "idealization-and-consistency",
        "validation-and-model-limit"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "motion-regime",
        "textDe": "Näherungsweise gleichförmige, gleichmäßig beschleunigte oder durch Widerstand abweichende Bewegung",
        "textEn": "Approximately uniform, uniformly accelerated, or drag-affected motion"
      },
      {
        "id": "reference-choice",
        "textDe": "Geänderte positive Koordinatenrichtung, Ortsnullpunkt oder Zeitnullpunkt",
        "textEn": "Changed positive coordinate direction, spatial origin, or time origin"
      },
      {
        "id": "evidence-form",
        "textDe": "Tabellarische Messdaten, Zeit-Ort-Graph oder Zeit-Geschwindigkeits-Graph",
        "textEn": "Tabulated measurements, time-position graph, or time-velocity graph"
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "cart-constant-acceleration",
        "taskDemandDe": "Für einen Wagen auf einer geraden Bahn liegen Zeit-Ort-Daten vor, die in einem begrenzten Intervall zu gleichmäßiger Beschleunigung passen. Ein Bezugssystem, konsistente Gesetze für Ort und Geschwindigkeit, Idealisierungen und der geprüfte Gültigkeitsbereich sind anzugeben.",
        "taskDemandEn": "Time-position data for a cart on a straight track are consistent with uniform acceleration over a limited interval. A reference frame, consistent position and velocity laws, idealizations, and the tested range of validity must be specified.",
        "expectedPerformanceDe": "Die lernende Person definiert Achse und Nullpunkte, entwickelt zueinander passende Gesetze, deutet Anfangswerte und Beschleunigung mit Vorzeichen, begründet das Massepunktmodell und beschränkt die Aussage auf das Datenintervall.",
        "expectedPerformanceEn": "The learner defines the axis and origins, develops mutually consistent laws, interprets initial values and acceleration with signs, justifies the point-particle model, and restricts the claim to the data interval.",
        "understandingFocusDe": "Mathematische Form und physikalische Bezugswahl müssen gemeinsam kohärent sein.",
        "understandingFocusEn": "Mathematical form and physical reference choice must be coherent together."
      },
      {
        "id": "fall-with-drag-deviation",
        "taskDemandDe": "Ein reibungsfreies Modell für einen fallenden Körper stimmt anfangs mit Messdaten überein, überschätzt später aber die Geschwindigkeit systematisch. Die Idealisierung und eine weitreichende Extrapolation sind zu beurteilen.",
        "taskDemandEn": "A drag-free model for a falling object initially agrees with measurements but later systematically overestimates the speed. The idealization and a long-range extrapolation must be evaluated.",
        "expectedPerformanceDe": "Die lernende Person erkennt das geordnete Abweichungsmuster als Grenze der Reibungsfreiheitsannahme, erklärt die zunehmende Bedeutung des Widerstands und lehnt die unveränderte Fortsetzung des Modells ab, ohne das gesamte Anfangsmodell als wertlos zu verwerfen.",
        "expectedPerformanceEn": "The learner recognizes the systematic deviation pattern as a limit of the no-drag assumption, explains the growing importance of resistance, and rejects unchanged extrapolation without dismissing the entire initial model as useless.",
        "understandingFocusDe": "Der Transfer deckt die Fehlvorstellung auf, eine lokal passende Gleichung sei eine unbegrenzt gültige Realität.",
        "understandingFocusEn": "The transfer exposes the misconception that a locally fitting equation is an indefinitely valid reality."
      }
    ]
  }
}
{
  "goalId": "8aff7aac-321b-5172-ac55-877876bfd2cd",
  "goalFingerprintRuleVersion": "goal-evidence-v1",
  "profileRuleVersion": "positive-understanding-evidence-v2",
  "goalFingerprint": "sha256:ed6e3f41f857f4572d0908e131e83134bdc6e77bec082e598ee59e07ac14d5e6",
  "reviewInputFingerprint": "sha256:d916bd1ea349f322b658b5f8708316f519ac5942330eded70d266e39d915cda5",
  "profileFingerprint": "sha256:c8a1ab57b8099b0b024a224be80ee80b44bb602ae9df5736b1be11797066d6c6",
  "profile": {
    "archetype": "data",
    "expectations": [
      {
        "id": "error-pattern-and-intervention",
        "essentialUnderstandingDe": "Systematische Abweichungen verschieben Messwerte durch gleichgerichtete Einflüsse wie Nullpunkt- oder Kalibrierfehler, während zufällige Abweichungen Wiederholungsmessungen streuen; Wiederholen und Mitteln verringert daher nicht automatisch einen systematischen Anteil.",
        "essentialUnderstandingEn": "Systematic deviations shift measured values through consistently directed influences such as zero or calibration errors, whereas random deviations make repeated measurements scatter; repeating and averaging therefore do not automatically reduce a systematic component.",
        "observablePerformanceDe": "Die lernende Person analysiert eine Messreihe zusammen mit Geräte- und Referenzinformationen, beschreibt das Abweichungsmuster, ordnet begründet zufällige und systematische Anteile zu und erklärt, welche Wirkung Wiederholung, Mittelung, Nullabgleich oder Kalibrierung jeweils haben.",
        "observablePerformanceEn": "The learner analyzes a measurement series together with instrument and reference information, describes the deviation pattern, justifiably classifies random and systematic components, and explains the respective effects of repetition, averaging, zero adjustment, or calibration."
      },
      {
        "id": "inference-respects-measurement-limits",
        "essentialUnderstandingDe": "Eine Messreihe allein zeigt Streuung, beweist aber ohne unabhängige Referenz oder Geräteprüfung keinen fehlenden systematischen Anteil. Auflösung, Messbereich und Vergleichswert begrenzen, welche Fehlerursache aus den Daten erschlossen und welche Korrektur vertreten werden kann.",
        "essentialUnderstandingEn": "A measurement series by itself reveals scatter but, without an independent reference or instrument check, does not prove the absence of a systematic component. Resolution, range, and reference value limit which error cause can be inferred from the data and which correction can be defended.",
        "observablePerformanceDe": "Die lernende Person wertet frische Daten mit Einheiten und Geräteangaben aus, trennt Beobachtung von Fehlerursachen-Hypothese, formuliert eine begrenzte Schlussfolgerung und nennt eine zusätzliche Prüfung, die zwischen konkurrierenden Erklärungen unterscheiden würde.",
        "observablePerformanceEn": "The learner evaluates fresh data with units and instrument specifications, separates observation from a hypothesis about the error cause, states a bounded conclusion, and identifies an additional check that would distinguish competing explanations."
      },
      {
        "id": "fresh-error-pattern-transfer",
        "essentialUnderstandingDe": "Die Zuordnung einer Fehlerart muss bei verändertem Aufbau erneut aus Datenmuster, Geräteinformation und unabhängiger Kontrolle hergeleitet werden; eine Maßnahme verbessert nur den Anteil, auf den sie physikalisch wirkt.",
        "essentialUnderstandingEn": "Classifying an error type in a changed setup must be derived again from the data pattern, instrument information, and an independent check; an intervention improves only the component on which it physically acts.",
        "observablePerformanceDe": "Bei einem neuen Versuchsaufbau mit veränderter Auflösung, zusätzlichem konstantem Offset oder gleicher Streuung um einen verschobenen Mittelwert sagt die lernende Person voraus, welche Fehlerart vorliegt und welche Maßnahme die Aussagekraft verbessert.",
        "observablePerformanceEn": "For a new setup with changed resolution, an added constant offset, or the same scatter around a shifted mean, the learner predicts which type of error is present and which intervention improves the evidential value."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "error-pattern-and-intervention",
        "inference-respects-measurement-limits",
        "fresh-error-pattern-transfer"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "deviation-pattern",
        "textDe": "Zufällige Streuung, konstanter Offset, driftender Nullpunkt oder Kombination aus Streuung und Verschiebung",
        "textEn": "Random scatter, constant offset, drifting zero, or a combination of scatter and shift"
      },
      {
        "id": "reference-information",
        "textDe": "Bekannter Referenzwert, Kontrollmessung, Kalibrierangabe oder fehlende unabhängige Referenz",
        "textEn": "Known reference value, control measurement, calibration information, or no independent reference"
      },
      {
        "id": "instrument-limit",
        "textDe": "Geänderte Auflösung, Messbereich oder Wiederholungszahl",
        "textEn": "Changed resolution, range, or number of repeats"
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "balance-zero-offset-and-scatter",
        "taskDemandDe": "Eine Waage zeigt für ein zertifiziertes 200-g-Prüfstück die Werte 203, 202, 204, 203 und 202 g; bei unbelasteter Waage zeigt sie 3 g. Beschreibe Messgrenze und Abweichungsmuster, trenne zufällige und systematische Anteile, bewerte die Wirkung von Mitteln und Nullabgleich und formuliere eine begrenzte Schlussfolgerung.",
        "taskDemandEn": "A balance reads 203, 202, 204, 203, and 202 g for a certified 200 g reference mass; when unloaded it reads 3 g. Describe the measurement limit and deviation pattern, separate random and systematic components, assess the effects of averaging and zero adjustment, and state a bounded conclusion.",
        "expectedPerformanceDe": "Die lernende Person erkennt die Streuung als zufälligen Anteil und die unbelastete 3-g-Anzeige als Evidenz für einen Nullpunktfehler, berechnet oder beschreibt den Mittelwert mit Einheit, erklärt, warum Mitteln den Offset nicht beseitigt, und empfiehlt Nullabgleich mit erneuter Kontrollmessung.",
        "expectedPerformanceEn": "The learner identifies the scatter as a random component and the unloaded 3 g reading as evidence of a zero error, calculates or describes the mean with a unit, explains why averaging does not remove the offset, and recommends zero adjustment followed by a new control measurement.",
        "understandingFocusDe": "Der Fall prüft gemeinsam Datenmuster, unabhängige Referenz, Messgrenze und ursachengerechte Gegenmaßnahme.",
        "understandingFocusEn": "The case jointly tests data pattern, independent reference, measurement limit, and an intervention matched to the cause."
      },
      {
        "id": "thermometer-comparison-without-reference",
        "taskDemandDe": "Zwei Thermometer messen dasselbe langsam temperierte Wasser. Gerät A liefert 21,0 bis 21,4 °C, Gerät B 22,8 bis 23,2 °C; eine verlässliche Referenztemperatur fehlt und beide Anzeigen lösen 0,1 °C auf. Werte die Reihen aus, benenne tragfähige und nicht tragfähige Schlussfolgerungen und entwirf eine Kontrollprüfung.",
        "taskDemandEn": "Two thermometers measure the same slowly equilibrated water. Instrument A gives 21.0 to 21.4 °C and instrument B 22.8 to 23.2 °C; no reliable reference temperature is available and both displays resolve 0.1 °C. Evaluate the series, state warranted and unwarranted conclusions, and design a control check.",
        "expectedPerformanceDe": "Die lernende Person beschreibt Streuung und deutliche gegenseitige Verschiebung, erklärt aber, dass ohne Referenz nicht entschieden ist, welches Gerät systematisch abweicht. Sie schlägt eine Kalibrier- oder Referenzmessung vor und beschränkt die Aussage bis dahin auf Wiederholbarkeit und Geräteunterschied.",
        "expectedPerformanceEn": "The learner describes the scatter and clear mutual shift but explains that without a reference it is not known which instrument is systematically biased. The learner proposes a calibration or reference measurement and, until then, limits the conclusion to repeatability and the difference between instruments.",
        "understandingFocusDe": "Der neue Fall prüft, ob eine auffällige Verschiebung nicht ohne Evidenz einer bestimmten Ursache oder einem bestimmten Gerät zugeschrieben wird.",
        "understandingFocusEn": "The fresh case tests whether a conspicuous shift is not attributed to a particular cause or instrument without evidence."
      }
    ]
  }
}
{
  "goalId": "f6b1d812-ce8b-5852-b417-e6c29b533c7a",
  "goalFingerprintRuleVersion": "goal-evidence-v1",
  "profileRuleVersion": "positive-understanding-evidence-v2",
  "goalFingerprint": "sha256:8d6418853cbfdd29a80b78d2626701641cc048c26c182848383197e6c0d5e6d3",
  "reviewInputFingerprint": "sha256:e17286fc9cbf549a8f4b39d8ee9720918d799222a7fbc42d3982bf298f6c9650",
  "profileFingerprint": "sha256:c5da41d9e4039784bbcf20f6f30452bebb19254d13d3728a5596e49450a2bd3a",
  "profile": {
    "archetype": "procedure",
    "expectations": [
      {
        "id": "justify-and-record-uncertainty",
        "essentialUnderstandingDe": "Ein Messergebnis ist kein exakter wahrer Wert, sondern ein Schätzwert mit einer begründeten Unsicherheit; Wert und Unsicherheit müssen dieselbe Einheit und zueinander passende Dezimalstellen besitzen, wobei die Unsicherheit die sinnvolle Rundung bestimmt.",
        "essentialUnderstandingEn": "A measurement result is not an exact true value but an estimate with a justified uncertainty; value and uncertainty must have the same unit and compatible decimal places, with the uncertainty determining meaningful rounding.",
        "observablePerformanceDe": "Die lernende Person leitet aus Geräteauflösung oder der Streuung einer Messreihe eine angemessene Unsicherheitsangabe ab, notiert das Ergebnis mit Einheit und konsistenter Rundung und erklärt, welche Werte durch diese Angabe nicht voneinander unterscheidbar sind.",
        "observablePerformanceEn": "The learner derives an appropriate uncertainty statement from instrument resolution or the spread of repeated measurements, records the result with a unit and consistent rounding, and explains which values cannot be distinguished by that statement."
      },
      {
        "id": "uncertainty-bounds-conclusion",
        "essentialUnderstandingDe": "Die Unsicherheitsangabe beschreibt die begrenzte Auflösung des Ergebnisses unter den benannten Messbedingungen; sie ist weder eine Garantie, dass der wahre Wert im Intervall liegt, noch eine automatische Korrektur unbekannter systematischer Fehler.",
        "essentialUnderstandingEn": "The uncertainty statement describes the limited resolution of the result under the stated measurement conditions; it is neither a guarantee that the true value lies in the interval nor an automatic correction of unknown systematic errors.",
        "observablePerformanceDe": "Die lernende Person vergleicht zwei Messangaben einschließlich Unsicherheiten, entscheidet begründet, ob ein behaupteter Unterschied durch die Angaben aufgelöst wird, und nennt eine nicht erfasste systematische Einflussgröße als Grenze der Schlussfolgerung.",
        "observablePerformanceEn": "The learner compares two measurement statements including uncertainties, justifiably decides whether a claimed difference is resolved by the statements, and identifies an unaccounted systematic influence as a limit of the conclusion."
      },
      {
        "id": "fresh-uncertainty-transfer",
        "essentialUnderstandingDe": "Unsicherheit und Rundung müssen aus den Messbedingungen des neuen Falls neu bestimmt werden; eine frühere Angabe bleibt bei anderer Auflösung oder Streuung nicht automatisch gültig.",
        "essentialUnderstandingEn": "Uncertainty and rounding must be redetermined from the measurement conditions of the fresh case; an earlier statement does not automatically remain valid with different resolution or spread.",
        "observablePerformanceDe": "Für dieselbe Messgröße mit einem Instrument anderer Auflösung oder mit stärker streuenden Wiederholungen passt die lernende Person Unsicherheit und Rundung neu an und begründet, warum die frühere Ergebnisangabe nicht unverändert übernommen werden kann.",
        "observablePerformanceEn": "For the same quantity measured with an instrument of different resolution or with more strongly scattered repetitions, the learner adjusts the uncertainty and rounding and explains why the previous result statement cannot be retained unchanged."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "justify-and-record-uncertainty",
        "uncertainty-bounds-conclusion",
        "fresh-uncertainty-transfer"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "uncertainty-source",
        "textDe": "Geräteauflösung einer Einzelmessung oder Streuung unabhängiger Wiederholungen",
        "textEn": "Instrument resolution of a single measurement or spread of independent repeats"
      },
      {
        "id": "measurement-scale",
        "textDe": "Länge, Zeit oder Temperatur mit jeweils passender Einheit und Größenordnung",
        "textEn": "Length, time, or temperature with the appropriate unit and scale"
      },
      {
        "id": "comparison-demand",
        "textDe": "Ergebnis notieren, zwei Angaben vergleichen oder eine behauptete Unterscheidbarkeit prüfen",
        "textEn": "Record a result, compare two statements, or test a claimed distinguishability"
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "ruler-resolution-single-length",
        "taskDemandDe": "Die Länge eines Bauteils wird mit einem Millimeterlineal zu 84 mm abgelesen. Leite aus der bereitgestellten Ableseregel eine geeignete Unsicherheit ab, notiere das Ergebnis fachgerecht und beurteile, ob damit 84,1 mm und 84,4 mm unterschieden werden können.",
        "taskDemandEn": "The length of a component is read as 84 mm with a millimetre ruler. Use the supplied reading rule to derive a suitable uncertainty, record the result correctly, and assess whether 84.1 mm and 84.4 mm can be distinguished with it.",
        "expectedPerformanceDe": "Die lernende Person bindet die Unsicherheit an die Skalenauflösung, notiert Wert und Unsicherheit mit derselben Einheit und passenden Stellen und verneint eine feinere Unterscheidung, die unterhalb der Messauflösung liegt. Sie behauptet keine Beseitigung möglicher Null- oder Kalibrierfehler.",
        "expectedPerformanceEn": "The learner ties the uncertainty to the scale resolution, records value and uncertainty with the same unit and compatible digits, and rejects a finer distinction below the measurement resolution. The learner does not claim that possible zero or calibration errors have been removed.",
        "understandingFocusDe": "Der Fall prüft die Verbindung von Geräteauflösung, sinnvoller Rundung und begrenzter Unterscheidbarkeit.",
        "understandingFocusEn": "The case tests the connection between instrument resolution, meaningful rounding, and limited distinguishability."
      },
      {
        "id": "period-series-spread-and-comparison",
        "taskDemandDe": "Für eine Pendelperiode liegen zehn frische Zeitwerte und eine zweite Messung mit einem höher auflösenden Zeitgeber, aber stärkerer Streuung vor. Bestimme für jede Reihe einen repräsentativen Wert, leite nach der vorgegebenen Regel eine Unsicherheit aus der Streuung ab, notiere beide Ergebnisse und bewerte eine behauptete Periodendifferenz.",
        "taskDemandEn": "Ten fresh timing values for a pendulum period and a second measurement from a higher-resolution timer with greater scatter are supplied. Determine a representative value for each series, derive an uncertainty from the spread using the supplied rule, record both results, and assess a claimed difference in period.",
        "expectedPerformanceDe": "Die lernende Person wertet beide Reihen mit Einheiten aus, lässt die Unsicherheit die Rundung bestimmen und beurteilt die Differenz nur im Verhältnis zu beiden Unsicherheitsangaben. Sie erklärt, warum höhere Anzeigeauflösung bei größerer Streuung nicht automatisch eine engere Ergebnisangabe rechtfertigt.",
        "expectedPerformanceEn": "The learner evaluates both series with units, lets the uncertainty determine rounding, and assesses the difference only in relation to both uncertainty statements. The learner explains why higher display resolution with greater scatter does not automatically justify a narrower result statement.",
        "understandingFocusDe": "Der Transferfall trennt Anzeigeauflösung von empirischer Streuung und bindet die Schlussfolgerung an die resultierende Unsicherheit.",
        "understandingFocusEn": "The transfer case separates display resolution from empirical spread and binds the conclusion to the resulting uncertainty."
      }
    ]
  }
}
{
  "goalId": "971beafa-6ba5-4c82-ac8b-7ebf66eec3dd",
  "goalFingerprintRuleVersion": "goal-evidence-v1",
  "profileRuleVersion": "positive-understanding-evidence-v2",
  "goalFingerprint": "sha256:525b6122c6aa914d3109d26afb18a86d440b8247ce92eb478eac94bc8cd651a7",
  "reviewInputFingerprint": "sha256:7cb17299f56069c289b367b2082d1cf0cdff994459f6544865fb9a8fd89b7812",
  "profileFingerprint": "sha256:38e23ffb0b8efc3260974f8a379539ce0b1925afb98f2b654fd734dfc5de3e26",
  "profile": {
    "archetype": "experiment",
    "expectations": [
      {
        "id": "selected-blind-review-core",
        "essentialUnderstandingDe": "Die lernende Person versteht, dass bei gleichförmiger eindimensionaler Bewegung in gleichen Zeitintervallen gleiche Ortsänderungen auftreten, die Geschwindigkeit einschließlich ihres Vorzeichens konstant ist und ihr Betrag experimentell aus der Steigung eines t-s-Diagramms beziehungsweise aus Orts- und Zeitdifferenzen bestimmt wird.",
        "essentialUnderstandingEn": "The learner understands that in uniform one-dimensional motion equal changes in position occur during equal time intervals, velocity including its sign is constant, and its magnitude can be determined experimentally from the slope of a time-position graph or from differences in position and time.",
        "observablePerformanceDe": "Die lernende Person entscheidet anhand eigener oder vorgegebener Messdaten, ob eine Bewegung gleichförmig ist, definiert die Geschwindigkeit mit Einheit und gewählter positiver Richtung, bestimmt den Geschwindigkeitsbetrag aus den Daten und begründet die Aussage anhand der Streuung und der Diagrammform.",
        "observablePerformanceEn": "Using self-recorded or supplied data, the learner decides whether a motion is uniform, defines velocity with its unit and a chosen positive direction, determines its magnitude from the data, and justifies the conclusion using the scatter and the graph shape."
      },
      {
        "id": "position-intercept-does-not-set-velocity",
        "essentialUnderstandingDe": "Für gleichförmige Bewegung gilt s(t) = s0 + v t; der Anfangsort verschiebt das t-s-Diagramm vertikal, während die Steigung die Geschwindigkeit bestimmt. Eine gleichförmige Bewegung muss daher nicht durch den Ursprung verlaufen.",
        "essentialUnderstandingEn": "Uniform motion follows s(t) = s0 + v t; initial position shifts the time-position graph vertically, whereas slope determines velocity. A uniform-motion graph therefore need not pass through the origin.",
        "observablePerformanceDe": "Die lernende Person vergleicht zwei lineare Messreihen, trennt Achsenabschnitt und Steigung und erkennt gleiche Geschwindigkeiten trotz verschiedener Anfangsorte.",
        "observablePerformanceEn": "The learner compares two linear data sets, distinguishes intercept from slope, and recognizes equal velocities despite different initial positions."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "selected-blind-review-core",
        "position-intercept-does-not-set-velocity"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "moving-object",
        "textDe": "Wagen, Förderbandobjekt oder gehende Person",
        "textEn": "Cart, conveyor object, or walking person"
      },
      {
        "id": "sampling-and-scatter",
        "textDe": "Messintervall, Anzahl der Punkte und zufällige Streuung",
        "textEn": "Measurement interval, number of points, and random scatter"
      },
      {
        "id": "coordinate-choice",
        "textDe": "Unterschiedlicher Ursprung oder umgekehrte positive Richtung",
        "textEn": "Different origin or reversed positive direction"
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "two-carts-offset-starts",
        "taskDemandDe": "Zwei Wagen liefern parallele t-s-Messreihen mit verschiedenen Anfangsorten. Entscheide mit Einheiten und Streuung, ob beide gleichförmig fahren und wie sich ihre Geschwindigkeiten unterscheiden.",
        "taskDemandEn": "Two carts produce parallel time-position data sets with different initial positions. Using units and scatter, decide whether both move uniformly and how their velocities differ.",
        "expectedPerformanceDe": "Beide Steigungen werden korrekt bestimmt; der unterschiedliche Achsenabschnitt wird nicht als Geschwindigkeitsunterschied gedeutet.",
        "expectedPerformanceEn": "Both slopes are determined correctly; the different intercept is not treated as a velocity difference.",
        "understandingFocusDe": "Anfangsort und Geschwindigkeit werden getrennt.",
        "understandingFocusEn": "Initial position and velocity are separated."
      },
      {
        "id": "self-planned-cart-reversed-axis",
        "taskDemandDe": "Plane und führe auf einer gesicherten geraden Bahn mit einem langsam fahrenden Wagen einen Versuch zu der Frage durch, ob seine Bewegung gleichförmig ist. Lege Messstrecke und positive Richtung fest, erfasse Position und Zeit mit Video oder Zeitmarken, halte Bahnneigung und Antrieb kontrolliert, wiederhole die Messung und werte die Messreihe samt Streuung aus. Stelle dieselben Daten anschließend für eine umgekehrte Koordinatenachse dar.",
        "taskDemandEn": "Plan and carry out an experiment on a secured straight track with a slow-moving cart to test whether its motion is uniform. Define the measurement distance and positive direction, record position and time using video or time markers, control track inclination and propulsion, repeat the measurement, and analyze the data including scatter. Then represent the same data with the coordinate axis reversed.",
        "expectedPerformanceDe": "Versuchsfrage, sicherer Aufbau, Messprinzip und kontrollierte Größen sind nachvollziehbar; Position und Zeit werden als Messgrößen von der erschlossenen Geschwindigkeit getrennt, Wiederholungen begrenzen die Unsicherheit und die Gleichförmigkeit wird datenbasiert beurteilt. Bei Achsenumkehr bleiben Gleichförmigkeit und Geschwindigkeitsbetrag erhalten, während Steigung und vorzeichenbehaftete Geschwindigkeit konsistent das Vorzeichen wechseln.",
        "expectedPerformanceEn": "The testable question, safe setup, measurement principle, and controlled quantities are explicit; measured position and time are distinguished from inferred velocity, repetitions bound uncertainty, and uniformity is judged from the data. Reversing the axis preserves uniformity and speed magnitude while slope and signed velocity consistently change sign.",
        "understandingFocusDe": "Experimentelle Geschwindigkeitsbestimmung und Koordinateninvarianz werden gemeinsam nachgewiesen.",
        "understandingFocusEn": "Experimental determination of velocity and coordinate invariance are demonstrated together."
      }
    ]
  }
}
{
  "goalId": "09029573-864f-40ca-bf8a-cee7bf6dcb73",
  "goalFingerprintRuleVersion": "goal-evidence-v1",
  "profileRuleVersion": "positive-understanding-evidence-v2",
  "goalFingerprint": "sha256:130790489acb03f5ba26be963eb06339ad5f38783763c65e16a1646eb7acd6ab",
  "reviewInputFingerprint": "sha256:6fbbffbd869e4da0a99fc0eb9f8192749e617d7b02c68c3623b21956c64d7224",
  "profileFingerprint": "sha256:081f196db82add31979dc8f09ae53e816aa7473171f58453a4c57c91e9cd7e40",
  "profile": {
    "archetype": "experiment",
    "expectations": [
      {
        "id": "selected-blind-review-core",
        "essentialUnderstandingDe": "Die lernende Person versteht den freien Fall nahe der Erdoberfläche als näherungsweise gleichmäßig beschleunigte Bewegung unter Gravitation, unterscheidet gemessene Orts- und Zeitdaten von der daraus erschlossenen Gravitationsbeschleunigung und berücksichtigt, dass das Modell Luftwiderstand vernachlässigt sowie Koordinatenwahl und Anfangsbedingungen benötigt.",
        "essentialUnderstandingEn": "The learner understands free fall near Earth's surface as approximately uniformly accelerated motion under gravity, distinguishes measured position and time data from the gravitational acceleration inferred from them, and recognizes that the model neglects air resistance and requires a coordinate choice and initial conditions.",
        "observablePerformanceDe": "Die lernende Person plant oder nutzt eine sichere beaufsichtigte Video- oder Sensormessung beziehungsweise einen bereitgestellten Datensatz, stellt die Daten geeignet grafisch dar, bestimmt g mit Einheit und begründeter Unsicherheit, prüft die Modellpassung und formuliert ein dazu konsistentes Zeit-Ort-Gesetz mit Anfangsbedingungen.",
        "observablePerformanceEn": "The learner plans or uses a safe supervised video or sensor measurement, or a supplied data set, represents the data in a suitable graph, determines g with a unit and justified uncertainty, checks the model fit, and formulates a consistent time-position law with initial conditions."
      },
      {
        "id": "g-is-acceleration-not-weight-or-speed",
        "essentialUnderstandingDe": "g ist im luftwiderstandsfreien Modell die lokale Beschleunigung und weder eine Geschwindigkeit noch eine Kraft. Verschiedene Massen haben dieselbe Fallbeschleunigung, obwohl ihre Gewichtskräfte m g verschieden sind.",
        "essentialUnderstandingEn": "In the no-drag model, g is local acceleration, not a velocity or force. Different masses have the same falling acceleration even though their weights m g differ.",
        "observablePerformanceDe": "Die lernende Person vergleicht Daten zweier Körper, trennt Beschleunigung, Geschwindigkeit und Gewichtskraft mit Einheiten und entscheidet, ob Abweichungen auf Messunsicherheit oder Luftwiderstand hinweisen.",
        "observablePerformanceEn": "The learner compares data for two objects, distinguishes acceleration, velocity, and weight with units, and decides whether differences indicate uncertainty or drag."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "selected-blind-review-core",
        "g-is-acceleration-not-weight-or-speed"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "object-and-drag",
        "textDe": "Kompakter Körper, flächiger Körper oder unterschiedliche Massen",
        "textEn": "Compact object, broad object, or different masses"
      },
      {
        "id": "coordinate-and-initial-state",
        "textDe": "Fall aus Ruhe, Anfangsgeschwindigkeit, Bezugshöhe und Achsenrichtung",
        "textEn": "Drop from rest, initial velocity, reference height, and axis direction"
      },
      {
        "id": "measurement-method",
        "textDe": "Video, Lichtschranke, Sensor oder bereitgestellter Datensatz",
        "textEn": "Video, light gate, sensor, or supplied data"
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "steel-ball-video-fit",
        "taskDemandDe": "Werte eine beaufsichtigt aufgezeichnete Fallbewegung einer Stahlkugel bei nach oben positiver Achse aus. Bestimme g grafisch, gib Unsicherheit und Einheit an und formuliere das Zeit-Ort-Gesetz.",
        "taskDemandEn": "Analyze a supervised video recording of a falling steel ball with upward chosen as positive. Determine g graphically, state uncertainty and unit, and formulate the time-position law.",
        "expectedPerformanceDe": "Gemessene Orte und Zeiten werden von g als erschlossener Größe getrennt; a = -g, Anfangshöhe und Anfangsgeschwindigkeit werden konsistent eingesetzt.",
        "expectedPerformanceEn": "Measured positions and times are distinguished from inferred g; a = -g, initial height, and initial velocity are used consistently.",
        "understandingFocusDe": "Vorzeichen und Anfangsbedingungen sind Teil des Modells.",
        "understandingFocusEn": "Signs and initial conditions are part of the model."
      },
      {
        "id": "ball-and-filter-model-comparison",
        "taskDemandDe": "Vergleiche bereitgestellte Fallmessungen einer kompakten Kugel und eines Papierfilters aus gleicher Höhe. Prüfe für beide das Modell ohne Luftwiderstand.",
        "taskDemandEn": "Compare supplied falling-motion data for a compact ball and a paper filter released from the same height. Test the no-drag model for each.",
        "expectedPerformanceDe": "Die Kugeldaten liefern innerhalb der Unsicherheit konstantes g; die Filterabweichung wird nicht als anderes Gravitationsfeld oder bloßer Masseneffekt, sondern als Modellgrenze eingeordnet.",
        "expectedPerformanceEn": "The ball data yield constant g within uncertainty; the filter discrepancy is treated as a model limitation rather than a different gravitational field or merely a mass effect.",
        "understandingFocusDe": "Abweichung vom Modell verändert nicht die Bedeutung von g.",
        "understandingFocusEn": "Deviation from the model does not change the meaning of g."
      }
    ]
  }
}
{
  "goalId": "e4b38061-1f28-43ad-8371-a3e7c0e81856",
  "goalFingerprintRuleVersion": "goal-evidence-v1",
  "profileRuleVersion": "positive-understanding-evidence-v2",
  "goalFingerprint": "sha256:70e4e02a89e3533891437bcd8ecdb5eebbf6844890928e623f32a6fbb2c2dd58",
  "reviewInputFingerprint": "sha256:44014b5930f3995f5e1d07d3e011b33906acc7a1659ec51ef7f531ed061caf7d",
  "profileFingerprint": "sha256:e7d478c83be998c71a1e4ff75e412cbb0558b24403e207a936f1ea38a8174039",
  "profile": {
    "archetype": "representation",
    "expectations": [
      {
        "id": "selected-blind-review-core",
        "essentialUnderstandingDe": "Konstante Beschleunigung bedeutet gleiche Geschwindigkeitsänderungen in gleichen Zeitintervallen; deshalb sind t-a-, t-v- und t-s-Darstellung über konstante Beschleunigung, lineare Geschwindigkeitsänderung und quadratische Ortsänderung miteinander verknüpft, wobei Anfangswerte und Vorzeichen den konkreten Verlauf bestimmen.",
        "essentialUnderstandingEn": "Constant acceleration means equal changes in velocity in equal time intervals; therefore the time-acceleration, time-velocity, and time-position representations are linked through constant acceleration, linear velocity change, and quadratic position change, while initial values and signs determine the specific course.",
        "observablePerformanceDe": "Die lernende Person konstruiert für gegebene Anfangsposition, Anfangsgeschwindigkeit und vorzeichenbehaftete konstante Beschleunigung selbstständig konsistente t-a-, t-v- und t-s-Darstellungen, übersetzt zwischen ihnen und prüft Steigungen, Flächen, Einheiten und Bewegungsrichtung auf Plausibilität.",
        "observablePerformanceEn": "For a given initial position, initial velocity, and signed constant acceleration, the learner independently constructs consistent time-acceleration, time-velocity, and time-position representations, translates among them, and checks slopes, areas, units, and direction of motion for plausibility."
      },
      {
        "id": "signed-displacement-differs-from-distance",
        "essentialUnderstandingDe": "Die vorzeichenbehaftete Fläche unter einem t-v-Diagramm ist die Ortsänderung. Nach einem Richtungswechsel ist die zurückgelegte Strecke die Summe der Beträge der Teilflächen und kann größer als der Betrag der Ortsänderung sein.",
        "essentialUnderstandingEn": "The signed area under a time-velocity graph is displacement. After a reversal, distance traveled is the sum of the magnitudes of the partial areas and may exceed the magnitude of displacement.",
        "observablePerformanceDe": "Die lernende Person zerlegt einen Verlauf am Nulldurchgang von v, bestimmt Ortsänderung und Strecke mit Einheiten und verbindet beide mit dem t-s-Verlauf.",
        "observablePerformanceEn": "The learner splits a graph at the zero crossing of v, determines displacement and distance with units, and relates both to the time-position graph."
      }
    ],
    "coverageExpectations": {
      "requiredExpectationIds": [
        "selected-blind-review-core",
        "signed-displacement-differs-from-distance"
      ],
      "alternativeExpectationGroups": [],
      "minimumIndependentDemonstrations": 2,
      "freshVariationRequired": true,
      "independentTransferRequired": true
    },
    "variationAxes": [
      {
        "id": "signed-initial-conditions",
        "textDe": "Verschiedene Anfangsorte, Anfangsgeschwindigkeiten und Vorzeichen der Beschleunigung",
        "textEn": "Different initial positions, initial velocities, and signs of acceleration"
      },
      {
        "id": "starting-representation",
        "textDe": "Gegebenes t-a-, t-v-, t-s-Diagramm oder Wertetabelle",
        "textEn": "Given time-acceleration, time-velocity, time-position graph, or table"
      },
      {
        "id": "model-interval",
        "textDe": "Vollständig konstante Beschleunigung oder begrenztes Gültigkeitsintervall",
        "textEn": "Fully constant acceleration or a bounded validity interval"
      }
    ],
    "applicationCaseBriefs": [
      {
        "id": "ramp-cart-turnaround",
        "taskDemandDe": "Ein Wagen fährt mit positiver Anfangsgeschwindigkeit eine Rampe hinauf und erfährt konstante negative Beschleunigung. Konstruiere alle Diagramme, bestimme den Umkehrzeitpunkt sowie Ortsänderung und Strecke.",
        "taskDemandEn": "A cart travels up a ramp with positive initial velocity and constant negative acceleration. Construct all graphs and determine reversal time, displacement, and distance.",
        "expectedPerformanceDe": "Am Umkehrpunkt ist v = 0, aber a ist ungleich null; Vorzeichen, Flächen und Einheiten bleiben in allen Darstellungen konsistent.",
        "expectedPerformanceEn": "At the turning point v = 0 but a is nonzero; signs, areas, and units remain consistent across all representations.",
        "understandingFocusDe": "Geschwindigkeit null ist nicht Beschleunigung null.",
        "understandingFocusEn": "Zero velocity is not zero acceleration."
      },
      {
        "id": "braking-model-beyond-stop",
        "taskDemandDe": "Bremsdaten eines Fahrzeugs passen bis zum Stillstand zu konstanter negativer Beschleunigung. Setze das mathematische Modell zunächst fort und entscheide dann, ab wann es den realen Vorgang nicht mehr beschreibt.",
        "taskDemandEn": "Vehicle braking data fit constant negative acceleration up to rest. First extend the mathematical model and then decide when it ceases to describe the real process.",
        "expectedPerformanceDe": "Die rechnerische Rückwärtsbewegung nach dem Nulldurchgang wird als Folge einer unzulässigen Modellfortsetzung erkannt und das Gültigkeitsintervall datenbezogen begrenzt.",
        "expectedPerformanceEn": "The calculated backward motion after the zero crossing is recognized as a consequence of invalid model extension, and the validity interval is bounded using the data.",
        "understandingFocusDe": "Modellgleichung und reale Gültigkeit werden getrennt.",
        "understandingFocusEn": "Model equation and physical validity are separated."
      },
      {
        "id": "elevator-acceleration-log",
        "taskDemandDe": "Aus einem t-a-Protokoll mit abschnittsweise konstanter Beschleunigung und gegebenen Anfangswerten sollen t-v- und t-s-Verläufe vorhergesagt und mit Ortsmarken samt Auflösung verglichen werden.",
        "taskDemandEn": "Given a time-acceleration log with piecewise-constant acceleration and initial values, predict time-velocity and time-position graphs and compare them with position marks and their resolution.",
        "expectedPerformanceDe": "Verwendet a·Δt als Geschwindigkeitsänderung und vorzeichenbehaftete t-v-Flächen als Ortsänderung; verwechselt negative Beschleunigung nicht mit negativer Geschwindigkeit und begrenzt Aussagen bei Datenabweichungen.",
        "expectedPerformanceEn": "Uses a·Δt as velocity change and signed time-velocity areas as displacement; does not confuse negative acceleration with negative velocity and bounds claims when data differ.",
        "understandingFocusDe": "Der zuvor bei ce431 zu frühe Transfer folgt jetzt auf die Beschleunigungskompetenz.",
        "understandingFocusEn": "The transfer previously introduced too early in ce431 now follows acceleration competence."
      }
    ]
  }
}
{
  "goalId": "ce431132-dfc4-42c2-aff6-bd72035190f8",
  "goalFingerprintRuleVersion": "goal-evidence-v1",
  "profileRuleVersion": "positive-understanding-evidence-v2",
  "goalFingerprint": "sha256:fdb9aaed7b4d18b35518e3f312886605c2334b0f8df1ee1291536d53c673c0a1",
  "reviewInputFingerprint": "sha256:4b6b23e75b688cb7eb1246b89b239c1f0918d753219976629f004c2daa836294",
  "profileFingerprint": "sha256:04c42219f282a011630f992f16cbf932f8492c1cf0376d8a320b1417352926d9",
  "profile": {
    "archetype": "representation",
    "expectations": [
      {
        "id": "measured-position-derived-interval-velocity",
        "essentialUnderstandingDe": "t-s und t-v stellen dieselbe eindimensionale Bewegung durch gemessene Orte und daraus bestimmte mittlere Intervallgeschwindigkeiten dar. Vorzeichen hängen von der vereinbarten Achsenrichtung ab; ein waagerechter t-s-Abschnitt bedeutet Ruhe, ein waagerechter t-v-Abschnitt konstante Geschwindigkeit.",
        "essentialUnderstandingEn": "Time-position and time-velocity graphs represent the same one-dimensional motion through measured positions and average interval velocities determined from them. Signs depend on the agreed axis direction; a horizontal time-position interval means rest, while a horizontal time-velocity interval means constant velocity.",
        "observablePerformanceDe": "Erfasst eigene Zeit-Ort-Daten einer sicheren einfachen Bewegung, trennt gemessene und berechnete Größen, zeichnet beschriftete Diagramme und erklärt Ruhe, Hin- und Rückbewegung.",
        "observablePerformanceEn": "Records their own time-position data for a safe simple motion, distinguishes measured and calculated quantities, draws labelled graphs, and explains rest, outward motion, and return motion."
      },
      {
        "id": "measurement-resolution-bounds-graph-consistency",

      "sourceGoalId": "sn-phys-seki-sn-klassenstufe-7-lb3-038-01-67ccc3c7",
      "topicCode": "SN-klassenstufe-7-LB3",
      "sourceSpan": "Klassenstufe 7, Energiewandler, PDF-S. 28",
      "decision": "mapped",
      "canonicalGoalIds": [
        "581c0766-b84b-54cb-b8b6-375310329a41",

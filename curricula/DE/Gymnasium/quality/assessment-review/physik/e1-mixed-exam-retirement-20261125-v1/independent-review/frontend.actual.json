        "run": "set -euo pipefail\ntest \"${RUNNER_ENVIRONMENT:-}\" = github-hosted\ntest \"${RUNNER_OS:-}\" = Linux\ndf -h \"${GITHUB_WORKSPACE}\"\ndf -i \"${GITHUB_WORKSPACE}\"\n# Keep Python, Java/JDK and Node caches plus system build tools.\nsudo rm -rf -- \\\n  /usr/local/lib/android /usr/share/dotnet /opt/ghc /usr/local/.ghcup \\\n  /usr/share/swift /usr/local/julia* /usr/share/miniconda \\\n  /opt/az /opt/microsoft/powershell /usr/local/share/powershell \\\n  /usr/local/share/boost /usr/local/share/vcpkg \\\n  /home/linuxbrew \"${HOME}/.rustup\" \"${HOME}/.cargo\"\nif [ -d /opt/hostedtoolcache ]; then\n  sudo find /opt/hostedtoolcache -mindepth 1 -maxdepth 1 \\\n    ! -name Python ! -name 'Java*' ! -iname 'node*' -exec rm -rf -- {} +\nfi\nif ! sudo docker image prune --all --force; then\n  echo \"::warning::Docker image cleanup unavailable; the disk budget is still required.\"\nfi\nsudo apt-get clean\ndf -h \"${GITHUB_WORKSPACE}\"\ndf -i \"${GITHUB_WORKSPACE}\"\n# 43 GiB worktree + 15 GiB shallow Git reserve + 8 GiB dependencies/builds.\nrequired_bytes=$((66 * 1024 * 1024 * 1024))\navailable_bytes=\"$(df -B1 --output=avail \"${GITHUB_WORKSPACE}\" | tail -n 1)\"\nif [ \"${available_bytes}\" -lt \"${required_bytes}\" ]; then\n  echo \"::error::Full checkout needs ${required_bytes} free bytes; only ${available_bytes} are available after cleanup.\"\n  exit 1\nfi\n"

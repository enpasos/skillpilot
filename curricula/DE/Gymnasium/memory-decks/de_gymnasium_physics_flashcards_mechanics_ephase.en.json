    },
    {
      "id": "physics_e_cov_028",
      "front": "Conservation of momentum?",
      "back": "In closed systems, total momentum remains conserved:\n\n$\\sum \\vec p= \\text{constant}$",
      "category": "E-Phase Mechanics",
      "tags": [
        "GK",
        "LK",
        "coverage:auto",
        "goal:839ecc8f-3a60-418b-bc92-64bfeef33824"
      ]
    },
    {
      "id": "physics_e_cov_029",
      "front": "Momentum balance with external forces?",
      "back": "$\\frac{d}{dt} \\sum \\vec p= \\sum \\vec F_\\text{ext}$\n\nif $\\sum \\vec F_\\text{ext}=0$, then $\\sum \\vec p$ is constant",
      "category": "E-Phase Mechanics",
      "tags": [
        "LK",
        "coverage:auto",
        "goal:f524f05c-4456-4fc3-a1f7-f40741fc1f16"
      ]
    },
    {
      "id": "physics_e_cov_030",
      "front": "Impulse?",
      "back": "$\\vec J= \\int \\vec F\\,dt \\approx \\vec F\\,\\Delta t= \\Delta \\vec p$",

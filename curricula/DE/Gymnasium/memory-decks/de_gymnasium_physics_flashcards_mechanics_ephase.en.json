    {
      "id": "physics_e_cov_012",
      "front": "Stopping distance: core equation?",
      "back": "Stopping distance = reaction distance + braking distance\n\n$s_A=s_R+s_B$\n\nwith $s_R=v \\cdot t_R$ and $s_B \\propto v^2$",
      "category": "E-Phase Mechanics",
      "tags": [
        "GK",

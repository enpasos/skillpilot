    {
      "id": "physics_e_cov_007",
      "front": "Diagram rules for \nt-s, t-v, and t-a diagrams?",
      "back": "Slope in $t$-$s$ is $v$\n\nSlope in $t$-$v$ is $a$\n\nArea under $t$-$v$ is $\\Delta s$\n\nArea under $t$-$a$ is $\\Delta v$",
      "category": "E-Phase Mechanics",
      "tags": [
        "GK",
        "LK",
        "coverage:auto",
        "goal:ce431132-dfc4-42c2-aff6-bd72035190f8"
      ]
    },
    {
      "id": "physics_e_cov_008",
      "front": "Uniform motion: formula?",
      "back": "$v=\\text{constant}$,\n\n$a=0$,\n\n$s(t)=s_0+vt$",
      "category": "E-Phase Mechanics",
      "tags": [
        "GK",
        "LK",
        "coverage:auto",
        "goal:971beafa-6ba5-4c82-ac8b-7ebf66eec3dd"
      ]
    },
    {
      "id": "physics_e_cov_009",
      "front": "Uniformly accelerated motion: basic formulas?",
      "back": "$a=\\text{constant}$\n\n$v(t)=v_0+at$\n\n$s(t)=s_0+v_0t+\\frac12at^2$",
      "category": "E-Phase Mechanics",
      "tags": [
        "GK",
        "LK",
        "coverage:auto",
        "goal:e4b38061-1f28-43ad-8371-a3e7c0e81856"
      ]
    },
    {
      "id": "physics_e_cov_010",
      "front": "Free fall (without air resistance): basic formulas?",
      "back": "$a=g$\n\n$v(t)=gt$\n\n$s(t)=\\frac12gt^2$\n\n(for $v_0=0$ and $s_0=0$)",
      "category": "E-Phase Mechanics",
      "tags": [
        "GK",
        "LK",
        "coverage:auto",
        "goal:09029573-864f-40ca-bf8a-cee7bf6dcb73"
      ]
    },
    {

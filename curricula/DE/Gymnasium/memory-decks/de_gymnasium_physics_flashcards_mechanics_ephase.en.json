      ]
    },
    {
      "id": "physics_e_cov_032",
      "front": "Crumple zone: physical benefit?",
      "back": "Longer collision duration\n\n$\\Delta t$\n\nreduces average force:\n\n$F_\\text{avg} \\approx\\frac{\\Delta p}{\\Delta t}$",
      "category": "E-Phase Mechanics",
      "tags": [
        "GK",
        "LK",
        "coverage:auto",
        "goal:1232febe-868a-4dac-b4c2-e35789434601"
      ]
    },
    {
      "id": "physics_e_cov_033",
      "front": "Elastic collision: conserved quantities?",
      "back": "Total momentum and total kinetic energy remain conserved",
      "category": "E-Phase Mechanics",
      "tags": [
        "GK",
        "LK",
        "coverage:auto",

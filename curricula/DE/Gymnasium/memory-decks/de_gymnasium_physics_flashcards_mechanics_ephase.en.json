    {
      "id": "physics_e_cov_006",
      "front": "Sports physics: most important influencing factors?",
      "back": "Initial speed, launch angle, release height, force application, friction, and air resistance determine the motion process",
      "category": "E-Phase Mechanics",
      "tags": [

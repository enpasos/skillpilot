        "GK",
        "LK",
        "coverage:auto",
        "goal:e790de73-f8e5-4027-bc05-9f12a0e8c9cb"
      ]
    },
    {
      "id": "physics_e_cov_031",
      "front": "Inelastic collision: \nwhat remains conserved?",
      "back": "Total momentum remains conserved\n\nkinetic energy is not conserved",

{
  "deckId": "hes_phys_waves_q2",
  "title": "Physik Q2 (Schwingungen, Induktion, Wellen) - KC 2024",
  "cards": [
    {
      "id": "hes_phys_q2_c01",
      "front": "Zeit-Ort-Gesetz einer harmonischen Schwingung",
      "back": "$s(t) = s_{max} \\cdot \\sin(\\omega \\cdot t)$\n\n(bzw. Cosinus, je nach Startpunkt). $s_{max}$ ist die Amplitude, $\\omega$ die Kreisfrequenz.",
      "category": "Q2.1 Schwingungen",
      "tags": ["GK", "LK"]
    },
    {
      "id": "hes_phys_q2_c02",
      "front": "Zusammenhang: Frequenz $f$, Periodendauer $T$ und Kreisfrequenz $\\omega$",
      "back": "$f = \\frac{1}{T}$\n\n$\\omega = 2\\pi \\cdot f = \\frac{2\\pi}{T}$",
      "category": "Q2.1 Schwingungen",
      "tags": ["GK", "LK"]
    },
    {
      "id": "hes_phys_q2_c03",
      "front": "Rückstellkraft beim Federpendel (Hooke'sches Gesetz)",
      "back": "$F = -D \\cdot s$\n\nLineare Rückstellkraft ist die Voraussetzung für eine harmonische Schwingung.",
      "category": "Q2.1 Schwingungen",
      "tags": ["GK", "LK"]
    },
    {
      "id": "hes_phys_q2_c04",
      "front": "Differenzialgleichung der ungedämpften harmonischen Schwingung",
      "back": "$\\ddot{s}(t) + \\frac{D}{m} \\cdot s(t) = 0$\n\nLösung liefert $\\omega = \\sqrt{\\frac{D}{m}}$.",
      "category": "Q2.1 Schwingungen",
      "tags": ["LK"]
    },
    {
      "id": "hes_phys_q2_c05",
      "front": "Resonanzbedingung",
      "back": "Die Erregerfrequenz entspricht der Eigenfrequenz des Systems ($f_E \\approx f_0$).\nFührt zu maximaler Amplitude (Resonanzkatastrophe bei geringer Dämpfung).",
      "category": "Q2.1 Schwingungen",
      "tags": ["GK", "LK"]
    },
    {
      "id": "hes_phys_q2_c06",
      "front": "Definition des magnetischen Flusses $\\Phi$",
      "back": "$\\Phi = B \\cdot A$\n\n(Wenn $B \\perp A$). Maß für die Anzahl der Feldlinien durch eine Fläche.",
      "category": "Q2.2 Induktion",
      "tags": ["GK", "LK"]
    },
    {
      "id": "hes_phys_q2_c07",
      "front": "Induktionsgesetz (Allgemein)",
      "back": "$U_{ind} = -N \\cdot \\dot{\\Phi}$\n\nDie Induktionsspannung ist proportional zur zeitlichen Änderung des magnetischen Flusses.",
      "category": "Q2.2 Induktion",
      "tags": ["GK", "LK"]
    },
    {
      "id": "hes_phys_q2_c08",
      "front": "Lenz'sche Regel",
      "back": "Der Induktionsstrom ist stets so gerichtet, dass er seiner Ursache (der Änderung des magnetischen Flusses) entgegenwirkt. (Grund für das Minuszeichen).",
      "category": "Q2.2 Induktion",
      "tags": ["GK", "LK"]
    },
    {
      "id": "hes_phys_q2_c09",
      "front": "Induktivität $L$ einer langen Spule",
      "back": "$L = \\mu_0 \\cdot \\mu_r \\cdot \\frac{N^2 \\cdot A}{l}$\n\nMaß für die Selbstinduktionseigenschaft einer Spule.",
      "category": "Q2.2 Induktion",
      "tags": ["LK"]
    },
    {
      "id": "hes_phys_q2_c10",
      "front": "Energie des Magnetfeldes einer Spule",
      "back": "$E_{mag} = \\frac{1}{2} \\cdot L \\cdot I^2$",
      "category": "Q2.2 Induktion",
      "tags": ["LK"]
    },
    {
      "id": "hes_phys_q2_c11",
      "front": "Thomson'sche Schwingungsgleichung (LC-Kreis)",
      "back": "$T = 2\\pi \\cdot \\sqrt{L \\cdot C}$\n\nPeriodendauer im elektromagnetischen Schwingkreis.",
      "category": "Q2.2 Induktion",
      "tags": ["GK", "LK"]
    },
    {
      "id": "hes_phys_q2_c12",
      "front": "Grundgleichung der Wellenlehre (Phasengeschwindigkeit)",
      "back": "$c = \\lambda \\cdot f$\n\nAusbreitungsgeschwindigkeit = Wellenlänge mal Frequenz.",
      "category": "Q2.3 Wellen",
      "tags": ["GK", "LK"]
    },
    {
      "id": "hes_phys_q2_c13",
      "front": "Wellengleichung (eindimensionale harmonische Welle)",
      "back": "$y(x,t) = y_{max} \\cdot \\sin\\left(2\\pi \\cdot (\\frac{t}{T} - \\frac{x}{\\lambda})\\right)$",
      "category": "Q2.3 Wellen",
      "tags": ["LK"]
    },
    {
      "id": "hes_phys_q2_c14",
      "front": "Bedingung für konstruktive Interferenz (Maxima)",
      "back": "Gangunterschied $\\Delta s = k \\cdot \\lambda$\nmit $k = 0, 1, 2, ...$",
      "category": "Q2.3 Wellen",
      "tags": ["GK", "LK"]
    },

            {
              "id": "q2b_1",
              "points": 8,
              "description": "Übersetzung korrekt und vollständig"
            },
            {
              "id": "q2b_2",
              "points": 4,
              "description": "Herrschaftsdarstellung differenziert herausgearbeitet"
            },
            {
              "id": "q2b_3",
              "points": 4,
              "description": "Schlüsselstelle funktional erläutert"
            },
            {
              "id": "q2b_4",
              "points": 4,

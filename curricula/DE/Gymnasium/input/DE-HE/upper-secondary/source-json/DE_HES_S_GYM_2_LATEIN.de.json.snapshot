    {
      "id": "1edde24d-ee3f-5ff8-8a42-753c0e7f3ee9",
      "title": "Stoische Selbstprüfung bei Seneca",
      "titleEn": "Stoic Self-Examination in Seneca",
      "description": "Die lernende Person kann einen philosophischen Lateintext zu Selbstprüfung, Freiheit und sittlichem Handeln übersetzen und im Horizont der Stoa deuten.",
      "descriptionEn": "The learner can translate and interpret a philosophical Latin text on self-examination, freedom, and moral action within the horizon of Stoicism.",
      "weight": 1,
      "tags": [

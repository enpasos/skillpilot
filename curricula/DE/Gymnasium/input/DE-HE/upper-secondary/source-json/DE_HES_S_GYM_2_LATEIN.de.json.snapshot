            },
            {
              "id": "gk_b_3",
              "points": 5,
              "description": "Verhältnis von Individuum und Gemeinschaft differenziert gedeutet"
            },
            {
              "id": "gk_b_4",
              "points": 5,
              "description": "Schaubild funktional einbezogen und Staatsdeutung plausibel erläutert"
            }
          ]
        }

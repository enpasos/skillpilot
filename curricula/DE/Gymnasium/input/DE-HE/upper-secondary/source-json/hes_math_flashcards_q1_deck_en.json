{
  "deckId": "hes_math_analysis_core",
  "title": "Analysis Core (E–Q2) - Key Statements",
  "cards": [
    {
      "id": "hes_analysis_c01",
      "front": "Power rule for derivatives: $f(x) = x^n$",
      "back": "$f'(x) = n \\cdot x^{n-1}$",
      "category": "Derivative",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c02",
      "front": "Product rule:\n\n$f(x) = u(x) \\cdot v(x)$",
      "back": "$f'(x) = u'(x) \\cdot v(x) + u(x) \\cdot v'(x)$",
      "category": "Derivative",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c03",
      "front": "Chain rule: $f(x) = u(v(x))$",
      "back": "$f'(x) = u'(v(x)) \\cdot v'(x)$\n\nOuter derivative $\\cdot$ inner derivative.",
      "category": "Derivative",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c04",
      "front": "Derivative of the exponential function:\n\n$f(x) = e^{kx}$",
      "back": "$f'(x) = k \\cdot e^{kx}$",
      "category": "Derivative",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c05",
      "front": "Derivative of logarithm:\n\n$f(x) = \\ln(x)$",
      "back": "$f'(x) = \\frac{1}{x}$",
      "category": "Derivative",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c06",
      "front": "Derivative of sine:\n\n$f(x) = \\sin(x)$",
      "back": "$f'(x) = \\cos(x)$",
      "category": "Derivative",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c07",
      "front": "Derivative of cosine:\n\n$f(x) = \\cos(x)$",
      "back": "$f'(x) = -\\sin(x)$",
      "category": "Derivative",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c08",
      "front": "Necessary condition:\n\nExtremum at $x_0$",
      "back": "$f'(x_0) = 0$",
      "category": "Curve Analysis",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c09",
      "front": "Sufficient condition:\n\nLocal maximum at $x_0$",
      "back": "$f'(x_0) = 0$ and $f''(x_0) < 0$.\n\nAlternatively: sign change from + to -.",
      "category": "Curve Analysis",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c10",
      "front": "Necessary condition:\n\nInflection point at $x_0$",
      "back": "$f''(x_0) = 0$",
      "category": "Curve Analysis",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c11",
      "front": "Symmetry: axis symmetry about the y-axis",
      "back": "Must hold.\n\n$f(-x) = f(x)$",
      "category": "Properties",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c12",
      "front": "Symmetry: point symmetry about the origin",
      "back": "Must hold.\n\n$f(-x) = -f(x)$",
      "category": "Properties",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c13",
      "front": "Antiderivative of $f(x) = x^n$\n\n(for $n \\neq -1$)",
      "back": "$F(x) = \\frac{1}{n+1} x^{n+1}$",
      "category": "Integral",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c14",
      "front": "Antiderivative of $f(x) = \\frac{1}{x}$",
      "back": "$F(x) = \\ln(|x|)$",
      "category": "Integral",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c15",
      "front": "Fundamental theorem of calculus (definite integral)",
      "back": "$\\int_a^b f(x) \\ dx = F(b) - F(a)$",
      "category": "Integral",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c16",
      "front": "Average value of a function on $[a; b]$",
      "back": "$\\bar{m} = \\frac{1}{b-a} \\int_a^b f(x) \\ dx$",
      "category": "Integral",
      "tags": [
        "GK",
        "LK"
      ]
    }
  ],

        "0261c76c-376f-4342-a9d1-6e92bcffea08",
        "f3203bbe-9b90-48db-b52c-10898913ae4e",
        "1ccfd82c-874b-46b2-beef-9717b36253a9",
        "c12b422d-2511-4ef5-939c-dcd6179f2f23"
      ],
      "dimensionTags": {
        "framework": "hessen-kc-2024-chinese",
        "demandLevel": "AB3",
        "processCompetencies": [],
        "guidingIdeas": [],
        "phase": "Q1"
      },
      "examData": {
        "taskContent": "**Kontext:**\n\nEine Jugendredaktion plant einen Beitrag über Alltag, Mobilität und Mediennutzung in einer chinesischen Großstadt.\n\n**Material 1:** ein Blogeintrag über den Schulweg und das Wohnen in Beijing.  \n**Material 2:** ein kurzer Podcastausschnitt über Freizeitorte für Jugendliche.  \n**Material 3:** eine Infografik zu Smartphone-Nutzung und Nahverkehr.\n\n**Aufgaben:**\n\n1. Fasse die Hauptaussagen von Material 1 zusammen und benenne zwei Perspektiven des Textes. (5 pts)\n2. Erkläre, welche Informationen Material 2 über jugendliche Lebenswelt und Stadtwahrnehmung vermittelt. (5 pts)\n3. Vermittle die wichtigsten Ergebnisse aus Material 3 auf Deutsch für eine Austauschgruppe. (5 pts)\n4. Schreibe einen kurzen chinesischen Kommentar, in dem du Vor- und Nachteile des Stadtlebens aus den Materialien bewertest. (5 pts)",
        "solutionContent": "1. Erwartet wird eine strukturierte Zusammenfassung mit erkennbarer Perspektive des Blogtexts.  \n   **5 pts**\n\n2. Erwartet wird eine gezielte Auswertung des Hörmaterials mit Bezug zur Lebenswelt.  \n   **5 pts**\n\n3. Erwartet wird eine präzise Sprachmittlung der Infografik in adressatengerechtem Deutsch.  \n   **5 pts**\n\n4. Erwartet wird ein kurzer, kohärenter Kommentar mit nachvollziehender Bewertung.  \n   **5 pts**",
        "scoring": {
          "maxPoints": 20,
          "passingPoints": 12,
          "steps": [
            {
              "id": "s1",
              "points": 5,
              "description": "Blogeintrag strukturiert zusammengefasst und Perspektiven erkannt"
            },
            {
              "id": "s2",
              "points": 5,
              "description": "Podcastausschnitt inhaltlich passend ausgewertet"
            },
            {
              "id": "s3",
              "points": 5,
              "description": "Infografik klar und adressatengerecht vermittelt"
            },
            {
              "id": "s4",
              "points": 5,
              "description": "Kommentar mit nachvollziehender Bewertung formuliert"
            }
          ]
        }
      }
    },
    {

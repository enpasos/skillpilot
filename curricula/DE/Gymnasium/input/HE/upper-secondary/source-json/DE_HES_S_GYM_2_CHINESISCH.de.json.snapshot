        "a99c2476-10c5-49bc-b843-7afb7756e3d9",
        "6250fb3d-4daa-4330-b06c-4c3e4809ef9c",
        "a62c790a-6b5e-49f7-834b-c64d33e20e20"
      ],
      "dimensionTags": {
        "framework": "hessen-kc-2024-chinese",
        "demandLevel": "AB3",

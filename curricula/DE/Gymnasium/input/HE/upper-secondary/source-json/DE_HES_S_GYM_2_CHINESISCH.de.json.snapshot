    {
      "id": "43c52ffe-6774-552e-8d4c-e934e2e58fce",
      "shortKey": "practice_task_q1_chinese_city_podcast",
      "title": "Stadtleben zwischen Podcast, Blog und Sprachmittlung",
      "titleEn": "Urban life between podcast, blog, and mediation",
      "description": "Die lernende Person kann eine materialgestützte Q1-Aufgabe zu Medien, Stadtleben und adressatengerechter Stellungnahme im Fach Chinesisch bearbeiten.",
      "descriptionEn": "The learner can solve a material-based Q1 task on media, city life, and audience-aware commentary in Chinese.",

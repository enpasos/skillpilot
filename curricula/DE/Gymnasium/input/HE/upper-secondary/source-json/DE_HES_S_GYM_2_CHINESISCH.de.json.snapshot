            },
            {
              "id": "s3",
              "points": 5,
              "description": "Reisetabelle adressatengerecht ins Deutsche vermittelt"
            },
            {
              "id": "s4",
              "points": 5,
              "description": "Kurze Empfehlung klar und begründet formuliert"
            }
          ]
        }
      }

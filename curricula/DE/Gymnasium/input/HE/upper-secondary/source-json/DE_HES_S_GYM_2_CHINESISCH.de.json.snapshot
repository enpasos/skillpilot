    {
      "id": "bd466d44-6f2f-5984-8dee-2966131a149d",
      "shortKey": "practice_task_q3_chinese_environment_campaign",
      "title": "Umweltkampagne zwischen Kommentar, Audio und Statistik",
      "titleEn": "Environmental campaign between commentary, audio, and statistics",
      "description": "Die lernende Person kann eine materialgestützte Q3-Aufgabe zu gesellschaftlichem Wandel, Umwelt und begründeter Stellungnahme im Fach Chinesisch bearbeiten.",
      "descriptionEn": "The learner can solve a material-based Q3 task on social change, environment, and reasoned commentary in Chinese.",
      "phase": "Q3",
      "area": "Practice",
      "level": 3,
      "core": true,
      "weight": 1,
      "tags": [
        "GK",
        "LK",
        "Practice",
        "Assessment"
      ],
      "contains": [],
      "requires": [
        "84cb89d7-11dc-4d27-9f8c-347a6c58889e",
        "10e1477d-67e0-4d54-982f-bc9f803e95e5",
        "06c0c23c-50e5-49fc-a052-e6595a372f2d",
        "1e0415bb-1cfa-4670-9597-1bbcbf5fa4a3"
      ],
      "dimensionTags": {
        "framework": "hessen-kc-2024-chinese",
        "demandLevel": "AB3",
        "processCompetencies": [],
        "guidingIdeas": [],
        "phase": "Q3"
      },
      "examData": {
        "taskContent": "**Kontext:**\n\nEine Schulgruppe diskutiert, wie junge Menschen in China auf Umweltprobleme reagieren.\n\n**Material 1:** ein Kommentar über Luftqualität und Alltagsverhalten in einer Großstadt.  \n**Material 2:** ein kurzer Audio-Bericht über eine lokale Umweltkampagne.  \n**Material 3:** eine Statistik zu öffentlichem Verkehr und Emissionen.\n\n**Aufgaben:**\n\n1. Analysiere die zentrale Position von Material 1 und benenne zwei sprachliche Mittel der Argumentation. (5 pts)\n2. Erkläre, welche Handlungsoptionen Material 2 für Jugendliche sichtbar macht. (5 pts)\n3. Vermittle die Aussage von Material 3 auf Deutsch für ein Umweltprojekt in deiner Schule. (5 pts)\n4. Schreibe eine kurze chinesische Stellungnahme, in der du begründet bewertest, welche Maßnahme aus den Materialien am wirksamsten erscheint. (5 pts)",
        "solutionContent": "1. Erwartet wird eine treffende Analyse der Position und ihrer sprachlichen Ausgestaltung.  \n   **5 pts**\n\n2. Erwartet wird eine klare Einordnung der im Hörtext gezeigten Handlungsoptionen.  \n   **5 pts**\n\n3. Erwartet wird eine präzise, adressatengerechte Sprachmittlung der Statistik.  \n   **5 pts**\n\n4. Erwartet wird eine begründete und kohärente Stellungnahme mit Materialbezug.  \n   **5 pts**",
        "scoring": {
          "maxPoints": 20,
          "passingPoints": 12,
          "steps": [
            {
              "id": "s1",
              "points": 5,
              "description": "Kommentarposition und Argumentationsmittel treffend analysiert"
            },
            {
              "id": "s2",
              "points": 5,
              "description": "Handlungsoptionen aus dem Audio sinnvoll erklärt"
            },
            {
              "id": "s3",
              "points": 5,
              "description": "Statistikaussage klar und adressatengerecht vermittelt"
            },
            {
              "id": "s4",
              "points": 5,
              "description": "Stellungnahme begründet und materialgestützt verfasst"
            }
          ]
        }
      }
    },
    {
      "id": "4e043d2d-33f2-51cc-b83e-ab3f87baffd9",
      "shortKey": "practice_task_q3_chinese_history_museum_note",
      "title": "Geschichte, Museum und kulturelle Deutung im Vergleich",
      "titleEn": "History, museum, and cultural interpretation in comparison",
      "description": "Die lernende Person kann eine materialgestützte Q3-Aufgabe zu Geschichte, Kultur und reflektierter Deutung im Fach Chinesisch bearbeiten.",
      "descriptionEn": "The learner can solve a material-based Q3 task on history, culture, and reflective interpretation in Chinese.",
      "phase": "Q3",
      "area": "Practice",
      "level": 3,
      "core": true,
      "weight": 1,
      "tags": [
        "GK",
        "LK",
        "Practice",

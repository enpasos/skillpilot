        "d6381c82-9ed4-40e1-bd97-0aef4b55c55c",
        "88e78639-7c02-4d7b-8f56-2bcf50af0213",
        "16e24a8d-acd4-46ea-b936-c1a74a76004a"
      ],
      "dimensionTags": {
        "framework": "hessen-kc-2024-chinese",
        "demandLevel": "AB3",
        "processCompetencies": [],
        "guidingIdeas": [],
        "phase": "Q3"
      },
      "examData": {
        "taskContent": "**Kontext:**\n\nFür ein digitales Museumsheft vergleichst du historische Erinnerung und kulturelle Darstellung.\n\n**Material 1:** eine kurze Museumsnotiz zu einem historischen Ereignis.  \n**Material 2:** ein Hörimpuls mit Aussagen einer jungen Besucherin.  \n**Material 3:** ein Begleittext zur Bedeutung des Ereignisses für heutige Identität.\n\n**Aufgaben:**\n\n1. Fasse Material 1 in eigenen Worten zusammen und benenne seine zentrale Perspektive. (5 pts)\n2. Erkläre, welche Sichtweise Material 2 zusätzlich eröffnet. (5 pts)\n3. Vermittle die Kernaussagen von Material 3 auf Deutsch für ein Begleitheft. (5 pts)\n4. Verfasse eine kurze chinesische Notiz, in der du erklärst, warum historische Erinnerung für junge Menschen relevant bleiben kann. (5 pts)",
        "solutionContent": "1. Erwartet wird eine strukturierte Zusammenfassung mit Perspektivenerkennung.  \n   **5 pts**\n\n2. Erwartet wird eine sinnvolle Erklärung der zusätzlichen Hörperspektive.  \n   **5 pts**\n\n3. Erwartet wird eine präzise Sprachmittlung des Begleittexts.  \n   **5 pts**\n\n4. Erwartet wird eine reflektierte und verständliche Notiz mit Gegenwartsbezug.  \n   **5 pts**",
        "scoring": {
          "maxPoints": 20,
          "passingPoints": 12,
          "steps": [
            {
              "id": "s1",
              "points": 5,
              "description": "Museumsnotiz korrekt zusammengefasst und Perspektive erkannt"
            },
            {
              "id": "s2",
              "points": 5,
              "description": "Zusätzliche Sichtweise aus dem Hörimpuls passend erläutert"
            },
            {
              "id": "s3",
              "points": 5,
              "description": "Begleittext adressatengerecht ins Deutsche vermittelt"
            },
            {
              "id": "s4",
              "points": 5,
              "description": "Kurze Notiz reflektiert und kohärent formuliert"
            }
          ]
        }
      }
    },

              "points": 7,
              "description": "Chancen und Grenzen technischer Innovation differenziert erläutert"
            },
            {
              "id": "q3_3",
              "points": 8,
              "description": "Spanischer Kommentar mit materialgestützten Vorschlägen schlüssig verfasst"
            }
          ]
        }

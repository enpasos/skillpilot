              "id": "q1b_2",
              "points": 6,
              "description": "Chancen und Risiken digitaler Meinungsbildung differenziert analysiert"
            },
            {
              "id": "q1b_3",
              "points": 8,
              "description": "Spanischer Kommentar reflektiert, materialgebunden und sprachlich stimmig verfasst"
            }
          ]

        "30b2b3da-9613-42ca-8e28-27dfc61771b6"
      ],
      "dimensionTags": {
        "framework": "hessen-kc-2024-chemistry",
        "demandLevel": "AB2",
        "processCompetencies": [
          "PK2_MODELLIEREN",
          "PK4_KOMMUNIZIEREN",
          "PK5_BEWERTEN"
        ],
        "guidingIdeas": [
          "BC_AUFBAU",
          "BC_AUFBAU"
        ],

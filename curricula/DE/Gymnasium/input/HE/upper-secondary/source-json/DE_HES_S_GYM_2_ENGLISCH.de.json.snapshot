        "81166ed9-85fb-4097-915a-51800f70a61a",
        "11079440-96ce-4946-b6c2-2a9a4cd32414"
      ],
      "dimensionTags": {
        "framework": "hessen-kc-2024-english",
        "demandLevel": "AB3",
        "processCompetencies": [],
        "guidingIdeas": [],
        "phase": "Abitur"
      },
      "examData": {
        "taskContent": "**Part 2 - Writing with integrated reading comprehension**\n\n**Material 1:** dramatic or narrative extract about a protagonist facing a public moral dilemma.  \n**Material 2:** feature article on gender constructions in digital media.  \n**Material 3:** commentary and data set on hate speech, diversity and media responsibility in multicultural Britain.\n\n**Tasks:**\n\n1. Analyse the conflict structure and moral pressure in material 1. (8 pts)\n2. Explain how material 2 constructs and critiques gender roles. (7 pts)\n3. Comment on the relevance of material 3 for multicultural societies and media ethics. (5 pts)\n4. Write a critical article on whether digital media intensify human dilemmas instead of helping to solve them. (10 pts)",
        "solutionContent": "A strong solution analyses the conflict structure with precision, explains the gender perspective critically, comments on diversity and media-ethics material with contextual awareness and writes a differentiated critical article.  \n**30 pts**",
        "scoring": {
          "maxPoints": 30,
          "passingPoints": 18,
          "steps": [
            {
              "id": "s1",
              "points": 8,
              "description": "Conflict structure analysed precisely"
            },
            {
              "id": "s2",
              "points": 7,
              "description": "Gender constructions explained critically"
            },
            {
              "id": "s3",
              "points": 5,
              "description": "Media ethics and diversity material commented on well"
            },
            {
              "id": "s4",
              "points": 10,
              "description": "Critical article differentiated and coherent"
            }
          ]
        }
      },
      "phase": "Abitur"
    },

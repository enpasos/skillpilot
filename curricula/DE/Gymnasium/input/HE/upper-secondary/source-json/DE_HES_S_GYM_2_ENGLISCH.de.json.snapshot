    {
      "id": "c8bce40d-e6e8-5359-9903-838b235c2427",
      "shortKey": "english_lk_2026_a",
      "title": "Pflichtaufgabe A (LK) - Mediation: Globalization, sustainability and British policy choices",
      "titleEn": "Mandatory task A (LK) - Mediation: globalization, sustainability and British policy choices",
      "description": "Die lernende Person kann im Leistungskurs eine vertiefte Sprachmittlungsaufgabe zu Globalisierung, Nachhaltigkeit und britischer Gesellschaft auf Abiturniveau bearbeiten.",
      "descriptionEn": "The learner can solve an advanced-course mediation task on globalization, sustainability and British society at Abitur level.",
      "weight": 1,
      "tags": [
        "LK",
        "Assessment"
      ],
      "contains": [],
      "requires": [
        "11079440-96ce-4946-b6c2-2a9a4cd32414",
        "4837e662-9247-4e97-9f05-5cdef20ab169",
        "abe139ac-47cf-4b59-bb25-76565864921e"
      ],
      "dimensionTags": {
        "framework": "hessen-kc-2024-english",
        "demandLevel": "AB3",
        "processCompetencies": [],
        "guidingIdeas": [],
        "phase": "Abitur"
      },
      "examData": {
        "taskContent": "**Part 1 - Mediation**\n\nYou are preparing an English briefing paper for an international youth policy roundtable.\n\n**Material 1 (German):** background article on British industrial policy, offshore wind and regional inequality.  \n**Material 2 (German):** interview extract on digitalization, outsourcing and sustainable growth.\n\n**Task:**\n\nWrite an English briefing paper (about 300 words).\n\n1. Select and structure the information relevant for an international audience. (5 pts)\n2. Mediate complex arguments and key data precisely in English. (5 pts)\n3. Explain tensions between economic competitiveness and sustainability. (5 pts)\n4. Adapt register, tone and line of reasoning to a policy audience. (5 pts)",
        "solutionContent": "A strong solution selects, restructures and mediates relevant German information accurately, explains policy tensions clearly and maintains a precise, audience-appropriate briefing register.  \n**20 pts**",
        "scoring": {

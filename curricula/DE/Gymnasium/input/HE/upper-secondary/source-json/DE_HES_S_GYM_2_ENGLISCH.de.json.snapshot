      ],
      "contains": [],
      "requires": [
        "11079440-96ce-4946-b6c2-2a9a4cd32414",
        "4837e662-9247-4e97-9f05-5cdef20ab169"
      ],
      "dimensionTags": {
        "framework": "hessen-kc-2024-english",
        "demandLevel": "AB2",
        "processCompetencies": [],
        "guidingIdeas": [],
        "phase": "Abitur"
      },
      "examData": {
        "taskContent": "**Part 1 - Mediation**\n\nYou are helping a youth delegation from Manchester prepare for a German-English climate partnership event.\n\n**Material 1 (German):** a short newspaper report on energy-intensive data centres and regional jobs in the UK.  \n**Material 2 (German):** an infographic on offshore wind power, electricity prices and digital infrastructure.\n\n**Task:**\n\nWrite an English briefing note (about 250 words) for the youth delegation.\n\n1. Select the information that is relevant for an international audience. (5 pts)\n2. Mediate the central arguments and figures accurately in English. (5 pts)\n3. Explain how sustainability and digital change are connected in this debate. (5 pts)\n4. Use an appropriate register and structure for a formal briefing note. (5 pts)",
        "solutionContent": "A strong solution selects relevant information, mediates factual content accurately, explains the connection between sustainability and digitalization clearly, and uses a formal English register throughout.  \n**20 pts**",
        "scoring": {
          "maxPoints": 20,
          "passingPoints": 12,
          "steps": [
            {
              "id": "s1",
              "points": 5,
              "description": "Relevant information selected appropriately"
            },
            {
              "id": "s2",
              "points": 5,
              "description": "Central arguments and figures mediated accurately"
            },
            {
              "id": "s3",
              "points": 5,
              "description": "Sustainability and digital change linked coherently"
            },
            {
              "id": "s4",
              "points": 5,
              "description": "Formal register and structure used appropriately"
            }
          ]
        }
      },
      "phase": "Abitur"
    },

      ]
    },
    {
      "id": "hes_phys_e_c03",
      "front": "Zeit-Ort-Gesetz des freien Falls \n(ohne Anfangsgeschwindigkeit)",
      "back": "$s(t) = \\frac{1}{2} g \\cdot t^2$\n\nmit der Fallbeschleunigung\n\n$g \\approx 9,81 \\frac{m}{s^2}$",
      "category": "E.1 Bewegungen",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_phys_e_c04",
      "front": "1. Newtonsches Axiom (Trägheitsgesetz)",
      "back": "Ein Körper verharrt im Zustand der Ruhe oder der gleichförmigen, geradlinigen Bewegung, solange keine resultierende Kraft auf ihn wirkt. Definiert Inertialsysteme.",
      "category": "E.2 Newton & Erhaltung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_phys_e_c05",
      "front": "2. Newtonsches Axiom \n\nAktionsprinzip\nGrundgleichung der Mechanik",
      "back": "$\\vec{F} = \\frac{d\\vec{p}}{dt}$ mit $\\vec{p}=m\\vec{v}$\n\n\nFalls $m$ konstant:\n\n\n$\\vec{F} = m\\vec{a}$",
      "category": "E.2 Newton & Erhaltung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_phys_e_c06",
      "front": "3. Newtonsches Axiom (Wechselwirkungsprinzip)",
      "back": "\"Actio gleich Reactio\" \n\nÜbt ein Körper A eine Kraft auf einen Körper B aus, so übt Körper B eine gleich große, aber entgegengerichtete Kraft auf Körper A aus",
      "category": "E.2 Newton & Erhaltung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_phys_e_c07",
      "front": "Formel für kinetische Energie $E_{kin}$",
      "back": "$E_{kin} = \\frac{1}{2} m \\cdot v^2$",
      "category": "E.2 Newton & Erhaltung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_phys_e_c08",
      "front": "Definition des Impulses $\\vec{p}$",
      "back": "$\\vec{p} = m \\cdot \\vec{v}$\n\nErhaltungsgröße in abgeschlossenen Systemen (z. B. bei Stößen)",
      "category": "E.2 Newton & Erhaltung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_phys_e_c09",
      "front": "Superpositionsprinzip \n(am Beispiel waagerechter Wurf)",
      "back": "Unterschiedliche Teilbewegungen \n(z. B. horizontal gleichförmig \nund vertikal beschleunigt) \nlaufen ungestört voneinander ab und überlagern sich zur Gesamtbewegung",
      "category": "E.3 Wurf & Kreis",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_phys_e_c10",
      "front": "Zentripetalkraft $F_Z$ (Betrag)",
      "back": "$F_Z = m \\cdot \\frac{v^2}{r} = m \\cdot \\omega^2 \\cdot r$\n\nDie Kraft, die einen Körper auf einer Kreisbahn hält (zum Zentrum gerichtet)",
      "category": "E.3 Wurf & Kreis",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_phys_e_c11",

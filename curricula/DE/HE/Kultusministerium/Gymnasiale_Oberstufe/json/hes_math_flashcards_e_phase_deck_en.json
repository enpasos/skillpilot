  "cards": [
    {
      "id": "hes_funbas_c01",
      "front": "Slope formula for a line through $P_1(x_1|y_1)$ and $P_2(x_2|y_2)$",
      "back": "$m = \\frac{y_2 - y_1}{x_2 - x_1}$",
      "category": "Linear Functions",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c02",
      "front": "Vertex form of a parabola and vertex $S$",
      "back": "$f(x) = a(x-d)^2 + e$ $\\rightarrow S(d|e)$",
      "category": "Quadratic Functions",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c03",
      "front": "Shift in x-direction: what does $f(x-c)$ with $c>0$ do?",
      "back": "Shifts the graph $c$ units to the right.",
      "category": "Transformations",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c04",
      "front": "Vertical stretch: what is the term?",
      "back": "$g(x) = k \\cdot f(x)$\n\nStretches the graph vertically by factor $k$.",
      "category": "Transformations",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c05",
      "front": "Zero-product property (solving equations)",
      "back": "A product is zero iff at least one factor is zero.\n\n$a \\cdot b = 0 \\Rightarrow a=0 \\vee b=0$",
      "category": "Equations",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c06",
      "front": "Zeros of the exponential function ($e^x = 0$)",
      "back": "None.\n\nThe exponential function is positive for all $x$.\n$e^x > 0$",
      "category": "Equations",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c07",
      "front": "Definition of the logarithm: solve $a^x = b$ for $x$ ($a,b > 0, a \\neq 1$)",
      "back": "$x = \\log_a(b)$\n\nBase $e$: $x = \\ln(b)$",
      "category": "Equations",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c08",
      "front": "General sine function\n\n$f(x) = a \\cdot \\sin(b(x-c)) + d$\n\nMeaning of $b$?",
      "back": "$b$ determines the period length.\n\n$p = \\frac{2\\pi}{b}$",
      "category": "Trigonometry",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c09",
      "front": "End behavior:\n\n$f(x) = x^n$\n\nfor $x \\to -\\infty$ (n odd)",
      "back": "$f(x) \\to -\\infty$\n\nThe graph comes from the lower left.",
      "category": "Polynomials",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c10",
      "front": "Arithmetic sequence: recursive formula",
      "back": "$a_{n+1} = a_n + d$\n\nConstant difference.",
      "category": "Sequences",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c11",
      "front": "Geometric sequence: explicit formula",
      "back": "$a_n = a_1 \\cdot q^{n-1}$\n\nConstant ratio $q$.",
      "category": "Sequences",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c12",
      "front": "Exponent rule:\n\n$x^a \\cdot x^b = ...$",
      "back": "$x^{a+b}$",
      "category": "Rules of Exponents",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_funbas_c13",
      "front": "p-q formula:\n\nSolve $x^2 + px + q = 0$",
      "back": "$x_{1,2} = -\\frac{p}{2} \\pm \\sqrt{\\left(\\frac{p}{2}\\right)^2 - q}$",
      "category": "Equations",
      "tags": [
        "GK",
        "LK"
      ]
    }

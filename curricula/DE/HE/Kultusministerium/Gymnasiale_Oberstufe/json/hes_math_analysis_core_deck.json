{
  "deckId": "hes_math_analysis_core",
  "title": "Analysis-Core (E-Q2) - Kernaussagen",
  "cards": [
    {
      "id": "hes_analysis_c01",
      "front": "Ableitungsregel für Potenzen: $f(x) = x^n$",
      "back": "$f'(x) = n \\cdot x^{n-1}$",
      "category": "Ableitung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c02",
      "front": "Produktregel: $f(x) = u(x) \\cdot v(x)$",
      "back": "$f'(x) = u'(x) \\cdot v(x) + u(x) \\cdot v'(x)$",
      "category": "Ableitung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c03",
      "front": "Kettenregel: $f(x) = u(v(x))$",
      "back": "$f'(x) = u'(v(x)) \\cdot v'(x)$ (Äußere Ableitung \\cdot Innere Ableitung)",
      "category": "Ableitung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c04",
      "front": "Ableitung e-Funktion: $f(x) = e^{kx}$",
      "back": "$f'(x) = k \\cdot e^{kx}$",
      "category": "Ableitung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c05",
      "front": "Ableitung Logarithmus: $f(x) = \\ln(x)$",
      "back": "$f'(x) = \\frac{1}{x}$",
      "category": "Ableitung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c06",
      "front": "Ableitung Sinus: $f(x) = \\sin(x)$",
      "back": "$f'(x) = \\cos(x)$",
      "category": "Ableitung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c07",
      "front": "Ableitung Kosinus: $f(x) = \\cos(x)$",
      "back": "$f'(x) = -\\sin(x)$",
      "category": "Ableitung",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c08",
      "front": "Notwendige Bedingung: Extremstelle bei $x_0$",
      "back": "$f'(x_0) = 0$",
      "category": "Kurvendiskussion",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c09",
      "front": "Hinreichende Bedingung: Hochpunkt bei $x_0$",
      "back": "$f'(x_0) = 0$ und $f''(x_0) < 0$ (oder Vorzeichenwechsel von + nach -)",
      "category": "Kurvendiskussion",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c10",
      "front": "Notwendige Bedingung: Wendestelle bei $x_0$",
      "back": "$f''(x_0) = 0$",
      "category": "Kurvendiskussion",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c11",
      "front": "Symmetrie: Achsensymmetrie zur y-Achse",
      "back": "Es muss gelten: $f(-x) = f(x)$",
      "category": "Eigenschaften",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c12",
      "front": "Symmetrie: Punktsymmetrie zum Ursprung",
      "back": "Es muss gelten: $f(-x) = -f(x)$",
      "category": "Eigenschaften",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c13",
      "front": "Stammfunktion von $f(x) = x^n$ (für $n \\neq -1$)",
      "back": "$F(x) = \\frac{1}{n+1} x^{n+1}$",
      "category": "Integral",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c14",
      "front": "Stammfunktion von $f(x) = \\frac{1}{x}$",
      "back": "$F(x) = \\ln(|x|)$",
      "category": "Integral",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c15",
      "front": "Hauptsatz der Analysis (bestimmtes Integral)",
      "back": "$\\int_a^b f(x) \\, dx = F(b) - F(a)$",
      "category": "Integral",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_analysis_c16",
      "front": "Mittelwert einer Funktion auf $[a; b]$",
      "back": "$\\bar{m} = \\frac{1}{b-a} \\int_a^b f(x) \\, dx$",
      "category": "Integral",
      "tags": [
        "GK",
        "LK"
      ]
    }
  ],

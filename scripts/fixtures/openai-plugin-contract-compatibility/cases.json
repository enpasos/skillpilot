{
  "baseline": {
    "contract": {
      "serverInstructions": "Follow the published V1 coaching workflow.",
      "tools": [
        {
          "name": "get_context",
          "description": "Load context.",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "learningSessionId"
            ],
            "properties": {
              "learningSessionId": {
                "type": "string",
                "pattern": "^sps_"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "stateVersion"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "retry"
                ]
              },
              "stateVersion": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "extensions": {
                "type": "object",
                "additionalProperties": true,
                "properties": {}
              }
            }
          },
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false,
            "idempotentHint": true,
            "openWorldHint": false,
            "returnDirect": false
          },
          "meta": {
            "securitySchemes": [
              {
                "type": "oauth2",
                "scopes": [
                  "skillpilot.read"
                ]
              }
            ]
          }
        },
        {
          "name": "set_scope",
          "description": "Set scope.",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "learningSessionId",
              "expectedStateVersion",
              "clientRequestId"
            ],
            "properties": {
              "learningSessionId": {
                "type": "string",
                "pattern": "^sps_"
              },
              "expectedStateVersion": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "clientRequestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "stateVersion"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "saved"
                ]
              },
              "stateVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          },
          "annotations": {
            "readOnlyHint": false,
            "destructiveHint": false,
            "idempotentHint": true,
            "openWorldHint": false,
            "returnDirect": false
          },
          "meta": {
            "securitySchemes": [
              {
                "type": "oauth2",
                "scopes": [
                  "skillpilot.write"
                ]
              }
            ]
          }
        }
      ]
    },
    "toolsList": [
      "get_context",
      "set_scope"
    ],
    "securitySchemes": {
      "get_context": [
        {
          "type": "oauth2",
          "scopes": [
            "skillpilot.read"
          ]
        }
      ],
      "set_scope": [
        {
          "type": "oauth2",
          "scopes": [
            "skillpilot.write"
          ]
        }
      ]
    },
    "errorCatalog": {
      "schemaVersion": 1,
      "contractMajor": 1,
      "errors": [
        {
          "code": "STATE_VERSION_CONFLICT",
          "category": "conflict",
          "retryable": true,
          "stateChanged": false,
          "recovery": "Reload context once and retry with the fresh version."
        }
      ]
    },
    "resources": [
      {
        "uri": "skillpilot://v1/policy",
        "contentSha256": "policy-v1"
      }
    ],
    "skillsBundle": {
      "schemaVersion": 1,
      "files": [
        {
          "path": "coach/SKILL.md",
          "bytes": 100,
          "sha256": "skill-v1"
        }
      ]
    },
    "uiManifest": {
      "schemaVersion": 1,
      "enabled": true,
      "origin": "https://ui-v1.skillpilot.test",
      "resources": [
        {
          "uri": "ui://skillpilot/v1/cockpit",
          "mimeType": "text/html",
          "contentSha256": "cockpit-v1"
        }
      ]
    }
  },
  "cases": [
    {
      "name": "compatible additive optional fields and relaxed input constraints",
      "compatible": true,
      "operations": [
        {
          "op": "set",
          "path": [
            "contract",
            "tools",
            0,
            "description"
          ],
          "value": "Load the current context."
        },
        {
          "op": "set",
          "path": [
            "contract",
            "tools",
            0,
            "inputSchema",
            "properties",
            "locale"
          ],
          "value": {
            "type": "string"
          }
        },
        {
          "op": "set",
          "path": [
            "contract",
            "tools",
            0,
            "outputSchema",
            "properties",
            "extensions",
            "properties",
            "traceId"
          ],
          "value": {
            "type": "string"
          }
        },
        {
          "op": "set",
          "path": [
            "contract",
            "tools",
            1,
            "inputSchema",
            "properties",
            "expectedStateVersion",
            "maximum"
          ],
          "value": 200
        },
        {
          "op": "set",
          "path": [
            "contract",
            "tools",
            1,
            "inputSchema",
            "required"
          ],
          "value": [
            "learningSessionId",
            "clientRequestId"
          ]
        },
        {
          "op": "set",
          "path": [
            "contract",
            "tools",
            0,
            "outputSchema",
            "required"
          ],
          "value": [
            "status",
            "stateVersion",
            "extensions"
          ]
        }
      ]
    },
    {

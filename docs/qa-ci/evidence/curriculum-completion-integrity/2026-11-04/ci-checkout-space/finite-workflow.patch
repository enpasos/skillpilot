+          df -h .
+          df -i .
+          du -sh .git
+          required_bytes=$((8 * 1024 * 1024 * 1024))
+          available_bytes="$(df -B1 --output=avail . | tail -n 1)"
+          if [ "${available_bytes}" -lt "${required_bytes}" ]; then
+            echo "::error::Dependencies and builds need ${required_bytes} free bytes after checkout; only ${available_bytes} remain."
+            exit 1
+          fi

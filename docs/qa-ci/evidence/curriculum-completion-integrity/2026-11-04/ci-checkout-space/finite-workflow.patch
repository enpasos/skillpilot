-          df -h .
+          test "${RUNNER_OS:-}" = Linux
+          df -h "${GITHUB_WORKSPACE}"
+          df -i "${GITHUB_WORKSPACE}"
+          # Keep Python, Java/JDK caches and system build tools; set up Node below.
+          sudo rm -rf -- \
+            /usr/local/lib/android /usr/share/dotnet /opt/ghc /usr/local/.ghcup \
+            /usr/share/swift /usr/local/julia* /usr/share/miniconda \
+            /opt/az /opt/microsoft/powershell /usr/local/share/powershell \
+            /usr/local/share/boost /usr/local/share/vcpkg \
+            /home/linuxbrew "${HOME}/.rustup" "${HOME}/.cargo"
+          if [ -d /opt/hostedtoolcache ]; then
+            sudo find /opt/hostedtoolcache -mindepth 1 -maxdepth 1 \
+              ! -name Python ! -name 'Java*' -exec rm -rf -- {} +
+          fi
+          if ! sudo docker image prune --all --force; then
+            echo "::warning::Docker image cleanup unavailable; the disk budget is still required."
+          fi
+          sudo apt-get clean
+          df -h "${GITHUB_WORKSPACE}"
+          df -i "${GITHUB_WORKSPACE}"
+          # 43 GiB worktree + 15 GiB shallow Git reserve + 8 GiB dependencies/builds.
+          required_bytes=$((66 * 1024 * 1024 * 1024))
+          available_bytes="$(df -B1 --output=avail "${GITHUB_WORKSPACE}" | tail -n 1)"
+          if [ "${available_bytes}" -lt "${required_bytes}" ]; then
+            echo "::error::Full checkout needs ${required_bytes} free bytes; only ${available_bytes} are available after cleanup."
+            exit 1
+          fi
       - name: Checkout
         uses: actions/checkout@v6

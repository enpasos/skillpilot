  "contract": {
    "authority": "Private factory capability from the actual unchanged preparer/capture, externally pinned preparation/tree bytes, actual bound sources and existing preparation lock; no caller verified boolean or JSON receipt capability",
    "membership": "Complete immediate selected roleRoot membership: every entry name/type, symlink text and direct file bytes/sha; actual root device/inode; captured before launch and exactly rechecked after launch under the preparation lock",
    "actualMount": "Existing actual selected roleRoot -> same roleRoot RO bind, genuine capture namespace mount, private recorder protection and exact original/candidate role; parent evidence is minted only after real launch and unchanged postconditions",
    "sourceAndToolSeparation": "All selected original/projected source/tool input paths require complete matching bindings. Catalog/document payloads must retain source classification. Every selected source/tool and detached output path is protected from absence classification",
    "unrepresentedSourceOverlays": "Actual binary or directory source overlays not represented by this small readonly namespace adapter prevent minting any parent capability. A real captured UTF16 source fixture with an empty root stub proves this rejection",
    "emptyForestEquivalence": "The unchanged preparer declares four asset forests even when empty. Under the same preparation binding/lock, actual canonical nonsymlink source and target directories must both have completely empty immediate membership before and after the launch; selectedFiles=0 alone is insufficient",
    "derivedSearchDomain": "Ordinary Node ancestor module-search directory construction from the actually read capture-bound JS entry anchor. Only generated candidates whose immediate parent is exactly this roleRoot are eligible; no failed pathname is a policy input",
    "executableContext": "Exact measured Node SHA and actual directly launched Node PID; its last successful exec before the actual event must still be that Node. Child/other executables and thread-PID generalization are not authorized",
    "events": "Exact actual launch event, supported readonly directory metadata operation, understood flags, PID/cwd/dirfd consistency and actual ENOENT. Failed payload opens, existing members, missing source inputs, unknown roots and higher parents remain errors",
    "sharedMetadataParser": "Existing dependency metadata flags/errno/locator parsing is factored without policy change and reused; no second lookup policy or curriculum scope engine"
  },

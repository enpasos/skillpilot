      "source": "import { readFileSync, writeFileSync } from 'node:fs'\nimport { createHash } from 'node:crypto'\nimport assert from 'node:assert/strict'\nimport { checkSkillGraphIntegrity } from '../app/scripts/lib/skillGraphIntegrity'\nconst application=JSON.parse(readFileSync('tmp/global-orientation-cycle-active-application.json','utf8'))\nconst hash=(value:Uint8Array|string)=>createHash('sha256').update(value).digest('hex')\nconst inputs=application.activeContextSources.map((row:{path:string;sha256:string})=>{\n const raw=readFileSync(row.path);assert.equal(hash(raw),row.sha256,row.path)\n return {...JSON.parse(raw.toString('utf8')),sourceFile:row.path}\n})\nassert.equal(inputs.length,21);assert.equal(new Set(inputs.map((r:any)=>r.landscapeId)).size,21)\nconst rows=inputs.map((document:any)=>{\n const report=checkSkillGraphIntegrity(inputs,[document.landscapeId]);const g15=report.checks.find(row=>row.id==='G15')!;const g42=report.checks.find(row=>row.id==='G42')!\n assert.ok(report.checkedGoalKeys.length>0);assert.equal(g15.status,'pass');assert.equal(g42.status,'pass');assert.equal(g15.findingCount,0);assert.equal(g42.findingCount,0)\n return {landscapeId:document.landscapeId,checkedGoalKeys:report.checkedGoalKeys.length,G15:g15.status,G15FindingCount:g15.findingCount,G42:g42.status,G42FindingCount:g42.findingCount}\n})\nfor(const row of application.activeContextSources)assert.equal(hash(readFileSync(row.path)),row.sha256)\nconst summary={landscapes:21,G15Pass:rows.filter(row=>row.G15==='pass').length,G42Pass:rows.filter(row=>row.G42==='pass').length,G15Findings:rows.reduce((n,row)=>n+row.G15FindingCount,0),G42Findings:rows.reduce((n,row)=>n+row.G42FindingCount,0)}\nconst result={summary,rows,sourceDataChanged:false,completeStrictIntegrityPassClaimed:false,implementations:['app/scripts/lib/skillGraphIntegrity.ts','app/scripts/auditTransitiveMinimality.ts'].map(path=>({path,sha256:hash(readFileSync(path))}))}\nwriteFileSync('tmp/global-orientation-active-dags-scalars.json',JSON.stringify(result,null,2)+'\\n')\nconsole.log(JSON.stringify(summary))\n"
    },

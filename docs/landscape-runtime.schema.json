{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.local/schema/landscape-runtime.schema.json",
  "title": "LearningLandscape (Runtime Fields Only)",
  "description": "Schema for the runtime contract used by the app. Additional metadata is allowed at the top level and per goal.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "landscapeId",
    "title",
    "description",
    "goals"
  ],
  "properties": {
    "landscapeId": {
      "type": "string",
      "description": "Landscape identifier used for routing and cross-landscape references."
    },
    "title": {
      "type": "string",
      "description": "Landscape title for the file locale."
    },
    "titleEn": {
      "type": "string",
      "description": "Landscape title in English (optional)."
    },
    "description": {
      "type": "string",
      "description": "Landscape description for the file locale."
    },
    "descriptionEn": {
      "type": "string",
      "description": "Landscape description in English (optional)."
    },
    "locale": {
      "type": "string",
      "description": "Locale code (e.g. de-DE)."
    },
    "frameworkId": {
      "type": "string",
      "description": "Framework identifier."
    },
    "country": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "schoolType": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "description": "Optional subject label shown in external prerequisite references."
    },
    "filters": {
      "type": "array",
      "description": "Optional UI filters (e.g., GK/LK).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal"
      }
    }
  },
  "$defs": {
    "goal": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "description",
        "weight",
        "contains",
        "requires",
        "dimensionTags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Goal UUID."
        },
        "shortKey": {
          "type": "string",
          "description": "Stable ASCII identifier used across persistence/export layers."
        },
        "title": {
          "type": "string",
          "description": "Goal title for the file locale."
        },
        "titleEn": {
          "type": "string",
          "description": "Goal title in English (optional)."
        },
        "description": {
          "type": "string",
          "description": "Goal description for the file locale."
        },
        "descriptionEn": {
          "type": "string",
          "description": "Goal description in English (optional)."
        },
        "sourceRef": {
          "type": "string",
          "description": "Canonical provenance reference for this goal; preferably a stable URL when available, otherwise a citation string."
        },
        "resourceLinks": {
          "type": "array",
          "description": "Canonical helpful learning resources for this goal, ordered by pedagogical priority.",
          "items": {
            "$ref": "#/$defs/resourceLink"
          }
        },
        "core": {
          "type": "boolean",
          "description": "Whether the goal is part of the core/default path."
        },
        "weight": {
          "type": "number",
          "description": "Weight used for aggregated mastery."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Filter and UI tags (e.g., GK/LK)."
        },
        "contains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Child goal IDs (contains edges)."
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Prerequisite goal IDs (requires edges)."
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional example task IDs or labels."
        },
        "courseLevel": {
          "type": "string",
          "description": "Optional course-level marker such as GK/LK/both."
        },
        "themenfeld": {
          "type": "string",
          "description": "Optional explicit topic field code."
        },
        "leitideen": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional guiding-idea tags."
        },
        "kompetenzen": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional process-competency tags."
        },
        "dimensionTags": {
          "type": "object",
          "required": [
            "phase"
          ],
          "properties": {
            "framework": {
              "type": "string"
            },
            "demandLevel": {
              "type": "string"
            },
            "processCompetencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "guidingIdeas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "phase": {
              "type": "string",
              "description": "Phase code used for ordering (e.g., E, Q1, Q2, Q3, Q4, J11)."
            },
            "area": {
              "type": "string"
            },
            "topicCode": {
              "type": "string"
            }
          },
          "description": "Only `phase` is required. Runtime may derive UI fields from the other known tags; additional dimension tags are allowed.",
          "additionalProperties": true
        },
        "extendedData": {
          "type": "object",
          "description": "Arbitrary extra data (e.g. SRS deck config)."
        },
        "type": {
          "type": "string",
          "enum": [
            "atomic",
            "cluster"
          ],
          "description": "Optional explicit node type."
        },
        "nodeKind": {
          "type": "string",
          "enum": [
            "exam",
            "tutor",
            "memory"
          ],
          "description": "Optional explicit node kind."
        },
        "oerContent": {
          "$ref": "#/$defs/oerContent",
          "description": "Legacy transitional OER metadata. Prefer `resourceLinks` for canonical helpful learning resources."
        },
        "experimentData": {
          "$ref": "#/$defs/experimentData",
          "description": "Optional structured experiment description."
        },
        "examData": {
          "type": "object",
          "required": [
            "taskContent",
            "solutionContent",
            "scoring"
          ],
          "properties": {
            "taskContent": {
              "type": "string",
              "description": "Markdown with LaTeX/images"
            },
            "taskContentEn": {
              "type": "string",
              "description": "English translation (optional)"
            },
            "solutionContent": {
              "type": "string",
              "description": "Markdown with solution/grading steps"
            },
            "solutionContentEn": {
              "type": "string",
              "description": "English translation (optional)"
            },
            "scoring": {
              "type": "object",
              "required": [
                "maxPoints",
                "passingPoints",
                "steps"
              ],
              "properties": {
                "maxPoints": {
                  "type": "number"
                },
                "passingPoints": {
                  "type": "number"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "points",
                      "description"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "points": {
                        "type": "number"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "resourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "url"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "Didactic role, e.g. overview, concept, practice, assessment, solution, reference."
        },
        "title": {
          "type": "string",
          "description": "Short user-facing label."
        },
        "url": {
          "type": "string",
          "description": "Absolute target URL."
        },
        "resourceType": {
          "type": "string",
          "description": "Concrete material kind, e.g. course-page, video, notes, article, simulation, problem-set, exam, solution-set, book, tool."
        },
        "provider": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "lang": {
          "type": "string",
          "description": "Optional BCP-47 language tag of the linked resource."
        },
        "license": {
          "type": "string"
        }
      }
    },
    "oerContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "experimentData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

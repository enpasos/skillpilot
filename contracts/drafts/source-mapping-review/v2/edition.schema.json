{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/contracts/drafts/source-mapping-review/v2/edition.schema.json",
  "title": "Registered source edition used for effective decision selection",
  "type": "object",
  "properties": {
    "targetLandscapeId": {
      "type": "string",
      "pattern": "\\S"
    },
    "sourceId": {
      "type": "string",
      "pattern": "\\S"
    },
    "sourceLandscapeId": {
      "type": "string",
      "pattern": "\\S"
    },
    "edition": {
      "type": "string",
      "pattern": "\\S"
    },
    "sourceExtractionPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[:\\\\])[^/].*[^/]$|^[a-zA-Z0-9]$"
    },
    "legacyReviewPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[:\\\\])[^/].*[^/]$|^[a-zA-Z0-9]$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "selectedReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceGoalId": {
            "type": "string",
            "pattern": "\\S"
          },
          "reviewPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[:\\\\])[^/].*[^/]$|^[a-zA-Z0-9]$"
          }
        },
        "required": ["sourceGoalId", "reviewPath"]
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceGoalId": {
            "type": "string",
            "pattern": "\\S"
          },
          "wording": {
            "type": "string",
            "pattern": "\\S"
          },
          "parentContext": {
            "type": "array",
            "description": "Applicable enclosing source goals, passages, and extraction scope metadata derived from the pinned source extraction.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["sourceGoal", "passage", "extraction"] },
                "id": { "type": "string", "pattern": "\\S" },
                "contextSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              },
              "required": ["kind", "id", "contextSha256"]
            }
          },
          "applicableScopeIds": {
            "type": "array",
            "description": "Authoritative applicable scope IDs for the official row. Include any course, branch, year, or module qualification required to distinguish scopes.",
            "items": { "type": "string", "pattern": "\\S" },
            "minItems": 1,
            "uniqueItems": true
          },
          "regularTargetsByScope": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "\\S"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "minProperties": 1
          },
          "sourceRecordSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "sourceGoalId",
          "wording",
          "parentContext",
          "applicableScopeIds",
          "regularTargetsByScope",
          "sourceRecordSha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sourceExtractionSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "historicalExtractions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[:\\\\])[^/].*[^/]$|^[a-zA-Z0-9]$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "retiredRowSuccessors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceGoalId": { "type": "string", "pattern": "\\S" },
          "successorSourceGoalId": { "type": "string", "pattern": "\\S" },
          "successorRowSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Digest of the current successor row, including the edition, context and applicable scopes."
          }
        },
        "required": ["sourceGoalId", "successorSourceGoalId", "successorRowSha256"],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "retainedLegacyReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[:\\\\])[^/].*[^/]$|^[a-zA-Z0-9]$"
          },
          "edition": {
            "type": "string",
            "pattern": "\\S"
          },
          "sourceExtractionPath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[:\\\\])[^/].*[^/]$|^[a-zA-Z0-9]$"
          },
          "sourceExtractionSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "edition",
          "sourceExtractionPath",
          "sourceExtractionSha256"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "targetLandscapeId",
    "sourceId",
    "sourceLandscapeId",
    "edition",
    "sourceExtractionPath",
    "legacyReviewPaths",
    "selectedReviews",
    "rows",
    "sourceExtractionSha256"
  ],
  "additionalProperties": false
}

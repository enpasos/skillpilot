{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/assessment-completion/v1/scope.schema.json",
  "title": "Authoritative assessment completion scope",
  "description": "A curriculum unit referencing canonical subtrees or individual goals. It contains no inline goal definitions, learner selection, mastery or waiver results.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "title", "targetRootIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "revision": { "$ref": "#/$defs/nonblank" },
    "title": {
      "type": "object",
      "required": ["de", "en"],
      "properties": {
        "de": { "$ref": "#/$defs/nonblank" },
        "en": { "$ref": "#/$defs/nonblank" }
      },
      "additionalProperties": { "$ref": "#/$defs/nonblank" }
    },
    "targetRootIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonblank" }
    }
  },
  "$defs": {
    "nonblank": { "type": "string", "minLength": 1, "pattern": "\\S" }
  }
}

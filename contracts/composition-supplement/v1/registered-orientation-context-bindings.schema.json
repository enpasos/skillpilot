{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/composition-supplement/v1/registered-orientation-context-bindings.schema.json",
  "title": "Fixed registered runtime orientation context bindings; no curricular content assessment authority",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "bindingContract",
      "receiptSha256",
      "landscapeId",
      "goalId",
      "rawGoalSha256",
      "kindDecisionSha256",
      "completionContract",
      "canonicalSourceBinding",
      "semanticKindSourceBinding"
    ],
    "properties": {
      "bindingContract": {
        "const": "registered-math-orientation-context-v1"
      },
      "receiptSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "landscapeId": {
        "const": "68a8ac50-f5f5-4e24-8aa9-5e408ca01ced"
      },
      "goalId": {
        "type": "string",
        "minLength": 1
      },
      "rawGoalSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "kindDecisionSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "completionContract": {
        "const": "orientation-binary-completion-v1"
      },
      "canonicalSourceBinding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "file"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "semanticKindSourceBinding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "file"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}

{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "reviewFormatVersion",
    "reviewId",
    "supplementSha256",
    "ownerLandscapeId",
    "scope",
    "compatibleBaseViewIds",
    "baseViewBindings",
    "decision",
    "authorId",
    "reviewerId",
    "conditions",
    "dissent",
    "mathGoalBindings",
    "physicsContext",
    "physicsGoalBindings",
    "sourceBindings",
    "targetAuthorizations",
    "mathTeachingClosureSha256"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/composition-supplement/v1/didactic-inference-review.schema.json"
    },
    "reviewFormatVersion": {
      "const": "1.0"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
    },
    "supplementSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ownerLandscapeId": {
      "const": "68a8ac50-f5f5-4e24-8aa9-5e408ca01ced"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schoolForm",
        "jurisdiction",
        "stage"
      ],
      "properties": {
        "schoolForm": {
          "const": "Gymnasium"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^DE(?:-[A-Z]{2})?$"
        },
        "stage": {
          "enum": [
            "SekI",
            "SekII"
          ]
        },
        "durationModel": {
          "enum": [
            "G8",
            "G9"
          ]
        },
        "courseProfile": {
          "enum": [
            "GK",
            "LK",
            "GK+LK"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "SekI"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "courseProfile"
              ]
            }
          },
          "else": {
            "required": [
              "courseProfile"
            ]
          }
        }
      ]
    },
    "compatibleBaseViewIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
      }
    },
    "baseViewBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "viewId",
          "viewSha256"
        ],
        "properties": {
          "viewId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
          },
          "viewSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "decision": {
      "const": "accepted"
    },
    "authorId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
    },
    "reviewerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
    },
    "conditions": {
      "type": "array",
      "maxItems": 0
    },
    "dissent": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      }
    },
    "mathGoalBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId",
          "goalSha256",
          "semanticKind",
          "nativeAcceptanceSha256"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
          },
          "goalSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "semanticKind": {
            "const": "curricularAtomic"
          },
          "nativeAcceptanceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "physicsContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landscapeId",
        "viewId",
        "viewSha256",
        "scope"
      ],
      "properties": {
        "landscapeId": {
          "const": "7f6fc60c-9fcc-4cc2-b07e-f897a1d0338a"
        },
        "viewId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
        },
        "viewSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schoolForm",
            "jurisdiction",
            "stage"
          ],
          "properties": {
            "schoolForm": {
              "const": "Gymnasium"
            },
            "jurisdiction": {
              "type": "string",
              "pattern": "^DE(?:-[A-Z]{2})?$"
            },
            "stage": {
              "enum": [
                "SekI",
                "SekII"
              ]
            },
            "durationModel": {
              "enum": [
                "G8",
                "G9"
              ]
            },
            "courseProfile": {
              "enum": [
                "GK",
                "LK",
                "GK+LK"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "stage": {
                    "const": "SekI"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "courseProfile"
                  ]
                }
              },
              "else": {
                "required": [
                  "courseProfile"
                ]
              }
            }
          ]
        }
      }
    },
    "physicsGoalBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId",
          "goalSha256",
          "semanticKind",
          "nativeAcceptanceSha256"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
          },
          "goalSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "semanticKind": {
            "const": "curricularAtomic"
          },
          "nativeAcceptanceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "sourceBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "subject",
          "edition",
          "cohort",
          "anchor",
          "officialUrl",
          "retainedEvidence"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
          },
          "subject": {
            "const": "Physics"
          },
          "edition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "cohort": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "officialUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "retainedEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "targetAuthorizations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId",
          "classification",
          "regularMathematicsSourceCoverageClaim",
          "physicsDependentGoalIds",
          "mandatoryOperation",
          "mathematicalInference",
          "inputAvailability",
          "wholePerformanceAlternatives",
          "minimality",
          "decision"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
          },
          "classification": {
            "enum": [
              "reviewed-didactic-mathematics-supplement-motivated-by-physics",
              "regular-mathematics-source-backed"
            ]
          },
          "regularMathematicsSourceCoverageClaim": {
            "type": "boolean"
          },
          "physicsDependentGoalIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,299}$"
            }
          },
          "mandatoryOperation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "mathematicalInference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "inputAvailability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "decision",
              "rationale"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "supplied",
                  "retained",
                  "independently-derived"
                ]
              },
              "decision": {
                "const": "accepted"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
              }
            }
          },
          "wholePerformanceAlternatives": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "minimality": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "decision": {
            "const": "accepted"
          },
          "regularMathematicsSourceReview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "regular-mathematics-source-backed"
                }
              }
            },
            "then": {
              "required": [
                "regularMathematicsSourceReview"
              ],
              "properties": {
                "regularMathematicsSourceCoverageClaim": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "regularMathematicsSourceCoverageClaim": {
                  "const": false
                }
              },
              "not": {
                "required": [
                  "regularMathematicsSourceReview"
                ]
              }
            }
          }
        ]
      }
    },
    "mathTeachingClosureSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/composition-supplement/v1/didactic-inference-review.schema.json",
  "title": "Reviewed didactic Math preparation motivated by Physics v1",
  "description": "Author and independent reviewer must differ. Complete current runtime Goal/P hashes, native Kind and D/P/A/M/V artifact identities, exact view bytes, closure, input availability and retained source evidence are runtime-validated. This record never grants regular Mathematics source coverage."
}

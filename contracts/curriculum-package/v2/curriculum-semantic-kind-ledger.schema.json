{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/curriculum-package/v2/curriculum-semantic-kind-ledger.schema.json",
  "title": "SkillPilot semantic-kind ledger v2 with reviewed directed-quantity-arrow use",
  "$ref": "#/$defs/semanticKindLedger",
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "semanticKind": {
      "enum": [
        "curricularAtomic",
        "curricularArea",
        "practiceAssessment",
        "programStructure",
        "memory",
        "runtimeSupport",
        "orientation"
      ]
    },
    "semanticKindCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curricularAtomic",
        "curricularArea",
        "practiceAssessment",
        "programStructure",
        "memory",
        "runtimeSupport",
        "orientation",
        "total"
      ],
      "properties": {
        "curricularAtomic": {
          "type": "integer",
          "minimum": 0
        },
        "curricularArea": {
          "type": "integer",
          "minimum": 0
        },
        "practiceAssessment": {
          "type": "integer",
          "minimum": 0
        },
        "programStructure": {
          "type": "integer",
          "minimum": 0
        },
        "memory": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeSupport": {
          "type": "integer",
          "minimum": 0
        },
        "orientation": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "semanticKindDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalId",
        "sourceFingerprint",
        "semanticKind",
        "decisionStatus",
        "decisionBasis",
        "directedQuantityArrows"
      ],
      "properties": {
        "goalId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceFingerprint": {
          "$ref": "#/$defs/sha256Digest"
        },
        "semanticKind": {
          "$ref": "#/$defs/semanticKind"
        },
        "decisionStatus": {
          "const": "authoritative"
        },
        "decisionBasis": {
          "type": "string",
          "enum": [
            "reviewed-current-pilot-curricular-atomic",
            "reviewed-current-pilot-curricular-area",
            "reviewed-current-pilot-practice-assessment",
            "reviewed-current-pilot-program-structure",
            "reviewed-current-pilot-memory",
            "reviewed-current-pilot-runtime-support",
            "reviewed-current-pilot-orientation",
            "individually-reviewed-route-assessment-follow-up-2026-08-16",
            "reviewed-current-orientation-milestone-follow-up",
            "reviewed-current-post-split-curricular-area",
            "reviewed-current-post-split-curricular-atomic",
            "reviewed-current-post-split-practice-assessment",
            "reviewed-current-semantic-recheck-curricular-atomic",
            "reviewed-current-structural-split-curricular-area",
            "reviewed-current-structural-split-curricular-atomic"
          ]
        },
        "directedQuantityArrows": {
          "$ref": "#/$defs/directedQuantityArrows"
        }
      }
    },
    "semanticKindLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "documentType",
        "ledgerFormatVersion",
        "ledgerId",
        "profileId",
        "profileVersion",
        "sourceLandscapeId",
        "sourceLandscapePath",
        "sourceFingerprintContractId",
        "reviewMethod",
        "counts",
        "decisions"
      ],
      "properties": {
        "$schema": {
          "const": "https://skillpilot.com/schemas/curriculum-package/v2/curriculum-semantic-kind-ledger.schema.json"
        },
        "documentType": {
          "const": "semantic-kind-ledger"
        },
        "ledgerFormatVersion": {
          "const": 2
        },
        "ledgerId": {
          "$ref": "#/$defs/stableId"
        },
        "profileId": {
          "$ref": "#/$defs/stableId"
        },
        "profileVersion": {
          "$ref": "#/$defs/semver"
        },
        "sourceLandscapeId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceLandscapePath": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sourceFingerprintContractId": {
          "const": "semantic-kind-source-fingerprint-v1"
        },
        "reviewMethod": {
          "const": "one-time-reviewed-pilot-migration-v1"
        },
        "counts": {
          "$ref": "#/$defs/semanticKindCounts"
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/$defs/semanticKindDecision"
          }
        }
      }
    },
    "directedQuantityArrows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage",
        "representationKinds",
        "evidence"
      ],
      "properties": {
        "usage": {
          "enum": [
            "required",
            "notRequired",
            "children"
          ]
        },
        "representationKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "spatialQuantityArrow",
              "fieldLineConvention",
              "displacementArrow",
              "circuitReference",
              "phasor",
              "formulaVector",
              "otherRepresentation",
              "none",
              "containedGoals"
            ]
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "entryId"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/repositoryPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256Digest"
            },
            "entryId": {
              "$ref": "#/$defs/stableId"
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/curriculum-package/v1.3/stage-plan.schema.json",
  "title": "SkillPilot stage plan 1.0 - candidate",
  "description": "One Land/duration authority with the same two-stage root and optional explicit year/phase children. Semantic validation checks complete parent membership, unique temporal slots, sibling after chains and source/authoring basis. The original unsplit two-stage format remains valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "planFormatVersion",
    "planId",
    "scope",
    "rootUnit",
    "units",
    "subjectViews"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/curriculum-package/v1.3/stage-plan.schema.json"
    },
    "planFormatVersion": {
      "const": "1.0"
    },
    "planId": {
      "$ref": "#/$defs/id"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schoolForm",
        "jurisdiction",
        "durationModel"
      ],
      "properties": {
        "schoolForm": {
          "$ref": "#/$defs/nonBlankText"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^DE-[A-Z]{2}$"
        },
        "durationModel": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "rootUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "children"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/nonBlankText"
        },
        "children": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "subjectViews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "landscapeId",
          "courseProfile",
          "viewId"
        ],
        "properties": {
          "landscapeId": {
            "$ref": "#/$defs/id"
          },
          "courseProfile": {
            "$ref": "#/$defs/nonBlankText"
          },
          "viewId": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "stage",
        "parentUnitId",
        "after"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/nonBlankText"
        },
        "kind": {
          "enum": [
            "stage",
            "year",
            "phase"
          ]
        },
        "stage": {
          "enum": [
            "SekI",
            "SekII"
          ]
        },
        "parentUnitId": {
          "$ref": "#/$defs/id"
        },
        "after": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "labelEn": {
          "$ref": "#/$defs/nonBlankText"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13
        },
        "phase": {
          "enum": [
            "E",
            "Q1",
            "Q2",
            "Q3",
            "Q4"
          ]
        },
        "basis": {
          "$ref": "#/$defs/unitBasis"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "stage"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "year"
                  ]
                },
                {
                  "required": [
                    "phase"
                  ]
                },
                {
                  "required": [
                    "basis"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "year"
              }
            }
          },
          "then": {
            "required": [
              "year",
              "basis"
            ],
            "properties": {
              "stage": {
                "const": "SekI"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "phase"
                  ]
                },
                {
                  "required": [
                    "children"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "phase"
              }
            }
          },
          "then": {
            "required": [
              "phase",
              "basis"
            ],
            "properties": {
              "stage": {
                "const": "SekII"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "year"
                  ]
                },
                {
                  "required": [
                    "children"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "unitBasis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "references"
          ],
          "properties": {
            "kind": {
              "const": "officialSource"
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonBlankText"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "references",
            "rationale"
          ],
          "properties": {
            "kind": {
              "const": "reviewedStructure"
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonBlankText"
              }
            },
            "rationale": {
              "$ref": "#/$defs/nonBlankText"
            }
          }
        }
      ]
    }
  }
}

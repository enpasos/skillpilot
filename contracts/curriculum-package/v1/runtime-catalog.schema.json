{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/curriculum-package/v1/runtime-catalog.schema.json",
  "title": "SkillPilot curriculum runtime catalog v1",
  "description": "Strict discovery and resolution catalog for a full-standalone-v1 curriculum package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "catalogVersion",
    "runtimeContractVersion",
    "releaseBinding",
    "rootLandscapeIds",
    "landscapes",
    "scopeDimensions",
    "views",
    "offeredScopes",
    "decks",
    "resources",
    "artifactIndexes",
    "dependencyClosure",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/curriculum-package/v1/runtime-catalog.schema.json"
    },
    "catalogVersion": {
      "const": "1.0"
    },
    "runtimeContractVersion": {
      "const": "1.0"
    },
    "releaseBinding": {
      "$ref": "#/$defs/releaseBinding"
    },
    "rootLandscapeIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "landscapes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/landscape"
      }
    },
    "scopeDimensions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/scopeDimension"
      }
    },
    "views": {
      "type": "array",
      "maxItems": 60000,
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "offeredScopes": {
      "type": "array",
      "maxItems": 60000,
      "items": {
        "$ref": "#/$defs/offeredScope"
      }
    },
    "decks": {
      "type": "array",
      "maxItems": 60000,
      "items": {
        "$ref": "#/$defs/deck"
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 60000,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "artifactIndexes": {
      "$ref": "#/$defs/artifactIndexes"
    },
    "dependencyClosure": {
      "$ref": "#/$defs/dependencyClosure"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "compositionViews",
          "memoryCards",
          "goalVisualizations",
          "embeddedDependencies"
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "packageRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$"
    },
    "scope": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "releaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "contentDigest"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "contentDigest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerPackageId",
        "sourceReleaseId",
        "fragmentOfLandscapeId",
        "recordDigest"
      ],
      "properties": {
        "ownerPackageId": {
          "$ref": "#/$defs/id"
        },
        "sourceReleaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "fragmentOfLandscapeId": {
          "$ref": "#/$defs/id"
        },
        "recordDigest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "landscape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landscapeId",
        "role",
        "artifactPath",
        "locale",
        "frameworkId",
        "subject"
      ],
      "properties": {
        "landscapeId": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "root",
            "module",
            "embedded-fragment"
          ]
        },
        "artifactPath": {
          "$ref": "#/$defs/packageRelativePath"
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "frameworkId": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 3
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "schoolForm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "defaultOfferingId": {
          "$ref": "#/$defs/id"
        },
        "parentLandscapeId": {
          "$ref": "#/$defs/id"
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "embedded-fragment"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "ownership"
            ]
          },
          "else": {
            "not": {
              "required": [
                "ownership"
              ]
            }
          }
        }
        ,
        {
          "if": {
            "properties": {
              "role": {
                "const": "module"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "parentLandscapeId"
            ]
          },
          "else": {
            "not": {
              "required": [
                "parentLandscapeId"
              ]
            }
          }
        }
      ]
    },
    "scopeComposite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "members"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scopeDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "composites": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/scopeComposite"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewId",
        "landscapeId",
        "artifactPath",
        "scope"
      ],
      "properties": {
        "viewId": {
          "$ref": "#/$defs/id"
        },
        "landscapeId": {
          "$ref": "#/$defs/id"
        },
        "artifactPath": {
          "$ref": "#/$defs/packageRelativePath"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      }
    },
    "viewResolution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "viewIds"
          ],
          "properties": {
            "mode": {
              "const": "single"
            },
            "viewIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "mergeDimension",
            "viewIds"
          ],
          "properties": {
            "mode": {
              "const": "merge"
            },
            "mergeDimension": {
              "$ref": "#/$defs/id"
            },
            "viewIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ]
    },
    "offeredScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offeringId",
        "landscapeId",
        "scope",
        "viewResolution"
      ],
      "properties": {
        "offeringId": {
          "$ref": "#/$defs/id"
        },
        "landscapeId": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "viewResolution": {
          "$ref": "#/$defs/viewResolution"
        }
      }
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deckId",
        "locale",
        "landscapeId",
        "artifactPath"
      ],
      "properties": {
        "deckId": {
          "$ref": "#/$defs/id"
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "landscapeId": {
          "$ref": "#/$defs/id"
        },
        "artifactPath": {
          "$ref": "#/$defs/packageRelativePath"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "resourceKind",
        "landscapeId",
        "goalId",
        "delivery",
        "runtimeRequired",
        "mediaType"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/id"
        },
        "resourceKind": {
          "const": "goal-visualization"
        },
        "landscapeId": {
          "$ref": "#/$defs/id"
        },
        "goalId": {
          "$ref": "#/$defs/id"
        },
        "delivery": {
          "enum": [
            "embedded",
            "external"
          ]
        },
        "runtimeRequired": {
          "type": "boolean"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "artifactPath": {
          "$ref": "#/$defs/packageRelativePath"
        },
        "externalUrl": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "embedded"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "required": [
              "artifactPath"
            ],
            "not": {
              "required": [
                "externalUrl"
              ]
            }
          },
          "else": {
            "required": [
              "externalUrl"
            ],
            "properties": {
              "runtimeRequired": {
                "const": false
              }
            },
            "not": {
              "required": [
                "artifactPath"
              ]
            }
          }
        }
      ]
    },
    "artifactIndexes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compositionViewsPath",
        "cardsPath",
        "resourcesPath",
        "migrationAliasesPath"
      ],
      "properties": {
        "compositionViewsPath": {
          "$ref": "#/$defs/packageRelativePath"
        },
        "cardsPath": {
          "$ref": "#/$defs/packageRelativePath"
        },
        "resourcesPath": {
          "$ref": "#/$defs/packageRelativePath"
        },
        "migrationAliasesPath": {
          "$ref": "#/$defs/packageRelativePath"
        }
      }
    },
    "dependencyClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "strategy",
        "externalRuntimeDependencies"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/packageRelativePath"
        },
        "strategy": {
          "const": "embedded-transitive-v1"
        },
        "externalRuntimeDependencies": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}

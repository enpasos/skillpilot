{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/curriculum-package/v1/fwu-owl-package-profile.schema.json",
  "title": "SkillPilot Core-first FWU-OWL package profile v1",
  "description": "Closed profile contract for inventory roles, RDF segment order, offline trust, Core binding, archive security, validation gates, and reproducible FWU-OWL ZIP construction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "profileFormatVersion",
    "profileId",
    "profileVersion",
    "description",
    "compatibility",
    "inventoryPolicy",
    "archiveLimits",
    "manifestLimits",
    "jsonPolicy",
    "checksumPolicy",
    "securityPolicy",
    "rdfPolicy",
    "declarationPolicy",
    "coreProjectionPolicy",
    "coreBindingPolicy",
    "applicationProfilePolicy",
    "shapesPolicy",
    "schemaCatalogPolicy",
    "contractPolicy",
    "sourceJsonBindingPolicy",
    "semanticContentPolicy",
    "releaseSupportPolicy",
    "resourceCapabilities",
    "roles",
    "validationGates",
    "reproducibility"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/curriculum-package/v1/fwu-owl-package-profile.schema.json"
    },
    "profileFormatVersion": {
      "const": 1
    },
    "profileId": {
      "const": "fwu-owl-v1"
    },
    "profileVersion": {
      "const": "1.0.0"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "inventoryPolicy": {
      "$ref": "#/$defs/inventoryPolicy"
    },
    "archiveLimits": {
      "$ref": "#/$defs/archiveLimits"
    },
    "manifestLimits": {
      "$ref": "#/$defs/manifestLimits"
    },
    "jsonPolicy": {
      "$ref": "#/$defs/jsonPolicy"
    },
    "checksumPolicy": {
      "$ref": "#/$defs/checksumPolicy"
    },
    "securityPolicy": {
      "$ref": "#/$defs/securityPolicy"
    },
    "rdfPolicy": {
      "$ref": "#/$defs/rdfPolicy"
    },
    "declarationPolicy": {
      "$ref": "#/$defs/declarationPolicy"
    },
    "coreProjectionPolicy": {
      "$ref": "#/$defs/coreProjectionPolicy"
    },
    "coreBindingPolicy": {
      "$ref": "#/$defs/coreBindingPolicy"
    },
    "applicationProfilePolicy": {
      "$ref": "#/$defs/applicationProfilePolicy"
    },
    "shapesPolicy": {
      "$ref": "#/$defs/shapesPolicy"
    },
    "schemaCatalogPolicy": {
      "$ref": "#/$defs/schemaCatalogPolicy"
    },
    "contractPolicy": {
      "$ref": "#/$defs/contractPolicy"
    },
    "sourceJsonBindingPolicy": {
      "$ref": "#/$defs/sourceJsonBindingPolicy"
    },
    "semanticContentPolicy": {
      "$ref": "#/$defs/semanticContentPolicy"
    },
    "releaseSupportPolicy": {
      "$ref": "#/$defs/releaseSupportPolicy"
    },
    "resourceCapabilities": {
      "$ref": "#/$defs/resourceCapabilities"
    },
    "roles": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/roleRule"
      }
    },
    "validationGates": {
      "$ref": "#/$defs/validationGateIds"
    },
    "reproducibility": {
      "$ref": "#/$defs/reproducibility"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
    },
    "role": {
      "enum": [
        "rdf-segment",
        "rdf-bundle",
        "package-profile",
        "contract-schema",
        "schema-catalog",
        "contract",
        "semantic-content-index",
        "ontology-core",
        "ontology-profile",
        "ontology-shapes",
        "ontology-catalog",
        "binary-resource",
        "release-support",
        "license"
      ]
    },
    "semanticBindingKind": {
      "enum": [
        "normative-rdf-segment",
        "generated-rdf-bundle",
        "contract",
        "schema-catalog",
        "ontology-core",
        "ontology-profile",
        "ontology-shapes",
        "ontology-catalog",
        "binary-resource",
        "semantic-content-index",
        "release-support",
        "license"
      ]

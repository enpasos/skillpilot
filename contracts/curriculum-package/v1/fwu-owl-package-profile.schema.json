    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageFormatVersion",
        "variant",
        "manifestSchemaId",
        "validationReportSchemaId"
      ],
      "properties": {
        "packageFormatVersion": {
          "const": "1.0"
        },
        "variant": {
          "const": "fwu-owl"
        },
        "manifestSchemaId": {
          "const": "https://skillpilot.com/schemas/curriculum-package/v1/fwu-owl-package-manifest.schema.json"
        },
        "validationReportSchemaId": {
          "const": "https://skillpilot.com/schemas/curriculum-package/v1/fwu-owl-package-validation-report.schema.json"
        }
      }
    },
    "inventoryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathBase",
        "allowUnknownRoles",
        "requireExactFileSet",
        "excludedPaths"
      ],
      "properties": {
        "pathBase": {
          "const": "archive-root-relative"
        },
        "allowUnknownRoles": {
          "const": false
        },
        "requireExactFileSet": {
          "const": true
        },
        "excludedPaths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "const": "metadata/manifest.json" },
            { "const": "metadata/SHA256SUMS" }
          ],
          "items": false
        }
      }
    },
    "archiveLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outerZipBytes",
        "entryCount",
        "genericEntryBytes",
        "rdfSegmentBytes",
        "rdfBundleBytes",
        "binaryResourceBytes",
        "binaryLaneBytes",
        "totalUncompressedBytes",
        "archivePathBytes",
        "jsonEntryBytes",
        "jsonMaxDepth",
        "jsonMaxNodes"
      ],
      "properties": {
        "outerZipBytes": { "const": 3500000000 },
        "entryCount": { "const": 60000 },
        "genericEntryBytes": { "const": 1000000000 },
        "rdfSegmentBytes": { "const": 536870912 },
        "rdfBundleBytes": { "const": 1000000000 },
        "binaryResourceBytes": { "const": 67108864 },
        "binaryLaneBytes": { "const": 3000000000 },
        "totalUncompressedBytes": { "const": 8000000000 },
        "archivePathBytes": { "const": 240 },
        "jsonEntryBytes": { "const": 67108864 },
        "jsonMaxDepth": { "const": 128 },
        "jsonMaxNodes": { "const": 5000000 }
      }

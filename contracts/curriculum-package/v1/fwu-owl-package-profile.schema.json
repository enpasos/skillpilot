      "properties": {
        "regularFilesOnly": { "const": true },
        "symlinksAllowed": { "const": false },
        "directoriesAllowed": { "const": false },
        "duplicatePathsAllowed": { "const": false },
        "caseFoldCollisionsAllowed": { "const": false },
        "unicodeNormalizationCollisionsAllowed": { "const": false },
        "absolutePathsAllowed": { "const": false },
        "parentTraversalAllowed": { "const": false },
        "backslashesAllowed": { "const": false },
        "nestedArchivesAllowed": { "const": false },
        "zip64Allowed": { "const": false },
        "dataDescriptorsAllowed": { "const": false },
        "encryptedEntriesAllowed": { "const": false },
        "archiveCommentsAllowed": { "const": false },

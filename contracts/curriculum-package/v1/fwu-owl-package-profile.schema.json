      "properties": {
        "path": { "const": "metadata/SHA256SUMS" },
        "format": { "const": "lowercase-sha256-two-spaces-root-relative-path-lf-v1" },
        "entryOrder": { "const": "unicode-code-point-path-order" },
        "coverage": { "const": "every-other-archive-entry-including-manifest" },
        "selfEntryAllowed": { "const": false },
        "finalNewline": { "const": true }
      }
    },
    "securityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regularFilesOnly",
        "symlinksAllowed",
        "directoriesAllowed",
        "duplicatePathsAllowed",
        "caseFoldCollisionsAllowed",
        "unicodeNormalizationCollisionsAllowed",
        "absolutePathsAllowed",
        "parentTraversalAllowed",
        "backslashesAllowed",
        "nestedArchivesAllowed",
        "zip64Allowed",
        "dataDescriptorsAllowed",
        "encryptedEntriesAllowed",
        "archiveCommentsAllowed",
        "entryCommentsAllowed",
        "extraFieldsAllowed",
        "localCentralHeaderMismatchAllowed",
        "overlappingEntriesAllowed",
        "trailingBytesAllowed",
        "multiDiskAllowed",
        "fileDirectoryPrefixCollisionsAllowed",

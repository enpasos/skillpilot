    "manifestLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestBytes",
        "fileRecords",
        "licenseDocuments"
      ],
      "properties": {
        "manifestBytes": { "const": 67108864 },
        "fileRecords": { "const": 59998 },
        "licenseDocuments": { "const": 1024 }
      }
    },
    "jsonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "duplicateObjectKeys",
        "nonFiniteNumbers",
        "invalidUnicode",
        "depthLimitSource",
        "nodeLimitSource",
        "entryByteLimitSource"

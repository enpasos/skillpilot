{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/curriculum-package/v1/source-goal-reference-index.schema.json",
  "title": "SkillPilot source-goal reference index v1",
  "description": "Closed publication-evidence projection that binds every reviewed source goal to reviewed, source-aligned authored wording, a stable official source document, and optional locators without repository-local paths. The wording is evidence aligned to the cited source; it is not asserted to be a verbatim official quotation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "sourceGoalReferenceFormatVersion",
    "targetLandscapeId",
    "sourceCollectionCount",
    "sourceGoalCount",
    "collections"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/curriculum-package/v1/source-goal-reference-index.schema.json"
    },
    "sourceGoalReferenceFormatVersion": {
      "const": "1.0"
    },
    "targetLandscapeId": {
      "$ref": "#/$defs/stableId"
    },
    "sourceCollectionCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "sourceGoalCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/sourceGoalCollection"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceGoalCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCollectionId",
        "sourceLandscapeId",
        "sourceGoalCount",
        "sourceGoals"
      ],
      "properties": {
        "sourceCollectionId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceLandscapeId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceGoalCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "sourceGoals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": {
            "$ref": "#/$defs/sourceGoal"
          }
        }
      }
    },
    "sourceGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceGoalId",
        "sourceDocumentId",
        "title",
        "description",
        "sourceText",
        "sourceTextSha256",
        "locator"
      ],
      "properties": {
        "sourceGoalId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceDocumentId": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "$ref": "#/$defs/nonBlank"
        },
        "description": {
          "$ref": "#/$defs/nonBlank"
        },
        "sourceText": {
          "allOf": [
            { "$ref": "#/$defs/nonBlank" },
            {
              "description": "Reviewed, source-aligned authored wording for the cited source passage; not necessarily a verbatim quotation."
            }
          ]
        },
        "sourceTextSha256": {
          "allOf": [
            { "$ref": "#/$defs/sha256Digest" },
            {
              "description": "SHA-256 digest of the UTF-8 bytes of sourceText exactly as published in this artifact; it authenticates the reviewed authored wording, not the bytes or exact wording of an official source document."
            }
          ]
        },
        "parentBulletText": {
          "$ref": "#/$defs/nonBlank"
        },
        "locator": {
          "$ref": "#/$defs/sourceLocator"
        },
        "classification": {
          "$ref": "#/$defs/sourceClassification"
        },
        "lineage": {
          "$ref": "#/$defs/sourceLineage"
        }
      }
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passageId",
        "topicCode",
        "sourceSpan",
        "sourceRef"
      ],
      "properties": {
        "passageId": {
          "$ref": "#/$defs/nonBlank"
        },
        "topicCode": {
          "$ref": "#/$defs/nonBlank"
        },
        "sourceSpan": {
          "$ref": "#/$defs/nonBlank"
        },
        "sourceRef": {
          "$ref": "#/$defs/nonBlank"
        },
        "sourcePage": {
          "type": "integer",
          "minimum": 0
        },
        "sourceLine": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceClassification": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "granularity": {
          "$ref": "#/$defs/nonBlank"
        },
        "category": {
          "$ref": "#/$defs/nonBlank"
        },
        "stage": {
          "$ref": "#/$defs/nonBlank"
        },
        "phase": {
          "$ref": "#/$defs/nonBlank"
        },
        "courseLevel": {
          "$ref": "#/$defs/nonBlank"
        },
        "grade": {
          "$ref": "#/$defs/nonBlank"
        },
        "area": {
          "$ref": "#/$defs/nonBlank"
        },
        "level": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "sourceLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "splitFromSourceGoalId",
        "splitIndex",
        "splitPartCount"
      ],
      "properties": {
        "splitFromSourceGoalId": {
          "$ref": "#/$defs/stableId"
        },
        "splitIndex": {
          "type": "integer",
          "minimum": 1
        },
        "splitPartCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

    {
      "id": "duplicate-schema-id",
      "mutations": [
        {
          "operation": "duplicate-entry-id",
          "fromSchemaId": "https://skillpilot.com/schemas/fixtures/v1/fixture-shared.schema.json",
          "toSchemaId": "https://skillpilot.com/schemas/fixtures/v1/fixture-document.schema.json"
        }
      ],
      "expectedDiagnostics": [
        {
          "code": "CATALOG_ID_DUPLICATE",
          "location": "/entries"
        }
      ]
    },
    {
      "id": "duplicate-schema-path",
      "mutations": [
        {
          "operation": "set-entry-field",

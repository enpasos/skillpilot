        },
        {
          "code": "SCHEMA_FILE_UNLISTED",
          "location": "/files/schemas/fixture-shared.schema.json"
        },
        {
          "code": "SCHEMA_ID_MISMATCH",
          "location": "/files/schemas/fixture-document.schema.json/$id"
        },
        {
          "code": "SCHEMA_REF_FRAGMENT_UNRESOLVED",
          "location": "/schemas/fixture-document.schema.json/properties/id/$ref"
        },
        {
          "code": "SCHEMA_REMOTE_RETRIEVAL_ATTEMPT",
          "location": "/entries"
        }
      ]
    },

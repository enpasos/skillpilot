{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/curriculum-package/v1/release-model-build-profile.schema.json",
  "title": "SkillPilot curriculum release-model build profile v1",
  "description": "Trusted, authoring-side input selection and relocation policy for deterministic compilation into the closed runtime release model. This profile is not shipped as executable package code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "profileFormatVersion",
    "profileId",
    "profileVersion",
    "package",
    "contracts",
    "canonicalLandscape",
    "compositionViews",
    "cardDecks",
    "resources",
    "pathRelocations",
    "expectedCounts"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/curriculum-package/v1/release-model-build-profile.schema.json"
    },
    "profileFormatVersion": {
      "const": 1
    },
    "profileId": {
      "$ref": "#/$defs/id"
    },
    "profileVersion": {
      "$ref": "#/$defs/semver"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "packageVersion",
        "releaseId",
        "curriculumEdition",
        "subject",
        "locale"
      ],
      "properties": {
        "packageId": {
          "$ref": "#/$defs/id"
        },
        "packageVersion": {
          "$ref": "#/$defs/semver"
        },
        "releaseId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "curriculumEdition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "locale": {
          "$ref": "#/$defs/locale"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeContractVersion",
        "fieldSemanticsRegistryPath",
        "normalizationProfilePath",
        "ontologyProfilePath",
        "ontologyProfileSha256",
        "ontologyNamespaceBindingsSha256"
      ],
      "properties": {
        "runtimeContractVersion": {
          "const": "1.0"
        },
        "fieldSemanticsRegistryPath": {
          "$ref": "#/$defs/repositoryPath"
        },
        "normalizationProfilePath": {
          "$ref": "#/$defs/repositoryPath"
        },
        "ontologyProfilePath": {
          "$ref": "#/$defs/repositoryPath"
        },
        "ontologyProfileSha256": {
          "$ref": "#/$defs/sha256"
        },
        "ontologyNamespaceBindingsSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "canonicalLandscape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "outputPath",
        "landscapeId",
        "rootGoalId",
        "semanticKindLedgerPath"
      ],
      "properties": {
        "sourcePath": {
          "$ref": "#/$defs/repositoryPath"
        },
        "outputPath": {
          "$ref": "#/$defs/packagePath"
        },
        "landscapeId": {
          "$ref": "#/$defs/id"
        },
        "rootGoalId": {
          "$ref": "#/$defs/id"
        },
        "semanticKindLedgerPath": {
          "$ref": "#/$defs/repositoryPath"
        }
      }
    },
    "compositionViews": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDirectory",
        "outputDirectory",
        "locale",
        "defaultViewId"
      ],
      "properties": {
        "sourceDirectory": {
          "$ref": "#/$defs/repositoryPath"
        },
        "outputDirectory": {
          "$ref": "#/$defs/packagePath"
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "defaultViewId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "cardDecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourcePath",
          "outputPath",
          "locale"
        ],
        "properties": {
          "sourcePath": {
            "$ref": "#/$defs/repositoryPath"
          },
          "outputPath": {
            "$ref": "#/$defs/packagePath"
          },
          "locale": {
            "$ref": "#/$defs/locale"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicAssetRoot",
        "embeddedOutputPrefix",
        "supportedImageMediaTypes",
        "externalToolMediaType"
      ],
      "properties": {
        "publicAssetRoot": {
          "$ref": "#/$defs/repositoryPath"
        },
        "embeddedOutputPrefix": {
          "$ref": "#/$defs/packagePath"
        },
        "supportedImageMediaTypes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "image/jpeg",
              "image/png"
            ]
          }
        },
        "externalToolMediaType": {
          "const": "text/html"
        }
      }
    },
    "pathRelocations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabularySourcePrefix",
        "cardOutputPrefix",
        "assessmentSourcePrefix",
        "assessmentOutputPrefix"
      ],
      "properties": {
        "vocabularySourcePrefix": {
          "const": "/data/"
        },
        "cardOutputPrefix": {
          "const": "data/cards/"
        },
        "assessmentSourcePrefix": {
          "$ref": "#/$defs/repositoryDirectory"
        },
        "assessmentOutputPrefix": {
          "$ref": "#/$defs/packagePath"
        }
      }
    },
    "expectedCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landscapes",
        "goals",
        "programUnits",
        "goalPlacements",
        "competencyEntries",
        "views",
        "decks",
        "cards",
        "resourceLinks",
        "embeddedImages",
        "externalResources",
        "embeddedImageBytes",
        "externalRuntimeDependencies"
      ],
      "properties": {
        "landscapes": {
          "const": 1
        },
        "goals": {
          "type": "integer",
          "minimum": 1
        },
        "programUnits": {
          "type": "integer",
          "minimum": 0
        },
        "goalPlacements": {
          "type": "integer",
          "minimum": 0
        },
        "competencyEntries": {
          "type": "integer",
          "minimum": 0
        },
        "views": {
          "type": "integer",
          "minimum": 1
        },
        "decks": {
          "type": "integer",
          "minimum": 0
        },
        "cards": {
          "type": "integer",
          "minimum": 0
        },
        "resourceLinks": {
          "type": "integer",
          "minimum": 0
        },
        "embeddedImages": {
          "type": "integer",
          "minimum": 0
        },
        "externalResources": {
          "type": "integer",
          "minimum": 0
        },
        "embeddedImageBytes": {
          "type": "integer",
          "minimum": 0
        },
        "externalRuntimeDependencies": {
          "const": 0
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
    },
    "repositoryDirectory": {
      "type": "string",
      "minLength": 2,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+/$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}

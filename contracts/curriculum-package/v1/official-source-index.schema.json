{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/curriculum-package/v1/official-source-index.schema.json",
  "title": "SkillPilot official curriculum-release source index v1",
  "description": "Closed, repository-path-free publication index of the official curricula and supplemental source documents that support one curriculum release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "sourceIndexFormatVersion",
    "targetLandscapeId",
    "sourceCollectionCount",
    "sourceDocumentCount",
    "collections"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/curriculum-package/v1/official-source-index.schema.json"
    },
    "sourceIndexFormatVersion": {
      "const": "1.0"
    },
    "targetLandscapeId": {
      "$ref": "#/$defs/stableId"
    },
    "sourceCollectionCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "sourceDocumentCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/sourceCollection"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "officialUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2000
    },
    "sourceCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCollectionId",
        "sourceLandscapeId",
        "jurisdiction",
        "subject",
        "stage",
        "documentCount",
        "documents"
      ],
      "properties": {
        "sourceCollectionId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceLandscapeId": {
          "$ref": "#/$defs/stableId"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^DE-[A-Z]{2}$"
        },
        "subject": {
          "$ref": "#/$defs/nonBlank"
        },
        "stage": {
          "enum": [
            "SekI",
            "SekII",
            "SekI+SekII"
          ]
        },
        "durationModels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "documentCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/sourceDocument"
          }
        }
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocumentId",
        "sourceKey",
        "title",
        "role",
        "semanticType",
        "official",
        "url"
      ],
      "properties": {
        "sourceDocumentId": {
          "$ref": "#/$defs/stableId"
        },
        "sourceKey": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "$ref": "#/$defs/nonBlank"
        },
        "role": {
          "$ref": "#/$defs/stableId"
        },
        "semanticType": {
          "enum": [
            "curriculum",
            "supplemental-source"
          ]
        },
        "official": {
          "const": true
        },
        "url": {
          "$ref": "#/$defs/officialUrl"
        },
        "landingUrl": {
          "$ref": "#/$defs/officialUrl"
        },
        "durationModel": {
          "$ref": "#/$defs/stableId"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/curriculum-package/v1/composition-view-index.schema.json",
  "title": "SkillPilot composition view index v1",
  "description": "Closed discovery index for authored composition views. Language is explicit and never inferred from artifact paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "indexFormatVersion",
    "views"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/curriculum-package/v1/composition-view-index.schema.json"
    },
    "indexFormatVersion": {
      "const": "1.0"
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60000,
      "x-skillpilot-listSemantics": "ordered",
      "items": {
        "$ref": "#/$defs/viewRecord"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "languageTag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "packageRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schoolForm"
      ],
      "properties": {
        "schoolForm": {
          "$ref": "#/$defs/nonBlankText"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^DE(?:-[A-Z]{2})?$"
        },
        "stage": {
          "$ref": "#/$defs/nonBlankText"
        },
        "courseProfile": {
          "$ref": "#/$defs/nonBlankText"
        },
        "durationModel": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "viewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewId",
        "landscapeId",
        "language",
        "scope",
        "artifactPath"
      ],
      "properties": {
        "viewId": {
          "$ref": "#/$defs/id"
        },
        "landscapeId": {
          "$ref": "#/$defs/id"
        },
        "language": {
          "$ref": "#/$defs/languageTag"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "artifactPath": {
          "$ref": "#/$defs/packageRelativePath"
        }
      }
    }
  }
}

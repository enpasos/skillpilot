{
  "profileFormatVersion": 1,
  "profileId": "full-standalone-v1",
  "description": "Self-contained JSON curriculum package profile. Every hard runtime dependency must resolve inside the package; external source URLs remain non-runtime metadata.",
  "manifestSchema": {
    "id": "https://skillpilot.com/schemas/curriculum-package/v1/package-manifest.schema.json",
    "sha256": "721053d41c558deb4192eab424e9f9452165176fbf073a79533bba4e75e33d7c"
  },
  "compatibility": {
    "packageFormatVersion": "1.0",
    "runtimeContractVersion": "1.0",
    "variant": "json"
  },
  "inventoryPolicy": {
    "pathBase": "archive-root-relative",
    "allowUnknownRoles": false,
    "excludedPaths": [
      "metadata/manifest.json",
      "metadata/SHA256SUMS"
    ]
  },
  "archiveLimits": {
    "outerZipBytes": 3500000000,
    "entryCount": 60000,
    "genericEntryBytes": 1000000000,
    "goalVisualizationBytes": 67108864,
    "imageLaneBytes": 3000000000,
    "totalUncompressedBytes": 8000000000,
    "archivePathBytes": 240,
    "maxEntryCompressionRatio": 100,
    "maxTotalCompressionRatio": 25,
    "nestedArchivesAllowed": false
  },
  "manifestLimits": {
    "manifestBytes": 67108864,
    "fileRecords": 59998,
    "licenseDocuments": 1024
  },
  "redistributionPolicy": {
    "allFilesMustBeAllowed": true
  },
  "licensePolicy": {
    "requireDocumentForEveryIdentifier": true,
    "disallowedIdentifiers": [
      "NONE",
      "NOASSERTION"
    ]
  },
  "roles": [

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/goal-book/v1/goal-book-source-manifest.schema.json",
  "title": "SkillPilot goal-book source manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "landscapeId",
    "navigationOwnership",
    "expectedJurisdictions",
    "durationModelPolicyPath",
    "expectedCurricularAtomicGoalCount",
    "sourcePaths"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "landscapeId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "navigationOwnership": { "const": "common-topic-suffix-v1" },
    "expectedJurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DE-[A-Z]{2}$" }
    },
    "durationModelPolicyPath": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "expectedCurricularAtomicGoalCount": { "type": "integer", "minimum": 1 },
    "sourcePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    }
  }
}

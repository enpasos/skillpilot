import {readFileSync,readdirSync,writeFileSync} from 'node:fs'
import {resolve} from 'node:path'
import {compileCompositionView,normalizeCompositionView} from '../../app/src/utils/authoring/compositionViewAuthoring.ts'
import {normalizeCanonicalLandscape} from '../../app/src/utils/authoring/canonicalAuthoring.ts'
import {hasUnavailableCurricularAtomicAssessmentPrerequisite,isAssessmentExplicitlyOutsideJurisdiction} from '../../app/scripts/lib/canonicalMathSek1ReviewedExamRoutes.ts'
const root=process.cwd(); const raw=JSON.parse(readFileSync(resolve(root,'curricula/DE/Gymnasium/canonical/DE_DEU_S_GYM_CANONICAL_MATHEMATIK.de.json'),'utf8')); const landscape=normalizeCanonicalLandscape(raw); const ledger=JSON.parse(readFileSync(resolve(root,'curricula/DE/Gymnasium/quality/release-model/mathematik.semantic-kinds.json'),'utf8'));const kinds=new Map(ledger.decisions.map((x:any)=>[x.goalId,x.semanticKind]));landscape.goals.forEach(g=>g.semanticKind=kinds.get(g.id) as string);const byId=new Map(landscape.goals.map(g=>[g.id,g]));const atoms=new Set(landscape.goals.filter(g=>g.semanticKind==='curricularAtomic').map(g=>g.id));const out=[];
for(const filename of readdirSync(resolve(root,'curricula/DE/Gymnasium/composition-views/mathematik')).filter(f=>f.endsWith('.json'))){const view=normalizeCompositionView(JSON.parse(readFileSync(resolve(root,'curricula/DE/Gymnasium/composition-views/mathematik',filename),'utf8')));if(!['SekI','CrossStage'].includes(view.scope.stage??''))continue;const p=compileCompositionView(view,landscape);const visible=new Set<string>();const structures:any[]=[];function visit(n:any,path:string[]=[]){if(n.sourceGoalId)visible.add(n.sourceGoalId);else structures.push({id:n.runtimeId,label:n.label,path});n.children.forEach((x:any)=>visit(x,[...path,n.label]));}p.compiledRootNodes.forEach(n=>visit(n));for(const [year,id]of [['9','f6c9c2b8-3dbd-4839-972f-c60f33c44b63'],['10','cb20dd6b-c4ff-4a1b-9636-3b3d6ea86aa8']]){if(visible.has(id)||(year==='10'&&view.scope.durationModel==='G8'))continue;const tasks=byId.get(id)!.contains.map(id=>byId.get(id)!);const eligible=tasks.filter(g=>!isAssessmentExplicitlyOutsideJurisdiction(g,view.scope.jurisdiction)&&!hasUnavailableCurricularAtomicAssessmentPrerequisite(g,atoms,visible));out.push({filename,year,folderId:id,total:tasks.length,eligible:eligible.map(g=>({id:g.id,title:g.title,visible:visible.has(g.id)})),relevantStructures:structures.filter(s=>/Prüfung|Aufgabe/.test(s.label))});}}
writeFileSync(resolve(root,'tmp/pr159-math-exam-folder-ci-repair-20261116/diagnosis.actual.json'),JSON.stringify(out,null,2)+'\n');console.log(out.map(r=>({filename:r.filename,year:r.year,total:r.total,eligible:r.eligible.length,missing:r.eligible.filter(g=>!g.visible).length})))

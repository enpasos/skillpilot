{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/goal-description-review/v1/goal-description-standalone-batch-resolution-index.schema.json",
  "title": "SkillPilot standalone goal-description batch resolution index",
  "description": "A group-local contribution to the central live-denominator progress report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "indexContract",
    "artifactSetId",
    "subject",
    "semanticKind",
    "batchGoalIds",
    "groups",
    "resolutions"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/goal-description-review/v1/goal-description-standalone-batch-resolution-index.schema.json"
    },
    "schemaVersion": { "const": 2 },
    "indexContract": { "const": "goal-description-standalone-batch-resolution-index-v1" },
    "artifactSetId": { "$ref": "#/$defs/stableId" },
    "subject": { "$ref": "#/$defs/nonBlank" },
    "semanticKind": { "const": "curricularAtomic" },
    "batchGoalIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/group" }
    },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/resolution" }
    }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relativeArtifactPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "artifactDirectory",
        "dualSummaryPath",
        "dualSummaryDigest",
        "campaignGoalCount",
        "resolvedGoalCount"
      ],
      "properties": {
        "groupId": { "$ref": "#/$defs/stableId" },
        "artifactDirectory": { "const": "." },
        "dualSummaryPath": { "$ref": "#/$defs/relativeArtifactPath" },
        "dualSummaryDigest": { "$ref": "#/$defs/digest" },
        "campaignGoalCount": { "type": "integer", "minimum": 1, "maximum": 20 },
        "resolvedGoalCount": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalId",
        "titleDe",
        "groupId",
        "decision",
        "resolutionPath",
        "resolutionDigest",
        "resolutionFingerprint",
        "strictDescriptionComplete"
      ],
      "properties": {
        "goalId": { "$ref": "#/$defs/stableId" },
        "titleDe": { "$ref": "#/$defs/nonBlank" },
        "groupId": { "$ref": "#/$defs/stableId" },
        "decision": {
          "enum": ["keep_current", "current_after_revision", "current_after_split"]
        },
        "resolutionPath": { "$ref": "#/$defs/relativeArtifactPath" },
        "resolutionDigest": { "$ref": "#/$defs/digest" },
        "resolutionFingerprint": { "$ref": "#/$defs/digest" },
        "strictDescriptionComplete": { "const": true }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/goal-evidence/v1/goal-evidence-ai-run-manifest.schema.json",
  "title": "SkillPilot goal-evidence AI review run manifest v1",
  "description": "Reproducible manifest for one independent AI review run. It binds the exact review bundle, model, prompt, criteria and output without granting release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "runId",
    "bundleFingerprint",
    "bookDigest",
    "provider",
    "model",
    "role",
    "promptFamilyId",
    "promptFingerprint",
    "criteriaFingerprint",
    "generationParametersFingerprint",
    "independenceGroupId",
    "blindToOtherRuns",
    "goalIds",
    "inputArtifacts",
    "startedAt",
    "completedAt",
    "status",
    "outputDigest",
    "toolchainVersion"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/goal-evidence/v1/goal-evidence-ai-run-manifest.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/stableId" },
    "campaignId": { "$ref": "#/$defs/stableId" },
    "roundId": { "$ref": "#/$defs/stableId" },
    "batchId": { "$ref": "#/$defs/stableId" },
    "batchInputFingerprint": { "$ref": "#/$defs/digest" },
    "bundleFingerprint": { "$ref": "#/$defs/digest" },
    "bookDigest": { "$ref": "#/$defs/digest" },
    "provider": { "$ref": "#/$defs/nonBlank" },
    "model": { "$ref": "#/$defs/nonBlank" },
    "modelVersion": { "$ref": "#/$defs/nonBlank" },
    "role": {
      "enum": [
        "candidate_author",
        "subject_reviewer",
        "didactic_reviewer",
        "assessment_adversarial_reviewer",
        "sequencing_representation_reviewer",
        "disconfirming_reviewer",
        "synthesizer"
      ]
    },
    "promptFamilyId": { "$ref": "#/$defs/stableId" },
    "promptFingerprint": { "$ref": "#/$defs/digest" },
    "criteriaFingerprint": { "$ref": "#/$defs/digest" },
    "generationParametersFingerprint": { "$ref": "#/$defs/digest" },
    "independenceGroupId": { "$ref": "#/$defs/stableId" },
    "blindToOtherRuns": { "type": "boolean" },
    "goalIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "inputArtifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "digest"],
        "properties": {
          "role": {
            "enum": [
              "book_pdf",
              "book_pdf_render_manifest",
              "book_html",
              "book_html_render_manifest",
              "book_model",
              "review_input_json",
              "review_input_jsonl",
              "description_review_batch_input_jsonl",
              "review_markdown",
              "review_prompt",
              "review_criteria",
              "finding_schema",
              "run_manifest_schema"
            ]
          },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "failed"] },
    "outputDigest": { "$ref": "#/$defs/digest" },
    "toolchainVersion": { "$ref": "#/$defs/stableId" }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

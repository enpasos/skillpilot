{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/goal-evidence/v1/goal-evidence-review-config.schema.json",
  "title": "SkillPilot goal-evidence review configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "reviewId",
    "ruleVersion",
    "landscapeId",
    "landscapePath",
    "semanticKindLedgerPath",
    "reviewPath",
    "requireApproved",
    "scope"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/goal-evidence/v1/goal-evidence-review-config.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "reviewId": { "$ref": "#/$defs/slug" },
    "ruleVersion": { "$ref": "#/$defs/slug" },
    "landscapeId": { "$ref": "#/$defs/nonBlank" },
    "landscapePath": { "$ref": "#/$defs/repositoryPath" },
    "semanticKindLedgerPath": { "$ref": "#/$defs/repositoryPath" },
    "reviewPath": { "$ref": "#/$defs/repositoryPath" },
    "requireApproved": { "type": "boolean" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "goalIds"],
      "properties": {
        "label": { "$ref": "#/$defs/nonBlank" },
        "goalIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlank" }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))\\S(?:[\\s\\S]*\\S)?$"
    }
  }
}

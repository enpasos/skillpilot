        "reason": {
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "kind",
        "matchedSourceGoalIds",
        "reason"
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "pointer",
        "reason",
        "value"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "classification": {
          "enum": [
            "runtime-graph",
            "composition",
            "mapping",
            "provenance-registry",
            "qa-scope-config",
            "duration-policy",
            "immutable-original",
            "derived-output",
            "unclassified",
            "active-code-consumer"
          ]
        },
        "handling": {
          "enum": [
            "explicit-pointer-projection",
            "preserve-exact-bytes",
            "requires-review",
            "requires-integration"
          ]
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "beforeCanonicalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "hypotheticalCanonicalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "inverseCanonicalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 0
        },
        "preservedFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preservedField"
          },
          "minItems": 0
        },
        "matchedSourceGoalIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "reason": {
          "type": "string"
        },
        "boundFromGoalKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "path",
        "classification",
        "handling",
        "sourceSha256",
        "matchedSourceGoalIds"
      ]
    }
  }
}

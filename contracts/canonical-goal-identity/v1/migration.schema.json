{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/contracts/canonical-goal-identity/v1/migration.schema.json",
  "title": "Unapplied bounded canonical goal identity proof",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/contracts/canonical-goal-identity/v1/migration.schema.json"
    },
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "migrationId": {
      "const": "canonical-goal-id-format-2026-11-06"
    },
    "uuidNamespace": {
      "const": "97d8c00c-411d-5dec-b260-4e6f22ab688b"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "status": {
      "enum": [
        "blocked",
        "proposal-verified"
      ]
    },
    "runtimeApplied": {
      "const": false,
      "type": "boolean"
    },
    "runtimeAliasSupportClaimed": {
      "const": false,
      "type": "boolean"
    },
    "qaApprovalClaimed": {
      "const": false,
      "type": "boolean"
    },
    "registry": {
      "$ref": "#/$defs/binding"
    },
    "verifier": {
      "$ref": "#/$defs/binding"
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "all-runtime-shaped-curricula-excluding-quality"
        },
        "sourceFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogSource"
          },
          "minItems": 593,
          "maxItems": 593
        },
        "fileCount": {
          "const": 593,
          "type": "integer"
        },
        "serializedGoals": {
          "type": "integer",
          "minimum": 0
        },
        "logicalGoalKeys": {
          "type": "integer",
          "minimum": 0
        },
        "resolvedReferencesBefore": {
          "type": "integer",
          "minimum": 0
        },
        "resolvedReferencesAfter": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "scope",
        "sourceFiles",
        "fileCount",
        "serializedGoals",
        "logicalGoalKeys",
        "resolvedReferencesBefore",
        "resolvedReferencesAfter"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 164,
      "maxItems": 164
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      },
      "minItems": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      },
      "minItems": 0
    },
    "proof": {

      "additionalProperties": false,
      "properties": {
        "bijectiveRuleCount": {
          "const": 164,
          "type": "integer"
        },
        "globalExistingIdentityCollisionCount": {
          "const": 0,
          "type": "integer"
        },
        "inverseDocumentEqualityVerified": {
          "const": true,
          "type": "boolean"
        },
        "unclassifiedOrUnreadyHitCount": {
          "type": "integer",
          "minimum": 0
        },
        "historicalEvidenceBytesPreserved": {
          "const": true,
          "type": "boolean"
        },
        "cardAndAssetBytesRenamed": {
          "const": false,
          "type": "boolean"
        },
        "activationReady": {
          "const": false,
          "type": "boolean"
        }
      },
      "required": [
        "bijectiveRuleCount",
        "globalExistingIdentityCollisionCount",
        "inverseDocumentEqualityVerified",
        "unclassifiedOrUnreadyHitCount",
        "historicalEvidenceBytesPreserved",
        "cardAndAssetBytesRenamed",
        "activationReady"
      ]

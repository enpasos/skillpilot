        "path",
        "sha256"
      ]
    },
    "catalogSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "landscapeId": {
          "type": "string"
        },
        "goalCount": {
          "type": "integer",
          "minimum": 0

        "gitMode": {
          "type": "string",
          "enum": [
            "100644",
            "100755",
            "120000"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "landscapeId",
        "goalCount",
        "gitMode"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "landscapeId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "sourceGoalId": {
          "type": "string"
        },
        "targetGoalId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "relation": {
          "const": "renamed"
        },
        "masteryPolicy": {
          "const": "copy-exact"
        },
        "historyPolicy": {
          "const": "preserve-original-and-add-alias"
        },
        "sourceFile": {
          "type": "string"
        },
        "sourcePointer": {
          "type": "string"
        },
        "beforeGoalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "hypotheticalGoalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "inverseGoalSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "semanticPayloadSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "landscapeId",
        "sourceGoalId",
        "targetGoalId",
        "relation",
        "masteryPolicy",
        "historyPolicy",
        "sourceFile",
        "sourcePointer",
        "beforeGoalSha256",
        "hypotheticalGoalSha256",
        "inverseGoalSha256",
        "semanticPayloadSha256"
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "key",
            "value"
          ]
        },
        "role": {
          "enum": [
            "identity",
            "reference",
            "reference-key"
          ]
        },
        "landscapeId": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "kind",
        "role",
        "landscapeId",
        "before",
        "after"
      ]
    },
    "preservedField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "key",
            "value"
          ]
        },
        "matchedSourceGoalIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/composition-view/v1.3/composition-view.schema.json",
  "title": "SkillPilot composition view 1.3 – elective extensions",
  "description": "Learner-facing composition tree with selectable extension subtrees and ordered election groups.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "viewFormatVersion",
    "viewId",
    "landscapeId",
    "language",
    "scope",
    "rootNodes",
    "electionGroups"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/composition-view/v1.3/composition-view.schema.json"
    },
    "viewFormatVersion": {
      "const": "1.3"
    },
    "viewId": {
      "$ref": "#/$defs/id"
    },
    "landscapeId": {
      "$ref": "#/$defs/id"
    },
    "language": {
      "$ref": "#/$defs/languageTag"
    },
    "title": {
      "$ref": "#/$defs/nonBlankText"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "rootNodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "x-skillpilot-listSemantics": "ordered",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "electionGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/electionGroup"
      },
      "uniqueItems": true,
      "x-skillpilot-listSemantics": "ordered"
    },
    "historicalAssessmentPlacements": {
      "$ref": "#/$defs/hessianPhysicsE1HistoricalAssessmentPlacements"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "languageTag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "projectionRole": {
      "type": "string",
      "enum": [
        "target",
        "prerequisiteOnly"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schoolForm"
      ],
      "properties": {
        "schoolForm": {
          "$ref": "#/$defs/nonBlankText"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^DE(?:-[A-Z]{2})?$"
        },
        "stage": {
          "$ref": "#/$defs/nonBlankText"
        },
        "courseProfile": {
          "$ref": "#/$defs/nonBlankText"
        },
        "durationModel": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "structureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "label",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "structure"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/nonBlankText"
        },
        "children": {
          "type": "array",
          "maxItems": 1000000,
          "x-skillpilot-listSemantics": "ordered",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "childOrder": {
          "$ref": "#/$defs/childOrder"
        },
        "labelEn": {
          "$ref": "#/$defs/nonBlankText"
        },
        "canonicalSourceGoalId": {
          "$ref": "#/$defs/id"
        },
        "originalCanonicalSubtree": {
          "$ref": "#/$defs/canonicalSubtreeNode"
        },
        "canonicalSourceNode": {
          "$ref": "#/$defs/canonicalSubtreeNode"
        },
        "canonicalSourcePhase": {
          "$ref": "#/$defs/nonBlankText"
        },
        "placementEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rationale"
          ],
          "properties": {
            "rationale": {
              "$ref": "#/$defs/nonBlankText"
            },
            "role": {
              "const": "canonicalDefault"
            }
          }
        },
        "extension": {
          "$ref": "#/$defs/extension"
        }
      },
      "dependentRequired": {
        "extension": [
          "labelEn"
        ]
      }
    },
    "canonicalSubtreeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "goalId"
      ],
      "properties": {
        "kind": {
          "const": "canonicalSubtree"
        },
        "goalId": {
          "$ref": "#/$defs/id"
        },
        "projectionRole": {
          "$ref": "#/$defs/projectionRole"
        },
        "displayLabel": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "goalEntryNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "goalId"
      ],
      "properties": {
        "kind": {
          "const": "goalEntry"
        },
        "goalId": {
          "$ref": "#/$defs/id"
        },
        "projectionRole": {
          "$ref": "#/$defs/projectionRole"
        },
        "displayLabel": {
          "$ref": "#/$defs/nonBlankText"
        },
        "placementEvidence": {
          "$ref": "#/$defs/placementEvidence"
        },
        "acquisitionPlacement": {
          "const": true,
          "description": "Explicit acquisition place for this prerequisite-only atom; only authoritative L membership permits runtime materialization. It never adds a seed target."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "acquisitionPlacement"
            ]
          },
          "then": {
            "required": [
              "projectionRole"
            ],
            "properties": {
              "projectionRole": {
                "const": "prerequisiteOnly"
              }
            }
          }
        }
      ]
    },
    "landscapeEntryNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "landscapeId"
      ],
      "properties": {
        "kind": {
          "const": "landscapeEntry"
        },
        "landscapeId": {
          "$ref": "#/$defs/id"
        },
        "displayLabel": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/structureNode"
        },
        {
          "$ref": "#/$defs/canonicalSubtreeNode"
        },
        {
          "$ref": "#/$defs/goalEntryNode"
        },
        {
          "$ref": "#/$defs/landscapeEntryNode"
        }
      ]
    },
    "childOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after"
      ],
      "description": "Presence replaces implicit sibling planning order. An empty after array explicitly declares no additional planning order. References name direct structure children; semantic validation rejects unknown, self, duplicate, cyclic and transitively redundant pairs.",
      "properties": {
        "after": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "after"
            ],
            "properties": {
              "unit": {
                "$ref": "#/$defs/id"
              },
              "after": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "existingAssessmentPlacementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Retained source-only evidence of an existing whole-assessment placement. It grants neither official source assignment nor learner mastery.",
      "required": [
        "role",
        "canonicalPhysicsSha256",
        "requiresGoalId",
        "fullOrdinaryPreparationAlreadyDemanded",
        "sourceClaimBoundary"
      ],
      "properties": {
        "role": {
          "const": "existingWholeAssessmentAtExistingPreparationDemand"
        },
        "canonicalPhysicsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requiresGoalId": {
          "$ref": "#/$defs/id"
        },
        "fullOrdinaryPreparationAlreadyDemanded": {
          "const": true
        },
        "sourceClaimBoundary": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "reviewedPreparationPlacementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Retained source-only preparation evidence. This metadata does not change the authored projectionRole or claim an official temporal assignment.",
      "required": [
        "role",
        "consumerGoalId",
        "requiredByPath",
        "reviewedCanonicalPhysicsSha256",
        "reviewedCanonicalOwnerSha256",
        "rationale",
        "sourceInterpretation",
        "sourceURLs",
        "futureModelGap"
      ],
      "properties": {
        "role": {
          "const": "reviewedPreparation"
        },
        "consumerGoalId": {
          "$ref": "#/$defs/id"
        },
        "requiredByPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "reviewedCanonicalPhysicsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewedCanonicalOwnerSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rationale": {
          "$ref": "#/$defs/nonBlankText"
        },
        "sourceInterpretation": {
          "$ref": "#/$defs/nonBlankText"
        },
        "sourceURLs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          }
        },
        "futureModelGap": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "placementEvidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/existingAssessmentPlacementEvidence"
        },
        {
          "$ref": "#/$defs/reviewedPreparationPlacementEvidence"
        },
        {
          "$ref": "#/$defs/canonicalDefaultPlacementEvidence"
        }
      ]
    },
    "canonicalDefaultPlacementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "classification",
        "sourceInterpretation",
        "references"
      ],
      "properties": {
        "role": {
          "const": "canonicalDefault"
        },
        "classification": {
          "$ref": "#/$defs/nonBlankText"
        },
        "sourceInterpretation": {
          "$ref": "#/$defs/nonBlankText"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonBlankText"
          }
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "groupId",
        "previouslyRegular"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "groupId": {
          "$ref": "#/$defs/id"
        },
        "previouslyRegular": {
          "type": "boolean"
        }
      }
    },
    "electionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "textEn",
        "edition",
        "location"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/nonBlankText"
        },
        "textEn": {
          "$ref": "#/$defs/nonBlankText"
        },
        "edition": {
          "$ref": "#/$defs/nonBlankText"
        },
        "location": {
          "$ref": "#/$defs/nonBlankText"
        }
      }
    },
    "electionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "labelEn",
        "origin",
        "minSelections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/nonBlankText"
        },
        "labelEn": {
          "$ref": "#/$defs/nonBlankText"
        },
        "origin": {
          "enum": [
            "official",
            "skillpilot"
          ]
        },
        "minSelections": {
          "type": "integer",
          "minimum": 0
        },
        "rule": {
          "$ref": "#/$defs/electionRule"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "official"
              }
            }
          },
          "then": {
            "required": [
              "rule"
            ]
          },
          "else": {
            "properties": {
              "minSelections": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "hessianPhysicsE1HistoricalAssessmentPlacements": {
      "type": "object",
      "additionalProperties": false,
      "description": "Named compatibility migration for the three historically placed Hessian Physics E.1 assessments.",
      "required": [
        "migration",
        "extension",
        "legacyOnly"
      ],
      "properties": {
        "migration": {
          "const": "he-physik-e1-20261127"
        },
        "extension": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "groupId",
            "label",
            "labelEn",
            "placements"
          ],
          "properties": {
            "id": {
              "const": "physics-he-e1-experimental-assessments"
            },
            "groupId": {
              "const": "physics-he-skillpilot-extensions"
            },
            "label": {
              "$ref": "#/$defs/nonBlankText"
            },
            "labelEn": {
              "$ref": "#/$defs/nonBlankText"
            },
            "placements": {
              "type": "array",
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "goalId",
                    "parentId"
                  ],
                  "properties": {
                    "goalId": {
                      "const": "f41e4e30-794e-5ce4-ba5e-cc72712cd691"
                    },
                    "parentId": {
                      "const": "physics-e1-accelerated-and-free-fall"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "goalId",
                    "parentId"
                  ],
                  "properties": {
                    "goalId": {
                      "const": "c6e2942d-1ff4-5e86-a52a-4ca4c8568291"
                    },
                    "parentId": {
                      "const": "physics-he-ephase-cross-topic-assessments"
                    }
                  }
                }
              ],
              "items": false
            }
          }
        },
        "legacyOnly": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goalId",
            "parentId"
          ],
          "properties": {
            "goalId": {
              "const": "bcc56921-7107-5f5f-b721-3d5e0d7e1cd9"
            },
            "parentId": {
              "const": "physics-e1-two-motions"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "historicalAssessmentPlacements"
        ]
      },
      "then": {
        "properties": {
          "landscapeId": {
            "const": "7f6fc60c-9fcc-4cc2-b07e-f897a1d0338a"
          },
          "scope": {
            "required": [
              "schoolForm",
              "jurisdiction",
              "stage"
            ],
            "properties": {
              "schoolForm": {
                "const": "Gymnasium"
              },
              "jurisdiction": {
                "const": "DE-HE"
              },
              "stage": {
                "enum": [
                  "SekII",
                  "CrossStage"
                ]
              }
            }
          }
        }
      }
    }
  ]
}

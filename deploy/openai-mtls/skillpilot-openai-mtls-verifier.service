[Unit]
Description=SkillPilot OpenAI MCP mTLS certificate verifier
After=network.target
Before=nginx.service

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 /usr/local/libexec/skillpilot-openai-mtls-verifier.py --listen 127.0.0.1 --port 8792 --root-ca /etc/skillpilot/openai-mtls/openai-root-ca.pem --intermediate-ca /etc/skillpilot/openai-mtls/openai-connectors-mtls-ca.pem
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

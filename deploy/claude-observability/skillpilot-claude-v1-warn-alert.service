[Unit]
Description=SkillPilot Claude v1 redacted provider WARN alert
Documentation=https://github.com/enpasos/skillpilot/blob/main/docs/deploy/claude-support-readiness-runbook.md
After=network-online.target skillpilot.service
Wants=network-online.target
StartLimitIntervalSec=3600s
StartLimitBurst=4

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=systemd-journal
LoadCredential=smtp-username:/etc/skillpilot/claude-v1-warn-alert/smtp-username
LoadCredential=smtp-password:/etc/skillpilot/claude-v1-warn-alert/smtp-password
LoadCredential=recipient:/etc/skillpilot/claude-v1-warn-alert/recipient
StateDirectory=skillpilot-claude-v1-warn-alert
StateDirectoryMode=0700
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/python3 -B /usr/local/libexec/skillpilot-claude-v1-warn-alert.py validate-config
ExecStartPre=/usr/bin/python3 -B /usr/local/libexec/skillpilot-claude-v1-warn-alert.py verify-journal --journal-unit skillpilot.service --journalctl /usr/bin/journalctl
ExecStart=/usr/bin/python3 -B /usr/local/libexec/skillpilot-claude-v1-warn-alert.py watch --journal-unit skillpilot.service --journalctl /usr/bin/journalctl
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=300s
TimeoutStopSec=45s
TasksMax=32
MemoryMax=128M
MemorySwapMax=0
LimitNOFILE=128
LimitCORE=0
UMask=0077
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target

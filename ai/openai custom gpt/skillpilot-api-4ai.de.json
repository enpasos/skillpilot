{
  "openapi": "3.1.0",
  "info": {
    "title": "Skillpilot AI Interface",
    "description": "Skillpilot AI-API fuer ChatGPT: Startcode einloesen, Lernzustand laden, Ziele waehlen und Mastery speichern. Der GPT arbeitet nur mit einem kurzlebigen Chat-Session-Token, nicht mit der echten SkillPilot-ID.",
    "version": "v3-ai-startcode-session"
  },
  "servers": [
    {
      "url": "https://skillpilot.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/ai/de/chat-start/redeem": {
      "post": {
        "operationId": "redeemStartCode",
        "summary": "Startcode einloesen",
        "description": "Startcode einloesen. `assistantMessage` ist die sichtbare Startantwort und kann einen Cockpit-Link zum aktiven Ziel enthalten.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemStartCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Startcode erfolgreich eingeloest. Enthält Chat-Session-Token und initialen Lernzustand.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemStartCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Start code not found"
          },
          "409": {
            "description": "Startcode wurde bereits verwendet."
          },
          "410": {
            "description": "Startcode ist abgelaufen."
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/state": {
      "get": {
        "operationId": "getLearnerState",
        "summary": "Get unified learner state",
        "description": "Lernzustand laden.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aktueller Lernzustand. skillpilotId ist bei Session-Routen absichtlich null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat-Session abgelaufen. Unterricht stoppen; auf skillpilot.com verweisen, dort Zugang laden oder SkillPilot-ID eingeben und Lerncoach erneut starten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/scope": {
      "post": {
        "operationId": "setScope",
        "summary": "Set learning scope/focus",
        "description": "Fokus setzen.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScopeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scope updated. Returns new learner state with planned goals.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat-Session abgelaufen. Unterricht stoppen; auf skillpilot.com verweisen, dort Zugang laden oder SkillPilot-ID eingeben und Lerncoach erneut starten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/active-goal": {
      "post": {
        "operationId": "setActiveGoal",
        "summary": "Aktives Ziel setzen",
        "description": "Aktives Ziel setzen.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveGoalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active goal set. Returns new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat-Session abgelaufen. Unterricht stoppen; auf skillpilot.com verweisen, dort Zugang laden oder SkillPilot-ID eingeben und Lerncoach erneut starten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/mastery": {
      "post": {
        "operationId": "setMastery",
        "summary": "Mastery speichern",
        "description": "Mastery speichern.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MasteryUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mastery updated, returns new frontier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasteryUpdateResponse"
                }
              }
            }
          },
          "409": {
            "description": "Voraussetzung fehlt vor dem Speichern der Mastery. Zurückgegebener Zustand enthält den nächsten erforderlichen Schritt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat-Session abgelaufen. Unterricht stoppen; auf skillpilot.com verweisen, dort Zugang laden oder SkillPilot-ID eingeben und Lerncoach erneut starten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/verified-recall/start": {
      "post": {
        "operationId": "startVerifiedRecall",
        "summary": "Lernkarten-Pruefung starten",
        "description": "Kartenpruefung starten.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifiedRecallStartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Naechste Kartenfrage oder Abschluss der Pruefung.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifiedRecallPromptResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat-Session abgelaufen. Unterricht stoppen; auf skillpilot.com verweisen, dort Zugang laden oder SkillPilot-ID eingeben und Lerncoach erneut starten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/verified-recall/answer": {
      "post": {
        "operationId": "getVerifiedRecallAnswer",
        "summary": "Kartenantwort holen",
        "description": "Kartenantwort holen.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifiedRecallAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Erwartete Antwort zur zuletzt abgefragten Karte.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifiedRecallAnswerResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat-Session abgelaufen. Unterricht stoppen; auf skillpilot.com verweisen, dort Zugang laden oder SkillPilot-ID eingeben und Lerncoach erneut starten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/verified-recall/result": {
      "post": {
        "operationId": "recordVerifiedRecallResult",
        "summary": "Kartenergebnis speichern",
        "description": "Kartenergebnis speichern; bei Abschluss speichert das Backend Lernkarten-Mastery implizit.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifiedRecallResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gespeichertes Kartenergebnis. Bei masterySaved=true ist das Lernkartenziel abgeschlossen; kein setMastery aufrufen.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifiedRecallResultResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat-Session abgelaufen. Unterricht stoppen; auf skillpilot.com verweisen, dort Zugang laden oder SkillPilot-ID eingeben und Lerncoach erneut starten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/curriculum": {
      "post": {
        "operationId": "setCurriculum",
        "summary": "Curriculum setzen",
        "description": "Curriculum setzen.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurriculumRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Curriculum updated successfully. Returns the new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Learner or Curriculum not found"
          },
          "410": {
            "description": "Chat-Session abgelaufen. Unterricht stoppen; auf skillpilot.com verweisen, dort Zugang laden oder SkillPilot-ID eingeben und Lerncoach erneut starten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/personalization": {
      "post": {
        "operationId": "setPersonalization",
        "summary": "Personalize the curriculum",
        "description": "Filter speichern.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonalizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Personalization updated. Returns new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat-Session abgelaufen. Unterricht stoppen; auf skillpilot.com verweisen, dort Zugang laden oder SkillPilot-ID eingeben und Lerncoach erneut starten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/landscapes": {
      "get": {
        "operationId": "listLandscapes",
        "summary": "List available curriculums",
        "responses": {
          "200": {
            "description": "List of available landscapes/curriculums",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandscapeOverviewResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key"
      }
    },
    "schemas": {
      "UnifiedLearnerStateResponse": {
        "type": "object",
        "properties": {
          "skillpilotId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Interne SkillPilot-ID. Bei Chat-Session-Routen absichtlich null; der GPT darf diese ID nicht erfragen, anzeigen oder in Links einbauen."
          },
          "curriculum": {
            "$ref": "#/components/schemas/LandscapeSummary"
          },
          "frontier": {
            "type": "array",
            "description": "Ziele, die im aktuellen Zustand lernbar sind (atomar und Cluster). Dies sind Kandidaten; das bestätigte aktuelle Ziel steht separat in `activeGoal`.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "goals": {
            "$ref": "#/components/schemas/LearnerGoals"
          },
          "nextAllowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Backend-Berechtigungsliste, keine Handlungsanweisung. Immer stateMachine.requiredAction folgen; setMastery nur nach Lernenden-Evidenz."
          },
          "activeFilters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of active filter IDs (e.g. 'LK', 'GK') applied to the current curriculum."
          },
          "copySources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CopySource"
            }
          },
          "learningState": {
            "type": "string",
            "description": "Current learning state (e.g. FRONTIER, TEACHING)."
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal",
            "description": "Bestätigtes aktives Lernziel."
          },
          "stateMachine": {
            "$ref": "#/components/schemas/StateMachineInfo"
          }
        }
      },
      "ActiveGoalRequest": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "description": "ID eines atomaren Ziels aus dem zuletzt geladenen Zustand, das als aktuelles Lernziel gesperrt wird."
          },
          "redirect": {
            "type": "boolean",
            "description": "Nur true, wenn der Nutzer explizit auf ein anderes Ziel wechseln moechte, waehrend der Zustand noch ein anderes aktives Ziel sperrt."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "FrontierGoal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "atomic",
              "cluster"
            ]
          },
          "nodeKind": {
            "type": "string",
            "enum": [
              "exam",
              "tutor",
              "memory"
            ]
          },
          "reason": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resourceLinks": {
            "description": "Geordnete hilfreiche Lernressourcen fuer dieses Lernziel. Kanonisches Feld fuer Cockpit und KI-Lerncoaches.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalSourceLink"
            }
          },
          "sourceRef": {
            "type": "string",
            "description": "Kanonische Provenienz-Referenz für dieses Lernziel, idealerweise eine stabile URL, sonst eine Zitationszeichenkette."
          },
          "sourceLicense": {
            "type": "string",
            "description": "Lizenzbezeichnung der kanonischen Quelle (z. B. CC-BY-NC-SA-4.0)."
          },
          "sourceLicenseUrl": {
            "type": "string",
            "description": "URL zur geltenden Lizenz- oder Terms-Seite."
          },
          "examData": {
            "$ref": "#/components/schemas/ExamData",
            "description": "Vollständige Prüfungsdaten. Garantiert nur auf `activeGoal` und `stateMachine.activeGoal`; bei auswählbaren Kandidaten kann das Feld fehlen."
          }
        }
      },
      "GoalSourceLink": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Didaktische Rolle des Links, z. B. overview, concept, practice, assessment, solution, reference."
          },
          "title": {
            "type": "string",
            "description": "Kurze, nutzerseitige Bezeichnung."
          },
          "url": {
            "type": "string",
            "description": "Absolute Ziel-URL."
          },
          "resourceType": {
            "type": "string",
            "description": "Konkrete Materialart, z. B. course-page, video, notes, article, simulation, problem-set, exam, solution-set, book, tool."
          },
          "provider": {
            "type": "string",
            "description": "Optionales Provider- oder Seitenlabel, z. B. MIT OCW oder physikbuch.schule."
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optionale Kapitel- oder Abschnittshinweise zum Lernziel."
          },
          "description": {
            "type": "string",
            "description": "Optionaler kurzer Hinweis, warum der Link hilfreich ist."
          },
          "lang": {
            "type": "string",
            "description": "Optionaler BCP-47-Sprachcode der verlinkten Ressource."
          },
          "license": {
            "type": "string",
            "description": "Optionale Lizenzbezeichnung der verlinkten Ressource."
          },
          "skillpilotId": {
            "type": "string",
            "description": "Optionaler Zielbezug."
          },
          "role": {
            "type": "string",
            "description": "Optionale Rolle des Links, z. B. primary."
          },
          "altText": {
            "type": "string",
            "description": "Alternativtext fuer Bildressourcen."
          },
          "reviewStatus": {
            "type": "string",
            "description": "Optionaler Reviewstatus der Ressource, z. B. pilot."
          }
        }
      },
      "LearnerGoals": {
        "type": "object",
        "properties": {
          "planned": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "mastered_count": {
            "type": "integer",
            "description": "Mastered atomic goals in the current focus (scope if set, otherwise personalized curriculum)."
          },
          "total_count": {
            "type": "integer",
            "description": "Total atomic goals in the current focus (scope if set, otherwise personalized curriculum)."
          },
          "personalized": {
            "$ref": "#/components/schemas/GoalStats"
          },
          "scope": {
            "$ref": "#/components/schemas/GoalStats"
          },
          "scope_completed": {
            "type": "boolean",
            "description": "True when the current scope (planned focus) is fully mastered."
          }
        }
      },
      "GoalStats": {
        "type": "object",
        "properties": {
          "mastered_atomic": {
            "type": "integer"
          },
          "total_atomic": {
            "type": "integer"
          }
        }
      },
      "ScopeRequest": {
        "type": "object",
        "properties": {
          "goalIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Goal-IDs aus dem zuletzt geladenen Zustand für die Scope-Definition."
          }
        },
        "required": [
          "goalIds"
        ]
      },
      "MasteryUpdateResponse": {
        "type": "object",
        "properties": {
          "frontier": {
            "type": "array",
            "description": "Aktualisierte Kandidatenziele nach Mastery (atomar und Cluster). Das bestätigte aktuelle Ziel steht separat in `activeGoal`.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "nextAllowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Backend-Berechtigungsliste, keine Handlungsanweisung. Immer stateMachine.requiredAction folgen; setMastery nur nach Lernenden-Evidenz."
          },
          "learningState": {
            "type": "string",
            "description": "Current learning state after mastery (e.g. FRONTIER, TEACHING)."

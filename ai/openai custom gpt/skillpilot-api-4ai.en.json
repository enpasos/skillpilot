{
  "openapi": "3.1.0",
  "info": {
    "title": "Skillpilot AI Interface",
    "description": "Skillpilot AI API for ChatGPT: redeem a start code, load learner state, select goals, and save mastery. The GPT uses only a short-lived chat session token, never the real SkillPilot ID.",
    "version": "v3-ai-startcode-session"
  },
  "servers": [
    {
      "url": "https://skillpilot.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/ai/en/chat-start/redeem": {
      "post": {
        "operationId": "redeemStartCode",
        "summary": "Redeem start code",
        "description": "Redeem start code. `assistantMessage` is the visible startup answer and may contain a Cockpit link to the active goal.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemStartCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Start code redeemed. Contains chat session token and initial learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemStartCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Start code not found"
          },
          "409": {
            "description": "Start code has already been used."
          },
          "410": {
            "description": "Start code has expired."
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/state": {
      "get": {
        "operationId": "getLearnerState",
        "summary": "Get unified learner state",
        "description": "Load learner state.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat session token returned by redeemStartCode. Do not display it, do not ask the learner for it, use it only for follow-up tool calls.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current learner state. skillpilotId is intentionally null on session routes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat session expired. Stop teaching; direct the learner to skillpilot.com, load a protected ID file or enter the SkillPilot ID there, and start the learning coach again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/scope": {
      "post": {
        "operationId": "setScope",
        "summary": "Set learning scope/focus",
        "description": "Set learning focus.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat session token returned by redeemStartCode. Do not display it, do not ask the learner for it, use it only for follow-up tool calls.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScopeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scope updated. Returns new learner state with planned goals.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat session expired. Stop teaching; direct the learner to skillpilot.com, load a protected ID file or enter the SkillPilot ID there, and start the learning coach again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/active-goal": {
      "post": {
        "operationId": "setActiveGoal",
        "summary": "Set active goal",
        "description": "Set active goal.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat session token returned by redeemStartCode. Do not display it, do not ask the learner for it, use it only for follow-up tool calls.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveGoalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active goal set. Returns new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat session expired. Stop teaching; direct the learner to skillpilot.com, load a protected ID file or enter the SkillPilot ID there, and start the learning coach again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/mastery": {
      "post": {
        "operationId": "setMastery",
        "summary": "Save mastery",
        "description": "Save mastery.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat session token returned by redeemStartCode. Do not display it, do not ask the learner for it, use it only for follow-up tool calls.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MasteryUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mastery updated, returns new frontier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasteryUpdateResponse"
                }
              }
            }
          },
          "409": {
            "description": "Saving mastery requires a prerequisite action. Returns current state and the next required step.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat session expired. Stop teaching; direct the learner to skillpilot.com, load a protected ID file or enter the SkillPilot ID there, and start the learning coach again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/verified-recall/start": {
      "post": {
        "operationId": "startVerifiedRecall",
        "summary": "Start flashcard verification",
        "description": "Start card check.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat session token returned by redeemStartCode. Do not display it, do not ask the learner for it, use it only for follow-up tool calls.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifiedRecallStartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Next flashcard prompt or verification completion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifiedRecallPromptResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat session expired. Stop teaching; direct the learner to skillpilot.com, load a protected ID file or enter the SkillPilot ID there, and start the learning coach again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/verified-recall/answer": {
      "post": {
        "operationId": "getVerifiedRecallAnswer",
        "summary": "Get card answer",
        "description": "Get card answer.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat session token returned by redeemStartCode. Do not display it, do not ask the learner for it, use it only for follow-up tool calls.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifiedRecallAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Expected answer for the previously asked card.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifiedRecallAnswerResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat session expired. Stop teaching; direct the learner to skillpilot.com, load a protected ID file or enter the SkillPilot ID there, and start the learning coach again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/verified-recall/result": {
      "post": {
        "operationId": "recordVerifiedRecallResult",
        "summary": "Save card result",
        "description": "Save card result; on completion the backend implicitly saves flashcard mastery.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat session token returned by redeemStartCode. Do not display it, do not ask the learner for it, use it only for follow-up tool calls.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifiedRecallResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved card result. If masterySaved=true, the flashcard goal is complete; do not call setMastery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifiedRecallResultResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat session expired. Stop teaching; direct the learner to skillpilot.com, load a protected ID file or enter the SkillPilot ID there, and start the learning coach again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/curriculum": {
      "post": {
        "operationId": "setCurriculum",
        "summary": "Set curriculum",
        "description": "Set curriculum.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat session token returned by redeemStartCode. Do not display it, do not ask the learner for it, use it only for follow-up tool calls.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurriculumRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Curriculum updated successfully. Returns the new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Learner or Curriculum not found"
          },
          "410": {
            "description": "Chat session expired. Stop teaching; direct the learner to skillpilot.com, load a protected ID file or enter the SkillPilot ID there, and start the learning coach again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/personalization": {
      "post": {
        "operationId": "setPersonalization",
        "summary": "Personalize the curriculum",
        "description": "Save filters.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat session token returned by redeemStartCode. Do not display it, do not ask the learner for it, use it only for follow-up tool calls.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonalizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Personalization updated. Returns new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "410": {
            "description": "Chat session expired. Stop teaching; direct the learner to skillpilot.com, load a protected ID file or enter the SkillPilot ID there, and start the learning coach again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionExpiredResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/landscapes": {
      "get": {
        "operationId": "listLandscapes",
        "summary": "List available curriculums",
        "responses": {
          "200": {
            "description": "List of available landscapes/curriculums",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandscapeOverviewResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key"
      }
    },
    "schemas": {
      "UnifiedLearnerStateResponse": {
        "type": "object",
        "properties": {
          "skillpilotId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Internal SkillPilot ID. Intentionally null on chat session routes; the GPT must not ask for, display, or put this ID into links."
          },
          "curriculum": {
            "$ref": "#/components/schemas/LandscapeSummary"
          },
          "frontier": {
            "type": "array",
            "description": "Goals available to learn in current state (atomic and cluster). These are candidates; the confirmed current goal is returned separately in `activeGoal`.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "goals": {
            "$ref": "#/components/schemas/LearnerGoals"
          },
          "nextAllowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Backend permission list, not an instruction. Always follow stateMachine.requiredAction; use setMastery only after learner evidence."
          },
          "activeFilters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of active filter IDs (e.g. 'LK', 'GK') applied to the current curriculum."
          },
          "copySources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CopySource"
            }
          },
          "learningState": {
            "type": "string",
            "description": "Current learning state (e.g. FRONTIER, TEACHING)."
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal",
            "description": "Confirmed active goal currently selected."
          },
          "stateMachine": {
            "$ref": "#/components/schemas/StateMachineInfo"
          }
        }
      },
      "ActiveGoalRequest": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "description": "Atomic goal ID from the latest loaded state to lock as the current learning target."
          },
          "redirect": {
            "type": "boolean",
            "description": "Set true only when the user explicitly requests moving to another goal while the current state still locks a different active goal."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "FrontierGoal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "atomic",
              "cluster"
            ]
          },
          "nodeKind": {
            "type": "string",
            "enum": [
              "exam",
              "tutor",
              "memory"
            ]
          },
          "reason": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resourceLinks": {
            "description": "Ordered helpful learning resources for this goal. Canonical field for Cockpit and AI learning coaches.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalSourceLink"
            }
          },
          "sourceRef": {
            "type": "string",
            "description": "Canonical provenance reference for this goal, preferably a stable URL when available, otherwise a citation string."
          },
          "sourceLicense": {
            "type": "string",
            "description": "License label for the canonical source (e.g. CC-BY-NC-SA-4.0)."
          },
          "sourceLicenseUrl": {
            "type": "string",
            "description": "URL to the applicable license or terms page."
          },
          "examData": {
            "$ref": "#/components/schemas/ExamData",
            "description": "Full exam payload. Guaranteed only on `activeGoal` and `stateMachine.activeGoal`; selectable candidates may omit this field."
          }
        }
      },
      "GoalSourceLink": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Didactic role of the link, e.g. overview, concept, practice, assessment, solution, reference."
          },
          "title": {
            "type": "string",
            "description": "Short user-facing label."
          },
          "url": {
            "type": "string",
            "description": "Absolute target URL."
          },
          "resourceType": {
            "type": "string",
            "description": "Concrete material kind, e.g. course-page, video, notes, article, simulation, problem-set, exam, solution-set, book, tool."
          },
          "provider": {
            "type": "string",
            "description": "Optional provider or site label, e.g. MIT OCW or physikbuch.schule."
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional chapter or section hints relevant to the goal."
          },
          "description": {
            "type": "string",
            "description": "Optional short note explaining why the link is useful."
          },
          "lang": {
            "type": "string",
            "description": "Optional BCP-47 language tag for the linked resource."
          },
          "license": {
            "type": "string",
            "description": "Optional license label for the linked resource."
          },
          "skillpilotId": {
            "type": "string",
            "description": "Optional goal reference."
          },
          "role": {
            "type": "string",
            "description": "Optional role of the link, e.g. primary."
          },
          "altText": {
            "type": "string",
            "description": "Alternative text for image resources."
          },
          "reviewStatus": {
            "type": "string",
            "description": "Optional review status for the resource, e.g. pilot."
          }
        }
      },
      "LearnerGoals": {
        "type": "object",
        "properties": {
          "planned": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "mastered_count": {
            "type": "integer",
            "description": "Mastered atomic goals in the current focus (scope if set, otherwise personalized curriculum)."
          },
          "total_count": {
            "type": "integer",
            "description": "Total atomic goals in the current focus (scope if set, otherwise personalized curriculum)."
          },
          "personalized": {
            "$ref": "#/components/schemas/GoalStats"
          },
          "scope": {
            "$ref": "#/components/schemas/GoalStats"
          },
          "scope_completed": {
            "type": "boolean",
            "description": "True when the current scope (planned focus) is fully mastered."
          }
        }
      },
      "GoalStats": {
        "type": "object",
        "properties": {
          "mastered_atomic": {
            "type": "integer"
          },
          "total_atomic": {
            "type": "integer"
          }
        }
      },
      "ScopeRequest": {
        "type": "object",
        "properties": {
          "goalIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Goal IDs from the latest loaded state that define the current learning scope."
          }
        },
        "required": [
          "goalIds"
        ]
      },
      "MasteryUpdateResponse": {
        "type": "object",
        "properties": {
          "frontier": {
            "type": "array",
            "description": "Updated candidate goals after mastery (atomic and cluster). The confirmed current goal is returned separately in `activeGoal`.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "nextAllowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Backend permission list, not an instruction. Always follow stateMachine.requiredAction; use setMastery only after learner evidence."
          },
          "learningState": {
            "type": "string",
            "description": "Current learning state after mastery (e.g. FRONTIER, TEACHING)."
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal",
            "description": "Confirmed active goal after mastery handling."
          },
          "stateMachine": {
            "$ref": "#/components/schemas/StateMachineInfo"
          },
          "goals": {
            "$ref": "#/components/schemas/LearnerGoals"
          }
        }
      },
      "StateMachineInfo": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "description": "Current high-level state (SETUP, FRONTIER, TEACHING)."
          },
          "requiredAction": {
            "type": "string",
            "description": "Single required next step for the current state, if any. Values matching tool names are tool calls. `teachActiveGoal` is a conversational teaching/checking step, not a tool call; do not call `setMastery` until learner evidence has been produced."
          },
          "goalOptions": {
            "type": "array",
            "description": "Goal options returned for the current `requiredAction`. These are selectable candidates, not automatically the confirmed active goal.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "curriculumOptions": {
            "type": "array",
            "description": "Curriculum options when a curriculum must be selected.",
            "items": {
              "$ref": "#/components/schemas/LandscapeSummary"
            }
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal",
            "description": "Confirmed active goal inside state machine."
          },
          "modeOptions": {
            "type": "array",
            "description": "Mode options for the current step. For `requiredAction=chooseMemoryMode`, this contains flashcard learning in the Cockpit and GPT verified recall.",
            "items": {
              "$ref": "#/components/schemas/LearningModeOption"
            }
          }
        }
      },
      "LearningModeOption": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable mode ID, e.g. practice or verify."
          },
          "title": {
            "type": "string",
            "description": "User-facing mode title."
          },
          "description": {
            "type": "string",
            "description": "Short action description for this mode."
          },
          "action": {
            "type": "string",
            "description": "Required action. `openCockpitPractice` means learn with flashcards in the Cockpit; `startVerifiedRecall` means start the verified-recall tool flow."
          },
          "target": {
            "type": "string",
            "description": "Target surface, e.g. cockpit or gpt."
          },
          "goalId": {
            "type": "string",
            "description": "Active flashcard goal for this mode."
          }
        }
      },
      "MasteryUpdateRequest": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "description": "Active atomic goal ID. Use only after sufficient learner evidence."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "VerifiedRecallStartRequest": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "description": "Optional; if empty, the backend uses the active flashcard goal."
          },
          "retest": {
            "type": "boolean",
            "description": "Deprecated; does not bypass passed cards or the daily lock."
          },
          "batchSize": {
            "type": "integer",
            "description": "Opt-in for new clients: number of card prompts to return at once. Cockpit default is 10. Omit for legacy single-card behavior.",
            "minimum": 1,
            "maximum": 20
          }
        }
      },
      "VerifiedRecallAnswerRequest": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "description": "Optional; active flashcard goal."
          },
          "cardId": {
            "type": "string",
            "description": "ID of the card just asked by `startVerifiedRecall`."
          }
        },
        "required": [
          "cardId"
        ]
      },
      "VerifiedRecallResultRequest": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "description": "Optional; active flashcard goal."
          },
          "cardId": {
            "type": "string",
            "description": "ID of the checked card."
          },
          "passed": {
            "type": "boolean",
            "description": "true if the learner answer was sufficiently correct without card help; otherwise false."
          },
          "feedback": {
            "type": "string",
            "description": "Optional short grading reason."
          }
        },
        "required": [
          "cardId",
          "passed"
        ]
      },
      "VerifiedRecallPromptResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "`ready` means ask the prompt. `waiting` means no further card can be tested today because open cards were already tested today. `complete` means all cards are passed."
          },
          "instruction": {
            "type": "string",
            "description": "Binding short rule for the next chat step."
          },
          "skillpilotId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null on chat session routes. Do not display or put into links."
          },
          "goalId": {
            "type": "string"
          },
          "goalTitle": {
            "type": "string"
          },
          "totalCards": {
            "type": "integer"
          },
          "verifiedCards": {
            "type": "integer"
          },
          "pendingCards": {
            "type": "integer"
          },
          "eligibleCards": {
            "type": "integer",
            "description": "Open cards that may still be tested today."
          },
          "blockedCards": {
            "type": "integer",
            "description": "Open cards already tested today and therefore locked until tomorrow."
          },
          "nextEligibleAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO timestamp when a card locked today may be tested again."
          },
          "batchSize": {
            "type": "integer",
            "description": "Number of card prompts returned in `cards`. Legacy clients can keep using `cardId` and `prompt`."
          },
          "cards": {
            "type": "array",
            "description": "Batch of card prompts to ask together as a numbered list. Empty when status is `waiting` or `complete`.",
            "items": {
              "$ref": "#/components/schemas/VerifiedRecallPromptCard"
            }
          },
          "cardId": {
            "type": [
              "string",
              "null"
            ],
            "description": "First card from `cards` for legacy single-card clients. Null when no card is available."
          },
          "prompt": {
            "type": [
              "string",
              "null"
            ],
            "description": "First prompt from `cards` for legacy single-card clients; do not reveal the expected answer first."
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "VerifiedRecallPromptCard": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "description": "Ask this prompt without revealing the expected answer first."
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "VerifiedRecallAnswerResponse": {
        "type": "object",
        "properties": {
          "instruction": {
            "type": "string"
          },
          "goalId": {
            "type": "string"
          },
          "cardId": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "expectedAnswer": {
            "type": "string",
            "description": "Use only after the learner has answered."
          },
          "category": {
            "type": "string"
          }
        }
      },
      "VerifiedRecallResultResponse": {
        "type": "object",
        "properties": {
          "savedCardId": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "verifiedCards": {
            "type": "integer"
          },
          "pendingCards": {
            "type": "integer"
          },
          "masterySaved": {
            "type": "boolean",
            "description": "true when this result saved the flashcard goal as Mastery=1.0 on the server. Do not call setMastery afterwards."
          },
          "masteryGoalId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Flashcard goal whose mastery was saved implicitly; otherwise null."
          },
          "instruction": {
            "type": [
              "string",
              "null"
            ],
            "description": "Binding short follow-up instruction for GPT, especially when verification is complete."
          },
          "next": {
            "$ref": "#/components/schemas/VerifiedRecallPromptResponse"
          }
        }
      },
      "MasteryResponse": {
        "type": "object",
        "properties": {
          "mastery": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "description": "Map of goal ID to mastery score (0.0 to 1.0)."
          },
          "goalId": {
            "type": "string",
            "description": "Optional single goal ID."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "FrontierResponse": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of Goal UUIDs that are ready to be learned."
          }
        }
      },
      "PlannedGoalsRequest": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "description": "List of goal IDs (UUIDs)",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "goals"
        ]
      },
      "PlannedGoalsResponse": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateCurriculumRequest": {
        "type": "object",
        "properties": {
          "curriculumId": {
            "type": "string"
          }
        }
      },
      "PersonalizationRequest": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "description": "Configuration map. Key = Landscape ID. Value = {selected: boolean, filterId: string}. EXAMPLE: {'math-de': {'selected': true, 'filterId': 'Q1'}}",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "selected": {
                  "type": "boolean"
                },
                "filterId": {
                  "type": "string"
                }
              }
            }
          },
          "goalIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of Goal IDs (UUIDs) to enable (e.g. subject/module goals). The backend will automatically select the corresponding landscapes. When applying GK/LK filters, include the relevant subject/module goal IDs here; filters alone do not select a subject."
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of filter tags (e.g. 'LK', 'GK') to apply to the selected landscapes. Use together with goalIds unless you intentionally want no subject selection."
          }
        }
      },
      "LandscapeOverviewResponse": {
        "type": "object",
        "properties": {
          "summaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LandscapeSummary"
            }
          }
        }
      },
      "LandscapeSummary": {
        "type": "object",
        "properties": {
          "curriculumId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LandscapeFilter"
            }
          }
        }
      },
      "LandscapeFilter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "CopySource": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "copiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ExamScoringStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ExamScoring": {
        "type": "object",
        "properties": {
          "maxPoints": {
            "type": "number"
          },
          "passingPoints": {
            "type": "number"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamScoringStep"
            }
          }
        }
      },
      "ExamData": {
        "type": "object",
        "properties": {
          "reviewStatus": {
            "type": "string",
            "enum": [
              "draft",
              "needs_review",
              "released"
            ]
          },
          "coveredGoalIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coveredStrands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "demandLevels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceArtifactPath": {
            "type": "string"
          },
          "taskContent": {
            "type": "string"
          },
          "taskContentEn": {
            "type": "string"
          },
          "solutionContent": {
            "type": "string"
          },
          "solutionContentEn": {
            "type": "string"
          },
          "scoring": {
            "$ref": "#/components/schemas/ExamScoring"
          }
        }
      },
      "RedeemStartCodeRequest": {
        "type": "object",
        "required": [
          "startCode"
        ],
        "properties": {
          "startCode": {
            "type": "string",
            "description": "Short-lived start code from skillpilot.com, e.g. SP-7KQ9-M2PA. Not a SkillPilot ID."
          }
        }
      },
      "RedeemStartCodeResponse": {
        "type": "object",
        "required": [
          "assistantMessage",
          "chatSessionToken",
          "expiresAt",
          "state"
        ],
        "properties": {
          "assistantMessage": {
            "type": "string",
            "description": "Complete visible startup answer for the GPT. Output verbatim; may include the Cockpit link to the active goal."
          },
          "chatSessionToken": {
            "type": "string",
            "description": "Chat session token returned by redeemStartCode. Do not display it, do not ask the learner for it, use it only for follow-up tool calls."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiry time of the chat session."
          },
          "state": {
            "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
          }
        }
      },
      "SessionExpiredResponse": {
        "type": "object",
        "description": "Response returned when the temporary chat session has expired. The GPT must guide the learner to restart through skillpilot.com and must not ask for the SkillPilot ID.",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "chat_session_expired"
            ]
          },
          "message": {
            "type": "string",
            "description": "Short technical category for the tool response. Do not repeat it verbatim to learners."
          },
          "recovery": {
            "type": "string",
            "description": "Instruction for the GPT: explain restart through skillpilot.com, do not ask for the SkillPilot ID in chat."
          }
        }
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "SkillPilot Visible Session API (EN)",
    "version": "0.2.0",
    "description": "Self-contained English Action API for the complete SkillPilot Learning Coach with visibly relayed 24-hour session context."
  },
  "servers": [
    {
      "url": "https://skillpilot.com"
    }
  ],
  "paths": {
    "/api/ai/en/sessions/{chatSessionToken}/visible/state": {
      "get": {
        "operationId": "getVisibleState",
        "summary": "Load the current visible learner state",
        "description": "Call before every new substantive ordinary answer turn. relayFooter becomes the final visible answer line verbatim.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exact visible temporary session token from the current chat; begins with sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/VisibleState"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/visible/choice": {
      "post": {
        "operationId": "applyVisibleChoice",
        "summary": "Apply a visible numbered choice",
        "description": "Uses only selection code and numbers from the latest visible choice or an immediately preceding Action in the same assistant turn. The server resolves curriculum, personalization, scope, learning mode, or goal.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exact visible temporary session token from the current chat; begins with sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleChoiceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VisibleState"
          },
          "400": {
            "$ref": "#/components/responses/VisibleState"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/visible/navigation": {
      "post": {
        "operationId": "requestVisibleNavigation",
        "summary": "Request visible navigation for a switch",
        "description": "Without changing state, creates a numbered choice for an explicitly requested curriculum, profile, scope, or goal switch.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exact visible temporary session token from the current chat; begins with sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleNavigationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VisibleState"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/visible/active-goal": {
      "post": {
        "operationId": "setVisibleActiveGoal",
        "summary": "Activate a visibly referenced learning goal",
        "description": "Activates only a full globally unique SkillPilot learning-goal ID already visible in the chat.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exact visible temporary session token from the current chat; begins with sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleActiveGoalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VisibleState"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/visible/mastery": {
      "post": {
        "operationId": "setVisibleMastery",
        "summary": "Save mastery for the active learning goal",
        "description": "Saves Mastery 1.0 only for the active visible learning-goal ID and only after sufficient subject evidence.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exact visible temporary session token from the current chat; begins with sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleMasteryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VisibleState"
          },
          "400": {
            "$ref": "#/components/responses/VisibleState"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/visible/verified-recall/start": {
      "post": {
        "operationId": "startVisibleVerifiedRecall",
        "summary": "Start or continue visible flashcard verification",
        "description": "Returns a numbered card batch. Every cardId and prompt must be displayed visibly before the follow-up turn.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exact visible temporary session token from the current chat; begins with sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleVerifiedRecallStartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VerifiedRecallPrompt"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/visible/verified-recall/answer": {
      "post": {
        "operationId": "getVisibleVerifiedRecallAnswer",
        "summary": "Load the expected flashcard answer after submission",
        "description": "Call only after the learner visibly answered this exact cardId. Never output expectedAnswer beforehand.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exact visible temporary session token from the current chat; begins with sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleVerifiedRecallAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VerifiedRecallAnswer"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/visible/verified-recall/result": {
      "post": {
        "operationId": "recordVisibleVerifiedRecallResult",
        "summary": "Save a graded flashcard result",
        "description": "Saves passed or failed for a previously visible cardId. The server enforces the daily lock.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exact visible temporary session token from the current chat; begins with sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleVerifiedRecallResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VerifiedRecallResult"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/en/sessions/{chatSessionToken}/visible/exam/evaluation": {
      "post": {
        "operationId": "getVisibleExamEvaluation",
        "summary": "Load the exam solution only after complete submission",
        "description": "Call only after the complete visible exam submission. solutionContent remains strictly protected until then and is never returned in state.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exact visible temporary session token from the current chat; begins with sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleExamEvaluationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ExamEvaluation"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "VisibleState": {
        "description": "Complete relay-safe visible coach state.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleCoachStateResponse"
            }
          }
        }
      },
      "VerifiedRecallPrompt": {
        "description": "Flashcard batch to display visibly, or waiting/completion status.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleVerifiedRecallPromptResponse"
            }
          }
        }
      },
      "VerifiedRecallAnswer": {
        "description": "Expected answer for a visible card the learner already answered.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleVerifiedRecallAnswerResponse"
            }
          }
        }
      },
      "VerifiedRecallResult": {
        "description": "Saved card result and next recall status.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleVerifiedRecallResultResponse"
            }
          }
        }
      },
      "ExamEvaluation": {
        "description": "Protected exam solution and scoring scheme after complete submission.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleExamEvaluationResponse"
            }
          }
        }
      },
      "StateConflict": {
        "description": "Workflow state changed. Display the returned state visibly and follow its instruction.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleCoachStateResponse"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid visible choice or request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid session token or invalid Action authentication.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "SessionExpired": {
        "description": "The session expired. Call no further Action; restart through skillpilot.com.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SessionExpiredResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "VisibleChoiceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selectionReference"
        ],
        "properties": {
          "selectionReference": {
            "type": "string",
            "description": "Selection code from the latest visible choice or the immediately preceding Action in the same assistant turn."
          },
          "choiceNumber": {
            "type": "integer",
            "minimum": 1,
            "description": "Exactly one visible number or one uniquely identified by the current natural request; do not send with choiceNumbers."
          },
          "choiceNumbers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Only for an explicitly chosen multi-selection of learning scope; otherwise use choiceNumber."
          }
        }
      },
      "VisibleActiveGoalRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Full globally unique SkillPilot learning-goal ID already visible in the chat."
          },
          "redirect": {
            "type": "boolean",
            "default": false,
            "description": "Set true only for an explicit deliberate switch away from the active goal."
          }
        }
      },
      "VisibleNavigationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "curriculum",
              "personalization",
              "scope",
              "goal"
            ],
            "description": "Only the navigation area explicitly requested by the learner."
          }
        }
      },
      "VisibleMasteryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Active learning-goal ID from the latest visible relayFooter; the backend saves 1.0."
          }
        }
      },
      "VisibleVerifiedRecallStartRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Visible active learning-goal ID of a memorization goal."
          },
          "batchSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10,
            "description": "Number of cards to ask visibly together; use the Cockpit preference, otherwise 10."
          }
        }
      },
      "VisibleVerifiedRecallAnswerRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId",
          "cardId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Visible active learning-goal ID."
          },
          "cardId": {
            "type": "string",
            "description": "Exact visible card ID from the most recently asked batch."
          }
        }
      },
      "VisibleVerifiedRecallResultRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId",
          "cardId",
          "passed"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Visible active learning-goal ID."
          },
          "cardId": {
            "type": "string",
            "description": "Exact visible card ID."
          },
          "passed": {
            "type": "boolean",
            "description": "Set true only when the visible answer was sufficiently correct without a revealed answer."
          },
          "feedback": {
            "type": "string",
            "description": "Short subject-specific reason for the grade."
          }
        }
      },
      "VisibleExamEvaluationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Visible active exam learning-goal ID after complete submission."
          }
        }
      },
      "VisibleCoachStateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relayFooter",
          "learningState",
          "requiredAction",
          "interactionMode",
          "resources",
          "progress",
          "completion",
          "allowedActions",
          "instruction"
        ],
        "properties": {
          "relayFooter": {
            "type": "string",
            "description": "Exact final visible answer line. Output verbatim and write nothing after it."
          },
          "learningState": {
            "type": "string",
            "description": "Compact current learning state."
          },
          "requiredAction": {
            "type": "string",
            "description": "Binding next coach step. teachActiveGoal means dialogue, not an Action."
          },
          "interactionMode": {
            "type": "string",
            "enum": [
              "selection",
              "chat",
              "cockpit",
              "exam",
              "verifiedRecall",
              "complete"
            ],
            "description": "Binding output mode; determines the permitted flow before every substantive answer."
          },
          "curriculum": {
            "$ref": "#/components/schemas/CurriculumSummary"
          },
          "activeGoal": {
            "$ref": "#/components/schemas/PublicActiveGoal"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisibleResource"
            }
          },
          "selection": {
            "$ref": "#/components/schemas/VisibleSelection"
          },
          "progress": {
            "$ref": "#/components/schemas/VisibleProgress"
          },
          "completion": {
            "$ref": "#/components/schemas/VisibleCompletion"
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "getVisibleState",
                "applyVisibleChoice",
                "requestVisibleNavigation",
                "setVisibleActiveGoal",
                "setVisibleMastery",
                "startVisibleVerifiedRecall",
                "getVisibleVerifiedRecallAnswer",
                "recordVisibleVerifiedRecallResult",
                "getVisibleExamEvaluation"
              ]
            },
            "description": "operationId values from this Visible Session API allowed in the current state."
          },
          "instruction": {
            "type": "string",
            "description": "Short binding follow-up instruction from the backend."
          }
        }
      },
      "CurriculumSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        }
      },
      "PublicActiveGoal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId",
          "title",
          "description",
          "nodeKind",
          "cockpitUrl"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Intentionally visible, globally unique canonical learning-goal ID."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "nodeKind": {
            "type": "string",
            "enum": [
              "tutor",
              "memory",
              "exam"
            ]
          },
          "cockpitUrl": {
            "type": "string",
            "format": "uri",
            "description": "Backend-generated public link to the active learning goal; use verbatim and never assemble it yourself."
          },
          "examData": {
            "$ref": "#/components/schemas/VisibleExamPresentation"
          }
        }
      },
      "VisibleSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selectionReference",
          "question",
          "options"
        ],
        "properties": {
          "selectionReference": {
            "type": "string",
            "description": "Time-local selection code; display only when a user follow-up is needed, otherwise forward directly in the same assistant turn."
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisibleChoiceOption"
            }
          }
        }
      },
      "VisibleChoiceOption": {
        "type": "object",
        "additionalProperties": false,

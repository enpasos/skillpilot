{
  "openapi": "3.1.0",
  "info": {
    "title": "SkillPilot Visible Session API (DE)",
    "version": "0.2.0",
    "description": "Eigenständige deutsche Action-API für den vollständigen SkillPilot-Lerncoach mit sichtbar weitergetragenem 24-Stunden-Sitzungskontext."
  },
  "servers": [
    {
      "url": "https://skillpilot.com"
    }
  ],
  "paths": {
    "/api/ai/de/sessions/{chatSessionToken}/visible/state": {
      "get": {
        "operationId": "getVisibleState",
        "summary": "Aktuellen sichtbaren Lernzustand laden",
        "description": "Vor jedem neuen substantiellen normalen Antwortturn aufrufen. relayFooter wird wortgleich die letzte sichtbare Antwortzeile.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exaktes sichtbares temporäres Sitzungstoken aus dem aktuellen Chat; beginnt mit sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/VisibleState"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/visible/choice": {
      "post": {
        "operationId": "applyVisibleChoice",
        "summary": "Sichtbare nummerierte Auswahl anwenden",
        "description": "Verwendet nur Auswahlcode und Nummer oder Scope-Nummern aus dem letzten sichtbaren Auswahlturn. Löst Lehrplan, Personalisierung, Scope, Lernmodus oder Lernziel serverseitig auf.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exaktes sichtbares temporäres Sitzungstoken aus dem aktuellen Chat; beginnt mit sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleChoiceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VisibleState"
          },
          "400": {
            "$ref": "#/components/responses/VisibleState"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/visible/navigation": {
      "post": {
        "operationId": "requestVisibleNavigation",
        "summary": "Sichtbare Navigation für einen Wechsel anfordern",
        "description": "Erzeugt ohne Zustandsänderung eine nummerierte Auswahl für einen ausdrücklich gewünschten Lehrplan-, Profil-, Scope- oder Zielwechsel.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exaktes sichtbares temporäres Sitzungstoken aus dem aktuellen Chat; beginnt mit sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleNavigationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VisibleState"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/visible/active-goal": {
      "post": {
        "operationId": "setVisibleActiveGoal",
        "summary": "Sichtbar referenziertes Lernziel aktivieren",
        "description": "Aktiviert nur eine vollständige global eindeutige SkillPilot-Lernziel-ID, die bereits sichtbar im Chat steht.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exaktes sichtbares temporäres Sitzungstoken aus dem aktuellen Chat; beginnt mit sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleActiveGoalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VisibleState"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/visible/mastery": {
      "post": {
        "operationId": "setVisibleMastery",
        "summary": "Mastery für das aktive Lernziel speichern",
        "description": "Speichert Mastery 1.0 ausschließlich für die aktive sichtbare Lernziel-ID und erst nach ausreichender fachlicher Evidenz.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exaktes sichtbares temporäres Sitzungstoken aus dem aktuellen Chat; beginnt mit sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleMasteryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VisibleState"
          },
          "400": {
            "$ref": "#/components/responses/VisibleState"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/visible/verified-recall/start": {
      "post": {
        "operationId": "startVisibleVerifiedRecall",
        "summary": "Sichtbare Lernkartenprüfung starten oder fortsetzen",
        "description": "Liefert einen nummerierten Kartenbatch. Jede cardId und jeder Prompt müssen vor dem Folgeturn sichtbar ausgegeben werden.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exaktes sichtbares temporäres Sitzungstoken aus dem aktuellen Chat; beginnt mit sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleVerifiedRecallStartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VerifiedRecallPrompt"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/visible/verified-recall/answer": {
      "post": {
        "operationId": "getVisibleVerifiedRecallAnswer",
        "summary": "Erwartete Lernkartenantwort nach Abgabe laden",
        "description": "Nur nach der sichtbaren Antwort der lernenden Person auf genau diese cardId aufrufen. expectedAnswer vorher nie ausgeben.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exaktes sichtbares temporäres Sitzungstoken aus dem aktuellen Chat; beginnt mit sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleVerifiedRecallAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VerifiedRecallAnswer"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/visible/verified-recall/result": {
      "post": {
        "operationId": "recordVisibleVerifiedRecallResult",
        "summary": "Bewertetes Lernkartenergebnis speichern",
        "description": "Speichert passed oder failed für eine zuvor sichtbar gestellte cardId. Der Tages-Lock wird serverseitig erzwungen.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exaktes sichtbares temporäres Sitzungstoken aus dem aktuellen Chat; beginnt mit sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleVerifiedRecallResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/VerifiedRecallResult"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/visible/exam/evaluation": {
      "post": {
        "operationId": "getVisibleExamEvaluation",
        "summary": "Prüfungslösung erst nach vollständiger Abgabe laden",
        "description": "Nur nach der vollständigen sichtbaren Prüfungsabgabe aufrufen. solutionContent ist bis dahin strikt geschützt und wird nie im State geliefert.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Exaktes sichtbares temporäres Sitzungstoken aus dem aktuellen Chat; beginnt mit sps_.",
            "schema": {
              "type": "string",
              "pattern": "^sps_[A-Za-z0-9_-]{43}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibleExamEvaluationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ExamEvaluation"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "410": {
            "$ref": "#/components/responses/SessionExpired"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "VisibleState": {
        "description": "Vollständiger relay-sicherer sichtbarer Coach-Zustand.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleCoachStateResponse"
            }
          }
        }
      },
      "VerifiedRecallPrompt": {
        "description": "Sichtbar zu stellender Lernkartenbatch oder Warte-/Abschlussstatus.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleVerifiedRecallPromptResponse"
            }
          }
        }
      },
      "VerifiedRecallAnswer": {
        "description": "Erwartete Antwort für eine bereits beantwortete sichtbare Karte.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleVerifiedRecallAnswerResponse"
            }
          }
        }
      },
      "VerifiedRecallResult": {
        "description": "Gespeichertes Kartenergebnis und nächster Recall-Status.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleVerifiedRecallResultResponse"
            }
          }
        }
      },
      "ExamEvaluation": {
        "description": "Geschützte Prüfungslösung und Bewertungsschema nach vollständiger Abgabe.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleExamEvaluationResponse"
            }
          }
        }
      },
      "StateConflict": {
        "description": "Der Ablaufzustand hat sich geändert. Den zurückgegebenen Zustand sichtbar ausgeben und seiner instruction folgen.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VisibleCoachStateResponse"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Ungültige sichtbare Auswahl oder Anfrage.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Ungültiges Sitzungstoken oder ungültige Action-Authentifizierung.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "SessionExpired": {
        "description": "Die Sitzung ist abgelaufen. Keine weitere Action; Neustart über skillpilot.com.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SessionExpiredResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "VisibleChoiceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selectionReference"
        ],
        "properties": {
          "selectionReference": {
            "type": "string",
            "description": "Auswahlcode aus dem letzten sichtbaren Auswahlturn."
          },
          "choiceNumber": {
            "type": "integer",
            "minimum": 1,
            "description": "Genau eine von der lernenden Person gewählte sichtbare Nummer; nicht zusammen mit choiceNumbers senden."
          },
          "choiceNumbers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Nur für eine ausdrücklich gewählte Mehrfachauswahl des Lernumfangs; sonst choiceNumber verwenden."
          }
        }
      },
      "VisibleActiveGoalRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Vollständige global eindeutige SkillPilot-Lernziel-ID, die bereits sichtbar im Chat steht."
          },
          "redirect": {
            "type": "boolean",
            "default": false,
            "description": "Nur bei einem ausdrücklichen bewussten Wechsel weg vom aktiven Ziel true."
          }
        }
      },
      "VisibleNavigationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "curriculum",
              "personalization",
              "scope",
              "goal"
            ],
            "description": "Nur der von der lernenden Person ausdrücklich gewünschte Navigationsbereich."
          }
        }
      },
      "VisibleMasteryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Aktive Lernziel-ID aus dem letzten sichtbaren relayFooter; das Backend speichert 1.0."
          }
        }
      },
      "VisibleVerifiedRecallStartRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Sichtbare aktive Lernziel-ID eines Memorierungsziels."
          },
          "batchSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10,
            "description": "Zahl gleichzeitig sichtbar abzufragender Karten; Cockpit-Vorgabe nutzen, sonst 10."
          }
        }
      },
      "VisibleVerifiedRecallAnswerRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId",
          "cardId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Sichtbare aktive Lernziel-ID."
          },
          "cardId": {
            "type": "string",
            "description": "Exakte sichtbare Karten-ID aus dem zuletzt gestellten Batch."
          }
        }
      },
      "VisibleVerifiedRecallResultRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId",
          "cardId",
          "passed"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Sichtbare aktive Lernziel-ID."
          },
          "cardId": {
            "type": "string",
            "description": "Exakte sichtbare Karten-ID."
          },
          "passed": {
            "type": "boolean",
            "description": "Nur true, wenn die sichtbare Antwort ohne vorweggenommene Lösung ausreichend korrekt war."
          },
          "feedback": {
            "type": "string",
            "description": "Kurze fachliche Begründung der Bewertung."
          }
        }
      },
      "VisibleExamEvaluationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goalId"
        ],
        "properties": {
          "goalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "description": "Sichtbare aktive Exam-Lernziel-ID nach vollständiger Abgabe."
          }
        }
      },
      "VisibleCoachStateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relayFooter",
          "learningState",
          "requiredAction",
          "interactionMode",
          "resources",
          "progress",
          "completion",
          "allowedActions",
          "instruction"
        ],
        "properties": {
          "relayFooter": {
            "type": "string",
            "description": "Exakte letzte sichtbare Antwortzeile. Wortgleich ausgeben und nichts danach schreiben."
          },
          "learningState": {
            "type": "string",
            "description": "Kompakter aktueller Lernzustand."
          },
          "requiredAction": {
            "type": "string",
            "description": "Nächster verbindlicher Coach-Schritt. teachActiveGoal bedeutet Dialog, nicht Action."
          },
          "interactionMode": {
            "type": "string",
            "enum": [
              "selection",
              "chat",
              "cockpit",
              "exam",
              "verifiedRecall",
              "complete"
            ],
            "description": "Verbindlicher Ausgabemodus; entscheidet vor jeder inhaltlichen Antwort über den erlaubten Ablauf."
          },
          "curriculum": {
            "$ref": "#/components/schemas/CurriculumSummary"
          },
          "activeGoal": {
            "$ref": "#/components/schemas/PublicActiveGoal"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VisibleResource"
            }
          },
          "selection": {
            "$ref": "#/components/schemas/VisibleSelection"
          },
          "progress": {
            "$ref": "#/components/schemas/VisibleProgress"
          },
          "completion": {
            "$ref": "#/components/schemas/VisibleCompletion"
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "getVisibleState",
                "applyVisibleChoice",
                "requestVisibleNavigation",
                "setVisibleActiveGoal",
                "setVisibleMastery",
                "startVisibleVerifiedRecall",
                "getVisibleVerifiedRecallAnswer",
                "recordVisibleVerifiedRecallResult",
                "getVisibleExamEvaluation"
              ]
            },
            "description": "Im aktuellen Zustand zulässige operationId-Werte dieser Visible-Session-API."
          },
          "instruction": {

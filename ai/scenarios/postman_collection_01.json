    "item": [
        {
            "name": "1. Create Learner",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "if (jsonData.state && jsonData.state.skillpilotId) {",
                            "    pm.collectionVariables.set(\"skillpilotId\", jsonData.state.skillpilotId);",
                            "    console.log(\"Learner ID set: \" + jsonData.state.skillpilotId);",
                            "} else if (jsonData.skillpilotId) {",
                            "    pm.collectionVariables.set(\"skillpilotId\", jsonData.skillpilotId);",
                            "    console.log(\"Learner ID set: \" + jsonData.skillpilotId);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/learners",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "learners"
                    ]
                }
            }
        },
        {
            "name": "2. Set Curriculum (Oberstufe)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "pm.test(\"Curriculum set\", function () {",
                            "    pm.expect(jsonData.curriculum).to.exist;",
                            "});",
                            "pm.test(\"Has StateMachine\", function () {",
                            "    pm.expect(jsonData.stateMachine).to.exist;",
                            "});",
                            "var options = (jsonData.stateMachine && jsonData.stateMachine.goalOptions) || [];",
                            "var math = options.find(function (g) {",
                            "    return (g.title || \"\").toLowerCase() === \"mathematik\";",
                            "});",
                            "if (!math && jsonData.frontier) {",
                            "    math = jsonData.frontier.find(function (g) {",
                            "        return (g.title || \"\").toLowerCase() === \"mathematik\";",
                            "    });",
                            "}",
                            "if (!math && options.length === 1) {",
                            "    math = options[0];",
                            "}",
                            "if (math && math.id) {",
                            "    pm.collectionVariables.set(\"subjectGoalId\", math.id);",
                            "    console.log(\"Subject Goal ID set: \" + math.id + \" (\" + math.title + \")\");",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"curriculumId\": \"{{curriculumId}}\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/learners/{{skillpilotId}}/curriculum",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "learners",
                        "{{skillpilotId}}",
                        "curriculum"
                    ]
                }
            }
        },
        {
            "name": "3. Personalize (Focus Math)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "pm.test(\"Has StateMachine\", function () {",
                            "    pm.expect(jsonData.stateMachine).to.exist;",
                            "});",
                            "var options = (jsonData.stateMachine && jsonData.stateMachine.goalOptions) || [];",
                            "var cluster = options.find(function (g) {",
                            "    return g.type === \"cluster\";",
                            "});",
                            "if (!cluster && jsonData.frontier) {",
                            "    cluster = jsonData.frontier.find(function (g) {",
                            "        return g.type === \"cluster\";",
                            "    });",
                            "}",
                            "if (!cluster && options.length === 1) {",
                            "    cluster = options[0];",
                            "}",
                            "if (cluster && cluster.id) {",
                            "    pm.collectionVariables.set(\"scopeGoalId\", cluster.id);",
                            "    console.log(\"Scope Goal ID set: \" + cluster.id + \" (\" + cluster.title + \")\");",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"goalIds\": [\"{{subjectGoalId}}\"]\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/learners/{{skillpilotId}}/personalization",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "learners",
                        "{{skillpilotId}}",
                        "personalization"
                    ]
                }
            }
        },
        {
            "name": "4. Set Scope (by IDs)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "pm.test(\"Has Planned Goals\", function () {",
                            "    pm.expect(jsonData.goals && jsonData.goals.planned).to.be.an('array');",
                            "});",
                            "var options = (jsonData.stateMachine && jsonData.stateMachine.goalOptions) || [];",
                            "var atomic = options.find(function (g) {",
                            "    return g.type === \"atomic\";",
                            "});",
                            "if (!atomic && jsonData.frontier) {",
                            "    atomic = jsonData.frontier.find(function (g) {",
                            "        return g.type === \"atomic\";",
                            "    });",
                            "}",
                            "if (!atomic && options.length === 1) {",
                            "    atomic = options[0];",
                            "}",
                            "if (atomic && atomic.id) {",
                            "    pm.collectionVariables.set(\"activeGoalId\", atomic.id);",
                            "    console.log(\"Active Goal ID set: \" + atomic.id + \" (\" + atomic.title + \")\");",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"goalIds\": [\"{{scopeGoalId}}\"]\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/learners/{{skillpilotId}}/scope",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "learners",
                        "{{skillpilotId}}",
                        "scope"
                    ]
                }
            }
        },
        {
            "name": "5. Set Active Goal",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "pm.test(\"Active goal locked\", function () {",
                            "    pm.expect(jsonData.activeGoal).to.exist;",
                            "});",
                            "if (jsonData.activeGoal && jsonData.activeGoal.id) {",
                            "    pm.collectionVariables.set(\"activeGoalId\", jsonData.activeGoal.id);",
                            "    console.log(\"Active Goal confirmed: \" + jsonData.activeGoal.id + \" (\" + jsonData.activeGoal.title + \")\");",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"goalId\": \"{{activeGoalId}}\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/learners/{{skillpilotId}}/active-goal",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "learners",
                        "{{skillpilotId}}",
                        "active-goal"
                    ]
                }
            }
        },
        {
            "name": "6. Set Mastery (Simulate 1.0)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "pm.test(\"Returns Frontier\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.frontier).to.be.an('array');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],

{
  "openapi": "3.1.0",
  "info": {
    "title": "Skillpilot AI Interface",
    "description": "Skillpilot learner-state API for loading learner context, selecting goals, and saving mastery updates.",
    "version": "v2-ai-optimized-unified"
  },
  "servers": [
    {
      "url": "https://skillpilot.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/ai/en/learners": {
      "post": {
        "operationId": "createLearner",
        "summary": "Initialize a new learner session",
        "description": "Creates a new learner entity.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLearnerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learner created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateLearnerResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/learners/{skillpilotId}/state": {
      "get": {
        "operationId": "getLearnerState",
        "summary": "Get unified learner state",
        "description": "Returns current learner state for a known `skillpilotId`.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unified state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/learners/{skillpilotId}/scope": {
      "post": {
        "operationId": "setScope",
        "summary": "Set learning scope/focus",
        "description": "Sets learning focus with Goal IDs from the latest loaded state and returns updated state.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScopeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scope updated. Returns new learner state with planned goals.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/learners/{skillpilotId}/active-goal": {
      "post": {
        "operationId": "setActiveGoal",
        "summary": "Lock an atomic goal for teaching",
        "description": "Locks one atomic goal from the latest loaded state as the active goal and returns the new learner state.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveGoalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active goal set. Returns new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/learners/{skillpilotId}/mastery": {
      "post": {
        "operationId": "setMastery",
        "summary": "Update mastery and get next steps",
        "description": "Persists mastery updates for the current active goal and returns the updated learner state.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MasteryUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mastery updated, returns new frontier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasteryUpdateResponse"
                }
              }
            }
          },
          "409": {
            "description": "Saving mastery requires a prerequisite action. Returns current state and the next required step.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/landscapes": {
      "get": {
        "operationId": "listLandscapes",
        "summary": "List available curriculums",
        "responses": {
          "200": {
            "description": "List of available landscapes/curriculums",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandscapeOverviewResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/learners/{skillpilotId}/curriculum": {
      "post": {
        "operationId": "setCurriculum",
        "summary": "Set current curriculum/landscape",
        "description": "Sets the active curriculum and returns updated learner state.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurriculumRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Curriculum updated successfully. Returns the new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Learner or Curriculum not found"
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/en/learners/{skillpilotId}/personalization": {
      "post": {
        "operationId": "setPersonalization",
        "summary": "Personalize the curriculum",
        "description": "Stores learner preferences and filters and returns updated learner state.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonalizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Personalization updated. Returns new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key"
      }
    },
    "schemas": {
      "CreateLearnerRequest": {
        "type": "object",
        "properties": {}
      },
      "CreateLearnerResponse": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
          },
          "availableCurricula": {
            "type": "array",
            "description": "List of available curricula to choose from if none was auto-selected.",
            "items": {
              "$ref": "#/components/schemas/LandscapeSummary"
            }
          }
        }
      },
      "UnifiedLearnerStateResponse": {
        "type": "object",
        "properties": {
          "skillpilotId": {
            "type": "string"
          },
          "curriculum": {
            "$ref": "#/components/schemas/LandscapeSummary"
          },
          "frontier": {
            "type": "array",
            "description": "Goals available to learn in current state (atomic and cluster). These are candidates; the confirmed current goal is returned separately in `activeGoal`.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "goals": {
            "$ref": "#/components/schemas/LearnerGoals"
          },
          "nextAllowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Backend-allowed next actions."
          },
          "activeFilters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of active filter IDs (e.g. 'LK', 'GK') applied to the current curriculum."
          },
          "copySources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CopySource"
            }
          },
          "learningState": {
            "type": "string",
            "description": "Current learning state (e.g. FRONTIER, TEACHING)."
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal",
            "description": "Confirmed active goal currently selected."
          },
          "stateMachine": {
            "$ref": "#/components/schemas/StateMachineInfo"
          }
        }
      },
      "ActiveGoalRequest": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "description": "Atomic goal ID from the latest loaded state to lock as the current learning target."
          },
          "redirect": {
            "type": "boolean",
            "description": "Set true only when the user explicitly requests moving to another active goal."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "FrontierGoal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "atomic",
              "cluster"
            ]
          },
          "nodeKind": {
            "type": "string",
            "enum": [
              "exam",
              "tutor",
              "memory"
            ]
          },
          "reason": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resourceLinks": {
            "description": "Ordered helpful learning resources for this goal. Canonical field for Cockpit and AI tutors.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalSourceLink"
            }
          },
          "sourceRef": {
            "type": "string",
            "description": "Canonical provenance reference for this goal, preferably a stable URL when available, otherwise a citation string."
          },
          "sourceLicense": {
            "type": "string",
            "description": "License label for the canonical source (e.g. CC-BY-NC-SA-4.0)."
          },
          "sourceLicenseUrl": {
            "type": "string",
            "description": "URL to the applicable license or terms page."
          },
          "examData": {
            "$ref": "#/components/schemas/ExamData",
            "description": "Full exam payload. Guaranteed only on `activeGoal` and `stateMachine.activeGoal`; selectable candidates may omit this field."
          }
        }
      },
      "GoalSourceLink": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Didactic role of the link, e.g. overview, concept, practice, assessment, solution, reference."
          },
          "title": {
            "type": "string",
            "description": "Short user-facing label."
          },
          "url": {
            "type": "string",
            "description": "Absolute target URL."
          },
          "resourceType": {
            "type": "string",
            "description": "Concrete material kind, e.g. course-page, video, notes, article, simulation, problem-set, exam, solution-set, book, tool."
          },
          "provider": {
            "type": "string",
            "description": "Optional provider or site label, e.g. MIT OCW or physikbuch.schule."
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional chapter or section hints relevant to the goal."
          },
          "description": {
            "type": "string",
            "description": "Optional short note explaining why the link is useful."
          },
          "lang": {
            "type": "string",
            "description": "Optional BCP-47 language tag for the linked resource."
          },
          "license": {
            "type": "string",
            "description": "Optional license label for the linked resource."
          }
        }
      },
      "LearnerGoals": {
        "type": "object",
        "properties": {
          "planned": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "mastered_count": {
            "type": "integer",
            "description": "Mastered atomic goals in the current focus (scope if set, otherwise personalized curriculum)."
          },
          "total_count": {
            "type": "integer",
            "description": "Total atomic goals in the current focus (scope if set, otherwise personalized curriculum)."
          },
          "personalized": {
            "$ref": "#/components/schemas/GoalStats"
          },
          "scope": {
            "$ref": "#/components/schemas/GoalStats"
          },
          "scope_completed": {
            "type": "boolean",
            "description": "True when the current scope (planned focus) is fully mastered."
          }
        }
      },
      "GoalStats": {
        "type": "object",
        "properties": {
          "mastered_atomic": {
            "type": "integer"
          },
          "total_atomic": {
            "type": "integer"
          }
        }
      },
      "ScopeRequest": {
        "type": "object",
        "properties": {
          "goalIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Goal IDs from the latest loaded state that define the current learning scope."
          }
        },
        "required": [
          "goalIds"
        ]
      },
      "MasteryUpdateResponse": {
        "type": "object",
        "properties": {
          "frontier": {
            "type": "array",
            "description": "Updated candidate goals after mastery (atomic and cluster). The confirmed current goal is returned separately in `activeGoal`.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "nextAllowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Backend-allowed next actions."
          },
          "learningState": {
            "type": "string",
            "description": "Current learning state after mastery (e.g. FRONTIER, TEACHING)."
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal",
            "description": "Confirmed active goal after mastery handling."
          },
          "stateMachine": {
            "$ref": "#/components/schemas/StateMachineInfo"
          },
          "goals": {
            "$ref": "#/components/schemas/LearnerGoals"
          }
        }
      },
      "StateMachineInfo": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "description": "Current high-level state (SETUP, FRONTIER, TEACHING)."
          },
          "requiredAction": {
            "type": "string",
            "description": "Single backend-required action for the current state, if any."
          },
          "goalOptions": {
            "type": "array",
            "description": "Goal options returned for the current `requiredAction`. These are selectable candidates, not automatically the confirmed active goal.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "curriculumOptions": {
            "type": "array",
            "description": "Curriculum options when a curriculum must be selected.",
            "items": {
              "$ref": "#/components/schemas/LandscapeSummary"
            }
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal",
            "description": "Confirmed active goal inside state machine."
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "skillpilotId": {
            "type": "string"
          },
          "selectedCurriculum": {
            "type": "string",
            "description": "ID of the current landscape"
          }
        }
      },
      "MasteryUpdateRequest": {
        "type": "object",
        "properties": {
          "mastery": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "description": "Map of {goalId: value} for mastery updates (0.0-1.0)."
          },
          "goalId": {
            "type": "string",
            "description": "Optional target atomic goal ID."
          }
        }
      },
      "MasteryResponse": {
        "type": "object",
        "properties": {
          "mastery": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "description": "Map of goal ID to mastery score (0.0 to 1.0)."
          },
          "goalId": {
            "type": "string",
            "description": "Optional single goal ID."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "FrontierResponse": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of Goal UUIDs that are ready to be learned."
          }
        }
      },
      "PlannedGoalsRequest": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "description": "List of goal IDs (UUIDs)",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "goals"
        ]
      },
      "PlannedGoalsResponse": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateCurriculumRequest": {
        "type": "object",
        "properties": {
          "curriculumId": {
            "type": "string"
          }
        }
      },
      "PersonalizationRequest": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "description": "Configuration map. Key = Landscape ID. Value = {selected: boolean, filterId: string}. EXAMPLE: {'math-de': {'selected': true, 'filterId': 'Q1'}}",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "selected": {
                  "type": "boolean"
                },
                "filterId": {
                  "type": "string"
                }
              }
            }
          },
          "goalIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of Goal IDs (UUIDs) to enable (e.g. subject/module goals). The backend will automatically select the corresponding landscapes. When applying GK/LK filters, include the relevant subject/module goal IDs here; filters alone do not select a subject."
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of filter tags (e.g. 'LK', 'GK') to apply to the selected landscapes. Use together with goalIds unless you intentionally want no subject selection."
          }
        }
      },
      "LandscapeOverviewResponse": {
        "type": "object",
        "properties": {
          "summaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LandscapeSummary"
            }
          }
        }
      },
      "LandscapeSummary": {
        "type": "object",
        "properties": {
          "curriculumId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LandscapeFilter"
            }
          }
        }
      },
      "LandscapeFilter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "CopySource": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "copiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ExamScoringStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ExamScoring": {
        "type": "object",
        "properties": {
          "maxPoints": {
            "type": "number"
          },
          "passingPoints": {
            "type": "number"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamScoringStep"
            }
          }
        }
      },
      "ExamData": {
        "type": "object",
        "properties": {
          "taskContent": {
            "type": "string"
          },
          "taskContentEn": {
            "type": "string"
          },
          "solutionContent": {
            "type": "string"
          },
          "solutionContentEn": {
            "type": "string"
          },
          "scoring": {
            "$ref": "#/components/schemas/ExamScoring"
          }
        }
      }
    }
  }
}


{
  "openapi": "3.1.0",
  "info": {
    "title": "Skillpilot AI Interface",
    "description": "Optimized API for AI Tutors.\n\n### INSTRUCTIONS\n1. **First Priority**: Ensure you have a `skillpilotId`. If not, **ASK** the user. Do **NOT** create a new learner unless explicitly requested (e.g. 'new user').\n2. **State Machine**: Always follow `stateMachine.requiredAction` (fallback: `nextAllowedActions`).\n   - If `setCurriculum`: ask the user to select from `stateMachine.curriculumOptions`.\n   - If `setPersonalization`: apply subject/module `goalIds` plus `filters` (e.g. GK/LK).\n   - If `setScope`: call `setScope` with `goalIds` from `stateMachine.goalOptions` (scope/cluster options). If `frontier` is empty, treat these as a **context change** (scope is replaced, not expanded) and do not invent new scopes. If only one option or the user says \"egal\", pick it automatically.\n   - If `setActiveGoal`: select from `stateMachine.goalOptions` and call `setActiveGoal`.\n   - **Never teach without an active goal.** If `requiredAction` is `setActiveGoal` (or `activeGoal` is null), call `setActiveGoal` first; no content before that.\n   - If `setMastery`: teach the locked goal and call `setMastery`.\n   - If a call returns **409** due to a required action mismatch (e.g. missing active goal), call `getLearnerState` and follow `stateMachine.requiredAction` immediately.\n3. **Core Concepts**: Use `getLearnerState` for context, `setMastery` for progress.",
    "version": "v2-ai-optimized-unified"
  },
  "servers": [
    {
      "url": "https://skillpilot.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/ai/de/learners": {
      "post": {
        "operationId": "createLearner",
        "summary": "Initialize a new learner session",
        "description": "Creates a new learner entity.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLearnerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learner created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateLearnerResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/learners/{skillpilotId}/state": {
      "get": {
        "operationId": "getLearnerState",
        "summary": "Get unified learner state",
        "description": "Returns the full context: ID, Curriculum, Rich Frontier, and Goals summary. Use this to avoid multiple round trips.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unified state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/learners/{skillpilotId}/scope": {
      "post": {
        "operationId": "setScope",
        "summary": "Set learning scope/focus",
        "description": "Set focus using Goal UUIDs (from stateMachine.goalOptions/frontier). Free-text instructions are not supported; always pass goalIds.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScopeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scope updated. Returns new learner state with planned goals.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/learners/{skillpilotId}/active-goal": {
      "post": {
        "operationId": "setActiveGoal",
        "summary": "Lock an atomic goal for teaching",
        "description": "Selects the current atomic goal (use stateMachine.goalOptions or filter frontier by type=atomic) and locks the session until mastery. Only call when stateMachine.requiredAction is setActiveGoal. If the user explicitly requests a redirect while requiredAction is setMastery, set redirect=true.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveGoalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active goal set. Returns new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/learners/{skillpilotId}/mastery": {
      "post": {
        "operationId": "setMastery",
        "summary": "Update mastery and get next steps",
        "description": "Updates mastery for the active goal and returns the new frontier and state. Call only after real content work on the active goal in this conversation. AI agents must send an explicit mastery map with one entry {goalId: value} and must not rely on empty-request defaults.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MasteryUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mastery updated, returns new frontier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasteryUpdateResponse"
                }
              }
            }
          },
          "409": {
            "description": "Action required before mastery can be saved. Returns current state so the client can follow stateMachine.requiredAction (e.g. setActiveGoal).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/landscapes": {
      "get": {
        "operationId": "listLandscapes",
        "summary": "List available curriculums",
        "responses": {
          "200": {
            "description": "List of available landscapes/curriculums",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandscapeOverviewResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/learners/{skillpilotId}/curriculum": {
      "post": {
        "operationId": "setCurriculum",
        "summary": "Set current curriculum/landscape",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurriculumRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Curriculum updated successfully. Returns the new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Learner or Curriculum not found"
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/learners/{skillpilotId}/personalization": {
      "post": {
        "operationId": "setPersonalization",
        "summary": "Personalize the curriculum",
        "description": "Restrict the curriculum to specific subjects or levels. Use this after selecting a curriculum but before setting a scope.",
        "parameters": [
          {
            "name": "skillpilotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonalizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Personalization updated. Returns new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key"
      }
    },
    "schemas": {
      "CreateLearnerRequest": {
        "type": "object",
        "properties": {}
      },
      "CreateLearnerResponse": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
          },
          "availableCurricula": {
            "type": "array",
            "description": "List of available curricula to choose from if none was auto-selected.",
            "items": {
              "$ref": "#/components/schemas/LandscapeSummary"
            }
          }
        }
      },
      "UnifiedLearnerStateResponse": {
        "type": "object",
        "properties": {
          "skillpilotId": {
            "type": "string"
          },
          "curriculum": {
            "$ref": "#/components/schemas/LandscapeSummary"
          },
          "frontier": {
            "type": "array",
            "description": "Goals ready to be learned; includes atomic and cluster goals. Filter by type=atomic when selecting an active goal.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "goals": {
            "$ref": "#/components/schemas/LearnerGoals"
          },
          "nextAllowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of allowed next actions. The AI MUST follow these hints."
          },
          "activeFilters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of active filter IDs (e.g. 'LK', 'GK') applied to the current curriculum."
          },
          "copySources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CopySource"
            }
          },
          "learningState": {
            "type": "string",
            "description": "Current learning state (e.g. FRONTIER, TEACHING)."
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal"
          },
          "stateMachine": {
            "$ref": "#/components/schemas/StateMachineInfo"
          }
        }
      },
      "ActiveGoalRequest": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "description": "Atomic goal UUID to lock as the current learning target."
          },
          "redirect": {
            "type": "boolean",
            "description": "Set to true only when the user explicitly requests switching away from the current active goal while requiredAction is setMastery."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "FrontierGoal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "atomic",
              "cluster"
            ]
          },
          "nodeKind": {
            "type": "string",
            "enum": [
              "exam",
              "tutor",
              "memory"
            ]
          },
          "reason": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resourceLinks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalSourceLink"
            }
          },
          "sourceRef": {
            "type": "string",
            "description": "Kanonische Curriculum-/Provenienz-Quelle (URL) für dieses Lernziel."
          },
          "sourceLicense": {
            "type": "string",
            "description": "Lizenzbezeichnung der kanonischen Quelle (z. B. CC-BY-NC-SA-4.0)."
          },
          "sourceLicenseUrl": {
            "type": "string",
            "description": "URL zur geltenden Lizenz- oder Terms-Seite."
          },
          "examData": {
            "$ref": "#/components/schemas/ExamData"
          }
        }
      },
      "GoalSourceLink": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "resourceType": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        }
      },
      "LearnerGoals": {
        "type": "object",
        "properties": {
          "planned": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "mastered_count": {
            "type": "integer",
            "description": "Mastered atomic goals in the current focus (scope if set, otherwise personalized curriculum)."
          },
          "total_count": {
            "type": "integer",
            "description": "Total atomic goals in the current focus (scope if set, otherwise personalized curriculum)."
          },
          "personalized": {
            "$ref": "#/components/schemas/GoalStats"
          },
          "scope": {
            "$ref": "#/components/schemas/GoalStats"
          },
          "scope_completed": {
            "type": "boolean",
            "description": "True when the current scope (planned focus) is fully mastered."
          }
        }
      },
      "GoalStats": {
        "type": "object",
        "properties": {
          "mastered_atomic": {
            "type": "integer"
          },
          "total_atomic": {
            "type": "integer"
          }
        }
      },
      "ScopeRequest": {
        "type": "object",
        "properties": {
          "goalIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of Goal IDs (UUIDs) to set as the scope. REQUIRED. Use goal IDs from stateMachine.goalOptions/frontier."
          }
        },
        "required": [
          "goalIds"
        ]
      },
      "MasteryUpdateResponse": {
        "type": "object",
        "properties": {
          "frontier": {
            "type": "array",
            "description": "Updated frontier after mastery; includes atomic and cluster goals. Filter by type=atomic when selecting an active goal.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "nextAllowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of allowed next actions after mastery. The AI MUST follow these hints."
          },
          "learningState": {
            "type": "string",
            "description": "Current learning state after mastery (e.g. FRONTIER, TEACHING)."
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal"
          },
          "stateMachine": {
            "$ref": "#/components/schemas/StateMachineInfo"
          },
          "goals": {
            "$ref": "#/components/schemas/LearnerGoals"
          }
        }
      },
      "StateMachineInfo": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "description": "Current high-level state (SETUP, FRONTIER, TEACHING)."
          },
          "requiredAction": {
            "type": "string",
            "description": "Single required action for the current state. Follow this strictly."
          },
          "goalOptions": {
            "type": "array",
            "description": "Goal options relevant to the required action (e.g. frontier goals or active goal).",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "curriculumOptions": {
            "type": "array",
            "description": "Curriculum options when a curriculum must be selected.",
            "items": {
              "$ref": "#/components/schemas/LandscapeSummary"
            }
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal"
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "skillpilotId": {
            "type": "string"
          },
          "selectedCurriculum": {
            "type": "string",
            "description": "ID of the current landscape"
          }
        }
      },
      "MasteryUpdateRequest": {
        "type": "object",
        "properties": {
          "mastery": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "description": "Map with a single entry {goalId: value} for mastery updates (0.0-1.0). AI agents should always provide this field explicitly."
          },
          "goalId": {
            "type": "string",
            "description": "Optional helper: UUID of the target atomic goal (no children). AI agents should still provide explicit mastery values via the mastery map."
          }
        }
      },
      "MasteryResponse": {
        "type": "object",
        "properties": {
          "mastery": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "description": "Map of Goal UUID to mastery score (0.0 to 1.0). e.g. {'uuid': 1.0}"
          },
          "goalId": {
            "type": "string",
            "description": "Simplification: Single Goal UUID to mark as mastered (1.0)."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "FrontierResponse": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of Goal UUIDs that are ready to be learned."
          }
        }
      },
      "PlannedGoalsRequest": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "description": "List of goal IDs (UUIDs)",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "goals"
        ]
      },
      "PlannedGoalsResponse": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateCurriculumRequest": {
        "type": "object",
        "properties": {
          "curriculumId": {
            "type": "string"
          }
        }
      },
      "PersonalizationRequest": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "description": "Configuration map. Key = Landscape ID. Value = {selected: boolean, filterId: string}. EXAMPLE: {'math-de': {'selected': true, 'filterId': 'Q1'}}",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "selected": {
                  "type": "boolean"
                },
                "filterId": {
                  "type": "string"
                }
              }
            }
          },
          "goalIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of Goal IDs (UUIDs) to enable (e.g. subject/module goals). The backend will automatically select the corresponding landscapes. When applying GK/LK filters, include the relevant subject/module goal IDs here; filters alone do not select a subject."
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of filter tags (e.g. 'LK', 'GK') to apply to the selected landscapes. Use together with goalIds unless you intentionally want no subject selection."
          }
        }
      },
      "LandscapeOverviewResponse": {
        "type": "object",
        "properties": {
          "summaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LandscapeSummary"
            }
          }
        }
      },
      "LandscapeSummary": {
        "type": "object",
        "properties": {
          "curriculumId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LandscapeFilter"
            }
          }
        }
      },
      "LandscapeFilter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "CopySource": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "copiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LearningLandscape": {
        "type": "object",
        "properties": {
          "landscapeId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "goals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningGoal"
            }
          }
        }
      },
      "LearningGoal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "UUID of the goal. Use this for all mastery updates."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IDs of prerequisite goals"
          }
        },
        "example": {
          "id": "123e4567-e89b-12d3-a456-426614174000",
          "title": "Linear Equations",
          "description": "Understanding y = mx + b",
          "requires": [
            "987fcdeb-51a2-43f1-a567-987654321000"
          ]
        }
      },
      "ExamScoringStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ExamScoring": {
        "type": "object",
        "properties": {
          "maxPoints": {
            "type": "number"
          },
          "passingPoints": {
            "type": "number"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamScoringStep"
            }
          }
        }
      },
      "ExamData": {
        "type": "object",
        "properties": {
          "taskContent": {
            "type": "string"
          },
          "taskContentEn": {
            "type": "string"
          },
          "solutionContent": {
            "type": "string"
          },
          "solutionContentEn": {
            "type": "string"
          },
          "scoring": {
            "$ref": "#/components/schemas/ExamScoring"
          }
        }
      }
    }
  }
}


{
  "openapi": "3.1.0",
  "info": {
    "title": "Skillpilot AI Interface",
    "description": "Skillpilot AI-API fuer ChatGPT: Startcode einloesen, Lernzustand laden, Ziele waehlen und Mastery speichern. Der GPT arbeitet nur mit einem kurzlebigen Chat-Session-Token, nicht mit der echten SkillPilot-ID.",
    "version": "v3-ai-startcode-session"
  },
  "servers": [
    {
      "url": "https://skillpilot.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/ai/de/chat-start/redeem": {
      "post": {
        "operationId": "redeemStartCode",
        "summary": "Startcode einloesen und Chat-Session starten",
        "description": "Muss als erster Tool-Call ausgefuehrt werden, wenn die Unterhaltung mit einem SkillPilot-Startcode beginnt. Gibt ein chatSessionToken und den initialen Lernzustand zurueck. Den Token intern weiterverwenden und nicht der lernenden Person anzeigen.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemStartCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Startcode erfolgreich eingeloest. Enthält Chat-Session-Token und initialen Lernzustand.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemStartCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Start code not found"
          },
          "409": {
            "description": "Startcode wurde bereits verwendet."
          },
          "410": {
            "description": "Startcode ist abgelaufen."
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/state": {
      "get": {
        "operationId": "getLearnerState",
        "summary": "Get unified learner state",
        "description": "Laedt den aktuellen Lernzustand fuer die Chat-Session. Nicht nach einer SkillPilot-ID fragen.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aktueller Lernzustand. skillpilotId ist bei Session-Routen absichtlich null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/scope": {
      "post": {
        "operationId": "setScope",
        "summary": "Set learning scope/focus",
        "description": "Setzt den Lernfokus anhand von Goal-IDs aus dem zuletzt geladenen Zustand und gibt den aktualisierten Zustand zurueck.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScopeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scope updated. Returns new learner state with planned goals.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/active-goal": {
      "post": {
        "operationId": "setActiveGoal",
        "summary": "Lock an atomic goal for teaching",
        "description": "Setzt ein atomares Ziel aus dem zuletzt geladenen Zustand als aktives Ziel und gibt den neuen Zustand zurueck.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActiveGoalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Active goal set. Returns new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/mastery": {
      "post": {
        "operationId": "setMastery",
        "summary": "Update mastery and get next steps",
        "description": "Persistiert Mastery nur fuer das aktive atomare Ziel nach ausreichender Evidenz im aktuellen Dialog. Nicht direkt nach State-Load oder setActiveGoal aufrufen. Request braucht goalId des aktiven Ziels.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MasteryUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mastery updated, returns new frontier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MasteryUpdateResponse"
                }
              }
            }
          },
          "409": {
            "description": "Voraussetzung fehlt vor dem Speichern der Mastery. Zurückgegebener Zustand enthält den nächsten erforderlichen Schritt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/curriculum": {
      "post": {
        "operationId": "setCurriculum",
        "summary": "Set current curriculum/landscape",
        "description": "Setzt das aktive Curriculum fuer die Chat-Session und gibt den aktualisierten Zustand zurueck.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurriculumRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Curriculum updated successfully. Returns the new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Learner or Curriculum not found"
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/sessions/{chatSessionToken}/personalization": {
      "post": {
        "operationId": "setPersonalization",
        "summary": "Personalize the curriculum",
        "description": "Speichert persoenliche Praeferenzen und Filter fuer die Chat-Session, danach den neuen Zustand.",
        "parameters": [
          {
            "name": "chatSessionToken",
            "in": "path",
            "required": true,
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonalizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Personalization updated. Returns new learner state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    },
    "/api/ai/de/landscapes": {
      "get": {
        "operationId": "listLandscapes",
        "summary": "List available curriculums",
        "responses": {
          "200": {
            "description": "List of available landscapes/curriculums",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandscapeOverviewResponse"
                }
              }
            }
          }
        },
        "x-openai-isConsequential": false
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key"
      }
    },
    "schemas": {
      "UnifiedLearnerStateResponse": {
        "type": "object",
        "properties": {
          "skillpilotId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Interne SkillPilot-ID. Bei Chat-Session-Routen absichtlich null; der GPT darf diese ID nicht erfragen, anzeigen oder in Links einbauen."
          },
          "curriculum": {
            "$ref": "#/components/schemas/LandscapeSummary"
          },
          "frontier": {
            "type": "array",
            "description": "Ziele, die im aktuellen Zustand lernbar sind (atomar und Cluster). Dies sind Kandidaten; das bestätigte aktuelle Ziel steht separat in `activeGoal`.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "goals": {
            "$ref": "#/components/schemas/LearnerGoals"
          },
          "nextAllowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Backend-Berechtigungsliste, keine Handlungsanweisung. Immer stateMachine.requiredAction folgen; setMastery nur nach Lernenden-Evidenz."
          },
          "activeFilters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of active filter IDs (e.g. 'LK', 'GK') applied to the current curriculum."
          },
          "copySources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CopySource"
            }
          },
          "learningState": {
            "type": "string",
            "description": "Current learning state (e.g. FRONTIER, TEACHING)."
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal",
            "description": "Bestätigtes aktives Lernziel."
          },
          "stateMachine": {
            "$ref": "#/components/schemas/StateMachineInfo"
          }
        }
      },
      "ActiveGoalRequest": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "description": "ID eines atomaren Ziels aus dem zuletzt geladenen Zustand, das als aktuelles Lernziel gesperrt wird."
          },
          "redirect": {
            "type": "boolean",
            "description": "Nur true, wenn der Nutzer explizit auf ein anderes Ziel wechseln möchte."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "FrontierGoal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "atomic",
              "cluster"
            ]
          },
          "nodeKind": {
            "type": "string",
            "enum": [
              "exam",
              "tutor",
              "memory"
            ]
          },
          "reason": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resourceLinks": {
            "description": "Geordnete hilfreiche Lernressourcen für dieses Lernziel. Kanonisches Feld für Cockpit und KI-Lerncoaches.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalSourceLink"
            }
          },
          "sourceRef": {
            "type": "string",
            "description": "Kanonische Provenienz-Referenz für dieses Lernziel, idealerweise eine stabile URL, sonst eine Zitationszeichenkette."
          },
          "sourceLicense": {
            "type": "string",
            "description": "Lizenzbezeichnung der kanonischen Quelle (z. B. CC-BY-NC-SA-4.0)."
          },
          "sourceLicenseUrl": {
            "type": "string",
            "description": "URL zur geltenden Lizenz- oder Terms-Seite."
          },
          "examData": {
            "$ref": "#/components/schemas/ExamData",
            "description": "Vollständige Prüfungsdaten. Garantiert nur auf `activeGoal` und `stateMachine.activeGoal`; bei auswählbaren Kandidaten kann das Feld fehlen."
          }
        }
      },
      "GoalSourceLink": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Didaktische Rolle des Links, z. B. overview, concept, practice, assessment, solution, reference."
          },
          "title": {
            "type": "string",
            "description": "Kurze, nutzerseitige Bezeichnung."
          },
          "url": {
            "type": "string",
            "description": "Absolute Ziel-URL."
          },
          "resourceType": {
            "type": "string",
            "description": "Konkrete Materialart, z. B. course-page, video, notes, article, simulation, problem-set, exam, solution-set, book, tool."
          },
          "provider": {
            "type": "string",
            "description": "Optionales Provider- oder Seitenlabel, z. B. MIT OCW oder physikbuch.schule."
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optionale Kapitel- oder Abschnittshinweise zum Lernziel."
          },
          "description": {
            "type": "string",
            "description": "Optionaler kurzer Hinweis, warum der Link hilfreich ist."
          },
          "lang": {
            "type": "string",
            "description": "Optionaler BCP-47-Sprachcode der verlinkten Ressource."
          },
          "license": {
            "type": "string",
            "description": "Optionale Lizenzbezeichnung der verlinkten Ressource."
          }
        }
      },
      "LearnerGoals": {
        "type": "object",
        "properties": {
          "planned": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "mastered_count": {
            "type": "integer",
            "description": "Mastered atomic goals in the current focus (scope if set, otherwise personalized curriculum)."
          },
          "total_count": {
            "type": "integer",
            "description": "Total atomic goals in the current focus (scope if set, otherwise personalized curriculum)."
          },
          "personalized": {
            "$ref": "#/components/schemas/GoalStats"
          },
          "scope": {
            "$ref": "#/components/schemas/GoalStats"
          },
          "scope_completed": {
            "type": "boolean",
            "description": "True when the current scope (planned focus) is fully mastered."
          }
        }
      },
      "GoalStats": {
        "type": "object",
        "properties": {
          "mastered_atomic": {
            "type": "integer"
          },
          "total_atomic": {
            "type": "integer"
          }
        }
      },
      "ScopeRequest": {
        "type": "object",
        "properties": {
          "goalIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Goal-IDs aus dem zuletzt geladenen Zustand für die Scope-Definition."
          }
        },
        "required": [
          "goalIds"
        ]
      },
      "MasteryUpdateResponse": {
        "type": "object",
        "properties": {
          "frontier": {
            "type": "array",
            "description": "Aktualisierte Kandidatenziele nach Mastery (atomar und Cluster). Das bestätigte aktuelle Ziel steht separat in `activeGoal`.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "nextAllowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Backend-Berechtigungsliste, keine Handlungsanweisung. Immer stateMachine.requiredAction folgen; setMastery nur nach Lernenden-Evidenz."
          },
          "learningState": {
            "type": "string",
            "description": "Current learning state after mastery (e.g. FRONTIER, TEACHING)."
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal",
            "description": "Bestätigtes aktives Lernziel nach Mastery."
          },
          "stateMachine": {
            "$ref": "#/components/schemas/StateMachineInfo"
          },
          "goals": {
            "$ref": "#/components/schemas/LearnerGoals"
          }
        }
      },
      "StateMachineInfo": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "description": "Current high-level state (SETUP, FRONTIER, TEACHING)."
          },
          "requiredAction": {
            "type": "string",
            "description": "Einzelner erforderlicher nächster Schritt für den aktuellen Zustand, sofern vorhanden. Werte, die Toolnamen entsprechen, sind Tool-Aufrufe. `teachActiveGoal` ist ein Gesprächs-/Prüfschritt, kein Tool-Aufruf; `setMastery` erst nach echter Lernenden-Evidenz aufrufen."
          },
          "goalOptions": {
            "type": "array",
            "description": "Goal-Optionen zum aktuellen `requiredAction`-Schritt. Dies sind auswählbare Kandidaten, nicht automatisch das bestätigte aktive Ziel.",
            "items": {
              "$ref": "#/components/schemas/FrontierGoal"
            }
          },
          "curriculumOptions": {
            "type": "array",
            "description": "Curriculum options when a curriculum must be selected.",
            "items": {
              "$ref": "#/components/schemas/LandscapeSummary"
            }
          },
          "activeGoal": {
            "$ref": "#/components/schemas/FrontierGoal",
            "description": "Bestätigtes aktives Ziel im State Machine-Teil."
          }
        }
      },
      "MasteryUpdateRequest": {
        "type": "object",
        "properties": {
          "goalId": {
            "type": "string",
            "description": "ID des aktiven atomaren Ziels. Nur nach ausreichender Lernenden-Evidenz verwenden."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "MasteryResponse": {
        "type": "object",
        "properties": {
          "mastery": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "description": "Map von Goal-ID zu Mastery-Wert (0.0-1.0)."
          },
          "goalId": {
            "type": "string",
            "description": "Optionale einzelne Ziel-ID."
          }
        },
        "required": [
          "goalId"
        ]
      },
      "FrontierResponse": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of Goal UUIDs that are ready to be learned."
          }
        }
      },
      "PlannedGoalsRequest": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "description": "List of goal IDs (UUIDs)",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "goals"
        ]
      },
      "PlannedGoalsResponse": {
        "type": "object",
        "properties": {
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateCurriculumRequest": {
        "type": "object",
        "properties": {
          "curriculumId": {
            "type": "string"
          }
        }
      },
      "PersonalizationRequest": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "description": "Configuration map. Key = Landscape ID. Value = {selected: boolean, filterId: string}. EXAMPLE: {'math-de': {'selected': true, 'filterId': 'Q1'}}",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "selected": {
                  "type": "boolean"
                },
                "filterId": {
                  "type": "string"
                }
              }
            }
          },
          "goalIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of Goal IDs (UUIDs) to enable (e.g. subject/module goals). The backend will automatically select the corresponding landscapes. When applying GK/LK filters, include the relevant subject/module goal IDs here; filters alone do not select a subject."
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of filter tags (e.g. 'LK', 'GK') to apply to the selected landscapes. Use together with goalIds unless you intentionally want no subject selection."
          }
        }
      },
      "LandscapeOverviewResponse": {
        "type": "object",
        "properties": {
          "summaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LandscapeSummary"
            }
          }
        }
      },
      "LandscapeSummary": {
        "type": "object",
        "properties": {
          "curriculumId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LandscapeFilter"
            }
          }
        }
      },
      "LandscapeFilter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "CopySource": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "copiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ExamScoringStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ExamScoring": {
        "type": "object",
        "properties": {
          "maxPoints": {
            "type": "number"
          },
          "passingPoints": {
            "type": "number"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamScoringStep"
            }
          }
        }
      },
      "ExamData": {
        "type": "object",
        "properties": {
          "taskContent": {
            "type": "string"
          },
          "taskContentEn": {
            "type": "string"
          },
          "solutionContent": {
            "type": "string"
          },
          "solutionContentEn": {
            "type": "string"
          },
          "scoring": {
            "$ref": "#/components/schemas/ExamScoring"
          }
        }
      },
      "RedeemStartCodeRequest": {
        "type": "object",
        "required": [
          "startCode"
        ],
        "properties": {
          "startCode": {
            "type": "string",
            "description": "Kurzlebiger Startcode aus skillpilot.com, z. B. SP-7KQ9-M2PA. Keine SkillPilot-ID."
          }
        }
      },
      "RedeemStartCodeResponse": {
        "type": "object",
        "required": [
          "chatSessionToken",
          "expiresAt",
          "state"
        ],
        "properties": {
          "chatSessionToken": {
            "type": "string",
            "description": "Chat-Session-Token aus redeemStartCode. Nicht anzeigen, nicht erfragen, nur fuer Folge-Tool-Calls verwenden."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Ablaufzeit der Chat-Session."
          },
          "state": {
            "$ref": "#/components/schemas/UnifiedLearnerStateResponse"
          }
        }
      }
    }
  }
}

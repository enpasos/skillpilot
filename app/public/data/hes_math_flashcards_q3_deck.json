  "title": "Stochastik-Core (Q3) - Kernaussagen",
  "cards": [
    {
      "id": "hes_stoch_c01",
      "front": "Formel für bedingte Wahrscheinlichkeit $P(A|B)$",
      "back": "$P(A|B) = \\frac{P(A \\cap B)}{P(B)}$",
      "category": "Grundlagen",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_stoch_c02",
      "front": "Bedingung für stochastische Unabhängigkeit von $A$ und $B$",
      "back": "$P(A \\cap B) = P(A) \\cdot P(B)$",
      "category": "Grundlagen",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_stoch_c03",
      "front": "Laplace-Experiment: Bedingung und Berechnung",
      "back": "Alle Ergebnisse sind gleich wahrscheinlich. $P(E) = \\frac{\\text{Anzahl günstige Ergebnisse}}{\\text{Anzahl mögliche Ergebnisse}}$",
      "category": "Grundlagen",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_stoch_c04",
      "front": "Erwartungswert $E(X)$ einer Zufallsgröße",
      "back": "Summe der Produkte aus Wert und Wahrscheinlichkeit: $\\mu = \\sum x_i \\cdot P(X=x_i)$",
      "category": "Kenngrößen",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_stoch_c05",
      "front": "Binomialkoeffizient $\\binom{n}{k}$: Bedeutung",
      "back": "Anzahl der Möglichkeiten, $k$ Elemente aus $n$ Elementen auszuwählen (ohne Reihenfolge, ohne Zurücklegen).",
      "category": "Kombinatorik",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_stoch_c06",
      "front": "Bernoulli-Formel (Binomialverteilung)",
      "back": "$P(X=k) = \\binom{n}{k} \\cdot p^k \\cdot (1-p)^{n-k}$",
      "category": "Verteilungen",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_stoch_c07",
      "front": "Erwartungswert $\\mu$ einer Binomialverteilung",
      "back": "$\\mu = n \\cdot p$",
      "category": "Verteilungen",
      "tags": [
        "GK",
        "LK"
      ]
    },
    {
      "id": "hes_stoch_c08",
      "front": "Standardabweichung $\\sigma$ einer Binomialverteilung",
      "back": "$\\sigma = \\sqrt{n \\cdot p \\cdot (1-p)}$",

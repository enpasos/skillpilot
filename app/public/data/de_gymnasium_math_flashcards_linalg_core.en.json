  "cards": [
    {
      "id": "math_linalg_c01",
      "front": "Magnitude (length) of a vector\n\n$\\vec{v} = (v_1, v_2, v_3)^T$",
      "back": "$|\\vec{v}| = \\sqrt{v_1^2 + v_2^2 + v_3^2}$",

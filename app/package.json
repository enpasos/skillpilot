{
  "name": "skillpilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run deploy:assets && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:assets": "./node_modules/.bin/tsx ../scripts/deploy_curriculum_decks.ts && ./node_modules/.bin/tsx ../scripts/deploy_exam_assets.ts && ./node_modules/.bin/tsx ../scripts/deploy_whitepaper.ts && python3 ../scripts/deploy_story.py",
    "validate:graph": "tsx scripts/validateGraph.ts",
    "validate:view-filters": "tsx scripts/validateViewFilters.ts",
    "validate:composition-views": "tsx scripts/validateCompositionViews.ts",
    "validate:learner-goal-selection": "tsx scripts/validateLearnerGoalSelection.ts",
    "quality:curriculum-status": "tsx scripts/generateCurriculumQualityStatus.ts",
    "quality:source-coverage-audit": "tsx scripts/generateCurriculumSourceCoverageAudit.ts",
    "quality:semantic-atomicity": "tsx scripts/semanticAtomicityReview.ts",
    "quality:semantic-atomicity:check": "tsx scripts/semanticAtomicityReview.ts --mode=check",
    "quality:memory-card-review": "tsx scripts/memoryCardReview.ts",
    "quality:memory-card-review:report": "tsx scripts/memoryCardReview.ts --write-report",
    "quality:memory-card-review:check": "tsx scripts/memoryCardReview.ts --mode=check",
    "quality:memory-card-review:report:all": "tsx scripts/runMemoryCardReviewConfigs.ts --mode=report",
    "quality:memory-card-review:check:all": "tsx scripts/runMemoryCardReviewConfigs.ts --mode=check",
    "quality:memory-card-review:rollout": "tsx scripts/reportMemoryCardReviewRollout.ts",
    "quality:memory-card-review:pilot-dossier": "tsx scripts/reportMemoryCardPilotDossier.ts",
    "quality:m0-remediation": "tsx scripts/reportM0RemediationPlan.ts",
    "quality:english-remediation-pilot": "tsx scripts/reportEnglishRemediationPilot.ts",
    "check:canonical-physics-evidence-watch": "bash ../scripts/run_canonical_physics_evidence_watch.sh",
    "report:learner-tree-fallbacks": "tsx scripts/reportLearnerTreeFallbackCoverage.ts",
    "report:canonical-math-scope-coverage": "tsx scripts/reportCanonicalMathScopeCoverage.ts",
    "report:canonical-math-visibility-gaps": "tsx scripts/reportCanonicalMathStateVisibilityGaps.ts",
    "export:subject-package": "tsx scripts/buildSkillpilotExportPackage.ts",
    "export:subject-provenance-audit": "tsx scripts/buildSubjectProvenanceAuditPackage.ts",
    "export:subject-packages:validate": "tsx scripts/validateSubjectExportPackages.ts",
    "export:subject-packages:audit-links": "tsx scripts/auditSubjectExportSourceLinks.ts",
    "export:subject-package:trace-source": "tsx scripts/traceSubjectExportSourceReference.ts",
    "export:subject-publication-index": "tsx scripts/buildSubjectExportPublicationIndex.ts",
    "export:subject-release-gate": "tsx scripts/runSubjectExportReleaseGate.ts",
    "export:m5-subject-packages": "tsx scripts/buildM5SubjectExportPackages.ts",
    "export:m5-subject-provenance-audits": "tsx scripts/buildM5SubjectProvenanceAuditPackages.ts",
    "export:m5-subject-packages:check-reproducible": "tsx scripts/checkM5SubjectExportPackageReproducibility.ts",
    "roundtrip:mem-fwu": "tsx scripts/memFwuRoundtrip.ts",
    "roundtrip:mem-fwu:to-rdf": "tsx scripts/memFwuRoundtrip.ts --mode to-rdf",
    "roundtrip:mem-fwu:slim": "tsx scripts/memFwuRoundtrip.ts --mode to-slim-rdf",
    "roundtrip:mem-fwu:semantic": "tsx scripts/memFwuRoundtrip.ts --mode to-slim-rdf && tsx scripts/semanticMemFwuRoundtrip.ts",
    "roundtrip:mem-fwu:from-rdf": "tsx scripts/memFwuRoundtrip.ts --mode from-rdf",
    "roundtrip:mem-fwu:validate": "tsx scripts/memFwuRoundtrip.ts --mode validate",
    "roundtrip:mem-fwu:visualize": "tsx scripts/visualizeMemFwuSubgraph.ts",
    "roundtrip:mem-fwu:semantic-reconstruct": "tsx scripts/semanticMemFwuRoundtrip.ts",
    "report:requires": "tsx scripts/generateRequiresReport.ts",
    "report:atomic": "tsx scripts/generateAtomicReport.ts",
    "report:applicability": "tsx scripts/compileApplicability.ts",
    "apply:applicability": "tsx scripts/applyApplicability.ts",
    "mcp:server": "tsx server/mcpServer.ts"
  },
  "dependencies": {
    "@types/dagre": "^0.7.53",
    "@types/express": "^5.0.5",
    "@types/react-router-dom": "^5.3.3",
    "@xyflow/react": "^12.10.1",
    "dagre": "^0.8.5",
    "elkjs": "^0.11.0",
    "express": "^5.1.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.0",
    "katex": "^0.16.27",
    "lucide-react": "0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.9.6",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "svg2pdf.js": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0"
  },
  "overrides": {
    "magic-string": "0.30.21",
    "serialize-javascript": "7.0.5",
    "source-map": "0.7.6"
  }
}

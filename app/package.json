{
  "name": "skillpilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run deploy:assets && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:assets": "./node_modules/.bin/tsx ../scripts/deploy_curriculum_decks.ts && ./node_modules/.bin/tsx ../scripts/deploy_exam_assets.ts && ./node_modules/.bin/tsx ../scripts/deploy_whitepaper.ts",
    "validate:graph": "tsx scripts/validateGraph.ts",
    "validate:view-filters": "tsx scripts/validateViewFilters.ts",
    "validate:composition-views": "tsx scripts/validateCompositionViews.ts",
    "validate:learner-goal-selection": "tsx scripts/validateLearnerGoalSelection.ts",
    "check:canonical-physics-evidence-watch": "bash ../scripts/run_canonical_physics_evidence_watch.sh",
    "report:learner-tree-fallbacks": "tsx scripts/reportLearnerTreeFallbackCoverage.ts",
    "report:canonical-math-scope-coverage": "tsx scripts/reportCanonicalMathScopeCoverage.ts",
    "report:canonical-math-visibility-gaps": "tsx scripts/reportCanonicalMathStateVisibilityGaps.ts",
    "report:requires": "tsx scripts/generateRequiresReport.ts",
    "report:atomic": "tsx scripts/generateAtomicReport.ts",
    "report:applicability": "tsx scripts/compileApplicability.ts",
    "apply:applicability": "tsx scripts/applyApplicability.ts",
    "mcp:server": "tsx server/mcpServer.ts"
  },
  "dependencies": {
    "@types/dagre": "^0.7.53",
    "@types/express": "^5.0.5",
    "@types/react-router-dom": "^5.3.3",
    "@xyflow/react": "^12.10.1",
    "dagre": "^0.8.5",
    "elkjs": "^0.11.0",
    "express": "^5.1.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.0",
    "katex": "^0.16.27",
    "lucide-react": "0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.9.6",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "svg2pdf.js": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0"
  },
  "overrides": {
    "magic-string": "0.30.21",
    "serialize-javascript": "7.0.5",
    "source-map": "0.7.6"
  }
}

* text=auto eol=lf
.gitattributes text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
.corretto-version text eol=lf
.java-version text eol=lf
.nvmrc text eol=lf

# PDFs are binary artifacts, including originals without early NUL bytes.
*.pdf binary

# Captured official HTML is primary evidence; retain its actual response bytes.
# Provider whitespace is part of that evidence, not authored formatting.
*.actual-official.html -text -whitespace
*.actual.html -text -whitespace

# Captured primary-source excerpts and raw terminal output retain exact bytes.
# Their whitespace belongs to the source/tool, not authored documentation.
curricula/**/quality/**/primary/*.txt -text -whitespace
curricula/**/quality/**/primary/*.html -text -whitespace
curricula/**/quality/**/primary/*.snapshot -text -whitespace
curricula/**/quality/**/read-primary/*.txt -text -whitespace
curricula/**/quality/**/source-readonly/*.txt -text -whitespace
curricula/**/quality/**/*.actual.txt -text -whitespace

# Hash-bound review materials retain the CSV writer's actual line endings.
curricula/**/quality/**/materials/*.csv -text -whitespace

# Verbatim review instructions and captured generation records are evidence.
curricula/**/quality/**/inputs/AGENTS*.md -whitespace
curricula/**/quality/**/generation-*.actual.json -whitespace

# Frozen native review pages retain renderer bytes, including empty-line spacing.
curricula/**/quality/**/native/**/*.html -text -whitespace
curricula/**/quality/**/inspected-exact-native/**/*.html -text -whitespace
curricula/**/quality/**/book.html -text -whitespace
curricula/**/quality/**/*.normal-renderer.html -text -whitespace

# Native validation reports are captured tool outputs; preserve their sealed bytes.
curricula/**/quality/**/*.normal.report.md -text -whitespace
curricula/**/quality/**/*.normal.actual.report.md -text -whitespace

# Captured check logs and JUnit reports retain their exact tool-output bytes.
curricula/**/quality/**/checks/**/*.log -text -whitespace
curricula/**/quality/**/checks/**/*.xml -text -whitespace


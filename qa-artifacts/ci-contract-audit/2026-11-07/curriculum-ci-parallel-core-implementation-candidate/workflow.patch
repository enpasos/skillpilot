+  curriculum-ci:
+    name: Curriculum CI
+    needs: [graph-validation, goal-book-publication]
+    if: ${{ always() }}
+    runs-on: ubuntu-24.04
+    defaults:
+      run:
+        working-directory: app
+    steps:
+      - name: Require successful curriculum core and verified book build
+        if: ${{ always() }}
+        working-directory: ${{ runner.temp }}
+        shell: bash
+        env:
+          CURRICULUM_CORE_RESULT: ${{ needs.graph-validation.result }}
+          CURRICULUM_BOOK_RESULT: ${{ needs.goal-book-publication.result }}
+        run: |
+          set -euo pipefail
+          if [[ "${CURRICULUM_CORE_RESULT:-}" != success || "${CURRICULUM_BOOK_RESULT:-}" != success ]]; then
+            echo "::error::Curriculum CI requires successful core and book jobs; core=${CURRICULUM_CORE_RESULT:-missing}, book=${CURRICULUM_BOOK_RESULT:-missing}."
+            exit 1
+          fi
+      - *reserve_repository_disk
+      - name: Checkout
+        uses: actions/checkout@v6
+      - *verify_repository_disk
+      - name: Use Node.js
+        uses: actions/setup-node@v6
+        with:
+          node-version-file: .nvmrc
+          cache: npm
+          cache-dependency-path: app/package-lock.json
+      - name: Install dependencies
+        run: npm ci
+      - name: Use Ubuntu package sources
+        uses: ./.github/actions/ubuntu-apt
+      - name: Install package-consumer isolation tools
+        timeout-minutes: 10
+        run: sudo apt-get update && sudo apt-get install -y bubblewrap strace
+      - name: Enable and verify bubblewrap isolation
+        run: bash ../scripts/configure_github_bubblewrap.sh
+      - name: Install PDF validation tools
+        timeout-minutes: 10
+        run: sudo apt-get update && sudo apt-get install --yes --no-install-recommends poppler-utils fontconfig fonts-liberation
+      - name: Install pinned Playwright Chromium
+        timeout-minutes: 10
+        run: npx --no-install playwright install --with-deps chromium
+      - name: Prepare generated curriculum runtime assets
+        run: npm run prepare:runtime-assets
+      - name: Check goal visualization runtime assets
+        run: npm run check:goal-visualization-assets
+      - name: Check goal visualization QA freshness
+        run: npm run check:goal-visualization-qa -- --subjects=mathematik,physik,chemie
+      - name: Check goal visualization approval coverage
+        run: npm run check:goal-visualization-approval-coverage
+      - name: Check goal visualization rollout coverage
+        run: |
+          npm run check:goal-visualization-rollout-coverage
+          npm run check:goal-visualization-rollout-coverage:physik
+          npm run check:goal-visualization-rollout-coverage:chemie
+          npm run check:goal-visualization-qa-coverage-parity
+      - name: Test full standalone curriculum package builder
+        run: npm run test:full-standalone-package-builder
+      - name: Restore same-run verified goal-book publications
+        uses: actions/download-artifact@v7
+        with:
+          name: goal-book-publication-${{ github.sha }}
+          path: app/public/lernzielbuch/
+      - name: Build integrated application artifact
+        run: npm run build:application
+      - name: Build package-only consumer frontend
+        run: npm run build:package-consumer -- --out-dir ../tmp/package-consumer-ci/frontend
+      - name: Check Goal Source Rationale Build Artifact
+        run: npm run check:goal-source-rationales:build-artifact
+      - name: Set up Python
+        uses: actions/setup-python@v6
+        with:
+          python-version: '3.10'
+      - name: Set up Java for package-consumer smoke
+        uses: actions/setup-java@v5
+        with:
+          distribution: corretto
+          java-version-file: .java-version
+          cache: gradle
+      - name: Use exact production Corretto build
+        run: |
+          set -euo pipefail
+          corretto_version="$(tr -d '[:space:]' < ../.corretto-version)"
+          install_dir="${RUNNER_TEMP}/amazon-corretto-${corretto_version}"
+          archive="${RUNNER_TEMP}/amazon-corretto-${corretto_version}-linux-x64.tar.gz"
+          curl -fsSL "https://corretto.aws/downloads/resources/${corretto_version}/amazon-corretto-${corretto_version}-linux-x64.tar.gz" -o "${archive}"
+          mkdir -p "${install_dir}"
+          tar -xzf "${archive}" --strip-components=1 -C "${install_dir}"
+          echo "JAVA_HOME=${install_dir}" >> "${GITHUB_ENV}"
+          echo "${install_dir}/bin" >> "${GITHUB_PATH}"
+          "${install_dir}/bin/java" -version
+      - name: Install Python dependencies
+        run: python -m pip install -r ../scripts/curriculum_package_validation_requirements.txt
+      - name: Verify curriculum JSON conformance scripts
+        run: |
+          cd ..
+          bash -n \
+            scripts/provision_pinned_fwu_ontology.sh \
+            scripts/run_curriculum_release_model_conformance.sh
+      - name: Validate Curriculum Package Contracts
+        env:
+          SKILLPILOT_SOURCE_PDF_MODE: committed-bindings
+        run: |
+          cd ..
+          python -B scripts/validate_curriculum_package_contracts.py
+          python -B scripts/validate_curriculum_runtime_catalog_contract.py
+          python -B scripts/validate_curriculum_schema_catalog_contract.py
+          python -B scripts/evaluate_curriculum_package_readiness.py --self-test
+          python -B scripts/validate_full_standalone_curriculum_package.py --self-test
+          python -B scripts/provision_curriculum_package.py self-test
+          python -B scripts/run_package_consumer_smoke.py --self-test
+          SKILLPILOT_FULL_PACKAGE_CONFORMANCE=false \
+            bash scripts/run_curriculum_release_model_conformance.sh
+
   backend-ci:
     needs: goal-book-publication
     runs-on: ubuntu-latest

  "sourceTexts": [
    {
      "sourceGoalId": "7d99b0d0-c868-578b-88f3-9695182514e7",
      "sourceSpan": "PuG8.4.1",
      "sourceText": "verwenden grundlegende Begriffe aus dem Bereich der Politik sinngerecht, u. a. bei Gesprächen über Politik sowohl innerhalb der Schule als auch im außerschulischen Bereich.",
      "rawAndExtractionTextEqual": true
    },
    {
      "sourceGoalId": "1e2565e3-be0e-526e-beaf-d0396d2e80ef",
      "sourceSpan": "PuG8.4.2",
      "sourceText": "erkennen die Notwendigkeit von Regeln für das Zusammenleben und die Mitwirkung der Bürgerinnen und Bürger in einem demokratischen Staat.",
      "rawAndExtractionTextEqual": true
    },
    {
      "sourceGoalId": "7ec25bbd-e411-5ba8-bbaf-de49e40b54c2",
      "sourceSpan": "PuG8.4.3",
      "sourceText": "recherchieren aktuelle politische Probleme und Lösungsvorschläge und präsentieren diese vor der Klasse.",
      "rawAndExtractionTextEqual": true
    },
    {
      "sourceGoalId": "edc83956-8312-5382-8057-ebb6fb5096f5",
      "sourceSpan": "PuG8.4.4",
      "sourceText": "ermitteln Mitwirkungsmöglichkeiten Jugendlicher auf kommunaler Ebene und bewerten Chancen und Grenzen einer wirksamen Partizipation Jugendlicher.",
      "rawAndExtractionTextEqual": true
    },
    {
      "sourceGoalId": "1ae3f60e-a4a5-53d3-bd8b-20765409836d",
      "sourceSpan": "PuG8.4.5",
      "sourceText": "erkennen an einem aktuellen Beispiel, dass Politik in einer demokratischen Gesellschaft die Aushandlung von mehrheitsfähigen Lösungen für Herausforderungen beinhaltet, um Kompromisse als Ergebnis einer friedlichen Konfliktaustragung wertzuschätzen.",
      "rawAndExtractionTextEqual": true
    },
    {
      "sourceGoalId": "8b47b74b-3117-57f1-8317-c6cde18682db",
      "sourceSpan": "PuG8.4.6",
      "sourceText": "recherchieren Formen politischen Engagements auf lokaler Ebene, um Grundhaltungen sowie Perspektiven hinsichtlich des eigenen politischen Engagements zu entwickeln.",
      "rawAndExtractionTextEqual": true
    },
    {
      "sourceGoalId": "1d39258d-c6e6-5679-bd7f-45ca023eacfb",
      "sourceSpan": "PuG8.4.7",
      "sourceText": "ermitteln mithilfe von Printmedien oder digitalen Medien aktuell im Blickfeld stehende Akteure in Gesellschaft und Staat und vollziehen deren Zusammenwirken in Grundzügen nach, z. B. in Form eines selbst gestalteten Schaubilds.",
      "rawAndExtractionTextEqual": true
    },
    {
      "sourceGoalId": "4a45dcb2-a41a-524a-947d-ca9e68dce605",
      "sourceSpan": "PuG8.6.6",
      "sourceText": "erschließen Möglichkeiten der Beteiligung und Einflussnahme in der Kommune (z. B. in Vereinen oder im Ehrenamt), um ihre Zukunft vor Ort mitzugestalten.",
      "rawAndExtractionTextEqual": true
    }
  ],

+def verify_directory_aliases(receipt, roots):
+    """Bind the declared Git aliases to both actual private directory trees."""
+    aliases = {}
+    declared = receipt.get("directorySymlinks", [])
+    require(isinstance(declared, list), "Directory alias inventory must be a list")
+    for item in declared:
+        path, target = relative_path(item["path"]), item["target"]
+        require(path not in aliases, "Directory alias is duplicated: " + path)
+        require(isinstance(target, str) and target and "\0" not in target and not target.startswith("/"),
+                "Directory alias target is not internal: " + path)
+        require(git_blob_oid(target.encode("utf-8")) == item["gitObjectId"],
+                "Directory alias Git link text differs: " + path)
+        aliases[path] = target
+
+    def final_path(path):
+        seen = set()
+        while True:
+            require(path not in seen, "Directory alias resolution is cyclic")
+            seen.add(path)
+            parts = path.split("/")
+            for length in range(1, len(parts) + 1):
+                prefix = "/".join(parts[:length])
+                if prefix in aliases:
+                    path = posixpath.normpath(posixpath.join(posixpath.dirname(prefix), aliases[prefix], *parts[length:]))
+                    require(path != ".." and not path.startswith("../") and not path.startswith("/"),
+                            "Directory alias resolution leaves its source root")
+                    relative_path(path)
+                    break
+            else:
+                return path
+
+    ends = {path: final_path(path) for path in aliases}
+    for role, root in roots.items():
+        for path, target in aliases.items():
+            physical = root / path
+            require(physical.is_symlink(), "Directory alias is not a symlink: " + role + ":" + path)
+            require(os.readlink(physical) == target, "Directory alias target changed: " + role + ":" + path)
+            try:
+                actual = physical.resolve(strict=True)
+            except (OSError, RuntimeError) as error:
+                raise ValueError("Directory alias does not resolve: " + role + ":" + path) from error
+            require(actual.is_relative_to(root) and actual == root / ends[path] and actual.is_dir(),
+                    "Directory alias final directory changed: " + role + ":" + path)
+

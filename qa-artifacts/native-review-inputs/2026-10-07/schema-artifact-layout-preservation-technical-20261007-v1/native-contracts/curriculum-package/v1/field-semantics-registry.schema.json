          "then": {
            "properties": {
              "dataType": {
                "properties": {
                  "jsonTypes": {
                    "const": [
                      "object"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "binary-reference"
              }
            }
          },
          "then": {
            "properties": {
              "dataType": {
                "properties": {
                  "jsonTypes": {
                    "const": [
                      "string"
                    ]
                  }
                }
              },
              "reverseMapping": {
                "properties": {
                  "mode": {
                    "const": "binary-index-join"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "set"
              }
            }
          },
          "then": {
            "properties": {
              "normalization": {
                "properties": {
                  "arrayOrder": {
                    "const": "sort-canonical-unique"
                  },
                  "duplicateItems": {
                    "const": "reject"
                  }
                },
                "required": [
                  "setSortKey"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "ordered-list"
              }
            }
          },
          "then": {
            "properties": {
              "normalization": {
                "properties": {
                  "arrayOrder": {
                    "const": "preserve"
                  },
                  "duplicateItems": {
                    "const": "preserve"
                  }
                }
              },
              "reverseMapping": {
                "properties": {
                  "mode": {
                    "const": "ordered-memberships"
                  },
                  "requireUniquePositions": {
                    "const": true
                  },
                  "requireContiguousPositions": {
                    "const": true
                  }
                },
                "required": [
                  "requireUniquePositions",
                  "requireContiguousPositions"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rdfMapping": {
                "properties": {
                  "strategy": {
                    "const": "excluded-generated"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "classification": {
                "const": "generated-non-semantic"
              },
              "reverseMapping": {
                "properties": {
                  "mode": {
                    "const": "omitted-generated"
                  },
                  "roundtrip": {
                    "const": "excluded-non-semantic"
                  },
                  "onMissing": {
                    "const": "regenerate"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rdfMapping": {
                "properties": {
                  "strategy": {
                    "const": "registered-canonical-json-literal"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "reverseMapping": {
                "properties": {
                  "mode": {
                    "const": "canonical-json-parse"
                  },
                  "roundtrip": {
                    "const": "exact"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dataType": {
                "properties": {
                  "jsonTypes": {
                    "contains": {
                      "const": "null"
                    }
                  }
                },
                "required": [
                  "jsonTypes"
                ]
              },
              "presenceSemantics": {
                "properties": {
                  "null": {
                    "const": "distinct"
                  }
                },
                "required": [
                  "null"
                ]
              }
            },
            "required": [
              "dataType",
              "presenceSemantics"
            ]
          },
          "then": {
            "properties": {
              "rdfMapping": {
                "not": {
                  "anyOf": [
                    {
                      "properties": {
                        "construction": {
                          "properties": {
                            "objectMapping": {
                              "const": "typed-literal"
                            }
                          },
                          "required": [
                            "objectMapping"
                          ]
                        }
                      },
                      "required": [
                        "construction"
                      ]
                    },
                    {
                      "properties": {
                        "fallbackConstruction": {

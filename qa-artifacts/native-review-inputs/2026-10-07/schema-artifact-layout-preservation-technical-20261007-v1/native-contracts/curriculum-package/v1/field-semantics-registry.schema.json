                            "objectMapping"
                          ]
                        }
                      },
                      "required": [
                        "fallbackConstruction"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "rdfMapping": {
                    "properties": {
                      "construction": {
                        "required": [
                          "resourceClass"
                        ]
                      }
                    },
                    "required": [
                      "construction"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "rdfMapping": {
                    "properties": {
                      "fallbackConstruction": {
                        "required": [
                          "resourceClass"
                        ]
                      }
                    },
                    "required": [
                      "fallbackConstruction"
                    ]
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "reverseMapping": {
                "properties": {
                  "mode": {
                    "const": "resource-record"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }

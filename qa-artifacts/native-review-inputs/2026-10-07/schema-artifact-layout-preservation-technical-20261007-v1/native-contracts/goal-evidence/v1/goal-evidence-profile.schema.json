{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/goal-evidence/v1/goal-evidence-profile.schema.json",
  "title": "SkillPilot goal evidence review record v1",
  "description": "Fingerprint-bound review record for learner-facing didactic coverage and mastery evidence. AI output is a candidate only; approved records require explicit human authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "ruleVersion",
    "landscapeId",
    "goalId",
    "goalFingerprint",
    "reviewInputFingerprint",
    "profileFingerprint",
    "status",
    "reviewAuthority",
    "reviewedAt",
    "reviewer",
    "reason",
    "evidenceLevel",
    "maximumClaimScope",
    "reviewRunIds",
    "dissent",
    "profile"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reviewId": {
      "$ref": "#/$defs/slug"
    },
    "ruleVersion": {
      "$ref": "#/$defs/slug"
    },
    "landscapeId": {
      "$ref": "#/$defs/nonBlankText"
    },
    "goalId": {
      "$ref": "#/$defs/nonBlankText"
    },
    "goalFingerprint": {
      "$ref": "#/$defs/sha256Digest"
    },
    "reviewInputFingerprint": {
      "$ref": "#/$defs/sha256Digest"
    },
    "profileFingerprint": {
      "$ref": "#/$defs/sha256Digest"
    },
    "status": {
      "enum": [
        "needs_human_review",
        "approved",
        "rejected"
      ]
    },
    "reviewAuthority": {
      "enum": [
        "ai_candidate",
        "human"
      ]
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "$ref": "#/$defs/nonBlankText"
    },
    "reason": {
      "$ref": "#/$defs/boundedText"
    },
    "evidenceLevel": {
      "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]
    },
    "maximumClaimScope": {
      "enum": ["G0", "G1", "G2", "G3", "G4"]
    },
    "reviewRunIds": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "dissent": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/boundedText"
      }
    },
    "profile": {
      "$ref": "#/$defs/profile"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reviewAuthority": {
            "const": "human"
          }
        }
      }
    }
  ],
  "$defs": {
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "localizedCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "criterionDe",
        "criterionEn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "criterionDe": {
          "$ref": "#/$defs/boundedText"
        },
        "criterionEn": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "localizedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "textDe",
        "textEn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "textDe": {
          "$ref": "#/$defs/boundedText"
        },
        "textEn": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "misconception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "signalDe",
        "signalEn",
        "correctionEvidenceDe",
        "correctionEvidenceEn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "signalDe": {
          "$ref": "#/$defs/boundedText"
        },
        "signalEn": {
          "$ref": "#/$defs/boundedText"
        },
        "correctionEvidenceDe": {
          "$ref": "#/$defs/boundedText"
        },
        "correctionEvidenceEn": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "contrastCaseBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purposeDe",
        "purposeEn",
        "strengthDe",
        "strengthEn",
        "whyAlternativesUnderperformDe",
        "whyAlternativesUnderperformEn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "purposeDe": {
          "$ref": "#/$defs/boundedText"
        },
        "purposeEn": {
          "$ref": "#/$defs/boundedText"
        },
        "strengthDe": {
          "$ref": "#/$defs/boundedText"
        },
        "strengthEn": {
          "$ref": "#/$defs/boundedText"
        },
        "whyAlternativesUnderperformDe": {
          "$ref": "#/$defs/boundedText"
        },
        "whyAlternativesUnderperformEn": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "coverageRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allOf",
        "anyOf",
        "minimumIndependentChecks",
        "requireChangedCase",
        "requireCueFreeTransfer"
      ],
      "properties": {
        "allOf": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "anyOf": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/slug"
            }
          }
        },
        "minimumIndependentChecks": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "requireChangedCase": {
          "type": "boolean"
        },
        "requireCueFreeTransfer": {
          "type": "boolean"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype",
        "facets",
        "coverageRequirements",
        "variationAxes",
        "misconceptions",
        "nonEvidence",
        "outOfScope",
        "contrastCaseBriefs"
      ],
      "properties": {
        "archetype": {
          "enum": [
            "concept",
            "procedure",
            "representation",
            "modeling",
            "proof",
            "experiment",
            "data"
          ]
        },
        "facets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/localizedCriterion"
          }
        },
        "coverageRequirements": {
          "$ref": "#/$defs/coverageRequirements"
        },
        "variationAxes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/localizedItem"
          }
        },
        "misconceptions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/misconception"
          }
        },
        "nonEvidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/localizedItem"
          }
        },
        "outOfScope": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/localizedItem"
          }
        },
        "contrastCaseBriefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/contrastCaseBrief"
          }
        }
      }
    }
  }
}

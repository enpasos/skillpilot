{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillpilot.com/schemas/goal-evidence/v2/goal-public-feedback.schema.json",
  "title": "SkillPilot public learning-goal feedback envelope v2",
  "description": "Version-bound, privacy-minimized public feedback for one published learning-goal page. The publication context is server-derived. The exact bilingual privacy-notice version and displayed notice locale are audit-bound independently of the publication locale. External text is untrusted intake evidence only and cannot mutate canonical state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "context",
    "feedback",
    "privacyNoticeVersion",
    "privacyNoticeLocale",
    "privacyAcknowledged",
    "automatedProcessingAcknowledged"
  ],
  "properties": {
    "$schema": {
      "const": "https://skillpilot.com/schemas/goal-evidence/v2/goal-public-feedback.schema.json"
    },
    "schemaVersion": { "const": 2 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalId",
        "goalFingerprint",
        "pageFingerprint",
        "bookId",
        "bookEdition",
        "bookDigest",
        "locale",
        "scopeLabel",
        "pageNumber",
        "canonicalUrl",
        "publicationManifestFingerprint"
      ],
      "properties": {
        "goalId": { "$ref": "#/$defs/stableId" },
        "goalFingerprint": { "$ref": "#/$defs/digest" },
        "pageFingerprint": { "$ref": "#/$defs/digest" },
        "bookId": { "$ref": "#/$defs/stableId" },
        "bookEdition": { "$ref": "#/$defs/stableId" },
        "bookDigest": { "$ref": "#/$defs/digest" },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "scopeLabel": { "$ref": "#/$defs/shortText" },
        "pageNumber": { "type": "integer", "minimum": 1 },
        "canonicalUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "publicationManifestFingerprint": { "$ref": "#/$defs/digest" }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "observation"],
      "properties": {
        "category": {
          "enum": [
            "factual_error",
            "wording_or_language",
            "missing_or_overbroad_goal",
            "prerequisite_or_sequence",
            "chapter_structure",
            "scope_or_applicability",
            "source_assignment",
            "visualization_or_accessibility",
            "other"
          ]
        },
        "observation": { "$ref": "#/$defs/longText" },
        "evidence": { "$ref": "#/$defs/longText" },
        "proposedImprovement": { "$ref": "#/$defs/longText" },
        "sourceReference": { "$ref": "#/$defs/longText" },
        "reviewerRole": {
          "enum": ["teacher", "learner", "parent", "researcher", "subject_expert", "other"]
        }
      }
    },
    "privacyNoticeVersion": { "enum": ["2026-08-30.1", "2026-08-31.1"] },
    "privacyNoticeLocale": { "enum": ["de", "en"] },
    "privacyAcknowledged": { "const": true },
    "automatedProcessingAcknowledged": { "const": true }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    }
  }
}

"""Repository fixtures for portable curriculum symlinks."""

import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest

sys.dont_write_bytecode = True

import validate_schemas


class CurriculumSymlinkTests(unittest.TestCase):
    def setUp(self):
        self.scratch = tempfile.TemporaryDirectory()
        self.addCleanup(self.scratch.cleanup)
        self.root = Path(self.scratch.name) / "checkout"
        self.root.mkdir()
        subprocess.run(["git", "init", "-q", str(self.root)], check=True)
        (self.root / "curricula").mkdir()
        (self.root / "docs").mkdir()
        (self.root / "docs" / "status.json").write_text('{"status":"fixture"}\n')

    def link(self, name, target):
        path = self.root / "curricula" / name
        path.symlink_to(target)
        return path

    def errors(self):
        return validate_schemas.curriculum_symlink_errors(self.root)

    def test_relative_file_and_directory_survive_repository_relocation(self):
        self.link("status.json", "../docs/status.json")
        self.link("directory", "../docs")
        subprocess.run(["git", "add", "curricula", "docs"], cwd=self.root, check=True)
        self.assertEqual([], self.errors())
        moved = Path(self.scratch.name) / "different-ci-location" / "renamed-repository"
        moved.parent.mkdir()
        shutil.move(str(self.root), moved)
        self.assertEqual([], validate_schemas.curriculum_symlink_errors(moved))
        self.assertEqual('{"status":"fixture"}\n', (moved / "curricula/status.json").read_text())
        self.assertEqual(moved / "docs", (moved / "curricula/directory").resolve())

    def test_absolute_existing_target_is_rejected(self):
        self.link("status.json", str(self.root / "docs/status.json"))
        self.assertTrue((self.root / "curricula/status.json").exists())
        self.assertIn("absolute symlink", self.errors()[0])

    def test_absolute_directory_is_rejected_before_json_traversal(self):
        self.link("directory", str(self.root / "docs"))
        self.assertIn("absolute symlink", self.errors()[0])

    def test_broken_relative_target_is_rejected(self):
        self.link("status.json", "../docs/missing.json")
        self.assertIn("dangling or cyclic symlink", self.errors()[0])

    def test_existing_relative_target_outside_repository_is_rejected(self):
        outside = Path(self.scratch.name) / "outside.json"
        outside.write_text('{}\n')
        self.link("status.json", os.path.relpath(outside, self.root / "curricula"))
        self.assertIn("escapes repository", self.errors()[0])

    def test_ignored_scratch_dependencies_are_excluded_but_tracked_links_are_checked(self):
        (self.root / ".gitignore").write_text("curricula/ignored\n")
        self.link("ignored", str(self.root / "docs"))
        self.assertEqual([], self.errors())
        subprocess.run(["git", "add", "-f", "curricula/ignored"], cwd=self.root, check=True)
        self.assertIn("absolute symlink", self.errors()[0])

    def test_relative_link_through_external_directory_is_rejected(self):
        outside = Path(self.scratch.name) / "outside"
        outside.mkdir()
        (outside / "status.json").write_text('{}\n')
        (self.root / "docs/external").symlink_to(outside, target_is_directory=True)
        self.link("status.json", "../docs/external/status.json")
        self.assertIn("escapes repository", self.errors()[0])


if __name__ == "__main__":
    unittest.main()
